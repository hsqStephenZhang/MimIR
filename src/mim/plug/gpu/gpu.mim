/// # The gpu Plugin {#gpu}
///
/// @see mim::plug::gpu
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
plugin mem;
plugin buffer;
plugin math;
import compile;

use core.ops.n;
///
/// ## Types
///
/// ### Address Spaces
///
/// Address space numbers correlate to the ones used by LLVM.
/// @see
///
/// - [User Guide for NVPTX Back-end](https://llvm.org/docs/NVPTXUsage.html#address-spaces)
/// - [User Guide for AMDGPU Backend](https://llvm.org/docs/AMDGPUUsage.html#address-spaces)
///
anx let addr_space_global = 1;
anx let addr_space_shared = 3;
anx let addr_space_const  = 4;
anx let addr_space_local  = 5;
///
/// ### Memory Types
///
anx let GlobalM = mem.M addr_space_global;
anx let SharedM = mem.M addr_space_shared;
anx let ConstM  = mem.M addr_space_const;
anx let LocalM  = mem.M addr_space_local;
///
/// ### Pointer Types
///
anx lam GlobalPtr (T: *): * = mem.Ptr (T, addr_space_global);
anx lam SharedPtr (T: *): * = mem.Ptr (T, addr_space_shared);
anx lam ConstPtr (T: *): *  = mem.Ptr (T, addr_space_const);
anx lam LocalPtr (T: *): *  = mem.Ptr (T, addr_space_local);
///
/// ### Stream Types
///
/// An opaque handle - a pointer on every GPU runtime.
anx let Stream = mem.Ptr0 I8;
axm default_stream: Stream;
///
/// ## Operations
///
/// ### Context
///
/// #### init
///
/// Initializes the GPU runtime.
/// @todo Consider allowing multiple contexts and configuration of device number or context flags.
axm init: mem.M 0 → [mem.M 0, GlobalM, ConstM];
///
/// #### deinit
///
/// Deinitializes the GPU runtime.
axm deinit: [mem.M 0, GlobalM, ConstM] → mem.M 0;
///
/// #### auto_init / auto_deinit
///
/// The compiler-inserted counterparts of gpu.init / gpu.deinit.
/// gpu.lower_btensor_map_reduce uses these instead of calling gpu.init / gpu.deinit directly, so a
/// backend can recognize and collapse the sessions it creates without touching one that the user opened by hand.
axm auto_init: mem.M 0 → [mem.M 0, GlobalM, ConstM];
axm auto_deinit: [mem.M 0, GlobalM, ConstM] → mem.M 0;
///
/// ### Streams
///
/// #### stream_init
///
/// Initializes a stream.
axm stream_init: [mem.M 0, GlobalM, mem.Ptr0 Stream] → [mem.M 0, GlobalM];
///
/// #### stream_deinit
///
/// Deinitializes a stream.
axm stream_deinit: [mem.M 0, GlobalM, Stream] → [mem.M 0, GlobalM];
///
/// #### stream_sync
///
/// Waits for a stream to finish all its work.
axm stream_sync: [mem.M 0, GlobalM, Stream] → [mem.M 0, GlobalM];
///
/// #### with_streams
///
/// Provides `n` streams to `func` for executing asynchronous GPU operations, managing their initialization and teardown.
anx fun with_streams (n: Nat, func: Fn [mem.M 0, GlobalM, «n; Stream»] → [mem.M 0, GlobalM])
                     (m0: mem.M 0, m1: GlobalM)
                   : [mem.M 0, GlobalM] =
    // FIXME: `streams_ptr` is never freed.
    let (m0, streams_ptr) = mem.alloc («n; Stream», 0) m0;
    init (m0, m1)
    where
        con init (m0: mem.M 0, m1: GlobalM) =
            loop (m0, m1, 0)
            where
                con loop (m0: mem.M 0, m1: GlobalM, i: Nat) =
                    (run, body)#(core.ncmp.l (i, n)) (m0, m1)
                    where
                        con body (m0: mem.M 0, m1: GlobalM) =
                            let lea = mem.lea (streams_ptr, core.bitcast (Idx n) i);
                            let (m0, m1) = stream_init (m0, m1, lea);
                            loop (m0, m1, i + 1);
                    end;
            end;
        con run (m0: mem.M 0, m1: GlobalM) =
            let (m0, streams) = mem.load (m0, streams_ptr);
            ret (m0, m1) = func $ (m0, m1, streams);
            deinit (m0, m1);
        con deinit (m0: mem.M 0, m1: GlobalM) =
            let (m0, streams) = mem.load (m0, streams_ptr);
            loop (m0, m1, 0)
            where
                con loop (m0: mem.M 0, m1: GlobalM, i: Nat) =
                    (return, body)#(core.ncmp.l (i, n)) (m0, m1)
                    where
                        con body (m0: mem.M 0, m1: GlobalM) =
                            let idx = core.bitcast (Idx n) i;
                            let (m0, m1) = stream_deinit (m0, m1, streams#idx);
                            loop (m0, m1, i + 1);
                    end;
            end;
    end;
///
/// ### Blocking / Async Memory Operations
///
/// #### alloc(block) / alloc(asyn)
///
/// Allocates memory on the device (in global address space), synchronously (`block`) or asynchronously
/// against a stream (`asyn`).
pub mod alloc
    axm block: [T: *] → GlobalM → [GlobalM, GlobalPtr T];
    axm asyn:  [T: *] → [GlobalM, Stream] → [GlobalM, GlobalPtr T];
end
///
/// #### free(block) / free(asyn)
///
/// Frees memory on the device (in global address space), synchronously (`block`) or asynchronously
/// against a stream (`asyn`).
pub mod free
    axm block: {T: *} → [GlobalM, GlobalPtr T] → GlobalM;
    axm asyn:  {T: *} → [GlobalM, GlobalPtr T, Stream] → GlobalM;
end
///
/// #### copy_to_device(block) / copy_to_device(asyn)
///
/// Copies data from host memory to device memory, synchronously (`block`) or asynchronously against a
/// stream (`asyn`).
pub mod copy_to_device
    axm block: {T: *} → [mem.M 0, GlobalM, mem.Ptr0 T, GlobalPtr T] → [mem.M 0, GlobalM];
    axm asyn:  {T: *} → [mem.M 0, GlobalM, mem.Ptr0 T, GlobalPtr T, Stream] → [mem.M 0, GlobalM];
end
///
/// #### copy_to_host(block) / copy_to_host(asyn)
///
/// Copies data from device memory to host memory, synchronously (`block`) or asynchronously against a
/// stream (`asyn`).
pub mod copy_to_host
    axm block: {T: *} → [mem.M 0, GlobalM, GlobalPtr T, mem.Ptr0 T] → [mem.M 0, GlobalM];
    axm asyn:  {T: *} → [mem.M 0, GlobalM, GlobalPtr T, mem.Ptr0 T, Stream] → [mem.M 0, GlobalM];
end
///
/// #### alloc_copy(block) / alloc_copy(asyn)
///
/// Allocates memory on the device (in global address space) for the provided host data and copies the
/// host data to that memory, synchronously (`block`) or asynchronously against a stream (`asyn`).
pub mod alloc_copy
    anx lam block {T: *} (m0: mem.M 0, m1: GlobalM, ptr: mem.Ptr0 T): [mem.M 0, GlobalM, GlobalPtr T] =
        let (m1, d_ptr) = alloc.block T m1;
        let (m0, m1) = copy_to_device.block (m0, m1, ptr, d_ptr);
        (m0, m1, d_ptr);

    anx lam asyn {T: *} (m0: mem.M 0, m1: GlobalM, ptr: mem.Ptr0 T, stream: Stream)
                      : [mem.M 0, GlobalM, GlobalPtr T] =
        let (m1, d_ptr) = alloc.asyn T (m1, stream);
        let (m0, m1) = copy_to_device.asyn (m0, m1, ptr, d_ptr, stream);
        (m0, m1, d_ptr);
end
///
/// ### Buffer Operations
///
/// #### buf_alloc_copy
///
/// Placeholder for copying a host-side `buffer.Buf` to the device.
/// Unlike `gpu.alloc_copy(block)`, this operates directly on the still-abstract `buffer.Buf`.
axm buf_alloc_copy: {r: Nat, s: «r; Nat», T: *}
                  → [mem.M 0, GlobalM, buffer.Buf (r, s, T)]
                  → [mem.M 0, GlobalM, GlobalPtr «s; T»];
///
/// #### buf_copy_to_host
///
/// Placeholder for copying device data to a host-side `buffer.Buf`.
/// Unlike `gpu.copy_to_host(block)`, this operates directly on the still-abstract `buffer.Buf`.
axm buf_copy_to_host: {r: Nat, s: «r; Nat», T: *}
                  → [mem.M 0, GlobalM, GlobalPtr «s; T», buffer.Buf (r, s, T)]
                  → [mem.M 0, GlobalM];
///
/// ### Kernel Launch
///
/// #### launch
///
/// Launches a kernel function on the device with dynamic shared memory and module symbols.
// TODO: refactor to {n m: N, Ts: «n; *»} as soon as type inference bug is fixed
axm launch: {n: Nat, Ts: «n; *»}
          → [n_groups n_items: Nat, Stream, m: Bool, MT: «core.idx2nat m; *»]
          → Cn [GlobalM, SharedM, ConstM, LocalM, Idx n_groups, Idx n_items,
                «i: core.idx2nat m; SharedPtr MT#i», «i: n; Ts#i»,
                Cn [GlobalM, SharedM, ConstM, LocalM]]
          → «i: n; Ts#i»
          → Fn [mem.M 0, GlobalM, ConstM]
          → [mem.M 0, GlobalM, ConstM];
///
/// ### Work-Item Synchronization
///
/// #### sync_work_items
///
/// Low-level operation to synchronize all work-items in the same work-group.
axm sync_work_items: [GlobalM, SharedM] → [GlobalM, SharedM];
///
/// #### synced_scope
///
/// Runs `scope` bracketed by work-item synchronization: syncs, runs `scope`, and syncs again.
// TODO: consider variadic arguments and returns values for the scope
anx lam synced_scope (m1: GlobalM, m3: SharedM,
                      scope: [GlobalM, SharedM] → [GlobalM, SharedM])
                   : [GlobalM, SharedM] =
    let (m1, m3) = sync_work_items (m1, m3);
    let (m1, m3) = scope (m1, m3);
    let (m1, m3) = sync_work_items (m1, m3);
    (m1, m3);
///
/// ### Loop Binding
///
/// #### bind
///
/// Identity annotation on the body of an `affine.For`.
/// `gpu.outline` runs a `group`-bound loop one iteration per work-group, an `item`-bound loop one iteration per work-item,
/// and spreads a `cooperative` loop's iterations over the work-items of a work-group with a barrier before and after.
/// A `chained` loop is cooperative with no barrier at all: a later `fence` publishes its writes.
/// An `async` loop is chained, and its stores into shared memory become `store_async`; an `async_wait` before the `fence` publishes them.
///
/// A `warp` loop runs one iteration per warp of 32 work-items, which see their lane as `lane_id ()`.
///
axm bind.(group, item, cooperative, chained, async, warp): {T: *} → T → T;
///
/// #### lane_id
///
/// The work-item's lane in its warp inside a `warp` loop; `gpu.outline` resolves it.
///
axm lane_id: [] → I64;
///
/// #### store_async
///
/// Stores into shared memory like `mem.store`.
/// When the value is loaded from global memory right before, the copy may complete asynchronously, up to the next `async_wait`.
///
axm store_async: {T: *} → [mem.M 0, mem.Ptr0 T, T] → mem.M 0;
///
/// #### async_wait
///
/// Waits until the work-item's `store_async`s have completed; the writes are visible to the other work-items after the next `fence`.
///
axm async_wait: mem.M 0 → mem.M 0;
///
/// #### async_commit / async_wait_group
///
/// `async_commit` closes the group of the work-item's `store_async`s since the previous one.
/// `async_wait_group n` waits until at most `n` of its committed groups are still pending.
///
axm async_commit: mem.M 0 → mem.M 0;
axm async_wait_group: Nat → mem.M 0 → mem.M 0;
///
/// #### fence
///
/// Makes every work-item's writes before it visible after it; `gpu.outline` turns it into a `sync_work_items`.
///
axm fence: mem.M 0 → mem.M 0;
///
/// #### slot_shared
///
/// A statically sized shared-memory slot of the work-group, handed out as a generic pointer.
///
axm slot_shared: [T: *] → mem.M 0 → [mem.M 0, mem.Ptr (T, 0)];
///
/// #### shared_scope
///
/// Marks the allocation on this memory as shared by the work-group; `gpu.outline` turns it into a `slot_shared`.
///
axm shared_scope: mem.M 0 → mem.M 0;
///
/// #### generic_mem / global_mem
///
/// Convert between global memory and the generic `mem.M 0` an outlined kernel body threads; both erase to nothing.
///
axm generic_mem: GlobalM → mem.M 0;
axm global_mem: mem.M 0 → GlobalM;
///
/// ### Tensor Cores
///
/// The operations of this section are warp-collective: all 32 work-items of a warp execute them together.
///
/// #### mma_tf32
///
/// A warp's `D = A·B + C` on a 16×8×8 tile with TF32 inputs and F32 accumulation (`mma.sync.m16n8k8`).
/// Each work-item holds 4 elements of A, 2 of B and 4 of C and D in the fragment layout of the PTX ISA.
///
axm mma_tf32: [«4; math.F32», «2; math.F32», «4; math.F32»] → «4; math.F32»;

/// #### shfl_xor
///
/// The `x` of the work-item whose lane is this one's exclusive-or `mask`, across the full warp (`shfl.sync.bfly`).
///
axm shfl_xor: [x: math.F32, mask: I32] → math.F32;

/// #### tf32_rna
///
/// Rounds the significand of an F32 to the 10 bits of TF32, to nearest with ties away from zero (`cvt.rna.tf32.f32`).
/// `tf32_rna_ref` is its bit-level reference; Inf and NaN only lose their low 13 bits, as measured on sm_80.
///
axm tf32_rna: math.F32 → math.F32;

anx lam tf32_rna_ref (x: math.F32): math.F32 =
    let bits = core.bitcast I32 x;
    let mask = 0xFFFFE000I32;
    let special = core.icmp.e (core.bit2.and 0 (bits, 0x7F800000I32), 0x7F800000I32);
    let rounded = core.bit2.and 0 ((core.wrap.add 0 (bits, 0x1000I32), bits)#special, mask);
    core.bitcast math.F32 rounded;
///
/// #### ldmatrix
///
/// Loads `n` 8×4 matrices of 32-bit elements from shared memory (`ldmatrix.sync.m8n8.b16`).
/// Work-item `i` passes the address of row `i % 8` of matrix `i / 8` and receives element `(i / 4, i % 4)` of each matrix.
///
axm ldmatrix: {a: Nat} → [n: Nat, mem.M a, mem.Ptr («4; math.F32», a)] → [mem.M a, «n; math.F32»];
///
/// #### buf_ldmatrix
///
/// `ldmatrix` on the row of a work-group panel at `idx`; `buffer.lower_ptr` takes its address.
///
axm buf_ldmatrix: {r: Nat, s: «r; Nat»}
                → [n: Nat, mem.M 0, buffer.Buf (r, s, «4; math.F32»), idx: «i: r; Idx s#i»]
                → [mem.M 0, «n; math.F32»];
///
/// ## Phases
///
/// ### check_addr_spaces_repl
///
/// Rejects address-space misuse: `mem.malloc` / `mem.free` in the shared, const or local address space,
/// `mem.mslot` in the global or const one, and `mem.store` into the const one.
///
axm check_addr_spaces_repl: compile.Phase;
///
/// ### host_malloc2gpualloc_repl
///
/// Rewrites `mem.malloc` / `mem.free` in the global address space into `gpu.alloc` / `gpu.free`.
///
axm host_malloc2gpualloc_repl: compile.Phase;
///
/// ### mem_checks
///
/// Rejects `mem.M` crossing a device boundary — passed to a `gpu.launch` kernel, or taken/returned
/// by `main` with a non-zero address space.
///
axm mem_checks: compile.Phase;
///
/// ### Work-group phases
///
/// A work-group's shared memory moves through supersteps: `Synced`, `Writing` its panels, then `Reading` them, and
/// possibly `Updating` claimed panels in place.
/// `GM (g, e, p)` is the memory of construct `g` in phase `p` of its `e`-th superstep, and `SharedBuf (g, e, v, …)` a panel
/// it fills; their indices keep a token or panel of another construct, superstep or phase out.
/// An `Empty` panel can only be filled, an `Unpublished` one only published and a `Published` one only read or claimed.
/// An `Owned` panel is updated in place: each work-item rewrites only elements no other work-item reads or writes in
/// that superstep, which nothing verifies.
/// `check_sync` checks the linear use these types cannot express, and `erase_phases` lowers them to `mem.M 0`,
/// `buffer.Buf` and `fence`s.
///
anx nom GroupPhase = | Synced | Writing | Reading | Updating;
anx nom Vis = | Empty | Unpublished | Published | Owned;
axm GM: [g e: Nat, p: GroupPhase] → *;
axm SharedBuf: [g e: Nat, v: Vis, r: Nat, s: «r; Nat», T: *] → *;
/// Enters construct `g` behind a barrier, so earlier readers of the memory it fills are done.
axm group_enter: {g: Nat} → mem.M 0 → GM (g, 0, GroupPhase#Synced);
axm enter_write: {g e: Nat} → GM (g, e, GroupPhase#Synced) → GM (g, e, GroupPhase#Writing);
/// Nothing is pending behind a barrier, so reading starts at once.
axm enter_read: {g e: Nat} → GM (g, e, GroupPhase#Synced) → GM (g, e, GroupPhase#Reading);
/// Claimed panels were never read in this superstep, so updating them starts at once.
axm enter_update: {g e: Nat} → GM (g, e, GroupPhase#Reading) → GM (g, e, GroupPhase#Updating);
/// A barrier: the superstep's fills are visible to every work-item after it.
axm sync_publish: {g e: Nat} → GM (g, e, GroupPhase#Writing) → GM (g, e, GroupPhase#Reading);
/// A barrier: the superstep's reads are done, so the next one may overwrite its panels.
axm sync_reclaim: {g e: Nat} → GM (g, e, GroupPhase#Reading) → GM (g, e + 1, GroupPhase#Synced);
axm group_leave: {g e: Nat} → GM (g, e, GroupPhase#Synced) → mem.M 0;
/// Leaves while panels may still be read; the next `group_enter` waits for those readers.
axm leave_reading: {g e: Nat} → GM (g, e, GroupPhase#Reading) → mem.M 0;
axm shared_panel: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
                → GM (g, e, GroupPhase#Writing) → [GM (g, e, GroupPhase#Writing), SharedBuf (g, e, Vis#Empty, r, s, T)];
/// The work-items fill the panel together with `fill`, each writing elements no other one writes.
axm coop_fill: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
             → [GM (g, e, GroupPhase#Writing), SharedBuf (g, e, Vis#Empty, r, s, T),
                fill: [mem.M 0, buffer.Buf (r, s, T)] → [mem.M 0, buffer.Buf (r, s, T)]]
             → [GM (g, e, GroupPhase#Writing), SharedBuf (g, e, Vis#Unpublished, r, s, T)];
axm publish_view: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
                → [GM (g, e, GroupPhase#Reading), SharedBuf (g, e, Vis#Unpublished, r, s, T)]
                → SharedBuf (g, e, Vis#Published, r, s, T);
axm view: {g e: Nat} → {r: Nat, s: «r; Nat», T: *} → SharedBuf (g, e, Vis#Published, r, s, T) → buffer.Buf (r, s, T);
/// Takes a published panel over for in-place updates.
axm claim: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
         → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Published, r, s, T)]
         → SharedBuf (g, e, Vis#Owned, r, s, T);
/// The work-items update the claimed panel with `body`, each only its own elements.
axm owned_update: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
                → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Owned, r, s, T),
                   body: [mem.M 0, buffer.Buf (r, s, T)] → mem.M 0]
                → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Owned, r, s, T)];
/// A barrier: the updates are visible, and the panel is published to the next superstep.
axm sync_carry: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
              → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Owned, r, s, T)]
              → [GM (g, e + 1, GroupPhase#Synced), SharedBuf (g, e + 1, Vis#Published, r, s, T)];
/// Runs `body` on the memory while the published panels are read.
axm read_phase: {g e: Nat} → {R: *}
              → [GM (g, e, GroupPhase#Reading), body: mem.M 0 → [mem.M 0, R]] → [GM (g, e, GroupPhase#Reading), R];
/// Rejects a token or an unpublished, owned or claimed panel used other than exactly once, a panel or token outside the
/// function that made it, and a construct entered twice.
axm check_sync: compile.Phase;
axm erase_phases: compile.Phase;
///
/// ### remove_double_syncs
///
/// Drops a `sync_work_items` whose memories come from the immediately preceding sync or from the
/// kernel entry.
///
axm remove_double_syncs: compile.Phase;
///
/// ### split_apply
///
/// Splits the kernels off into a device world, then runs `host_specific_phases` on the host world and
/// `device_specific_phases` on the device world.
///
axm split_apply: compile.Phase;
///
/// ### lower_btensor_map_reduce
///
/// Lowers `btensor.map_reduce_post` to a kernel launch; skipped if the program already contains an
/// explicit `init`.
///
axm lower_btensor_map_reduce: compile.Phase;
///
/// ### outline
///
/// Outlines each `affine.For` whose body is `gpu.bind.group` into a `gpu.launch`: one work-group per iteration and one work-item per iteration of the enclosed `gpu.bind.item` loop.
/// Captured host pointers are copied to the device before the launch and back afterwards.
///
axm outline: compile.Phase;
///
/// ### Pipelines
///
/// The two sub-pipelines `split_apply` runs on the worlds it has just split apart; override them to
/// plug target-specific phases into either side.
///
anx lam host_specific_phases () = host_malloc2gpualloc_repl;
anx lam device_specific_phases () = remove_double_syncs;
