/// # The gpu Plugin {#gpu}
///
/// @see mim::plug::gpu
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
plugin mem;
plugin buffer;
plugin math;
plugin vec;
plugin cps;
plugin affine;
import compile;

use core.ops.n;
///
/// ## Types
///
/// ### Address Spaces
///
/// Address space numbers correlate to the ones used by LLVM.
/// @see
///
/// - [User Guide for NVPTX Back-end](https://llvm.org/docs/NVPTXUsage.html#address-spaces)
/// - [User Guide for AMDGPU Backend](https://llvm.org/docs/AMDGPUUsage.html#address-spaces)
///
anx let addr_space_global = 1;
anx let addr_space_shared = 3;
anx let addr_space_const  = 4;
anx let addr_space_local  = 5;
///
/// ### Memory Types
///
anx let GlobalM = mem.M addr_space_global;
anx let SharedM = mem.M addr_space_shared;
anx let ConstM  = mem.M addr_space_const;
anx let LocalM  = mem.M addr_space_local;
///
/// ### Pointer Types
///
anx lam GlobalPtr (T: *): * = mem.Ptr (T, addr_space_global);
anx lam SharedPtr (T: *): * = mem.Ptr (T, addr_space_shared);
anx lam ConstPtr (T: *): *  = mem.Ptr (T, addr_space_const);
anx lam LocalPtr (T: *): *  = mem.Ptr (T, addr_space_local);
///
/// ### Stream Types
///
/// An opaque handle - a pointer on every GPU runtime.
anx let Stream = mem.Ptr0 I8;
axm default_stream: Stream;
///
/// ## Operations
///
/// ### Context
///
/// #### init
///
/// Initializes the GPU runtime.
/// @todo Consider allowing multiple contexts and configuration of device number or context flags.
axm init: mem.M 0 → [mem.M 0, GlobalM, ConstM];
///
/// #### deinit
///
/// Deinitializes the GPU runtime.
axm deinit: [mem.M 0, GlobalM, ConstM] → mem.M 0;
///
/// #### auto_init / auto_deinit
///
/// The compiler-inserted counterparts of gpu.init / gpu.deinit.
/// gpu.lower_btensor_map_reduce uses these instead of calling gpu.init / gpu.deinit directly, so a
/// backend can recognize and collapse the sessions it creates without touching one that the user opened by hand.
axm auto_init: mem.M 0 → [mem.M 0, GlobalM, ConstM];
axm auto_deinit: [mem.M 0, GlobalM, ConstM] → mem.M 0;
///
/// ### Streams
///
/// #### stream_init
///
/// Initializes a stream.
axm stream_init: [mem.M 0, GlobalM, mem.Ptr0 Stream] → [mem.M 0, GlobalM];
///
/// #### stream_deinit
///
/// Deinitializes a stream.
axm stream_deinit: [mem.M 0, GlobalM, Stream] → [mem.M 0, GlobalM];
///
/// #### stream_sync
///
/// Waits for a stream to finish all its work.
axm stream_sync: [mem.M 0, GlobalM, Stream] → [mem.M 0, GlobalM];
///
/// #### with_streams
///
/// Provides `n` streams to `func` for executing asynchronous GPU operations, managing their initialization and teardown.
anx fun with_streams (n: Nat, func: Fn [mem.M 0, GlobalM, «n; Stream»] → [mem.M 0, GlobalM])
                     (m0: mem.M 0, m1: GlobalM)
                   : [mem.M 0, GlobalM] =
    // FIXME: `streams_ptr` is never freed.
    let (m0, streams_ptr) = mem.alloc («n; Stream», 0) m0;
    init (m0, m1)
    where
        con init (m0: mem.M 0, m1: GlobalM) =
            loop (m0, m1, 0)
            where
                con loop (m0: mem.M 0, m1: GlobalM, i: Nat) =
                    (run, body)#(core.ncmp.l (i, n)) (m0, m1)
                    where
                        con body (m0: mem.M 0, m1: GlobalM) =
                            let lea = mem.lea (streams_ptr, core.bitcast (Idx n) i);
                            let (m0, m1) = stream_init (m0, m1, lea);
                            loop (m0, m1, i + 1);
                    end;
            end;
        con run (m0: mem.M 0, m1: GlobalM) =
            let (m0, streams) = mem.load (m0, streams_ptr);
            ret (m0, m1) = func $ (m0, m1, streams);
            deinit (m0, m1);
        con deinit (m0: mem.M 0, m1: GlobalM) =
            let (m0, streams) = mem.load (m0, streams_ptr);
            loop (m0, m1, 0)
            where
                con loop (m0: mem.M 0, m1: GlobalM, i: Nat) =
                    (return, body)#(core.ncmp.l (i, n)) (m0, m1)
                    where
                        con body (m0: mem.M 0, m1: GlobalM) =
                            let idx = core.bitcast (Idx n) i;
                            let (m0, m1) = stream_deinit (m0, m1, streams#idx);
                            loop (m0, m1, i + 1);
                    end;
            end;
    end;
///
/// ### Blocking / Async Memory Operations
///
/// #### alloc(block) / alloc(asyn)
///
/// Allocates memory on the device (in global address space), synchronously (`block`) or asynchronously
/// against a stream (`asyn`).
pub mod alloc
    axm block: [T: *] → GlobalM → [GlobalM, GlobalPtr T];
    axm asyn:  [T: *] → [GlobalM, Stream] → [GlobalM, GlobalPtr T];
end
///
/// #### free(block) / free(asyn)
///
/// Frees memory on the device (in global address space), synchronously (`block`) or asynchronously
/// against a stream (`asyn`).
pub mod free
    axm block: {T: *} → [GlobalM, GlobalPtr T] → GlobalM;
    axm asyn:  {T: *} → [GlobalM, GlobalPtr T, Stream] → GlobalM;
end
///
/// #### copy_to_device(block) / copy_to_device(asyn)
///
/// Copies data from host memory to device memory, synchronously (`block`) or asynchronously against a
/// stream (`asyn`).
pub mod copy_to_device
    axm block: {T: *} → [mem.M 0, GlobalM, mem.Ptr0 T, GlobalPtr T] → [mem.M 0, GlobalM];
    axm asyn:  {T: *} → [mem.M 0, GlobalM, mem.Ptr0 T, GlobalPtr T, Stream] → [mem.M 0, GlobalM];
end
///
/// #### copy_to_host(block) / copy_to_host(asyn)
///
/// Copies data from device memory to host memory, synchronously (`block`) or asynchronously against a
/// stream (`asyn`).
pub mod copy_to_host
    axm block: {T: *} → [mem.M 0, GlobalM, GlobalPtr T, mem.Ptr0 T] → [mem.M 0, GlobalM];
    axm asyn:  {T: *} → [mem.M 0, GlobalM, GlobalPtr T, mem.Ptr0 T, Stream] → [mem.M 0, GlobalM];
end
///
/// #### alloc_copy(block) / alloc_copy(asyn)
///
/// Allocates memory on the device (in global address space) for the provided host data and copies the
/// host data to that memory, synchronously (`block`) or asynchronously against a stream (`asyn`).
pub mod alloc_copy
    anx lam block {T: *} (m0: mem.M 0, m1: GlobalM, ptr: mem.Ptr0 T): [mem.M 0, GlobalM, GlobalPtr T] =
        let (m1, d_ptr) = alloc.block T m1;
        let (m0, m1) = copy_to_device.block (m0, m1, ptr, d_ptr);
        (m0, m1, d_ptr);

    anx lam asyn {T: *} (m0: mem.M 0, m1: GlobalM, ptr: mem.Ptr0 T, stream: Stream)
                      : [mem.M 0, GlobalM, GlobalPtr T] =
        let (m1, d_ptr) = alloc.asyn T (m1, stream);
        let (m0, m1) = copy_to_device.asyn (m0, m1, ptr, d_ptr, stream);
        (m0, m1, d_ptr);
end
///
/// ### Buffer Operations
///
/// #### buf_alloc_copy
///
/// Placeholder for copying a host-side `buffer.Buf` to the device.
/// Unlike `gpu.alloc_copy(block)`, this operates directly on the still-abstract `buffer.Buf`.
axm buf_alloc_copy: {r: Nat, s: «r; Nat», T: *}
                  → [mem.M 0, GlobalM, buffer.Buf (r, s, T)]
                  → [mem.M 0, GlobalM, GlobalPtr «s; T»];
///
/// #### buf_copy_to_host
///
/// Placeholder for copying device data to a host-side `buffer.Buf`.
/// Unlike `gpu.copy_to_host(block)`, this operates directly on the still-abstract `buffer.Buf`.
axm buf_copy_to_host: {r: Nat, s: «r; Nat», T: *}
                  → [mem.M 0, GlobalM, GlobalPtr «s; T», buffer.Buf (r, s, T)]
                  → [mem.M 0, GlobalM];
///
/// ### Kernel Launch
///
/// #### launch
///
/// Launches a kernel function on the device with dynamic shared memory and module symbols.
// TODO: refactor to {n m: N, Ts: «n; *»} as soon as type inference bug is fixed
axm launch: {n: Nat, Ts: «n; *»}
          → [n_groups n_items: Nat, Stream, m: Bool, MT: «core.idx2nat m; *»]
          → Cn [GlobalM, SharedM, ConstM, LocalM, Idx n_groups, Idx n_items,
                «i: core.idx2nat m; SharedPtr MT#i», «i: n; Ts#i»,
                Cn [GlobalM, SharedM, ConstM, LocalM]]
          → «i: n; Ts#i»
          → Fn [mem.M 0, GlobalM, ConstM]
          → [mem.M 0, GlobalM, ConstM];
///
/// ### Work-Item Synchronization
///
/// #### sync_work_items
///
/// Low-level operation to synchronize all work-items in the same work-group.
axm sync_work_items: [GlobalM, SharedM] → [GlobalM, SharedM];
///
/// #### synced_scope
///
/// Runs `scope` bracketed by work-item synchronization: syncs, runs `scope`, and syncs again.
// TODO: consider variadic arguments and returns values for the scope
anx lam synced_scope (m1: GlobalM, m3: SharedM,
                      scope: [GlobalM, SharedM] → [GlobalM, SharedM])
                   : [GlobalM, SharedM] =
    let (m1, m3) = sync_work_items (m1, m3);
    let (m1, m3) = scope (m1, m3);
    let (m1, m3) = sync_work_items (m1, m3);
    (m1, m3);
///
/// ### Loop Binding
///
/// #### bind
///
/// Identity annotation on the body of an `affine.For`.
/// `gpu.outline` runs a `group`-bound loop one iteration per work-group, an `item`-bound loop one iteration per work-item,
/// and spreads a `cooperative` loop's iterations over the work-items of a work-group with a barrier before and after.
/// A `chained` loop is cooperative with no barrier at all: a later `fence` publishes its writes.
/// An `async` loop is chained, and its stores into shared memory become `store_async`; an `async_wait` before the `fence` publishes them.
///
/// A `warp` loop runs one iteration per warp of 32 work-items, which see their lane as `lane_id ()`.
/// A `warpgroup` loop runs one iteration per warpgroup of four consecutive warps, which see their lane and their warp's
/// rank in the warpgroup as `warp_rank ()`.
/// A `specialized` loop is a `warpgroup` loop whose last iteration runs on a single warp, a producer that needs fewer
/// work-items than the others.
///
axm bind.(group, item, cooperative, chained, async, warp, warpgroup, specialized): {T: *} → T → T;
///
/// #### lane_id
///
/// The work-item's lane in its warp inside a `warp` loop; `gpu.outline` resolves it.
///
axm lane_id: [] → I64;
///
/// #### warp_rank
///
/// The work-item's warp's rank, 0 to 3, in its warpgroup inside a `warpgroup` loop; `gpu.outline` resolves it.
///
axm warp_rank: [] → I64;
///
/// #### leader
///
/// Whether this is work-item 0 of its work-group, which issues the work-group's TMA copies; `gpu.outline` resolves it.
///
axm leader: [] → Bool;
///
/// #### item_index
///
/// The work-item's index in its work-group; `gpu.outline` resolves it.
///
axm item_index: [] → I64;
///
/// #### store_async
///
/// Stores into shared memory like `mem.store`.
/// When the value is loaded from global memory right before, the copy may complete asynchronously, up to the next `async_wait`.
///
axm store_async: {T: *} → [mem.M 0, mem.Ptr0 T, T] → mem.M 0;
///
/// #### async_wait
///
/// Waits until the work-item's `store_async`s have completed; the writes are visible to the other work-items after the next `fence`.
///
axm async_wait: mem.M 0 → mem.M 0;
///
/// #### async_commit / async_wait_group
///
/// `async_commit` closes the group of the work-item's `store_async`s since the previous one.
/// `async_wait_group n` waits until at most `n` of its committed groups are still pending.
///
axm async_commit: mem.M 0 → mem.M 0;
axm async_wait_group: Nat → mem.M 0 → mem.M 0;
///
/// #### fence
///
/// Makes every work-item's writes before it visible after it; `gpu.outline` turns it into a `sync_work_items`.
///
axm fence: mem.M 0 → mem.M 0;
///
/// #### slot_shared
///
/// A statically sized shared-memory slot of the work-group, handed out as a generic pointer.
///
axm slot_shared: [T: *] → mem.M 0 → [mem.M 0, mem.Ptr (T, 0)];
///
/// #### shared_scope
///
/// Marks the allocation on this memory as shared by the work-group; `gpu.outline` turns it into a `slot_shared`.
///
axm shared_scope: mem.M 0 → mem.M 0;
///
/// #### panel_scope
///
/// Marks the allocation on this memory as a panel of construct `g`, empty when `g` enters and dead once it leaves.
/// `gpu.outline` turns it into a `slot_shared` that keeps the mark, so the panels of different constructs may share
/// storage: constructs never nest and each enters behind a barrier.
///
axm panel_scope: {g: Nat} → mem.M 0 → mem.M 0;
///
/// #### generic_mem / global_mem
///
/// Convert between global memory and the generic `mem.M 0` an outlined kernel body threads; both erase to nothing.
///
axm generic_mem: GlobalM → mem.M 0;
axm global_mem: mem.M 0 → GlobalM;
///
/// ### Tensor Cores
///
/// The operations of this section are warp-collective: all 32 work-items of a warp execute them together.
///
/// #### mma_tf32
///
/// A warp's `D = A·B + C` on a 16×8×8 tile with TF32 inputs and F32 accumulation (`mma.sync.m16n8k8`).
/// Each work-item holds 4 elements of A, 2 of B and 4 of C and D in the fragment layout of the PTX ISA.
///
axm mma_tf32: [«4; math.F32», «2; math.F32», «4; math.F32»] → «4; math.F32»;
///
/// #### mma_f16, mma_bf16
///
/// A warp's `D = A·B + C` on a 16×8×16 tile with F16 or BF16 inputs and F32 accumulation (`mma.sync.m16n8k16`).
/// Each work-item holds 4 pairs of A, 2 pairs of B and 4 elements of C and D; a pair is one 32-bit register.
///
axm mma_f16: [«4, 2; math.F16», «2, 2; math.F16», «4; math.F32»] → «4; math.F32»;
axm mma_bf16: [«4, 2; math.BF16», «2, 2; math.BF16», «4; math.F32»] → «4; math.F32»;

/// #### shfl_xor
///
/// The `x` of the work-item whose lane is this one's exclusive-or `mask`, across the full warp (`shfl.sync.bfly`).
///
axm shfl_xor: [x: math.F32, mask: I32] → math.F32;

/// #### shfl_idx
///
/// The `x` of the work-item in lane `src`, across the full warp (`shfl.sync.idx`).
///
axm shfl_idx: [x: math.F32, src: I32] → math.F32;
///
/// ### Warpgroup Tensor Cores
///
/// A warpgroup is four consecutive warps of a work-group whose first warp index is a multiple of 4; the operations of this section are collective over it.
/// `wgmma` reads A and B from shared memory through descriptors and accumulates asynchronously: the accumulator it returns may only be read after a `wgmma_wait` that passes it through.
/// Warp `w` of the warpgroup holds rows `16 w .. 16 w + 15` of the 64-row accumulator in the layout of `mma.m16n8k8`'s C, tile `j` covering columns `8 j .. 8 j + 7`.
///
/// #### shared_addr
///
/// The byte address of a shared-memory pointer in the shared window.
///
axm shared_addr: {T: *} → {a: Nat} → mem.Ptr (T, a) → I32;
///
/// #### wgmma_desc
///
/// The matrix descriptor of a tile at shared byte address `addr`: core matrices of 8 rows × 16 bytes, `lbo` and `sbo` bytes apart along the leading and the strided dimension, `swizzle` 0 (none), 1 (128 B), 2 (64 B) or 3 (32 B).
/// A swizzled tile's atoms of 8 rows must start 1 KiB aligned.
///
pub anx lam wgmma_desc (addr: I32, lbo sbo swizzle: I64): I64 =
    let field = λ (x: I64, at: I64): I64 = core.wrap.shl 0 (core.bit2.and 0 (core.shr.l (x, 4I64), 0x3FFFI64), at);
    core.bit2.or 0 (core.bit2.or 0 (field (core.conv.u 0 addr, 0I64), field (lbo, 16I64)),
                    core.bit2.or 0 (field (sbo, 32I64), core.wrap.shl 0 (swizzle, 62I64)));
///
/// #### wgmma_f16, wgmma_bf16
///
/// `D = A·B + C` on a 64×(8 nt)×16 tile with F16 or BF16 inputs from the descriptors `a` and `b` and F32 accumulation (`wgmma.mma_async.m64nNk16`).
/// A is K-major; B is K-major unless `trans_b`, then MN-major.
///
axm wgmma_f16: [nt: Nat, mem.M 0, a b: I64, trans_b: Bool, «nt, 4; math.F32»] → [mem.M 0, «nt, 4; math.F32»];
axm wgmma_bf16: [nt: Nat, mem.M 0, a b: I64, trans_b: Bool, «nt, 4; math.F32»] → [mem.M 0, «nt, 4; math.F32»];
///
/// #### wgmma_rs_f16, wgmma_rs_bf16
///
/// `wgmma_f16`/`wgmma_bf16` with A from registers: warp `w` passes rows `16 w .. 16 w + 15` of the 64×16 A in the A layout of `mma_f16`.
///
axm wgmma_rs_f16: [nt: Nat, mem.M 0, a: «4, 2; math.F16», b: I64, trans_b: Bool, «nt, 4; math.F32»] → [mem.M 0, «nt, 4; math.F32»];
axm wgmma_rs_bf16: [nt: Nat, mem.M 0, a: «4, 2; math.BF16», b: I64, trans_b: Bool, «nt, 4; math.F32»] → [mem.M 0, «nt, 4; math.F32»];
///
/// #### wgmma_fence, wgmma_commit, wgmma_wait
///
/// `wgmma_fence` orders prior register and shared-memory accesses before the following `wgmma`s (`wgmma.fence`).
/// `wgmma_commit` closes the group of the `wgmma`s issued since the last one (`wgmma.commit_group`).
/// `wgmma_wait` waits until at most `n` groups are pending and passes `x`, the accumulators they wrote and the register operands they read (`wgmma.wait_group`).
///
axm wgmma_fence: mem.M 0 → mem.M 0;
axm wgmma_commit: mem.M 0 → mem.M 0;
axm wgmma_wait: {T: *} → [mem.M 0, n: Nat, x: T] → [mem.M 0, T];
///
/// #### fence_proxy_async
///
/// Makes this work-item's prior generic-proxy writes to shared memory visible to the async proxy that `wgmma` and TMA read through (`fence.proxy.async.shared::cta`).
///
axm fence_proxy_async: mem.M 0 → mem.M 0;
///
/// ### Asynchronous Barriers and Tensor Copies
///
/// An mbarrier is a 64-bit object in shared memory.
/// Its current phase completes once `count` arrivals and all expected transaction bytes have arrived; then the next phase begins, with the parity flipped.
///
/// #### mbar_init, mbar_arrive, mbar_expect_tx, mbar_wait
///
/// `mbar_init` sets up `bar` for `count` arrivals per phase; other work-items see it after the next barrier.
/// `mbar_arrive` arrives once; `mbar_expect_tx` arrives once and expects `bytes` more of asynchronous copies in the current phase.
/// `mbar_wait` waits until the phase of parity `parity` has completed.
///
axm mbar_init: [mem.M 0, bar: mem.Ptr0 I64, count: I32] → mem.M 0;
axm mbar_arrive: [mem.M 0, bar: mem.Ptr0 I64] → mem.M 0;
axm mbar_expect_tx: [mem.M 0, bar: mem.Ptr0 I64, bytes: I32] → mem.M 0;
axm mbar_wait: [mem.M 0, bar: mem.Ptr0 I64, parity: I32] → mem.M 0;
///
/// #### tensor_map
///
/// On the host: encodes into `map` the TMA descriptor of a row-major `rows × cols` matrix of `E` at device address `base`, copied in boxes of `box_rows × box_cols` with 128-byte swizzle (`cuTensorMapEncodeTiled`).
/// A kernel uses a copy of `map` in device memory.
///
axm tensor_map: [E: *] → {X: *} → [mem.M 0, map: mem.Ptr0 «16; I64», base: mem.Ptr (X, 1), rows cols: I64, box_rows box_cols: I32] → mem.M 0;
///
/// #### tma_load
///
/// Copies the box at column `col` and row `row` of the tensor that `map` describes to `dst` in shared memory, and counts its bytes as transactions on `bar` (`cp.async.bulk.tensor.2d`).
/// One work-item issues it; `dst` must be 1 KiB aligned.
///
axm tma_load: {T: *} → {a: Nat} → [mem.M 0, dst: mem.Ptr0 T, map: mem.Ptr («16; I64», a), col row: I32, bar: mem.Ptr0 I64] → mem.M 0;
///
/// #### sync_named, arrive_named
///
/// Barrier `id` (1 to 15) of `count` work-items, a multiple of 32: `sync_named` arrives and waits, `arrive_named` only arrives (`bar.sync`, `bar.arrive`).
///
axm sync_named: [mem.M 0, id count: I32] → mem.M 0;
axm arrive_named: [mem.M 0, id count: I32] → mem.M 0;
///
/// #### setmaxnreg
///
/// Raises (`inc`) or lowers the warpgroup's per-thread register budget to `n`, a multiple of 8 from 24 to 256 (`setmaxnreg`).
///
axm setmaxnreg: [mem.M 0, inc: Bool, n: Nat] → mem.M 0;
///
/// #### reg_budget
///
/// Marks the kernel it is in as compiled for at most `n` registers per work-item at entry (`.maxnreg`), the count that
/// `setmaxnreg` redistributes between warpgroups.
///
axm reg_budget: Nat → mem.M 0 → mem.M 0;
///
/// #### mbar_init_if, mbar_expect_tx_if, mbar_wait_at, tma_load_if
///
/// `mbar_init`, `mbar_expect_tx`, `mbar_wait` and `tma_load` on the mbarrier and the destination at shared addresses; the
/// `_if` forms take effect only in work-items whose `issue` holds, so the work-group runs them without branching.
///
axm mbar_init_if: [mem.M 0, bar: I32, count: I32, issue: Bool] → mem.M 0;
axm mbar_expect_tx_if: [mem.M 0, bar: I32, bytes: I32, issue: Bool] → mem.M 0;
axm mbar_wait_at: [mem.M 0, bar: I32, parity: I32] → mem.M 0;
axm tma_load_if: [mem.M 0, dst: I32, map: GlobalPtr «16; I64», col row: I32, bar: I32, issue: Bool] → mem.M 0;
///
/// ### Thread-Block Clusters
///
/// A cluster is `size` consecutive work-groups that run together and can write each other's shared memory.
///
/// #### cluster_size, cluster_rank, sync_cluster, fence_mbarrier_init
///
/// `cluster_size n` marks the kernel it is in as launched in clusters of `n` work-groups (`.reqnctapercluster`); `n` divides the work-group count.
/// `cluster_rank` is the work-group's rank in its cluster; `sync_cluster` is a barrier of all work-items of the cluster that publishes their shared-memory writes (`barrier.cluster`).
/// `fence_mbarrier_init` makes this work-item's mbarrier initializations visible to the cluster.
///
axm cluster_size: Nat → mem.M 0 → mem.M 0;
axm cluster_rank: [] → I32;
axm sync_cluster: mem.M 0 → mem.M 0;
axm fence_mbarrier_init: mem.M 0 → mem.M 0;
///
/// #### tma_load_multicast_if
///
/// `tma_load_if` that writes the box to the same shared address in each work-group of the cluster whose rank is set in `mask`, completing the mbarrier at `bar` in each.
///
axm tma_load_multicast_if: [mem.M 0, dst: I32, map: GlobalPtr «16; I64», col row: I32, bar: I32, mask: I32, issue: Bool] → mem.M 0;
///
/// #### tma_fill
///
/// A panel a fill copies by TMA: `rows × cols` elements of `bytes` each of the matrix `map` describes, from its element
/// `(row, col)`, to the shared address `base`.
/// A row splits into atoms of 128 bytes, one box each, stacked `rows · 128` bytes apart.
/// With more than one of `shares`, each work-group of a cluster of that size copies its share of the rows into all of them.
///
let TmaPanel = [base: I32, map: GlobalPtr «16; I64», row col: I32, rows cols bytes shares: Nat];
lam tma_panel (bar: I32, issue: Bool) (m: mem.M 0, p: TmaPanel): mem.M 0 =
    let (base, map, row, col, rows, cols, bytes, shares) = p;
    let word   = core.idx 0 0x100000000;
    let atom  = 128 / bytes;
    let atoms = cols / atom;
    let share = rows / shares;
    let multi = 1 < shares;
    let rank  = cluster_rank ();
    let row   = core.select (multi, core.wrap.add 0 (row, core.wrap.mul 0 (rank, word share)), row);
    let skip  = core.select (multi, core.wrap.mul 0 (rank, word (share * 128)), 0I32);
    let all   = vec.fold.r @(Nat, Idx shares) @shares (λ (_: Idx shares, x: Nat): Nat = 2 * x) (‹r: shares; r›, 1) - 1;
    vec.fold.l @(mem.M 0, Idx atoms) @atoms
        (λ (m: mem.M 0, a: Idx atoms): mem.M 0 =
            let k   = core.idx2nat a;
            let dst = core.wrap.add 0 (core.wrap.add 0 (base, word (k * rows * 128)), skip);
            let c   = core.wrap.add 0 (col, word (k * atom));
            (tma_load_if (m, dst, map, c, row, bar, issue),
             tma_load_multicast_if (m, dst, map, c, row, bar, word all, issue))#multi)
        (m, ‹a: atoms; a›);
/// One fill of a ring slot: the mbarrier at `bar` expects the bytes of all `panels`, which the copies then complete, so
/// what is expected is what is copied; the work-items `issue` selects start them.
anx lam tma_fill {n: Nat} (panels: «n; TmaPanel», bar: I32, issue: Bool) (m: mem.M 0): mem.M 0 =
    let bytes = vec.fold.r @(Nat, TmaPanel) @n (λ (p: TmaPanel, x: Nat): Nat = x + p#rows * p#cols * p#bytes) (panels, 0);
    vec.fold.l @(mem.M 0, TmaPanel) @n (tma_panel (bar, issue))
        (mbar_expect_tx_if (m, bar, core.idx 0 0x100000000 bytes, issue), panels);
///
/// #### mbar_arrive_cluster_if, mbar_wait_if
///
/// `mbar_arrive_cluster_if` arrives once on the mbarrier at shared address `bar` of the cluster's work-group `rank`.
/// It orders no memory access: it says a slot was read, and what is read was written through the async proxy.
/// `mbar_wait_if` is `mbar_wait_at` in the work-items whose `issue` holds.
///
axm mbar_arrive_cluster_if: [mem.M 0, bar: I32, rank: I32, issue: Bool] → mem.M 0;
///
/// #### load_peer
///
/// Loads the F32 at shared address `addr` of the cluster's work-group `rank` through distributed shared memory (`mapa`, `ld.shared::cluster`).
/// Its writes there are visible after a `sync_cluster` that follows them.
///
axm load_peer: [mem.M 0, addr: I32, rank: I32] → [mem.M 0, math.F32];
axm mbar_wait_if: [mem.M 0, bar: I32, parity: I32, issue: Bool] → mem.M 0;
///
/// #### mbar_arrive_if, arrive_named_if
///
/// `mbar_arrive` on the mbarrier at shared address `bar`, and `arrive_named`, in the work-items whose `issue` holds.
///
axm mbar_arrive_if: [mem.M 0, bar: I32, issue: Bool] → mem.M 0;
axm arrive_named_if: [mem.M 0, id count: I32, issue: Bool] → mem.M 0;
///
/// #### device_tensor_map, buf_tensor_map
///
/// The TMA descriptor, in device memory, of the row-major `rows × cols` matrix of `E` at device address `base`, copied in
/// boxes of `box_rows × box_cols` with 128-byte swizzle; the host computes it before the launch that uses it.
/// `buf_tensor_map` is it for a device buffer of rank 2; `buffer.lower_ptr` takes its address.
///
axm device_tensor_map: {E: *} → {X: *} → {a: Nat} → [base: mem.Ptr (X, a), rows cols box_rows box_cols: Nat] → GlobalPtr «16; I64»;
axm buf_tensor_map: {T: *} → {s: «2; Nat»} → [buffer.Buf (2, s, T), box_rows box_cols: Nat] → GlobalPtr «16; I64»;

/// #### lanes
///
/// The warp's value made of every work-item's `x`, component `self` being this one's: a warp program's input.
/// A warp program is a function on such `«32; T»` values, `tensor.warp`'s functions and `tensor.mma_warp` among them;
/// `tensor.distribute` keeps each lane's component, so reading component `self` is `x` and reading another is a shuffle.
/// It needs the whole warp converged, as any warp collective does.
///
axm lanes: {T: *} → [self: Idx 32, x: T] → «32; T»;

/// #### tf32_rna
///
/// Rounds the significand of an F32 to the 10 bits of TF32, to nearest with ties away from zero (`cvt.rna.tf32.f32`).
/// `tf32_rna_ref` is its bit-level reference; Inf and NaN only lose their low 13 bits, as measured on sm_80.
///
axm tf32_rna: math.F32 → math.F32;

anx lam tf32_rna_ref (x: math.F32): math.F32 =
    let bits = core.bitcast I32 x;
    let mask = 0xFFFFE000I32;
    let special = core.icmp.e (core.bit2.and 0 (bits, 0x7F800000I32), 0x7F800000I32);
    let rounded = core.bit2.and 0 ((core.wrap.add 0 (bits, 0x1000I32), bits)#special, mask);
    core.bitcast math.F32 rounded;
///
/// #### ldmatrix
///
/// Loads `n` 8×4 matrices of 32-bit elements from shared memory (`ldmatrix.sync.m8n8.b16`).
/// Work-item `i` passes the address of row `i % 8` of matrix `i / 8` and receives element `(i / 4, i % 4)` of each matrix.
///
axm ldmatrix: {a: Nat} → [n: Nat, mem.M a, mem.Ptr («4; math.F32», a)] → [mem.M a, «n; math.F32»];
///
/// #### ldmatrix_b16
///
/// Loads `n` 8×8 matrices of 16-bit elements `T` from shared memory (`ldmatrix.sync.m8n8.b16`, `.trans` if `trans`).
/// Work-item `i` passes the address of row `i % 8` of matrix `i / 8` and receives elements `(i / 4, 2 (i % 4) + h)` of each matrix, or their transposes.
///
axm ldmatrix_b16: {T: *} → {a: Nat} → [n: Nat, trans: Bool, mem.M a, mem.Ptr («8; T», a)] → [mem.M a, «n, 2; T»];
///
/// #### buf_ldmatrix
///
/// `ldmatrix` on the row of a work-group panel at `idx`; `buffer.lower_ptr` takes its address.
///
axm buf_ldmatrix: {r: Nat, s: «r; Nat»}
                → [n: Nat, mem.M 0, buffer.Buf (r, s, «4; math.F32»), idx: «i: r; Idx s#i»]
                → [mem.M 0, «n; math.F32»];
///
/// #### buf_addr
///
/// The shared-window address of the element of a work-group panel at `idx`; `buffer.lower_ptr` takes it.
///
axm buf_addr: {T: *} → {r: Nat, s: «r; Nat»} → [buffer.Buf (r, s, T), idx: «i: r; Idx s#i»] → I32;
///
/// #### buf_ldmatrix_b16
///
/// `ldmatrix_b16` on the row of a work-group panel of 16-bit `T` at `idx`; `buffer.lower_ptr` takes its address.
///
axm buf_ldmatrix_b16: {T: *} → {r: Nat, s: «r; Nat»}
                    → [n: Nat, trans: Bool, mem.M 0, buffer.Buf (r, s, «8; T»), idx: «i: r; Idx s#i»]
                    → [mem.M 0, «n, 2; T»];
///
/// ## Phases
///
/// ### check_addr_spaces_repl
///
/// Rejects address-space misuse: `mem.malloc` / `mem.free` in the shared, const or local address space,
/// `mem.mslot` in the global or const one, and `mem.store` into the const one.
///
axm check_addr_spaces_repl: compile.Phase;
///
/// ### host_malloc2gpualloc_repl
///
/// Rewrites `mem.malloc` / `mem.free` in the global address space into `gpu.alloc` / `gpu.free`.
///
axm host_malloc2gpualloc_repl: compile.Phase;
///
/// ### mem_checks
///
/// Rejects `mem.M` crossing a device boundary — passed to a `gpu.launch` kernel, or taken/returned
/// by `main` with a non-zero address space.
///
axm mem_checks: compile.Phase;
///
/// ### Work-group phases
///
/// A work-group's shared memory moves through supersteps: `Synced`, `Writing` its panels, then `Reading` them, and
/// possibly `Updating` claimed panels in place.
/// `GM (g, e, p)` is the memory of construct `g` in phase `p` of its `e`-th superstep, and `SharedBuf (g, e, v, …)` a panel
/// it fills; their indices keep a token or panel of another construct, superstep or phase out.
/// An `Empty` panel can only be filled, an `Unpublished` one only published and a `Published` one only read or claimed.
/// An `Owned` panel is updated in place: each work-item rewrites only elements no other work-item reads or writes in
/// that superstep, which nothing verifies.
/// `check_sync` checks the linear use these types cannot express, and `erase_phases` lowers them to `mem.M 0`,
/// `buffer.Buf` and `fence`s.
///
anx nom GroupPhase = | Synced | Writing | Reading | Updating;
anx let Vis = buffer.Vis;
axm GM: [g e: Nat, p: GroupPhase] → *;
axm SharedBuf: [g e: Nat, v: Vis, r: Nat, s: «r; Nat», T: *] → *;
/// Enters construct `g` behind a barrier, so earlier readers of the memory it fills are done.
axm group_enter: {g: Nat} → mem.M 0 → GM (g, 0, GroupPhase#Synced);
axm enter_write: {g e: Nat} → GM (g, e, GroupPhase#Synced) → GM (g, e, GroupPhase#Writing);
/// Nothing is pending behind a barrier, so reading starts at once.
axm enter_read: {g e: Nat} → GM (g, e, GroupPhase#Synced) → GM (g, e, GroupPhase#Reading);
/// Claimed panels were never read in this superstep, so updating them starts at once.
axm enter_update: {g e: Nat} → GM (g, e, GroupPhase#Reading) → GM (g, e, GroupPhase#Updating);
/// A barrier: the superstep's fills are visible to every work-item after it.
axm sync_publish: {g e: Nat} → GM (g, e, GroupPhase#Writing) → GM (g, e, GroupPhase#Reading);
/// A barrier: the superstep's reads are done, so the next one may overwrite its panels.
axm sync_reclaim: {g e: Nat} → GM (g, e, GroupPhase#Reading) → GM (g, e + 1, GroupPhase#Synced);
axm group_leave: {g e: Nat} → GM (g, e, GroupPhase#Synced) → mem.M 0;
/// Leaves while panels may still be read; the next `group_enter` waits for those readers.
axm leave_reading: {g e: Nat} → GM (g, e, GroupPhase#Reading) → mem.M 0;
axm shared_panel: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
                → GM (g, e, GroupPhase#Writing) → [GM (g, e, GroupPhase#Writing), SharedBuf (g, e, Vis#Empty, r, s, T)];
/// The work-items fill the panel together with `fill`, each writing elements no other one writes.
axm coop_fill: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
             → [GM (g, e, GroupPhase#Writing), SharedBuf (g, e, Vis#Empty, r, s, T),
                fill: [mem.M 0, buffer.Buf (r, s, T)] → [mem.M 0, buffer.Buf (r, s, T)]]
             → [GM (g, e, GroupPhase#Writing), SharedBuf (g, e, Vis#Unpublished, r, s, T)];
axm publish_view: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
                → [GM (g, e, GroupPhase#Reading), SharedBuf (g, e, Vis#Unpublished, r, s, T)]
                → SharedBuf (g, e, Vis#Published, r, s, T);
axm view: {g e: Nat} → {r: Nat, s: «r; Nat», T: *} → SharedBuf (g, e, Vis#Published, r, s, T) → buffer.Buf (r, s, T);
/// Takes a published panel over for in-place updates.
axm claim: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
         → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Published, r, s, T)]
         → SharedBuf (g, e, Vis#Owned, r, s, T);
/// The work-items update the claimed panel with `body`, each only its own elements.
axm owned_update: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
                → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Owned, r, s, T),
                   body: [mem.M 0, buffer.Buf (r, s, T)] → mem.M 0]
                → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Owned, r, s, T)];
/// A barrier: the updates are visible, and the panel is published to the next superstep.
axm sync_carry: {g e: Nat} → {r: Nat, s: «r; Nat», T: *}
              → [GM (g, e, GroupPhase#Updating), SharedBuf (g, e, Vis#Owned, r, s, T)]
              → [GM (g, e + 1, GroupPhase#Synced), SharedBuf (g, e + 1, Vis#Published, r, s, T)];
/// Runs `body` on the memory while the published panels are read.
axm read_phase: {g e: Nat} → {R: *}
              → [GM (g, e, GroupPhase#Reading), body: mem.M 0 → [mem.M 0, R]] → [GM (g, e, GroupPhase#Reading), R];
/// A work-group fills one more panel of the superstep it is writing.
lam fill_panel {g: Nat, r: Nat, s: «r; Nat», T: *}
    (t: GM (g, 0, GroupPhase#Writing), fill: [mem.M 0, buffer.Buf (r, s, T)] → [mem.M 0, buffer.Buf (r, s, T)])
    : [GM (g, 0, GroupPhase#Writing), SharedBuf (g, 0, Vis#Unpublished, r, s, T)] =
    let (t, p) = shared_panel @(g, 0) @(r, s, T) t;
    coop_fill (t, p, fill);
/// One superstep of construct `g` from `start`: its work-items fill the `n` panels together, publish them behind one
/// barrier and run `read` while the panels are read.
/// Panel `i` is filled from the token the fills before it left, the fold of their steps.
/// The implicit arguments form one group: applied one after another, a literal `n` would index `fills` before its type is known.
/// For the same reason the panels are only indexed by a pack's own binder, never by a function's parameter.
/// Each fill is named once: a pack makes its element anew at every extraction, and two copies of a fill would use
/// one token twice.
/// So a step keeps its panel in a slot of one erased type, cast back once all are filled.
anx lam superstep {g n: Nat, rs: «n; Nat», ss: «i: n; «rs#i; Nat»», Ts: «n; *», R: *}
    (start: mem.M 0,
     fills: «i: n; [mem.M 0, buffer.Buf (rs#i, ss#i, Ts#i)] → [mem.M 0, buffer.Buf (rs#i, ss#i, Ts#i)]»,
     read: [mem.M 0, «i: n; buffer.Buf (rs#i, ss#i, Ts#i)»] → [mem.M 0, R]): [mem.M 0, R] =
    let W      = GM (g, 0, GroupPhase#Writing);
    let Filled = λ (i: Idx n): * = SharedBuf (g, 0, Vis#Unpublished, rs#i, ss#i, Ts#i);
    let Slot   = SharedBuf (g, 0, Vis#Unpublished, 0, (), []);
    let S      = [W, «n; Slot»];
    let steps  = ‹i: n; λ (st: S): S =
        let (t, p) = fill_panel @(g, rs#i, ss#i, Ts#i) (st#0₂, fills#i);
        (t, ‹j: n; ((st#1₂)#j, core.bitcast Slot p)#(core.icmp.e (j, i))›)›;
    let (t, slots) = vec.fold.l @(S, S → S) @n (λ (st: S, f: S → S): S = f st)
        ((enter_write (group_enter @g start), ‹n; ⊥:Slot›), steps);
    let seen   = sync_publish t;
    let views  = ‹i: n; view (publish_view (seen, core.bitcast (Filled i) (slots#i)))›;
    let (t, r) = read_phase (seen, λ (m: mem.M 0): [mem.M 0, R] = read (m, views));
    (leave_reading t, r);
/// Each lane merges its value with that of the lane `width / 2` away, then `width / 4`, down to 1, after which each of
/// `width` adjacent lanes holds the merge of all of them; `op` is commutative and `width` a power of two.
anx lam lane_merge {k: Nat} (width: Nat, op: [«k; math.F32», «k; math.F32»] → «k; math.F32») (value: «k; math.F32»)
    : «k; math.F32» =
    lam halve (mask: Nat, v: «k; math.F32»)@(core.pe.is_closed mask): «k; math.F32» =
        (λ (): «k; math.F32» = v,
         λ (): «k; math.F32» =
            halve (mask / 2, op (v, ‹i: k; shfl_xor (v#i, core.idx 0 0x100000000 mask)›)))#(mask != 0) ();
    halve (width / 2, value);
/// A work-group fills a panel together, updates it in place in `k` rounds with a barrier behind each, and runs `read`
/// while the panel is read; `rounds#j` rewrites only elements no other work-item touches in that round.
/// Round `e` leaves the token and the panel of superstep `e`, so their types count the rounds.
/// The casts are between equal types once `e` is a literal: the step from `e - 1` yields superstep `e - 1 + 1`.
anx lam merge_rounds {g k r: Nat, s: «r; Nat», T R: *}
    (start: mem.M 0, fill: [mem.M 0, buffer.Buf (r, s, T)] → [mem.M 0, buffer.Buf (r, s, T)],
     rounds: «k; [mem.M 0, buffer.Buf (r, s, T)] → mem.M 0»,
     read: [mem.M 0, buffer.Buf (r, s, T)] → [mem.M 0, R]): [mem.M 0, R] =
    let Seen   = λ (e: Nat): * = [GM (g, e, GroupPhase#Reading), SharedBuf (g, e, Vis#Published, r, s, T)];
    let (t, p) = fill_panel @(g, r, s, T) (enter_write (group_enter @g start), fill);
    let t      = sync_publish t;
    let first  = (t, publish_view (t, p));
    lam after (e: Nat)@(core.pe.is_closed e): Seen e =
        (λ (): Seen e = core.bitcast (Seen e) first,
         λ (): Seen e =
            let (t, p) = after (e - 1);
            let u      = enter_update t;
            let (u, o) = owned_update (u, claim (u, p), rounds#(core.idx 0 k (e - 1)));
            let (t, p) = sync_carry (u, o);
            core.bitcast (Seen e) (enter_read t, p))#(e != 0) ();
    let (t, p) = after k;
    let (t, x) = read_phase (t, λ (m: mem.M 0): [mem.M 0, R] = read (m, view p));
    (group_leave (sync_reclaim t), x);
/// One round of a tree merge for `merge_rounds`: `trip` work-items each merge the pairs `t, t + trip, …` below `pairs`,
/// pair `p` being element `p % elems` of the partials `p / elems` and `p / elems + span`, into the first of the two.
/// `get (mem, parts, t, e)` reads element `e` of partial `t` and `set` writes it.
anx lam merge_pairs {B T: *} (elems span pairs trip: Nat, op: [T, T] → T,
                              get: [mem.M 0, B, Nat, Nat] → [mem.M 0, T], set: [mem.M 0, B, Nat, Nat, T] → mem.M 0)
    (m: mem.M 0, parts: B): mem.M 0 =
    fun from (t: I64, m: mem.M 0): mem.M 0 =
        affine.For @(0, 1, mem.M 0) pair done (t, core.bitcast I64 pairs, core.bitcast I64 trip, m)
        where
            con pair (p: I64, m: mem.M 0, next: Cn [mem.M 0]) =
                let i      = core.bitcast Nat p / elems;
                let e      = core.bitcast Nat p % elems;
                let (m, a) = get (m, parts, i, e);
                let (m, b) = get (m, parts, i + span, e);
                next (set (m, parts, i, e, op (a, b)));
            con done (m: mem.M 0) = return m;
        end;
    fun run (m: mem.M 0): mem.M 0 =
        affine.For @(0, 1, mem.M 0) (bind.item items) exit (0I64, core.bitcast I64 trip, 1I64, m)
        where
            con items (t: I64, m: mem.M 0, yield: Cn [mem.M 0]) = yield (cps.cps2ds from (t, m));
            con exit (m: mem.M 0) = return m;
        end;
    cps.cps2ds run m;
/// The reading phase of a tree merge: one work-item per element hands the first partial's to `put`.
anx lam merge_first {B T: *} (elems: Nat, get: [mem.M 0, B, Nat, Nat] → [mem.M 0, T], put: [mem.M 0, Nat, T] → mem.M 0)
    (m: mem.M 0, parts: B): [mem.M 0, []] =
    fun run (m: mem.M 0): mem.M 0 =
        affine.For @(0, 1, mem.M 0) (bind.item items) exit (0I64, core.bitcast I64 elems, 1I64, m)
        where
            con items (j: I64, m: mem.M 0, yield: Cn [mem.M 0]) =
                let e      = core.bitcast Nat j;
                let (m, v) = get (m, parts, 0, e);
                yield (put (m, e, v));
            con exit (m: mem.M 0) = return m;
        end;
    (cps.cps2ds run m, ());
/// The reading phase of a merge in order: one work-item per element folds that element of the `n` partials from
/// `seed` and hands the result to `put`.
anx lam merge_serial {B T: *} (elems n: Nat, seed: T, op: [T, T] → T, get: [mem.M 0, B, Nat, Nat] → [mem.M 0, T],
                               put: [mem.M 0, Nat, T] → mem.M 0)
    (m: mem.M 0, parts: B): [mem.M 0, []] =
    fun of (e: Nat, m: mem.M 0): [mem.M 0, T] =
        affine.For @(0, 2, (mem.M 0, T)) step done (0I64, core.bitcast I64 n, 1I64, (m, seed))
        where
            con step (t: I64, st: [mem.M 0, T], next: Cn [mem.M 0, T]) =
                let (m, acc) = st;
                let (m, v)   = get (m, parts, core.bitcast Nat t, e);
                next (m, op (acc, v));
            con done (st: [mem.M 0, T]) = return st;
        end;
    fun run (m: mem.M 0): mem.M 0 =
        affine.For @(0, 1, mem.M 0) (bind.item items) exit (0I64, core.bitcast I64 elems, 1I64, m)
        where
            con items (j: I64, m: mem.M 0, yield: Cn [mem.M 0]) =
                let e      = core.bitcast Nat j;
                let (m, v) = cps.cps2ds of (e, m);
                yield (put (m, e, v));
            con exit (m: mem.M 0) = return m;
        end;
    (cps.cps2ds run m, ());
/// A persistent work-group runs, round after round, the tile `ctas` further on from its own `id` among `total`, as long
/// as there is one; `settle` ends a round, so the next tile finds the last one's effects.
anx lam persistent_tiles {n: Nat, Ts: «n; *»} (total ctas: Nat, settle: «i: n; Ts#i» → «i: n; Ts#i»)
    (tile: Cn [linear round: Nat, «i: n; Ts#i», Cn «i: n; Ts#i»]): Cn [id: Nat, «i: n; Ts#i», Cn «i: n; Ts#i»] =
    let S = «i: n; Ts#i»;
    con run (id: Nat, init: S, exit: Cn S)@tt =
        affine.For @(0, n, Ts) rounds exit (0I64, core.bitcast I64 ((total + ctas - 1) / ctas), 1I64, init)
        where
            con rounds (r: I64, st: S, next: Cn S) =
                let round  = core.bitcast Nat r;
                let linear = id + round * ctas;
                con done (st: S) = next (settle st);
                con skip (st: S) = next st;
                con go (st: S)   = tile (linear, round, st, done);
                (skip, go)#(linear < total) st;
        end;
    run;
/// What a step holds of slot `s` of a ring of `depth` slots: once its fill has landed and until the step gives the
/// slot up it is `live`; `unheld` is the one that is not, for a step that has read none yet.
/// Only a ring's sync makes them, `hold` on the memory it waited on so that each is a value of its own, and `retire`
/// consumes one; `gpu.check_sync` rejects one used twice and `gpu.erase_phases` erases them.
axm Held: [depth: Nat] → [Idx depth, Bool] → *;
axm hold: {depth: Nat} → [mem.M 0, s: Idx depth] → [mem.M 0, Held depth (s, tt)];
axm unheld: [depth: Nat] → Held depth (core.idx 0 depth 0, ff);
axm retire: {depth: Nat} → [mem.M 0, s: Idx depth, live: Bool, Held depth (s, live)] → mem.M 0;
/// What a fill holds of slot `s` once the slot is empty and until its copies are committed.
/// Only a ring's sync makes one, with `vacate`, and `occupy` consumes it; they are checked and erased as `Held` is.
axm Vacant: [depth: Nat] → Idx depth → *;
axm vacate: {depth: Nat} → [mem.M 0, s: Idx depth] → [mem.M 0, Vacant depth s];
axm occupy: {depth: Nat} → [mem.M 0, s: Idx depth, Vacant depth s] → mem.M 0;
/// How a ring of slots that asynchronous copies fill is synchronized; a slot is empty, being filled, full and read in turn.
/// `open` sets the ring up; `acquire (mem, n)` returns once the slot of the ring's fill `n` is empty, with what `V` says
/// the fill holds of it, and `commit (mem, s, vacant)` closes the copies the fill of slot `s` started; `await (mem, i)` returns once block `i`'s panels have landed, with what `H` says the
/// step holds of that slot; `release (mem, s, live, held)` gives slot `s` up if it is held `live`; `settle` waits for
/// all copies still in flight.
/// `idle` is what a step holds before it has read any slot, which is not live.
anx lam SyncOf (depth: Nat) (H: [Idx depth, Bool] → *) (V: Idx depth → *): * =
    [open: mem.M 0 → mem.M 0, acquire: [m: mem.M 0, n: Nat] → [mem.M 0, V (core.idx 0 depth (n % depth))],
     commit: [mem.M 0, s: Idx depth, V s] → mem.M 0,
     await: [m: mem.M 0, n: Nat] → [mem.M 0, H (core.idx 0 depth (n % depth), tt)],
     release: [mem.M 0, s: Idx depth, live: Bool, H (s, live)] → mem.M 0, idle: H (core.idx 0 depth 0, ff),
     settle: mem.M 0 → mem.M 0];
lam RingSync (depth: Nat): * = SyncOf depth (Held depth) (Vacant depth);
lam kept {depth: Nat} (m: mem.M 0, n: Nat): [mem.M 0, Vacant depth (core.idx 0 depth (n % depth))] =
    vacate (m, core.idx 0 depth (n % depth));
lam same (m: mem.M 0): mem.M 0 = m;
/// The mbarriers of `bars` start a phase that `count` arrivals complete, initialized by the work-items `issue` selects.
lam mbars_init {depth: Nat} (bars: buffer.Buf (1, depth, I64), count: Nat, issue: Bool) (m: mem.M 0): mem.M 0 =
    vec.fold.l @(mem.M 0, Idx depth) @depth
        (λ (m: mem.M 0, s: Idx depth): mem.M 0 = mbar_init_if (m, buf_addr (bars, s), core.idx 0 0x100000000 count, issue))
        (m, ‹s: depth; s›);
/// `cp.async` commit groups: a fill is one group and a step waits until at most `pending` are in flight.
/// With `proxy` the panels are read through the async proxy, so each filler first publishes its writes to it.
anx lam async_ring {depth: Nat} (pending: Nat, proxy: Bool): RingSync depth =
    (same, kept @depth, λ (m: mem.M 0, s: Idx depth, v: Vacant depth s): mem.M 0 = async_commit (occupy (m, s, v)),
     λ (m: mem.M 0, n: Nat): [mem.M 0, Held depth (core.idx 0 depth (n % depth), tt)] =
        let waited = async_wait_group pending m;
        hold ((waited, fence_proxy_async waited)#proxy, core.idx 0 depth (n % depth)),
     retire @depth,
     unheld depth, async_wait);
/// mbarriers, one per slot in `bars`: the ring's fill `n` completes the phase of parity `parity n` of slot `n % depth`,
/// which the step that reads it waits for; the fills beyond the `blocks` steps are waited for at the end.
/// A fill arrives on its slot's mbarrier by itself, so nothing commits it; `initiator` selects who initializes them.
anx lam mbar_ring {depth: Nat} (bars: buffer.Buf (1, depth, I64), blocks: Nat, parity: Nat → Nat, initiator: Bool): RingSync depth =
    let landed = λ (m: mem.M 0, n: Nat): mem.M 0 =
        mbar_wait_at (m, buf_addr (bars, core.idx 0 depth (n % depth)), core.idx 0 0x100000000 (parity n));
    (mbars_init (bars, 1, initiator), kept @depth, occupy @depth,
     λ (m: mem.M 0, n: Nat): [mem.M 0, Held depth (core.idx 0 depth (n % depth), tt)] =
        hold (landed (m, n), core.idx 0 depth (n % depth)),
     retire @depth,
     unheld depth,
     λ (m: mem.M 0): mem.M 0 =
        vec.fold.l @(mem.M 0, Idx (depth - 1)) @(depth - 1)
            (λ (m: mem.M 0, k: Idx (depth - 1)): mem.M 0 = landed (m, blocks + core.idx2nat k))
            (async_wait m, ‹k: depth - 1; k›));
/// A cluster that shares panels refills a slot only when all of its `size` work-groups have read it, which the "empty"
/// mbarrier of the slot counts: the leader arrives for each of them on that of the slot it gives up, and it waits for
/// the phase of parity `vacant n` before fill `n`.
anx lam shared_ring {depth: Nat} (sync: RingSync depth, size: Nat, empties: buffer.Buf (1, depth, I64), vacant: Nat → Nat, initiator: Bool): RingSync depth =
    (λ (m: mem.M 0): mem.M 0 = mbars_init (empties, size, initiator) ((sync#0₇) m),
     λ (m: mem.M 0, n: Nat): [mem.M 0, Vacant depth (core.idx 0 depth (n % depth))] =
        let (m, v) = (sync#1₇) (m, n);
        (mbar_wait_if (m, buf_addr (empties, core.idx 0 depth (n % depth)), core.idx 0 0x100000000 (vacant n), leader ()), v),
     sync#2₇, sync#3₇,
     λ (m: mem.M 0, s: Idx depth, live: Bool, h: Held depth (s, live)): mem.M 0 =
        let slot  = buf_addr (empties, s);
        let issue = core.bit2.and 0 (leader (), live);
        vec.fold.l @(mem.M 0, Idx size) @size
            (λ (m: mem.M 0, r: Idx size): mem.M 0 = mbar_arrive_cluster_if (m, slot, core.idx 0 0x100000000 (core.idx2nat r), issue))
            ((sync#4₇) (m, s, live, h), ‹r: size; r›),
     sync#5₇, sync#6₇);
/// A ring a producer warp fills for `consumers` warpgroups: the first work-item of the producer waits for the "empty"
/// mbarrier of a slot before it fills it, and the first lane of each of a consumer's four warps arrives on that of the
/// slot it gives up.
/// When `readers` work-groups of a cluster share the panels, each one's producer fills its share into all of them, so
/// a slot is empty once the consumers of all have given it up: each arrives on the slot's mbarrier in every one.
anx lam consumer_ring {depth: Nat}
    (sync: RingSync depth, empties: buffer.Buf (1, depth, I64), consumers readers: Nat, producer: Bool, vacant: Nat → Nat, initiator: Bool): RingSync depth =
    (λ (m: mem.M 0): mem.M 0 = mbars_init (empties, 4 * consumers * readers, initiator) ((sync#0₇) m),
     λ (m: mem.M 0, n: Nat): [mem.M 0, Vacant depth (core.idx 0 depth (n % depth))] =
        let issue  = core.bit2.and 0 (producer, core.icmp.e (core.bit2.and 0 (item_index (), 127I64), 0I64));
        let (m, v) = (sync#1₇) (m, n);
        (mbar_wait_if (m, buf_addr (empties, core.idx 0 depth (n % depth)), core.idx 0 0x100000000 (vacant n), issue), v),
     sync#2₇, sync#3₇,
     λ (m: mem.M 0, s: Idx depth, live: Bool, h: Held depth (s, live)): mem.M 0 =
        let first = core.icmp.e (core.bit2.and 0 (item_index (), 31I64), 0I64);
        let issue = core.bit2.and 0 (first, live);
        let slot  = buf_addr (empties, s);
        let m     = (sync#4₇) (m, s, live, h);
        (λ (): mem.M 0 = mbar_arrive_if (m, slot, issue),
         λ (): mem.M 0 = vec.fold.l @(mem.M 0, Idx readers) @readers
            (λ (m: mem.M 0, r: Idx readers): mem.M 0 = mbar_arrive_cluster_if (m, slot, core.idx 0 0x100000000 (core.idx2nat r), issue))
            (m, ‹r: readers; r›))#(1 < readers) (),
     sync#5₇, async_wait);
/// A work-group's barrier makes the initialized mbarriers visible to all of its work-items.
anx lam fenced_ring {depth: Nat} (sync: RingSync depth): RingSync depth =
    (λ (m: mem.M 0): mem.M 0 = fence ((sync#0₇) m), sync#1₇, sync#2₇, sync#3₇, sync#4₇, sync#5₇, sync#6₇);
/// A persistent work-group sets its ring up in its `first` tile only.
/// Later tiles skip the barrier, so a producer ahead of its consumers never waits for their stores.
anx lam resumed_ring {depth: Nat} (sync: RingSync depth, first: Bool): RingSync depth =
    fun set_up (m: mem.M 0): mem.M 0 =
        (ready, fenced)#first m
        where
            con fenced (m: mem.M 0) = return (fence m);
            con ready (m: mem.M 0)  = return m;
        end;
    (λ (m: mem.M 0): mem.M 0 = cps.cps2ds set_up ((sync#0₇) m), sync#1₇, sync#2₇, sync#3₇, sync#4₇, sync#5₇, sync#6₇);
/// A cluster's `size` work-groups load into each other's slots: each sees the others' mbarriers initialized before the
/// fold, and the cluster's barrier ends it.
anx lam cluster_ring {depth: Nat} (sync: RingSync depth, size: Nat): RingSync depth =
    (λ (m: mem.M 0): mem.M 0 = sync_cluster (fence_mbarrier_init (cluster_size size ((sync#0₇) m))),
     sync#1₇, sync#2₇, sync#3₇, sync#4₇, sync#5₇, λ (m: mem.M 0): mem.M 0 = sync_cluster ((sync#6₇) m));
/// Two consumers take turns at issuing their MMAs: `turn_take` waits on the consumer's named barrier and `turn_pass`
/// arrives on the other's.
anx lam turn_take (consumer: Nat) (m: mem.M 0): mem.M 0 = sync_named (m, core.idx 0 0x100000000 (consumer + 1), 256I32);
anx lam turn_pass (consumer: Nat) (m: mem.M 0): mem.M 0 = arrive_named (m, core.idx 0 0x100000000 (2 - consumer), 256I32);
/// What a warpgroup knows once at most `pending` of its groups of MMAs are in flight.
/// Only the wait of `wgmma_batch` makes one; `gpu.erase_phases` erases it.
axm InFlight: Nat → *;
axm in_flight: [pending: Nat] → InFlight pending;
/// A warpgroup's group of `n` MMAs over `x`, the accumulators they write and the register operands they read: prior
/// accesses are fenced before them, with `publish` after the panels' fillers published them to the async proxy, and
/// `x` comes back only from the wait that leaves at most `pending` groups in flight, with the witness of that.
/// A consumer taking turns issues them on its `turn`, which it then passes on.
anx lam wgmma_batch {X: *, n: Nat} (publish: Bool, pending: Nat, turn: Bool, consumer: Nat)
    (m: mem.M 0, x: X) (issue: «n; [mem.M 0, X] → [mem.M 0, X]»): [mem.M 0, X, InFlight pending] =
    let M      = mem.M 0;
    let m      = (λ (): M = m, λ (): M = turn_take consumer m)#turn ();
    let m      = wgmma_fence ((λ (): M = m, λ (): M = fence (fence_proxy_async m))#publish ());
    let (m, x) = vec.fold.l @([M, X], [M, X] → [M, X]) @n (λ (st: [M, X], f: [M, X] → [M, X]): [M, X] = f st) ((m, x), issue);
    let m      = wgmma_commit m;
    let m      = (λ (): M = m, λ (): M = turn_pass consumer m)#turn ();
    let (m, x) = wgmma_wait (m, pending, x);
    (m, x, in_flight pending);
/// The first consumer issues first: the second one hands it the turn once, in the `first` tile.
anx lam pingpong_ring {depth: Nat} (sync: RingSync depth, consumer: Nat, producer first: Bool): RingSync depth =
    let second = core.bit2.and 0 (core.bit2.and 0 (core.ncmp.e (consumer, 1), core.bit2.xor 0 (producer, tt)), first);
    (λ (m: mem.M 0): mem.M 0 = arrive_named_if ((sync#0₇) m, 1I32, 256I32, second),
     sync#1₇, sync#2₇, sync#3₇, sync#4₇, sync#5₇, sync#6₇);
/// The sync of a ring TMA fills, built from who shares it: a cluster of `cluster` work-groups (0 if none) that may be
/// `sharing` its panels, `consumers` warpgroups a producer warp fills for (0 if its readers fill it), of which this is
/// `consumer` and which take turns if `pingpong`, and a `persistent` work-group, whose `first` tile sets the ring up.
/// `full` and `vacant` give the parities a fill completes and waits for; `empties` is read only by a ring that is
/// shared or has a producer.
anx lam tma_ring {depth: Nat}
    (bars empties: buffer.Buf (1, depth, I64), blocks: Nat, full vacant: Nat → Nat, cluster: Nat, sharing: Bool,
     consumers consumer: Nat, producer pingpong persistent first: Bool): RingSync depth =
    let S         = RingSync depth;
    let initiator = core.bit2.and 0 (leader (), first);
    let base      = mbar_ring (bars, blocks, full, initiator);
    let shared    = (λ (): S = base, λ (): S = shared_ring (base, cluster, empties, vacant, initiator))
                        #(core.bit2.and 0 (sharing, consumers == 0)) ();
    let readers   = core.select (sharing, cluster, 1);
    let fed       = (λ (): S = consumer_ring (shared, empties, consumers, readers, producer, vacant, initiator), λ (): S = shared)
                        #(consumers == 0) ();
    let scoped    = ((λ (): S = fenced_ring fed, λ (): S = resumed_ring (fed, first))#persistent,
                     λ (): S = cluster_ring (fed, cluster))#(cluster != 0) ();
    (λ (): S = scoped, λ (): S = pingpong_ring (scoped, consumer, producer, first))#pingpong ();
/// `ring_fold` for any `H` and `V`: it only gives up a slot whose `H` an `await` returned and only commits a fill
/// whose `V` an `acquire` returned, so it cannot make either up.
/// A step gives up the slot the step before read, once every work-item has synchronized.
lam ring_fold_at {A P: *, depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (sync: SyncOf depth H V, count: I64, refill: Nat → Nat)
    (start: mem.M 0, acc: A, ring: «depth; P»)
    (fill: Fn [mem.M 0, Nat, Nat, P] → mem.M 0, step: Fn [mem.M 0, A, Nat, P] → [mem.M 0, A]): [mem.M 0, A] =
    let Last   = [live: Bool, s: Idx depth, H (s, live)];
    let S      = [mem.M 0, A, «depth; P», Last];
    let ahead  = depth - 1;
    let (open, acquire, commit, await, release, idle, settle) = sync;
    let primed = vec.fold.l @(mem.M 0, Idx ahead) @ahead
        (λ (m: mem.M 0, s: Idx ahead): mem.M 0 =
            let n      = core.idx2nat s;
            let (m, v) = acquire (m, n);
            commit (cps.cps2ds fill (m, n, n, ring#(core.idx 0 depth n)), core.idx 0 depth (n % depth), v))
        (open start, ‹s: ahead; s›);
    fun run (init: S): [mem.M 0, A] =
        affine.For @(0, 4, (mem.M 0, A, «depth; P», Last)) ring_step ring_done (0I64, count, 1I64, init)
        where
            con ring_step (i: I64, st: S, yield: Cn S) =
                let (m, a, slots, last) = st;
                let block      = core.bitcast Nat i;
                let (m, mine)  = await (m, block);
                let (live, s, h) = last;
                let synced     = release (fence m, s, live, h);
                let (vacant, v) = acquire (synced, block + ahead);
                let filled     = commit (cps.cps2ds fill (vacant, refill block, block + ahead, slots#(core.idx 0 depth ahead)),
                                         core.idx 0 depth ((block + ahead) % depth), v);
                let (m, a)     = cps.cps2ds step (filled, a, block, slots#(core.idx 0 depth 0));
                let next: Last = (tt, core.idx 0 depth (block % depth), mine);
                yield (m, a, ‹s: depth; slots#(core.idx 0 depth ((core.idx2nat s + 1) % depth))›, next);
            con ring_done (st: S) = return (settle st#0₄, st#1₄);
        end;
    let none: Last = (ff, core.idx 0 depth 0, idle);
    cps.cps2ds run (primed, acc, ring, none);
/// A work-group folds `count` blocks into `acc`, each read from panels `P` that asynchronous copies fill ahead into a
/// ring of `depth` slots.
/// The prologue fills blocks `0 .. depth - 2`; step `i` waits for its block, synchronizes, gives up the slot of the
/// block before, refills it with block `refill i`, computes block `i` from the first slot and rotates the slots; the
/// last copies land before the panels go away.
/// `fill (mem, block, n, slot)` starts the copies of `block`'s panels into `slot` as the ring's `n`-th fill.
anx lam ring_fold {A P: *, depth: Nat} (sync: RingSync depth, count: I64, refill: Nat → Nat)
    (start: mem.M 0, acc: A, ring: «depth; P»)
    (fill: Fn [mem.M 0, Nat, Nat, P] → mem.M 0, step: Fn [mem.M 0, A, Nat, P] → [mem.M 0, A]): [mem.M 0, A] =
    ring_fold_at @(A, P, depth) (Held depth) (Vacant depth) (sync, count, refill) (start, acc, ring) (fill, step);
/// A step hands back the witness that it left at most `lag` groups of MMAs in flight: the slot given up `lag` steps
/// after it was read is then one no MMA still reads.
/// `ws_fold` for any `H`, which likewise only gives up slots it awaited, the last one once its readers have retired at
/// the end, so a persistent work-group's next tile finds every slot given up.
lam ws_fold_at {A P: *, depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (sync: SyncOf depth H V, count: I64, producer: Bool, nth: Nat → Nat, lag: Nat)
    (start: mem.M 0, acc: A, ring: «depth; P»)
    (fill: Fn [mem.M 0, Nat, P] → mem.M 0, step: Fn [mem.M 0, A, Nat, P] → [mem.M 0, A, InFlight lag]): [mem.M 0, A] =
    let Last = [live: Bool, s: Idx depth, H (s, live)];
    let S    = [mem.M 0, A, «depth; P», Last];
    let (open, acquire, commit, await, release, idle, settle) = sync;
    fun run (init: S): [mem.M 0, A] =
        affine.For @(0, 4, (mem.M 0, A, «depth; P», Last)) ws_step ws_done (0I64, count, 1I64, init)
        where
            con ws_step (i: I64, st: S, yield: Cn S) =
                let (m, a, slots, last) = st;
                let block = core.bitcast Nat i;
                let n     = nth block;
                let next  = ‹s: depth; slots#(core.idx 0 depth ((core.idx2nat s + 1) % depth))›;
                con produce (m: mem.M 0) =
                    let (m, v) = acquire (m, n);
                    yield (commit (cps.cps2ds fill (m, block, slots#(core.idx 0 depth 0)), core.idx 0 depth (n % depth), v), a, next, last);
                con consume (m: mem.M 0) =
                    let (m, mine)    = await (m, n);
                    let (m, a, _)    = cps.cps2ds step (m, a, block, slots#(core.idx 0 depth 0));
                    let here         = core.idx 0 depth (n % depth);
                    let (live, s, h) = last;
                    con early (m: mem.M 0) = yield (release (m, here, tt, mine), a, next, last);
                    con late (m: mem.M 0)  = yield (release (m, s, live, h), a, next, (tt, here, mine));
                    (early, late)#(lag != 0) m;
                (consume, produce)#producer m;
            con ws_done (st: S) =
                let (m, a)       = wgmma_wait (st#0₄, 0, st#1₄);
                let (live, s, h) = st#3₄;
                return (settle ((m, release (m, s, live, h))#(lag != 0)), a);
        end;
    let none: Last = (ff, core.idx 0 depth 0, idle);
    cps.cps2ds run (open start, acc, ring, none);
/// A warpgroup region folds `count` blocks into `acc`, its producer warp and its consumers each running their side of
/// one ring of `depth` slots and meeting only at the slots' mbarriers.
/// In step `i` the producer acquires the first slot and starts the copies of block `i` into it with
/// `fill (mem, i, slot)`; a consumer waits for the fill, computes block `i` with `step` and gives up the slot it read
/// `lag` steps before, 0 or 1, whose asynchronous readers have retired by then.
/// Both rotate the slots from the first one, so block `i` takes slot `i % depth` for either, and `nth i` is the fill of
/// the ring it is: `i` itself, or with the fills of the tiles a persistent work-group ran before counted in.
anx lam ws_fold {A P: *, depth: Nat} (sync: RingSync depth, count: I64, producer: Bool, nth: Nat → Nat, lag: Nat)
    (start: mem.M 0, acc: A, ring: «depth; P»)
    (fill: Fn [mem.M 0, Nat, P] → mem.M 0, step: Fn [mem.M 0, A, Nat, P] → [mem.M 0, A, InFlight lag]): [mem.M 0, A] =
    ws_fold_at @(A, P, depth) (Held depth) (Vacant depth) (sync, count, producer, nth, lag) (start, acc, ring) (fill, step);
/// Rejects a token or an unpublished, owned or claimed panel used other than exactly once, a panel or token outside the
/// function that made it, and a construct entered twice.
/// Of a ring's slot tokens it rejects one used more than once where it is made; one packed into a value or captured by
/// a loop escapes it.
axm check_sync: compile.Phase;
axm erase_phases: compile.Phase;
///
/// ### remove_double_syncs
///
/// Drops a `sync_work_items` whose memories come from the immediately preceding sync or from the
/// kernel entry.
///
axm remove_double_syncs: compile.Phase;
///
/// ### split_apply
///
/// Splits the kernels off into a device world, then runs `host_specific_phases` on the host world and
/// `device_specific_phases` on the device world.
///
axm split_apply: compile.Phase;
///
/// ### lower_btensor_map_reduce
///
/// Lowers `btensor.map_reduce_post` to a kernel launch; skipped if the program already contains an
/// explicit `init`.
///
axm lower_btensor_map_reduce: compile.Phase;
///
/// ### outline
///
/// Outlines each `affine.For` whose body is `gpu.bind.group` into a `gpu.launch`: one work-group per iteration and one work-item per iteration of the enclosed `gpu.bind.item` loop.
/// Captured host pointers are copied to the device before the launch and back afterwards.
///
axm outline: compile.Phase;
///
/// ### Pipelines
///
/// The two sub-pipelines `split_apply` runs on the worlds it has just split apart; override them to
/// plug target-specific phases into either side.
///
anx lam host_specific_phases () = host_malloc2gpualloc_repl;
anx lam device_specific_phases () = remove_double_syncs;
