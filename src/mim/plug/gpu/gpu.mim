/// # The gpu Plugin {#gpu}
///
/// @see mim::plug::gpu
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
plugin math;
plugin mem;
plugin buffer;
plugin affine;
plugin cps;
plugin refly;
plugin vec;
import compile;

use core.ops.n;
///
/// ## Types
///
/// ### Address Spaces
///
/// Address space numbers correlate to the ones used by LLVM.
/// @see
///
/// - [User Guide for NVPTX Back-end](https://llvm.org/docs/NVPTXUsage.html#address-spaces)
/// - [User Guide for AMDGPU Backend](https://llvm.org/docs/AMDGPUUsage.html#address-spaces)
///
anx let addr_space_global = 1;
anx let addr_space_shared = 3;
anx let addr_space_const  = 4;
anx let addr_space_local  = 5;
///
/// ### Memory Types
///
anx let GlobalM = mem.M addr_space_global;
anx let SharedM = mem.M addr_space_shared;
anx let ConstM  = mem.M addr_space_const;
anx let LocalM  = mem.M addr_space_local;
///
/// ### Pointer Types
///
anx lam GlobalPtr (T: *): * = mem.Ptr (T, addr_space_global);
anx lam SharedPtr (T: *): * = mem.Ptr (T, addr_space_shared);
anx lam ConstPtr (T: *): *  = mem.Ptr (T, addr_space_const);
anx lam LocalPtr (T: *): *  = mem.Ptr (T, addr_space_local);
///
/// ### Stream Types
///
/// An opaque handle - a pointer on every GPU runtime.
anx let Stream = mem.Ptr0 I8;
axm default_stream: Stream;
///
/// ## Operations
///
/// ### Context
///
/// #### init
///
/// Initializes the GPU runtime.
/// @todo Consider allowing multiple contexts and configuration of device number or context flags.
axm init: mem.M 0 → [mem.M 0, GlobalM, ConstM];
///
/// #### deinit
///
/// Deinitializes the GPU runtime.
axm deinit: [mem.M 0, GlobalM, ConstM] → mem.M 0;
///
/// #### auto_init / auto_deinit
///
/// The compiler-inserted counterparts of gpu.init / gpu.deinit.
/// gpu.lower_btensor_map_reduce uses these instead of calling gpu.init / gpu.deinit directly, so a
/// backend can recognize and collapse the sessions it creates without touching one that the user opened by hand.
axm auto_init: mem.M 0 → [mem.M 0, GlobalM, ConstM];
axm auto_deinit: [mem.M 0, GlobalM, ConstM] → mem.M 0;
///
/// ### Streams
///
/// #### stream_init
///
/// Initializes a stream.
axm stream_init: [mem.M 0, GlobalM, mem.Ptr0 Stream] → [mem.M 0, GlobalM];
///
/// #### stream_deinit
///
/// Deinitializes a stream.
axm stream_deinit: [mem.M 0, GlobalM, Stream] → [mem.M 0, GlobalM];
///
/// #### stream_sync
///
/// Waits for a stream to finish all its work.
axm stream_sync: [mem.M 0, GlobalM, Stream] → [mem.M 0, GlobalM];
///
/// #### with_streams
///
/// Provides `n` streams to `func` for executing asynchronous GPU operations, managing their initialization and teardown.
anx fun with_streams (n: Nat, func: Fn [mem.M 0, GlobalM, «n; Stream»] → [mem.M 0, GlobalM])
                     (m0: mem.M 0, m1: GlobalM)
                   : [mem.M 0, GlobalM] =
    // FIXME: `streams_ptr` is never freed.
    let (m0, streams_ptr) = mem.alloc («n; Stream», 0) m0;
    init (m0, m1)
    where
        con init (m0: mem.M 0, m1: GlobalM) =
            loop (m0, m1, 0)
            where
                con loop (m0: mem.M 0, m1: GlobalM, i: Nat) =
                    (run, body)#(core.ncmp.l (i, n)) (m0, m1)
                    where
                        con body (m0: mem.M 0, m1: GlobalM) =
                            let lea = mem.lea (streams_ptr, core.bitcast (Idx n) i);
                            let (m0, m1) = stream_init (m0, m1, lea);
                            loop (m0, m1, i + 1);
                    end;
            end;
        con run (m0: mem.M 0, m1: GlobalM) =
            let (m0, streams) = mem.load (m0, streams_ptr);
            ret (m0, m1) = func $ (m0, m1, streams);
            deinit (m0, m1);
        con deinit (m0: mem.M 0, m1: GlobalM) =
            let (m0, streams) = mem.load (m0, streams_ptr);
            loop (m0, m1, 0)
            where
                con loop (m0: mem.M 0, m1: GlobalM, i: Nat) =
                    (return, body)#(core.ncmp.l (i, n)) (m0, m1)
                    where
                        con body (m0: mem.M 0, m1: GlobalM) =
                            let idx = core.bitcast (Idx n) i;
                            let (m0, m1) = stream_deinit (m0, m1, streams#idx);
                            loop (m0, m1, i + 1);
                    end;
            end;
    end;
///
/// ### Blocking / Async Memory Operations
///
/// #### alloc(block) / alloc(asyn)
///
/// Allocates memory on the device (in global address space), synchronously (`block`) or asynchronously
/// against a stream (`asyn`).
pub mod alloc
    axm block: [T: *] → GlobalM → [GlobalM, GlobalPtr T];
    axm asyn:  [T: *] → [GlobalM, Stream] → [GlobalM, GlobalPtr T];
end
///
/// #### free(block) / free(asyn)
///
/// Frees memory on the device (in global address space), synchronously (`block`) or asynchronously
/// against a stream (`asyn`).
pub mod free
    axm block: {T: *} → [GlobalM, GlobalPtr T] → GlobalM;
    axm asyn:  {T: *} → [GlobalM, GlobalPtr T, Stream] → GlobalM;
end
///
/// #### copy_to_device(block) / copy_to_device(asyn)
///
/// Copies data from host memory to device memory, synchronously (`block`) or asynchronously against a
/// stream (`asyn`).
pub mod copy_to_device
    axm block: {T: *} → [mem.M 0, GlobalM, mem.Ptr0 T, GlobalPtr T] → [mem.M 0, GlobalM];
    axm asyn:  {T: *} → [mem.M 0, GlobalM, mem.Ptr0 T, GlobalPtr T, Stream] → [mem.M 0, GlobalM];
end
///
/// #### copy_to_host(block) / copy_to_host(asyn)
///
/// Copies data from device memory to host memory, synchronously (`block`) or asynchronously against a
/// stream (`asyn`).
pub mod copy_to_host
    axm block: {T: *} → [mem.M 0, GlobalM, GlobalPtr T, mem.Ptr0 T] → [mem.M 0, GlobalM];
    axm asyn:  {T: *} → [mem.M 0, GlobalM, GlobalPtr T, mem.Ptr0 T, Stream] → [mem.M 0, GlobalM];
end
///
/// #### alloc_copy(block) / alloc_copy(asyn)
///
/// Allocates memory on the device (in global address space) for the provided host data and copies the
/// host data to that memory, synchronously (`block`) or asynchronously against a stream (`asyn`).
pub mod alloc_copy
    anx lam block {T: *} (m0: mem.M 0, m1: GlobalM, ptr: mem.Ptr0 T): [mem.M 0, GlobalM, GlobalPtr T] =
        let (m1, d_ptr) = alloc.block T m1;
        let (m0, m1) = copy_to_device.block (m0, m1, ptr, d_ptr);
        (m0, m1, d_ptr);

    anx lam asyn {T: *} (m0: mem.M 0, m1: GlobalM, ptr: mem.Ptr0 T, stream: Stream)
                      : [mem.M 0, GlobalM, GlobalPtr T] =
        let (m1, d_ptr) = alloc.asyn T (m1, stream);
        let (m0, m1) = copy_to_device.asyn (m0, m1, ptr, d_ptr, stream);
        (m0, m1, d_ptr);
end
///
/// ### Buffer Operations
///
/// #### buf_alloc_copy
///
/// Placeholder for copying a host-side `buffer.Buf` to the device.
/// Unlike `gpu.alloc_copy(block)`, this operates directly on the still-abstract `buffer.Buf`.
axm buf_alloc_copy: {r: Nat, s: «r; Nat», T: *}
                  → [mem.M 0, GlobalM, buffer.Buf (r, s, T)]
                  → [mem.M 0, GlobalM, GlobalPtr «s; T»];
///
/// #### buf_copy_to_host
///
/// Placeholder for copying device data to a host-side `buffer.Buf`.
/// Unlike `gpu.copy_to_host(block)`, this operates directly on the still-abstract `buffer.Buf`.
axm buf_copy_to_host: {r: Nat, s: «r; Nat», T: *}
                  → [mem.M 0, GlobalM, GlobalPtr «s; T», buffer.Buf (r, s, T)]
                  → [mem.M 0, GlobalM];
///
/// ### Kernel Launch
///
/// #### launch
///
/// Launches a kernel function on the device with dynamic shared memory and module symbols.
// TODO: refactor to {n m: N, Ts: «n; *»} as soon as type inference bug is fixed
axm launch: {n: Nat, Ts: «n; *»}
          → [n_groups n_items: Nat, Stream, m: Bool, MT: «core.idx2nat m; *»]
          → Cn [GlobalM, SharedM, ConstM, LocalM, Idx n_groups, Idx n_items,
                «i: core.idx2nat m; SharedPtr MT#i», «i: n; Ts#i»,
                Cn [GlobalM, SharedM, ConstM, LocalM]]
          → «i: n; Ts#i»
          → Fn [mem.M 0, GlobalM, ConstM]
          → [mem.M 0, GlobalM, ConstM];
///
/// ### Work-Item Synchronization
///
/// #### sync_work_items
///
/// Low-level operation to synchronize all work-items in the same work-group.
axm sync_work_items: [GlobalM, SharedM] → [GlobalM, SharedM];
///
/// #### warp_shfl_xor
///
/// Exchanges a scalar value with lane `lane_id ^ offset` across all 32 lanes of a warp (`shfl.sync.bfly`).
/// Threads `GlobalM` so MimIR's scheduler keeps the convergent warp shuffle out of divergent branches.
axm warp_shfl_xor: {T: *} → [GlobalM, T, I32] → [GlobalM, T];
///
/// #### vload4 / vstore4
///
/// 16-byte aligned 4-element vector load and store (`ld.*.v4` / `st.*.v4`) in address space `a`.
/// The caller guarantees 16-byte pointer alignment and 4 contiguous elements.
axm vload4:  {T: *, a: Nat} → [mem.M a, mem.Ptr (T, a)] → [mem.M a, «4; T»];
axm vstore4: {T: *, a: Nat} → [mem.M a, mem.Ptr (T, a), «4; T»] → mem.M a;
///
/// #### vstore2
///
/// 8-byte aligned 2-element vector store (`st.*.v2`) in address space `a`.
axm vstore2: {T: *, a: Nat} → [mem.M a, mem.Ptr (T, a), «2; T»] → mem.M a;
///
/// #### cp_async_cg_16 / cp_async_zero_16 / cp_async_commit / cp_async_wait_group
///
/// Asynchronous 16-byte global→shared copy (`cp.async.cg.shared.global.16`), 16-byte shared zero-fill,
/// group commit (`cp.async.commit_group`), and static wait (`cp.async.wait_group N`).
axm cp_async_cg_16:      {Td Ts: *} → [GlobalM, SharedM, SharedPtr Td, GlobalPtr Ts] → [GlobalM, SharedM];
axm cp_async_zero_16:    {T: *} → [SharedM, SharedPtr T] → SharedM;
axm cp_async_commit:     [GlobalM, SharedM] → [GlobalM, SharedM];
axm cp_async_wait_group: Nat → [GlobalM, SharedM] → [GlobalM, SharedM];
///
/// #### ldmatrix_b16
///
/// Warp-collective shared→register load of `n` 8×8 matrices of 16-bit elements `T`
/// (`ldmatrix.sync.aligned.m8n8.x{n}{.trans}.b16`). Threads `GlobalM` and `SharedM` to keep
/// warp convergence and shared-memory ordering intact.
axm ldmatrix_b16: {T PtrT: *} → [n: Nat, trans: Bool, GlobalM, SharedM, SharedPtr PtrT] → [GlobalM, SharedM, «n; «2; T»»];
///
/// #### mma_m16n8k16_f16 / mma_m16n8k16_bf16
///
/// Warp-collective Tensor Core MMA (`mma.sync.aligned.m16n8k16.row.col.f32.{f16,bf16}.{f16,bf16}.f32`).
/// Threads `GlobalM` so MimIR's scheduler keeps convergent warp MMA out of divergent branches.
axm mma_m16n8k16_f16:  [GlobalM, «4; «2; math.F16»»,  «2; «2; math.F16»»,  «4; math.F32»] → [GlobalM, «4; math.F32»];
axm mma_m16n8k16_bf16: [GlobalM, «4; «2; math.BF16»», «2; «2; math.BF16»», «4; math.F32»] → [GlobalM, «4; math.F32»];
///
/// #### synced_scope
///
/// Runs `scope` bracketed by work-item synchronization: syncs, runs `scope`, and syncs again.
// TODO: consider variadic arguments and returns values for the scope
anx lam synced_scope (m1: GlobalM, m3: SharedM,
                      scope: [GlobalM, SharedM] → [GlobalM, SharedM])
                   : [GlobalM, SharedM] =
    let (m1, m3) = sync_work_items (m1, m3);
    let (m1, m3) = scope (m1, m3);
    let (m1, m3) = sync_work_items (m1, m3);
    (m1, m3);
///
/// ## Phases
///
/// ### check_addr_spaces_repl
///
/// Rejects address-space misuse: `mem.malloc` / `mem.free` in the shared, const or local address space,
/// `mem.mslot` in the global or const one, and `mem.store` into the const one.
///
axm check_addr_spaces_repl: compile.Phase;
///
/// ### host_malloc2gpualloc_repl
///
/// Rewrites `mem.malloc` / `mem.free` in the global address space into `gpu.alloc` / `gpu.free`.
///
axm host_malloc2gpualloc_repl: compile.Phase;
///
/// ### mem_checks
///
/// Rejects `mem.M` crossing a device boundary — passed to a `gpu.launch` kernel, or taken/returned
/// by `main` with a non-zero address space.
///
axm mem_checks: compile.Phase;
///
/// ### remove_double_syncs
///
/// Drops a `sync_work_items` whose memories come from the immediately preceding sync or from the
/// kernel entry.
///
axm remove_double_syncs: compile.Phase;
///
/// ### split_apply
///
/// Splits the kernels off into a device world, then runs `host_specific_phases` on the host world and
/// `device_specific_phases` on the device world.
///
axm split_apply: compile.Phase;
///
/// ### lower_btensor_map_reduce
///
/// Lowers `btensor.map_reduce_post` to a kernel launch; skipped if the program already contains an
/// explicit `init`.
///
axm lower_btensor_map_reduce: compile.Phase;
///
/// ### Pipelines
///
/// The two sub-pipelines `split_apply` runs on the worlds it has just split apart; override them to
/// plug target-specific phases into either side.
///
anx lam host_specific_phases () = host_malloc2gpualloc_repl;
anx lam device_specific_phases () = remove_double_syncs;
///
/// ## SIMT Multi-Level Tiling Combinators
///
/// Open, typed PE combinators for static-shape GPU contractions (`B × M × N × K`).
/// Each combinator owns a single level and threads only the state that level needs:
/// - `simt_stage_tile`: cooperative work-group global→shared tile staging with static bounds elision.
/// - `simt_k_loop`: serial reduction loop carrying thread-private register accumulators.
/// - `simt_reg_mma`: thread-local `TM × TN` outer-product register micro-kernel over a shared slice.
/// - `simt_store_tile`: in-register epilogue + coalesced global write-back with static bounds elision.
/// - `simt_tiled_kernel`: composes the above over two static shared-memory slots (`mem.slot` in `addr_space_shared`).

lam simt_unroll {S: *} (n: Nat) (s0: S) (body: [Idx n, S] → S): S =
    vec.fold.l @(S, Idx n) @n (λ (s: S, i: Idx n): S = body (i, s)) (s0, ‹i: n; i›);

lam simt_when {S: *} (cond: Bool, s: S, body: S → S): S =
    fun guard (s: S)@tt: S =
        (skip, run)#cond s
        where
            con skip (s: S) = return s;
            con run  (s: S) = return (body s);
        end;
    cps.cps2ds guard s;

lam simt_if_else {S: *} (cond: Bool, s: S, then_b else_b: S → S): S =
    fun guard (s: S)@tt: S =
        (run_e, run_t)#cond s
        where
            con run_e (s: S) = return (else_b s);
            con run_t (s: S) = return (then_b s);
        end;
    cps.cps2ds guard s;

/// Cooperatively loads an `H × W` slice from `read` into `smem` (`H_alloc × Wpad`) across `NT` threads.
/// Out-of-bounds global coordinates are skipped; `row_div` / `col_div` statically elide bounds guards.
anx lam simt_stage_tile {T: *} (H_alloc H W Wpad NT: Nat) (row_div col_div: Bool)
    (m1: GlobalM, m3: SharedM, smem: SharedPtr «H_alloc; «Wpad; T»», tid: Nat,
     base_r lim_r base_c lim_c: Nat,
     read: [GlobalM, Nat, Nat] → [GlobalM, T])
    : [GlobalM, SharedM] =
    let total = H * W;
    let trips = core.nat.div (core.nat.add (total, core.nat.sub (NT, 1)), NT);
    let exact = core.nat.rem (total, NT) == 0;
    simt_unroll @[GlobalM, SharedM] trips (m1, m3) (λ (s: Idx trips, (m1: GlobalM, m3: SharedM)): [GlobalM, SharedM] =
        let idx     = core.nat.add (tid, core.nat.mul (core.idx2nat s, NT));
        let in_tile = core.select (exact, tt, core.ncmp.l (idx, total));
        simt_when @[GlobalM, SharedM] (in_tile, (m1, m3), λ (m1: GlobalM, m3: SharedM): [GlobalM, SharedM] =
            let r    = core.nat.div (idx, W);
            let c    = core.nat.rem (idx, W);
            let gr   = core.nat.add (base_r, r);
            let gc   = core.nat.add (base_c, c);
            let ok_r = core.select (row_div, tt, core.ncmp.l (gr, lim_r));
            let ok_c = core.select (col_div, tt, core.ncmp.l (gc, lim_c));
            let ok   = core.bit2.and 2 (ok_r, ok_c);
            simt_when @[GlobalM, SharedM] (ok, (m1, m3), λ (m1: GlobalM, m3: SharedM): [GlobalM, SharedM] =
                let (m1, v) = read (m1, gr, gc);
                let row_p   = mem.lea (smem, core.conv.u H_alloc (core.bitcast I64 r));
                let cell_p  = mem.lea (row_p, core.conv.u Wpad (core.bitcast I64 c));
                (m1, mem.store (m3, cell_p, v)))));

/// Serial loop of `n_steps` iterations carrying `(GlobalM, SharedM, Acc)` in registers.
anx lam simt_k_loop {Acc: *} (n_steps: Nat)
    (m1: GlobalM, m3: SharedM, acc0: Acc)
    (step: [Nat, GlobalM, SharedM, Acc] → [GlobalM, SharedM, Acc])
    : [GlobalM, SharedM, Acc] =
    fun run (s: [GlobalM, SharedM, Acc])@tt: [GlobalM, SharedM, Acc] =
        affine.For @(0, 3, (GlobalM, SharedM, Acc)) body exit (0I64, core.bitcast I64 n_steps, 1I64, s)
        where
            con body (i: I64, s: [GlobalM, SharedM, Acc], yield: Cn [GlobalM, SharedM, Acc]) =
                let (m1, m3, acc) = s;
                yield (step (core.bitcast Nat i, m1, m3, acc));
            con exit (s: [GlobalM, SharedM, Acc]) = return s;
        end;
    cps.cps2ds run (m1, m3, acc0);

/// Thread-local `TM × TN` outer-product micro-kernel over `Klen` steps of shared-memory tiles `sa` and `sb`.
anx lam simt_reg_mma {Ta Tb To: *} (BM BK BKpad BNpad TY TX TM TN Klen: Nat)
    (comb: Fn [GlobalM, To, [Ta, Tb]] → [GlobalM, To])
    (m1: GlobalM, m3: SharedM,
     sa: SharedPtr «BM; «BKpad; Ta»», sb: SharedPtr «BK; «BNpad; Tb»»,
     ty tx: Nat, acc0: «TM; «TN; To»»)
    : [GlobalM, SharedM, «TM; «TN; To»»] =
    let Regs = «TM; «TN; To»»;
    simt_k_loop @Regs Klen (m1, m3, acc0) (λ (kk: Nat, m1: GlobalM, m3: SharedM, acc: Regs): [GlobalM, SharedM, Regs] =
        let kk_a   = core.conv.u BKpad (core.bitcast I64 kk);
        let kk_b   = core.conv.u BK (core.bitcast I64 kk);
        let sb_row = mem.lea (sb, kk_b);
        let (m3, a_frag) = simt_unroll @[SharedM, «TM; Ta»] TM (m3, ‹TM; ⊥:Ta›)
            (λ (i: Idx TM, (m3: SharedM, af: «TM; Ta»)): [SharedM, «TM; Ta»] =
                let r       = core.nat.add (ty, core.nat.mul (core.idx2nat i, TY));
                let p       = mem.lea (mem.lea (sa, core.conv.u BM (core.bitcast I64 r)), kk_a);
                let (m3, v) = mem.load (m3, p);
                (m3, af#i ← v));
        let (m3, b_frag) = simt_unroll @[SharedM, «TN; Tb»] TN (m3, ‹TN; ⊥:Tb›)
            (λ (j: Idx TN, (m3: SharedM, bf: «TN; Tb»)): [SharedM, «TN; Tb»] =
                let c       = core.nat.add (tx, core.nat.mul (core.idx2nat j, TX));
                let p       = mem.lea (sb_row, core.conv.u BNpad (core.bitcast I64 c));
                let (m3, v) = mem.load (m3, p);
                (m3, bf#j ← v));
        let (m1, acc) = simt_unroll @[GlobalM, Regs] TM (m1, acc)
            (λ (i: Idx TM, (m1: GlobalM, acc: Regs)): [GlobalM, Regs] =
                let av = a_frag#i;
                simt_unroll @[GlobalM, Regs] TN (m1, acc)
                    (λ (j: Idx TN, (m1: GlobalM, acc: Regs)): [GlobalM, Regs] =
                        let (m1, nv) = cps.cps2ds comb (m1, acc#i#j, (av, b_frag#j));
                        (m1, acc#i#j ← nv)));
        (m1, m3, acc));

/// Writes each thread's `TM × TN` register accumulators through `write` (which fuses any epilogue in registers).
anx lam simt_store_tile {To: *} (M N BM BN TY TX TM TN: Nat)
    (m1: GlobalM, block_m block_n ty tx: Nat, acc: «TM; «TN; To»»,
     write: [GlobalM, Nat, Nat, To] → GlobalM)
    : GlobalM =
    let m_div = core.nat.rem (M, BM) == 0;
    let n_div = core.nat.rem (N, BN) == 0;
    simt_unroll @GlobalM TM m1 (λ (i: Idx TM, m1: GlobalM): GlobalM =
        let gm   = core.nat.add (block_m, core.nat.add (ty, core.nat.mul (core.idx2nat i, TY)));
        let ok_m = core.select (m_div, tt, core.ncmp.l (gm, M));
        simt_when @GlobalM (ok_m, m1, λ (m1: GlobalM): GlobalM =
            simt_unroll @GlobalM TN m1 (λ (j: Idx TN, m1: GlobalM): GlobalM =
                let gn   = core.nat.add (block_n, core.nat.add (tx, core.nat.mul (core.idx2nat j, TX)));
                let ok_n = core.select (n_div, tt, core.ncmp.l (gn, N));
                simt_when @GlobalM (ok_n, m1, λ (m1: GlobalM): GlobalM =
                    write (m1, gm, gn, acc#i#j)))));

/// Full SIMT shared-memory + register-tiled contraction kernel body over `B × M × N × K`.
anx lam simt_tiled_kernel {Ta Tb To: *}
    (B M N K BM BN BK TM TN Pad: Nat)
    (init: To, comb: Fn [GlobalM, To, [Ta, Tb]] → [GlobalM, To])
    (read_a:  [GlobalM, Nat, Nat, Nat] → [GlobalM, Ta],
     read_b:  [GlobalM, Nat, Nat, Nat] → [GlobalM, Tb],
     write_c: [GlobalM, Nat, Nat, Nat, To] → GlobalM)
    (m1: GlobalM, m3: SharedM, group_id item_id: Nat)
    : [GlobalM, SharedM] =
    let BM    = refly.check (1 < BM, BM, "gpu.simt_tiled_kernel: BM must be > 1");
    let BN    = refly.check (1 < BN, BN, "gpu.simt_tiled_kernel: BN must be > 1");
    let BK    = refly.check (1 < BK, BK, "gpu.simt_tiled_kernel: BK must be > 1");
    let TM    = refly.check (core.bit2.and 2 (0 < TM, core.nat.rem (BM, TM) == 0), TM,
        "gpu.simt_tiled_kernel: TM must divide BM");
    let TN    = refly.check (core.bit2.and 2 (0 < TN, core.nat.rem (BN, TN) == 0), TN,
        "gpu.simt_tiled_kernel: TN must divide BN");
    let TY    = core.nat.div (BM, TM);
    let TX    = core.nat.div (BN, TN);
    let NT    = refly.check (TY * TX <= 1024, TY * TX,
        "gpu.simt_tiled_kernel: block thread count (BM/TM)*(BN/TN) exceeds 1024");
    let BKpad = core.nat.add (BK, Pad);
    let BNpad = core.nat.add (BN, Pad);
    let gm_blks = core.nat.div (core.nat.add (M, core.nat.sub (BM, 1)), BM);
    let gn_blks = core.nat.div (core.nat.add (N, core.nat.sub (BN, 1)), BN);
    let mn_blks = gm_blks * gn_blks;
    let batch   = (0, core.nat.div (group_id, mn_blks))#(1 < B);
    let blk_rem = (group_id, core.nat.rem (group_id, mn_blks))#(1 < B);
    let bm_id   = core.nat.div (blk_rem, gn_blks);
    let bn_id   = core.nat.rem (blk_rem, gn_blks);
    let block_m = core.nat.mul (bm_id, BM);
    let block_n = core.nat.mul (bn_id, BN);
    let ty      = core.nat.div (item_id, TX);
    let tx      = core.nat.rem (item_id, TX);
    let m_div   = core.nat.rem (M, BM) == 0;
    let n_div   = core.nat.rem (N, BN) == 0;
    let full_k  = core.nat.div (K, BK);
    let tail_k  = core.nat.rem (K, BK);
    let Regs    = «TM; «TN; To»»;
    let acc0    = ‹TM; ‹TN; init››;
    let ra      = λ (m1: GlobalM, r c: Nat): [GlobalM, Ta] = read_a (m1, batch, r, c);
    let rb      = λ (m1: GlobalM, r c: Nat): [GlobalM, Tb] = read_b (m1, batch, r, c);
    let wc      = λ (m1: GlobalM, r c: Nat, v: To): GlobalM = write_c (m1, batch, r, c, v);
    let StepFn  = [Nat, Nat, GlobalM, SharedM, Regs] → [GlobalM, SharedM, Regs];

    fun body (m1: GlobalM, m3: SharedM)@tt: [GlobalM, SharedM] =
        ret (m3, sa) = mem.slot («BM; «BKpad; Ta»», addr_space_shared) $ m3;
        ret (m3, sb) = mem.slot («BK; «BNpad; Tb»», addr_space_shared) $ m3;
        let run_step = λ (Klen k_base: Nat, m1: GlobalM, m3: SharedM, acc: Regs): [GlobalM, SharedM, Regs] =
            let (m1, m3) = simt_stage_tile @Ta (BM, BM, Klen, BKpad, NT) (m_div, tt)
                (m1, m3, sa, item_id, block_m, M, k_base, K, ra);
            let (m1, m3) = simt_stage_tile @Tb (BK, Klen, BN, BNpad, NT) (tt, n_div)
                (m1, m3, sb, item_id, k_base, K, block_n, N, rb);
            let (m1, m3) = sync_work_items (m1, m3);
            let (m1, m3, acc) = simt_reg_mma @(Ta, Tb, To) (BM, BK, BKpad, BNpad, TY, TX, TM, TN, Klen)
                comb (m1, m3, sa, sb, ty, tx, acc);
            let (m1, m3) = sync_work_items (m1, m3);
            (m1, m3, acc);
        let do_full = λ (rs: StepFn): [GlobalM, SharedM, Regs] =
            simt_k_loop @Regs full_k (m1, m3, acc0)
                (λ (kt: Nat, m1: GlobalM, m3: SharedM, acc: Regs): [GlobalM, SharedM, Regs] =
                    rs (BK, core.nat.mul (kt, BK), m1, m3, acc));
        let (m1, m3, acc) = (λ (_: StepFn): [GlobalM, SharedM, Regs] = (m1, m3, acc0),
                             do_full)#(core.ncmp.ne (full_k, 0)) run_step;
        let do_tail = λ (rs: StepFn): [GlobalM, SharedM, Regs] =
            rs (tail_k, core.nat.mul (full_k, BK), m1, m3, acc);
        let (m1, m3, acc) = (λ (_: StepFn): [GlobalM, SharedM, Regs] = (m1, m3, acc),
                             do_tail)#(core.ncmp.ne (tail_k, 0)) run_step;
        let m1 = simt_store_tile @To (M, N, BM, BN, TY, TX, TM, TN) (m1, block_m, block_n, ty, tx, acc, wc);
        return (m1, m3);
    cps.cps2ds body (m1, m3);

/// Butterfly warp reduction over `width` active lanes (`width` a power of 2 in `1..32`).
/// Unrolls `log2(width)` `warp_shfl_xor` steps (`16, 8, 4, 2, 1` filtered by `< width`) at PE time.
anx lam simt_warp_reduce {Acc: *} (width: Nat)
    (merge: Fn [GlobalM, Acc, Acc] → [GlobalM, Acc])
    (m1: GlobalM, val: Acc)
    : [GlobalM, Acc] =
    let width = refly.check (core.bit2.and 2 (0 < width, width <= 32), width,
        "gpu.simt_warp_reduce: width must be in 1..32");
    let step = λ (off: Nat, (m1: GlobalM, v: Acc)): [GlobalM, Acc] =
        let do_step = λ (v: Acc): [GlobalM, Acc] =
            let (m1, other) = warp_shfl_xor @Acc (m1, v, core.bitcast I32 off);
            cps.cps2ds merge (m1, v, other);
        (λ (v: Acc): [GlobalM, Acc] = (m1, v), do_step)#(off < width) v;
    let s = step (16, (m1, val));
    let s = step (8, s);
    let s = step (4, s);
    let s = step (2, s);
    step (1, s);

/// Work-group reduction across `NT` threads (`NT` a multiple of 32 in `32..1024`):
/// 1. Each warp reduces its 32 lanes in registers via `simt_warp_reduce`.
/// 2. When `NW = NT / 32 > 1`, lane 0 of each warp stores to an `NW`-element shared slot,
///    syncs once, and warp 0 finishes the `NW`-way butterfly warp reduction.
/// On return, thread 0 holds the full work-group reduced value.
anx lam simt_group_reduce {Acc: *} (NT: Nat)
    (init: Acc, merge: Fn [GlobalM, Acc, Acc] → [GlobalM, Acc])
    (m1: GlobalM, m3: SharedM, tid: Nat, val: Acc)
    : [GlobalM, SharedM, Acc] =
    let NT = refly.check (core.bit2.and 2 (core.bit2.and 2 (32 <= NT, NT <= 1024), core.nat.rem (NT, 32) == 0), NT,
        "gpu.simt_group_reduce: NT must be a multiple of 32 in 32..1024");
    let NW       = core.nat.div (NT, 32);
    let (m1, wv) = simt_warp_reduce @Acc 32 merge (m1, val);
    let multi = λ (wv: Acc): [GlobalM, SharedM, Acc] =
        let w2 = core.select (NW <= 2, 2, core.select (NW <= 4, 4, core.select (NW <= 8, 8, core.select (NW <= 16, 16, 32))));
        fun body (m1: GlobalM, m3: SharedM)@tt: [GlobalM, SharedM, Acc] =
            ret (m3, smem) = mem.slot («NW; Acc», addr_space_shared) $ m3;
            let lane = core.nat.rem (tid, 32);
            let warp = core.nat.div (tid, 32);
            let m3 = simt_when @SharedM (core.ncmp.e (lane, 0), m3, λ (m3: SharedM): SharedM =
                mem.store (m3, mem.lea (smem, core.conv.u NW (core.bitcast I64 warp)), wv));
            let (m1, m3) = sync_work_items (m1, m3);
            let (m1, m3, res) = simt_when @[GlobalM, SharedM, Acc] (core.ncmp.l (tid, 32), (m1, m3, wv),
                λ (m1: GlobalM, m3: SharedM, _: Acc): [GlobalM, SharedM, Acc] =
                    let (m3, lv) = simt_when @[SharedM, Acc] (core.ncmp.l (tid, NW), (m3, init),
                        λ (m3: SharedM, _: Acc): [SharedM, Acc] =
                            mem.load (m3, mem.lea (smem, core.conv.u NW (core.bitcast I64 tid))));
                    let (m1, fin) = simt_warp_reduce @Acc w2 merge (m1, lv);
                    (m1, m3, fin));
            return (m1, m3, res);
        cps.cps2ds body (m1, m3);
    (λ (wv: Acc): [GlobalM, SharedM, Acc] = (m1, m3, wv), multi)#(1 < NW) wv;

/// Parallel reduction kernel: one work-group of `NT` threads per output element `0..OutN-1`.
/// Threads stride across `0..RedK-1` via `simt_k_loop`, merge partial accumulators with
/// `simt_group_reduce`, and thread 0 writes the fused epilogue via `write_out`.
anx lam simt_reduce_kernel {To: *} (OutN RedK NT: Nat)
    (init: To, merge: Fn [GlobalM, To, To] → [GlobalM, To])
    (step_elem: [GlobalM, Nat, Nat, To] → [GlobalM, To],
     write_out: [GlobalM, Nat, To] → GlobalM)
    (m1: GlobalM, m3: SharedM, group_id item_id: Nat)
    : [GlobalM, SharedM] =
    let NT     = refly.check (core.bit2.and 2 (core.bit2.and 2 (32 <= NT, NT <= 1024), core.nat.rem (NT, 32) == 0), NT,
        "gpu.simt_reduce_kernel: NT must be a multiple of 32 in 32..1024");
    let full   = core.nat.div (RedK, NT);
    let tail   = core.nat.rem (RedK, NT);
    let StepEl = [GlobalM, Nat, Nat, To] → [GlobalM, To];
    let do_full = λ (st: StepEl): [GlobalM, SharedM, To] =
        simt_k_loop @To full (m1, m3, init)
            (λ (s: Nat, m1: GlobalM, m3: SharedM, acc: To): [GlobalM, SharedM, To] =
                let rk       = core.nat.add (item_id, core.nat.mul (s, NT));
                let (m1, nv) = st (m1, group_id, rk, acc);
                (m1, m3, nv));
    let (m1, m3, acc) = (λ (_: StepEl): [GlobalM, SharedM, To] = (m1, m3, init),
                         do_full)#(core.ncmp.ne (full, 0)) step_elem;
    let do_tail = λ (st: StepEl): [GlobalM, To] =
        simt_when @[GlobalM, To] (core.ncmp.l (item_id, tail), (m1, acc),
            λ (m1: GlobalM, acc: To): [GlobalM, To] =
                let rk = core.nat.add (item_id, core.nat.mul (full, NT));
                st (m1, group_id, rk, acc));
    let (m1, acc) = (λ (_: StepEl): [GlobalM, To] = (m1, acc),
                     do_tail)#(core.ncmp.ne (tail, 0)) step_elem;
    let (m1, m3, total) = simt_group_reduce @To NT (init, merge) (m1, m3, item_id, acc);
    let m1 = simt_when @GlobalM (core.ncmp.e (item_id, 0), m1, λ (m1: GlobalM): GlobalM =
        write_out (m1, group_id, total));
    (m1, m3);

/// ## Vectorized (`v4`) + Double-Buffered SIMT Contraction Combinators
///
/// Extends the SIMT PE library with 128-bit vector loads/stores (`vload4`/`vstore4`), transposed
/// shared-memory `A` (`BK × BMpad`, 16-byte aligned for `LDS.128`), and register-prefetch ping-pong
/// double buffering (1 `bar.sync` per K-tile, overlapping global `LDG.128` with `FFMA`).

/// Prefetches an `H × W` tile (`4 | W`, `NT | (H * W / 4)`) in 4-wide chunks into registers.
/// A chunk starting at or beyond `lim_c` is skipped, so `4 | lim_c` keeps every read in bounds.
anx lam simt_prefetch_v4 {T: *} (H W NT: Nat) (row_div col_div: Bool)
    (m1: GlobalM, tid base_r lim_r base_c lim_c: Nat,
     read4: [GlobalM, Nat, Nat] → [GlobalM, «4; T»])
    : [GlobalM, «core.nat.div (H * core.nat.div (W, 4), NT); «4; T»»] =
    let W4    = core.nat.div (W, 4);
    let trips = core.nat.div (H * W4, NT);
    let m1    = refly.check (core.nat.rem (W, 4) == 0, m1, "gpu.simt_prefetch_v4: 4 must divide W");
    let m1    = refly.check (core.nat.rem (H * W4, NT) == 0, m1, "gpu.simt_prefetch_v4: NT must divide H * W / 4");
    let Buf   = «trips; «4; T»»;
    simt_unroll @[GlobalM, Buf] trips (m1, ‹trips; ‹4; ⊥:T››)
        (λ (s: Idx trips, (m1: GlobalM, buf: Buf)): [GlobalM, Buf] =
            let idx  = core.nat.add (tid, core.nat.mul (core.idx2nat s, NT));
            let r    = core.nat.div (idx, W4);
            let c    = core.nat.mul (core.nat.rem (idx, W4), 4);
            let gr   = core.nat.add (base_r, r);
            let gc   = core.nat.add (base_c, c);
            let ok_r = core.select (row_div, tt, core.ncmp.l (gr, lim_r));
            let ok_c = core.select (col_div, tt, core.ncmp.l (gc, lim_c));
            simt_when @[GlobalM, Buf] (core.bit2.and 2 (ok_r, ok_c), (m1, buf), λ (m1: GlobalM, buf: Buf): [GlobalM, Buf] =
                let (m1, v4) = read4 (m1, gr, gc);
                (m1, buf#s ← v4)));

/// Commits prefetched 4-wide chunks of `B` (`BK × BN`) directly into `sb` (`BK × BNpad`) via `vstore4`.
anx lam simt_commit_v4 {T: *} (BK BN BNpad NT: Nat)
    (m3: SharedM, sb: SharedPtr «BK; «BNpad; T»», tid: Nat,
     buf: «core.nat.div (BK * core.nat.div (BN, 4), NT); «4; T»»)
    : SharedM =
    let W4    = core.nat.div (BN, 4);
    let trips = core.nat.div (BK * W4, NT);
    simt_unroll @SharedM trips m3 (λ (s: Idx trips, m3: SharedM): SharedM =
        let idx = core.nat.add (tid, core.nat.mul (core.idx2nat s, NT));
        let r   = core.nat.div (idx, W4);
        let c   = core.nat.mul (core.nat.rem (idx, W4), 4);
        let p   = mem.lea (mem.lea (sb, core.conv.u BK (core.bitcast I64 r)), core.conv.u BNpad (core.bitcast I64 c));
        vstore4 @(T, addr_space_shared) (m3, p, buf#s));

/// Commits prefetched 4-wide chunks of `A` (`BM × BK`) transposed into `sa` (`BK × BMpad`).
anx lam simt_commit_t_v4 {T: *} (BM BK BMpad NT: Nat)
    (m3: SharedM, sa: SharedPtr «BK; «BMpad; T»», tid: Nat,
     buf: «core.nat.div (BM * core.nat.div (BK, 4), NT); «4; T»»)
    : SharedM =
    let W4    = core.nat.div (BK, 4);
    let trips = core.nat.div (BM * W4, NT);
    simt_unroll @SharedM trips m3 (λ (s: Idx trips, m3: SharedM): SharedM =
        let idx = core.nat.add (tid, core.nat.mul (core.idx2nat s, NT));
        let r   = core.nat.div (idx, W4);
        let c0  = core.nat.mul (core.nat.rem (idx, W4), 4);
        let v4  = buf#s;
        let ri  = core.conv.u BMpad (core.bitcast I64 r);
        simt_unroll @SharedM 4 m3 (λ (l: Idx 4, m3: SharedM): SharedM =
            let ck = core.nat.add (c0, core.idx2nat l);
            let p  = mem.lea (mem.lea (sa, core.conv.u BK (core.bitcast I64 ck)), ri);
            mem.store (m3, p, v4#l)));

/// Scalar cooperative staging of a transposed `H × W` slice of `A` into `sa` (`BK × BMpad`), used for `K % BK` tails.
anx lam simt_stage_tile_t {T: *} (BK H W BMpad NT: Nat) (row_div: Bool)
    (m1: GlobalM, m3: SharedM, sa: SharedPtr «BK; «BMpad; T»», tid: Nat,
     base_r lim_r base_c: Nat,
     read: [GlobalM, Nat, Nat] → [GlobalM, T])
    : [GlobalM, SharedM] =
    let total = H * W;
    let trips = core.nat.div (core.nat.add (total, core.nat.sub (NT, 1)), NT);
    let exact = core.nat.rem (total, NT) == 0;
    simt_unroll @[GlobalM, SharedM] trips (m1, m3) (λ (s: Idx trips, (m1: GlobalM, m3: SharedM)): [GlobalM, SharedM] =
        let idx     = core.nat.add (tid, core.nat.mul (core.idx2nat s, NT));
        let in_tile = core.select (exact, tt, core.ncmp.l (idx, total));
        simt_when @[GlobalM, SharedM] (in_tile, (m1, m3), λ (m1: GlobalM, m3: SharedM): [GlobalM, SharedM] =
            let r    = core.nat.div (idx, W);
            let c    = core.nat.rem (idx, W);
            let gr   = core.nat.add (base_r, r);
            let gc   = core.nat.add (base_c, c);
            let ok_r = core.select (row_div, tt, core.ncmp.l (gr, lim_r));
            simt_when @[GlobalM, SharedM] (ok_r, (m1, m3), λ (m1: GlobalM, m3: SharedM): [GlobalM, SharedM] =
                let (m1, v) = read (m1, gr, gc);
                let p       = mem.lea (mem.lea (sa, core.conv.u BK (core.bitcast I64 c)), core.conv.u BMpad (core.bitcast I64 r));
                (m1, mem.store (m3, p, v)))));

/// Thread-local `TM × TN` outer-product micro-kernel (`4 | TM`, `4 | TN`) loading 4-wide fragments
/// from transposed `sa` (`BK × BMpad`) and `sb` (`BK × BNpad`) via `vload4` (`LDS.128`).
anx lam simt_reg_mma_v4 {Ta Tb To: *} (BK BMpad BNpad TY TX TM TN Klen: Nat)
    (comb: Fn [GlobalM, To, [Ta, Tb]] → [GlobalM, To])
    (m1: GlobalM, m3: SharedM,
     sa: SharedPtr «BK; «BMpad; Ta»», sb: SharedPtr «BK; «BNpad; Tb»»,
     ty tx: Nat, acc0: «TM; «TN; To»»)
    : [GlobalM, SharedM, «TM; «TN; To»»] =
    let TM4  = core.nat.div (TM, 4);
    let TN4  = core.nat.div (TN, 4);
    let Regs = «TM; «TN; To»»;
    simt_k_loop @Regs Klen (m1, m3, acc0) (λ (kk: Nat, m1: GlobalM, m3: SharedM, acc: Regs): [GlobalM, SharedM, Regs] =
        let kki    = core.conv.u BK (core.bitcast I64 kk);
        let sa_row = mem.lea (sa, kki);
        let sb_row = mem.lea (sb, kki);
        let (m3, a_frag) = simt_unroll @[SharedM, «TM4; «4; Ta»»] TM4 (m3, ‹TM4; ‹4; ⊥:Ta››)
            (λ (ig: Idx TM4, (m3: SharedM, af: «TM4; «4; Ta»»)): [SharedM, «TM4; «4; Ta»»] =
                let r0       = core.nat.mul (core.nat.add (ty, core.nat.mul (core.idx2nat ig, TY)), 4);
                let p        = mem.lea (sa_row, core.conv.u BMpad (core.bitcast I64 r0));
                let (m3, v4) = vload4 @(Ta, addr_space_shared) (m3, p);
                (m3, af#ig ← v4));
        let (m3, b_frag) = simt_unroll @[SharedM, «TN4; «4; Tb»»] TN4 (m3, ‹TN4; ‹4; ⊥:Tb››)
            (λ (jg: Idx TN4, (m3: SharedM, bf: «TN4; «4; Tb»»)): [SharedM, «TN4; «4; Tb»»] =
                let c0       = core.nat.mul (core.nat.add (tx, core.nat.mul (core.idx2nat jg, TX)), 4);
                let p        = mem.lea (sb_row, core.conv.u BNpad (core.bitcast I64 c0));
                let (m3, v4) = vload4 @(Tb, addr_space_shared) (m3, p);
                (m3, bf#jg ← v4));
        let (m1, acc) = simt_unroll @[GlobalM, Regs] TM4 (m1, acc)
            (λ (ig: Idx TM4, (m1: GlobalM, acc: Regs)): [GlobalM, Regs] =
                let av4 = a_frag#ig;
                simt_unroll @[GlobalM, Regs] 4 (m1, acc)
                    (λ (il: Idx 4, (m1: GlobalM, acc: Regs)): [GlobalM, Regs] =
                        let ii = core.conv.u TM (core.bitcast I64 (core.nat.add (core.nat.mul (core.idx2nat ig, 4), core.idx2nat il)));
                        let av = av4#il;
                        simt_unroll @[GlobalM, Regs] TN4 (m1, acc)
                            (λ (jg: Idx TN4, (m1: GlobalM, acc: Regs)): [GlobalM, Regs] =
                                let bv4 = b_frag#jg;
                                simt_unroll @[GlobalM, Regs] 4 (m1, acc)
                                    (λ (jl: Idx 4, (m1: GlobalM, acc: Regs)): [GlobalM, Regs] =
                                        let jj = core.conv.u TN (core.bitcast I64 (core.nat.add (core.nat.mul (core.idx2nat jg, 4), core.idx2nat jl)));
                                        let (m1, nv) = cps.cps2ds comb (m1, acc#ii#jj, (av, bv4#jl));
                                        (m1, acc#ii#jj ← nv)))));
        (m1, m3, acc));

/// Coalesced 4-wide write-back of each thread's `TM × TN` register tile (`4 | TM`, `4 | TN`, `4 | N`).
anx lam simt_store_tile_v4 {To: *} (M N BM BN TY TX TM TN: Nat)
    (m1: GlobalM, block_m block_n ty tx: Nat, acc: «TM; «TN; To»»,
     write4: [GlobalM, Nat, Nat, «4; To»] → GlobalM)
    : GlobalM =
    let TM4   = core.nat.div (TM, 4);
    let TN4   = core.nat.div (TN, 4);
    let m_div = core.nat.rem (M, BM) == 0;
    let n_div = core.nat.rem (N, BN) == 0;
    simt_unroll @GlobalM TM4 m1 (λ (ig: Idx TM4, m1: GlobalM): GlobalM =
        let r0 = core.nat.add (block_m, core.nat.mul (core.nat.add (ty, core.nat.mul (core.idx2nat ig, TY)), 4));
        simt_unroll @GlobalM 4 m1 (λ (il: Idx 4, m1: GlobalM): GlobalM =
            let gm   = core.nat.add (r0, core.idx2nat il);
            let ok_m = core.select (m_div, tt, core.ncmp.l (gm, M));
            let ii   = core.conv.u TM (core.bitcast I64 (core.nat.add (core.nat.mul (core.idx2nat ig, 4), core.idx2nat il)));
            simt_when @GlobalM (ok_m, m1, λ (m1: GlobalM): GlobalM =
                simt_unroll @GlobalM TN4 m1 (λ (jg: Idx TN4, m1: GlobalM): GlobalM =
                    let gn0  = core.nat.add (block_n, core.nat.mul (core.nat.add (tx, core.nat.mul (core.idx2nat jg, TX)), 4));
                    let ok_n = core.select (n_div, tt, core.ncmp.l (gn0, N));
                    simt_when @GlobalM (ok_n, m1, λ (m1: GlobalM): GlobalM =
                        let j0 = core.nat.mul (core.idx2nat jg, 4);
                        let v4: «4; To» = ‹jl: 4; acc#ii#(core.conv.u TN (core.bitcast I64 (core.nat.add (j0, core.idx2nat jl))))›;
                        write4 (m1, gm, gn0, v4))))));

/// Allocate a `Stages`-slot shared-memory ring of `T` in CPS and pass `[m3, slots]` to `body`.
/// Anchoring every `mem.slot` in CPS before `body` guarantees disjoint `addrspace(3)` allocations
/// that LLVM's alias analysis proves non-aliasing and `cps::Conv` never duplicates into inner loops.
anx lam simt_with_shared_ring {T Res: *} (Stages: Nat) (m3: SharedM)
    (body: [SharedM, «Stages; SharedPtr T»] → Res): Res =
    fun go (m3: SharedM)@tt: Res =
        let K = Cn [SharedM, «Stages; SharedPtr T»];
        con finish (m3: SharedM, ps: «Stages; SharedPtr T») = return (body (m3, ps));
        let chain: K = simt_unroll @K Stages finish
            (λ (st: Idx Stages, next: K): K =
                con slot_st (m3: SharedM, ps: «Stages; SharedPtr T») =
                    ret (m3, p) = mem.slot (T, addr_space_shared) $ m3;
                    next (m3, ps#st ← p);
                slot_st);
        chain (m3, ‹Stages; ⊥:(SharedPtr T)›);
    cps.cps2ds go m3;

/// Generic `Stages`-stage static-ring software pipeline (`Stages >= 1`) over `n_steps` iterations.
/// Polymorphic in:
/// - `Slot`: per-stage shared-memory handle (e.g. `[SaPtr, SbPtr]`).
/// - `Tok`:  in-flight handle between `issue` and `arrive` (e.g. `[PrefA, PrefB]` for register-prefetch
///           double-buffering, or `[]` for hardware `cp.async` / TMA rings).
/// - `Acc`:  loop-carried register accumulator.
///
/// The main loop steps by `Stages` and statically unrolls `0..Stages-1` via `simt_unroll`, so every
/// `slots#u` index folds to a compile-time constant with zero runtime modulo or dynamic slot lookup.
anx lam simt_pipe_n {Slot Tok Acc: *} (Stages n_steps: Nat)
    (slots: «Stages; Slot»)
    (m1: GlobalM, m3: SharedM, acc0: Acc)
    (issue:   [Nat, GlobalM, SharedM, Slot] → [GlobalM, SharedM, Tok],
     arrive:  [Nat, GlobalM, SharedM, Slot, Tok] → [GlobalM, SharedM],
     compute: [GlobalM, SharedM, Slot, Acc] → [GlobalM, SharedM, Acc])
    : [GlobalM, SharedM, Acc] =
    let ok_stages = refly.check (0 < Stages, 0 < Stages, "gpu.simt_pipe_n: Stages must be > 0");
    let State     = [GlobalM, SharedM, Acc];
    let run_single = λ (comp: [GlobalM, SharedM, Slot, Acc] → State): State =
        let s0 = slots#(core.idx 0 Stages 0);
        simt_k_loop @Acc n_steps (m1, m3, acc0)
            (λ (k: Nat, m1: GlobalM, m3: SharedM, acc: Acc): State =
                let (m1, m3, tok) = issue (k, m1, m3, s0);
                let (m1, m3)      = arrive (0, m1, m3, s0, tok);
                let (m1, m3, acc) = comp (m1, m3, s0, acc);
                let (m1, m3)      = sync_work_items (m1, m3);
                (m1, m3, acc));
    let run_multi = λ (comp: [GlobalM, SharedM, Slot, Acc] → State): State =
        let raw_d  = core.select (core.nat.sub (Stages, 1) < n_steps, core.nat.sub (Stages, 1), n_steps);
        let D      = core.select (core.bit2.and 2 (1 < Stages, 0 < n_steps), raw_d, 1);
        let Q      = core.nat.sub (D, 1);
        let Q1     = core.select (0 < Q, Q, 1);
        let body   = core.nat.sub (n_steps, D);
        let chunks = core.nat.div (body, Stages);
        let rem    = core.nat.rem (body, Stages);
        let run_pipe = λ {Toks: *} (m1: GlobalM, m3: SharedM, toks0: Toks,
                                    step_tok: [Toks, Tok] → [Tok, Toks],
                                    get_tok:  [Toks, Idx Q] → Tok): State =
            let LoopSt = [Acc, Toks];
            let step_u = λ (k u: Nat, m1: GlobalM, m3: SharedM, acc: Acc, toks: Toks): [GlobalM, SharedM, LoopSt] =
                let cur           = slots#(core.idx 0 Stages u);
                let nxt_i         = slots#(core.idx 0 Stages (core.nat.rem (core.nat.add (u, D), Stages)));
                let nxt_a         = slots#(core.idx 0 Stages (core.nat.rem (core.nat.add (u, 1), Stages)));
                let (m1, m3, nt)  = issue (core.nat.add (k, D), m1, m3, nxt_i);
                let (m1, m3, acc) = comp (m1, m3, cur, acc);
                let (arr_tok, ts) = step_tok (toks, nt);
                let (m1, m3)      = arrive (Q, m1, m3, nxt_a, arr_tok);
                (m1, m3, (acc, ts));
            let do_chunks = λ (c: [GlobalM, SharedM, Slot, Acc] → State): [GlobalM, SharedM, LoopSt] =
                simt_k_loop @LoopSt chunks (m1, m3, (acc0, toks0))
                    (λ (ch: Nat, m1: GlobalM, m3: SharedM, (acc: Acc, toks: Toks)): [GlobalM, SharedM, LoopSt] =
                        let base = core.nat.mul (ch, Stages);
                        simt_unroll @[GlobalM, SharedM, LoopSt] Stages (m1, m3, (acc, toks))
                            (λ (u: Idx Stages, (m1: GlobalM, m3: SharedM, (acc: Acc, toks: Toks))): [GlobalM, SharedM, LoopSt] =
                                let ui = core.idx2nat u;
                                step_u (core.nat.add (base, ui), ui, m1, m3, acc, toks)));
            let (m1, m3, (acc, toks)) = (λ (_: [GlobalM, SharedM, Slot, Acc] → State): [GlobalM, SharedM, LoopSt] = (m1, m3, (acc0, toks0)),
                                         do_chunks)#(core.ncmp.ne (chunks, 0)) comp;
            let do_rem = λ (c: [GlobalM, SharedM, Slot, Acc] → State): [GlobalM, SharedM, LoopSt] =
                let base = core.nat.mul (chunks, Stages);
                simt_unroll @[GlobalM, SharedM, LoopSt] rem (m1, m3, (acc, toks))
                    (λ (u: Idx rem, (m1: GlobalM, m3: SharedM, (acc: Acc, toks: Toks))): [GlobalM, SharedM, LoopSt] =
                        let ui = core.idx2nat u;
                        step_u (core.nat.add (base, ui), ui, m1, m3, acc, toks));
            let (m1, m3, (acc, toks)) = (λ (_: [GlobalM, SharedM, Slot, Acc] → State): [GlobalM, SharedM, LoopSt] = (m1, m3, (acc, toks)),
                                         do_rem)#(core.ncmp.ne (rem, 0)) comp;
            let cur0          = slots#(core.idx 0 Stages (core.nat.rem (body, Stages)));
            let (m1, m3, acc) = comp (m1, m3, cur0, acc);
            simt_unroll @State Q (m1, m3, acc)
                (λ (e: Idx Q, (m1: GlobalM, m3: SharedM, acc: Acc)): State =
                    let ei       = core.idx2nat e;
                    let slot_i   = core.nat.rem (core.nat.add (core.nat.add (body, 1), ei), Stages);
                    let cur      = slots#(core.idx 0 Stages slot_i);
                    let rem_wait = core.nat.sub (core.nat.sub (Q, 1), ei);
                    let (m1, m3) = arrive (rem_wait, m1, m3, cur, get_tok (toks, e));
                    comp (m1, m3, cur, acc));
        let s0             = slots#(core.idx 0 Stages 0);
        let (m1, m3, tok0) = issue (0, m1, m3, s0);
        let run_q0 = λ (_: [GlobalM, SharedM, Slot, Acc] → State): State =
            let (m1, m3) = arrive (0, m1, m3, s0, tok0);
            run_pipe @[] (m1, m3, (),
                λ (_: [], nt: Tok): [Tok, []] = (nt, ()),
                λ (_: [], _: Idx Q): Tok = ⊥:Tok);
        let run_qn = λ (_: [GlobalM, SharedM, Slot, Acc] → State): State =
            let ToksQ = «Q1; Tok»;
            let (m1, m3, toks0) = simt_unroll @[GlobalM, SharedM, ToksQ] Q (m1, m3, ‹Q1; ⊥:Tok›)
                (λ (q: Idx Q, (m1: GlobalM, m3: SharedM, ts: ToksQ)): [GlobalM, SharedM, ToksQ] =
                    let qi            = core.nat.add (core.idx2nat q, 1);
                    let (m1, m3, tok) = issue (qi, m1, m3, slots#(core.idx 0 Stages qi));
                    (m1, m3, ts#(core.idx 0 Q1 (core.idx2nat q)) ← tok));
            let (m1, m3) = arrive (Q, m1, m3, s0, tok0);
            let step_q = λ (ts: ToksQ, nt: Tok): [Tok, ToksQ] =
                let head = ts#(core.idx 0 Q1 0);
                let nxt: ToksQ = ‹j: Q1; (ts#(core.idx 0 Q1 (core.nat.add (core.idx2nat j, 1))), nt)#(core.idx2nat j == core.nat.sub (Q1, 1))›;
                (head, nxt);
            run_pipe @ToksQ (m1, m3, toks0, step_q,
                λ (ts: ToksQ, e: Idx Q): Tok = ts#(core.idx 0 Q1 (core.idx2nat e)));
        (run_q0, run_qn)#(0 < Q) comp;
    let do_any = λ (c: [GlobalM, SharedM, Slot, Acc] → State): State =
        (run_single, run_multi)#(1 < Stages) c;
    (λ (_: [GlobalM, SharedM, Slot, Acc] → State): State = (m1, m3, acc0),
     do_any)#(core.bit2.and 2 (ok_stages, core.ncmp.ne (n_steps, 0))) compute;

/// Vectorized + pipelined SIMT contraction kernel body over `B × M × N × K`.
/// Uses `simt_with_shared_ring` + `simt_pipe_n` and grouped L2 CTA swizzling.
/// Requires `4 | BM`, `4 | BN`, `4 | BK`, `4 | TM`, `4 | TN`, `4 | N`, `NT | (BM*BK/4)`, `NT | (BK*BN/4)`; PE rejects anything else.
anx lam simt_tiled_kernel_v4 {Ta Tb To: *}
    (B M N K BM BN BK TM TN Pad Dbuf: Nat)
    (init: To, comb: Fn [GlobalM, To, [Ta, Tb]] → [GlobalM, To])
    (read_a4:  [GlobalM, Nat, Nat, Nat] → [GlobalM, «4; Ta»],
     read_b4:  [GlobalM, Nat, Nat, Nat] → [GlobalM, «4; Tb»],
     read_a1:  [GlobalM, Nat, Nat, Nat] → [GlobalM, Ta],
     read_b1:  [GlobalM, Nat, Nat, Nat] → [GlobalM, Tb],
     write_c4: [GlobalM, Nat, Nat, Nat, «4; To»] → GlobalM)
    (m1: GlobalM, m3: SharedM, group_id item_id: Nat)
    : [GlobalM, SharedM] =
    let four  = λ (x: Nat): Bool = core.nat.rem (x, 4) == 0;
    let TM    = refly.check (core.bit2.and 2 (core.bit2.and 2 (0 < TM, four TM), core.nat.rem (BM, TM) == 0), TM,
        "gpu.simt_tiled_kernel_v4: TM must be a positive multiple of 4 that divides BM");
    let TN    = refly.check (core.bit2.and 2 (core.bit2.and 2 (0 < TN, four TN), core.nat.rem (BN, TN) == 0), TN,
        "gpu.simt_tiled_kernel_v4: TN must be a positive multiple of 4 that divides BN");
    let BK    = refly.check (core.bit2.and 2 (0 < BK, four BK), BK, "gpu.simt_tiled_kernel_v4: BK must be a positive multiple of 4");
    let N     = refly.check (four N, N, "gpu.simt_tiled_kernel_v4: 4 must divide N for 4-wide reads and writes of B and C");
    let TY    = core.nat.div (BM, TM);
    let TX    = core.nat.div (BN, TN);
    let NT    = refly.check (TY * TX <= 1024, TY * TX,
        "gpu.simt_tiled_kernel_v4: block thread count (BM/TM)*(BN/TN) exceeds 1024");
    let pad4  = core.select (Pad == 0, 0, core.nat.mul (core.nat.div (core.nat.add (Pad, 3), 4), 4));
    let BMpad = core.nat.add (BM, pad4);
    let BNpad = core.nat.add (BN, pad4);
    let gm_blks = core.nat.div (core.nat.add (M, core.nat.sub (BM, 1)), BM);
    let gn_blks = core.nat.div (core.nat.add (N, core.nat.sub (BN, 1)), BN);
    let mn_blks = gm_blks * gn_blks;
    let batch   = (0, core.nat.div (group_id, mn_blks))#(1 < B);
    let blk_rem = (group_id, core.nat.rem (group_id, mn_blks))#(1 < B);
    let sw_m    = core.select (gm_blks < 8, gm_blks, 8);
    let grp_sz  = sw_m * gn_blks;
    let grp_id  = core.nat.div (blk_rem, grp_sz);
    let first_m = core.nat.mul (grp_id, sw_m);
    let rem_m   = core.nat.sub (gm_blks, first_m);
    let grp_m   = core.select (rem_m < sw_m, rem_m, sw_m);
    let in_grp  = core.nat.rem (blk_rem, grp_sz);
    let bm_id   = core.nat.add (first_m, core.nat.rem (in_grp, grp_m));
    let bn_id   = core.nat.div (in_grp, grp_m);
    let block_m = core.nat.mul (bm_id, BM);
    let block_n = core.nat.mul (bn_id, BN);
    let ty      = core.nat.div (item_id, TX);
    let tx      = core.nat.rem (item_id, TX);
    let m_div   = core.nat.rem (M, BM) == 0;
    let n_div   = core.nat.rem (N, BN) == 0;
    let full_k  = core.nat.div (K, BK);
    let tail_k  = core.nat.rem (K, BK);
    let stages  = core.select (core.bit2.and 2 (core.ncmp.ne (Dbuf, 0), 1 < full_k), 2, 1);
    let Regs    = «TM; «TN; To»»;
    let acc0    = ‹TM; ‹TN; init››;
    let ra4     = λ (m1: GlobalM, r c: Nat): [GlobalM, «4; Ta»] = read_a4 (m1, batch, r, c);
    let rb4     = λ (m1: GlobalM, r c: Nat): [GlobalM, «4; Tb»] = read_b4 (m1, batch, r, c);
    let ra1     = λ (m1: GlobalM, r c: Nat): [GlobalM, Ta]      = read_a1 (m1, batch, r, c);
    let rb1     = λ (m1: GlobalM, r c: Nat): [GlobalM, Tb]      = read_b1 (m1, batch, r, c);
    let wc4     = λ (m1: GlobalM, r c: Nat, v: «4; To»): GlobalM = write_c4 (m1, batch, r, c, v);
    let SaPtr   = SharedPtr «BK; «BMpad; Ta»»;
    let SbPtr   = SharedPtr «BK; «BNpad; Tb»»;
    let Slot    = [SaPtr, SbPtr];
    let PrefA   = «core.nat.div (BM * core.nat.div (BK, 4), NT); «4; Ta»»;
    let PrefB   = «core.nat.div (BK * core.nat.div (BN, 4), NT); «4; Tb»»;
    let Pref    = [PrefA, PrefB];

    simt_with_shared_ring @(«BK; «BMpad; Ta»», [GlobalM, SharedM]) stages m3
        (λ (m3: SharedM, sa_slots: «stages; SaPtr»): [GlobalM, SharedM] =
            simt_with_shared_ring @(«BK; «BNpad; Tb»», [GlobalM, SharedM]) stages m3
                (λ (m3: SharedM, sb_slots: «stages; SbPtr»): [GlobalM, SharedM] =
                    let slots: «stages; Slot» = ‹st: stages; (sa_slots#st, sb_slots#st)›;
                    let issue = λ (kt: Nat, m1: GlobalM, m3: SharedM, _: Slot): [GlobalM, SharedM, Pref] =
                        let kb       = core.nat.mul (kt, BK);
                        let (m1, pa) = simt_prefetch_v4 @Ta (BM, BK, NT) (m_div, tt) (m1, item_id, block_m, M, kb, K, ra4);
                        let (m1, pb) = simt_prefetch_v4 @Tb (BK, BN, NT) (tt, n_div) (m1, item_id, kb, K, block_n, N, rb4);
                        (m1, m3, (pa, pb));
                    let arrive = λ (_: Nat, m1: GlobalM, m3: SharedM, (sa: SaPtr, sb: SbPtr), (pa: PrefA, pb: PrefB)): [GlobalM, SharedM] =
                        let m3 = simt_commit_t_v4 @Ta (BM, BK, BMpad, NT) (m3, sa, item_id, pa);
                        let m3 = simt_commit_v4   @Tb (BK, BN, BNpad, NT) (m3, sb, item_id, pb);
                        sync_work_items (m1, m3);
                    let compute = λ (m1: GlobalM, m3: SharedM, (sa: SaPtr, sb: SbPtr), acc: Regs): [GlobalM, SharedM, Regs] =
                        simt_reg_mma_v4 @(Ta, Tb, To) (BK, BMpad, BNpad, TY, TX, TM, TN, BK) comb (m1, m3, sa, sb, ty, tx, acc);
                    let (m1, m3, acc) = simt_pipe_n @(Slot, Pref, Regs) (stages, full_k) slots (m1, m3, acc0) (issue, arrive, compute);
                    let do_tail = λ (st: Slot): [GlobalM, SharedM, Regs] =
                        let (sa0, sb0) = st;
                        let (m1, m3)   = (λ (s: [GlobalM, SharedM]): [GlobalM, SharedM] = s,
                                          sync_work_items)#(1 < stages) (m1, m3);
                        let kb         = core.nat.mul (full_k, BK);
                        let (m1, m3)   = simt_stage_tile_t @Ta (BK, BM, tail_k, BMpad, NT) m_div (m1, m3, sa0, item_id, block_m, M, kb, ra1);
                        let (m1, m3)   = simt_stage_tile   @Tb (BK, tail_k, BN, BNpad, NT) (tt, n_div) (m1, m3, sb0, item_id, kb, K, block_n, N, rb1);
                        let (m1, m3)   = sync_work_items (m1, m3);
                        simt_reg_mma_v4 @(Ta, Tb, To) (BK, BMpad, BNpad, TY, TX, TM, TN, tail_k) comb (m1, m3, sa0, sb0, ty, tx, acc);
                    let (m1, m3, acc) = (λ (_: Slot): [GlobalM, SharedM, Regs] = (m1, m3, acc),
                                         do_tail)#(core.ncmp.ne (tail_k, 0)) (slots#(core.idx 0 stages 0));
                    let m1 = simt_store_tile_v4 @To (M, N, BM, BN, TY, TX, TM, TN) (m1, block_m, block_n, ty, tx, acc, wc4);
                    (m1, m3)));

/// ## PE-Erased CuTe-Style Layout, Fragment & Tensor Core (`mma.sync.m16n8k16` + `cp.async`) Combinators
///
/// Compile-time-erased layouts and warp-collective Tensor Core fragments over 16-byte (`«8; T»`) chunks:
/// - `cu_swizzle_chunk` / `cu_smem_chunk_ptr`: bank-conflict-free 64B (`Swizzle<2,3,2>`) and 128B+ (`Swizzle<3,3,3>`) XOR layouts.
/// - `cu_mma_m16n8k16_*`: PTX ISA `m16n8k16` coordinate maps for `C`, `A` (`ldmatrix.x4`), and `B` (both `NN` via `.trans` and `NT`).
/// - `cu_mma_frag_row_reduce` / `cu_mma_frag_c2_to_a`: composable register-fragment algebra (row reductions, C→A in-register recast).
/// - `cu_copy_tile_cp_async` / `cu_warp_mma_m16n8k16` / `cu_store_mma_c` / `tc_tiled_kernel_m16n8k16`: multi-stage async Tensor Core GEMM.

/// Bank-conflict-free XOR swizzle on 16-byte (`«8; T»`) column chunk index `c8` of row `r`:
/// - `8 | Cols8` (128B+ row stride): `c8 ^ (r & 7)` (`Swizzle<3,3,3>`, 0 bank conflicts on both `cp.async` and `ldmatrix.x4`).
/// - `Cols8 % 8 == 4` (64B row stride): `c8 ^ ((r >> 1) & 3)` (`Swizzle<2,3,2>`, 0 bank conflicts across 8 consecutive rows).
/// - otherwise: identity `c8`.
anx lam cu_swizzle_chunk (Cols8: Nat) (r c8: Nat): Nat =
    let is_128 = core.nat.rem (Cols8, 8) == 0;
    let is_64  = core.nat.rem (Cols8, 8) == 4;
    let mask   = core.select (is_128, core.nat.rem (r, 8),
                 core.select (is_64,  core.nat.rem (core.nat.div (r, 2), 4), 0));
    core.bitcast Nat (core.bit2.xor 0 (core.bitcast I64 c8, core.bitcast I64 mask));

/// Typed pointer to swizzled 16-byte chunk `(r, c8)` inside a `Rows × Cols8` shared tile of `«8; T»`.
anx lam cu_smem_chunk_ptr {T: *} (Rows Cols8: Nat)
    (smem: SharedPtr «Rows; «Cols8; «8; T»»», r c8: Nat): SharedPtr «8; T» =
    let c8_sw = cu_swizzle_chunk Cols8 (r, c8);
    mem.lea (mem.lea (smem, core.idx 0 Rows r), core.idx 0 Cols8 c8_sw);

/// PTX ISA `mma.sync.m16n8k16` C-fragment element `(row, col)` in `16 × 8` held by `(lane, reg)`.
anx lam cu_mma_m16n8k16_c_coord (lane: Nat, reg: Idx 4): [Nat, Nat] =
    let j = core.idx2nat reg;
    (core.nat.add (core.nat.div (lane, 4), core.nat.mul (8, core.nat.div (j, 2))),
     core.nat.add (core.nat.mul (2, core.nat.rem (lane, 4)), core.nat.rem (j, 2)));

/// Row-major `A` (`16 × 16`) chunk address `[row, k8]` for `ldmatrix.sync.aligned.m8n8.x4.b16`.
anx lam cu_mma_m16n8k16_a_addr (lane: Nat): [Nat, Nat] =
    (core.nat.rem (lane, 16), core.nat.div (lane, 16));

/// Row-major `B` (`16 × 16` covering two `16 × 8` N-tiles) chunk address `[k, n8]` for `ldmatrix.x4.trans`.
anx lam cu_mma_m16n8k16_b_addr_rn (lane: Nat): [Nat, Nat] =
    (core.nat.rem (lane, 16), core.nat.div (lane, 16));

/// K-major `B` (`16 × 16` stored as `N × K`, covering two `16 × 8` N-tiles) chunk address `[n, k8]` for `ldmatrix.x4`.
anx lam cu_mma_m16n8k16_b_addr_rk (lane: Nat): [Nat, Nat] =
    (core.nat.add (core.nat.rem (lane, 8), core.nat.mul (8, core.nat.div (lane, 16))),
     core.nat.rem (core.nat.div (lane, 8), 2));

/// PE-erased register-fragment row reduction over a warp's `WM × WN` grid of `m16n8k16` F32 C-fragments.
/// Reduces all `8 * WN` columns of each logical row in registers + 4-lane quad `warp_shfl_xor` (offsets 2, 1),
/// returning `«WM; «2; F32»»` (the upper `r0` and lower `r0 + 8` row results for this lane).
anx lam cu_mma_frag_row_reduce (WM WN: Nat)
    (init: math.F32, merge: Fn [GlobalM, math.F32, math.F32] → [GlobalM, math.F32])
    (m1: GlobalM, acc: «WM; «WN; «4; math.F32»»»): [GlobalM, «WM; «2; math.F32»»] =
    let Out = «WM; «2; math.F32»»;
    simt_unroll @[GlobalM, Out] WM (m1, ‹WM; ‹2; init››)
        (λ (mi: Idx WM, (m1: GlobalM, out: Out)): [GlobalM, Out] =
            let (m1, r0, r1) = simt_unroll @[GlobalM, math.F32, math.F32] WN (m1, init, init)
                (λ (ni: Idx WN, (m1: GlobalM, v0 v1: math.F32)): [GlobalM, math.F32, math.F32] =
                    let c = acc#mi#ni;
                    let (m1, v0) = cps.cps2ds merge (m1, v0, c#(core.idx 0 4 0));
                    let (m1, v0) = cps.cps2ds merge (m1, v0, c#(core.idx 0 4 1));
                    let (m1, v1) = cps.cps2ds merge (m1, v1, c#(core.idx 0 4 2));
                    let (m1, v1) = cps.cps2ds merge (m1, v1, c#(core.idx 0 4 3));
                    (m1, v0, v1));
            let (m1, r0) = simt_warp_reduce @math.F32 4 merge (m1, r0);
            let (m1, r1) = simt_warp_reduce @math.F32 4 merge (m1, r1);
            (m1, out#mi ← (r0, r1)));

/// PE-erased zero-smem register conversion of two side-by-side `16 × 8` F32 C-fragments into one `16 × 16` A-fragment.
anx lam cu_mma_frag_c2_to_a {T: *} (down: math.F32 → T) (c0 c1: «4; math.F32»): «4; «2; T»» =
    let cs: «2; «4; math.F32»» = (c0, c1);
    ‹reg: 4; ‹h: 2;
        let r = core.idx2nat reg;
        down (cs#(core.idx 0 2 (core.nat.div (r, 2)))#(core.idx 0 4 (core.nat.add (core.nat.mul (2, core.nat.rem (r, 2)), core.idx2nat h))))››;

/// Cooperative 16-byte (`«8; T»`) `cp.async.cg.16` global→shared tile copy with swizzled destination layout.
/// Out-of-bounds chunks zero-fill shared memory via `cp_async_zero_16`; `r_div` / `c_div` statically elide bounds checks.
anx lam cu_copy_tile_cp_async {T: *} (Rows Cols NT: Nat) (r_div c_div: Bool)
    (m1: GlobalM, m3: SharedM, smem: SharedPtr «Rows; «core.nat.div (Cols, 8); «8; T»»», tid: Nat,
     base_r lim_r base_c lim_c: Nat,
     ptr_g: [GlobalM, Nat, Nat] → [GlobalM, GlobalPtr T])
    : [GlobalM, SharedM] =
    let Cols8 = core.nat.div (Cols, 8);
    let total = Rows * Cols8;
    let steps = refly.check (core.nat.rem (total, NT) == 0, core.nat.div (total, NT),
        "gpu.cu_copy_tile_cp_async: NT must divide Rows*(Cols/8)");
    simt_unroll @[GlobalM, SharedM] steps (m1, m3)
        (λ (s: Idx steps, (m1: GlobalM, m3: SharedM)): [GlobalM, SharedM] =
            let idx  = core.nat.add (tid, core.nat.mul (core.idx2nat s, NT));
            let r    = core.nat.div (idx, Cols8);
            let c8   = core.nat.rem (idx, Cols8);
            let gr   = core.nat.add (base_r, r);
            let gc   = core.nat.add (base_c, core.nat.mul (c8, 8));
            let ok   = core.bit2.and 2 (core.select (r_div, tt, core.ncmp.l (gr, lim_r)),
                                        core.select (c_div, tt, core.ncmp.l (gc, lim_c)));
            let sptr = cu_smem_chunk_ptr @T (Rows, Cols8) (smem, r, c8);
            simt_if_else @[GlobalM, SharedM] (ok, (m1, m3),
                λ ((m1: GlobalM, m3: SharedM)): [GlobalM, SharedM] =
                    let (m1, gptr) = ptr_g (m1, gr, gc);
                    cp_async_cg_16 @(«8; T», T) (m1, m3, sptr, gptr),
                λ ((m1: GlobalM, m3: SharedM)): [GlobalM, SharedM] =
                    (m1, cp_async_zero_16 @«8; T» (m3, sptr))));

/// Warp-level `mma.sync.m16n8k16` micro-kernel over swizzled shared A (`BM × BK`) and B (`BK × BN` or `BN × BK`).
/// Uses `ldmatrix.x4` for A and `ldmatrix.x4{.trans}` for pairs of N-tiles of B.
anx lam cu_warp_mma_m16n8k16 {T: *} (BM BN BK WY WX: Nat) (b_k_major: Bool)
    (mma_op: [GlobalM, «4; «2; T»», «2; «2; T»», «4; math.F32»] → [GlobalM, «4; math.F32»])
    (m1: GlobalM, m3: SharedM,
     sa: SharedPtr «BM; «core.nat.div (BK, 8); «8; T»»»,
     sb: SharedPtr «core.select (b_k_major, BN, BK); «core.nat.div (core.select (b_k_major, BK, BN), 8); «8; T»»»,
     wy wx lane: Nat,
     acc0: «core.nat.div (core.nat.div (BM, WY), 16); «core.nat.div (core.nat.div (BN, WX), 8); «4; math.F32»»»)
    : [GlobalM, SharedM, «core.nat.div (core.nat.div (BM, WY), 16); «core.nat.div (core.nat.div (BN, WX), 8); «4; math.F32»»»] =
    let BK8    = core.nat.div (BK, 8);
    let Brows  = core.select (b_k_major, BN, BK);
    let Bcols  = core.select (b_k_major, BK, BN);
    let Bcols8 = core.nat.div (Bcols, 8);
    let WM     = core.nat.div (core.nat.div (BM, WY), 16);
    let WN     = core.nat.div (core.nat.div (BN, WX), 8);
    let WN2    = core.nat.div (WN, 2);
    let KS     = core.nat.div (BK, 16);
    let Acc    = «WM; «WN; «4; math.F32»»»;
    let FragA  = «4; «2; T»»;
    let FragB  = «2; «2; T»»;
    let AFrags = «WM; FragA»;
    let BFrags = «WN; FragB»;
    let wm_off = core.nat.mul (wy, core.nat.mul (WM, 16));
    let wn_off = core.nat.mul (wx, core.nat.mul (WN, 8));
    let wn8_off = core.nat.div (wn_off, 8);
    let (da_r, da_k8)  = cu_mma_m16n8k16_a_addr lane;
    let (db_kr, db_n8) = cu_mma_m16n8k16_b_addr_rn lane;
    let (db_nr, db_k8) = cu_mma_m16n8k16_b_addr_rk lane;
    let b_trans        = core.select (b_k_major, ff, tt);

    simt_unroll @[GlobalM, SharedM, Acc] KS (m1, m3, acc0)
        (λ (ks: Idx KS, (m1: GlobalM, m3: SharedM, acc: Acc)): [GlobalM, SharedM, Acc] =
            let k_base  = core.nat.mul (core.idx2nat ks, 16);
            let k8_base = core.nat.mul (core.idx2nat ks, 2);
            // Load WM A fragments via ldmatrix.x4.
            let (m1, m3, a_frags) = simt_unroll @[GlobalM, SharedM, AFrags] WM (m1, m3, ‹WM; ⊥:FragA›)
                (λ (mi: Idx WM, (m1: GlobalM, m3: SharedM, af: AFrags)): [GlobalM, SharedM, AFrags] =
                    let sr   = core.nat.add (wm_off, core.nat.add (core.nat.mul (core.idx2nat mi, 16), da_r));
                    let sc8  = core.nat.add (k8_base, da_k8);
                    let sptr = cu_smem_chunk_ptr @T (BM, BK8) (sa, sr, sc8);
                    let (m1, m3, a4) = ldmatrix_b16 @(T, «8; T») (4, ff, m1, m3, sptr);
                    (m1, m3, af#mi ← a4));
            // Load WN = 2*WN2 B fragments via WN2 calls to ldmatrix.x4{.trans}.
            let (m1, m3, b_frags) = simt_unroll @[GlobalM, SharedM, BFrags] WN2 (m1, m3, ‹WN; ⊥:FragB›)
                (λ (ni2: Idx WN2, (m1: GlobalM, m3: SharedM, bf: BFrags)): [GlobalM, SharedM, BFrags] =
                    let n_pair = core.nat.mul (core.idx2nat ni2, 2);
                    let sb_r   = core.select (b_k_major,
                                     core.nat.add (wn_off, core.nat.add (core.nat.mul (n_pair, 8), db_nr)),
                                     core.nat.add (k_base, db_kr));
                    let sb_c8  = core.select (b_k_major,
                                     core.nat.add (k8_base, db_k8),
                                     core.nat.add (wn8_off, core.nat.add (n_pair, db_n8)));
                    let sptr   = cu_smem_chunk_ptr @T (Brows, Bcols8) (sb, sb_r, sb_c8);
                    let (m1, m3, b4) = ldmatrix_b16 @(T, «8; T») (4, b_trans, m1, m3, sptr);
                    let b_lo: FragB = (b4#(core.idx 0 4 0), b4#(core.idx 0 4 1));
                    let b_hi: FragB = (b4#(core.idx 0 4 2), b4#(core.idx 0 4 3));
                    let bf = bf#(core.idx 0 WN n_pair) ← b_lo;
                    let bf = bf#(core.idx 0 WN (core.nat.add (n_pair, 1))) ← b_hi;
                    (m1, m3, bf));
            // Outer-product MMA over WM × WN tiles.
            let (m1, acc) = simt_unroll @[GlobalM, Acc] WM (m1, acc)
                (λ (mi: Idx WM, (m1: GlobalM, acc: Acc)): [GlobalM, Acc] =
                    let am = a_frags#mi;
                    simt_unroll @[GlobalM, Acc] WN (m1, acc)
                        (λ (ni: Idx WN, (m1: GlobalM, acc: Acc)): [GlobalM, Acc] =
                            let row = acc#mi;
                            let (m1, d) = mma_op (m1, am, b_frags#ni, row#ni);
                            (m1, acc#mi ← (row#ni ← d))));
            (m1, m3, acc));

/// Coalesced global write-back of a warp's `WM × WN` `m16n8k16` F32 accumulator fragments via 2-wide stores.
anx lam cu_store_mma_c (M N BM BN WY WX: Nat)
    (m1: GlobalM, block_m block_n wy wx lane: Nat,
     acc: «core.nat.div (core.nat.div (BM, WY), 16); «core.nat.div (core.nat.div (BN, WX), 8); «4; math.F32»»»,
     write2: [GlobalM, Nat, Nat, «2; math.F32»] → GlobalM): GlobalM =
    let WM     = core.nat.div (core.nat.div (BM, WY), 16);
    let WN     = core.nat.div (core.nat.div (BN, WX), 8);
    let m_div  = core.nat.rem (M, BM) == 0;
    let n_div  = core.nat.rem (N, BN) == 0;
    let wm_off = core.nat.add (block_m, core.nat.mul (wy, core.nat.mul (WM, 16)));
    let wn_off = core.nat.add (block_n, core.nat.mul (wx, core.nat.mul (WN, 8)));
    let (dr0, dc0) = cu_mma_m16n8k16_c_coord (lane, core.idx 0 4 0);
    let (dr1, _)   = cu_mma_m16n8k16_c_coord (lane, core.idx 0 4 2);
    simt_unroll @GlobalM WM m1 (λ (mi: Idx WM, m1: GlobalM): GlobalM =
        let m_base = core.nat.add (wm_off, core.nat.mul (core.idx2nat mi, 16));
        let gm0    = core.nat.add (m_base, dr0);
        let gm1    = core.nat.add (m_base, dr1);
        let ok_m0  = core.select (m_div, tt, core.ncmp.l (gm0, M));
        let ok_m1  = core.select (m_div, tt, core.ncmp.l (gm1, M));
        simt_unroll @GlobalM WN m1 (λ (ni: Idx WN, m1: GlobalM): GlobalM =
            let gn   = core.nat.add (wn_off, core.nat.add (core.nat.mul (core.idx2nat ni, 8), dc0));
            let ok_n = core.select (n_div, tt, core.ncmp.l (gn, N));
            let c    = acc#mi#ni;
            let v0: «2; math.F32» = (c#(core.idx 0 4 0), c#(core.idx 0 4 1));
            let v1: «2; math.F32» = (c#(core.idx 0 4 2), c#(core.idx 0 4 3));
            let m1 = simt_when @GlobalM (core.bit2.and 2 (ok_m0, ok_n), m1,
                         λ (m1: GlobalM): GlobalM = write2 (m1, gm0, gn, v0));
            simt_when @GlobalM (core.bit2.and 2 (ok_m1, ok_n), m1,
                λ (m1: GlobalM): GlobalM = write2 (m1, gm1, gn, v1))));

/// Multi-stage asynchronous Tensor Core (`mma.sync.m16n8k16` + `cp.async.cg.16` + `ldmatrix.x4`) contraction kernel.
/// Composes grouped L2 CTA swizzle, `simt_with_shared_ring`, `simt_pipe_n @(Slot, [], Acc)`, swizzled shared tiles,
/// `cu_warp_mma_m16n8k16`, and coalesced `cu_store_mma_c`. Supports both `NN` (`b_k_major = ff`) and `NT` (`b_k_major = tt`).
anx lam tc_tiled_kernel_m16n8k16 {T: *}
    (B M N K BM BN BK WY WX Stages: Nat) (b_k_major: Bool)
    (mma_op: [GlobalM, «4; «2; T»», «2; «2; T»», «4; math.F32»] → [GlobalM, «4; math.F32»])
    (ptr_a:    [GlobalM, Nat, Nat, Nat] → [GlobalM, GlobalPtr T],
     ptr_b:    [GlobalM, Nat, Nat, Nat] → [GlobalM, GlobalPtr T],
     write_c2: [GlobalM, Nat, Nat, Nat, «2; math.F32»] → GlobalM)
    (m1: GlobalM, m3: SharedM, group_id item_id: Nat)
    : [GlobalM, SharedM] =
    let WY     = refly.check (core.bit2.and 2 (0 < WY, core.nat.rem (BM, core.nat.mul (WY, 16)) == 0), WY,
        "gpu.tc_tiled_kernel_m16n8k16: WY*16 must divide BM");
    let WX     = refly.check (core.bit2.and 2 (0 < WX, core.nat.rem (BN, core.nat.mul (WX, 16)) == 0), WX,
        "gpu.tc_tiled_kernel_m16n8k16: WX*16 must divide BN");
    let BK     = refly.check (core.bit2.and 2 (0 < BK, core.nat.rem (BK, 16) == 0), BK,
        "gpu.tc_tiled_kernel_m16n8k16: BK must be a positive multiple of 16");
    let NT     = refly.check (core.nat.mul (core.nat.mul (WY, WX), 32) <= 1024, core.nat.mul (core.nat.mul (WY, WX), 32),
        "gpu.tc_tiled_kernel_m16n8k16: block thread count WY*WX*32 exceeds 1024");
    let BK8    = core.nat.div (BK, 8);
    let Brows  = core.select (b_k_major, BN, BK);
    let Bcols  = core.select (b_k_major, BK, BN);
    let Bcols8 = core.nat.div (Bcols, 8);
    let WM     = core.nat.div (core.nat.div (BM, WY), 16);
    let WN     = core.nat.div (core.nat.div (BN, WX), 8);
    let gm_blks = core.nat.div (core.nat.add (M, core.nat.sub (BM, 1)), BM);
    let gn_blks = core.nat.div (core.nat.add (N, core.nat.sub (BN, 1)), BN);
    let mn_blks = gm_blks * gn_blks;
    let batch   = (0, core.nat.div (group_id, mn_blks))#(1 < B);
    let blk_rem = (group_id, core.nat.rem (group_id, mn_blks))#(1 < B);
    let sw_m    = core.select (gm_blks < 8, gm_blks, 8);
    let grp_sz  = sw_m * gn_blks;
    let grp_id  = core.nat.div (blk_rem, grp_sz);
    let first_m = core.nat.mul (grp_id, sw_m);
    let rem_m   = core.nat.sub (gm_blks, first_m);
    let grp_m   = core.select (rem_m < sw_m, rem_m, sw_m);
    let in_grp  = core.nat.rem (blk_rem, grp_sz);
    let bm_id   = core.nat.add (first_m, core.nat.rem (in_grp, grp_m));
    let bn_id   = core.nat.div (in_grp, grp_m);
    let block_m = core.nat.mul (bm_id, BM);
    let block_n = core.nat.mul (bn_id, BN);
    let warp_id = core.nat.div (item_id, 32);
    let lane    = core.nat.rem (item_id, 32);
    let wy      = core.nat.div (warp_id, WX);
    let wx      = core.nat.rem (warp_id, WX);
    let m_div   = core.nat.rem (M, BM) == 0;
    let n_div   = core.nat.rem (N, BN) == 0;
    let k_div   = core.nat.rem (K, BK) == 0;
    let k_tiles = core.nat.div (core.nat.add (K, core.nat.sub (BK, 1)), BK);
    let SaTile  = «BM; «BK8; «8; T»»»;
    let SbTile  = «Brows; «Bcols8; «8; T»»»;
    let SaPtr   = SharedPtr SaTile;
    let SbPtr   = SharedPtr SbTile;
    let Slot    = [SaPtr, SbPtr];
    let Acc     = «WM; «WN; «4; math.F32»»»;
    let acc0    = ‹WM; ‹WN; ‹4; 0:math.F32›››;
    let pa      = λ (m1: GlobalM, r c: Nat): [GlobalM, GlobalPtr T] = ptr_a (m1, batch, r, c);
    let pb      = λ (m1: GlobalM, r c: Nat): [GlobalM, GlobalPtr T] = ptr_b (m1, batch, r, c);
    let wc2     = λ (m1: GlobalM, r c: Nat, v: «2; math.F32»): GlobalM = write_c2 (m1, batch, r, c, v);

    simt_with_shared_ring @(SaTile, [GlobalM, SharedM]) Stages m3
        (λ (m3: SharedM, sa_slots: «Stages; SaPtr»): [GlobalM, SharedM] =
            simt_with_shared_ring @(SbTile, [GlobalM, SharedM]) Stages m3
                (λ (m3: SharedM, sb_slots: «Stages; SbPtr»): [GlobalM, SharedM] =
                    let slots: «Stages; Slot» = ‹st: Stages; (sa_slots#st, sb_slots#st)›;
                    let issue = λ (kt: Nat, m1: GlobalM, m3: SharedM, (sa: SaPtr, sb: SbPtr)): [GlobalM, SharedM, []] =
                        let kb       = core.nat.mul (kt, BK);
                        let (m1, m3) = cu_copy_tile_cp_async @T (BM, BK, NT) (m_div, k_div) (m1, m3, sa, item_id, block_m, M, kb, K, pa);
                        let b_r_div  = core.select (b_k_major, n_div, k_div);
                        let b_c_div  = core.select (b_k_major, k_div, n_div);
                        let b_br     = core.select (b_k_major, block_n, kb);
                        let b_lr     = core.select (b_k_major, N, K);
                        let b_bc     = core.select (b_k_major, kb, block_n);
                        let b_lc     = core.select (b_k_major, K, N);
                        let (m1, m3) = cu_copy_tile_cp_async @T (Brows, Bcols, NT) (b_r_div, b_c_div) (m1, m3, sb, item_id, b_br, b_lr, b_bc, b_lc, pb);
                        let (m1, m3) = cp_async_commit (m1, m3);
                        (m1, m3, ());
                    let arrive = λ (rem_wait: Nat, m1: GlobalM, m3: SharedM, _: Slot, _: []): [GlobalM, SharedM] =
                        let (m1, m3) = cp_async_wait_group rem_wait (m1, m3);
                        sync_work_items (m1, m3);
                    let compute = λ (m1: GlobalM, m3: SharedM, (sa: SaPtr, sb: SbPtr), acc: Acc): [GlobalM, SharedM, Acc] =
                        cu_warp_mma_m16n8k16 @T (BM, BN, BK, WY, WX) b_k_major mma_op (m1, m3, sa, sb, wy, wx, lane, acc);
                    let (m1, m3, acc) = simt_pipe_n @(Slot, [], Acc) (Stages, k_tiles) slots (m1, m3, acc0) (issue, arrive, compute);
                    let m1 = cu_store_mma_c (M, N, BM, BN, WY, WX) (m1, block_m, block_n, wy, wx, lane, acc, wc2);
                    (m1, m3)));
