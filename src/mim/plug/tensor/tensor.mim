/// # The tensor Plugin {#tensor}
///
/// @see [`-X tensor:<arg>`](@ref xarg_tensor)
/// @see mim::plug::tensor
///
/// [TOC]
///
/// SSA-world tensor operations: a generic `map_reduce` loop-nest abstraction plus derived operations
/// (reshape, slice, convolution, pooling, dot product, ...), lowered via `affine` loops and bufferized
/// onto the `buffer` layer.
///
/// ## Dependencies
///
plugin tuple;
plugin refly;
plugin core;
import compile;
plugin option;
plugin vec;
plugin cps;
plugin affine;
plugin buffer;
plugin btensor;
plugin math;

use core.ops.n;
///
/// ## Types
///
/// ### Ring
///
/// Represents an [algebraic ring](https://en.wikipedia.org/wiki/Ring_(mathematics)).
/// E.g., `let nat_ring = (Nat, 0, core.nat.add, core.nat.mul);`.
///
/// An alias for `btensor.Ring`.
/// The buffer-world `btensor` plugin sits *below* `tensor` — `lower_to_mem` bufferizes onto `btensor.*` ops -
/// so the definition lives there and both layers share one notion of a ring.
anx Ring = btensor.Ring;
///
/// ### Tensor
///
/// `Tensor r s T` carries a logical rank `r`, shape `s` and element type `T`, distinct from ordinary arrays.
/// Its nominal key identifies tensors across shape substitution and function boundaries without classifying shape or index arrays as tensors.
/// The singleton witness preserves all three indices even when rank-0, singleton or empty array representations fold away.
/// For example, `Tensor 2 (1, 4) I32` differs from `Tensor 1 4 I32`, and `Tensor 0 () I32` differs from `I32`.
/// `⊥:T` records the element type without being evaluated; the singleton witness is erased before code generation.
/// The private representation prevents array access from bypassing tensor operations.
priv nom Tensor (r: Nat) (s: «r; Nat») (T: *) = [indices: «(r, s, ⊥:T)», data: «s; T»];
/// The annex lets lowering identify the exported type constructor.
pub anx let Tensor = Tensor;
axm buf: {r: Nat, s: «r; Nat», T: *} → Tensor r s T → Tensor r s T;
///
/// ### LayoutExpr
///
/// An opaque physical-layout value stores only canonical layout data.
pub mod layout_expr
anx nom Data (r: Nat, s: «r; Nat») =
    [logical: «s»,
     split: Nat,
     perm: «r + 1; Idx (r + 1)»,
     pad: «r; Nat»,
     width groups shift chunks: Nat,
     xor: Bool];
/// A storage layout of a panel whose unpadded logical shape is `s`; carrying `s` as a singleton keeps it in the type.
pub anx nom Expr (r: Nat, s: «r; Nat») = Data (r, s);

/// The index algebra lets one layout interpreter serve affine indices and concrete I64 coordinates.
pub let IndexOps =
    [C: *,
     lit: Nat → C,
     add: [C, C] → C,
     mul: [C, Nat] → C,
     floordiv: [C, Nat] → C,
     remainder: [C, Nat] → C,
     xor: [C, C] → C];

pub let affine_index_ops: IndexOps =
    (affine.Index, affine.lit, affine.op.add, affine.semiop.mul, affine.semiop.floordiv, affine.semiop.rem,
     affine.op.xor);

pub let i64_index_ops: IndexOps =
    (I64,
     (λ (x: Nat): I64 = core.bitcast I64 x),
     core.wrap.add 0,
     (λ (x: I64, y: Nat): I64 = core.wrap.mul 0 (x, core.bitcast I64 y)),
     (λ (x: I64, y: Nat): I64 = core.bitcast I64 (core.bitcast Nat x / y)),
     (λ (x: I64, y: Nat): I64 = core.bitcast I64 (core.bitcast Nat x % y)),
     core.bit2.xor 0);

lam shape_impl {r: Nat}
    (split: Nat, perm: «r + 1; Idx (r + 1)», pad logical: «r; Nat»): «r; Nat» =
    let last = core.idx 0 r (r - 1);
    let pre = ‹p: r + 1; let pp = core.idx2nat p;
                core.select (pp == r, split,
                    core.select (pp + 1 == r, logical#last / split, logical#(core.idx 0 r pp)))›;
    let placed = ‹p: r + 1; pre#(perm#p)›;
    ‹p: r; let pp = core.idx2nat p;
           let base = core.select (pp == 0, placed#(core.idx 0 (r + 1) 0),
                          core.select (pp == 1, placed#(core.idx 0 (r + 1) 1) * placed#(core.idx 0 (r + 1) 2),
                                                 placed#(core.idx 0 (r + 1) (pp + 1))));
           base + pad#p›;

/// Split quotient and remainder, a checked permutation, and mixed-radix merging are jointly injective.
/// Padding changes only physical extents, so it preserves coordinates.
/// A swizzle acts on segments of `chunks · width` elements of the linear physical order, a segment's index being its row.
/// A checked block rotation is a bijection on a segment's complete set of chunks.
/// So is an exclusive or with a group below a power-of-two chunk count.
pub anx lam make {r: Nat}
    (logical: «r; Nat», split: Nat, perm: «r + 1; Idx (r + 1)», pad: «r; Nat»,
     width groups shift chunks: Nat, xor: Bool): Expr (r, logical) =
    let checked = refly.check (r >= 2, logical, "layout rank must be at least two");
    let split = refly.check (split > 0, split, "layout split must be nonzero");
    let split = refly.check (checked#(core.idx 0 r (r - 1)) % split == 0, split,
                             "layout split must divide the last logical extent");
    let perm = refly.check (vec.is_unique perm, perm, "layout permutation must contain every dimension once");
    let perm = refly.check (core.bit2.or 0 (split != 1, core.idx2nat (perm#(core.idx 0 (r + 1) 2)) == r), perm,
                            "an unsplit layout keeps its unit dimension at position 2");
    let enabled = groups != 1;
    let width = core.select (enabled, refly.check (width > 0, width, "layout swizzle width must be nonzero"), 1);
    let shift = core.select (enabled, refly.check (shift < 64, shift, "layout swizzle shift must be below 64"), 0);
    let chunks = core.select (enabled, refly.check (chunks > 0, chunks, "layout swizzle chunks must be nonzero"), 1);
    let groups = core.select (enabled, refly.check (groups > 0, groups, "layout swizzle groups must be nonzero"), 1);
    let groups = core.select (enabled,
        refly.check (groups <= chunks, groups, "layout swizzle groups must not exceed chunks"), 1);
    let physical = shape_impl (split, perm, pad, checked);
    let columns = vec.fold.r @(Nat, Idx r) @r
        (λ (p: Idx r, acc: Nat): Nat = acc * (1, physical#p)#(0 < core.idx2nat p)) (‹p: r; p›, 1);
    let chunks = refly.check (core.bit2.or 0 (core.bit2.xor 0 (enabled, tt), columns % (chunks * width) == 0), chunks,
                              "layout swizzle chunks times width must divide the physical row width");
    let xor = core.bit2.and 0 (enabled, xor);
    let power = core.icmp.e (core.bit2.and 0 (core.bitcast I64 chunks, core.bitcast I64 (chunks - 1)), 0I64);
    let chunks = refly.check (core.bit2.or 0 (core.bit2.xor 0 (xor, tt), power), chunks,
                              "an exclusive-or swizzle needs a power-of-two chunk count");
    ((‹logical›, split, perm, pad, width, groups, shift, chunks, xor) inj Data (r, logical)) inj Expr (r, logical);

pub anx lam shape {r: Nat} {s: «r; Nat»} (layout: Expr (r, s)): «r; Nat» =
    shape_impl ((#layout)#split, (#layout)#perm, (#layout)#pad, s);

lam interpret {r: Nat} {s: «r; Nat»} (ops: IndexOps, layout: Expr (r, s), x: «r; ops#C»): «r; ops#C» =
    let logical = s;
    let split = (#layout)#split;
    let perm = (#layout)#perm;
    let last = core.idx 0 r (r - 1);
    let pre_shape = ‹p: r + 1; let pp = core.idx2nat p;
                      core.select (pp == r, split,
                          core.select (pp + 1 == r, logical#last / split, logical#(core.idx 0 r pp)))›;
    let placed_shape = ‹p: r + 1; pre_shape#(perm#p)›;
    let pre = ‹p: r + 1; let pp = core.idx2nat p;
                core.select (pp == r, ops#remainder (x#last, split),
                    core.select (pp + 1 == r, ops#floordiv (x#last, split), x#(core.idx 0 r pp)))›;
    let split_coords = ‹p: r + 1; pre#(perm#p)›;
    let placed = ‹p: r; let pp = core.idx2nat p;
                    core.select (pp == 0, split_coords#(core.idx 0 (r + 1) 0),
                    core.select (pp == 1,
                        ops#add (ops#mul (split_coords#(core.idx 0 (r + 1) 1),
                                          placed_shape#(core.idx 0 (r + 1) 2)),
                                 split_coords#(core.idx 0 (r + 1) 2)),
                        split_coords#(core.idx 0 (r + 1) (pp + 1))))›;
    let physical = shape_impl (split, perm, (#layout)#pad, logical);
    let strides = ‹p: r; let pp = core.idx2nat p;
                     vec.fold.r @(Nat, Idx r) @r
                         (λ (q: Idx r, acc: Nat): Nat = acc * (1, physical#q)#(pp < core.idx2nat q))
                         (‹q: r; q›, 1)›;
    let col = vec.fold.r @(ops#C, Idx r) @r
        (λ (p: Idx r, acc: ops#C): ops#C =
            (acc, ops#add (ops#mul (placed#p, strides#p), acc))#(0 < core.idx2nat p))
        (‹p: r; p›, ops#lit 0);
    let row_step = vec.fold.r @(Nat, Nat) @(#layout)#shift core.nat.mul (‹_: (#layout)#shift; 2›, 1);
    let segment = (#layout)#chunks * (#layout)#width;
    let line = ops#add (ops#mul (placed#(core.idx 0 r 0), strides#(core.idx 0 r 0) / segment), ops#floordiv (col, segment));
    let inside = ops#remainder (col, segment);
    let group = ops#remainder (ops#floordiv (line, row_step), (#layout)#groups);
    let chunk = (ops#remainder (ops#add (ops#floordiv (inside, (#layout)#width), group), (#layout)#chunks),
                 ops#xor (ops#floordiv (inside, (#layout)#width), group))#((#layout)#xor);
    let swizzled = ops#add (ops#mul (ops#floordiv (col, segment), segment),
                            ops#add (ops#mul (chunk, (#layout)#width), ops#remainder (inside, (#layout)#width)));
    ‹p: r; let pp = core.idx2nat p;
           let rotated = ops#remainder (ops#floordiv (swizzled, strides#p), physical#p);
           (placed#p, rotated)#(core.bit2.and 0 ((#layout)#groups != 1, 0 < pp))›;

pub anx lam map_affine {r: Nat} {s: «r; Nat»} (layout: Expr (r, s)): «r; affine.Index» → «r; affine.Index» =
    λ (x: «r; affine.Index»): «r; affine.Index» = interpret @r @s (affine_index_ops, layout, x);
pub anx lam map_i64 {r: Nat} {s: «r; Nat»} (layout: Expr (r, s)): «r; I64» → «r; I64» =
    λ (x: «r; I64»): «r; I64» = interpret @r @s (i64_index_ops, layout, x);

/// #### F₂ interpretation
///
/// GPU layouts are mostly linear maps over the bits of their coordinates, so for power-of-two extents a layout's
/// injectivity and the contiguity of its vector fills are decidable by Gaussian elimination over F₂.
/// A coordinate over `n` input bits is a matrix: row `i` is output bit `i` as the exclusive or of the input bits its
/// low `n` mask bits select and of its constant in mask bit `n`.
/// Multiplying, dividing and taking the remainder by a power of two move or drop rows, and an addition is an exclusive
/// or while its operands share no bit; anything else leaves the class, which `linear` records.
/// Without padding a layout's addresses stay below `2^n`, so `n + 1` output bits hold them.
lam F2 (n: Nat): * = [Bool, «n + 1; I64»];
let powers = ‹k: 32; vec.fold.r @(Nat, Nat) @(core.idx2nat k) core.nat.mul (‹core.idx2nat k; 2›, 1)›;
lam any {m: Nat} (p: «m; Bool»): Bool = vec.fold.r @(Bool, Bool) @m (core.bit2.or 0) (p, ff);
lam total {m: Nat} (v: «m; Nat»): Nat = vec.fold.r @(Nat, Nat) @m core.nat.add (v, 0);
/// Taking an unnamed pair keeps field names off every `«2; Bool»`, which would otherwise capture `x#p` elsewhere.
lam both (pq: «2; Bool»): Bool = core.bit2.and 0 pq;
/// Whether `k` is a power of two, and its exponent.
lam log2 (k: Nat): [Bool, Nat] = (any ‹j: 32; powers#j == k›, total ‹j: 32; (0, core.idx2nat j)#(powers#j == k)›);
lam bit (j: Nat): I64 = core.wrap.shl 0 (1I64, core.bitcast I64 j);
lam nonzero (v: I64): Bool = (tt, ff)#(core.icmp.e (v, 0I64));
lam has (row: I64) (j: Nat): Bool = nonzero (core.bit2.and 0 (row, bit j));
lam at (n: Nat) (k: Nat): Idx (n + 1) = core.idx 0 (n + 1) (core.select (k < n + 1, k, 0));

lam f2_lit (n: Nat) (k: Nat): F2 n = (tt, ‹i: n + 1; (0I64, bit n)#((k / powers#(core.idx 0 32 (core.idx2nat i))) % 2 == 1)›);
lam f2_add (n: Nat) (x y: F2 n): F2 n =
    let (lx, rx) = x;
    let (ly, ry) = y;
    let shared   = any ‹i: n + 1; both (nonzero (rx#i), nonzero (ry#i))›;
    (both (both (lx, ly), (tt, ff)#shared), ‹i: n + 1; core.bit2.xor 0 (rx#i, ry#i)›);
lam f2_mul (n: Nat) (x: F2 n, k: Nat): F2 n =
    let (lx, rx) = x;
    let (pow, s) = log2 k;
    (both (lx, pow), ‹i: n + 1; let ii = core.idx2nat i; (0I64, rx#(at n (ii - s)))#(s <= ii)›);
lam f2_div (n: Nat) (x: F2 n, k: Nat): F2 n =
    let (lx, rx) = x;
    let (pow, s) = log2 k;
    (both (lx, pow), ‹i: n + 1; let ii = core.idx2nat i; (0I64, rx#(at n (ii + s)))#(ii + s < n + 1)›);
lam f2_rem (n: Nat) (x: F2 n, k: Nat): F2 n =
    let (lx, rx) = x;
    let (pow, s) = log2 k;
    (both (lx, pow), ‹i: n + 1; (0I64, rx#i)#(core.idx2nat i < s)›);
lam f2_xor (n: Nat) (x y: F2 n): F2 n =
    let (lx, rx) = x;
    let (ly, ry) = y;
    (both (lx, ly), ‹i: n + 1; core.bit2.xor 0 (rx#i, ry#i)›);
lam f2_ops (n: Nat): IndexOps = (F2 n, f2_lit n, f2_add n, f2_mul n, f2_div n, f2_rem n, f2_xor n);

/// Gaussian elimination's step for column `c`: an unused row with bit `c` becomes the pivot and clears it from the rest.
lam eliminate {b: Nat} (rows: «b; I64», used: «b; Bool», rank: Nat, c: Nat): [«b; I64», «b; Bool», Nat] =
    let candidates = ‹i: b; both (has (rows#i) c, (tt, ff)#(used#i))›;
    let found      = any candidates;
    let pivot      = vec.fold.r @(Nat, Idx b) @b
        (λ (i: Idx b, acc: Nat): Nat = (acc, core.idx2nat i)#(candidates#i)) (‹i: b; i›, 0);
    let row        = rows#(core.idx 0 b pivot);
    (‹i: b; (rows#i, core.bit2.xor 0 (rows#i, row))#(both (both (found, has (rows#i) c), core.idx2nat i != pivot))›,
     ‹i: b; core.bit2.or 0 (used#i, both (found, core.idx2nat i == pivot))›,
     rank + (0, 1)#found);
/// The rank of `rows` over their low `m` mask bits.
lam rank {b: Nat} (m: Nat, rows: «b; I64»): Nat =
    let (_, _, r) = vec.fold.l @([«b; I64», «b; Bool», Nat], Idx m) @m
        (λ (st: [«b; I64», «b; Bool», Nat], c: Idx m): [«b; I64», «b; Bool», Nat] =
            let (rows, used, r) = st;
            eliminate (rows, used, r, core.idx2nat c))
        ((rows, ‹b; ff›, 0), ‹c: m; c›);
    r;

/// The bits of each logical extent and where a coordinate's bits start among the inputs.
lam widths {r: Nat} (s: «r; Nat»): «r; Nat» = ‹d: r; (log2 (s#d))#1₂›;
lam offsets {r: Nat} (s: «r; Nat»): «r; Nat» =
    ‹d: r; total ‹e: r; (0, (widths s)#e)#(core.idx2nat e < core.idx2nat d)››;
/// The F₂ address of a layout's element: its physical coordinates merged row-major.
lam address {r: Nat} {s: «r; Nat»} (layout: Expr (r, s)): F2 (total (widths s)) =
    let n    = total (widths s);
    let x    = ‹d: r; ((log2 (s#d))#0₂,
                       ‹i: n + 1; (0I64, bit ((offsets s)#d + core.idx2nat i))#(core.idx2nat i < (widths s)#d)›)›;
    let phys = interpret @r @s (f2_ops n, layout, x);
    let ext  = shape layout;
    vec.fold.r @(F2 n, Idx r) @r
        (λ (p: Idx r, acc: F2 n): F2 n =
            let stride = vec.fold.r @(Nat, Idx r) @r
                (λ (q: Idx r, st: Nat): Nat = st * (1, ext#q)#(core.idx2nat p < core.idx2nat q)) (‹q: r; q›, 1);
            f2_add n (f2_mul n (phys#p, stride), acc))
        (‹p: r; p›, f2_lit n 0);

/// Whether a K-major wgmma panel of `rows × atom` elements of `bytes` each, `atom · bytes` being 128, lies as the 128-byte
/// swizzle its descriptor tells the hardware to read: CuTe's `Swizzle<3, 4, 3>` over byte offsets, which on element
/// `e = row · atom + col` exchanges 16-byte chunks as `e ⊕ ((e / atom) % 8) · (16 / bytes)`.
/// 0 if undecided, 1 if not, 2 if so.
pub anx lam matches_sw128 {s: «2; Nat»} (layout: Expr (2, s), bytes: Nat): Nat =
    let n     = total (widths s);
    let coord = λ (d: Idx 2): F2 n =
        (tt, ‹i: n + 1; (0I64, bit ((offsets s)#(d) + core.idx2nat i))#(core.idx2nat i < (widths s)#(d))›);
    let atom  = s#1₂;
    let e     = f2_add n (f2_mul n (coord 0₂, atom), coord 1₂);
    let want  = f2_xor n (e, f2_mul n (f2_rem n (f2_div n (e, atom), 8), 16 / bytes));
    let (lw, rw) = want;
    let (lh, rh) = address @2 @s layout;
    let differ   = any ‹i: n + 1; (tt, ff)#(core.icmp.e (rw#i, rh#i))›;
    core.select (both (both (lw, lh), atom * bytes == 128), (2, 1)#differ, 0);

/// Whether a layout maps distinct elements to distinct addresses: 0 if its extents leave the F₂ class, 1 if not, 2 if so.
pub anx lam injective {r: Nat} {s: «r; Nat»} (layout: Expr (r, s)): Nat =
    let n           = total (widths s);
    let (lin, rows) = address @r @s layout;
    let variable    = core.wrap.sub 0 (bit n, 1I64);
    core.select (lin, (1, 2)#(rank (n, ‹i: n + 1; core.bit2.and 0 (rows#i, variable)›) == n), 0);
/// Whether a fill's runs of `run` consecutive elements along the last logical dim land on `run` consecutive,
/// `run`-aligned addresses: the low address bits are exactly those coordinate bits, which no other address bit reads.
/// 0 if undecided, 1 if not, 2 if so.
pub anx lam contiguous {r: Nat} {s: «r; Nat»} (layout: Expr (r, s), run: Nat): Nat =
    let n           = total (widths s);
    let (lin, rows) = address @r @s layout;
    let (pow, t)    = log2 run;
    let base        = (offsets s)#(core.idx 0 r (r - 1));
    let window      = core.wrap.shl 0 (core.wrap.sub 0 (bit t, 1I64), core.bitcast I64 base);
    let wrong       = ‹i: n + 1; let ii = core.idx2nat i;
                          (nonzero (core.bit2.and 0 (rows#i, window)), (tt, ff)#(core.icmp.e (rows#i, bit (base + ii))))#(ii < t)›;
    core.select (both (lin, pow), (2, 1)#(any wrong), 0);
end

pub mod r8_plan
pub anx lam is_tree (n: Nat): Bool =
    core.bit2.and 0 (n != 0,
        core.icmp.e (core.bit2.and 0 (core.bitcast I64 n, core.bitcast I64 (n - 1)), 0I64));
pub anx lam rounds (n elems: Nat): «n / 2; [active: Bool, span pairs trip: Nat]» =
    ‹level: n / 2;
        let span = n / 2 - core.idx2nat level;
        let pairs = span * elems;
        (is_tree span, span, pairs, core.select (n < pairs, n, pairs))›;
pub anx lam pair_coords (pair elems span: Nat): [partial element partner: Nat] =
    (pair / elems, pair % elems, pair / elems + span);
end

pub mod pipeline_plan
pub anx lam depth (requested blocks: Nat): Nat = core.select (requested < blocks, requested, blocks);
pub anx lam ring_block (iteration slot blocks: Nat): Nat =
    (blocks - 1, iteration + slot)#(iteration + slot < blocks);
pub anx lam refill_block (iteration depth blocks: Nat): Nat = ring_block (iteration, depth - 1, blocks);
pub anx lam rotated_source (slot depth: Nat): Nat = (slot + 1) % depth;
///
/// A TMA ring's mbarrier protocol: fill `f` lands in slot `f % depth`, its consumer waits on that slot's full barrier for
/// the phase of parity `(f / depth) % 2`, and its producer waits on the slot's empty barrier for the phase of parity
/// `(f / depth + 1) % 2`; a fresh barrier's phase before its first counts as completed, so the first round passes.
/// `mbarrier.try_wait.parity p` returns once the phase of parity `p` completed, i.e. while the barrier's completed
/// phases `c` have `c % 2 != p`.
pub anx lam full_parity (fill: Nat) (depth: Nat): Nat = (fill / depth) % 2;
pub anx lam empty_parity (fill: Nat) (depth: Nat): Nat = (fill / depth + 1) % 2;
/// How many of the first `upto` fills land in slot `s`.
lam landed (upto: Nat) (depth: Nat) (s: Nat): Nat = core.select (s < upto, (upto - s - 1) / depth + 1, 0);
lam passes (completed: Nat) (parity: Nat): Bool = completed % 2 != parity;
lam every {m: Nat} (p: «m; Bool»): Bool = vec.fold.r @(Bool, Bool) @m (core.bit2.and 0) (p, tt);
lam some {m: Nat} (p: «m; Bool»): Bool = vec.fold.r @(Bool, Bool) @m (core.bit2.or 0) (p, ff);
lam implies (p: Bool) (q: Bool): Bool = core.bit2.or 0 ((tt, ff)#(p), q);
/// Checks the protocol for `fills` fills of a ring of `depth` slots whose consumer releases a slot `lag` steps after
/// reading it, with the producer's parity offset by `offset` (1 in `empty_parity`), over every state of `p` fills and
/// `c` consumptions: a wait that passes never lets the producer overwrite an unconsumed slot or the consumer read an
/// unfilled one, and some side can always go on until both are done.
pub anx lam ring_safe (fills: Nat) (depth: Nat) (lag: Nat) (offset: Nat): Bool =
    every ‹pi: fills + 1; every ‹ci: fills + 1;
        let p = core.idx2nat pi;
        let c = core.idx2nat ci;
        let released = core.select (lag < c, c - lag, 0);
        let empty    = landed released depth (p % depth);
        let produce  = core.bit2.and 0 (p < fills, passes empty ((p / depth + offset) % 2));
        let consume  = core.bit2.and 0 (c < fills, passes (landed p depth (c % depth)) (full_parity c depth));
        let state    = core.bit2.and 0 (c <= p, p <= c + depth);
        implies state (every (implies produce (landed p depth (p % depth) == empty),
                              implies consume (c < p),
                              implies (core.bit2.or 0 (p < fills, c < fills)) (some (produce, consume))))››;
end

/// ### mma_m16n8k8_tf32
///
/// Fragment coordinates follow the `mma.sync.m16n8k8` fragment tables in the PTX ISA.
pub mod mma_m16n8k8_tf32
pub anx lam l_a (lane: Idx 32, reg: Idx 4): [Idx 16, Idx 8] =
    let l = core.idx2nat lane;
    let j = core.idx2nat reg;
    (core.idx 0 16 (l / 4 + 8 * (j % 2)), core.idx 0 8 (l % 4 + 4 * (j / 2)));

pub anx lam l_b (lane: Idx 32, reg: Idx 2): [Idx 8, Idx 8] =
    let l = core.idx2nat lane;
    let j = core.idx2nat reg;
    (core.idx 0 8 (l % 4 + 4 * j), core.idx 0 8 (l / 4));

pub anx lam l_c (lane: Idx 32, reg: Idx 4): [Idx 16, Idx 8] =
    let l = core.idx2nat lane;
    let j = core.idx2nat reg;
    (core.idx 0 16 (l / 4 + 8 * (j / 2)), core.idx 0 8 (2 * (l % 4) + j % 2));

/// Lane `l` supplies row address `l % 8` of matrix `l / 8` for an x4 load.
pub anx lam addr_ld (lane: Idx 32): [Idx 4, Idx 8] =
    let l = core.idx2nat lane;
    (core.idx 0 4 (l / 8), core.idx 0 8 (l % 8));

/// Register `j` in lane `l` receives matrix `j` element `(l / 4, l % 4)`.
pub anx lam transfer_ld (lane: Idx 32, reg: Idx 4): [Idx 4, Idx 8, Idx 4] =
    let l = core.idx2nat lane;
    (reg, core.idx 0 8 (l / 4), core.idx 0 4 (l % 4));

/// The row-major A panel uses lane `l` for row `l % 16` at k offset `4 * (l / 16)`.
pub anx lam panel_a_addr (lane: Idx 32): [Idx 16, Idx 8] =
    let l = core.idx2nat lane;
    (core.idx 0 16 (l % 16), core.idx 0 8 (4 * (l / 16)));

pub anx lam ld_a (lane: Idx 32, reg: Idx 4): [Idx 16, Idx 8] =
    let (matrix, matrix_row, matrix_col) = transfer_ld (lane, reg);
    let provider = core.idx 0 32 (8 * core.idx2nat matrix + core.idx2nat matrix_row);
    let (row, col) = panel_a_addr provider;
    (row, core.idx 0 8 (core.idx2nat col + core.idx2nat matrix_col));

lam a_at (a: «32; «4; math.F32»», row: Idx 16, col: Idx 8): math.F32 =
    let r = core.idx2nat row;
    let k = core.idx2nat col;
    a#(core.idx 0 32 (4 * (r % 8) + k % 4))#(core.idx 0 4 (2 * (k / 4) + r / 8));

lam b_at (b: «32; «2; math.F32»», row col: Idx 8): math.F32 =
    let k = core.idx2nat row;
    let n = core.idx2nat col;
    b#(core.idx 0 32 (4 * n + k % 4))#(core.idx 0 2 (k / 4));

pub anx lam mma_ref
    (a: «32; «4; math.F32»», b: «32; «2; math.F32»», c: «32; «4; math.F32»»)
    : «32; «4; math.F32»» =
    ‹lane: 32; ‹reg: 4;
        let (row, col) = l_c (lane, reg);
        vec.fold.r @(math.F32, Idx 8) @8
            (λ (k: Idx 8, acc: math.F32): math.F32 =
                math.arith.add 0 (acc, math.arith.mul 0 (a_at (a, row, k), b_at (b, k, col))))
            (‹k: 8; k›, c#lane#reg)››;
end
///
/// ### mma_m16n8k16
///
/// Fragment coordinates of `mma.sync.m16n8k16` with 16-bit inputs, a register holding the pair `h` of halves; C's are `mma_m16n8k8_tf32.l_c`.
/// A warpgroup MMA (`gpu.wgmma_*`) gives warp `w` rows `16 w .. 16 w + 15` in the same layouts.
pub mod mma_m16n8k16
pub anx lam l_a (lane: Idx 32, reg: Idx 4, h: Idx 2): [Idx 16, Idx 16] =
    let l = core.idx2nat lane;
    let r = core.idx2nat reg;
    (core.idx 0 16 (l / 4 + 8 * (r % 2)), core.idx 0 16 (2 * (l % 4) + core.idx2nat h + 8 * (r / 2)));

pub anx lam l_b (lane: Idx 32, reg: Idx 2, h: Idx 2): [Idx 16, Idx 8] =
    let l = core.idx2nat lane;
    (core.idx 0 16 (2 * (l % 4) + core.idx2nat h + 8 * core.idx2nat reg), core.idx 0 8 (l / 4));

/// The row-major A panel uses lane `l` for row `l % 16` at k offset `8 * (l / 16)`; `ldmatrix_b16 4` then yields `l_a`.
pub anx lam panel_a_addr (lane: Idx 32): [Idx 16, Idx 16] =
    let l = core.idx2nat lane;
    (core.idx 0 16 (l % 16), core.idx 0 16 (8 * (l / 16)));

lam a_at {T: *} (a: «32; «4, 2; T»», row col: Idx 16): T =
    let r = core.idx2nat row;
    let k = core.idx2nat col;
    a#(core.idx 0 32 (4 * (r % 8) + k % 8 / 2))#(core.idx 0 4 (r / 8 + 2 * (k / 8)))#(core.idx 0 2 (k % 2));

lam b_at {T: *} (b: «32; «2, 2; T»», row: Idx 16, col: Idx 8): T =
    let k = core.idx2nat row;
    b#(core.idx 0 32 (4 * core.idx2nat col + k % 8 / 2))#(core.idx 0 2 (k / 8))#(core.idx 0 2 (k % 2));

/// `c + a·b` with the inputs widened by `up`.
pub anx lam mma_ref {T: *} (up: T → math.F32)
    (a: «32; «4, 2; T»», b: «32; «2, 2; T»», c: «32; «4; math.F32»»)
    : «32; «4; math.F32»» =
    ‹lane: 32; ‹reg: 4;
        let (row, col) = mma_m16n8k8_tf32.l_c (lane, reg);
        vec.fold.r @(math.F32, Idx 16) @16
            (λ (k: Idx 16, acc: math.F32): math.F32 =
                math.arith.add 0 (acc, math.arith.mul 0 (up (a_at (a, row, k)), up (b_at (b, k, col)))))
            (‹k: 16; k›, c#lane#reg)››;

/// Two C tiles side by side, narrowed by `down`, as one A fragment: register `reg` is C tile `reg / 2`, registers `2 (reg % 2) + h`.
pub anx lam a_of_c2 {T: *} (down: math.F32 → T) (c: «32, 2, 4; math.F32»): «32; «4, 2; T»» =
    ‹lane: 32; ‹reg: 4; ‹h: 2;
        down c#lane#(core.idx 0 2 (core.idx2nat reg / 2))#(core.idx 0 4 (2 * (core.idx2nat reg % 2) + core.idx2nat h))›››;

/// Whether `a_of_c2` places at A position `(row, k)` the element `(row, k)` of the two C tiles: no key permutation is needed.
pub anx let c_pair_is_a: Bool =
    vec.scan.for_all @(Idx 256) @256
        (λ (x: Idx 256): Bool =
            let lane = core.idx 0 32 (core.idx2nat x / 8);
            let reg  = core.idx 0 4 (core.idx2nat x / 2 % 4);
            let h    = core.idx 0 2 (core.idx2nat x % 2);
            let (a_row, a_col) = l_a (lane, reg, h);
            let (c_row, c_col) = mma_m16n8k8_tf32.l_c (lane, core.idx 0 4 (2 * (core.idx2nat reg % 2) + core.idx2nat h));
            core.bit2.and 0 (core.idx2nat a_row == core.idx2nat c_row,
                             core.idx2nat a_col == 8 * (core.idx2nat reg / 2) + core.idx2nat c_col))
        ‹x: 256; x›;

/// Whether `l_a` and `l_b` place every element of their tiles exactly once.
pub anx let layouts_cover: Bool =
    core.bit2.and 0 (
        vec.is_unique ‹x: 256;
            let (r, k) = l_a (core.idx 0 32 (core.idx2nat x / 8), core.idx 0 4 (core.idx2nat x / 2 % 4), core.idx 0 2 (core.idx2nat x % 2));
            16 * core.idx2nat r + core.idx2nat k›,
        vec.is_unique ‹x: 128;
            let (k, n) = l_b (core.idx 0 32 (core.idx2nat x / 4), core.idx 0 2 (core.idx2nat x / 2 % 2), core.idx 0 2 (core.idx2nat x % 2));
            8 * core.idx2nat k + core.idx2nat n›);
end
///
/// ### warp_keep
///
/// The identity on a warp value, marking it shared: a lane reading another's component shuffles what that lane computed
/// instead of recomputing it from the definition.
/// It vanishes unless the `gpu` plugin is loaded; then `tensor.distribute` resolves its reads.
///
axm warp_keep: {T: *} → «32; T» → «32; T», normalize_warp_keep;
///
/// ### mma_warp
///
/// A warp's tensor-core product `mma_m16n8k8_tf32.mma_ref (a, b, c)` on warp values.
/// It is `mma_ref` unless the `gpu` plugin is loaded; then `tensor.distribute` lowers it to each lane's `gpu.mma_tf32`.
///
axm mma_warp: [a: «32, 4; math.F32», b: «32, 2; math.F32», c: «32, 4; math.F32»] → «32, 4; math.F32», normalize_mma_warp;
///
/// ### wgmma_lane
///
/// One lane's accumulator `c` plus its warp's 16 rows of `A · B` on a warpgroup's tensor cores, over `nk` chunks of 16 keys.
/// `a#kc` is the lane's A fragment of chunk `kc` in the layout of `mma_m16n8k16.l_a`; `b` is a work-group panel of 16-bit
/// `T` whose element `at#kc` is B's `(16 kc, 0)`, read K-major or MN-major as its storage layout holds it.
/// Per warp it is `mma_m16n8k16.mma_ref` on the warp's rows; LowerToMem lowers it to `gpu.wgmma_rs_*` in a
/// warpgroup-owned region (`bind 7`).
///
axm wgmma_lane: {T: *} → {nk nt r: Nat} → {s: «r; Nat»}
              → [a: «nk, 4, 2; T», b: Tensor r s T, at: «nk; «i: r; Idx s#i»», c: «nt, 4; math.F32»]
              → «nt, 4; math.F32»;
///
/// ### warp
///
/// A warp's value is an array over its 32 lanes, lane `l` holding component `l`; see `docs/warp-schedule.zh-CN.md`.
/// The functions here are the specifications: they evaluate on any target, and `gpu` keeps only each lane's component.
/// `C nt T` holds a `16 × nt·8` tile in the accumulator layout of `mma.m16n8k8`, tile `j` in registers `j`.
/// `R T` holds a row vector of that tile, lane `l` keeping rows `l / 4` and `l / 4 + 8`.
/// A warp owns one 16-row block; several are arrays of these.
pub mod warp
pub anx lam C (nt: Nat) (T: *): * = «32, nt, 4; T»;
pub anx lam R (T: *): * = «32, 2; T»;

pub anx lam c_pos {nt: Nat} (lane: Idx 32, j: Idx nt, reg: Idx 4): [Idx 16, Idx (8 * nt)] =
    let (r, c) = mma_m16n8k8_tf32.l_c (lane, reg);
    (r, core.idx 0 (8 * nt) (8 * core.idx2nat j + core.idx2nat c));

pub anx lam r_pos (lane: Idx 32, h: Idx 2): Idx 16 = core.idx 0 16 (core.idx2nat lane / 4 + 8 * core.idx2nat h);

/// Distributes a tile over the warp.
pub anx lam c_of {nt: Nat} {T: *} (t: «16, 8 * nt; T»): C nt T =
    ‹lane: 32; ‹j: nt; ‹reg: 4; let (r, c) = c_pos (lane, j, reg); t#r#c›››;

/// Gathers a distributed tile; `c_tile (c_of t) = t` since `c_pos` is a bijection.
pub anx lam c_tile {nt: Nat} {T: *} (f: C nt T): «16, 8 * nt; T» =
    ‹r: 16; ‹c: 8 * nt;
        let row = core.idx2nat r;
        let col = core.idx2nat c % 8;
        f#(core.idx 0 32 (4 * (row % 8) + col / 2))#(core.idx 0 nt (core.idx2nat c / 8))#(core.idx 0 4 (2 * (row / 8) + col % 2))››;

pub anx lam r_of {T: *} (v: «16; T»): R T = ‹lane: 32; ‹h: 2; v#(r_pos (lane, h))››;

pub anx lam r_vec {T: *} (v: R T): «16; T» =
    ‹r: 16; let row = core.idx2nat r; v#(core.idx 0 32 (4 * (row % 8)))#(core.idx 0 2 (row / 8))›;

pub anx lam c_map {nt: Nat} {T U: *} (g: T → U) (f: C nt T): C nt U = ‹lane: 32; ‹j: nt; ‹reg: 4; g (f#lane#j#reg)›››;

pub anx lam c_zip {nt: Nat} {T U V: *} (g: [T, U] → V) (x: C nt T, y: C nt U): C nt V =
    ‹lane: 32; ‹j: nt; ‹reg: 4; g (x#lane#j#reg, y#lane#j#reg)›››;

/// Broadcasts each lane's rows over their columns: register `reg` lies in row half `reg / 2`.
pub anx lam c_rows {nt: Nat} {T: *} (v: R T): C nt T =
    ‹lane: 32; ‹j: nt; ‹reg: 4; v#lane#(core.idx 0 2 (core.idx2nat reg / 2))›››;

/// The specification of a row reduction: `op` folded over each row of the gathered tile from `init`.
pub anx lam row_fold_spec {nt: Nat} {T: *} (op: [T, T] → T, init: T) (f: C nt T): «16; T» =
    let t = c_tile f;
    ‹r: 16; vec.fold.l @(T, T) @(8 * nt) op (init, t#r)›;

/// The partial row reduction of each lane over its own columns; `quad_merge` completes it.
pub anx lam row_own {nt: Nat} {T: *} (op: [T, T] → T, init: T) (f: C nt T): R T =
    ‹lane: 32; ‹h: 2;
        vec.fold.l @(T, T) @(2 * nt) op
            (init, ‹k: 2 * nt; f#lane#(core.idx 0 nt (core.idx2nat k / 2))#(core.idx 0 4 (2 * core.idx2nat h + core.idx2nat k % 2))›)››;

/// Merges each quad's partials across lanes `l xor 1` and `l xor 2`, which shuffle the partials computed.
pub anx lam quad_merge {T: *} (op: [T, T] → T) (x: R T): R T =
    let x    = warp_keep x;
    let pair = warp_keep ‹lane: 32; ‹h: 2; op (x#lane#h, x#(core.bit2.xor 0 (lane, core.idx 0 32 1))#h)››;
    ‹lane: 32; ‹h: 2; op (pair#lane#h, pair#(core.bit2.xor 0 (lane, core.idx 0 32 2))#h)››;

/// A row reduction: for an associative and commutative `op` with identity `init` it equals
/// `r_of (row_fold_spec op init f)`, since the four lanes of a quad hold the row's columns exactly once (`quad_covers_rows`).
pub anx lam row_fold {nt: Nat} {T: *} (op: [T, T] → T, init: T) (f: C nt T): R T = quad_merge op (row_own @nt (op, init) f);

/// Whether the four lanes `l xor m` of a quad hold row `r_pos (l, h)` at registers of half `h`, each column once.
pub anx lam quad_covers_rows (nt: Nat): Bool =
    vec.scan.for_all @(Idx 64) @64
        (λ (x: Idx 64): Bool =
            let lane = core.idx 0 32 (core.idx2nat x / 2);
            let h    = core.idx 0 2 (core.idx2nat x % 2);
            let at   = ‹k: 8 * nt;
                let m   = core.idx 0 32 (core.idx2nat k / (2 * nt));
                let j   = core.idx 0 nt (core.idx2nat k / 2 % nt);
                let reg = core.idx 0 4 (2 * core.idx2nat h + core.idx2nat k % 2);
                c_pos @nt (core.bit2.xor 0 (lane, m), j, reg)›;
            core.bit2.and 0 (
                vec.scan.for_all @([Idx 16, Idx (8 * nt)]) @(8 * nt)
                    (λ (p: [Idx 16, Idx (8 * nt)]): Bool = core.idx2nat p#0_2 == core.idx2nat (r_pos (lane, h)))
                    at,
                vec.is_unique ‹k: 8 * nt; core.idx2nat (at#k#1_2)›))
        ‹x: 64; x›;

/// The keys a C fragment's columns become as an A fragment: A column `k` holds C column `2 k` for `k < 4`, else `2 k - 7`.
pub anx lam key_perm (k: Idx 8): Idx 8 =
    let n = core.idx2nat k;
    core.idx 0 8 ((2 * n, 2 * (n - 4) + 1)#(4 <= n));

/// Reads C tile `j` as an A fragment over the permuted keys: registers `(c0, c2, c1, c3)`.
pub anx lam a_of_c {nt: Nat} {T: *} (f: C nt T): «32, nt, 4; T» =
    ‹lane: 32; ‹j: nt; ‹reg: 4; f#lane#j#(core.idx 0 4 (2 * (core.idx2nat reg % 2) + core.idx2nat reg / 2))›››;

/// A C fragment, a row vector, and the A and B fragments of `nk` k-chunks (`a16_gen`: of 16 keys, in pairs), from their
/// elements at each position.
pub anx lam c_gen {nt: Nat} {T: *} (g: [Idx 32, Idx nt, Idx 4] → T): C nt T = ‹lane: 32; ‹j: nt; ‹reg: 4; g (lane, j, reg)›››;
pub anx lam r_gen {T: *} (g: [Idx 32, Idx 2] → T): R T = ‹lane: 32; ‹h: 2; g (lane, h)››;
pub anx lam a_gen {nk: Nat} {T: *} (g: [Idx nk, Idx 32, Idx 4] → T): «nk, 32, 4; T» =
    ‹kc: nk; ‹lane: 32; ‹reg: 4; g (kc, lane, reg)›››;
pub anx lam a16_gen {nk: Nat} {T: *} (g: [Idx nk, Idx 32, Idx 4, Idx 2] → T): «nk, 32, 4, 2; T» =
    ‹kc: nk; ‹lane: 32; ‹reg: 4; ‹h: 2; g (kc, lane, reg, h)››››;
pub anx lam b_gen {nk nt: Nat} {T: *} (g: [Idx nk, Idx nt, Idx 32, Idx 2] → T): «nk, nt, 32, 2; T» =
    ‹kc: nk; ‹j: nt; ‹lane: 32; ‹reg: 2; g (kc, j, lane, reg)››››;

/// The `(row, k)` of A register `reg` in lane `lane` of chunk `kc`, and the `(k, col)` of B register `reg` of chunk `kc`
/// and column tile `j`; `permuted` reads B's keys in the order an A from `a_from_c` holds them.
pub anx lam a_pos {nk: Nat} (kc: Idx nk, lane: Idx 32, reg: Idx 4): [Idx 16, Idx (8 * nk)] =
    let (r, k) = mma_m16n8k8_tf32.l_a (lane, reg);
    (r, core.idx 0 (8 * nk) (8 * core.idx2nat kc + core.idx2nat k));
pub anx lam b_pos {nk nt: Nat} (permuted: Bool) (kc: Idx nk, j: Idx nt, lane: Idx 32, reg: Idx 2): [Idx (8 * nk), Idx (8 * nt)] =
    let (k, n) = mma_m16n8k8_tf32.l_b (lane, reg);
    let k      = (k, key_perm k)#permuted;
    (core.idx 0 (8 * nk) (8 * core.idx2nat kc + core.idx2nat k), core.idx 0 (8 * nt) (8 * core.idx2nat j + core.idx2nat n));

/// A C tile of keys read as the A fragments of as many k-chunks, keys permuted (`b_pos` with `permuted`).
pub anx lam a_from_c {nk: Nat} (p: C nk math.F32): «nk, 32, 4; math.F32» = ‹kc: nk; ‹lane: 32; (a_of_c @nk p)#lane#kc››;

/// `c + a·b` on `nt` column tiles accumulated over `nk` k-chunks.
pub anx lam c_mma {nk nt: Nat} (a: «nk, 32, 4; math.F32», b: «nk, nt, 32, 2; math.F32», c: C nt math.F32): C nt math.F32 =
    let tiles = ‹j: nt;
        vec.fold.l @(«32, 4; math.F32», Idx nk) @nk
            (λ (acc: «32, 4; math.F32», kc: Idx nk): «32, 4; math.F32» = mma_warp (‹lane: 32; a#kc#lane›, ‹lane: 32; b#kc#j#lane›, acc))
            (‹lane: 32; c#lane#j›, ‹kc: nk; kc›)›;
    ‹lane: 32; ‹j: nt; tiles#j#lane››;

/// Whether `a_of_c` places at A position `(row, k)` the C element `(row, key_perm k)` of the same 16 × 8 tile.
pub anx let c_to_a_permutes: Bool =
    vec.scan.for_all @(Idx 128) @128
        (λ (x: Idx 128): Bool =
            let lane = core.idx 0 32 (core.idx2nat x / 4);
            let reg  = core.idx 0 4 (core.idx2nat x % 4);
            let (a_row, a_col) = mma_m16n8k8_tf32.l_a (lane, reg);
            let (c_row, c_col) = mma_m16n8k8_tf32.l_c (lane, core.idx 0 4 (2 * (core.idx2nat reg % 2) + core.idx2nat reg / 2));
            core.bit2.and 0 (core.idx2nat a_row == core.idx2nat c_row,
                             core.idx2nat (key_perm (core.idx 0 8 (core.idx2nat a_col))) == core.idx2nat c_col))
        ‹x: 128; x›;
end
///
/// ### from_array
///
/// Constructs a tensor from an array; bufferization accepts only static shapes and literal elements here.
/// Uniform literals use `buffer.lit`; other literals use `buffer.init`.
/// Use `from_array @(r, s, T) a` when array folding hides the intended singleton axes or rank.
/// External data enters through Tensor-typed parameters.
axm from_array: {r: Nat, s: «r; Nat», T: *} → [a: «s; T»] → Tensor r s T;
///
/// ### Element access and rank-0 conversion
///
/// `get` and `set` take one coordinate per logical axis, with type `Idx (s#j)` on axis `j`.
/// This index contract does not insert runtime bounds checks.
/// `scalar` constructs a rank-0 tensor; `item` extracts its element.
/// These boundary operations remain axioms when they cannot fold, so early inlining cannot expose the private array representation.
axm get: {r: Nat, s: «r; Nat», T: *}
       → [t: Tensor r s T, i: «j: r; Idx (s#j)»] → T, normalize_get;
/// `get_fused` is the read of a `tensor.stage` fill: it evaluates a pointwise `map_reduce_post` at the coordinate,
/// reading its inputs where their maps send it, and reads through a `slice`, so a staged producer is computed in the
/// fill instead of realized.
axm get_fused: {r: Nat, s: «r; Nat», T: *}
             → [t: Tensor r s T, i: «j: r; Idx (s#j)»] → T, normalize_get_fused;
axm set: {r: Nat, s: «r; Nat», T: *}
       → [t: Tensor r s T, i: «j: r; Idx (s#j)», v: T] → Tensor r s T, normalize_set;
axm scalar: {T: *} → T → Tensor 0 () T, normalize_scalar;
axm item: {T: *} → Tensor 0 () T → T, normalize_item;
///
/// ### as_vectors
///
/// Views the last axis in runs of `n` elements as one `«n; T»` element each; `c` is `s` with its last extent
/// divided by `n`, which must divide it.
/// A `get` on the view reads one aligned vector (see `buffer.vectorize`).
axm as_vectors: {r: Nat, s: «r; Nat», T: *} → [n: Nat, c: «r; Nat»] → Tensor r s T → Tensor r c «n; T»;

priv anx lam get_vector {r: Nat, s: «r; Nat», T: *} (n: Nat)
    (t: Tensor r s T, i: «d: r; Idx (s#d)»): «n; T» =
    let runs = ‹d: r; (s#d, s#d / n)#(core.idx2nat d + 1 == r)›;
    let indices = ‹d: r;
        let coord = core.idx2nat (i#d);
        (core.bitcast (Idx (runs#d)) (i#d), core.idx 0 (runs#d) (coord / n))#(core.idx2nat d + 1 == r)›;
    get @(r, runs, «n; T») (as_vectors @(r, s, T) (n, runs) t, indices);
///
/// ## Constructors
///
/// Build a tensor from nothing but its shape.
///
/// ### generate
///
/// Constructs a tensor by evaluating `body` once for every logical output coordinate.
/// Coordinates use `I64` so the body can do ordinary scalar arithmetic before converting them to bounded tensor indices.
///
/// ```python
/// output = empty(s_out)
/// for index in ndindex(s_out):
///     output[index] = body(index)
/// return output
/// ```
///
axm generate: {T: *, r: Nat}
            → [s_out: «r; Nat»]
            → [body: [«r; I64»] → T]
            → Tensor r s_out T;
///
/// ### splat
///
/// Constructs a tensor whose every element is `value`.
/// Keeping this explicit lets bufferization pick a fill operation instead of first building an index
/// lambda or a monolithic nested-array literal.
///
/// ```python
/// output = empty(s_out)
/// for index in ndindex(s_out):
///     output[index] = value
/// return output
/// ```
axm splat: {T: *, r: Nat}
         → [s_out: «r; Nat», value: T]
         → Tensor r s_out T;
///
/// ## Accessors
///
pub lam shape {r: Nat, s: «r; Nat», T: *} (t: Tensor r s T): «r; Nat» = s;
///
/// ## Map-Reduce
///
/// The loop-nest core every other operation is lowered onto: `lower_tensor` re-applies the matching
/// annex from Implementations, while `broadcast`, `concat`, `gather`, `generate`, `pad` and `scatter` are
/// expanded by `lower_map_reduce` directly.
///
/// ### id
///
/// The CPS identity (with an empty epilogue-input pack) — the neutral `post` epilogue.
anx fun id {T: *} (x: T, _: [])@tt: T = return x;
///
/// ### map_reduce_post
///
/// The workhorse behind every tensor operation: a reduction fold over an affinely-indexed loop nest.
/// The loop vector `(o…, r…)` has length `Rn`; its leading `Ro` dims are the parallel output loops,
/// the trailing ones the reduction loops that are folded away.
///
/// - `Sr`, `So`: the full loop bounds and the result shape (rank `Ro`).
///   `So` may differ from the leading `Ro` bounds of `Sr` — that is what lets `map_out` write to a
///   re-shaped output, e.g. a transpose.
/// - `f`: folds one element of each input into the accumulator, seeded per output cell with `init`.
/// - `post`: maps the folded accumulator, plus one element of each of the `nps` *epilogue inputs*
///   `post_is`, to the stored element.
///   It runs once per output cell, between fold and write-back — the slot `fuse_tensor` composes
///   trailing elementwise maps into (bias + activation after a convolution or matrix product).
/// - `map_out`: full loop vector ↦ the `Ro` write coordinates in `«So»`.
///   The reduction is folded away before the write, so it may only depend on the leading `Ro` indices.
/// - `maps#i`: full loop vector ↦ the `Ris#i` read coordinates of input `i`.
///   Transposes, slices and broadcasts are expressed here.
/// - `post_maps#j`: the `Ro` *output-cell* coordinates (the write coordinates `map_out` produces) ↦
///   the read coordinates of epilogue input `j`; epilogue inputs are read once per output cell, not
///   per loop iteration.
/// - `sched`: the op's **schedule**, selected in the frontend via the `Tileable` machinery below and
///   carried as an ordinary operand through fusion — a target-agnostic chooser (canonically a
///   `mk_sched` value) that, handed the target's loop-nest builder, returns the nest to run.
///   The lowering only binds it and **applies** the result to the op's decision-free fold step and
///   write-back, so unrolling, interchange and vectorization are plain IR, not lowering behavior.
///
/// The total loop count `Rn` is stated instead of the reduction count `Rr = Rn - Ro`: a
/// `core.nat.add (Ro, Rr)` in the domain cannot be inverted by type inference and every call site
/// would have to pass the whole meta group explicitly with `@`, whereas `Sr` pins `Rn` structurally.
///
/// `nis`, `nps`, `Ro`, `Rn`, `Ris` and `Rps` must be literals before the `tensor::Lower` phase; the
/// bounds `So` and `Sr` may stay symbolic.
///
axm map_reduce_post: {nis nps: Nat}
                   → {To Tp: *, Ro Rn: Nat, TSched: □}
                   → [So: «Ro; Nat», Sr: «Rn; Nat», sched: TSched]
                   → {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»,
                      Tps: «nps; *», Rps: «j: nps; Nat», Sps: «j: nps; «Rps#j; Nat»»}
                   → {Init: *}
                   → [f: Fn [To, «i: nis; Tis#i»] → To, init: Init, post: Fn [To, «j: nps; Tps#j»] → Tp]
                   → [map_out: «Rn; affine.Index» → «Ro; affine.Index»]
                   → [     maps: «i: nis; «Rn; affine.Index» → «Ris#i; affine.Index»»,
                      post_maps: «j: nps; «Ro; affine.Index» → «Rps#j; affine.Index»»]
                   → [is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)», post_is: «j: nps; Tensor (Rps#j) (Sps#j) (Tps#j)»]
                   → Tensor Ro So Tp;
///
/// ### Sched, SchedT, mk_sched
///
/// The schedule record (`vdim`, `unroll`), the type of a schedule **chooser** over the target's loop-nest
/// builder, and the canonical chooser.
/// Aliases for the `btensor` definitions, which `btensor` owns for the same reason it owns `btensor.Ring`.
anx Sched    = btensor.Sched;
anx SchedT   = btensor.SchedT;
anx mk_sched = btensor.mk_sched;
///
/// ### map_reduce
///
/// `map_reduce_post` without the epilogue and with the neutral schedule: delegates with `post = id`
/// (so `Tp = To`), no epilogue inputs (`nps = 0`), no vector dim (`vdim = Rn`, the out-of-range
/// sentinel), and no unrolling.
/// `Rn` is stated instead of `Rr` for the same reason as there.
anx lam map_reduce {nis: Nat} {To: *, Ro Rn: Nat}
                   (So: «Ro; Nat», Sr: «Rn; Nat»)
                   {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                   (f: Fn [To, «i: nis; Tis#i»] → To, init: To)
                   (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
                   (maps: «i: nis; («Rn; affine.Index» → «Ris#i; affine.Index»)»)
                   (is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)»): Tensor Ro So To =
    map_reduce_post @(nis, 0)
        @(To, To, Ro, Rn, SchedT)
        (So, Sr, mk_sched (Rn, 0))
        @(Tis, Ris, Sis, (), (), ())
        (f, init, id @To) map_out (maps, ()) (is, ());
///
/// ### proj_map
///
/// `subs ↦ λ o. ‹j; o#(subs#j)›`: the access map that reads input axis `j` at loop variable `subs#j`,
/// e.g. `((0, 2), (2, 1))` for the two inputs of a matrix product.
/// An alias for `btensor.proj_map`, which `btensor` owns for the same reason it owns `btensor.Ring`.
anx proj_map = btensor.proj_map;
///
/// ## Shape Operations
///
/// Pure re-indexing: every element of the result is one element of an input, so the operation lives
/// entirely in the access map.
///
/// ### broadcast
///
/// Expands the dimensions of `input` to fit `s_out`:
/// for all `i`, either `s_in#i = s_out#i` or `s_in#i = 1`, and the size-1 dimensions are expanded to fit `s_out`.
///
/// Lowered directly to packs by the `LowerMapReduce` phase (`lower_broadcast`): a size-1 axis broadcast to `n`
/// becomes a `‹n; …›` pack instead of a copy loop.
axm broadcast: {T: *, r: Nat}
             → [s_in s_out: «r; Nat», input: Tensor r s_in T]
             → Tensor r s_out T, normalize_broadcast;
///
/// ### broadcast_in_dim
///
/// Transposes and expands the dimensions of `input` to fit `s_out`.
/// Each input dimension is mapped to the output dimension given by `index`; the holes are filled by broadcasting.
///
/// @todo We could probably implement this in terms of `broadcast` and `transpose` directly.
///
axm broadcast_in_dim: {T: *, r_in r_out: Nat}
                    → [s_in: «r_in; Nat», s_out: «r_out; Nat», input: Tensor r_in s_in T, index: «r_in; Idx r_out»]
                    → Tensor r_out s_out T, normalize_broadcast_in_dim;
///
/// ### concat_acc
///
/// Accumulator for the axis-sum: adds `row#ax` to the running total.
lam concat_acc {r: Nat} (ax: Idx r) (acc: Nat, row: «r; Nat»): Nat = acc + row#ax;
///
/// ### concat_shape
///
/// `(ax, Sis) ↦ s_out`: sums the inputs' extents along `ax`, keeps the shared extents on every other
/// axis.
lam concat_shape {nis r: Nat} (ax: Idx r, Sis: «nis; «r; Nat»»): «r; Nat» =
    let sum_ax = vec.fold.l (concat_acc ax) (0, Sis);
    let row_0  = Sis#(core.idx 0 nis 0);
    ‹d: r; core.select (core.icmp.e (d, ax), sum_ax, row_0#d)›;
///
/// ### concat
///
/// Joins `nis` inputs along axis `ax`. All inputs share rank `r` and agree on every axis except `ax`;
/// the output extent along `ax` is the sum of the inputs' extents there (`s_out#ax = Σ_i Sis#i#ax`).
/// `out[…o…] = is#k[… o with o#ax ↦ o#ax − off#k …]`, where `k` is the input whose range `o#ax` lands
/// in (`off` are the prefix sums of the per-input extents along `ax`).
///
/// The output shape is deduced from `ax` and the per-input shapes `Sis` (see `concat_shape`), so it is
/// not passed explicitly.
///
axm concat: {T: *, nis r: Nat}
          → [ax: Idx r]
          → {Sis: «i: nis; «r; Nat»»}
          → [is: «i: nis; Tensor r (Sis#i) T»]
          → Tensor r (concat_shape (ax, Sis)) T, normalize_concat;
///
/// ### flip
///
/// Reverses every axis: `out[…d…] = input[… (s_in#d − 1) − d …]`.
///
axm flip: {T: *, r: Nat}
        → [s_in: «r; Nat»]
        → [input: Tensor r s_in T]
        → Tensor r s_in T, normalize_flip;
///
/// ### pad_shape
///
lam pad_shape {r: Nat} (lo s_in hi: «r; Nat»): «r; Nat» =
    ‹d: r; lo#d + s_in#d + hi#d›;
///
/// ### pad
///
/// Pads each axis: `s_out#d = lo#d + s_in#d + hi#d`, rank preserved.
/// `out[…o…] = input[… o#d − lo#d …]` whenever every axis lands inside the input region;
/// otherwise the value depends on `mode`:
///
/// - `mode = 0` (constant): out-of-region cells take the scalar `value`.
/// - `mode = 1` (replicate): out-of-region cells take the nearest edge element (the read index is
///   clamped to `[0, s_in#d − 1]` per axis); `value` is ignored.
///
/// The output shape is deduced from `lo`, `s_in` and `hi` (see `pad_shape`), so it is not passed explicitly.
axm pad: {T: *, r: Nat}
       → [s_in: «r; Nat»]
       → [mode: Nat, lo hi: «r; Nat»]
       → [input: Tensor r s_in T, value: T]
       → Tensor r (pad_shape (lo, s_in, hi)) T, normalize_pad;
///
/// ### repeat
///
/// Tiles `input` to the larger shape `s_out` (each `s_out#d` must be a multiple of `s_in#d`): `out[…d…] = input[… d mod s_in#d …]`.
///
axm repeat: {T: *, r: Nat}
          → [s_in: «r; Nat»]
          → [s_out: «r; Nat»]
          → [input: Tensor r s_in T]
          → Tensor r s_out T, normalize_repeat;
///
/// ### reshape
///
/// Row-major reshape: `prod(s_in)` must equal `prod(s_out)`. Loops over the result and reads the input at the
/// delinearized linear index, so it works for arbitrary rank changes (e.g. flatten/unflatten).
///
/// `s_in` is explicit because `s_out` has a different rank and so cannot pin the input's
/// rank/element-type during inference.
axm reshape: {T: *, r_in r_out: Nat}
           → [s_in: «r_in; Nat»]
           → [s_out: «r_out; Nat»]
           → [input: Tensor r_in s_in T]
           → Tensor r_out s_out T, normalize_reshape;
///
/// ### slice
///
/// Strided slice / narrow: `out[…d…] = input[… start#d + step#d · d …]`. Same rank in/out; `s_out` gives the sliced
/// extents (the caller must ensure `start#d + step#d · (s_out#d − 1) < s_in#d`).
///
axm slice: {T: *, r: Nat}
         → [s_in: «r; Nat»]
         → [start step s_out: «r; Nat»]
         → [input: Tensor r s_in T]
         → Tensor r s_out T, normalize_slice;
///
/// ### transpose_shape
///
/// `(s, permutation) ↦ ‹i; s#(permutation⁻¹#i)›`: the permuted shape.
lam transpose_shape {r: Nat} (s: «r; Nat», permutation: «r; Idx r»): «r; Nat» =
    let shape_permutation = ‹i: r; option.unwrap_unsafe (vec.first core.icmp.e (permutation, i))›;
    ‹i: r; s#(shape_permutation#i)›;
///
/// ### transpose
///
/// Permutes the dimensions of `input` according to `permutation`.
/// Input axis `j` becomes output axis `permutation#j`, so `out#i = s#(permutation⁻¹#i)` — the inverse of the StableHLO/NumPy convention.
///
/// `permutation` precedes `input`, and `{s}` is a *separate* implicit group introduced after it, so that `{T, r, s}`
/// can be inferred: `permutation: «r; Idx r»` pins the rank `r`, and only then is the `{s}` Hole created — with the
/// now-literal type `«r; Nat»`, which lets `input: Tensor r s T` infer its shape index.
axm transpose: {T: *, r: Nat}
             → [permutation: «r; Idx r»]
             → {s: «r; Nat»}
             → [input: Tensor r s T]
             → Tensor r (transpose_shape (s, permutation)) T, normalize_transpose;
///
/// ### transpose_2d
///
/// Permutes the dimensions of a 2-dimensional tensor.
///
anx lam transpose_2d {T: *} {s: «2; Nat»} (input: Tensor 2 s T): Tensor 2 (s#tt, s#ff) T = transpose (tt, ff) input;
///
/// ## Element-wise Operations
///
/// Apply a scalar function at every coordinate.
///
/// ### binary
///
/// Maps a binary function over a pair of tensors.
///
axm binary: {Ti1 Ti2 To: *}
          → [app: [Ti1, Ti2] → To]
          → {r: Nat, s: «r; Nat»}
          → [is: [Tensor r s Ti1, Tensor r s Ti2]]
          → Tensor r s To;
///
/// ### map
///
/// Maps a function over a collection of tensors.
///
axm map: {T: *, ni: Nat, Is: «ni; *»}
       → [app: «i: ni; Is#i» → T]
       → {r: Nat, s: «r; Nat»}
       → [is: «i: ni; Tensor r s (Is#i)»]
       → Tensor r s T;
///
/// ### select
///
/// Maps `core.select` over tensors.
///
axm select: {T: *}
          → {r: Nat, s: «r; Nat»}
          → [is: [Tensor r s Bool, Tensor r s T, Tensor r s T]]
          → Tensor r s T;
///
/// ### unary
///
/// Maps a unary function over a tensor.
///
axm unary: {Ti To: *}
         → [app: Ti → To]
         → {r: Nat, s: «r; Nat»}
         → [i: Tensor r s Ti]
         → Tensor r s To;
///
/// ## Reductions
///
/// Operations that fold one or more reduction dims away.
///
/// ### bmm
///
/// Computes the batch matrix multiplication (BMM) of two 3-dimensional tensors — a special case of `dot_product`.
///
axm bmm: [R: Ring]
       → {B M K N: Nat}
       → [t1: Tensor 3 (B, M, K) (R#T), t2: Tensor 3 (B, K, N) (R#T)]
       → Tensor 3 (B, M, N) (R#T);
///
/// ### conv_shape
///
/// `(n, cout, (H, W), (KH, KW), stride, dilation, padding) ↦ (n, cout, OH, OW)`, where
/// \f$O_d = (s_d + 2 \cdot \mathit{padding}_d - (\mathit{dilation}_d \cdot (k_d - 1) + 1)) / \mathit{stride}_d + 1\f$:
/// the NCHW output shape.
pub lam conv_shape (n cout: Nat, s k stride dilation padding: «2; Nat»): «4; Nat» =
    let (hwx, hwy) = ‹d: 2; (s#(d) + 2 * padding#(d) - (dilation#(d) * (k#(d) - 1) + 1)) / stride#(d) + 1›;
    (n, cout, hwx, hwy);
///
/// ### conv
///
/// 2-D convolution (cross-correlation) in the ring `R`, `groups = 1`, no bias:
/// \f[
///     \mathit{out}_{n,co,oh,ow} = \sum_{ci,kh,kw} \mathit{padded}_{n,ci,ih,iw} \cdot \mathit{weight}_{co,ci,kh,kw},
///     \qquad ih = \mathit{stride}_0 \cdot oh + \mathit{dilation}_0 \cdot kh,
///     \qquad iw = \mathit{stride}_1 \cdot ow + \mathit{dilation}_1 \cdot kw
/// \f]
///
/// - Layout: `input: Tensor 4 (N, Cin, H, W) (R#T)`, `weight: Tensor 4 (Cout, Cin, KH, KW) (R#T)`,
///   `output: Tensor 4 (N, Cout, OH, OW) (R#T)`.
/// - `padding` zero-pads the spatial axes (composed via `pad`), so the windowed read is a pure affine
///   map.
/// - The output shape follows from the extents and window parameters (see `conv_shape`) and is not
///   passed explicitly.
///
axm conv: [R: Ring]
        → {n cin cout h w kh kw: Nat}
        → [stride dilation padding: «2; Nat»]
        → [input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, cin, kh, kw) (R#T)]
        → Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T);
///
/// ### conv_grouped
///
/// `conv` with the channels split into `groups` independent convolutions: output channel `co` only reads the
/// `ci = cin / groups` input channels of its group `co / (cout / groups)`.
///
/// - Layout: as for `conv`, but `weight: Tensor 4 (Cout, Cin / groups, KH, KW) (R#T)`.
/// - `groups` must divide both `cin` and `cout`.
axm conv_grouped: [R: Ring]
                → {n cin cout h w ci kh kw: Nat}
                → [groups: Nat, stride dilation padding: «2; Nat»]
                → [input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, ci, kh, kw) (R#T)]
                → Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T);
///
/// ### dot_general_shape
///
/// The result shape: the batching extents, then the left operand's free extents, then the right
/// operand's; the batching extents are checked to agree (the contracting ones in `dot_product_impl`).
lam dot_general_shape {r1 r2: Nat} {nc nb: Nat}
    (c1: «nc; Idx r1», c2: «nc; Idx r2», b1: «nb; Idx r1», b2: «nb; Idx r2»)
    (s1: «r1; Nat», s2: «r2; Nat») =
    let bs      = ‹i: nb; refly.check (s1#(b1#i) == s2#(b2#i), s1#(b1#i), "batching dims don't match")›;
    let bc_1    = vec.cat (b1, c1);
    let s1_res  = vec.diff (s1, bc_1);
    let bc_2    = vec.cat (b2, c2);
    let s2_res  = vec.diff (s2, bc_2);
    let s12_res = vec.cat (s1_res, s2_res);
    vec.cat (bs, s12_res);
///
/// ### dot_product
///
/// Returns the [generalized dot product](https://openxla.org/stablehlo/spec#dot_general) of `a` and `b`:
///
/// - `R`: the ring in which the dot product is performed
/// - `r1`/`r2`: the ranks of the two inputs
/// - `nc`/`nb`: the number of contracting/batching dimensions
/// - `c1`/`c2`: the contracting dimensions of the left/right input
/// - `b1`/`b2`: the batching dimensions of the left/right input
/// - `s1`/`s2`: the shape of the left/right input
/// - `a`/`b`: the left/right input
///
axm dot_product: [R: Ring]
               → {r1 r2: Nat}
               → {nc nb: Nat}
               → [c1: «nc; Idx r1», c2: «nc; Idx r2», b1: «nb; Idx r1», b2: «nb; Idx r2»]
               → {s1: «r1; Nat», s2: «r2; Nat»}
               → [a: Tensor r1 s1 (R#T), b: Tensor r2 s2 (R#T)]
               → Tensor (vec.len (dot_general_shape (c1, c2, b1, b2) (s1, s2))) (dot_general_shape (c1, c2, b1, b2) (s1, s2)) (R#T);
///
/// ### pool
///
/// 2-D pooling: reduces each `(kernel#0, kernel#1)` window of `input: Tensor 4 (N, C, H, W) T` with the fold
/// `g` seeded by `init` to `output: Tensor 4 (N, C, OH, OW) T`, each channel independently.
///
/// - `padding` pads the spatial axes with `init` (composed via `pad`), so padded cells are inert.
/// - Max-pooling is `g = max, init = −∞`; sum-/average-pooling is `g = +, init = 0` — divide by the
///   window size afterwards for the average.
/// - Unlike `conv` there is no weight, so the window size `kernel` is an explicit operand, and the
///   output spatial size `s_out = (OH, OW)` is passed explicitly.
///
axm pool: {T: *}
        → [g: [T, T] → T, init: T]
        → {n c h w: Nat}
        → [kernel stride dilation padding s_out: «2; Nat»]
        → [input: Tensor 4 (n, c, h, w) T]
        → Tensor 4 (n, c, s_out#0₂, s_out#1₂) T;
///
/// ### product_2d
///
/// Computes the matrix product of two 2-dimensional tensors — a special case of `dot_product`.
///
axm product_2d: [R: Ring]
              → {m k l: Nat}
              → [t1: Tensor 2 (m, k) (R#T), t2: Tensor 2 (k, l) (R#T)]
              → Tensor 2 (m, l) (R#T);
///
/// ## Indexing
///
/// Data-dependent access: an `index` tensor picks the coordinate along `dim`.
///
/// ### gather
///
/// Reads one source element for every index element:
///
/// - the output coordinate is also the index coordinate, except on `dim`, where the value loaded from
///   `index` selects the source coordinate;
/// - `s_idx#d <= s_src#d` is required for every `d != dim`;
/// - `dim: Idx r` and the index element type encode the axis and the indexed-source bounds in the type.
///
/// ```python
/// for out_index in ndindex(s_idx):
///     selected = index[out_index]
///     source_index = tuple(
///         selected if d == dim else out_index[d]
///         for d in range(r)
///     )
///     output[out_index] = input[source_index]
/// ```
axm gather: {T: *, r: Nat}
          → [s_src: «r; Nat», s_idx: «r; Nat»]
          → [dim: Idx r]
          → [input: Tensor r s_src T, index: Tensor r s_idx (Idx (s_src#dim))]
          → Tensor r s_idx T;
///
/// ### scatter
///
/// Starts with `input` and visits `index` in row-major order.
/// Each corresponding `updates` element is stored at the input coordinate selected by `index` on `dim`.
/// Duplicate destinations use the last visited update. For `d != dim`, `s_idx#d <= s_src#d`; on every axis, `s_idx#d <= s_updates#d`.
///
/// ```python
/// output = input.copy()
/// for update_coord in ndindex(s_idx):
///     selected = index[update_coord]
///     destination = tuple(
///         selected if d == dim else update_coord[d]
///         for d in range(r)
///     )
///     output[destination] = updates[update_coord]
/// ```
axm scatter: {T: *, r: Nat}
           → [s_src: «r; Nat», s_idx: «r; Nat», s_updates: «r; Nat»]
           → [dim: Idx r]
           → [input: Tensor r s_src T, index: Tensor r s_idx (Idx (s_src#dim)), updates: Tensor r s_updates T]
           → Tensor r s_src T;
///
/// ## Reflection
///
/// Compile-time queries about an operand that a schedule selector (see Tiling) branches on.
///
/// ### fastest_axis
///
/// Layout reflection for schedule selectors: which axis of the rank-`r` tensor `t` is the
/// fastest-varying (unit-stride) axis of the tensor **actually** read, once `fuse_tensor`'s
/// read-through has absorbed a pure re-indexed read behind `t` — behind a transpose the source's
/// trailing axis maps back to a different axis of `t`.
///
/// - a plain tensor (anything that is not such a read, a still-symbolic operand included): its own
///   last axis `r − 1`.
/// - an undecidable read (composed arithmetic like `reshape`, a nested read chain): the sentinel `r`.
///
/// This reflects only operand structure the frontend cannot inspect itself; the schedule **decision**
/// built on the answer stays in the IR next to the op (see `dot_product_impl`).
/// `tensor::Lower` applies it where the op's operands are concrete.
///
axm fastest_axis: {T: *} → [r: Nat, t: T] → Nat, normalize_fastest_axis;
///
/// ### if_static
///
/// Binding-time dispatch for schedule selectors, so that one selector serves compile-time and
/// runtime extents without staging annotations at the call site:
///
/// - `k` a literal: the normalizer picks `s`.
/// - `k` symbolic: stays stuck, keeping the choice open until instantiation.
/// - still stuck at lowering time: the lowerings residualize to `d`, since an undecided `k` is then a
///   runtime value.
axm if_static: {T: *} → [k: Nat, s d: T] → T, normalize_if_static;
///
/// ### vec_width
///
/// Target reflection for schedule selectors: the machine's vector width, in elements of the schedule's fold type.
/// It is the number of lanes one vector register holds, and hence the widest block of independent accumulators a
/// vectorized loop body can keep in registers.
/// `d` is the width to answer when the compilation was not told one; `-X tensor:vec-width=<n>` (`1`, `4`, `8` or `16`)
/// overrides it, so a single world can be emitted for one target and re-emitted for another.
/// `1` describes a target without SIMD: no block is sized by lanes, and `reassoc` counts plain multiplications.
/// It does not stop the backend from vectorizing the loops a schedule nominates.
/// Like `fastest_axis` this only reflects what the frontend cannot inspect itself; the schedule **decision** built on
/// the answer stays in the IR next to the op (see `dot_schedule_kvec`).
/// `reassoc` charges its costs in units of the same width, so schedules and cost model agree on the target.
axm vec_width: [d: Nat] → Nat, normalize_vec_width;
///
/// ## Tiling
///
/// Tiling, strip-mining and schedule selection are implemented entirely in the frontend IR, with
/// partial evaluation doing the rewriting; no C++ transformation code.
///
/// ### Tileable
///
/// A `Tileable` existentially packages a computation over an affinely-indexed iteration domain
/// together with its **schedule** (cf. MLIR's TilingInterface):
///
/// - `Out`: the result *type constructor* — what materializing over a domain with `ro` parallel
///   dims of extents `so` yields.
/// - the iteration domain `Sr` (leading `Ro` parallel dims, trailing `Rr` reduction dims) and the
///   result shape `So` — MLIR's getIterationDomain + getLoopIteratorTypes.
/// - `oax`: which output axis each parallel dim writes — the piece of the write map the domain
///   transforms need (`strip_mine_par` splits the output along `oax#d`).
/// - the schedule `sched` (see `Sched`): the record `retile` packs into the op's chooser.
/// - `retile`: rebuild the computation over a *reindexed* domain, given the new domain and
///   schedule, `iota` (maps new loop vectors to old loop vectors) and `omega` (maps (old output
///   coordinates, new loop vector) to new output coordinates).
///
/// The op's internals (combiner, init, epilogue, inputs, access maps) stay hidden in the closure.
let Tileable = [
    Out: [ro: Nat, so: «ro; Nat»] → *,
    Ro: Nat, Rr: Nat,
    So: «Ro; Nat»,
    oax: «Ro; Nat»,
    Sr: «Ro + Rr; Nat»,
    sched: Sched,
    retile: [Ro_n Rr_n: Nat]
          → [So_n: «Ro_n; Nat», Sr_n: «Ro_n + Rr_n; Nat», sched_n: Sched]
          → [iota:  «Ro_n + Rr_n; affine.Index» → «Ro + Rr; affine.Index»,
             omega: [«Ro; affine.Index», «Ro_n + Rr_n; affine.Index»] → «Ro_n; affine.Index»]
          → Out (Ro_n, So_n),
];
///
/// #### comp_map
///
/// Composition helper for access maps: (m ∘ g).
///
lam comp_map {A B C: *} (m: B → C, g: A → B) (o: A): C = m (g o);
///
/// #### interchange
///
/// Permute the loop dims — new loop `j` iterates old dim `perm#j`. Loop order and write
/// position are decoupled by the write map, so So is untouched. The permutation must keep parallel
/// dims parallel (`perm#j < Ro` iff `j < Ro`), enforced at compile time; the schedule's `vdim` moves to
/// its new position.
anx lam interchange (t: Tileable, perm: «t#Ro + t#Rr; Nat»): Tileable =
    let r = t#Ro + t#Rr;
    let perm_ok = ‹j: r; let jj = core.idx2nat j;
                         refly.check (core.icmp.e @2 (jj < t#Ro, perm#j < t#Ro),
                                       perm#j,
                                       "interchange: permutation must not mix parallel and reduction dims")›;
    let sr_n   = ‹i: r; t#Sr#(core.idx 0 r (perm_ok#i))›;
    let vdim_n = match vec.first `== (perm_ok, t#sched#vdim) with
                     | Some j => core.idx2nat j
                     | None   => t#sched#vdim;
    // The parallel dims permute among themselves (checked above), so the new dim j writes the
    // output axis its old dim perm#j wrote.
    let oax_n = ‹j: t#Ro; t#oax#(core.idx 0 (t#Ro) (perm_ok#(core.idx 0 r (core.idx2nat j))))›;
    // iota: old dim i is found at the new position j with perm#j = i.
    lam iota_p (o: «r; affine.Index»): «r; affine.Index» =
        ‹i: r; o#(option.unwrap_unsafe (vec.first `== (perm_ok, core.idx2nat i)))›;
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «ro_m + rr_m; Nat», sched_m: Sched)
                 (iota:  «ro_m + rr_m; affine.Index» → «r; affine.Index»,
                  omega: [«t#Ro; affine.Index», «ro_m + rr_m; affine.Index»] → «ro_m; affine.Index»)
               : t#Out (ro_m, so_m) =
        t#retile (ro_m, rr_m) (so_m, sr_m, sched_m) (comp_map (iota_p, iota), omega);
    (t#Out, t#Ro, t#Rr, t#So, oax_n, sr_n, (t#sched)#vdim ← vdim_n, retile_n);
///
/// #### materialize
///
/// Materialize a `Tileable` over its current domain and schedule (identity reindexing).
anx lam materialize (t: Tileable): t#Out (t#Ro, t#So) =
    lam id_i (o: «t#Ro + t#Rr; affine.Index»): «t#Ro + t#Rr; affine.Index» = o;
    lam id_o (oo: «t#Ro; affine.Index», o: «t#Ro + t#Rr; affine.Index»): «t#Ro; affine.Index» = oo;
    t#retile (t#Ro, t#Rr) (t#So, t#Sr, t#sched) (id_i, id_o);
///
/// #### mr_tileable
///
/// The `map_reduce_post` instance, the SSA analog of MLIR's getTiledImplementation: `retile` rebuilds
/// the same op over the new domain, composing the access maps with `iota` and the write map with
/// `omega`.
///
/// - No extract/insert_slice machinery — the tiled reads hit the original inputs through the
///   reindexed access maps.
/// - Epilogue-free (`nps = 0`): impls build raw ops and the epilogue arrives later via `fuse_tensor`,
///   because epilogue-input access maps take output-cell coordinates, whose rank a domain transform
///   may change.
/// - `oax` states which output axis `map_out` writes each parallel dim to — the identity for the
///   impls' projection write maps.
anx lam mr_tileable
                {nis: Nat}
                {Ro Rr: Nat}
                {To Tp: *}
                (So: «Ro; Nat», oax: «Ro; Nat», Sr: «Ro + Rr; Nat»)
                {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                (f: Fn [To, «i: nis; Tis#i»] → To, init: To, post: Fn [To, []] → Tp)
                (map_out: «Ro + Rr; affine.Index» → «Ro; affine.Index»)
                (maps: «i: nis; («Ro + Rr; affine.Index» → «Ris#i; affine.Index»)»)
                (is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)»)
              : Tileable =
    lam out_t (ro: Nat, so: «ro; Nat»): * = Tensor ro so Tp;
    lam retile (Ro_n Rr_n: Nat)
               (So_n: «Ro_n; Nat», Sr_n: «Ro_n + Rr_n; Nat», sched_n: Sched)
               (iota:  «Ro_n + Rr_n; affine.Index» → «Ro + Rr; affine.Index»,
                omega: [«Ro; affine.Index», «Ro_n + Rr_n; affine.Index»] → «Ro_n; affine.Index»)
             : Tensor Ro_n So_n Tp =
        lam map_out_n (o: «Ro_n + Rr_n; affine.Index»): «Ro_n; affine.Index» =
            omega (map_out (iota o), o);
        map_reduce_post @(nis, 0) @(To, Tp, Ro_n, Ro_n + Rr_n, SchedT)
            (So_n, Sr_n, mk_sched sched_n)
            @(Tis, Ris, Sis, (), (), ()) (f, init, post)
            map_out_n
            (‹i: nis; comp_map (maps#i, iota)›, ())
            (is, ());
    (out_t, Ro, Rr, So, oax, Sr, (Ro + Rr, 0), retile);
///
/// #### unroll_trailing
///
/// Fully unroll the trailing `d` reduction dims into the loop body — e.g. a
/// convolution's kh·kw window (`d = 2`). Their trip counts must be literals at lowering time.
lam unroll_trailing (t: Tileable, d: Nat): Tileable = t#sched#unroll ← d;
///
/// #### vectorize
///
/// Run dim `d` as the innermost, unit-stride vector loop (per-cell fold order is
/// unchanged). A parallel `d` runs inside the reduction loops over a row of accumulators; the
/// innermost reduction dim as `d` selects `btensor.mr_nest`'s reduction-vectorized nest instead.
lam vectorize (t: Tileable, d: Nat): Tileable = t#sched#vdim ← d;
///
/// ### Strip-Mining
///
/// Strip-mining is a pure **domain** transform (cf. TilingInterface's `op[N] → op[N/ts, ts]`) that
/// `retile` absorbs entirely: `iota` recombines the split loop vector, and for a parallel dim `omega`
/// splits the write coordinate.
/// The result is an ordinary `map_reduce_post` over a higher-rank domain with composed access maps —
/// schedule operand and lowering untouched.
/// Classic cache tiling is composition: strip-mine, then `interchange` the tile loops outward.
///
/// #### check_div
///
/// Checks that `ts` exactly divides the extent `sd` (discharges symbolically for factored extents).
lam check_div (sd ts: Nat): Nat =
    refly.check (sd / ts * ts == sd, sd, "strip_mine: tile size must divide the extent");
///
/// #### shift_ax
///
/// Axis renumbering after inserting a new axis at position `a`.
lam shift_ax (a x: Nat): Nat = core.select (x < a, x, x + 1);
///
/// #### split_bounds
///
/// Split bounds vector `v` (length `n`) at dim `d` into `(nt, ts)`; the result arity `m` (`= n+1`) is
/// passed explicitly, in the syntactic form the call site's types require (the checker does not
/// re-associate `core.nat.add` symbolically).
lam split_bounds (m n: Nat, v: «n; Nat», d ts nt: Nat): «m; Nat» =
    ‹i: m; let ii = core.idx2nat i;
           core.select (ii < d, v#(core.idx 0 n ii),
           core.select (ii == d, nt,
           core.select (ii == d + 1, ts,
           v#(core.idx 0 n (ii - 1)))))›;
///
/// #### split_iota
///
/// Recombine a split loop vector (`m = n+1`): `old#d = new#d · ts + new#(d+1)`.
lam split_iota (m n d ts: Nat) (o: «m; affine.Index»): «n; affine.Index» =
    ‹j: n; let jj = core.idx2nat j;
           core.select (jj < d, o#(core.idx 0 m jj),
           core.select (jj == d,
                         affine.op.add (affine.semiop.mul (o#(core.idx 0 m d), ts),
                                         o#(core.idx 0 m (d + 1))),
           o#(core.idx 0 m (jj + 1))))›;
///
/// #### split_omega
///
/// Split an output coordinate vector (`m = n+1`): `new#a = old#a ⌊/⌋ ts`, `new#(a+1) = old#a mod ts`.
lam split_omega (m n a ts: Nat) (oc: «n; affine.Index»): «m; affine.Index» =
    ‹j: m; let jj = core.idx2nat j;
           core.select (jj < a, oc#(core.idx 0 n jj),
           core.select (jj == a, affine.semiop.floordiv (oc#(core.idx 0 n a), ts),
           core.select (jj == a + 1, affine.semiop.rem (oc#(core.idx 0 n a), ts),
           oc#(core.idx 0 n (jj - 1)))))›;
///
/// #### strip_mine_par
///
/// Split parallel dim `d` (d < Ro) into two adjacent parallel dims. The result
/// shape splits along the output axis `d` writes (`oax#d`), so the materialized tensor is *packed*
/// (`«…, N/ts, ts, …»` along that axis); a row-major `reshape` restores the original shape — and in a
/// fused graph `fuse_tensor`'s read-through absorbs it into the consumers' access maps.
anx lam strip_mine_par (t: Tileable, d ts: Nat): Tileable =
    let r    = t#Ro + t#Rr;
    let ro_n = t#Ro + 1;
    let r_n  = t#Ro + 1 + t#Rr;
    let a    = t#oax#(core.idx 0 (t#Ro) d);
    let sd   = refly.check (t#So#(core.idx 0 (t#Ro) a) == t#Sr#(core.idx 0 r d),
                             t#Sr#(core.idx 0 r d),
                             "strip_mine_par: output extent (at oax#d) must match domain extent");
    let nt   = check_div (sd, ts) / ts;
    // The split dim writes the split axis pair; all other dims write their old axis, renumbered
    // around the insertion at `a`. The unit-stride half is the inner one: a vdim at `d` moves to
    // `d + 1`.
    let oax_n = ‹j: ro_n; let jj = core.idx2nat j;
                          core.select (jj < d, shift_ax (a, t#oax#(core.idx 0 (t#Ro) jj)),
                          core.select (jj == d, a,
                          core.select (jj == d + 1, a + 1,
                          shift_ax (a, t#oax#(core.idx 0 (t#Ro) (jj - 1))))))›;
    // FIXME: a reduction vdim is reset to none here instead of moving to `vdim + 1`.
    let vd     = t#sched#vdim;
    let vdim_n = core.select (vd < t#Ro, core.select (vd < d, vd, vd + 1), r_n);
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «ro_m + rr_m; Nat», sched_m: Sched)
                 (iota:  «ro_m + rr_m; affine.Index» → «r_n; affine.Index»,
                  omega: [«ro_n; affine.Index», «ro_m + rr_m; affine.Index»] → «ro_m; affine.Index»)
               : t#Out (ro_m, so_m) =
        lam iota_c  (o: «ro_m + rr_m; affine.Index»): «r; affine.Index» =
            split_iota (r_n, r, d, ts) (iota o);
        lam omega_c (oo: «t#Ro; affine.Index», ov: «ro_m + rr_m; affine.Index»): «ro_m; affine.Index» =
            omega (split_omega (ro_n, t#Ro, a, ts) oo, ov);
        t#retile (ro_m, rr_m) (so_m, sr_m, sched_m) (iota_c, omega_c);
    (t#Out, ro_n, t#Rr,
     split_bounds (ro_n, t#Ro, t#So, a, ts, nt), oax_n,
     split_bounds (r_n, r, t#Sr, d, ts, nt), (t#sched)#vdim ← vdim_n, retile_n);
///
/// #### strip_mine_red
///
/// Split reduction dim `d` (Ro ≤ d < Ro + Rr) of extent N into two adjacent
/// reduction dims (N/ts, ts). If the split lands inside the trailing unroll window, both halves
/// unroll — the tap count is unchanged.
anx lam strip_mine_red (t: Tileable, d ts: Nat): Tileable =
    let r   = t#Ro + t#Rr;
    let r_n = t#Ro + (t#Rr + 1);
    let nt  = check_div (t#Sr#(core.idx 0 r d), ts) / ts;
    let vd       = t#sched#vdim;
    let un       = t#sched#unroll;
    let vdim_n   = core.select (vd < t#Ro, vd, r_n);
    let unroll_n = core.select (d < r - un, un, un + 1);
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «ro_m + rr_m; Nat», sched_m: Sched)
                 (iota:  «ro_m + rr_m; affine.Index» → «r_n; affine.Index»,
                  omega: [«t#Ro; affine.Index», «ro_m + rr_m; affine.Index»] → «ro_m; affine.Index»)
               : t#Out (ro_m, so_m) =
        t#retile (ro_m, rr_m) (so_m, sr_m, sched_m)
                 (comp_map (split_iota (r_n, r, d, ts), iota), omega);
    (t#Out, t#Ro, t#Rr + 1, t#So, t#oax,
     split_bounds (r_n, r, t#Sr, d, ts, nt), ((t#sched)#vdim ← vdim_n)#unroll ← unroll_n, retile_n);

/// ### Schedules
///
/// A `Schedule` is just a `Tileable` transformer, a **selector** a compile-time inspection of an op's
/// parameters returning the appropriate one — combinator composition, dispatched as an extract over
/// thunks so that partial evaluation resolves it entirely.
/// This is where "when is a transformation appropriate" lives: in the IR next to the op, not in a
/// lowering heuristic.
///
/// #### Schedule
///
/// A transformer of `Tileable`s.
let Schedule = Tileable → Tileable;
///
/// #### sched_id
///
lam sched_id (t: Tileable): Tileable = t;
///
/// #### unroll_budget
///
/// The greedy trailing-suffix unroll scan (the old lowering's budget scan): the number of trailing
/// reduction dims whose tap product stays within `budget`. Folded innermost-first over the
/// reduction dims with state (count, taps, alive); a dim whose extent is still open at lowering
/// time stops the scan (`if_static` residualizes its step to "over budget").
lam unroll_budget (t: Tileable, budget: Nat): Nat =
    let r = t#Ro + t#Rr;
    lam step (d: Nat, (cnt taps alive: Nat)): «3; Nat» =
        let taps_n  = taps * t#Sr#(core.idx 0 r d);
        let alive_n = alive * if_static (taps_n, (0, 1)#(taps_n <= budget), 0);
        (cnt + alive_n, core.select (alive_n == 1, taps_n, taps), alive_n);
    (vec.fold.r @(«3; Nat», Nat) @(t#Rr) step (‹i: t#Rr; t#Ro + core.idx2nat i›, (0, 1, 1)))#0_3;
///
/// #### vectorize_if
///
/// Vectorize the parallel dim `d` only when `cond` holds; otherwise the sentinel "no vector dim".
lam vectorize_if (t: Tileable, cond: Bool, d: Nat): Tileable =
    vectorize (t, (t#Ro + t#Rr, d)#cond);
///
/// #### conv_schedule
///
/// The convolution schedule, selected from the op's parameters — the old lowering's heuristics,
/// now plain IR next to the op:
///
/// - unroll the trailing reduction dims greedily while their tap product fits the register budget
///   (the kh·kw window; a small cin joins it) — constant tap offsets, no window loops;
/// - run `ow` (parallel dim 3) innermost with unit stride over a row of accumulators iff it beats
///   the innermost *remaining* reduction dim on unit-stride/broadcast reads: ow reads the padded
///   input at stride_w and is broadcast in the weight (score [stride_w = 1] + 1); an un-unrolled
///   kw reads the input at dilation_w and the weight at unit stride ([dilation_w = 1] + 1 — the
///   classic nest is already unit-stride, so vectorizing buys nothing); kh/cin score 0; with the
///   whole reduction unrolled there is nothing to beat;
/// - a **pointwise** window (kh·kw = 1) has no taps to unroll, so the row accumulator would make a
///   memory round trip per MAC: jam a block of `co` into the vector body (the padded-input read is
///   invariant in `co`, so the jammed cells share it) and unroll a tile of `ci` into the window
///   (which amortizes the round trip over the tile) — the 1x1 counterpart of the kh·kw window.
///
/// Open extents/strides residualize to no unrolling and no vector dim (`if_static`).
lam conv_schedule (stride dilation: «2; Nat») (t: Tileable): Tileable =
    let u     = unroll_budget (t, 32);
    let s_ow  = (0, 1)#(stride#1_2 == 1) + 1;
    // FIXME: with the whole reduction unrolled the doc says `ow` has nothing to beat, but `s_red = s_ow` keeps it scalar.
    let s_red = core.select (u == 0, (0, 1)#(dilation#1_2 == 1) + 1, core.select (u < t#Rr, 0, s_ow));
    let r     = t#Ro + t#Rr;
    let ow    = t#Sr#(core.idx 0 r 3);
    let vec   = if_static (stride#1_2 * dilation#1_2 * ow, s_red < s_ow, ff);
    lam fits (k b: Nat): Bool = core.bit2.and 2 (k / b * b == k, b < k);
    // Rows too short for the vectorizer (ow < 16) are processed in BLOCKS: strip-mine oh by the
    // largest block size ≤ 4 that divides it and sink both halves (vdim = ro − 2 selects mr_nest's
    // blocked branch, which jams the block dim into the vector body — one reduction pass folds the
    // whole row block, sharing the hoisted window weights). Otherwise the split is the neutral
    // ts = 1 (its size-1 axis folds away), so one code path serves every case and no divisibility
    // check fires on an untaken choice.
    let oh    = t#Sr#(core.idx 0 r 2);
    lam divides (d: Nat): Bool = oh / d * d == oh;
    let bs    = ((1, 2)#(divides 2), 4)#(divides 4);
    let short = if_static (oh * ow, core.bit2.and 2 (vec, ow < 16), ff);
    // There is one jam slot, so a `co` block is worth taking only where the row block cannot fire:
    // a POINTWISE window (which has no taps to amortize the accumulator round trip at all), or a
    // short row whose oh does not split. Measured over the level3 3x3 layers, taking it against a
    // working row block instead is a 5-12% loss, and taking it for a long row is a wash.
    let co    = t#Sr#(core.idx 0 r 1);
    let ci    = t#Sr#(core.idx 0 r 4);
    let win   = t#Sr#(core.idx 0 r 5) * t#Sr#(core.idx 0 r 6);
    let pw    = if_static (win, core.bit2.and 2 (vec, win == 1), ff);
    // A pointwise window keeps a working 2-row block at unit stride (1.3-1.6x faster over the level3
    // pointwise layers); 4-row blocks and strided rows still lose to the `co` block.
    let pw_rows = core.bit2.and 2 (core.bit2.and 2 (short, bs == 2),
                                    core.bit2.and 2 (stride#0_2 == 1, stride#1_2 == 1));
    let cob   = core.bit2.or 2 (core.bit2.and 2 (pw, (tt, ff)#pw_rows), core.bit2.and 2 (short, bs == 1));
    // One accumulator register per jammed cell, so a block wider than the target's lanes spills;
    // every jammed cell also replays the window, so the block shares the 32-tap register budget.
    let vw    = vec_width 8;
    lam cb_ok (b: Nat): Bool = core.bit2.and 2 (core.bit2.and 2 (fits (co, b), b <= vw), b * win <= 32);
    let cb    = if_static (co, (1, (((1, 2)#(cb_ok 2), 4)#(cb_ok 4), 8)#(cb_ok 8))#cob, 1);
    let cblk  = cb != 1;
    lam ct_ok (b: Nat): Bool = core.bit2.and 2 (fits (ci, b), cb * b * win <= 32);
    let cts   = if_static (ci, (1, (((1, 2)#(ct_ok 2), 4)#(ct_ok 4), 8)#(ct_ok 8))#cob, 1);
    let block = core.bit2.and 2 ((tt, ff)#cblk, core.bit2.and 2 (short, bs != 1));
    let t_ci  = strip_mine_red (t, 4, cts);
    let t_co  = strip_mine_par (t_ci, 1, cb);
    let t_oh  = strip_mine_par (t_co, 3, (1, bs)#block);
    // Spelled from t_oh's positional fields so the pack's length is definitionally the
    // «t#Ro + t#Rr» the dependent `interchange` domain expects.
    let r_n   = t_oh#1_8 + t_oh#2_8;
    // Dims are (n, co/cb, cb, oh/bs, bs, ow | …); rotate `cb` down next to `ow` so the jam dim and
    // the vector dim are the trailing parallel pair. Identity when the block is not taken.
    let perm  = ‹j: r_n; let jj = core.idx2nat j;
                         core.select (core.bit2.and 2 (cblk, jj == 2), 3,
                         core.select (core.bit2.and 2 (cblk, jj == 3), 4,
                         core.select (core.bit2.and 2 (cblk, jj == 4), 2, jj)))›;
    let vd    = core.select (core.bit2.or 2 (cblk, block), 4, (r_n, 5)#vec);
    // The window grows only when the `ci` split is REAL; keying it off the pointwise flag would
    // over-unroll a big window past the tap budget (a 7x7 stem goes 7 -> 49 taps, and 2x slower).
    let un    = core.select (core.bit2.or 2 (cts != 1, 3 <= u), u + 1, u);
    unroll_trailing (vectorize (interchange (t_oh, perm), vd), un);
///
/// #### dot_schedule
///
/// The dot-product schedule for a contraction whose right operand stores the last output dim
/// unit-stride (\f$A \cdot B\f$): that dim is invariant in the left operand, so it runs innermost over a row of
/// accumulators (GEMM-style vectorization) and the innermost contraction is register-blocked —
/// strip-mined by 4, the tile unrolled.
///
/// - Blocking only needs the **divisibility** decided, which is weaker than a literal extent: a
///   factored extent (`«(n+3)/4*4, …»`, say a padded row) folds the guard to `tt` under a symbolic
///   `n`, because `core.nat` cancels `(c*x)/c`.
/// - `if_static` therefore gates on the tile size rather than on `K` — a tile that folded to a
///   literal is decided, no matter which kind of extent decided it.
/// - An undecided divisibility takes the neutral tile (`ts = 1`), so one selector serves static,
///   symbolic and runtime shapes.
lam dot_schedule (r_out: Nat) (t: Tileable): Tileable =
    let r   = t#Ro + t#Rr;
    let d   = r - 1;
    let K   = t#Sr#(core.idx 0 r d);
    let ts0 = (1, 4)#(K / 4 * 4 == K);
    let ts  = if_static (ts0, ts0, 1);
    unroll_trailing (strip_mine_red (vectorize (t, r_out - 1), d, ts), 1);
///
/// #### dot_schedule_kvec
///
/// The dot-product schedule for a contraction whose right operand stores the **contraction**
/// unit-stride per output cell (\f$x \cdot W^T\f$ — the fc/linear layout, where `fuse_tensor`'s read-through
/// absorbs the weight transpose into the access map).
/// Vectorizing the last output dim would read a different weight row per lane (gathers), so instead
///
/// - the contraction itself runs as the vector loop — unit-stride in both the input row and each
///   weight row, folded with a horizontal sum (see `btensor.mr_nest`'s reduction-vectorized branch,
///   selected by a `vdim` naming the innermost reduction dim, where `unroll` names the jam width);
/// - a 2-D block of output cells is unroll-and-jammed into its body over independent vector
///   accumulators: the last output dim strip-mined by the largest power-of-two divisor that fits the
///   target's vector width (`vec_width` — jammed lanes share the input-row loads) × the
///   second-to-last by 2 (jammed rows share the weight-row loads — without this the whole weight
///   matrix re-streams once per batch row).
///
/// An extent still open at lowering time, an indivisible one, and the missing row dim of a rank-1
/// output all take the neutral split (`1`), whose size-1 jam dim folds away.
lam dot_schedule_kvec (r_out: Nat) (t: Tileable): Tileable =
    // A block counts only when it divides AND leaves a non-trivial outer dim (`b < k`): an exact
    // split's leading size-1 axis would type-collapse the packed output (Tensor 1 1 T ≡ T).
    lam blk_by (k b: Nat): Bool = core.bit2.and 2 (k / b * b == k, b < k);
    // One accumulator register per jammed cell, so a block wider than the target's lanes spills.
    let vw  = vec_width 8;
    lam blk_ok (k b: Nat): Bool = core.bit2.and 2 (blk_by (k, b), b <= vw);
    let d   = r_out - 1;
    let n   = t#So#(core.idx 0 (t#Ro) d);
    let bs  = if_static (n, ((((1, 2)#(blk_ok (n, 2)), 4)#(blk_ok (n, 4)), 8)#(blk_ok (n, 8)), 16)#(blk_ok (n, 16)), 1);
    let t2  = strip_mine_par (t, d, bs);
    let d2  = r_out - 2;
    let m   = t#So#(core.idx 0 (t#Ro) d2);
    let ms  = (1, if_static (m, (1, 2)#(blk_by (m, 2)), 1))#(2 <= r_out);
    let t3  = strip_mine_par (t2, d2, ms);
    // Dims now (…, m/ms, ms, n/bs, bs | red): swap ms ↔ n/bs so both jam dims are the trailing
    // parallel pair. Identity for a rank-1 output, where the neutral split already sits next to
    // `bs` ((n/bs, 1, bs | red)). `r3` is spelled from t3's own (positional) fields so the pack's
    // length is definitionally the «t#Ro + t#Rr» the dependent `interchange` domain expects —
    // `core.nat.add` does not reassociate an equivalent spelling.
    let r3   = t3#1_8 + t3#2_8;
    let swap = 2 <= r_out;
    let pa   = r_out - 1;
    let pb   = r_out;
    let perm = ‹j: r3; let jj = core.idx2nat j;
                       core.select (core.bit2.and 2 (swap, jj == pa), pb,
                       core.select (core.bit2.and 2 (swap, jj == pb), pa, jj))›;
    unroll_trailing (vectorize (interchange (t3, perm), r3 - 1), 2);
///
/// #### pool_schedule
///
/// The pooling schedule: unroll the window while it stays within budget. Pooling reads its single
/// input in every loop dim (no broadcast operand), so `ow` scores [stride_w = 1] against an
/// un-unrolled kw's [dilation_w = 1] — the row accumulator never wins and the nest stays classic.
lam pool_schedule (stride dilation: «2; Nat») (t: Tileable): Tileable =
    let u     = unroll_budget (t, 32);
    let s_ow  = (0, 1)#(stride#1_2 == 1);
    let s_red = core.select (u == 0, (0, 1)#(dilation#1_2 == 1), core.select (u < t#Rr, 0, s_ow));
    let ow    = t#Sr#(core.idx 0 (t#Ro + t#Rr) 3);
    let vec   = if_static (stride#1_2 * dilation#1_2 * ow, s_red < s_ow, ff);
    unroll_trailing (vectorize_if (t, vec, 3), u);
///
/// ## Implementations
///
/// The `_impl` annexes `lower_tensor` re-applies to expand the derived operations above, together
/// with the fold steps and access maps they read through.
/// Most are a single `map_reduce` over a copy step — the operation itself lives in the access map.
/// They are `priv`: the phase resolves them through the annex table, so no path from outside this
/// plugin reaches them and the axioms above stay the only public spelling of these operations.
///
/// The declaration order is load-bearing beyond the usual definition-before-use: `lower_tensor`
/// resolves an `_impl` in the world it is *building*, so an impl must be declared before any annex
/// whose body applies the axiom it implements — `reshape_impl` before `conv_impl` and
/// `dot_product_impl`, which reshape their packed results.
///
/// ### tensor_copy
///
/// Ignores the (⊥) accumulator and returns the read element — the fold step of every pure
/// re-indexing operation below.
fun tensor_copy {T: *} (acc: T, y: T)@tt: T = return y;
///
/// ### bid_map
///
/// `o ↦ (o#(index#i) · [s_in#i ≠ 1])_i`: input axis `i` reads output-loop var `o#(index#i)` (the transpose), unless
/// it is a broadcast axis (`s_in#i = 1`), which reads index 0.
lam bid_map {r_in r_out: Nat} (s_in: «r_in; Nat», index: «r_in; Idx r_out»)
            (o: «r_out; affine.Index»): «r_in; affine.Index» =
    ‹i: r_in; affine.semiop.mul (o#(index#i), core.select (s_in#i == 1, 0, 1))›;
///
/// ### broadcast_in_dim_impl
///
priv anx lam broadcast_in_dim_impl {T: *, r_in r_out: Nat}
    (s_in: «r_in; Nat», s_out: «r_out; Nat», input: Tensor r_in s_in T, index: «r_in; Idx r_out»): Tensor r_out s_out T =
    map_reduce (s_out, s_out) (tensor_copy, ⊥:T)
        affine.id (bid_map (s_in, index),) input;
///
/// ### flip_map
///
/// `o ↦ ((s_in#d − 1) − o#d)_d`: the reverse read map.
lam flip_map {r: Nat} (s_in: «r; Nat») (o: «r; affine.Index»): «r; affine.Index» =
    ‹d: r; affine.op.sub (affine.lit (s_in#d - 1), o#d)›;
///
/// ### flip_impl
///
priv anx lam flip_impl {T: *, r: Nat} (s_in: «r; Nat») (input: Tensor r s_in T): Tensor r s_in T =
    map_reduce (s_in, s_in) (tensor_copy, ⊥:T)
        affine.id (flip_map s_in,) input;
///
/// ### gather_pointwise_elem_impl
///
/// One output element: reads `index` at the output coordinate, then the source at that coordinate
/// with axis `dim` replaced by the loaded value.
priv anx lam gather_pointwise_elem_impl {T: *, r: Nat}
                                   (s_src: «r; Nat», s_idx: «r; Nat»)
                                   (dim: Idx r)
                                   (out_indices: «r; I64»)
                                   (input: Tensor r s_src T, index: Tensor r s_idx (Idx (s_src#dim))): T =
    let index_coords = ‹d: r; core.conv.u (s_idx#d) (out_indices#d)›;
    let source_axis_index = core.bitcast I64 (get (index, index_coords));
    let source_coords = ‹d: r;
        let coordinate = core.select (core.icmp.e @r (d, dim), source_axis_index, out_indices#d);
        core.conv.u (s_src#d) coordinate›;
    get (input, source_coords);
///
/// ### map_impl
///
/// A `map_reduce` whose fold step drops the accumulator and applies `app` to the element tuple.
priv anx lam map_impl {T: *, ni: Nat, Is: «ni; *»}
                     (app: «i: ni; Is#i» → T)
                     {r: Nat, s: «r; Nat»}
                     (is: «i: ni; Tensor r s (Is#i)»)
                     : Tensor r s T =
    fun app_mr (x: T, y: «i: ni; Is#i»)@tt = return (app y);
    // The `{Tis, Ris, Sis}` group stays explicit: with a *symbolic* `ni`, solving `Sis#i ≡ s` for all `i`
    // (i.e. `Sis := ‹ni; s›`) is Miller pattern unification. Adding that rule to `Checker::alpha_impl_` was tried
    // and reverted — even with an occurs check it fires inside `tuple`'s machinery and commits a wrong solution.
    map_reduce (s, s) @(Is, ‹ni; r›, ‹ni; s›) (app_mr, ⊥:T)
        // `‹ni; …›` builds the pack bottom-up, so there is no expected type to drive implicit insertion for the
        // element; `affine.id` needs its rank here.
        affine.id ‹ni; affine.id @r› is;
///
/// ### pool_fun
///
/// Wraps a binary fold `g` as a `map_reduce` reduction `Fn [T, Tensor 1 1 T] → T`.
pub fun pool_fun {T: *} (g: [T, T] → T) (acc y: T)@tt: T = return (g (acc, y));
///
/// ### reduce_shape
///
/// `s` without axis `ax`.
pub lam reduce_shape {r: Nat} (ax: Idx r, s: «r; Nat»): «r - 1; Nat» =
    ‹i: r - 1; s#(core.idx 0 r (shift_ax (core.idx2nat ax, core.idx2nat i)))›;
///
/// ### reduce
///
/// Folds `input` along axis `ax` with `g`, seeded with `init`; the result drops that axis.
/// The output axes run as the leading loops, `ax` as the trailing reduction loop.
pub lam reduce {T: *} (g: [T, T] → T, init: T) {r: Nat} (ax: Idx r) {s: «r; Nat»} (input: Tensor r s T): Tensor (r - 1) (reduce_shape (ax, s)) T =
    let a = core.idx2nat ax;
    map_reduce (reduce_shape (ax, s), ‹i: r; let ii = core.idx2nat i; s#(core.idx 0 r (core.select (ii < r - 1, shift_ax (a, ii), a)))›)
        (pool_fun g, init)
        (proj_map ‹i: r - 1; core.idx2nat i›)
        (proj_map ‹j: r; let jj = core.idx2nat j; core.select (jj < a, jj, core.select (jj == a, r - 1, jj - 1))›)
        input;
///
/// ### binary_ax
///
/// `binary app (x, y)` where `y` lacks axis `ax` of `x` and is broadcast along it.
pub lam binary_ax {Ti1 Ti2 To: *} (app: [Ti1, Ti2] → To) {r: Nat} (ax: Idx r) {s: «r; Nat»}
                  (x: Tensor r s Ti1, y: Tensor (r - 1) (reduce_shape (ax, s)) Ti2): Tensor r s To =
    fun app_mr (_: To, (u: Ti1, v: Ti2))@tt: To = return (app (u, v));
    let a = core.idx2nat ax;
    map_reduce (s, s) @((Ti1, Ti2), (r, r - 1), (s, reduce_shape (ax, s))) (app_mr, ⊥:To)
        affine.id (affine.id @r, proj_map ‹i: r - 1; shift_ax (a, core.idx2nat i)›) (x, y);
///
/// ### softmax
///
/// Numerically stable softmax along axis `ax`: `exp (x - max) / Σ exp (x - max)`.
pub lam softmax (m: Nat) {pe: «2; Nat»} {r: Nat} (ax: Idx r) {s: «r; Nat»} (input: Tensor r s (math.F pe)): Tensor r s (math.F pe) =
    let F  = math.F pe;
    let mx = reduce (math.extrema.fmax m, math.neg_inf pe) ax input;
    let e  = binary_ax (λ (x y: F): F = math.exp.exp m (math.arith.sub m (x, y))) ax (input, mx);
    binary_ax (math.arith.div m) ax (e, reduce (math.arith.add m, 0:F) ax e);

axm sdpa: [mode: Nat] → {H M S K N: Nat}
    → [scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
       v: Tensor 3 (H, S, N) (math.F32)] → Tensor 3 (H, M, N) (math.F32);

priv anx lam attention_impl (mode: Nat) {H M S K N: Nat}
    (scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
     v: Tensor 3 (H, S, N) (math.F32)): Tensor 3 (H, M, N) (math.F32) =
    let R: Ring = (math.F32, 0:math.F32, math.arith.add mode, math.arith.mul mode);
    let scores = dot_product R @(3, 3) @(1, 1) (2₃, 2₃, 0₃, 0₃)
        @((H, M, K), (H, S, K)) (q, k);
    let scores = unary (λ x: math.F32: math.F32 = math.arith.mul mode (x, scale)) @(3, (H, M, S)) scores;
    let probabilities = softmax mode @math.f32 @3 2₃ @(H, M, S) scores;
    dot_product R @(3, 3) @(1, 1) (2₃, 1₃, 0₃, 0₃)
        @((H, M, S), (H, S, N)) (probabilities, v);

pub anx lam attention_rule (mode: Nat): Rule [
    H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
    k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32)] =
    rule raise (H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
                k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32)):
        attention_impl mode @(H, M, S, K, N) (scale, q, k, v) =>
        sdpa mode @(H, M, S, K, N) (scale, q, k, v);
    raise;

axm raise_attention: compile.Phase;
axm group_attention: compile.Phase;

axm sdpa_masked: [mode: Nat] → {H M S K N: Nat}
    → [scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
       v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)] → Tensor 3 (H, M, N) (math.F32);

priv anx lam attention_masked_impl (mode: Nat) {H M S K N: Nat}
    (scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
     v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)): Tensor 3 (H, M, N) (math.F32) =
    let R: Ring = (math.F32, 0:math.F32, math.arith.add mode, math.arith.mul mode);
    let scores = dot_product R @(3, 3) @(1, 1) (2₃, 2₃, 0₃, 0₃)
        @((H, M, K), (H, S, K)) (q, k);
    let scores = unary (λ x: math.F32: math.F32 = math.arith.mul mode (x, scale)) @(3, (H, M, S)) scores;
    let scores = binary (math.arith.add mode) @(3, (H, M, S)) (scores, mask);
    let probabilities = softmax mode @math.f32 @3 2₃ @(H, M, S) scores;
    dot_product R @(3, 3) @(1, 1) (2₃, 1₃, 0₃, 0₃)
        @((H, M, S), (H, S, N)) (probabilities, v);

pub anx lam attention_masked_rule (mode: Nat): Rule [
    H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
    k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)] =
    rule raise (H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
                k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)):
        attention_masked_impl mode @(H, M, S, K, N) (scale, q, k, v, mask) =>
        sdpa_masked mode @(H, M, S, K, N) (scale, q, k, v, mask);
    raise;
///
/// ### pool2d_in_map
///
/// Windowed input read over the loop vector `(n, c, oh, ow, kh, kw)`:
/// `(n, c, stride#0·oh + dilation#0·kh, stride#1·ow + dilation#1·kw)`.
lam pool2d_in_map (stride dilation: «2; Nat») (o: «6; affine.Index»): «4; affine.Index» =
    let (n, c, oh, ow, kh, kw) = o;
    (n, c,
     affine.op.add (affine.semiop.mul (oh, stride#0_2), affine.semiop.mul (kh, dilation#0_2)),
     affine.op.add (affine.semiop.mul (ow, stride#1_2), affine.semiop.mul (kw, dilation#1_2)));
///
/// ### pool_impl
///
priv anx lam pool_impl {T: *} (g: [T, T] → T, init: T) {n c h w: Nat}
                      (kernel stride dilation padding s_out: «2; Nat»)
                      (input: Tensor 4 (n, c, h, w) T)
                    : Tensor 4 (n, c, s_out#0_2, s_out#1_2) T =
    let s_in     = (n, c, h, w);
    let pad_lohi = (0, 0, padding#0_2, padding#1_2);
    let padded   = pad s_in (0, pad_lohi, pad_lohi) (input, init);
    let s_padded = shape padded;

    // Schedule (frontend, selected from the parameters — see `pool_schedule`).
    materialize (pool_schedule (stride, dilation) (
        mr_tileable @1 @(4, 2)
            ((n, c, s_out#0_2, s_out#1_2), (0, 1, 2, 3), (n, c, s_out#0_2, s_out#1_2, kernel#0_2, kernel#1_2))
            @(T, 4, s_padded)
            (pool_fun g, init, id @T)
            (proj_map @(6, 4) (0, 1, 2, 3))
            (pool2d_in_map (stride, dilation),)
            padded));
///
/// ### repeat_map
///
/// `o ↦ (o#d mod s_in#d)_d`: the wrap-around (tiling) read map.
lam repeat_map {r: Nat} (s_in: «r; Nat») (o: «r; affine.Index»): «r; affine.Index» =
    ‹d: r; affine.semiop.rem (o#d, s_in#d)›;
///
/// ### repeat_impl
///
priv anx lam repeat_impl {T: *, r: Nat} (s_in: «r; Nat») (s_out: «r; Nat») (input: Tensor r s_in T): Tensor r s_out T =
    map_reduce (s_out, s_out) (tensor_copy, ⊥:T)
        affine.id (repeat_map s_in,) input;
///
/// ### reshape_map
///
/// `o ↦ delinearize(linearize(o, s_out), s_in)`: the row-major output→input index map.
anx lam reshape_map {r_in r_out: Nat} (s_in: «r_in; Nat», s_out: «r_out; Nat»)
                (o: «r_out; affine.Index»): «r_in; affine.Index» =
    affine.delinearize (affine.linearize (o, s_out), s_in);
///
/// ### reshape_impl
///
priv anx lam reshape_impl {T: *, r_in r_out: Nat}
                         (s_in: «r_in; Nat») (s_out: «r_out; Nat») (input: Tensor r_in s_in T): Tensor r_out s_out T =
    map_reduce (s_out, s_out) (tensor_copy, ⊥:T)
        affine.id (reshape_map (s_in, s_out),) input;
///
/// ### conv_fun
///
/// Fused multiply-add over the ring `R`; `x` is the padded-input element, `w` the weight.
fun conv_fun (R: Ring) (acc: R#T, (x w: R#T))@tt: R#T = return (R#add (acc, R#mul (x, w)));
///
/// ### conv2d_in_map
///
/// The `«7; affine.Index»` loop vector is `o = (n, co, oh, ow, ci, kh, kw)`, so the weight read map
/// `(co, ci, kh, kw)` and the output write map `(n, co, oh, ow)` are `proj_map` projections of it;
/// only this padded-input read needs arithmetic:
/// `(n, ci, stride#0·oh + dilation#0·kh, stride#1·ow + dilation#1·kw)`.
lam conv2d_in_map (stride dilation: «2; Nat») (o: «7; affine.Index»): «4; affine.Index» =
    let (n, _, oh, ow, ci, kh, kw) = o;
    (n, ci,
     affine.op.add (affine.semiop.mul (oh, stride#0_2), affine.semiop.mul (kh, dilation#0_2)),
     affine.op.add (affine.semiop.mul (ow, stride#1_2), affine.semiop.mul (kw, dilation#1_2)));
///
/// ### conv_impl
///
priv anx lam conv_impl (R: Ring) {n cin cout h w kh kw: Nat}
                      (stride dilation padding: «2; Nat»)
                      (input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, cin, kh, kw) (R#T))
                    : Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T) =
    // Zero-pad only the spatial axes (lo = hi = (0, 0, pad_h, pad_w)); the pad value is the ring zero.
    let s_in     = (n, cin, h, w);
    let pad_lohi = (0, 0, padding#0_2, padding#1_2);
    let padded   = pad s_in (0, pad_lohi, pad_lohi) (input, R#_0);
    let s_padded = shape padded;
    let s_out    = conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding);
    let (_, _, oh, ow) = s_out;

    // The SCHEDULE, selected in the frontend from the parameters (see `conv_schedule`): unroll the
    // kh·kw window into the loop body (constant tap offsets) when it fits the budget, and run `ow`
    // as the innermost, unit-stride loop — for a fixed tap, adjacent output pixels read adjacent
    // input pixels, so the vectorizer emits contiguous vector loads instead of gathers. The
    // schedule may strip-mine `oh` (row blocking), packing the materialized tensor along that axis;
    // the row-major `reshape` restores `s_out` (an identity for the neutral split, and absorbed into
    // the consumers' access maps by `fuse_tensor`'s read-through in a fused graph).
    let sched = conv_schedule (stride, dilation) (
        mr_tileable @2 @(4, 3)
            ((n, cout, oh, ow), (0, 1, 2, 3), (n, cout, oh, ow, cin, kh, kw))
            @((R#T, R#T), (4, 4), (s_padded, (cout, cin, kh, kw)))
            (conv_fun R, R#_0, id @(R#T))
            (proj_map @(7, 4) (0, 1, 2, 3))
            (conv2d_in_map (stride, dilation), proj_map @(7, 4) (1, 4, 5, 6))
            (padded, weight));
    // `sched#3_8` is the scheduled Tileable's (possibly packed) output shape `So`.
    reshape (sched#3_8) s_out (materialize sched);
///
/// ### conv_grouped_in_map
///
/// The loop vector is `o = (b, co, oh, ow, ci, kh, kw)` with `b = n·groups + g`: group `g` reads input channel `g·ci + ci`.
lam conv_grouped_in_map (groups ci: Nat, stride dilation: «2; Nat») (o: «7; affine.Index»): «4; affine.Index» =
    let (_, _, ih, iw) = conv2d_in_map (stride, dilation) o;
    (affine.semiop.floordiv (o#0_7, groups),
     affine.op.add (affine.semiop.mul (affine.semiop.rem (o#0_7, groups), ci), o#4_7),
     ih, iw);
///
/// ### conv_grouped_w_map
///
/// The weight read of `conv_grouped_in_map`'s loop vector: group `g` owns the weight rows `g·co + co`.
lam conv_grouped_w_map (groups co: Nat) (o: «7; affine.Index»): «4; affine.Index» =
    (affine.op.add (affine.semiop.mul (affine.semiop.rem (o#0_7, groups), co), o#1_7), o#4_7, o#5_7, o#6_7);
///
/// ### conv_grouped_impl
///
/// Each (batch, group) pair is an independent dense convolution, so folding the group into the batch dim lets the
/// group-free `conv_schedule` apply unchanged: the group arithmetic stays in the outermost loop.
/// The materialized `«n·groups, cout / groups, oh, ow»` is the row-major layout of the NCHW output.

priv anx lam conv_grouped_impl (R: Ring) {n cin cout h w ci kh kw: Nat}
                              (groups: Nat, stride dilation padding: «2; Nat»)
                              (input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, ci, kh, kw) (R#T))
                            : Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T) =
    let ci_g     = refly.check (ci * groups == cin, ci, "conv_grouped: weight must hold cin / groups input channels");
    let co       = check_div (cout, groups) / groups;
    let s_in     = (n, cin, h, w);
    let pad_lohi = (0, 0, padding#0_2, padding#1_2);
    let padded   = pad s_in (0, pad_lohi, pad_lohi) (input, R#_0);
    let s_padded = shape padded;
    let s_out    = conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding);
    let oh       = s_out#2_4;
    let ow       = s_out#3_4;
    let b        = n * groups;
    let sched = conv_schedule (stride, dilation) (
        mr_tileable @2 @(4, 3)
            ((b, co, oh, ow), (0, 1, 2, 3), (b, co, oh, ow, ci, kh, kw))
            @((R#T, R#T), (4, 4), (s_padded, (cout, ci, kh, kw)))
            (conv_fun R, R#_0, id @(R#T))
            (proj_map @(7, 4) (0, 1, 2, 3))
            (conv_grouped_in_map (groups, ci_g, stride, dilation), conv_grouped_w_map (groups, co))
            (padded, weight));
    reshape (sched#3_8) s_out (materialize sched);
///
/// ### dot_general_fun
///
/// The fold step: a fused multiply-add in the ring `R`.
pub fun dot_general_fun (R: Ring) (x: R#T, (y z: R#T))@tt: R#T = return (R#add (x, (R#mul (y, z))));
///
/// ### dot_general_pick
///
/// Sends input axis `i` to the loop id it reads — batching dims first, then the contractions, then
/// the remaining free axes.
pub lam dot_general_pick {n: Nat} {na nb nc: Nat} (a: «na; Idx n», b: «nb; Idx n», c: «nc; Idx n») (off_1 off_2: Nat) (i: Idx n): Nat =
    match vec.first core.icmp.e (b, i) with
        | Some bi => core.idx2nat bi
        | None    => match vec.first core.icmp.e (c, i) with
            | Some ci => off_2 + core.idx2nat ci
            | None    => match vec.first core.icmp.e (a, i) with
                | Some ai => off_1 + core.idx2nat ai
                | None    => 0;
///
/// ### dot_product_impl
///
/// `r1`/`r2` are an *explicit* group here, unlike in the `dot_product` axiom: they must be literals
/// already when this `lam` is β-reduced, since the subscript rows are built with `vec.diff`/`vec.first`,
/// whose normalizers decline to fold over a non-literal rank, and nothing re-normalizes the body once a
/// Hole is resolved later.
/// `{s1 s2}` has no such problem and stays implicit.
///
/// `tensor::Lower` re-applies the axiom's groups positionally, so the two curry shapes still match —
/// except for the leading `fastest_2`, which has no axiom counterpart: it is `fastest_axis` of the
/// right operand, pre-applied by `Lower` where that operand is concrete.
/// The schedule **decision** built on it lives in the body:
///
/// - a contracted fastest axis (\f$x \cdot W^T\f$, e.g. behind a weight transpose the read-through absorbs) selects
///   `dot_schedule_kvec`, anything else `dot_schedule`;
/// - the selected schedule may strip-mine an output dim (row/output-cell blocking), packing the
///   materialized tensor along that axis, whereupon the row-major `reshape` restores `s_out` — the
///   identity for the neutral split, and absorbed into the consumers' access maps by `fuse_tensor`'s
///   read-through in a fused graph.
///
axm blis_candidate: {T: *} → T → Bool, normalize_blis_candidate;

priv anx lam dot_product_impl
    (fastest_2: Nat)
    (R: Ring) (r1 r2: Nat) {nc nb: Nat}
    (c1: «nc; Idx r1», c2: «nc; Idx r2», b1: «nb; Idx r1», b2: «nb; Idx r2»)
    {s1: «r1; Nat», s2: «r2; Nat»} (a: Tensor r1 s1 (R#T), b: Tensor r2 s2 (R#T))
    : let s_out = dot_general_shape (c1, c2, b1, b2) (s1, s2);
      Tensor (vec.len s_out) s_out (R#T)
    = let s_out    = dot_general_shape (c1, c2, b1, b2) (s1, s2);
      let bc_1     = vec.cat (b1, c1);
      let s1_res   = vec.diff (s1, bc_1);
      let n_s1_res = vec.len s1_res;
      let bc_2     = vec.cat (b2, c2);
      let f        = dot_general_fun R;
      let r_out    = vec.len s_out;
      let a1       = vec.diff (‹i: r1; i›, bc_1);
      let a2       = vec.diff (‹i: r2; i›, bc_2);
      let subs_1   = ‹i: r1; dot_general_pick (a1, b1, c1) (nb, r_out) i›;
      let subs_2   = ‹i: r2; dot_general_pick (a2, b2, c2) (nb + n_s1_res, r_out) i›;
      // The subscript rows use consecutive loop ids: 0 … r_out−1 are the output loops
      // and r_out … r_out+nc−1 the contractions, whose bounds are the contracting extents of `a`.
      let s_red    = ‹i: nc; refly.check (s1#(c1#i) == s2#(c2#i), s1#(c1#i), "contracting dims don't match")›;
      let s_full   = vec.cat (s_out, s_red);
      let n_loops  = r_out + nc;
      let t        = mr_tileable @2 @(r_out, nc)
                         (s_out, ‹i: r_out; core.idx2nat i›, s_full)
                         @((R#T, R#T), (r1, r2), (s1, s2))
                         (f, R#_0, id @(R#T))
                         (proj_map @(n_loops, r_out) ‹i: r_out; core.idx2nat i›)
                         (proj_map @(n_loops, r1) subs_1, proj_map @(n_loops, r2) subs_2)
                         (a, b);
      // Schedule (frontend, selected from the parameters — see `dot_schedule`/`dot_schedule_kvec`):
      // vectorize the contraction iff it is the right operand's effective fastest axis (x·Wᵀ);
      // otherwise the last output dim is unit-stride in that operand (A·B) and runs as the vector
      // loop. Dispatched as an extract over thunks, each materializing its own concretely-scheduled
      // Tileable: behind a stuck extract the record's `Out` field would not reduce, so the
      // reshape's input could not be checked. `sched#3_8` is the scheduled Tileable's (possibly
      // packed) output shape `So`.
      let kvec = option.is_some (vec.first `== (‹i: nc; core.idx2nat (c2#i)›, fastest_2));
      lam go_n    (u: []): Tensor (vec.len s_out) s_out (R#T) =
          let sched = dot_schedule r_out t;
          reshape (sched#3_8) s_out (materialize sched);
      lam go_kvec (u: []): Tensor (vec.len s_out) s_out (R#T) =
          let sched = dot_schedule_kvec r_out t;
          reshape (sched#3_8) s_out (materialize sched);
      let canonical = materialize t;
      let blis = blis_candidate canonical;
      (λ (): Tensor (vec.len s_out) s_out (R#T) = (go_n, go_kvec)#kvec (),
       λ (): Tensor (vec.len s_out) s_out (R#T) = canonical)#(if_static (core.idx2nat blis, blis, ff)) ();
///
/// ### bmm_impl
///
/// `dot_product_impl` with literal ranks `(3, 3)`, batching axis 0 and contraction `k`.
priv anx lam bmm_impl (fastest_2: Nat) (R: Ring) {B M K N: Nat} (t1: Tensor 3 (B, M, K) (R#T), t2: Tensor 3 (B, K, N) (R#T)): Tensor 3 (B, M, N) (R#T)
        = dot_product_impl fastest_2 R (3, 3) (2_3, 1_3, 0_3, 0_3) (t1, t2);
///
/// ### product_2d_impl
///
/// `dot_product_impl` with literal ranks `(2, 2)` and the contraction `k`; see there for why the ranks are an explicit group.
priv anx lam product_2d_impl (fastest_2: Nat) (R: Ring) {m k l: Nat} (t1: Tensor 2 (m, k) (R#T), t2: Tensor 2 (k, l) (R#T)): Tensor 2 (m, l) (R#T)
        = dot_product_impl fastest_2 R (2, 2) (1_2, 0_2, (), ()) (t1, t2);
///
/// ### scatter_step_impl
///
/// One update: reads `index` and `updates` at the visited coordinate and inserts the element into the
/// accumulated tensor at the destination it selects.
priv anx lam scatter_step_impl {T: *, r: Nat}
                          (s_src: «r; Nat», s_idx: «r; Nat», s_updates: «r; Nat»)
                          (dim: Idx r)
                          (visit_indices: «r; I64»)
                          (acc: Tensor r s_src T, index: Tensor r s_idx (Idx (s_src#dim)), updates: Tensor r s_updates T): Tensor r s_src T =
    let index_coords = ‹d: r; core.conv.u (s_idx#d) (visit_indices#d)›;
    let update_coords = ‹d: r; core.conv.u (s_updates#d) (visit_indices#d)›;
    let destination_axis_index = core.bitcast I64 (get (index, index_coords));
    let update = get (updates, update_coords);
    let destination_coords = ‹d: r;
        let coordinate = core.select (core.icmp.e @r (d, dim), destination_axis_index, visit_indices#d);
        core.conv.u (s_src#d) coordinate›;
    set (acc, destination_coords, update);
///
/// ### slice_map
///
/// `o ↦ (start#d + step#d · o#d)_d`: the strided read map.
anx lam slice_map {r: Nat} (start step: «r; Nat») (o: «r; affine.Index»): «r; affine.Index» =
    ‹d: r; affine.op.add (affine.semiop.mul (o#d, step#d), affine.lit (start#d))›;

priv anx lam tile_shift {n m: Nat} (f: «n; affine.Index» → «m; affine.Index»)
                       (lo: «n; Nat», origin: «m; Nat») (o: «n; affine.Index»): «m; affine.Index» =
    let y = f ‹d: n; affine.op.add (o#d, affine.lit (lo#d))›;
    ‹d: m; affine.op.sub (y#d, affine.lit (origin#d))›;

priv anx lam tile_sched (s: SchedT): Sched = s Sched (λ (record: Sched): Sched = record);

axm tile_of: {T: *, r: Nat} → {s: «r; Nat»}
           → [producer: Tensor r s T, off ext: «r; Nat»] → Tensor r ext T, normalize_tile_of;

anx lam tile_of_ref {T: *, r: Nat} {s: «r; Nat»}
                   (producer: Tensor r s T, off ext: «r; Nat»): Tensor r ext T =
    slice @(T, r) s (off, ‹r; 1›, ext) producer;

axm slice_box: {T: *, r: Nat} → [s: «r; Nat»]
             → [off ext cap: «r; Nat»] → Tensor r s T → Tensor r ext T, normalize_slice_box;

axm tile_of_box: {T: *, r: Nat} → {s: «r; Nat»}
               → [producer: Tensor r s T, off ext cap: «r; Nat»] → Tensor r ext T, normalize_tile_of_box;

priv anx lam slice_box_impl {T: *, r: Nat} (s: «r; Nat»)
                           (off ext cap: «r; Nat») (p: Tensor r s T): Tensor r ext T =
    slice @(T, r) s (off, ‹r; 1›, ext) p;

priv anx lam tile_of_box_ref {T: *, r: Nat} {s: «r; Nat»}
                            (p: Tensor r s T, off ext cap: «r; Nat»): Tensor r ext T =
    tile_of_ref @(T, r) @s (p, off, ext);
///
/// ### Reduction tiles
///
/// The output tile `(off, ext)` of a `map_reduce_post` `producer` also reads as
/// `tile_of_post (…, fold (tile_of_partial (…, loop, k0, k, ·)) (tile_of_init (…)))`
/// over consecutive chunks `[k0, k0 + k)` of reduction loop `loop`, folded in their original order.
/// `T` is the producer's accumulator type and `U` its element type.
/// `tile_legal` holds when `tile_of` computes the tile itself instead of slicing the whole producer.
///
axm tile_legal: {T: *, r: Nat} → {s: «r; Nat»}
              → [producer: Tensor r s T, off ext: «r; Nat»] → Bool, normalize_tile_legal;
axm tile_of_init: {T U: *, r: Nat} → {s: «r; Nat»}
                → [producer: Tensor r s U, off ext: «r; Nat»] → Tensor r ext T, normalize_tile_of_init;
axm tile_of_partial: {T U: *, r: Nat} → {s: «r; Nat»}
                   → [producer: Tensor r s U, off ext: «r; Nat», loop k0 k: Nat, acc: Tensor r ext T]
                   → Tensor r ext T, normalize_tile_of_partial;
axm tile_of_post: {T U: *, r: Nat} → {s: «r; Nat»}
                → [producer: Tensor r s U, off ext: «r; Nat», acc: Tensor r ext T] → Tensor r ext U,
                  normalize_tile_of_post;

priv anx lam post_tile {To Tp: *, ro nps: Nat, Tps: «nps; *», Rps: «nps; Nat», Sps: «j: nps; «Rps#j; Nat»»}
    (off ext: «ro; Nat», post: Fn [To, «j: nps; Tps#j»] → Tp,
     post_maps: «j: nps; «ro; affine.Index» → «Rps#j; affine.Index»»,
     post_is: «j: nps; Tensor (Rps#j) (Sps#j) (Tps#j)»)
    (acc: Tensor ro ext To): Tensor ro ext Tp =
    map_reduce_post @(1, nps) @(To, Tp, ro, ro, SchedT) (ext, ext, mk_sched (ro, 0))
        @(To, ro, ext, Tps, Rps, Sps)
        (tensor_copy @To, ⊥:To, post) (affine.id @ro)
        (affine.id @ro, ‹j: nps; tile_shift @(ro, Rps#j) (post_maps#j) (off, ‹Rps#j; 0›)›) (acc, post_is);
///
/// ### slice_impl
///
priv anx lam slice_impl {T: *, r: Nat} (s_in: «r; Nat»)
                       (start step s_out: «r; Nat») (input: Tensor r s_in T): Tensor r s_out T =
    map_reduce (s_out, s_out) (tensor_copy, ⊥:T)
        affine.id (slice_map (start, step),) input;
///
/// ### transpose_map
///
/// `o ↦ (o#(perm#0), …, o#(perm#(r−1)))`: input axis `j` reads output-loop var `o#(perm#j)`.
lam transpose_map {r: Nat} (perm: «r; Idx r») (o: «r; affine.Index»): «r; affine.Index» = ‹j: r; o#(perm#j)›;
///
/// ### transpose_impl
///
priv anx lam transpose_impl {T: *, r: Nat}
                           (permutation: «r; Idx r») {s: «r; Nat»} (input: Tensor r s T)
                         : Tensor r (transpose_shape (s, permutation)) T
                         = let out_s = transpose_shape (s, permutation);
                           map_reduce (out_s, out_s) (tensor_copy, ⊥:T)
                               affine.id (transpose_map permutation,) input;
///
/// ### binary_impl
///
/// `map_impl` over two tensors.
priv anx lam binary_impl {Ti1 Ti2 To: *} (app: [Ti1, Ti2] → To) {r: Nat, s: «r; Nat»} (is: [Tensor r s Ti1, Tensor r s Ti2]): Tensor r s To =
    map_impl app is;
///
/// ### select_impl
///
/// `map_impl` of `core.select` over three tensors.
priv anx lam select_impl {T: *} {r: Nat, s: «r; Nat»} (is: [Tensor r s Bool, Tensor r s T, Tensor r s T]): Tensor r s T =
    map_impl core.select is;
///
/// ### unary_impl
///
/// `map_impl` over one tensor.
priv anx lam unary_impl {Ti To: *} (app: Ti → To) {r: Nat, s: «r; Nat»} (i: Tensor r s Ti): Tensor r s To =
    map_impl app i;
///
/// ## Phases
///
/// ### reassoc
///
/// Reassociates chains of `product_2d` with the classic matrix-chain-order dynamic program — but
/// minimizing vector-lane slots instead of scalar multiplications.
///
/// - The vector loop runs over a product's trailing extent (`dot_schedule`) or, for a transposed
///   operand, over its contraction (`dot_schedule_kvec`), and a literal extent is charged rounded up
///   to whole lanes of `vec_width` (`-X tensor:vec-width=<n>`).
///   A bracketing whose intermediates are too narrow to fill a vector thus pays for the lanes it
///   leaves idle, which is exactly what the multiplication count misses.
/// - Extents need not be literal: a cost is a polynomial in the symbolic extents, ordered by
///   coefficient-wise `≤`, which proves `≤` for every instantiation because extents are non-negative.
/// - That order is only *partial*, so a chain can have several bracketings that each win for some
///   instantiation — a batch dimension favouring a different one when small than when large.
///   Up to 4 matrices — `-X tensor:reassoc-max=<n>`, below `3` to switch it off — those survivors are
///   emitted side by side behind a run-time comparison of their costs, so only the winner's thunk
///   runs; a longer chain is only reassociated where one bracketing provably wins for every extent.
/// - Common sub-products are hash-consed across the alternatives, so the code growth stays well below
///   \f$\mathit{Catalan}(n-1)\f$.
/// - A product with more than one consumer stays a chain boundary, as pulling it apart would leave it
///   materialized for its other consumers as well.
/// - A transposed product is part of the chain, as `(A · B)ᵀ = Bᵀ · Aᵀ`; so `Q · Kᵀ` with `Q = x · wq` and
///   `K = x · wk` is the chain `x · wq · wkᵀ · xᵀ`.
/// - Reassociation is only exact for an associative ring; on floating-point rings it changes the
///   rounding, just like `-ffast-math`.
///
axm reassoc: compile.Phase;
///
/// ### combine_products
///
/// Explicit graph rewrite before `lower_tensor`: combine three `product_2d` calls sharing their
/// left operand and standard Nat or wrapping integer ring into a weight concat, one product,
/// and three slices. Floating-point and user-defined rings are left unchanged.
/// Widths must be positive literals with a representable sum; row and contraction dimensions
/// must agree. One triple per closed external function is rewritten per phase invocation.
/// This phase does not estimate backend profitability and is not in the default pipeline.
///
axm combine_products: compile.Phase;
///
/// ### lower_tensor
///
/// Lowers the derived operations to the core ones by re-applying the matching `_impl` annexes.
///
axm lower_tensor: compile.Phase;
///
/// ### distribute
///
/// Keeps each lane's component of the warp values built by `gpu.lanes`, `tensor.mma_warp` and `warp_keep`: reading the
/// own lane's component is the local value, another lane's a shuffle (`shfl_xor` for `self xor c`, else `shfl_idx`).
///
axm distribute: compile.Phase;
///
/// ### lower_map_reduce
///
/// Lowers the core operations, `generate` included, to their underlying primitives: loops, `extract`,
/// `insert`, packs, ...
///
axm lower_map_reduce: compile.Phase;
///
/// ### fuse_tensor
///
/// Fuses pure producer `map_reduce`s into their consumers' access maps.
///
/// - A producer is only fused where the consumer reads it injectively — its access map uses every
///   loop index, possibly strided/shifted — so fusion never recomputes a producer element; strided
///   reads even skip producer elements entirely.
/// - In the reverse direction, a trailing elementwise map over a reducing `map_reduce` is composed
///   into the producer's `post` epilogue (the GEMM-epilogue pattern), provided the map is its only
///   consumer.
///
axm fuse_tensor: compile.Phase;
axm fuse_views: compile.Phase;
///
/// ### lower_to_mem
///
/// Bufferizes the core operations onto the `buffer` layer: tensor values become `buffer.Buf` handles,
/// `get` / `set` / `generate` / `map_reduce` become `buffer.read` / `buffer.write` / `buffer.alloc`
/// threading `mem.M`.
/// The nominal `Tensor` key identifies tensor values; shape vectors remain ordinary arrays.
/// Tensor types are rewritten throughout function signatures, aggregates and calls while preserving parameter groups and curry structure.
/// Rank must be literal; literal zero extents are unsupported, and only the outermost extent may be a runtime value.
/// `mem.add_mem` (scheduled next in the pipeline) threads the memory; run `buffer.lower_ptr`
/// afterwards to reach `mem.Ptr`.
///
axm lower_to_mem: compile.Phase;
///
/// Staged Rule witness for a static permutation map: consumer box to producer box.
///
axm input_box: {r: Nat}
             → [map: «r; Nat» → «r; Nat», offset extent: «r; Nat»]
             → [«r; Nat», «r; Nat»];
///
/// Staged Rule witness that reads a source transpose's permutation and returns its input box.
///
axm transpose_box: {T: *, r: Nat, s: «r; Nat»}
                 → [producer: Tensor r s T, offset extent: «r; Nat»]
                 → [«r; Nat», «r; Nat»];

axm group_root: {T: *} → T → Bool, normalize_group_root;
///
/// Identity request: `op` supplies source provenance; `kind`, `dim`, and `tile` are literal Nats.
/// Kind 0 tiles parallel axis `dim` by `tile`; `params: Nat` is the producer recomputation budget.
/// Kind 1 requests BLIS with `tile = MR`, `params: «3; Nat» = (NR, KC, NC)`; zero blocks select target defaults.
/// Kind 2 places `params` (one consumer or a slot-ordered tuple) after producer `op` at `dim` with size `tile`.
/// The rule stage removes realized requests and reports residual requests, failing under `tensor:strict=1`.
///
axm group_req: {P C: *} → [op: P, kind dim tile: Nat, params: C] → P;
axm group_rules: compile.Phase;
axm group_default: compile.Phase;
priv axm group_region: {P: *} → [value: P, budget: Nat] → P;
priv axm group_supported: {P C: *} → [op: P, kind dim tile: Nat, params: C] → Bool;
priv axm group_schedule: {P C: *} → [op: P, kind dim tile: Nat, params: C] → P, normalize_group_schedule;
priv axm group_fusion: {P C: *} → [producer: P, reader: C] → Bool;
priv axm group_reverse_supported: {P C A: *}
    → [fields: [op: P, kind dim tile: Nat, params: C], actual: A, slot: Nat] → Bool;
axm group: compile.Phase;
axm report_groups: compile.Phase;
///
/// ### tile_req
///
/// Identity request for multi-level tile-and-fuse of root `op`.
/// `members` are the producers the partition placed in `op`'s group; only they are fused.
/// `levels` lists the levels outermost first as a chain whose type names the scope its levels run in:
/// `TileLevels` for serial code, `GroupLevels` inside a work-group, `ItemLevels` inside a work-item,
/// `WarpLevels` inside a warp, whose 32 work-items compute its tile together, and `WarpgroupLevels` inside a warpgroup
/// of four consecutive warps.
/// Entering a work-group or a work-item continues in the next chain, so a level the scope does not offer,
/// such as a work-item bound reduction outside a work-group, does not type-check.
/// `GroupLevels` and `WarpgroupLevels` are also indexed by the tiles of their work-group and warpgroup, so a `wg_mma`
/// only fits a warpgroup tile of its own `m × n` and ping-pong only a work-group of two warpgroups.
/// `control: FuseQuery → FuseDecision` decides, per candidate, whether to fuse and whether to yield.
/// `report_groups` removes residual requests with a warning, failing under `tensor:strict=1`.
///
/// Every level tiles the root's `n` loops; `sizes#d = 0` leaves loop `d` untiled at that level.
/// `tail` is 0 for one capped body over a runtime tail and 1 for peeling full tiles from the tail.
/// `promote` sets bit `i` to stage input `i` into shared memory: a reduction level stages a panel per block,
/// a work-group level its whole box.
/// `RedItems` splits a reduction over the work-items and merges their partials.
/// `Lanes` splits a work-item's reduction into blocks of `sizes`, each folded by one of as many adjacent lanes, which
/// then merge their partials by warp shuffles; it needs a recognized reassociable law over F32.
/// `Combiner` is accepted only for a recognized reassociable law whose identity is the seed.
/// `Merge` supplies an explicit permission and a merge function whose accumulator type is checked.
/// `Mma` computes a warp's reduction block on tensor cores; `shape` is the instruction's tile of the root's loops and
/// divides the warp's tile and block: `(16, 8, 8)` for a matrix product of F32 inputs, run with TF32 inputs, and
/// `(16, 8, 16)` for one of F16 or BF16 inputs widened into an F32 accumulator, `acc + up x · up y`.
/// `Wgmma` computes a warpgroup's reduction block with one `wgmma` per k step from the work-group's panels; `shape` is
/// `(64, N, 16)` for the warpgroup's whole `64 × N` tile, with F16 or BF16 inputs both K-major (`a · bᵀ`).
/// Promoted inputs of a reduction inside a warp or a warpgroup are staged as panels over the whole work-group's tile.
/// `RedTma` is a warpgroup's `Red` whose panels the work-group's leader fills with TMA, each ring slot completing an mbarrier.
/// `RedWs` specializes the warpgroups: one more warp only fills the ring with TMA, waiting on each slot's "empty" mbarrier,
/// while the warpgroups only compute, waiting on "full" and arriving on "empty", with no work-group barrier per step.
/// With a ring of four or more slots, a step's MMAs stay in flight and release the previous step's slot.
/// With `pingpong` 1 the two computing warpgroups take turns issuing their MMAs.
/// `Cluster` runs the next `Group` level's work-groups in clusters of `size` consecutive tiles; a `RedTma` below loads
/// each input set in `multicast` once per cluster, each work-group a `1 / size` share of its rows multicast to all.
/// With `split` 1 the cluster's work-groups compute the same tile instead, each `1 / size` of a `RedTma` reduction below,
/// and add their accumulators through distributed shared memory.
/// `pipeline` of a reduction inside a work-group is how many blocks' panels are in flight, `n` filling `n - 1` blocks
/// ahead of the one being computed; 0 takes `-X tensor:pipeline`, and the `*_red` constructors leave it 0.
/// The CPU lowering runs bound levels as loops.
/// `Persistent` launches `ctas` work-groups for the next `Group` level, each running its tiles `ctas` apart in turn;
/// a specialized reduction's ring and mbarriers persist across them, so the producer fills the next tile's panels
/// while the consumers store the last one.
///
/// The tensor-core contraction a tile request's root computes into an F32 accumulator, as the type that indexes its
/// level chain: `NoMma`, `Tf32Mma` for F32 operands run as TF32, or `HalfMma` for 16-bit (F16 or BF16) operands
/// widened as `acc + up a · up b`.
/// An MMA level carries a value of that type, so it only type-checks for the operands its instruction takes.
anx nom NoMma = | No;
anx nom Tf32Mma = | Tf32;
anx nom HalfMma = | Half;
///
/// A schedule constraint: `require (cond, value, msg)` is `value` if `cond` holds and a type error reporting `msg` if
/// it does not.
///
axm require: {T: *} → {n: Nat} → [Bool, T, «n; I8»] → T, normalize_require;
///
anx nom TileMerge (Acc: *) = | Combiner | Merge: [Acc, Acc] → Acc;
/// The tiles of the enclosing work-group and warpgroup index their chains; a level that depends on one carries this
/// evidence of it.
axm ScopeTile: {n: Nat} → «n; Nat» → *;
axm scope_tile: {n: Nat} → [tile: «n; Nat»] → ScopeTile tile;
/// A tail is 0 to cap the last tile and 1 to peel it.
lam peeled (tail: Nat): Nat = require (tail <= 1, tail, "a tail is 0 (cap) or 1 (peel)");
/// The extents a level of `sizes` leaves to the next one, a `0` keeping the enclosing extent.
/// It indexes a warp's levels by the warp's tile.
axm within: {n: Nat} → [outer sizes: «n; Nat»] → «n; Nat», normalize_within;
/// Whether `shape` divides `block`, whose `0` extents are not known yet.
lam divides {n: Nat} (shape block: «n; Nat»): Bool =
    vec.fold.r @(Bool, Bool) @n (core.bit2.and 0) (‹d: n; core.bit2.or 0 (block#d == 0, core.nat.rem (block#d, (shape#d, 1)#(shape#d == 0)) == 0)›, tt);
anx mutual
    nom TileLevels (n: Nat, Acc: *, Mma: *) =
        | Done
        | Par: [sizes: «n; Nat», tail: Nat, rest: TileLevels (n, Acc, Mma)]
        | Group: [sizes: «n; Nat», tail promote: Nat, rest: GroupLevels (n, Acc, Mma, sizes)]
        | Red: [sizes: «n; Nat», tail promote: Nat, rest: TileLevels (n, Acc, Mma)]
        | Vec: [sizes: «n; Nat», rest: TileLevels (n, Acc, Mma)]
        | Cluster: [size multicast split: Nat, rest: TileLevels (n, Acc, Mma)]
        | Persistent: [ctas: Nat, rest: TileLevels (n, Acc, Mma)];
    nom GroupLevels (n: Nat, Acc: *, Mma: *, group: «n; Nat») =
        | Done
        | Par: [sizes: «n; Nat», tail: Nat, rest: GroupLevels (n, Acc, Mma, group)]
        | Item: [sizes: «n; Nat», tail: Nat, rest: ItemLevels (n, Acc, Mma)]
        | Red: [sizes: «n; Nat», tail promote pipeline: Nat, rest: GroupLevels (n, Acc, Mma, group)]
        | RedItems: [sizes: «n; Nat», tail: Nat, merge: TileMerge Acc, rest: GroupLevels (n, Acc, Mma, group)]
        | Vec: [sizes: «n; Nat», rest: GroupLevels (n, Acc, Mma, group)]
        | Warp: [sizes: «n; Nat», tail: Nat, rest: WarpLevels (n, Acc, Mma, within (group, sizes))]
        | Warpgroup: [sizes: «n; Nat», tail: Nat, rest: WarpgroupLevels (n, Acc, Mma, group, sizes)];
    nom ItemLevels (n: Nat, Acc: *, Mma: *) =
        | Done
        | Par: [sizes: «n; Nat», tail: Nat, rest: ItemLevels (n, Acc, Mma)]
        | Red: [sizes: «n; Nat», tail promote pipeline: Nat, rest: ItemLevels (n, Acc, Mma)]
        | Vec: [sizes: «n; Nat», rest: ItemLevels (n, Acc, Mma)]
        | Lanes: [sizes: «n; Nat», tail: Nat, rest: ItemLevels (n, Acc, Mma)];
    nom WarpLevels (n: Nat, Acc: *, Mma: *, block: «n; Nat») =
        | Done
        | Red: [sizes: «n; Nat», tail promote pipeline: Nat, rest: WarpLevels (n, Acc, Mma, block)]
        | Mma: [shape: «n; Nat», operands: Mma, block: ScopeTile block];
    nom WarpgroupLevels (n: Nat, Acc: *, Mma: *, group tile: «n; Nat») =
        | Done
        | Red: [sizes: «n; Nat», tail promote pipeline: Nat, rest: WarpgroupLevels (n, Acc, Mma, group, tile)]
        | Wgmma: [shape: «n; Nat», operands: Mma, owned: ScopeTile tile]
        | RedTma: [sizes: «n; Nat», tail promote pipeline: Nat, rest: WarpgroupLevels (n, Acc, Mma, group, tile)]
        | RedWs: [sizes: «n; Nat», tail promote pipeline pingpong: Nat, consumers: ScopeTile group, rest: WarpgroupLevels (n, Acc, Mma, group, tile)];
end
///
/// The constructors as functions, so a chain infers `n` and `Acc` from the request.
///
anx lam serial_done {n: Nat, Acc: *, Mma: *} (_: []): TileLevels (n, Acc, Mma) = (TileLevels (n, Acc, Mma))#Done;
anx lam serial_par {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail: Nat, rest: TileLevels (n, Acc, Mma)): TileLevels (n, Acc, Mma) =
    (TileLevels (n, Acc, Mma))#Par (sizes, peeled tail, rest);
anx lam serial_group {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail promote: Nat, rest: GroupLevels (n, Acc, Mma, sizes)): TileLevels (n, Acc, Mma) =
    (TileLevels (n, Acc, Mma))#Group (sizes, peeled tail, promote, rest);
anx lam serial_red {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail promote: Nat, rest: TileLevels (n, Acc, Mma)): TileLevels (n, Acc, Mma) =
    (TileLevels (n, Acc, Mma))#Red (sizes, peeled tail, promote, rest);
anx lam serial_vec {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», rest: TileLevels (n, Acc, Mma)): TileLevels (n, Acc, Mma) =
    (TileLevels (n, Acc, Mma))#Vec (sizes, require (match rest with | 0 => tt | 1 _ => ff | 2 _ => ff | 3 _ => ff | 4 _ => ff | 5 _ => ff | 6 _ => ff, rest, "a vector level must be the innermost"));
/// A portable cluster runs 2 to 8 work-groups.
lam cluster_size (size: Nat): Bool = core.bit2.and 0 (2 <= size, size <= 8);
anx lam serial_cluster {n: Nat, Acc: *, Mma: *} (size multicast: Nat, rest: TileLevels (n, Acc, Mma)): TileLevels (n, Acc, Mma) =
    (TileLevels (n, Acc, Mma))#Cluster (require (cluster_size size, size, "a cluster has 2 to 8 work-groups"), multicast, 0, rest);
anx lam serial_persistent {n: Nat, Acc: *, Mma: *} (ctas: Nat, rest: TileLevels (n, Acc, Mma)): TileLevels (n, Acc, Mma) =
    let unclustered = match rest with
        | 0 => tt | 1 _ => tt | 2 _ => tt | 3 _ => tt | 4 _ => tt | 5 _ => ff | 6 _ => tt;
    (TileLevels (n, Acc, Mma))#Persistent
        (require (ctas != 0, ctas, "a persistent level launches at least one work-group"),
         require (unclustered, rest, "a persistent level's work-groups do not run in clusters"));
anx lam serial_cluster_split {n: Nat, Acc: *, Mma: *} (size: Nat, rest: TileLevels (n, Acc, Mma)): TileLevels (n, Acc, Mma) =
    (TileLevels (n, Acc, Mma))#Cluster (require (cluster_size size, size, "a cluster has 2 to 8 work-groups"), 0, 1, rest);
anx lam group_done {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (_: []): GroupLevels (n, Acc, Mma, g) = (GroupLevels (n, Acc, Mma, g))#Done;
anx lam group_par {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail: Nat, rest: GroupLevels (n, Acc, Mma, g)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Par (sizes, peeled tail, rest);
anx lam group_item {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail: Nat, rest: ItemLevels (n, Acc, Mma)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Item (sizes, peeled tail, rest);
anx lam group_red {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail promote: Nat, rest: GroupLevels (n, Acc, Mma, g)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Red (sizes, peeled tail, promote, 0, rest);
anx lam group_red_pipelined {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail promote pipeline: Nat, rest: GroupLevels (n, Acc, Mma, g)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Red (sizes, peeled tail, promote, pipeline, rest);
anx lam group_red_items {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail: Nat, rest: GroupLevels (n, Acc, Mma, g)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#RedItems (sizes, peeled tail, (TileMerge Acc)#Combiner, rest);
anx lam group_red_merge {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail: Nat, merge: [Acc, Acc] → Acc, rest: GroupLevels (n, Acc, Mma, g)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#RedItems (sizes, peeled tail, (TileMerge Acc)#Merge merge, rest);
anx lam group_vec {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», rest: GroupLevels (n, Acc, Mma, g)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Vec (sizes, require (match rest with | 0 => tt | 1 _ => ff | 2 _ => ff | 3 _ => ff | 4 _ => ff | 5 _ => ff | 6 _ => ff | 7 _ => ff, rest, "a vector level must be the innermost"));
anx lam group_warp {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail: Nat, rest: WarpLevels (n, Acc, Mma, within (g, sizes))): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Warp (sizes, peeled tail, rest);
anx lam item_done {n: Nat, Acc: *, Mma: *} (_: []): ItemLevels (n, Acc, Mma) = (ItemLevels (n, Acc, Mma))#Done;
anx lam item_par {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail: Nat, rest: ItemLevels (n, Acc, Mma)): ItemLevels (n, Acc, Mma) =
    (ItemLevels (n, Acc, Mma))#Par (sizes, peeled tail, rest);
anx lam item_red {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail promote: Nat, rest: ItemLevels (n, Acc, Mma)): ItemLevels (n, Acc, Mma) =
    (ItemLevels (n, Acc, Mma))#Red (sizes, peeled tail, promote, 0, rest);
anx lam item_red_pipelined {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail promote pipeline: Nat, rest: ItemLevels (n, Acc, Mma)): ItemLevels (n, Acc, Mma) =
    (ItemLevels (n, Acc, Mma))#Red (sizes, peeled tail, promote, pipeline, rest);
anx lam item_vec {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», rest: ItemLevels (n, Acc, Mma)): ItemLevels (n, Acc, Mma) =
    (ItemLevels (n, Acc, Mma))#Vec (sizes, require (match rest with | 0 => tt | 1 _ => ff | 2 _ => ff | 3 _ => ff | 4 _ => ff, rest, "a vector level must be the innermost"));
anx lam item_lanes {n: Nat, Acc: *, Mma: *} (sizes: «n; Nat», tail: Nat, rest: ItemLevels (n, Acc, Mma)): ItemLevels (n, Acc, Mma) =
    (ItemLevels (n, Acc, Mma))#Lanes (sizes, peeled tail, rest);
anx lam warp_done {n: Nat, Acc: *, Mma: *, b: «n; Nat»} (_: []): WarpLevels (n, Acc, Mma, b) = (WarpLevels (n, Acc, Mma, b))#Done;
anx lam warp_red {n: Nat, Acc: *, Mma: *, b: «n; Nat»} (sizes: «n; Nat», tail promote: Nat, rest: WarpLevels (n, Acc, Mma, b)): WarpLevels (n, Acc, Mma, b) =
    (WarpLevels (n, Acc, Mma, b))#Red (sizes, peeled tail, promote, 0, rest);
anx lam warp_red_pipelined {n: Nat, Acc: *, Mma: *, b: «n; Nat»} (sizes: «n; Nat», tail promote pipeline: Nat, rest: WarpLevels (n, Acc, Mma, b)): WarpLevels (n, Acc, Mma, b) =
    (WarpLevels (n, Acc, Mma, b))#Red (sizes, peeled tail, promote, pipeline, rest);
/// The operands a warp's `mma` tile takes: `(16, 8, 8)` runs F32 ones as TF32, `(16, 8, 16)` takes 16-bit ones.
lam warp_mma_kind (shape: «3; Nat»): * =
    let (m, n, k) = shape;
    (HalfMma, Tf32Mma)#(k == 8);
lam warp_mma_shape (shape: «3; Nat»): Bool =
    let (m, n, k) = shape;
    core.bit2.and 0 (core.bit2.and 0 (m == 16, n == 8), core.bit2.or 0 (k == 8, k == 16));
/// The operand kind of a warp's `mma` tile, as a value of the type its shape selects.
axm warp_mma_operands: [shape: «3; Nat»] → warp_mma_kind shape;
/// A contraction root's levels end in an MMA over its three loops `(m, n, k)`.
anx lam warp_mma {Acc: *, b: «3; Nat»} (shape: «3; Nat»): WarpLevels (3, Acc, warp_mma_kind shape, b) =
    (WarpLevels (3, Acc, warp_mma_kind shape, b))#Mma
        (require (core.bit2.and 0 (warp_mma_shape shape, divides (shape, b)), shape,
                  "a warp's mma tile is (16, 8, 8) for F32 operands or (16, 8, 16) for 16-bit ones and divides the warp's tile"),
         warp_mma_operands shape, scope_tile b);
anx lam group_warpgroup {n: Nat, Acc: *, Mma: *, g: «n; Nat»} (sizes: «n; Nat», tail: Nat, rest: WarpgroupLevels (n, Acc, Mma, g, sizes)): GroupLevels (n, Acc, Mma, g) =
    (GroupLevels (n, Acc, Mma, g))#Warpgroup (sizes, peeled tail, rest);
anx lam wg_done {n: Nat, Acc: *, Mma: *, g t: «n; Nat»} (_: []): WarpgroupLevels (n, Acc, Mma, g, t) = (WarpgroupLevels (n, Acc, Mma, g, t))#Done;
anx lam wg_red {n: Nat, Acc: *, Mma: *, g t: «n; Nat»} (sizes: «n; Nat», tail promote: Nat, rest: WarpgroupLevels (n, Acc, Mma, g, t)): WarpgroupLevels (n, Acc, Mma, g, t) =
    (WarpgroupLevels (n, Acc, Mma, g, t))#Red (sizes, peeled tail, promote, 0, rest);
anx lam wg_red_pipelined {n: Nat, Acc: *, Mma: *, g t: «n; Nat»} (sizes: «n; Nat», tail promote pipeline: Nat, rest: WarpgroupLevels (n, Acc, Mma, g, t)): WarpgroupLevels (n, Acc, Mma, g, t) =
    (WarpgroupLevels (n, Acc, Mma, g, t))#Red (sizes, peeled tail, promote, pipeline, rest);
lam wgmma_tile (shape: «3; Nat»): «3; Nat» = let (m, n, k) = shape; (m, n, 0);
/// Whether `(m, n, k)` is the tile of one `wgmma` over 16-bit operands, `(64, 8 j, 16)` with `8 j <= 256`.
lam wgmma_shape (shape: «3; Nat»): Bool =
    let (m, n, k) = shape;
    core.bit2.and 0 (core.bit2.and 0 (m == 64, k == 16),
                     core.bit2.and 0 (core.nat.rem (n, 8) == 0, core.bit2.and 0 (n != 0, n <= 256)));
/// A `wgmma` takes 16-bit operands.
/// Its warpgroup owns the `m × n` tile of one `wgmma`.
anx lam wg_mma {Acc: *, g: «3; Nat»} (shape: «3; Nat»): WarpgroupLevels (3, Acc, HalfMma, g, wgmma_tile shape) =
    (WarpgroupLevels (3, Acc, HalfMma, g, wgmma_tile shape))#Wgmma
        (require (wgmma_shape shape, shape, "a wgmma tile is (64, 8 j, 16) with 8 j <= 256"), HalfMma#Half,
         scope_tile (wgmma_tile shape));
anx lam wg_red_tma {n: Nat, Acc: *, Mma: *, g t: «n; Nat»} (sizes: «n; Nat», tail promote pipeline: Nat, rest: WarpgroupLevels (n, Acc, Mma, g, t)): WarpgroupLevels (n, Acc, Mma, g, t) =
    (WarpgroupLevels (n, Acc, Mma, g, t))#RedTma (sizes, peeled tail, promote, pipeline, rest);
/// How many warpgroups tile a work-group's tile `g`, a `0` in `t` leaving that loop to each of them.
lam warpgroups {n: Nat} (g t: «n; Nat»): Nat =
    vec.fold.r @(Nat, Nat) @n core.nat.mul (‹d: n; (g#d / (t#d, 1)#(t#d == 0), 1)#(t#d == 0)›, 1);
anx lam wg_red_ws {n: Nat, Acc: *, Mma: *, g t: «n; Nat»} (sizes: «n; Nat», tail promote pipeline pingpong: Nat, rest: WarpgroupLevels (n, Acc, Mma, g, t)): WarpgroupLevels (n, Acc, Mma, g, t) =
    (WarpgroupLevels (n, Acc, Mma, g, t))#RedWs (sizes, peeled tail, promote, pipeline,
        require (core.bit2.or 0 (pingpong == 0, core.bit2.and 0 (pingpong == 1, warpgroups (g, t) == 2)), pingpong,
                 "pingpong is 0, or 1 for a work-group of two computing warpgroups"),
        scope_tile g, rest);
anx let FuseQuery = [level kind role: Nat, reduces outside_use in_group: Bool, tile_bytes: Nat];
anx let FuseDecision = [fuse yield: Bool];
/// The loop count and accumulator type of the `map_reduce_post` that computes a tile request's root; they index the
/// request's levels, so a chain over other loops or another accumulator does not type-check.
axm root_loops: {T: *, r: Nat} → {s: «r; Nat»} → Tensor r s T → Nat, normalize_root_loops;
axm root_acc: {T: *, r: Nat} → {s: «r; Nat»} → Tensor r s T → *, normalize_root_acc;
/// The contraction that `map_reduce_post` computes: `Tf32Mma` or `HalfMma` for a matrix product
/// `C (m, n) += A (m, k) · B (k, n)` of F32 or 16-bit inputs into an F32 accumulator (`contraction_type`), `NoMma` otherwise.
axm root_contraction: {T: *, r: Nat} → {s: «r; Nat»} → Tensor r s T → *, normalize_root_contraction;
///
/// ### check
///
/// The legality rules of a tile request's levels that need its root, as a predicate the `tile_req` normalizer reduces by
/// partial evaluation.
/// `levels (op, l)` is 0 for a legal chain, the index into `messages` of the first rule it breaks, or stuck while the chain
/// or the root is not literal; the late checks of `tile_fuse` and `lower_to_mem` then still apply.
/// Each rule unfolds only on a closed chain, so a symbolic one stays a stuck call instead of unfolding.
///
pub mod check
    /// The root's parallel loop count and input count, and the extents of all its loops, 0 for one known only at run time.
    /// A rule takes a block of 0 as unknown and lets it pass; `tile_fuse` checks it once it is literal.
    axm parallel: {T: *, r: Nat} → {s: «r; Nat»} → Tensor r s T → Nat, normalize_check;
    axm inputs: {T: *, r: Nat} → {s: «r; Nat»} → Tensor r s T → Nat, normalize_check;
    axm extents: {T: *, r: Nat} → {s: «r; Nat»} → [op: Tensor r s T] → «root_loops op; Nat», normalize_check;
    /// The target's compute capability `-X nvptx:sm` names, as `2 · cc + a` for an architecture-specific `sm_<cc>a`, or
    /// 0 when none is named and the backend picks the device's later.
    axm target: [] → Nat, normalize_check;

    anx let messages = ("",
        "a parallel level cannot tile a reduction loop",
        "a reduction level cannot tile a parallel loop",
        "a reduction level tiles a single reduction loop",
        "a level promotes input bits {} of {} inputs",
        "a lane reduction splits its block of {} into blocks of {}, not into a power of two of at most 32 lanes",
        "a tensor-core tile does not divide its block",
        "a tensor-core level reads A and B from promoted panels",
        "{} work-groups do not form clusters of {}",
        "{} blocks do not split evenly over a cluster of {}",
        "a specialized reduction does not share panels across a cluster",
        "a TMA reduction in a persistent work-group must be specialized",
        "{} blocks per tile do not fill whole cycles of a persistent ring of {} slots",
        "a bound level cannot peel its tail",
        "a vector level marks a single parallel loop with size 1 or splits the last reduction loop",
        "a specialized reduction needs at least two blocks, not {}",
        "warpgroup ping-pong alternates two consumers, not {}",
        "a warpgroup level runs wgmma, which needs sm_90a, not sm_{}",
        "TMA and clusters need sm_90 or newer, not sm_{}",
        "a warp's mma needs sm_80 or newer, not sm_{}");

    lam any {n: Nat} (p: «n; Bool»): Bool = vec.fold.r @(Bool, Bool) @n (core.bit2.or 0) (p, ff);
    lam count {n: Nat} (p: «n; Bool»): Nat = vec.fold.r @(Nat, Nat) @n core.nat.add (‹d: n; (0, 1)#(p#d)›, 0);
    lam sum {n: Nat} (x: «n; Nat»): Nat = vec.fold.r @(Nat, Nat) @n core.nat.add (x, 0);
    lam both (xy: «2; Bool»): Bool = core.bit2.and 0 xy;
    lam either (xy: «2; Bool»): Bool = core.bit2.or 0 xy;
    lam positive (x: Nat): Nat = (x, 1)#(x == 0);
    /// A verdict is the index of the broken rule into `messages`, 0 if none, and up to two values the message reports.
    let Verdict = «3; Nat»;
    let ok      = (0, 0, 0);
    lam or_else (verdict next: Verdict): Verdict = (verdict, next)#(verdict#0₃ == 0);
    lam fail_with (broken: Bool, code x y: Nat): Verdict = (ok, (code, x, y))#broken;
    lam fail (broken: Bool, code: Nat): Verdict = fail_with (broken, code, 0, 0);
    lam stages (staged: Bool, promote bit: Nat): Bool = either (staged, core.nat.rem (promote / bit, 2) == 1);
    /// The extent of the one reduction loop a level tiles and its block size.
    lam reduced {n: Nat} (block sizes: «n; Nat»): «2; Nat» = (sum ‹d: n; (0, block#d)#(sizes#d != 0)›, positive (sum sizes));

    lam parallel_sizes {n: Nat} (ro: Nat, sizes: «n; Nat»): Verdict =
        fail (any ‹d: n; both (sizes#d != 0, ro <= core.idx2nat d)›, 1);
    lam reduction_sizes {n: Nat} (ro: Nat, sizes: «n; Nat»): Verdict =
        or_else (fail (any ‹d: n; both (sizes#d != 0, core.idx2nat d < ro)›, 2), fail (1 < count ‹d: n; sizes#d != 0›, 3));
    lam promotes (nis promote: Nat): Verdict = fail_with (vec.fold.r @(Nat, Nat) @nis core.nat.mul (‹nis; 2›, 1) <= promote, 4, promote, nis);
    lam lanes {n: Nat} (block sizes: «n; Nat»): Verdict =
        let (k, s) = reduced (block, sizes);
        let count  = k / s;
        fail_with (both (k != 0, either (core.nat.rem (k, s) != 0, (tt, ff)#(any ‹i: 6; count == (1, 2, 4, 8, 16, 32)#i›))), 5, k, s);
    lam mma {n: Nat} (shape block: «n; Nat», a b: Bool): Verdict =
        or_else (fail ((tt, ff)#(divides (shape, block)), 6), fail ((tt, ff)#(both (a, b)), 7));
    lam clusters {n: Nat} (cluster split: Nat, block sizes: «n; Nat»): Verdict =
        let groups = vec.fold.r @(Nat, Nat) @n core.nat.mul
            (‹d: n; (1, (block#d + positive (sizes#d) - 1) / positive (sizes#d))#(sizes#d != 0)›, 1);
        fail_with (both (both (cluster != 0, split == 0), core.nat.rem (groups, positive cluster) != 0), 8, groups, cluster);
    lam splits {n: Nat} (cluster split: Nat, block sizes: «n; Nat»): Verdict =
        let (k, s) = reduced (block, sizes);
        fail_with (both (split != 0, either (core.nat.rem (k, s) != 0, core.nat.rem (k / s, positive cluster) != 0)), 9, k / s, cluster);
    lam ring {n: Nat} (persistent: Bool, pipeline: Nat, block sizes: «n; Nat»): Verdict =
        let (k, s) = reduced (block, sizes);
        fail_with (both (both (persistent, pipeline != 0), core.nat.rem (k / s, positive pipeline) != 0), 12, k / s, pipeline);
    /// A level's block as its loops' extents cap it, an unknown extent of 0 leaving the level's size.
    lam clip {n: Nat} (os: «2; «n; Nat»»): «n; Nat» =
        let (outer, sizes) = os;
        ‹d: n; (outer#d, core.select (core.bit2.and 0 (outer#d != 0, outer#d < sizes#d), outer#d, sizes#d))#(sizes#d != 0)›;
    /// How many warpgroups tile a work-group's block `g` by `t`, 0 while an extent is unknown.
    lam consumers {n: Nat} (gt: «2; «n; Nat»»): Nat =
        let (g, t) = gt;
        let known  = vec.fold.r @(Bool, Bool) @n (core.bit2.and 0) (‹d: n; core.bit2.or 0 (t#d == 0, g#d != 0)›, tt);
        core.select (known, vec.fold.r @(Nat, Nat) @n core.nat.mul
            (‹d: n; (1, (g#d + positive (t#d) - 1) / positive (t#d))#(t#d != 0)›, 1), 0);
    /// Whether a named target lacks capability `cc`, or its architecture-specific instructions when `specific`.
    lam lacks (cc: Nat) (specific: Bool): Bool =
        let t = target ();
        both (t != 0, either (t / 2 < cc, both (specific, either (t / 2 != cc, t % 2 == 0))));
    lam needs (cc: Nat) (specific: Bool) (code: Nat): Verdict = fail_with (lacks cc specific, code, target () / 2, 0);
    lam specialized {n: Nat} (block sizes: «n; Nat»): Verdict =
        let (k, s) = reduced (block, sizes);
        fail_with (both (k != 0, k / s < 2), 15, k / s, 0);
    lam peels {n: Nat} (tail: Nat, block sizes: «n; Nat»): Verdict =
        fail (both (tail == 1, any ‹d: n; both (both (sizes#d != 0, sizes#d < block#d),
                                                 core.nat.rem (block#d, positive (sizes#d)) != 0)›), 13);
    lam vector {n: Nat} (ro: Nat, sizes: «n; Nat»): Verdict =
        let last = core.nat.sub (n, 1);
        fail (either (any ‹d: n; both (both (sizes#d != 0, ro <= core.idx2nat d), core.idx2nat d != last)›,
                      either (any ‹d: n; both (both (sizes#d != 0, core.idx2nat d < ro), sizes#d != 1)›,
                              1 < count ‹d: n; both (sizes#d != 0, core.idx2nat d < ro)›)), 14);

    lam wg_ok {n: Nat, Acc Mma: *, g t: «n; Nat»}
        (ro nis: Nat, block: «n; Nat», a b: Bool, cluster split: Nat, persistent: Bool, warpgroups: Nat,
         l: WarpgroupLevels (n, Acc, Mma, g, t))@(core.pe.is_closed l): Verdict =
        match l with
            | 0 => ok
            | 1 (sizes, _, promote, _, rest) =>
                or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote),
                    wg_ok (ro, nis, within (block, sizes), stages (a, promote, 1), stages (b, promote, 2), cluster, split,
                           persistent, warpgroups, rest)))
            | 2 (shape, _, _) => mma (shape, block, a, b)
            | 3 (sizes, _, promote, _, rest) =>
                or_else (needs 90 ff 18, or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote), or_else (fail (persistent, 11),
                or_else (splits (cluster, split, block, sizes),
                    wg_ok (ro, nis, within (block, sizes), stages (a, promote, 1), stages (b, promote, 2), cluster, split,
                           persistent, warpgroups, rest))))))
            | 4 (sizes, _, promote, pipeline, pingpong, _, rest) =>
                or_else (fail_with (both (both (pingpong == 1, warpgroups != 0), warpgroups != 2), 16, warpgroups, 0),
                or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote), or_else (fail (cluster != 0, 10),
                or_else (specialized (block, sizes), or_else (ring (persistent, pipeline, block, sizes),
                    wg_ok (ro, nis, within (block, sizes), stages (a, promote, 1), stages (b, promote, 2), cluster, split,
                           persistent, warpgroups, rest)))))));
    lam warp_ok {n: Nat, Acc Mma: *, w: «n; Nat»} (ro nis: Nat, block: «n; Nat», a b: Bool, l: WarpLevels (n, Acc, Mma, w))@(core.pe.is_closed l): Verdict =
        match l with
            | 0 => ok
            | 1 (sizes, _, promote, _, rest) =>
                or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote),
                    warp_ok (ro, nis, within (block, sizes), stages (a, promote, 1), stages (b, promote, 2), rest)))
            | 2 (shape, _, _) => or_else (needs 80 ff 19, mma (shape, block, a, b));
    lam item_ok {n: Nat, Acc Mma: *} (ro nis: Nat, block: «n; Nat», a b: Bool, l: ItemLevels (n, Acc, Mma))@(core.pe.is_closed l): Verdict =
        match l with
            | 0 => ok
            | 1 (sizes, _, rest) => or_else (parallel_sizes (ro, sizes), item_ok (ro, nis, within (block, sizes), a, b, rest))
            | 2 (sizes, _, promote, _, rest) =>
                or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote),
                    item_ok (ro, nis, within (block, sizes), stages (a, promote, 1), stages (b, promote, 2), rest)))
            | 3 (sizes, rest) => or_else (vector (ro, sizes), item_ok (ro, nis, block, a, b, rest))
            | 4 (sizes, _, rest) =>
                or_else (reduction_sizes (ro, sizes), or_else (lanes (block, sizes),
                    item_ok (ro, nis, within (block, sizes), a, b, rest)));
    lam group_ok {n: Nat, Acc Mma: *, g: «n; Nat»}
        (ro nis: Nat, block: «n; Nat», a b: Bool, cluster split: Nat, persistent: Bool, l: GroupLevels (n, Acc, Mma, g))@(core.pe.is_closed l): Verdict =
        match l with
            | 0 => ok
            | 1 (sizes, _, rest) =>
                or_else (parallel_sizes (ro, sizes),
                         group_ok (ro, nis, within (block, sizes), a, b, cluster, split, persistent, rest))
            | 2 (sizes, tail, rest) =>
                or_else (parallel_sizes (ro, sizes), or_else (peels (tail, block, sizes),
                    item_ok (ro, nis, within (block, sizes), a, b, rest)))
            | 3 (sizes, _, promote, _, rest) =>
                or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote),
                    group_ok (ro, nis, clip (block, sizes), stages (a, promote, 1), stages (b, promote, 2), cluster,
                              split, persistent, rest)))
            | 4 (sizes, _, _, rest) =>
                or_else (reduction_sizes (ro, sizes),
                         group_ok (ro, nis, within (block, sizes), a, b, cluster, split, persistent, rest))
            | 5 (sizes, rest) => or_else (vector (ro, sizes), group_ok (ro, nis, block, a, b, cluster, split, persistent, rest))
            | 6 (sizes: «n; Nat», tail: Nat, rest: WarpLevels (n, Acc, Mma, within (g, sizes))) =>
                or_else (parallel_sizes (ro, sizes), or_else (peels (tail, block, sizes),
                    warp_ok (ro, nis, within (block, sizes), a, b, rest)))
            | 7 (sizes: «n; Nat», tail: Nat, rest: WarpgroupLevels (n, Acc, Mma, g, sizes)) =>
                or_else (parallel_sizes (ro, sizes), or_else (peels (tail, block, sizes),
                    or_else (needs 90 tt 17,
                    wg_ok (ro, nis, within (block, sizes), a, b, cluster, split, persistent, consumers (block, sizes), rest))));
    lam tile_ok {n: Nat, Acc Mma: *}
        (ro nis: Nat, block: «n; Nat», a b: Bool, cluster split: Nat, persistent: Bool, l: TileLevels (n, Acc, Mma))@(core.pe.is_closed l): Verdict =
        match l with
            | 0 => ok
            | 1 (sizes, _, rest) =>
                or_else (parallel_sizes (ro, sizes),
                         tile_ok (ro, nis, within (block, sizes), a, b, cluster, split, persistent, rest))
            | 2 (sizes: «n; Nat», tail promote: Nat, rest: GroupLevels (n, Acc, Mma, sizes)) =>
                or_else (parallel_sizes (ro, sizes), or_else (promotes (nis, promote),
                or_else (peels (tail, block, sizes), or_else (clusters (cluster, split, block, sizes),
                    group_ok (ro, nis, clip (block, sizes), stages (a, promote, 1), stages (b, promote, 2), cluster,
                              split, persistent, rest)))))
            | 3 (sizes, _, promote, rest) =>
                or_else (reduction_sizes (ro, sizes), or_else (promotes (nis, promote),
                    tile_ok (ro, nis, within (block, sizes), stages (a, promote, 1), stages (b, promote, 2), cluster,
                             split, persistent, rest)))
            | 4 (sizes, rest) => or_else (vector (ro, sizes), tile_ok (ro, nis, block, a, b, cluster, split, persistent, rest))
            | 5 (size, _, cut, rest) => or_else (needs 90 ff 18, tile_ok (ro, nis, block, a, b, size, cut, persistent, rest))
            | 6 (_, rest) => tile_ok (ro, nis, block, a, b, cluster, split, tt, rest);

    anx lam levels {T: *, r: Nat, s: «r; Nat»}
        (op: Tensor r s T, l: TileLevels (root_loops op, root_acc op, root_contraction op)): Verdict =
        tile_ok (parallel op, inputs op, extents op, ff, ff, 0, 0, ff, l);
end
axm tile_req: {T: *, r: Nat, s: «r; Nat», M K: *}
            → [op: Tensor r s T, members: M,
               levels: TileLevels (root_loops op, root_acc op, root_contraction op), control: K]
            → Tensor r s T, normalize_tile_req;
/// A tile request inside a work-group: `levels` start at the work-group's scope, whose tile is `sizes`, at least as
/// large as `op`, so the work-group runs it in place.
anx lam group_tile_req {T: *, r: Nat, s: «r; Nat», M K: *}
    (op: Tensor r s T, members: M, sizes: «root_loops op; Nat»,
     levels: GroupLevels (root_loops op, root_acc op, root_contraction op, sizes), control: K)
    : Tensor r s T =
    tile_req (op, members, serial_group (sizes, 1, 0, levels), control);
axm tile_fuse: compile.Phase;
axm tile_group: compile.Phase;
///
/// ### bind
///
/// Identity annotation on the body of a `tiled` or `tiled_multi` region: `to` is the level's binding, 1 for a
/// work-group, 2 for a work-item and 3 for a warp.
/// On a reduction step, 2 runs its blocks on the work-items and 4 on the lanes of one work-item.
/// 5 binds a region of 16 rows to a warp that owns it: its tensors are warp values (`tensor.warp`) in registers.
/// 6 binds it to a warpgroup of four consecutive warps.
/// 7 binds a region of 64 rows to a warpgroup that owns it: warp `w` keeps rows `16 w ..` as warp values, and products of
/// 16-bit inputs run on `wgmma_lane`.
///
axm bind: {T: *} → [to: Nat] → T → T;
///
/// Identity annotation on a reduction step inside a work-group: its fold keeps `depth` blocks' panels in flight.
///
axm pipeline: {T: *} → [depth: Nat] → T → T;
///
/// Identity annotation on a reduction step inside a work-group whose pipelined panels are filled by TMA and mbarriers.
///
axm fill_tma: {T: *} → T → T;
///
/// Identity annotation inside a warpgroup region's `bind`: one more warp produces its reductions' panels, and with
/// `pingpong` 1 the two warpgroups alternate their MMAs.
///
axm specialize: {T: *} → [pingpong: Nat] → T → T;
///
/// Identity annotation inside a work-group region's `bind`: its work-groups run in clusters of `size`, sharing the TMA
/// copies of the inputs set in `multicast`, or with `split` splitting the reduction of each tile among them.
///
axm cluster: {T: *} → [size multicast split: Nat] → T → T;
///
/// Identity annotation inside a work-group region's `bind`: `ctas` work-groups run its tiles, each `ctas` apart in turn.
///
axm persistent: {T: *} → [ctas: Nat] → T → T;
///
/// Identity annotation on a reduction block that a warp computes on tensor cores, from TF32 or 16-bit inputs into an F32
/// accumulator; `shape` is the instruction's tile of the block's loops.
///
axm mma: {T: *} → [n: Nat, shape: «n; Nat»] → T → T;
///
/// `merge_with merge step` explicitly permits a bound reduction's partial accumulators to use `merge`.
/// Its accumulator type is checked, but its algebraic laws are not inferred.
axm merge_with: {T Acc: *} → [merge: [Acc, Acc] → Acc] → T → T;
///
/// Fuses exactly the group's members; parallel levels yield members that have users outside the group,
/// reduction levels fuse only members without such users and never yield.
/// A pointwise member without users outside the group that a deeper reduction level stages (`role` 1) is left to
/// that level, so its panels compute it per block instead of a parallel level realizing it over the whole reduction.
///
anx lam default_control (q: FuseQuery): FuseDecision =
    let deferred = core.bit2.and 0 (core.ncmp.ne (q#role, 0), core.bit2.xor 0 (q#outside_use, tt));
    let parallel = core.bit2.and 0 (core.ncmp.e (q#kind, 0), core.bit2.xor 0 (deferred, tt));
    let inside   = core.bit2.and 0 (core.bit2.xor 0 (q#outside_use, tt), core.ncmp.ne (q#kind, 0));
    (core.bit2.and 0 (q#in_group, core.bit2.or 0 (parallel, inside)),
     core.bit2.and 0 (core.bit2.and 0 (q#in_group, parallel), q#outside_use));

anx lam group_blocks (bytes lanes registers cache_bytes: Nat): «4; Nat» =
    let nr = lanes * 4;
    let mr_budget = (registers - 12) / 4;
    let mr = core.select (mr_budget < lanes, mr_budget, lanes);
    let nc_budget = nr * lanes * 4;
    let nc = core.select (nc_budget < 256, nc_budget, 256);
    let kc_budget = cache_bytes / (nc * bytes * 2);
    let kc = core.select (kc_budget < 256, kc_budget, 256);
    (mr, nr, kc, nc);

///
/// The levels `tensor.tile_group` requests for a root with `ro` parallel and `rr` reduction loops:
/// always parallel, reduction, parallel, vector, where a level of zeros changes nothing.
/// `kind` 1 is a contraction (BLIS blocks, both operands packed, register-blocked micro tiles),
/// 2 another reduction and 0 an elementwise root, both one tile per index of all parallel loops but the last
/// (one per row for a row reduction).
///
anx lam default_tile_config {Acc: *, Mma: *} (ro rr kind: Nat, bytes lanes registers cache_bytes: Nat)
    : TileLevels (ro + rr, Acc, Mma) =
    let n      = ro + rr;
    let blocks = group_blocks (bytes, lanes, registers, cache_bytes);
    let (mr, nr, kc, nc) = (blocks#0₄, blocks#1₄, blocks#2₄, blocks#3₄);
    lam is (d: Idx n, k: Nat): Bool = core.idx2nat d == k;
    lam below (d: Idx n, k: Nat): Bool = core.idx2nat d < k;
    let none   = ‹n; 0›;
    let lead   = (ro - 1, 1)#(core.bit2.and 0 (kind == 2, ro == 1));
    let rows   = ‹d: n; (0, 1)#(below (d, lead))›;
    let outer  = ‹d: n; ((0, nc)#(is (d, ro - 1)), 1)#(below (d, ro - 2))›;
    let block  = ‹d: n; (0, kc)#(is (d, n - 1))›;
    let micro  = ‹d: n; ((0, nr)#(is (d, ro - 1)), mr)#(is (d, ro - 2))›;
    let vector = ‹d: n; (0, 1)#(is (d, ro - 2))›;
    // One chain for both shapes: a select of two chains would be a union of two nominal instances.
    lam pick (elementwise contraction: «n; Nat»): «n; Nat» = (elementwise, contraction)#(kind == 1);
    serial_par (pick (rows, outer), 1,
        serial_red (pick (none, block), 1, (0, 3)#(kind == 1),
            serial_par (pick (none, micro), 1, serial_vec (pick (none, vector), serial_done ()))));

axm within_budget: {P C: *} → [producer: P, reader: C, budget: Nat] → Bool;
axm region_fusion_ok: {P R B: *}
    → [producer: P, region: R, body: B, slot mode budget: Nat] → Bool;
axm fuse_region_inputs: [mode budget: Nat, graph: Bool] → compile.Phase;
axm fuse_and_yield: [budget: Nat] → compile.Phase;
axm region_yield_ok: {P R B A: *}
    → [producer: P, region: R, body: B, axes: A, slot budget: Nat] → Bool;

priv axm yield_tiles: {T: *, r: Nat, C: *} → {s: «r; Nat»}
    → [producer: Tensor r s T, off ext: «r; Nat», value: C] → [Tensor r ext T, C], normalize_yield_tiles;
priv axm split_rows: {R: *} → [region: R, slot tile: Nat] → R, normalize_split_rows;
priv axm outer_rows_ok: {R: *} → [region: R, slot tile: Nat] → Bool;

priv anx lam group_request_rule (P C: *): Rule [p: P, kind dim tile: Nat, params: C] =
    rule request (p: P, kind dim tile: Nat, params: C):
        group_req (p, kind, dim, tile, params)
        when group_supported (p, kind, dim, tile, params) =>
        group_schedule (p, kind, dim, tile, params);
    request;

priv anx lam group_slice_rule (T: *, r: Nat): Rule [s: «r; Nat», p: Tensor r s T, off ext: «r; Nat»] =
    rule fuse (s: «r; Nat», p: Tensor r s T, off ext: «r; Nat»):
        slice s (off, ‹r; 1›, ext) p
        when group_fusion (p, slice s (off, ‹r; 1›, ext) p) =>
        tile_of (p, off, ext);
    fuse;

priv anx lam group_box_rule (T: *, r: Nat): Rule [s: «r; Nat», p: Tensor r s T, off ext cap: «r; Nat»] =
    rule fuse (s: «r; Nat», p: Tensor r s T, off ext cap: «r; Nat»):
        slice_box s (off, ext, cap) p
        when group_fusion (p, slice_box s (off, ext, cap) p) =>
        tile_of_box (p, off, ext, cap);
    fuse;

priv anx lam fusion_slice_rule (T: *, r budget: Nat): Rule [s: «r; Nat», p: Tensor r s T, off ext: «r; Nat»] =
    rule fuse (s: «r; Nat», p: Tensor r s T, off ext: «r; Nat»):
        slice @(T, r) s (off, ‹r; 1›, ext) p
        when core.bit2.and 0 (core.bit2.xor 0 (group_root p, tt),
            within_budget (p, slice @(T, r) s (off, ‹r; 1›, ext) p, budget)) =>
        tile_of (p, off, ext);
    fuse;

pub lam fuse_producer (T: *, r: Nat): Rule [s: «r; Nat», p: Tensor r s T, off ext: «r; Nat»] =
    fusion_slice_rule (T, r, 1);

priv anx lam fusion_box_rule (T: *, r budget: Nat): Rule [s: «r; Nat», p: Tensor r s T, off ext cap: «r; Nat»] =
    rule fuse (s: «r; Nat», p: Tensor r s T, off ext cap: «r; Nat»):
        slice_box @(T, r) s (off, ext, cap) p
        when within_budget (p, slice_box @(T, r) s (off, ext, cap) p, budget) =>
        tile_of_box (p, off, ext, cap);
    fuse;

pub lam fuse_halo (T: *, r budget: Nat): Rule [s: «r; Nat», p: Tensor r s T, off ext cap: «r; Nat»] =
    fusion_box_rule (T, r, budget);

axm group_candidate: {P: *} → [producer: P, tile_size: Nat] → Bool;
axm group_build: {P: *} → [producer: P, tile_size: Nat] → P, normalize_group_build;

pub lam group_outer (P: *, tile_size: Nat): Rule P =
    rule group (p: P): p when group_candidate (p, tile_size) => group_build (p, tile_size);
    group;

axm reverse_at: {P C: *} → [producer: P, consumers: C, dim tile_size: Nat] → [P, C];
axm reverse_legal: {P C: *} → [producer: P, consumers: C, dim tile_size: Nat] → Bool;
axm reverse_build: {P C: *} → [producer: P, consumers: C, dim tile_size: Nat] → [P, C], normalize_reverse_build;

pub lam reverse_rule (P C: *): Rule [producer: P, consumers: C, dim tile_size: Nat] =
    rule place (p: P, cs: C, dim tile_size: Nat):
        reverse_at (p, cs, dim, tile_size)
        when reverse_legal (p, cs, dim, tile_size) =>
        reverse_build (p, cs, dim, tile_size);
    place;

priv axm reverse_source: {T: *, r: Nat} → [s: «r; Nat»]
    → [producer: Tensor r s T, off ext: «r; Nat»] → Tensor r ext T, normalize_reverse_source;
priv axm reverse_part: {T: *, r rp: Nat, P C Tile: *}
    → [consumer: C, producer: P, tile: Tile, off ext: «r; Nat», producer_off producer_ext: «rp; Nat»]
    → Tensor r ext T, normalize_reverse_part;
///
/// The tensor accumulator descriptor read at each full loop coordinate before reduction.
///
anx lam Accumulator {T: *, Ro Rn: Nat}: * = [shape: «Ro; Nat»,
    map_init: «Rn; affine.Index» → «Ro; affine.Index», outs: Tensor Ro shape T];
anx lam outs {T: *, Ro Rn: Nat} (shape: «Ro; Nat»)
    (map_init: «Rn; affine.Index» → «Ro; affine.Index») (value: Tensor Ro shape T): Accumulator @(T, Ro, Rn) =
    (shape, map_init, value);
anx lam AccumulatorDefault {T: *, Ro: Nat}: * =
    [shape: «Ro; Nat», outs: Tensor Ro shape T];
anx lam outs_default {T: *, Ro: Nat} (shape: «Ro; Nat») (value: Tensor Ro shape T): AccumulatorDefault @(T, Ro) =
    (shape, value);
///
/// `map_reduce` that folds into the elements of `acc` instead of a scalar seed, e.g. `C + A·B`.
anx lam map_reduce_acc {nis: Nat} {To: *, Ro Rn: Nat}
                       (So: «Ro; Nat», Sr: «Rn; Nat»)
                       {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                       (f: Fn [To, «i: nis; Tis#i»] → To, acc: Tensor Ro So To)
                       (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
                       (maps: «i: nis; («Rn; affine.Index» → «Ris#i; affine.Index»)»)
                       (is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)»): Tensor Ro So To =
    map_reduce_post @(nis, 0)
        @(To, To, Ro, Rn, SchedT)
        (So, Sr, mk_sched (Rn, 0))
        @(Tis, Ris, Sis, (), (), ())
        (f, outs_default @(To, Ro) So acc, id @To) map_out (maps, ()) (is, ());

priv anx lam tile_rebuild {nis nps: Nat}
    {To Tp: *, Ro Rn: Nat, TSched: □}
    (So: «Ro; Nat», Sr: «Rn; Nat», sched: TSched)
    {Tis: «nis; *», Ris: «nis; Nat», Sis: «i: nis; «Ris#i; Nat»»,
     Tps: «nps; *», Rps: «nps; Nat», Sps: «j: nps; «Rps#j; Nat»»}
    {Init: *}
    (f: Fn [To, «i: nis; Tis#i»] → To, init: Init, post: Fn [To, «j: nps; Tps#j»] → Tp)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: nis; «Rn; affine.Index» → «Ris#i; affine.Index»»,
     post_maps: «j: nps; «Ro; affine.Index» → «Rps#j; affine.Index»») =
    lam full {Seed: *} (seed: Seed)
        (ext: «Ro; Nat», size: «Rn; Nat», schedule: TSched)
        (sis: «i: nis; «Ris#i; Nat»», sps: «j: nps; «Rps#j; Nat»»)
        (lo: «Rn; Nat», off: «Ro; Nat», starts: «i: nis; «Ris#i; Nat»», post_starts: «j: nps; «Rps#j; Nat»»)
        (inputs: «i: nis; Tensor (Ris#i) (sis#i) (Tis#i)», extras: «j: nps; Tensor (Rps#j) (sps#j) (Tps#j)»)
        : Tensor Ro ext Tp =
        map_reduce_post @(nis, nps) @(To, Tp, Ro, Rn, TSched) (ext, size, schedule)
            @(Tis, Ris, sis, Tps, Rps, sps) @Seed (f, seed, post)
            (tile_shift @(Rn, Ro) map_out (lo, off))
            (‹i: nis; tile_shift @(Rn, Ris#i) (maps#i) (lo, starts#i)›,
             ‹j: nps; tile_shift @(Ro, Rps#j) (post_maps#j) (off, post_starts#j)›)
            (inputs, extras);
    lam cut_reduction (ext: «Ro; Nat», size: «Rn; Nat», schedule: TSched)
        (sis: «i: nis; «Ris#i; Nat»»)
        (lo: «Rn; Nat», off: «Ro; Nat», starts: «i: nis; «Ris#i; Nat»»)
        (acc: Tensor Ro ext To, inputs: «i: nis; Tensor (Ris#i) (sis#i) (Tis#i)»): Tensor Ro ext To =
        map_reduce_post @(nis, 0) @(To, To, Ro, Rn, TSched) (ext, size, schedule)
            @(Tis, Ris, sis, (), (), ()) (f, outs_default @(To, Ro) ext acc, id @To)
            (tile_shift @(Rn, Ro) map_out (lo, off))
            (‹i: nis; tile_shift @(Rn, Ris#i) (maps#i) (lo, starts#i)›, ()) (inputs, ());
    (full, cut_reduction);

priv anx lam tile_init {T: *, r n: Nat} (s: «r; Nat»)
    (map: «n; affine.Index» → «r; affine.Index», value: Tensor r s T)
    (lo: «n; Nat», start ext: «r; Nat») =
    (ext, tile_shift @(n, r) map (lo, start), slice @(T, r) s (start, ‹r; 1›, ext) value);

// Bind the literal slot before specializing dependent map tuples.
priv anx lam stage_input (slot: Nat) {nis nps: Nat}
    {To Tp: *, Ro Rn: Nat, TSched: □}
    (So: «Ro; Nat», Sr: «Rn; Nat», sched: TSched)
    {Tis: «nis; *», Ris: «nis; Nat», Sis: «i: nis; «Ris#i; Nat»»,
     Tps: «nps; *», Rps: «nps; Nat», Sps: «j: nps; «Rps#j; Nat»»}
    {Init: *}
    (f: Fn [To, «i: nis; Tis#i»] → To, init: Init, post: Fn [To, «j: nps; Tps#j»] → Tp)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: nis; «Rn; affine.Index» → «Ris#i; affine.Index»»,
     post_maps: «j: nps; «Ro; affine.Index» → «Rps#j; affine.Index»»)
    (inputs: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)», extras: «j: nps; Tensor (Rps#j) (Sps#j) (Tps#j)»)
    (axis: Idx (Ris#(core.idx 0 nis slot)), tile: Nat,
     perm: «Ris#(core.idx 0 nis slot); Idx (Ris#(core.idx 0 nis slot))», shifted: Bool, inner: Nat)
    (shape: «Ris#(core.idx 0 nis slot) + 1; Nat»)
    (staged: Tensor (Ris#(core.idx 0 nis slot) + 1) shape (Tis#(core.idx 0 nis slot))): Tensor Ro So Tp =
    let slot = core.idx 0 nis slot;
    let r = Ris#slot;
    lam read (o: «Rn; affine.Index»): «r + 1; affine.Index» =
        let coords = (maps#slot) o;
        let at = (coords#axis, affine.op.add (coords#axis, affine.lit inner))#shifted;
        let outer = ‹d: r;
            let p = perm#d;
            (coords#p, affine.semiop.floordiv (at, tile))#(core.icmp.e (p, axis))›;
        tuple.append @r @(‹r; affine.Index›, affine.Index) (outer, affine.semiop.rem (at, tile));
    let ris = ‹i: nis; (Ris#i, r + 1)#(core.icmp.e (i, slot))›;
    let sis = ‹i: nis;
        (core.bitcast «ris#i; Nat» (Sis#i), core.bitcast «ris#i; Nat» shape)#(core.icmp.e (i, slot))›;
    let reads = ‹i: nis;
        let Map = «Rn; affine.Index» → «ris#i; affine.Index»;
        (core.bitcast Map (maps#i), core.bitcast Map read)#(core.icmp.e (i, slot))›;
    let values = ‹i: nis;
        let Input = Tensor (ris#i) (sis#i) (Tis#i);
        (core.bitcast Input (inputs#i), core.bitcast Input staged)#(core.icmp.e (i, slot))›;
    map_reduce_post @(nis, nps) @(To, Tp, Ro, Rn, TSched) (So, Sr, sched)
        @(Tis, ris, sis, Tps, Rps, Sps) @Init (f, init, post) map_out (reads, post_maps) (values, extras);

///
/// `tail` is 0 to cover a partial tile with one body of extent `min (ts, s - off)` and 1 to peel it.
///
axm tiled: {T: *, r: Nat}
         → [s ts: «r; Nat», tail: Nat]
         → {I: *} → [ins: I]
         → [body: [off ext: «r; Nat»] → I → Tensor r ext T]
         → Tensor r s T, normalize_tiled;

anx lam tile_shape {r g: Nat} (s: «r; Nat», axes: «g; Idx r», ext: «g; Nat»): «r; Nat» =
    ‹d: r; vec.fold.r @(Nat, Idx g) @g
        (λ (j: Idx g, value: Nat): Nat = (value, ext#j)#(core.icmp.e (axes#j, d)))
        (‹j: g; j›, s#d)›;

axm tiled_multi: {n g: Nat, Ts: «n; *», rs: «n; Nat»}
               → [shapes: «i: n; «rs#i; Nat»», s ts: «g; Nat», tail: Nat]
               → [axes: «i: n; «g; Idx (rs#i)»»]
               → {I: *} → [ins: I]
               → [body: [off ext: «g; Nat»] → I
                   → «i: n; Tensor (rs#i) (tile_shape (shapes#i, axes#i, ext)) (Ts#i)»]
               → «i: n; Tensor (rs#i) (shapes#i) (Ts#i)», normalize_tiled_multi;

priv anx lam tiled_multi_impl {n g: Nat, Ts: «n; *», rs: «n; Nat»}
    (shapes: «i: n; «rs#i; Nat»», s ts: «g; Nat», tail: Nat)
    (axes: «i: n; «g; Idx (rs#i)»») {I: *} (ins: I)
    (body: [off ext: «g; Nat»] → I
        → «i: n; Tensor (rs#i) (tile_shape (shapes#i, axes#i, ext)) (Ts#i)»): «i: n; Tensor (rs#i) (shapes#i) (Ts#i)» =
    ‹i: n;
        lam at (x: «rs#i; I64»): Ts#i =
            let off = ‹d: g;
                let axis = axes#i#d;
                let tile = (ts#d, s#d)#(s#d < ts#d);
                core.bitcast Nat (x#axis) / tile * tile›;
            lam read (ext: «g; Nat»): Ts#i =
                let origin = tile_shape (‹rs#i; 0›, axes#i, off);
                let extent = tile_shape (shapes#i, axes#i, ext);
                get ((body (off, ext) ins)#i, ‹d: rs#i;
                    core.idx 0 (extent#d) (core.bitcast Nat (x#d) - origin#d)›);
            lam peel (d: Nat, ext: «g; Nat»)@core.pe.is_closed (g, s, ts): Ts#i =
                (λ (): Ts#i = read ext,
                 λ (): Ts#i =
                    let axis = core.idx 0 g d;
                    let rem = s#axis % ts#axis;
                    let tail = (ts#axis, rem)#(rem != 0);
                    let short = ‹j: g; (ext#j, tail)#(core.idx2nat j == d)›;
                    fun choose (): Ts#i =
                        (short_case, full_case)#(off#axis < s#axis - rem) ()
                        where
                            con short_case () = return (peel (d + 1, short));
                            con full_case () = return (peel (d + 1, ext));
                        end;
                    cps.cps2ds choose ()
                )#(d < g) ();
            let full = ‹d: g; (ts#d, s#d)#(s#d < ts#d)›;
            (λ (): Ts#i = peel (0, full),
             λ (): Ts#i = read ‹d: g; (full#d, s#d - off#d)#(s#d - off#d < full#d)›)#(tail == 0) ();
        generate (shapes#i) at›;

axm tile_fold: {Acc: *}
             → [n ks: Nat]
             → [init: Acc]
             → {I: *} → [ins: I]
             → [step: [acc: Acc, off: Nat] → I → Acc]
             → Acc, normalize_tile_fold;
///
/// ### Tile-and-fuse builders
///
/// `tile_fuse` builds every level from these, so each rewrite it applies is defined here.
/// `tf_par` tiles a root on one grid (R1); `tf_par_n` also hands back `n - 1` member tiles ahead of the root (R4), each whole off its grid `axes`.
/// `tf_view` materializes an operand on the loops a contraction reads it by, so packing sees a plain projection.
/// `tf_reduce` splits a reduction into `tile_fold` blocks of `ks`, a peeled last block and the epilogue (R3).
/// `tf_chunk` is the extent of the block at `ko` and `tf_tail` the offset and extent of the peeled block.
///
anx lam tf_par {T: *, r: Nat} {I: *} (s ts: «r; Nat», tail: Nat) (ins: I)
    (body: [off ext: «r; Nat»] → I → Tensor r ext T): Tensor r s T =
    tiled (s, ts, tail) ins body;
anx lam tf_par_n {n g: Nat, Ts: «n; *», rs: «n; Nat»} {I: *}
    (shapes: «i: n; «rs#i; Nat»», s ts: «g; Nat», tail: Nat) (axes: «i: n; «g; Idx (rs#i)»») (ins: I)
    (body: [off ext: «g; Nat»] → I → «i: n; Tensor (rs#i) (tile_shape (shapes#i, axes#i, ext)) (Ts#i)»)
    : «i: n; Tensor (rs#i) (shapes#i) (Ts#i)» =
    tiled_multi @(n, g, Ts, rs) (shapes, s, ts, tail) axes ins body;
anx lam tf_view {T: *, r: Nat, s: «r; Nat»} {g: Nat} (S: «g; Nat»)
    (map: «g; affine.Index» → «r; affine.Index») (input: Tensor r s T): Tensor g S T =
    map_reduce (S, S) (tensor_copy @T, ⊥:T) affine.id (map,) input;
anx lam tf_chunk (K ks tail ko: Nat): Nat =
    let rest = K - ko;
    ((rest, ks)#(ks < rest), ks)#(tail == 1);
anx lam tf_tail (K ks: Nat): «2; Nat» = (K / ks * ks, K % ks);
anx lam tf_reduce {Acc Out I: *} (K ks tail: Nat) (init: Acc) (ins: I)
    (step: [acc: Acc, ko: Nat] → I → Acc) (last: Acc → Acc) (post: Acc → Out): Out =
    let blocks = ((K + (ks - 1)) / ks, K / ks)#(tail == 1);
    let acc    = tile_fold (blocks, ks) init ins step;
    post ((acc, last acc)#(tail == 1));

anx lam TileBox (r: Nat): * = [off ext: «r; Nat»];
axm tiled_n: {n g: Nat, Ts: «n; *», rs: «n; Nat»}
           → [shapes: «i: n; «rs#i; Nat»», grid: «g; Nat»]
           → [boxes: «g; Nat» → «i: n; TileBox (rs#i)»]
           → {I: *} → [ins: I]
           → [body: [point: «g; Nat»] → I → «i: n; Tensor (rs#i) ((boxes point)#i#tt) (Ts#i)»]
           → «i: n; Tensor (rs#i) (shapes#i) (Ts#i)», normalize_tiled_n;

priv anx lam tiled_n_impl {n g: Nat, Ts: «n; *», rs: «n; Nat»}
    (shapes: «i: n; «rs#i; Nat»», grid: «g; Nat»)
    (boxes: «g; Nat» → «i: n; TileBox (rs#i)»)
    {I: *} (ins: I)
    (body: [point: «g; Nat»] → I → «i: n; Tensor (rs#i) ((boxes point)#i#tt) (Ts#i)»): «i: n; Tensor (rs#i) (shapes#i) (Ts#i)» =
    let count = vec.fold.r @(Nat, Nat) @g core.nat.mul (grid, 1);
    let Results = «i: n; Tensor (rs#i) (shapes#i) (Ts#i)»;
    let init = ‹i: n; splat (shapes#i, ⊥:(Ts#i))›;
    lam step (acc: Results, index: Nat): Results =
        let point = ‹d: g;
            let stride = vec.fold.r @(Nat, Idx g) @g
                (λ (j: Idx g, value: Nat): Nat = value * (1, grid#j)#(core.idx2nat j > core.idx2nat d))
                (‹j: g; j›, 1);
            index / stride % grid#d›;
        let owned = boxes point;
        let tiles = body point ins;
        ‹i: n;
            let (off, ext) = owned#i;
            lam at (x: «rs#i; I64»): Ts#i =
                let local = ‹d: rs#i; core.bitcast Nat (x#d) - off#d›;
                let valid = vec.scan.for_all @(Idx (rs#i)) @(rs#i)
                    (λ (d: Idx (rs#i)): Bool =
                        core.bit2.and 0 (off#d <= core.bitcast Nat (x#d), local#d < ext#d)) ‹d: rs#i; d›;
                fun read (): Ts#i =
                    (old_value, tile_value)#valid ()
                    where
                        con old_value () = return (get (acc#i, ‹d: rs#i; core.idx 0 (shapes#i#d) (core.bitcast Nat (x#d))›));
                        con tile_value () = return (get (tiles#i, ‹d: rs#i; core.idx 0 (ext#d) (local#d)›));
                    end;
                cps.cps2ds read ();
            generate (shapes#i) at›;
    lam run (index: Nat, acc: Results)@core.pe.is_closed (count, index): Results =
        (λ (): Results = acc,
         λ (): Results = run (index + 1, step (acc, index)))#(index < count) ();
    run (0, init);

axm group_impl: {T: *, r: Nat, s: «r; Nat»} → [p: Tensor r s T, ts: «r; Nat»] → Tensor r s T,
    normalize_group_impl;

priv anx lam tiled_impl {T: *, r: Nat} (s ts: «r; Nat», tail: Nat)
    {I: *} (ins: I) (body: [off ext: «r; Nat»] → I → Tensor r ext T): Tensor r s T =
    let ts = ‹d: r; (ts#d, s#d)#(s#d < ts#d)›;
    lam at (x: «r; I64»): T =
        let off = ‹d: r; let i = core.bitcast Nat (x#d); i / ts#d * ts#d›;
        let local = ‹d: r; core.bitcast Nat (x#d) - off#d›;
        lam peel (d: Nat, ext: «r; Nat»)@core.pe.is_closed (r, s, ts): T =
            (λ (): T = get (body (off, ext) ins, ‹j: r; core.idx 0 (ext#j) (local#j)›),
             λ (): T =
                let axis = core.idx 0 r d;
                let rem = s#axis % ts#axis;
                let tail = (ts#axis, rem)#(rem != 0);
                let full = s#axis - rem;
                let short = ‹j: r; (ext#j, tail)#(core.idx2nat j == d)›;
                fun choose (): T =
                    (short_case, full_case)#(core.bitcast Nat (x#axis) < full) ()
                    where
                        con short_case () = return (peel (d + 1, short));
                        con full_case () = return (peel (d + 1, ext));
                    end;
                cps.cps2ds choose ()
            )#(d < r) ();
        let capped = ‹d: r; (ts#d, s#d - off#d)#(s#d - off#d < ts#d)›;
        (λ (): T = peel (0, ts),
         λ (): T = get (body (off, capped) ins, ‹j: r; core.idx 0 (capped#j) (local#j)›))#(tail == 0) ();
    generate s at;

priv anx lam tile_fold_impl {Acc: *} (n ks: Nat) (init: Acc)
    {I: *} (ins: I) (step: [acc: Acc, off: Nat] → I → Acc): Acc =
    fun run (): Acc =
        loop (0, init)
        where
            con loop (i: Nat, acc: Acc) =
                (done, next)#(i < n) ()
                where
                    con done () = return acc;
                    con next () = loop (i + 1, step (acc, i * ks) ins);
                end
        end;
    cps.cps2ds run ();

axm sdpa_online: [mode: Nat, masked: Bool, bm bk: Nat] → {H M S K N: Nat}
    → [scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
       v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)] → Tensor 3 (H, M, N) (math.F32), normalize_sdpa_online;

pub anx lam attention_online_rule (mode bm bk: Nat): Rule [
    H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
    k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32)] =
    rule online (H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
                 k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32)):
        sdpa mode @(H, M, S, K, N) (scale, q, k, v)
        when core.bit2.and 0 (core.bit2.and 0 (0 < S, 0 < N), core.bit2.and 0 (0 < bm, 0 < bk)) =>
        sdpa_online (mode, ff, bm, bk) @(H, M, S, K, N)
            (scale, q, k, v, splat ((H, M, S), 0:math.F32));
    online;

pub anx lam attention_masked_online_rule (mode bm bk: Nat): Rule [
    H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
    k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)] =
    rule online (H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
                 k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)):
        sdpa_masked mode @(H, M, S, K, N) (scale, q, k, v, mask)
        when core.bit2.and 0 (core.bit2.and 0 (0 < S, 0 < N), core.bit2.and 0 (0 < bm, 0 < bk)) =>
        sdpa_online (mode, tt, bm, bk) @(H, M, S, K, N) (scale, q, k, v, mask);
    online;

pub anx lam attention_row_tile (K N lanes registers: Nat): Nat =
    let columns = (K, N)#(K < N);
    let cost = columns + lanes + 2;
    ((1, 2)#(2 * cost <= registers * lanes), 4)#(4 * cost <= registers * lanes);

pub anx lam attention_schedule_rule (mode lanes registers: Nat): Rule [
    H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
    k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32)] =
    rule schedule (H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
                   k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32)):
        sdpa mode @(H, M, S, K, N) (scale, q, k, v)
        when core.bit2.and 0 (core.bit2.and 0 (0 < S, 0 < N), 0 < lanes) =>
        sdpa_online (mode, ff, attention_row_tile (K, N, lanes, registers), lanes)
            @(H, M, S, K, N) (scale, q, k, v, splat ((H, M, S), 0:math.F32));
    schedule;

pub anx lam attention_masked_schedule_rule (mode lanes registers: Nat): Rule [
    H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
    k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)] =
    rule schedule (H M S K N: Nat, scale: math.F32, q: Tensor 3 (H, M, K) (math.F32),
                   k: Tensor 3 (H, S, K) (math.F32), v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)):
        sdpa_masked mode @(H, M, S, K, N) (scale, q, k, v, mask)
        when core.bit2.and 0 (core.bit2.and 0 (0 < S, 0 < N), 0 < lanes) =>
        sdpa_online (mode, tt, attention_row_tile (K, N, lanes, registers), lanes)
            @(H, M, S, K, N) (scale, q, k, v, mask);
    schedule;

priv anx lam sdpa_online_inputs (mode: Nat, masked: Bool, bm bk: Nat) {H M S K N: Nat} {Mask: *}
    (scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
     v: Tensor 3 (H, S, N) (math.F32), mask: Mask, get_mask: Mask → Tensor 3 (H, M, S) (math.F32)): Tensor 3 (H, M, N) (math.F32) =
    let F = math.F32;
    let add = math.arith.add mode;
    let mul = math.arith.mul mode;
    let sub = math.arith.sub mode;
    let maximum = math.extrema.fmax mode;
    let R: Ring = (F, 0:F, add, mul);
    tiled ((H, M, N), (1, bm, N), 1) (q, k, v, mask)
        (λ (off ext: «3; Nat»)
            (q: Tensor 3 (H, M, K) F, k: Tensor 3 (H, S, K) F, v: Tensor 3 (H, S, N) F, mask: Mask): Tensor 3 ext F =
            let rows = ext#1₃;
            let qt = reshape (1, rows, K) (rows, K)
                (slice @(F, 3) (H, M, K) ((off#0₃, off#1₃, 0), (1, 1, 1), (1, rows, K)) q);
            let Acc = [Tensor 1 rows F, Tensor 1 rows F, Tensor 2 (rows, N) F];
            let init: Acc = (splat (rows, math.neg_inf math.f32), splat (rows, 0:F), splat ((rows, N), 0:F));
            lam block (qt: Tensor 2 (rows, K) F, k: Tensor 3 (H, S, K) F, v: Tensor 3 (H, S, N) F, mask: Mask)
                (width ko: Nat, (old_max old_sum: Tensor 1 rows F, old_out: Tensor 2 (rows, N) F)): Acc =
                let kt = reshape (1, width, K) (width, K)
                    (slice @(F, 3) (H, S, K) ((off#0₃, ko, 0), (1, 1, 1), (1, width, K)) k);
                let vt = reshape (1, width, N) (width, N)
                    (slice @(F, 3) (H, S, N) ((off#0₃, ko, 0), (1, 1, 1), (1, width, N)) v);
                let scores = dot_product R @(2, 2) @(1, 0) (1₂, 1₂, (), ())
                    @((rows, K), (width, K)) (qt, kt);
                let scores = unary (λ x: F: F = mul (x, scale)) @(2, (rows, width)) scores;
                let scores = (λ (): Tensor 2 (rows, width) F = scores,
                    λ (): Tensor 2 (rows, width) F =
                        let bias = reshape (1, rows, width) (rows, width)
                            (slice @(F, 3) (H, M, S) ((off#0₃, off#1₃, ko),
                                (1, 1, 1), (1, rows, width)) (get_mask mask));
                        binary add @(2, (rows, width)) (scores, bias))#masked ();
                let next_max = binary maximum @(1, rows)
                    (old_max, reduce (maximum, math.neg_inf math.f32) @2 1₂ @(rows, width) scores);
                let correction = binary (λ (x y: F): F =
                    (math.exp.exp mode (sub (x, y)), 1.0:F)#(math.cmp.e math.mode.none (y, math.neg_inf math.f32)))
                    @(1, rows) (old_max, next_max);
                let p = binary_ax (λ (x y: F): F =
                    (math.exp.exp mode (sub (x, y)), 0:F)#(math.cmp.e math.mode.none (y, math.neg_inf math.f32)))
                    @2 1₂ @(rows, width) (scores, next_max);
                let next_sum = binary add @(1, rows)
                    (binary mul @(1, rows) (old_sum, correction), reduce (add, 0:F) @2 1₂ @(rows, width) p);
                let pv = dot_product R @(2, 2) @(1, 0) (1₂, 0₂, (), ())
                    @((rows, width), (width, N)) (p, vt);
                let next_out = binary add @(2, (rows, N))
                    (binary_ax mul @2 1₂ @(rows, N) (old_out, correction), pv);
                (next_max, next_sum, next_out);
            let blocks = (S - 1) / bk;
            let acc = tile_fold @Acc (blocks, bk) init (qt, k, v, mask)
                (λ (acc: Acc, ko: Nat)
                    (qt: Tensor 2 (rows, K) F, k: Tensor 3 (H, S, K) F, v: Tensor 3 (H, S, N) F, mask: Mask): Acc =
                    block (qt, k, v, mask) (bk, ko, acc));
            let (_, sums, result) = block (qt, k, v, mask) (S - blocks * bk, blocks * bk, acc);
            reshape (rows, N) ext (binary_ax (math.arith.div mode) @2 1₂ @(rows, N) (result, sums)));

priv anx lam sdpa_online_impl (mode: Nat, masked: Bool, bm bk: Nat) {H M S K N: Nat}
    (scale: math.F32, q: Tensor 3 (H, M, K) (math.F32), k: Tensor 3 (H, S, K) (math.F32),
     v: Tensor 3 (H, S, N) (math.F32), mask: Tensor 3 (H, M, S) (math.F32)): Tensor 3 (H, M, N) (math.F32) =
    (λ (): Tensor 3 (H, M, N) (math.F32) =
        sdpa_online_inputs (mode, ff, bm, bk) @(H, M, S, K, N) @[]
            (scale, q, k, v, (), λ (): Tensor 3 (H, M, S) (math.F32) = splat ((H, M, S), 0:math.F32)),
     λ (): Tensor 3 (H, M, N) (math.F32) =
        sdpa_online_inputs (mode, tt, bm, bk) @(H, M, S, K, N) @(Tensor 3 (H, M, S) math.F32)
            (scale, q, k, v, mask, λ x: Tensor 3 (H, M, S) (math.F32): Tensor 3 (H, M, S) (math.F32) = x))#masked ();

anx lam stage_shape {r k: Nat} (s: «r; Nat»)
    (inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r»): «r + k; Nat» =
    let axes = ‹j: k; core.idx2nat j›;
    lam extent (d: Nat) (j: Nat, size: Nat): Nat =
        (size, (size + inner_tiles#(core.idx 0 k j) - 1) / inner_tiles#(core.idx 0 k j))
            #(d == inner_dims_pos#(core.idx 0 k j));
    let outer = ‹d: r; vec.fold.r @(Nat, Nat) @k (extent (core.idx2nat d)) (axes, s#d)›;
    vec.cat @(r, k) @Nat (‹d: r; outer#(outer_perm#d)›, inner_tiles);

axm stage: {T: *, r k: Nat}
         → [s: «r; Nat»]
         → [inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r», pad: T]
         → [scope: Nat]
         → [input: Tensor r s T]
         → Tensor (r + k) (stage_shape s (inner_dims_pos, inner_tiles, outer_perm)) T, normalize_stage;

axm frozen: {T: *, r: Nat} → {s: «r; Nat»} → Tensor r s T → Tensor r s T;

/// Identity annotation on a staged work-group panel: it is stored at capacity `cap` in the layout the scheduler chose.
axm placed: {T: *, r: Nat} → {s: «r; Nat»} → [cap: «r; Nat», layout: layout_expr.Expr (r, cap)] → Tensor r s T → Tensor r s T;

axm prepack: {T: *, r k: Nat}
           → [s: «r; Nat»]
           → [inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r», pad: T]
           → [input: Tensor r s T]
           → Tensor (r + k) (stage_shape s (inner_dims_pos, inner_tiles, outer_perm)) T;

priv axm prepack_panel: {C: *} → C → C, normalize_prepack_panel;
priv axm prepack_supported: {C: *, n: Nat} → [C, «n; [value multiple bound: Nat]»] → Bool;

priv anx lam prepack_rule (T: *, r k n: Nat) (facts: «n; [value multiple bound: Nat]»): Rule [
    s: «r; Nat», pos tiles: «k; Nat», perm: «r; Idx r», pad: T, scope: Nat, input: Tensor r s T] =
    rule pack (s: «r; Nat», pos tiles: «k; Nat», perm: «r; Idx r», pad: T, scope: Nat, input: Tensor r s T):
        stage @(T, r, k) s (pos, tiles, perm, pad) scope input
        when prepack_supported (stage @(T, r, k) s (pos, tiles, perm, pad) scope input, facts) =>
        prepack_panel (stage @(T, r, k) s (pos, tiles, perm, pad) scope input);
    pack;

// A fill of `s_out` elements of `E`, each `getter` reading the panel coordinate scaled by `scale`;
// a vector fill scales its fast dim by the vector width and gets that many elements at once.
priv anx lam stage_read_impl {T E: *, r k ri: Nat} (s_source s: «r; Nat», si: «ri; Nat»)
    (map: «r; affine.Index» → «ri; affine.Index»)
    (inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r», pad: E)
    (start step: «r; Nat»)
    (s_out scale: «r + k; Nat», getter: [Tensor ri si T, «i: ri; Idx si#i»] → E)
    (scope: Nat) (input: Tensor ri si T): Tensor (r + k) s_out E =
    let input = buf input;
    let inverse = ‹d: r; option.unwrap_unsafe (vec.first core.icmp.e (outer_perm, d))›;
    let axes = ‹j: k; core.idx2nat j›;
    lam at (x: «r + k; I64»): E =
        let y = ‹d: r + k; core.nat.mul (core.bitcast Nat (x#d), scale#d)›;
        lam coordinate (d: Nat) (j: Nat, coord: Nat): Nat =
            (coord, coord * inner_tiles#(core.idx 0 k j) + y#(core.idx 0 (r + k) (r + j)))
                    #(d == inner_dims_pos#(core.idx 0 k j));
        let coords = ‹d: r;
            vec.fold.r @(Nat, Nat) @k (coordinate (core.idx2nat d))
                (axes, y#(core.idx 0 (r + k) (core.idx2nat (inverse#d))))›;
        let valid = vec.scan.for_all @(Idx r) @r
            (λ (d: Idx r): Bool = coords#d < s#d) ‹d: r; d›;
        fun read (): E =
            (padding, present)#valid ()
            where
                con padding () = return pad;
                con present () =
                    let indices = ‹d: r; core.idx 0 (s_source#d) (start#d + step#d * coords#d)›;
                    let (_, indices) = affine.map @(ri, r) @(s_source, si) map indices @0 (⊥:(core.M 0));
                    return (getter (input, indices));
            end;
        cps.cps2ds read ();
    generate s_out at;

/// `stage_read_impl` for a box whose tiled extents are multiples of their tiles: every coordinate is in bounds.
priv anx lam stage_read_exact_impl {T E: *, r k ri: Nat} (s_source s: «r; Nat», si: «ri; Nat»)
    (map: «r; affine.Index» → «ri; affine.Index»)
    (inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r», pad: E)
    (start step: «r; Nat»)
    (s_out scale: «r + k; Nat», getter: [Tensor ri si T, «i: ri; Idx si#i»] → E)
    (scope: Nat) (input: Tensor ri si T): Tensor (r + k) s_out E =
    let input = buf input;
    let inverse = ‹d: r; option.unwrap_unsafe (vec.first core.icmp.e (outer_perm, d))›;
    let axes = ‹j: k; core.idx2nat j›;
    lam at (x: «r + k; I64»): E =
        let y = ‹d: r + k; core.nat.mul (core.bitcast Nat (x#d), scale#d)›;
        lam coordinate (d: Nat) (j: Nat, coord: Nat): Nat =
            (coord, coord * inner_tiles#(core.idx 0 k j) + y#(core.idx 0 (r + k) (r + j)))
                    #(d == inner_dims_pos#(core.idx 0 k j));
        let coords = ‹d: r;
            vec.fold.r @(Nat, Nat) @k (coordinate (core.idx2nat d))
                (axes, y#(core.idx 0 (r + k) (core.idx2nat (inverse#d))))›;
        let indices = ‹d: r; core.idx 0 (s_source#d) (start#d + step#d * coords#d)›;
        let (_, indices) = affine.map @(ri, r) @(s_source, si) map indices @0 (⊥:(core.M 0));
        getter (input, indices);
    generate s_out at;

priv anx lam stage_box_impl {T: *, r k: Nat} (s_source s: «r; Nat»)
    (inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r», pad: T)
    (start step: «r; Nat») (scope: Nat) (input: Tensor r s_source T): Tensor (r + k) (stage_shape s (inner_dims_pos, inner_tiles, outer_perm)) T =
    stage_read_impl @(T, T, r, k, r) (s_source, s, s_source) (affine.id @r)
        (inner_dims_pos, inner_tiles, outer_perm, pad) (start, step)
        (stage_shape s (inner_dims_pos, inner_tiles, outer_perm), ‹r + k; 1›, get_fused @(r, s_source, T)) scope input;

priv anx lam stage_impl {T: *, r k: Nat} (s: «r; Nat»)
    (inner_dims_pos inner_tiles: «k; Nat», outer_perm: «r; Idx r», pad: T)
    (scope: Nat) (input: Tensor r s T): Tensor (r + k) (stage_shape s (inner_dims_pos, inner_tiles, outer_perm)) T =
    stage_box_impl @(T, r, k) (s, s) (inner_dims_pos, inner_tiles, outer_perm, pad)
        (‹r; 0›, ‹r; 1›) scope input;

priv anx lam blis_operand {T: *, r: Nat} (source_shape: «r; Nat»)
    (shape: «2; Nat», read: «2; affine.Index» → «r; affine.Index»)
    (source: Tensor r source_shape T): Tensor 2 shape T =
    fun copy (_ x: T)@tt: T = return x;
    map_reduce_post @(1, 0) @(T, T, 2, 2, SchedT) (shape, shape, mk_sched (2, 0))
        @(T, r, source_shape, (), (), ())
        (copy, ⊥:T, id @T) (affine.id @2) (read, ()) (source, ());

priv anx lam group_blis_impl {T Ta Tb: *, nps: Nat, Tps: «nps; *», Rps: «nps; Nat», Sps: «i: nps; «Rps#i; Nat»»}
    (M K N: Nat, mr nr nc kc: Nat, pack_a: Bool)
    (combine: Fn [T, [Ta, Tb]] → T, init: T, post: Fn [T, «i: nps; Tps#i»] → T,
     post_maps: «i: nps; «2; affine.Index» → «Rps#i; affine.Index»»)
    (a: Tensor 2 (M, K) Ta, b: Tensor 2 (K, N) Tb, extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»): Tensor 2 (M, N) T =
    tiled ((M, N), (M, nc), 1) (a, b, extras)
        (λ (off ext: «2; Nat»)
            (a: Tensor 2 (M, K) Ta, b: Tensor 2 (K, N) Tb, extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»): Tensor 2 ext T =
            let rows = ext#ff;
            let n = ext#tt;
            lam block (a: Tensor 2 (M, K) Ta, b: Tensor 2 (K, N) Tb, extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»)
                (k ko: Nat, acc: Tensor 2 (rows, n) T, last: Bool): Tensor 2 (rows, n) T =
                let bp = stage @(Tb, 2, 1) (k, n) (1, nr, (tt, ff), ⊥:Tb) 0
                    (slice @(Tb, 2) (K, N) ((ko, off#tt), (1, 1), (k, n)) b);
                tiled ((rows, n), (mr, nr), 1) (a, bp, acc, extras)
                    (λ (row size: «2; Nat»)
                        (a: Tensor 2 (M, K) Ta, bp: Tensor 3 (stage_shape @(2, 1) (k, n) (1, nr, (tt, ff))) Tb,
                         acc: Tensor 2 (rows, n) T, extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»): Tensor 2 size T =
                        let m = size#ff;
                        let cols = size#tt;
                        let kt = core.select (core.ncmp.e (k / 4 * 4, k), 4, 1);
                        let vd = core.select (core.bit2.and 0 (1 < m, 1 < cols), 0,
                            core.select (1 < cols, 1, 4));
                        let source = slice @(Ta, 2) (M, K) ((off#ff + row#ff, ko), (1, 1), (m, k)) a;
                        let ap = (λ (): Tensor 2 (m, k) Ta = source,
                                  λ (): Tensor 2 (m, k) Ta =
                                      let shape = stage_shape @(2, 1) (m, k) (0, 1, (ff, tt));
                                      reshape_impl shape (m, k)
                                          (stage @(Ta, 2, 1) (m, k) (0, 1, (ff, tt), ⊥:Ta) 0 source))#pack_a ();
                        let cp = slice @(T, 2) (rows, n) (row, (1, 1), size) acc;
                        lam leaf {q: Nat, Tqs: «q; *», Rqs: «q; Nat», Sqs: «i: q; «Rqs#i; Nat»»}
                            (finish: Fn [T, «i: q; Tqs#i»] → T,
                             reads: «i: q; «2; affine.Index» → «Rqs#i; affine.Index»»,
                             values: «i: q; Tensor (Rqs#i) (Sqs#i) (Tqs#i)»): Tensor 2 size T =
                            map_reduce_post @(2, q) @(T, T, 2, 4, SchedT)
                                (size, (m, cols, k / kt, kt), mk_sched (vd, 1))
                                @((Ta, Tb), (2, 3), ((m, k), ((n + nr - 1) / nr, k, nr)), Tqs, Rqs, Sqs)
                                (combine, outs_default @(T, 2) size cp, finish)
                                (proj_map @(4, 2) (0, 1))
                                ((λ (o: «4; affine.Index»): «2; affine.Index» =
                                    (o#0₄, affine.op.add (affine.semiop.mul (o#2₄, kt), o#3₄)),
                                  λ (o: «4; affine.Index»): «3; affine.Index» =
                                    let j = affine.op.add (o#1₄, affine.lit (row#tt));
                                    (affine.semiop.floordiv (j, nr),
                                     affine.op.add (affine.semiop.mul (o#2₄, kt), o#3₄),
                                     affine.semiop.rem (j, nr))), reads)
                                ((ap, bp), values);
                        (λ (): Tensor 2 size T = leaf @(0, (), (), ()) (id @T, (), ()),
                         λ (): Tensor 2 size T =
                             leaf @(nps, Tps, Rps, Sps) (post,
                                 ‹i: nps; λ (o: «2; affine.Index»): «Rps#i; affine.Index» =
                                     post_maps#i (affine.op.add (o#ff, affine.lit (off#ff + row#ff)),
                                                  affine.op.add (o#tt, affine.lit (off#tt + row#tt)))›,
                                 extras))#last ());
            let blocks = (K - 1) / kc;
            let acc = tile_fold (blocks, kc) (splat ((rows, n), init)) (a, b, extras)
                (λ (acc: Tensor 2 (rows, n) T, ko: Nat)
                    (a: Tensor 2 (M, K) Ta, b: Tensor 2 (K, N) Tb, extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»): Tensor 2 (rows, n) T =
                    block (a, b, extras) (kc, ko, acc, ff));
            block (a, b, extras) (K - blocks * kc, blocks * kc, acc, tt));

priv anx lam group_blis_batch_impl
    {T Ta Tb: *, nps: Nat, Tps: «nps; *», Rps: «nps; Nat», Sps: «i: nps; «Rps#i; Nat»»,
     nb: Nat, Ris: «2; Nat»}
    (Sis: «i: 2; «Ris#i; Nat»», batches: «nb; Nat»)
    (M K N: Nat, mr nr nc kc: Nat, pack_a: Bool)
    (combine: Fn [T, [Ta, Tb]] → T, init: T, post: Fn [T, «i: nps; Tps#i»] → T,
     post_maps: «i: nps; «nb + 2; affine.Index» → «Rps#i; affine.Index»»,
     reads: «i: 2; «nb + 2; affine.Index» → «Ris#i; affine.Index»»)
    (inputs: [Tensor (Ris#ff) (Sis#ff) Ta, Tensor (Ris#tt) (Sis#tt) Tb], extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»)
    : Tensor (nb + 2) (vec.cat (batches, (M, N))) T =
    let shape = vec.cat (batches, (M, N));
    let extent = vec.cat (‹nb; 1›, (M, N));
    tiled @(T, nb + 2) (shape, extent, 1) (inputs, extras)
        (λ (off ext: «nb + 2; Nat»)
            (inputs: [Tensor (Ris#ff) (Sis#ff) Ta, Tensor (Ris#tt) (Sis#tt) Tb], extras: «i: nps; Tensor (Rps#i) (Sps#i) (Tps#i)»): Tensor (nb + 2) ext T =
            let prefix = ‹d: nb; affine.lit (off#(core.conv.u (nb + 2) d))›;
            let a = blis_operand @(Ta, Ris#ff) (Sis#ff)
                ((M, K), λ ij: «2; affine.Index»: «Ris#ff; affine.Index» = reads#ff (vec.cat (prefix, ij)))
                (inputs#ff);
            let b = blis_operand @(Tb, Ris#tt) (Sis#tt)
                ((K, N), λ ij: «2; affine.Index»: «Ris#tt; affine.Index» = reads#tt (vec.cat (prefix, ij)))
                (inputs#tt);
            reshape_impl (M, N) ext
                (group_blis_impl @(T, Ta, Tb, nps, Tps, Rps, Sps) (M, K, N, mr, nr, nc, kc, pack_a)
                    (combine, init, post,
                     ‹i: nps; λ ij: «2; affine.Index»: «Rps#i; affine.Index» =
                         post_maps#i (vec.cat (prefix, ij))›)
                    (a, b, extras)));
