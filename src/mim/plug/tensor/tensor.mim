/// # The tensor Plugin {#tensor}
///
/// @see [`-X tensor:<arg>`](@ref xarg_tensor)
/// @see mim::plug::tensor
///
/// [TOC]
///
/// SSA-world tensor operations: a generic `map_reduce` loop-nest abstraction plus derived operations
/// (reshape, slice, convolution, pooling, dot product, ...), lowered via `affine` loops and bufferized
/// onto the `buffer` layer.
///
/// ## Dependencies
///
plugin tuple;
plugin refly;
plugin core;
plugin mem;
import compile;
plugin option;
plugin vec;
plugin cps;
plugin affine;
plugin buffer;
plugin btensor;
plugin math;

use core.ops.n;
///
/// ## Types
///
/// ### Ring
///
/// Represents an [algebraic ring](https://en.wikipedia.org/wiki/Ring_(mathematics)).
/// E.g., `let nat_ring = (Nat, 0, core.nat.add, core.nat.mul);`.
///
/// An alias for `btensor.Ring`.
/// The buffer-world `btensor` plugin sits *below* `tensor` — `lower_to_mem` bufferizes onto `btensor.*` ops -
/// so the definition lives there and both layers share one notion of a ring.
anx Ring = btensor.Ring;
///
/// ### Tensor
///
/// `Tensor r s T` carries a logical rank `r`, shape `s` and element type `T`, distinct from ordinary arrays.
/// Its nominal key identifies tensors across shape substitution and function boundaries without classifying shape or index arrays as tensors.
/// The singleton witness preserves all three indices even when rank-0, singleton or empty array representations fold away.
/// For example, `Tensor 2 (1, 4) I32` differs from `Tensor 1 4 I32`, and `Tensor 0 () I32` differs from `I32`.
/// `⊥:T` records the element type without being evaluated; the singleton witness is erased before code generation.
/// The private representation prevents array access from bypassing tensor operations.
priv nom Tensor (r: Nat) (s: «r; Nat») (T: *) = [indices: «(r, s, ⊥:T)», data: «s; T»];
/// The annex lets lowering identify the exported type constructor.
pub anx let Tensor = Tensor;
///
/// ### from_array
///
/// Constructs a tensor from an array; bufferization accepts only static shapes and literal elements here.
/// Uniform literals use `buffer.lit`; other literals use `buffer.init`.
/// Use `from_array @(r, s, T) a` when array folding hides the intended singleton axes or rank.
/// External data enters through Tensor-typed parameters.
axm from_array: {r: Nat, s: «r; Nat», T: *} → [a: «s; T»] → Tensor r s T;
///
/// ### Element access and rank-0 conversion
///
/// `get` and `set` take one coordinate per logical axis, with type `Idx (s#j)` on axis `j`.
/// This index contract does not insert runtime bounds checks.
/// `scalar` constructs a rank-0 tensor; `item` extracts its element.
/// These boundary operations remain axioms when they cannot fold, so early inlining cannot expose the private array representation.
axm get: {r: Nat, s: «r; Nat», T: *}
       → [t: Tensor r s T, i: «j: r; Idx (s#j)»] → T, normalize_get;
axm set: {r: Nat, s: «r; Nat», T: *}
       → [t: Tensor r s T, i: «j: r; Idx (s#j)», v: T] → Tensor r s T, normalize_set;
axm scalar: {T: *} → T → Tensor 0 () T, normalize_scalar;
axm item: {T: *} → Tensor 0 () T → T, normalize_item;
///
/// ## Constructors
///
/// Build a tensor from nothing but its shape.
///
/// ### generate
///
/// Constructs a tensor by evaluating `body` once for every logical output coordinate.
/// Coordinates use `I64` so the body can do ordinary scalar arithmetic before converting them to bounded tensor indices.
///
/// ```python
/// output = empty(s_out)
/// for index in ndindex(s_out):
///     output[index] = body(index)
/// return output
/// ```
///
axm generate: {T: *, r: Nat}
            → [s_out: «r; Nat»]
            → [body: [«r; I64»] → T]
            → Tensor r s_out T;
///
/// ### splat
///
/// Constructs a tensor whose every element is `value`.
/// Keeping this explicit lets bufferization pick a fill operation instead of first building an index
/// lambda or a monolithic nested-array literal.
///
/// ```python
/// output = empty(s_out)
/// for index in ndindex(s_out):
///     output[index] = value
/// return output
/// ```
axm splat: {T: *, r: Nat}
         → [s_out: «r; Nat», value: T]
         → Tensor r s_out T;
///
/// ## Accessors
///
pub lam shape {r: Nat, s: «r; Nat», T: *} (t: Tensor r s T): «r; Nat» = s;
///
/// ## Map-Reduce
///
/// The loop-nest core every other operation is lowered onto: `lower_tensor` re-applies the matching
/// annex from Implementations, while `broadcast`, `concat`, `gather`, `generate`, `pad` and `scatter` are
/// expanded by `lower_map_reduce` directly.
///
/// ### id
///
/// The CPS identity (with an empty epilogue-input pack) — the neutral `post` epilogue.
axm id: {T: *} → Fn [T, []] → T, normalize_id;
///
/// ### copy
///
/// Ignores the (⊥) accumulator and returns the read element — the fold step of every pure re-indexing operation.
axm copy: {T: *} → Fn [T, T] → T, normalize_copy;
///
/// ### map_of
///
/// Ignores the accumulator and applies `app` to the elements — the fold step of an elementwise map.
axm map_of: {To Ins: *} → [Ins → To] → Fn [To, Ins] → To, normalize_map_of;
///
/// ### Aff
///
/// A factor, divisor or modulus of an access map: a literal, or one of its `s` run-time symbols.
anx nom AffK (s: Nat) =
    | Num: Nat
    | Var: Idx s;

anx lam aff_num {s: Nat} (c: Nat): AffK s = (AffK s)#Num c;
anx lam aff_var {s: Nat} (k: Idx s): AffK s = (AffK s)#Var k;

lam aff_k {s: Nat} (k: AffK s, vals: «s; Nat»)@(core.pe.is_closed k): Nat =
    match k with
        | Num c => c
        | Var j => vals#j;

/// `k` if it is a literal, else `0`.
lam aff_kstatic {s: Nat} (k: AffK s)@(core.pe.is_closed k): Nat =
    match k with
        | Num c => c
        | Var _ => 0;

/// One coordinate of an access map over `n` loop coordinates and `s` run-time symbols; the constructors mirror `affine.*`.
anx nom AffE (n s: Nat) =
    | Dim:  Idx n
    | Sym:  Idx s
    | Lit:  Nat
    | Add:  [AffE (n, s), AffE (n, s)]
    | Mul:  [AffE (n, s), AffK s]
    | FDiv: [AffE (n, s), AffK s]
    | CDiv: [AffE (n, s), AffK s]
    | Mod:  [AffE (n, s), AffK s]
    | Sub:  [AffE (n, s), AffE (n, s)];

/// An access map from `n` loop coordinates to `m` buffer coordinates, kept as data so that PE both evaluates it and computes the boxes it touches.
/// The trees are static; `vals` holds the run-time values of their symbols.
anx nom Aff (n m: Nat) = [s: Nat, vals: «s; Nat», rows: «m; AffE (n, s)»];

anx lam aff_dim  {n s: Nat} (d: Idx n): AffE (n, s) = (AffE (n, s))#Dim d;
anx lam aff_sym  {n s: Nat} (k: Idx s): AffE (n, s) = (AffE (n, s))#Sym k;
anx lam aff_lit  {n s: Nat} (c: Nat): AffE (n, s) = (AffE (n, s))#Lit c;
anx lam aff_add  {n s: Nat} (x y: AffE (n, s)): AffE (n, s) = (AffE (n, s))#Add (x, y);
anx lam aff_mul  {n s: Nat} (x: AffE (n, s), c: AffK s): AffE (n, s) = (AffE (n, s))#Mul (x, c);
anx lam aff_fdiv {n s: Nat} (x: AffE (n, s), c: AffK s): AffE (n, s) = (AffE (n, s))#FDiv (x, c);
anx lam aff_cdiv {n s: Nat} (x: AffE (n, s), c: AffK s): AffE (n, s) = (AffE (n, s))#CDiv (x, c);
anx lam aff_mod  {n s: Nat} (x: AffE (n, s), c: AffK s): AffE (n, s) = (AffE (n, s))#Mod (x, c);
anx lam aff_sub  {n s: Nat} (x y: AffE (n, s)): AffE (n, s) = (AffE (n, s))#Sub (x, y);
anx lam aff_map  {n m s: Nat} (vals: «s; Nat», rows: «m; AffE (n, s)»): Aff (n, m) = (s, vals, rows) inj Aff (n, m);
/// The projection onto the loop coordinates `dims`.
anx lam aff_proj {n m: Nat} (dims: «m; Idx n»): Aff (n, m) = aff_map @(n, m, 0) ((), ‹i: m; aff_dim @(n, 0) (dims#i)›);
/// The projection onto the loop coordinates `dims`, shifted by the run-time offsets `off`.
anx lam aff_offset {n m: Nat} (dims: «m; Idx n», off: «m; Nat»): Aff (n, m) =
    aff_map @(n, m, m) (off, ‹i: m; aff_add @(n, m) (aff_dim @(n, m) (dims#i), aff_sym @(n, m) i)›);

lam aff_eval {n s: Nat} (e: AffE (n, s), vals: «s; Nat», x: «n; affine.Index»)@(core.pe.is_closed e): affine.Index =
    match e with
        | Dim d  => x#d
        | Sym k  => affine.lit (vals#k)
        | Lit c  => affine.lit c
        | Add p  => affine.op.add (aff_eval (p#0₂, vals, x), aff_eval (p#1₂, vals, x))
        | Mul p  => affine.semiop.mul (aff_eval (p#0₂, vals, x), aff_k (p#1₂, vals))
        | FDiv p => affine.semiop.floordiv (aff_eval (p#0₂, vals, x), aff_k (p#1₂, vals))
        | CDiv p => affine.semiop.ceildiv (aff_eval (p#0₂, vals, x), aff_k (p#1₂, vals))
        | Mod p  => affine.semiop.rem (aff_eval (p#0₂, vals, x), aff_k (p#1₂, vals))
        | Sub p  => affine.op.sub (aff_eval (p#0₂, vals, x), aff_eval (p#1₂, vals, x));

/// The map that evaluates the rows of `f`.
anx lam aff_eval_map {n m: Nat} (f: Aff (n, m)) (o: «n; affine.Index»): «m; affine.Index» = ‹i: m; aff_eval (f#rows#i, f#vals, o)›;

/// `k` over `t` symbols, its symbol moved up by `o`.
lam aff_k_shift {s t: Nat} (k: AffK s, o: Nat)@(core.pe.is_closed k): AffK t =
    match k with
        | Num c => aff_num @t c
        | Var j => aff_var @t (core.idx 0 t (core.nat.add (core.idx2nat j, o)));

/// `e` over `t` symbols, its symbols moved up by `o`.
lam aff_shift {n s t: Nat} (e: AffE (n, s), o: Nat)@(core.pe.is_closed e): AffE (n, t) =
    let go = λ (x: AffE (n, s)): AffE (n, t) = aff_shift @(n, s, t) (x, o);
    let k  = λ (c: AffK s): AffK t = aff_k_shift @(s, t) (c, o);
    match e with
        | Dim d  => aff_dim @(n, t) d
        | Sym j  => aff_sym @(n, t) (core.idx 0 t (core.nat.add (core.idx2nat j, o)))
        | Lit c  => aff_lit @(n, t) c
        | Add p  => aff_add @(n, t) (go p#0₂, go p#1₂)
        | Sub p  => aff_sub @(n, t) (go p#0₂, go p#1₂)
        | Mul p  => aff_mul @(n, t) (go p#0₂, k p#1₂)
        | FDiv p => aff_fdiv @(n, t) (go p#0₂, k p#1₂)
        | CDiv p => aff_cdiv @(n, t) (go p#0₂, k p#1₂)
        | Mod p  => aff_mod @(n, t) (go p#0₂, k p#1₂);

/// `e` with each loop coordinate `d` replaced by `sub#d`, over the first of `t` symbols.
lam aff_subst {k n s t: Nat} (e: AffE (k, s), sub: «k; AffE (n, t)»)@(core.pe.is_closed e): AffE (n, t) =
    let go = λ (x: AffE (k, s)): AffE (n, t) = aff_subst @(k, n, s, t) (x, sub);
    let c  = λ (x: AffK s): AffK t = aff_k_shift @(s, t) (x, 0);
    match e with
        | Dim d  => sub#d
        | Sym j  => aff_sym @(n, t) (core.idx 0 t (core.idx2nat j))
        | Lit l  => aff_lit @(n, t) l
        | Add p  => aff_add @(n, t) (go p#0₂, go p#1₂)
        | Sub p  => aff_sub @(n, t) (go p#0₂, go p#1₂)
        | Mul p  => aff_mul @(n, t) (go p#0₂, c p#1₂)
        | FDiv p => aff_fdiv @(n, t) (go p#0₂, c p#1₂)
        | CDiv p => aff_cdiv @(n, t) (go p#0₂, c p#1₂)
        | Mod p  => aff_mod @(n, t) (go p#0₂, c p#1₂);

/// The rows of `f` followed by those of `g`; the symbols of `f` come first.
anx lam aff_cat {n a b: Nat} (f: Aff (n, a), g: Aff (n, b)): Aff (n, core.nat.add (a, b)) =
    let t = core.nat.add (f#s, g#s);
    let m = core.nat.add (a, b);
    aff_map @(n, m, t) (vec.cat (f#vals, g#vals),
        ‹i: m; let ii = core.idx2nat i;
               core.select (ii < a, aff_shift @(n, f#s, t) (f#rows#(core.idx 0 a ii), 0),
                                    aff_shift @(n, g#s, t) (g#rows#(core.idx 0 b (core.nat.sub (ii, a))), f#s))›);

/// `f ∘ g`: the map that reads `f` at the coordinates `g` gives; the symbols of `f` come first.
anx lam aff_compose {n k m: Nat} (f: Aff (k, m), g: Aff (n, k)): Aff (n, m) =
    let t   = core.nat.add (f#s, g#s);
    let sub = ‹d: k; aff_shift @(n, g#s, t) (g#rows#d, f#s)›;
    aff_map @(n, m, t) (vec.cat (f#vals, g#vals), ‹i: m; aff_subst @(k, n, f#s, t) (f#rows#i, sub)›);

/// The projection onto the loop coordinates `dims`, given as naturals.
anx lam aff_projn {n m: Nat} (dims: «m; Nat»): Aff (n, m) = aff_proj @(n, m) ‹i: m; core.idx 0 n (dims#i)›;
pub lam affd {n s: Nat} (k: Nat): AffE (n, s) = aff_dim @(n, s) (core.idx 0 n k);
pub lam affa {n s: Nat} (x y: AffE (n, s)): AffE (n, s) = aff_add @(n, s) (x, y);
pub lam affm {n s: Nat} (x: AffE (n, s), j: Nat): AffE (n, s) = aff_mul @(n, s) (x, aff_var @s (core.idx 0 s j));
pub lam afff {n s: Nat} (x: AffE (n, s), j: Nat): AffE (n, s) = aff_fdiv @(n, s) (x, aff_var @s (core.idx 0 s j));
pub lam affr {n s: Nat} (x: AffE (n, s), j: Nat): AffE (n, s) = aff_mod @(n, s) (x, aff_var @s (core.idx 0 s j));
pub lam affc {n s: Nat} (x: AffE (n, s), j: Nat): AffE (n, s) = aff_cdiv @(n, s) (x, aff_var @s (core.idx 0 s j));
/// The identity over `r` loops.
anx lam aff_idn (r: Nat): Aff (r, r) = aff_proj @(r, r) ‹i: r; i›;
/// The product of `s#j` for `from <= j`, the stride of a row-major layout.
lam aff_stride {n: Nat} (s: «n; Nat», from: Nat): Nat = vec.fold.l core.nat.mul (1, ‹j: n; core.select (core.idx2nat j < from, 1, s#j)›);
/// `o ↦ delinearize (linearize (o, s_out), s_in)`.
anx lam reshape_aff {r_in r_out: Nat} (s_in: «r_in; Nat», s_out: «r_out; Nat»): Aff (r_out, r_in) =
    let t    = core.nat.add (core.nat.add (r_out, r_in), r_in);
    let vals = ‹j: t; let jj = core.idx2nat j;
                      core.select (jj < r_out, aff_stride (s_out, jj + 1),
                      core.select (jj < r_out + r_in, aff_stride (s_in, jj - r_out + 1), s_in#(core.idx 0 r_in (jj - r_out - r_in))))›;
    let term = λ (k: Nat): AffE (r_out, t) = affm (affd @(r_out, t) k, k);
    let lin  = vec.fold.r (affa @(r_out, t)) (‹k: r_out - 1; term (core.idx2nat k)›, term (r_out - 1));
    aff_map @(r_out, r_in, t) (vals, ‹k: r_in; let kk = core.idx2nat k; affr (afff (lin, r_out + kk), r_out + r_in + kk)›);
///
/// ### map_reduce_post
///
/// The workhorse behind every tensor operation: a reduction fold over an affinely-indexed loop nest.
/// The loop vector `(o…, r…)` has length `Rn`; its leading `Ro` dims are the parallel output loops,
/// the trailing ones the reduction loops that are folded away.
///
/// - `Sr`, `So`: the full loop bounds and the result shape (rank `Ro`).
///   `So` may differ from the leading `Ro` bounds of `Sr` — that is what lets `map_out` write to a
///   re-shaped output, e.g. a transpose.
/// - `f`: folds one element of each input into the accumulator, seeded per output cell with `init`.
/// - `post`: maps the folded accumulator, plus one element of each of the `nps` *epilogue inputs*
///   `post_is`, to the stored element.
///   It runs once per output cell, between fold and write-back — the slot `fuse_tensor` composes
///   trailing elementwise maps into (bias + activation after a convolution or matrix product).
/// - `map_out`: full loop vector ↦ the `Ro` write coordinates in `«So»`.
///   The reduction is folded away before the write, so it may only depend on the leading `Ro` indices.
/// - `maps#i`: full loop vector ↦ the `Ris#i` read coordinates of input `i`.
///   Transposes, slices and broadcasts are expressed here.
/// - `post_maps#j`: the `Ro` *output-cell* coordinates (the write coordinates `map_out` produces) ↦
///   the read coordinates of epilogue input `j`; epilogue inputs are read once per output cell, not
///   per loop iteration.
/// - `sched`: the op's **schedule**, selected in the frontend via the `Tileable` machinery below and
///   carried as an ordinary operand through fusion — a target-agnostic chooser (canonically a
///   `mk_sched` value) that, handed the target's loop-nest builder, returns the nest to run.
///   The lowering only binds it and **applies** the result to the op's decision-free fold step and
///   write-back, so unrolling, interchange and vectorization are plain IR, not lowering behavior.
///
/// The total loop count `Rn` is stated instead of the reduction count `Rr = Rn - Ro`: a
/// `core.nat.add (Ro, Rr)` in the domain cannot be inverted by type inference and every call site
/// would have to pass the whole meta group explicitly with `@`, whereas `Sr` pins `Rn` structurally.
///
/// `nis`, `nps`, `Ro`, `Rn`, `Ris` and `Rps` must be literals before the `tensor::Lower` phase; the
/// bounds `So` and `Sr` may stay symbolic.
///
axm map_reduce_post: {nis nps: Nat}
                   → {To Tp: *, Ro Rn: Nat, TSched: □}
                   → [So: «Ro; Nat», Sr: «Rn; Nat», sched: TSched]
                   → {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»,
                      Tps: «nps; *», Rps: «j: nps; Nat», Sps: «j: nps; «Rps#j; Nat»»}
                   → [f: Fn [To, «i: nis; Tis#i»] → To, init: To, post: Fn [To, «j: nps; Tps#j»] → Tp]
                   → [map_out: Aff (Rn, Ro)]
                   → [maps: «i: nis; Aff (Rn, Ris#i)», post_maps: «j: nps; Aff (Ro, Rps#j)»]
                   → [is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)», post_is: «j: nps; Tensor (Rps#j) (Sps#j) (Tps#j)»]
                   → Tensor Ro So Tp;
///
/// ### Sched, SchedT, mk_sched
///
/// The schedule record (`vdim`, `unroll`), the type of a schedule **chooser** over the target's loop-nest
/// builder, and the canonical chooser.
/// Aliases for the `btensor` definitions, which `btensor` owns for the same reason it owns `btensor.Ring`.
anx Sched    = btensor.Sched;
anx SchedT   = btensor.SchedT;
anx mk_sched = btensor.mk_sched;
///
/// ### map_reduce
///
/// `map_reduce_post` without the epilogue and with the neutral schedule: delegates with `post = id`
/// (so `Tp = To`), no epilogue inputs (`nps = 0`), no vector dim (`vdim = Rn`, the out-of-range
/// sentinel), and no unrolling.
/// `Rn` is stated instead of `Rr` for the same reason as there.
anx lam map_reduce {nis: Nat} {To: *, Ro Rn: Nat}
                   (So: «Ro; Nat», Sr: «Rn; Nat»)
                   {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                   (f: Fn [To, «i: nis; Tis#i»] → To, init: To)
                   (map_out: Aff (Rn, Ro))
                   (maps: «i: nis; Aff (Rn, Ris#i)»)
                   (is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)»): Tensor Ro So To =
    map_reduce_post (So, Sr, mk_sched (Rn, 0)) (f, init, id @To) map_out (maps, ()) (is, ());
///
/// ### proj_map
///
/// The access map that reads input axis `j` at loop variable `subs#j`, e.g. `((0, 2), (2, 1))` for the two inputs of a matrix product.
anx lam proj_map {n m: Nat} (subs: «m; Nat»): Aff (n, m) = aff_projn @(n, m) subs;
///
/// ## Shape Operations
///
/// Pure re-indexing: every element of the result is one element of an input, so the operation lives
/// entirely in the access map.
///
/// ### broadcast
///
/// Expands the dimensions of `input` to fit `s_out`:
/// for all `i`, either `s_in#i = s_out#i` or `s_in#i = 1`, and the size-1 dimensions are expanded to fit `s_out`.
///
/// Lowered directly to packs by the `LowerMapReduce` phase (`lower_broadcast`): a size-1 axis broadcast to `n`
/// becomes a `‹n; …›` pack instead of a copy loop.
axm broadcast: {T: *, r: Nat}
             → [s_in s_out: «r; Nat», input: Tensor r s_in T]
             → Tensor r s_out T, normalize_broadcast;
///
/// ### broadcast_in_dim
///
/// Transposes and expands the dimensions of `input` to fit `s_out`.
/// Each input dimension is mapped to the output dimension given by `index`; the holes are filled by broadcasting.
///
/// @todo We could probably implement this in terms of `broadcast` and `transpose` directly.
///
axm broadcast_in_dim: {T: *, r_in r_out: Nat}
                    → [s_in: «r_in; Nat», s_out: «r_out; Nat», input: Tensor r_in s_in T, index: «r_in; Idx r_out»]
                    → Tensor r_out s_out T, normalize_broadcast_in_dim;
///
/// ### concat_acc
///
/// Accumulator for the axis-sum: adds `row#ax` to the running total.
lam concat_acc {r: Nat} (ax: Idx r) (acc: Nat, row: «r; Nat»): Nat = acc + row#ax;
///
/// ### concat_shape
///
/// `(ax, Sis) ↦ s_out`: sums the inputs' extents along `ax`, keeps the shared extents on every other
/// axis.
lam concat_shape {nis r: Nat} (ax: Idx r, Sis: «nis; «r; Nat»»): «r; Nat» =
    let sum_ax = vec.fold.l (concat_acc ax) (0, Sis);
    let row_0  = Sis#(core.idx 0 nis 0);
    ‹d: r; core.select (core.icmp.e (d, ax), sum_ax, row_0#d)›;
///
/// ### concat
///
/// Joins `nis` inputs along axis `ax`. All inputs share rank `r` and agree on every axis except `ax`;
/// the output extent along `ax` is the sum of the inputs' extents there (`s_out#ax = Σ_i Sis#i#ax`).
/// `out[…o…] = is#k[… o with o#ax ↦ o#ax − off#k …]`, where `k` is the input whose range `o#ax` lands
/// in (`off` are the prefix sums of the per-input extents along `ax`).
///
/// The output shape is deduced from `ax` and the per-input shapes `Sis` (see `concat_shape`), so it is
/// not passed explicitly.
///
axm concat: {T: *, nis r: Nat}
          → [ax: Idx r]
          → {Sis: «i: nis; «r; Nat»»}
          → [is: «i: nis; Tensor r (Sis#i) T»]
          → Tensor r (concat_shape (ax, Sis)) T, normalize_concat;
///
/// ### flip
///
/// Reverses every axis: `out[…d…] = input[… (s_in#d − 1) − d …]`.
///
axm flip: {T: *, r: Nat}
        → [s_in: «r; Nat»]
        → [input: Tensor r s_in T]
        → Tensor r s_in T, normalize_flip;
///
/// ### pad_shape
///
lam pad_shape {r: Nat} (lo s_in hi: «r; Nat»): «r; Nat» =
    ‹d: r; lo#d + s_in#d + hi#d›;
///
/// ### pad
///
/// Pads each axis: `s_out#d = lo#d + s_in#d + hi#d`, rank preserved.
/// `out[…o…] = input[… o#d − lo#d …]` whenever every axis lands inside the input region;
/// otherwise the value depends on `mode`:
///
/// - `mode = 0` (constant): out-of-region cells take the scalar `value`.
/// - `mode = 1` (replicate): out-of-region cells take the nearest edge element (the read index is
///   clamped to `[0, s_in#d − 1]` per axis); `value` is ignored.
///
/// The output shape is deduced from `lo`, `s_in` and `hi` (see `pad_shape`), so it is not passed explicitly.
axm pad: {T: *, r: Nat}
       → [s_in: «r; Nat»]
       → [mode: Nat, lo hi: «r; Nat»]
       → [input: Tensor r s_in T, value: T]
       → Tensor r (pad_shape (lo, s_in, hi)) T, normalize_pad;
///
/// ### repeat
///
/// Tiles `input` to the larger shape `s_out` (each `s_out#d` must be a multiple of `s_in#d`): `out[…d…] = input[… d mod s_in#d …]`.
///
axm repeat: {T: *, r: Nat}
          → [s_in: «r; Nat»]
          → [s_out: «r; Nat»]
          → [input: Tensor r s_in T]
          → Tensor r s_out T, normalize_repeat;
///
/// ### reshape
///
/// Row-major reshape: `prod(s_in)` must equal `prod(s_out)`. Loops over the result and reads the input at the
/// delinearized linear index, so it works for arbitrary rank changes (e.g. flatten/unflatten).
///
/// `s_in` is explicit because `s_out` has a different rank and so cannot pin the input's
/// rank/element-type during inference.
axm reshape: {T: *, r_in r_out: Nat}
           → [s_in: «r_in; Nat»]
           → [s_out: «r_out; Nat»]
           → [input: Tensor r_in s_in T]
           → Tensor r_out s_out T, normalize_reshape;
///
/// ### slice
///
/// Strided slice / narrow: `out[…d…] = input[… start#d + step#d · d …]`. Same rank in/out; `s_out` gives the sliced
/// extents (the caller must ensure `start#d + step#d · (s_out#d − 1) < s_in#d`).
///
axm slice: {T: *, r: Nat}
         → [s_in: «r; Nat»]
         → [start step s_out: «r; Nat»]
         → [input: Tensor r s_in T]
         → Tensor r s_out T, normalize_slice;
///
/// ### transpose_shape
///
/// `(s, permutation) ↦ ‹i; s#(permutation⁻¹#i)›`: the permuted shape.
lam transpose_shape {r: Nat} (s: «r; Nat», permutation: «r; Idx r»): «r; Nat» =
    let shape_permutation = ‹i: r; option.unwrap_unsafe (vec.first core.icmp.e (permutation, i))›;
    ‹i: r; s#(shape_permutation#i)›;
///
/// ### transpose
///
/// Permutes the dimensions of `input` according to `permutation`.
/// Input axis `j` becomes output axis `permutation#j`, so `out#i = s#(permutation⁻¹#i)` — the inverse of the StableHLO/NumPy convention.
///
/// `permutation` precedes `input`, and `{s}` is a *separate* implicit group introduced after it, so that `{T, r, s}`
/// can be inferred: `permutation: «r; Idx r»` pins the rank `r`, and only then is the `{s}` Hole created — with the
/// now-literal type `«r; Nat»`, which lets `input: Tensor r s T` infer its shape index.
axm transpose: {T: *, r: Nat}
             → [permutation: «r; Idx r»]
             → {s: «r; Nat»}
             → [input: Tensor r s T]
             → Tensor r (transpose_shape (s, permutation)) T, normalize_transpose;
///
/// ### transpose_2d
///
/// Permutes the dimensions of a 2-dimensional tensor.
///
anx lam transpose_2d {T: *} {s: «2; Nat»} (input: Tensor 2 s T): Tensor 2 (s#tt, s#ff) T = transpose (tt, ff) input;
///
/// ## Element-wise Operations
///
/// Apply a scalar function at every coordinate.
///
/// ### binary
///
/// Maps a binary function over a pair of tensors.
///
axm binary: {Ti1 Ti2 To: *}
          → [app: [Ti1, Ti2] → To]
          → {r: Nat, s: «r; Nat»}
          → [is: [Tensor r s Ti1, Tensor r s Ti2]]
          → Tensor r s To;
///
/// ### map
///
/// Maps a function over a collection of tensors.
///
axm map: {T: *, ni: Nat, Is: «ni; *»}
       → [app: «i: ni; Is#i» → T]
       → {r: Nat, s: «r; Nat»}
       → [is: «i: ni; Tensor r s (Is#i)»]
       → Tensor r s T;
///
/// ### select
///
/// Maps `core.select` over tensors.
///
axm select: {T: *}
          → {r: Nat, s: «r; Nat»}
          → [is: [Tensor r s Bool, Tensor r s T, Tensor r s T]]
          → Tensor r s T;
///
/// ### unary
///
/// Maps a unary function over a tensor.
///
axm unary: {Ti To: *}
         → [app: Ti → To]
         → {r: Nat, s: «r; Nat»}
         → [i: Tensor r s Ti]
         → Tensor r s To;
///
/// ## Reductions
///
/// Operations that fold one or more reduction dims away.
///
/// ### bmm
///
/// Computes the batch matrix multiplication (BMM) of two 3-dimensional tensors — a special case of `dot_product`.
///
axm bmm: [R: Ring]
       → {B M K N: Nat}
       → [t1: Tensor 3 (B, M, K) (R#T), t2: Tensor 3 (B, K, N) (R#T)]
       → Tensor 3 (B, M, N) (R#T);
///
/// ### conv_shape
///
/// `(n, cout, (H, W), (KH, KW), stride, dilation, padding) ↦ (n, cout, OH, OW)`, where
/// \f$O_d = (s_d + 2 \cdot \mathit{padding}_d - (\mathit{dilation}_d \cdot (k_d - 1) + 1)) / \mathit{stride}_d + 1\f$:
/// the NCHW output shape.
pub lam conv_shape (n cout: Nat, s k stride dilation padding: «2; Nat»): «4; Nat» =
    let (hwx, hwy) = ‹d: 2; (s#(d) + 2 * padding#(d) - (dilation#(d) * (k#(d) - 1) + 1)) / stride#(d) + 1›;
    (n, cout, hwx, hwy);
///
/// ### conv
///
/// 2-D convolution (cross-correlation) in the ring `R`, `groups = 1`, no bias:
/// \f[
///     \mathit{out}_{n,co,oh,ow} = \sum_{ci,kh,kw} \mathit{padded}_{n,ci,ih,iw} \cdot \mathit{weight}_{co,ci,kh,kw},
///     \qquad ih = \mathit{stride}_0 \cdot oh + \mathit{dilation}_0 \cdot kh,
///     \qquad iw = \mathit{stride}_1 \cdot ow + \mathit{dilation}_1 \cdot kw
/// \f]
///
/// - Layout: `input: «N, Cin, H, W; R#T»`, `weight: «Cout, Cin, KH, KW; R#T»`,
///   `output: «N, Cout, OH, OW; R#T»`.
/// - `padding` zero-pads the spatial axes (composed via `pad`), so the windowed read is a pure affine
///   map.
/// - The output shape follows from the extents and window parameters (see `conv_shape`) and is not
///   passed explicitly.
///
axm conv: [R: Ring]
        → {n cin cout h w kh kw: Nat}
        → [stride dilation padding: «2; Nat»]
        → [input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, cin, kh, kw) (R#T)]
        → Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T);
///
/// ### conv_grouped
///
/// `conv` with the channels split into `groups` independent convolutions: output channel `co` only reads the
/// `ci = cin / groups` input channels of its group `co / (cout / groups)`.
///
/// - Layout: as for `conv`, but `weight: «Cout, Cin / groups, KH, KW; R#T»`.
/// - `groups` must divide both `cin` and `cout`.
axm conv_grouped: [R: Ring]
                → {n cin cout h w ci kh kw: Nat}
                → [groups: Nat, stride dilation padding: «2; Nat»]
                → [input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, ci, kh, kw) (R#T)]
                → Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T);
///
/// ### dot_general_shape
///
/// The result shape: the batching extents, then the left operand's free extents, then the right
/// operand's; the batching extents are checked to agree (the contracting ones in `dot_product_impl`).
lam dot_general_shape {r1 r2: Nat} {nc nb: Nat}
    (c1: «nc; Idx r1», c2: «nc; Idx r2», b1: «nb; Idx r1», b2: «nb; Idx r2»)
    (s1: «r1; Nat», s2: «r2; Nat») =
    let bs      = ‹i: nb; refly.check (s1#(b1#i) == s2#(b2#i), s1#(b1#i), "batching dims don't match")›;
    let bc_1    = vec.cat (b1, c1);
    let s1_res  = vec.diff (s1, bc_1);
    let bc_2    = vec.cat (b2, c2);
    let s2_res  = vec.diff (s2, bc_2);
    let s12_res = vec.cat (s1_res, s2_res);
    vec.cat (bs, s12_res);
///
/// ### dot_product
///
/// Returns the [generalized dot product](https://openxla.org/stablehlo/spec#dot_general) of `a` and `b`:
///
/// - `R`: the ring in which the dot product is performed
/// - `r1`/`r2`: the ranks of the two inputs
/// - `nc`/`nb`: the number of contracting/batching dimensions
/// - `c1`/`c2`: the contracting dimensions of the left/right input
/// - `b1`/`b2`: the batching dimensions of the left/right input
/// - `s1`/`s2`: the shape of the left/right input
/// - `a`/`b`: the left/right input
///
axm dot_product: [R: Ring]
               → {r1 r2: Nat}
               → {nc nb: Nat}
               → [c1: «nc; Idx r1», c2: «nc; Idx r2», b1: «nb; Idx r1», b2: «nb; Idx r2»]
               → {s1: «r1; Nat», s2: «r2; Nat»}
               → [a: Tensor r1 s1 (R#T), b: Tensor r2 s2 (R#T)]
               → Tensor (vec.len (dot_general_shape (c1, c2, b1, b2) (s1, s2))) (dot_general_shape (c1, c2, b1, b2) (s1, s2)) (R#T);
///
/// ### pool
///
/// 2-D pooling: reduces each `(kernel#0, kernel#1)` window of `input: «N, C, H, W; T»` with the fold
/// `g` seeded by `init` to `output: «N, C, OH, OW; T»`, each channel independently.
///
/// - `padding` pads the spatial axes with `init` (composed via `pad`), so padded cells are inert.
/// - Max-pooling is `g = max, init = −∞`; sum-/average-pooling is `g = +, init = 0` — divide by the
///   window size afterwards for the average.
/// - Unlike `conv` there is no weight, so the window size `kernel` is an explicit operand, and the
///   output spatial size `s_out = (OH, OW)` is passed explicitly.
///
axm pool: {T: *}
        → [g: [T, T] → T, init: T]
        → {n c h w: Nat}
        → [kernel stride dilation padding s_out: «2; Nat»]
        → [input: Tensor 4 (n, c, h, w) T]
        → Tensor 4 (n, c, s_out#0₂, s_out#1₂) T;
///
/// ### product_2d
///
/// Computes the matrix product of two 2-dimensional tensors — a special case of `dot_product`.
///
axm product_2d: [R: Ring]
              → {m k l: Nat}
              → [t1: Tensor 2 (m, k) (R#T), t2: Tensor 2 (k, l) (R#T)]
              → Tensor 2 (m, l) (R#T);
///
/// ## Indexing
///
/// Data-dependent access: an `index` tensor picks the coordinate along `dim`.
///
/// ### gather
///
/// Reads one source element for every index element:
///
/// - the output coordinate is also the index coordinate, except on `dim`, where the value loaded from
///   `index` selects the source coordinate;
/// - `s_idx#d <= s_src#d` is required for every `d != dim`;
/// - `dim: Idx r` and the index element type encode the axis and the indexed-source bounds in the type.
///
/// ```python
/// for out_index in ndindex(s_idx):
///     selected = index[out_index]
///     source_index = tuple(
///         selected if d == dim else out_index[d]
///         for d in range(r)
///     )
///     output[out_index] = input[source_index]
/// ```
axm gather: {T: *, r: Nat}
          → [s_src: «r; Nat», s_idx: «r; Nat»]
          → [dim: Idx r]
          → [input: Tensor r s_src T, index: Tensor r s_idx (Idx (s_src#dim))]
          → Tensor r s_idx T;
///
/// ### scatter
///
/// Starts with `input` and visits `index` in row-major order.
/// Each corresponding `updates` element is stored at the input coordinate selected by `index` on `dim`.
/// Duplicate destinations use the last visited update. For `d != dim`, `s_idx#d <= s_src#d`; on every axis, `s_idx#d <= s_updates#d`.
///
/// ```python
/// output = input.copy()
/// for update_coord in ndindex(s_idx):
///     selected = index[update_coord]
///     destination = tuple(
///         selected if d == dim else update_coord[d]
///         for d in range(r)
///     )
///     output[destination] = updates[update_coord]
/// ```
axm scatter: {T: *, r: Nat}
           → [s_src: «r; Nat», s_idx: «r; Nat», s_updates: «r; Nat»]
           → [dim: Idx r]
           → [input: Tensor r s_src T, index: Tensor r s_idx (Idx (s_src#dim)), updates: Tensor r s_updates T]
           → Tensor r s_src T;
///
/// ## Reflection
///
/// Compile-time queries about an operand that a schedule selector (see Tiling) branches on.
///
/// ### fastest_axis
///
/// Layout reflection for schedule selectors: which axis of the rank-`r` tensor `t` is the
/// fastest-varying (unit-stride) axis of the tensor **actually** read, once `fuse_tensor`'s
/// read-through has absorbed a pure re-indexed read behind `t` — behind a transpose the source's
/// trailing axis maps back to a different axis of `t`.
///
/// - a plain tensor (anything that is not such a read, a still-symbolic operand included): its own
///   last axis `r − 1`.
/// - an undecidable read (composed arithmetic like `reshape`, a nested read chain): the sentinel `r`.
///
/// This reflects only operand structure the frontend cannot inspect itself; the schedule **decision**
/// built on the answer stays in the IR next to the op (see `dot_product_impl`).
/// `tensor::Lower` applies it where the op's operands are concrete.
///
axm fastest_axis: {T: *} → [r: Nat, t: T] → Nat, normalize_fastest_axis;
///
/// ### if_static
///
/// Binding-time dispatch for schedule selectors, so that one selector serves compile-time and
/// runtime extents without staging annotations at the call site:
///
/// - `k` a literal: the normalizer picks `s`.
/// - `k` symbolic: stays stuck, keeping the choice open until instantiation.
/// - still stuck at lowering time: the lowerings residualize to `d`, since an undecided `k` is then a
///   runtime value.
axm if_static: {T: *} → [k: Nat, s d: T] → T, normalize_if_static;
///
/// ### cpu_knobs
///
/// The CPU blocking knobs `(vec_bytes, registers, cache, mr, nr, mc, nc, kc, order, dyn_k, pack_b, conv)` from `-X btensor:vec-bytes`, `-X tensor:group-registers`, `group-cache` and `cpu-{mr,nr,mc,nc,kc,order,dyn-k,pack-b,conv}`; a block size of `0` is derived.
axm cpu_knobs: [] → «12; Nat», normalize_cpu_knobs;
///
/// ### vec_width
///
/// Target reflection for schedule selectors: the machine's vector width, in elements of the schedule's fold type.
/// It is the number of lanes one vector register holds, and hence the widest block of independent accumulators a
/// vectorized loop body can keep in registers.
/// `d` is the width to answer when the compilation was not told one; `-X tensor:vec-width=<n>` (`1`, `4`, `8` or `16`)
/// overrides it, so a single world can be emitted for one target and re-emitted for another.
/// `1` describes a target without SIMD: no block is sized by lanes, and `reassoc` counts plain multiplications.
/// It does not stop the backend from vectorizing the loops a schedule nominates.
/// Like `fastest_axis` this only reflects what the frontend cannot inspect itself; the schedule **decision** built on
/// the answer stays in the IR next to the op (see `dot_schedule_kvec`).
/// `reassoc` charges its costs in units of the same width, so schedules and cost model agree on the target.
axm vec_width: [d: Nat] → Nat, normalize_vec_width;
///
/// ## Tiling
///
/// Tiling, strip-mining and schedule selection are implemented entirely in the frontend IR, with
/// partial evaluation doing the rewriting; no C++ transformation code.
///
/// ### Tileable
///
/// A `Tileable` existentially packages a computation over an affinely-indexed iteration domain
/// together with its **schedule** (cf. MLIR's TilingInterface):
///
/// - `Out`: the result *type constructor* — what materializing over a domain with `ro` parallel
///   dims of extents `so` yields.
/// - the iteration domain `Sr` (leading `Ro` parallel dims, trailing `Rr` reduction dims) and the
///   result shape `So` — MLIR's getIterationDomain + getLoopIteratorTypes.
/// - `oax`: which output axis each parallel dim writes — the piece of the write map the domain
///   transforms need (`strip_mine_par` splits the output along `oax#d`).
/// - the schedule `sched` (see `Sched`): the record `retile` packs into the op's chooser.
/// - `retile`: rebuild the computation over a *reindexed* domain, given the new domain and
///   schedule, `iota` (maps new loop vectors to old loop vectors) and `omega` (maps (old output
///   coordinates, new loop vector) to new output coordinates).
///
/// The op's internals (combiner, init, epilogue, inputs, access maps) stay hidden in the closure.
let Tileable = [
    Out: [ro: Nat, so: «ro; Nat»] → *,
    Ro: Nat, Rr: Nat,
    So: «Ro; Nat»,
    oax: «Ro; Nat»,
    Sr: «Ro + Rr; Nat»,
    sched: Sched,
    retile: [Ro_n Rr_n: Nat]
          → [So_n: «Ro_n; Nat», Sr_n: «Ro_n + Rr_n; Nat», sched_n: Sched]
          → [iota: Aff (Ro_n + Rr_n, Ro + Rr), omega: Aff (Ro + (Ro_n + Rr_n), Ro_n)]
          → Out (Ro_n, So_n),
];
///
/// #### comp_map
///
/// Composition helper for access maps: (m ∘ g).
///
lam comp_map {A B C: *} (m: B → C, g: A → B) (o: A): C = m (g o);
///
/// #### interchange
///
/// Permute the loop dims — new loop `j` iterates old dim `perm#j`. Loop order and write
/// position are decoupled by the write map, so So is untouched. The permutation must keep parallel
/// dims parallel (`perm#j < Ro` iff `j < Ro`), enforced at compile time; the schedule's `vdim` moves to
/// its new position.
anx lam interchange (t: Tileable, perm: «t#Ro + t#Rr; Nat»): Tileable =
    let r = t#Ro + t#Rr;
    let perm_ok = ‹j: r; let jj = core.idx2nat j;
                         refly.check (core.icmp.e @2 (jj < t#Ro, perm#j < t#Ro),
                                       perm#j,
                                       "interchange: permutation must not mix parallel and reduction dims")›;
    let sr_n   = ‹i: r; t#Sr#(core.idx 0 r (perm_ok#i))›;
    let vdim_n = match vec.first `== (perm_ok, t#sched#vdim) with
                     | Some j => core.idx2nat j
                     | None   => t#sched#vdim;
    // The parallel dims permute among themselves (checked above), so the new dim j writes the
    // output axis its old dim perm#j wrote.
    let oax_n = ‹j: t#Ro; t#oax#(core.idx 0 (t#Ro) (perm_ok#(core.idx 0 r (core.idx2nat j))))›;
    // iota: old dim i is found at the new position j with perm#j = i.
    let iota_p = aff_proj @(r, r) ‹i: r; option.unwrap_unsafe (vec.first `== (perm_ok, core.idx2nat i))›;
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «ro_m + rr_m; Nat», sched_m: Sched)
                 (iota: Aff (ro_m + rr_m, r), omega: Aff (t#Ro + (ro_m + rr_m), ro_m))
               : t#Out (ro_m, so_m) =
        t#retile (ro_m, rr_m) (so_m, sr_m, sched_m) (aff_compose (iota_p, iota), omega);
    (t#Out, t#Ro, t#Rr, t#So, oax_n, sr_n, (t#sched)#vdim ← vdim_n, retile_n);
///
/// #### materialize
///
/// Materialize a `Tileable` over its current domain and schedule (identity reindexing).
anx lam materialize (t: Tileable): t#Out (t#Ro, t#So) =
    let r = t#Ro + t#Rr;
    t#retile (t#Ro, t#Rr) (t#So, t#Sr, t#sched)
        (aff_proj @(r, r) ‹i: r; i›, aff_proj @(t#Ro + r, t#Ro) ‹i: t#Ro; core.idx 0 (t#Ro + r) (core.idx2nat i)›);
///
/// #### mr_tileable
///
/// The `map_reduce_post` instance, the SSA analog of MLIR's getTiledImplementation: `retile` rebuilds
/// the same op over the new domain, composing the access maps with `iota` and the write map with
/// `omega`.
///
/// - No extract/insert_slice machinery — the tiled reads hit the original inputs through the
///   reindexed access maps.
/// - Epilogue-free (`nps = 0`): impls build raw ops and the epilogue arrives later via `fuse_tensor`,
///   because epilogue-input access maps take output-cell coordinates, whose rank a domain transform
///   may change.
/// - `oax` states which output axis `map_out` writes each parallel dim to — the identity for the
///   impls' projection write maps.
anx lam mr_tileable
                {nis: Nat}
                {Ro Rr: Nat}
                {To Tp: *}
                (So: «Ro; Nat», oax: «Ro; Nat», Sr: «Ro + Rr; Nat»)
                {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
                (f: Fn [To, «i: nis; Tis#i»] → To, init: To, post: Fn [To, []] → Tp)
                (map_out: Aff (Ro + Rr, Ro))
                (maps: «i: nis; Aff (Ro + Rr, Ris#i)»)
                (is: «i: nis; Tensor (Ris#i) (Sis#i) (Tis#i)»)
              : Tileable =
    lam out_t (ro: Nat, so: «ro; Nat»): * = Tensor ro so Tp;
    lam retile (Ro_n Rr_n: Nat)
               (So_n: «Ro_n; Nat», Sr_n: «Ro_n + Rr_n; Nat», sched_n: Sched)
               (iota: Aff (Ro_n + Rr_n, Ro + Rr), omega: Aff (Ro + (Ro_n + Rr_n), Ro_n))
             : Tensor Ro_n So_n Tp =
        let rn  = Ro_n + Rr_n;
        let cur = aff_cat (aff_compose (map_out, iota), aff_proj @(rn, rn) ‹i: rn; i›);
        map_reduce_post @(nis, 0) @(To, Tp, Ro_n, Ro_n + Rr_n, SchedT)
            (So_n, Sr_n, mk_sched sched_n)
            @(Tis, Ris, Sis, (), (), ()) (f, init, post)
            (aff_compose (omega, cur))
            (‹i: nis; aff_compose (maps#i, iota)›, ())
            (is, ());
    (out_t, Ro, Rr, So, oax, Sr, (Ro + Rr, 0), retile);
///
/// #### unroll_trailing
///
/// Fully unroll the trailing `d` reduction dims into the loop body — e.g. a
/// convolution's kh·kw window (`d = 2`). Their trip counts must be literals at lowering time.
lam unroll_trailing (t: Tileable, d: Nat): Tileable = t#sched#unroll ← d;
///
/// #### vectorize
///
/// Run dim `d` as the innermost, unit-stride vector loop (per-cell fold order is
/// unchanged). A parallel `d` runs inside the reduction loops over a row of accumulators; the
/// innermost reduction dim as `d` selects `btensor.mr_nest`'s reduction-vectorized nest instead.
lam vectorize (t: Tileable, d: Nat): Tileable = t#sched#vdim ← d;
///
/// ### Strip-Mining
///
/// Strip-mining is a pure **domain** transform (cf. TilingInterface's `op[N] → op[N/ts, ts]`) that
/// `retile` absorbs entirely: `iota` recombines the split loop vector, and for a parallel dim `omega`
/// splits the write coordinate.
/// The result is an ordinary `map_reduce_post` over a higher-rank domain with composed access maps —
/// schedule operand and lowering untouched.
/// Classic cache tiling is composition: strip-mine, then `interchange` the tile loops outward.
///
/// #### check_div
///
/// Checks that `ts` exactly divides the extent `sd` (discharges symbolically for factored extents).
lam check_div (sd ts: Nat): Nat =
    refly.check (sd / ts * ts == sd, sd, "strip_mine: tile size must divide the extent");
///
/// #### shift_ax
///
/// Axis renumbering after inserting a new axis at position `a`.
lam shift_ax (a x: Nat): Nat = core.select (x < a, x, x + 1);
///
/// #### split_bounds
///
/// Split bounds vector `v` (length `n`) at dim `d` into `(nt, ts)`; the result arity `m` (`= n+1`) is
/// passed explicitly, in the syntactic form the call site's types require (the checker does not
/// re-associate `core.nat.add` symbolically).
lam split_bounds (m n: Nat, v: «n; Nat», d ts nt: Nat): «m; Nat» =
    ‹i: m; let ii = core.idx2nat i;
           core.select (ii < d, v#(core.idx 0 n ii),
           core.select (ii == d, nt,
           core.select (ii == d + 1, ts,
           v#(core.idx 0 n (ii - 1)))))›;
///
/// #### split_iota_aff
///
/// Recombine a split loop vector (`m = n+1`): `old#d = new#d · ts + new#(d+1)`.
lam split_iota_aff (m n d ts: Nat): Aff (m, n) =
    let dim = affd @(m, 1);
    aff_map @(m, n, 1) (ts, ‹j: n; let jj = core.idx2nat j;
        core.select (jj < d, dim jj, core.select (jj == d, affa (affm (dim d, 0), dim (d + 1)), dim (jj + 1)))›);
///
/// #### split_omega_aff
///
/// Split an output coordinate vector (`m = n+1`): `new#a = old#a ⌊/⌋ ts`, `new#(a+1) = old#a mod ts`.
lam split_omega_aff (m n a ts: Nat): Aff (n, m) =
    let dim = affd @(n, 1);
    aff_map @(n, m, 1) (ts, ‹j: m; let jj = core.idx2nat j;
        core.select (jj < a, dim jj,
        core.select (jj == a, afff (dim a, 0),
        core.select (jj == a + 1, affr (dim a, 0), dim (core.nat.sub (jj, 1)))))›);
///
/// #### strip_mine_par
///
/// Split parallel dim `d` (d < Ro) into two adjacent parallel dims. The result
/// shape splits along the output axis `d` writes (`oax#d`), so the materialized tensor is *packed*
/// (`«…, N/ts, ts, …»` along that axis); a row-major `reshape` restores the original shape — and in a
/// fused graph `fuse_tensor`'s read-through absorbs it into the consumers' access maps.
anx lam strip_mine_par (t: Tileable, d ts: Nat): Tileable =
    let r    = t#Ro + t#Rr;
    let ro_n = t#Ro + 1;
    let r_n  = t#Ro + 1 + t#Rr;
    let a    = t#oax#(core.idx 0 (t#Ro) d);
    let sd   = refly.check (t#So#(core.idx 0 (t#Ro) a) == t#Sr#(core.idx 0 r d),
                             t#Sr#(core.idx 0 r d),
                             "strip_mine_par: output extent (at oax#d) must match domain extent");
    let nt   = check_div (sd, ts) / ts;
    // The split dim writes the split axis pair; all other dims write their old axis, renumbered
    // around the insertion at `a`. The unit-stride half is the inner one: a vdim at `d` moves to
    // `d + 1`.
    let oax_n = ‹j: ro_n; let jj = core.idx2nat j;
                          core.select (jj < d, shift_ax (a, t#oax#(core.idx 0 (t#Ro) jj)),
                          core.select (jj == d, a,
                          core.select (jj == d + 1, a + 1,
                          shift_ax (a, t#oax#(core.idx 0 (t#Ro) (jj - 1))))))›;
    // FIXME: a reduction vdim is reset to none here instead of moving to `vdim + 1`.
    let vd     = t#sched#vdim;
    let vdim_n = core.select (vd < t#Ro, core.select (vd < d, vd, vd + 1), r_n);
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «ro_m + rr_m; Nat», sched_m: Sched)
                 (iota: Aff (ro_m + rr_m, r_n), omega: Aff (ro_n + (ro_m + rr_m), ro_m))
               : t#Out (ro_m, so_m) =
        let rm   = ro_m + rr_m;
        let dom  = t#Ro + rm;
        let outs = aff_proj @(dom, t#Ro) ‹i: t#Ro; core.idx 0 dom (core.idx2nat i)›;
        let lps  = aff_proj @(dom, rm) ‹i: rm; core.idx 0 dom (t#Ro + core.idx2nat i)›;
        let split = aff_cat (aff_compose (split_omega_aff (ro_n, t#Ro, a, ts), outs), lps);
        t#retile (ro_m, rr_m) (so_m, sr_m, sched_m) (aff_compose (split_iota_aff (r_n, r, d, ts), iota), aff_compose (omega, split));
    (t#Out, ro_n, t#Rr,
     split_bounds (ro_n, t#Ro, t#So, a, ts, nt), oax_n,
     split_bounds (r_n, r, t#Sr, d, ts, nt), (t#sched)#vdim ← vdim_n, retile_n);
///
/// #### strip_mine_red
///
/// Split reduction dim `d` (Ro ≤ d < Ro + Rr) of extent N into two adjacent
/// reduction dims (N/ts, ts). If the split lands inside the trailing unroll window, both halves
/// unroll — the tap count is unchanged.
anx lam strip_mine_red (t: Tileable, d ts: Nat): Tileable =
    let r   = t#Ro + t#Rr;
    let r_n = t#Ro + (t#Rr + 1);
    let nt  = check_div (t#Sr#(core.idx 0 r d), ts) / ts;
    let vd       = t#sched#vdim;
    let un       = t#sched#unroll;
    let vdim_n   = core.select (vd < t#Ro, vd, r_n);
    let unroll_n = core.select (d < r - un, un, un + 1);
    lam retile_n (ro_m rr_m: Nat)
                 (so_m: «ro_m; Nat», sr_m: «ro_m + rr_m; Nat», sched_m: Sched)
                 (iota: Aff (ro_m + rr_m, r_n), omega: Aff (t#Ro + (ro_m + rr_m), ro_m))
               : t#Out (ro_m, so_m) =
        t#retile (ro_m, rr_m) (so_m, sr_m, sched_m) (aff_compose (split_iota_aff (r_n, r, d, ts), iota), omega);
    (t#Out, t#Ro, t#Rr + 1, t#So, t#oax,
     split_bounds (r_n, r, t#Sr, d, ts, nt), ((t#sched)#vdim ← vdim_n)#unroll ← unroll_n, retile_n);

/// ### Schedules
///
/// A `Schedule` is just a `Tileable` transformer, a **selector** a compile-time inspection of an op's
/// parameters returning the appropriate one — combinator composition, dispatched as an extract over
/// thunks so that partial evaluation resolves it entirely.
/// This is where "when is a transformation appropriate" lives: in the IR next to the op, not in a
/// lowering heuristic.
///
/// #### Schedule
///
/// A transformer of `Tileable`s.
let Schedule = Tileable → Tileable;
///
/// #### sched_id
///
lam sched_id (t: Tileable): Tileable = t;
///
/// #### unroll_budget
///
/// The greedy trailing-suffix unroll scan (the old lowering's budget scan): the number of trailing
/// reduction dims whose tap product stays within `budget`. Folded innermost-first over the
/// reduction dims with state (count, taps, alive); a dim whose extent is still open at lowering
/// time stops the scan (`if_static` residualizes its step to "over budget").
lam unroll_budget (t: Tileable, budget: Nat): Nat =
    let r = t#Ro + t#Rr;
    lam step (d: Nat, (cnt taps alive: Nat)): «3; Nat» =
        let taps_n  = taps * t#Sr#(core.idx 0 r d);
        let alive_n = alive * if_static (taps_n, (0, 1)#(taps_n <= budget), 0);
        (cnt + alive_n, core.select (alive_n == 1, taps_n, taps), alive_n);
    (vec.fold.r @(«3; Nat», Nat) @(t#Rr) step (‹i: t#Rr; t#Ro + core.idx2nat i›, (0, 1, 1)))#0_3;
///
/// #### vectorize_if
///
/// Vectorize the parallel dim `d` only when `cond` holds; otherwise the sentinel "no vector dim".
lam vectorize_if (t: Tileable, cond: Bool, d: Nat): Tileable =
    vectorize (t, (t#Ro + t#Rr, d)#cond);
///
/// #### conv_schedule
///
/// The convolution schedule, selected from the op's parameters — the old lowering's heuristics,
/// now plain IR next to the op:
///
/// - unroll the trailing reduction dims greedily while their tap product fits the register budget
///   (the kh·kw window; a small cin joins it) — constant tap offsets, no window loops;
/// - run `ow` (parallel dim 3) innermost with unit stride over a row of accumulators iff it beats
///   the innermost *remaining* reduction dim on unit-stride/broadcast reads: ow reads the padded
///   input at stride_w and is broadcast in the weight (score [stride_w = 1] + 1); an un-unrolled
///   kw reads the input at dilation_w and the weight at unit stride ([dilation_w = 1] + 1 — the
///   classic nest is already unit-stride, so vectorizing buys nothing); kh/cin score 0; with the
///   whole reduction unrolled there is nothing to beat;
/// - a **pointwise** window (kh·kw = 1) has no taps to unroll, so the row accumulator would make a
///   memory round trip per MAC: jam a block of `co` into the vector body (the padded-input read is
///   invariant in `co`, so the jammed cells share it) and unroll a tile of `ci` into the window
///   (which amortizes the round trip over the tile) — the 1x1 counterpart of the kh·kw window.
///
/// Open extents/strides residualize to no unrolling and no vector dim (`if_static`).
lam conv_schedule (stride dilation: «2; Nat») (t: Tileable): Tileable =
    let u     = unroll_budget (t, 32);
    let s_ow  = (0, 1)#(stride#1_2 == 1) + 1;
    // FIXME: with the whole reduction unrolled the doc says `ow` has nothing to beat, but `s_red = s_ow` keeps it scalar.
    let s_red = core.select (u == 0, (0, 1)#(dilation#1_2 == 1) + 1, core.select (u < t#Rr, 0, s_ow));
    let r     = t#Ro + t#Rr;
    let ow    = t#Sr#(core.idx 0 r 3);
    let vec   = if_static (stride#1_2 * dilation#1_2 * ow, s_red < s_ow, ff);
    lam fits (k b: Nat): Bool = core.bit2.and 2 (k / b * b == k, b < k);
    // Rows too short for the vectorizer (ow < 16) are processed in BLOCKS: strip-mine oh by the
    // largest block size ≤ 4 that divides it and sink both halves (vdim = ro − 2 selects mr_nest's
    // blocked branch, which jams the block dim into the vector body — one reduction pass folds the
    // whole row block, sharing the hoisted window weights). Otherwise the split is the neutral
    // ts = 1 (its size-1 axis folds away), so one code path serves every case and no divisibility
    // check fires on an untaken choice.
    let oh    = t#Sr#(core.idx 0 r 2);
    lam divides (d: Nat): Bool = oh / d * d == oh;
    let bs    = ((1, 2)#(divides 2), 4)#(divides 4);
    let short = if_static (oh * ow, core.bit2.and 2 (vec, ow < 16), ff);
    // There is one jam slot, so a `co` block is worth taking only where the row block cannot fire:
    // a POINTWISE window (which has no taps to amortize the accumulator round trip at all), or a
    // short row whose oh does not split. Measured over the level3 3x3 layers, taking it against a
    // working row block instead is a 5-12% loss, and taking it for a long row is a wash.
    let co    = t#Sr#(core.idx 0 r 1);
    let ci    = t#Sr#(core.idx 0 r 4);
    let win   = t#Sr#(core.idx 0 r 5) * t#Sr#(core.idx 0 r 6);
    let pw    = if_static (win, core.bit2.and 2 (vec, win == 1), ff);
    // A pointwise window keeps a working 2-row block at unit stride (1.3-1.6x faster over the level3
    // pointwise layers); 4-row blocks and strided rows still lose to the `co` block.
    let pw_rows = core.bit2.and 2 (core.bit2.and 2 (short, bs == 2),
                                    core.bit2.and 2 (stride#0_2 == 1, stride#1_2 == 1));
    let cob   = core.bit2.or 2 (core.bit2.and 2 (pw, (tt, ff)#pw_rows), core.bit2.and 2 (short, bs == 1));
    // One accumulator register per jammed cell, so a block wider than the target's lanes spills;
    // every jammed cell also replays the window, so the block shares the 32-tap register budget.
    let vw    = vec_width 8;
    lam cb_ok (b: Nat): Bool = core.bit2.and 2 (core.bit2.and 2 (fits (co, b), b <= vw), b * win <= 32);
    let cb    = if_static (co, (1, (((1, 2)#(cb_ok 2), 4)#(cb_ok 4), 8)#(cb_ok 8))#cob, 1);
    let cblk  = cb != 1;
    lam ct_ok (b: Nat): Bool = core.bit2.and 2 (fits (ci, b), cb * b * win <= 32);
    let cts   = if_static (ci, (1, (((1, 2)#(ct_ok 2), 4)#(ct_ok 4), 8)#(ct_ok 8))#cob, 1);
    let block = core.bit2.and 2 ((tt, ff)#cblk, core.bit2.and 2 (short, bs != 1));
    let t_ci  = strip_mine_red (t, 4, cts);
    let t_co  = strip_mine_par (t_ci, 1, cb);
    let t_oh  = strip_mine_par (t_co, 3, (1, bs)#block);
    // Spelled from t_oh's positional fields so the pack's length is definitionally the
    // «t#Ro + t#Rr» the dependent `interchange` domain expects.
    let r_n   = t_oh#1_8 + t_oh#2_8;
    // Dims are (n, co/cb, cb, oh/bs, bs, ow | …); rotate `cb` down next to `ow` so the jam dim and
    // the vector dim are the trailing parallel pair. Identity when the block is not taken.
    let perm  = ‹j: r_n; let jj = core.idx2nat j;
                         core.select (core.bit2.and 2 (cblk, jj == 2), 3,
                         core.select (core.bit2.and 2 (cblk, jj == 3), 4,
                         core.select (core.bit2.and 2 (cblk, jj == 4), 2, jj)))›;
    let vd    = core.select (core.bit2.or 2 (cblk, block), 4, (r_n, 5)#vec);
    // The window grows only when the `ci` split is REAL; keying it off the pointwise flag would
    // over-unroll a big window past the tap budget (a 7x7 stem goes 7 -> 49 taps, and 2x slower).
    let un    = core.select (core.bit2.or 2 (cts != 1, 3 <= u), u + 1, u);
    unroll_trailing (vectorize (interchange (t_oh, perm), vd), un);
///
/// #### dot_schedule
///
/// The dot-product schedule for a contraction whose right operand stores the last output dim
/// unit-stride (\f$A \cdot B\f$): that dim is invariant in the left operand, so it runs innermost over a row of
/// accumulators (GEMM-style vectorization) and the innermost contraction is register-blocked —
/// strip-mined by 4, the tile unrolled.
///
/// - Blocking only needs the **divisibility** decided, which is weaker than a literal extent: a
///   factored extent (`«(n+3)/4*4, …»`, say a padded row) folds the guard to `tt` under a symbolic
///   `n`, because `core.nat` cancels `(c*x)/c`.
/// - `if_static` therefore gates on the tile size rather than on `K` — a tile that folded to a
///   literal is decided, no matter which kind of extent decided it.
/// - An undecided divisibility takes the neutral tile (`ts = 1`), so one selector serves static,
///   symbolic and runtime shapes.
lam dot_schedule (r_out: Nat) (t: Tileable): Tileable =
    let r   = t#Ro + t#Rr;
    let d   = r - 1;
    let K   = t#Sr#(core.idx 0 r d);
    let ts0 = (1, 4)#(K / 4 * 4 == K);
    let ts  = if_static (ts0, ts0, 1);
    unroll_trailing (strip_mine_red (vectorize (t, r_out - 1), d, ts), 1);
///
/// #### dot_schedule_kvec
///
/// The dot-product schedule for a contraction whose right operand stores the **contraction**
/// unit-stride per output cell (\f$x \cdot W^T\f$ — the fc/linear layout, where `fuse_tensor`'s read-through
/// absorbs the weight transpose into the access map).
/// Vectorizing the last output dim would read a different weight row per lane (gathers), so instead
///
/// - the contraction itself runs as the vector loop — unit-stride in both the input row and each
///   weight row, folded with a horizontal sum (see `btensor.mr_nest`'s reduction-vectorized branch,
///   selected by a `vdim` naming the innermost reduction dim, where `unroll` names the jam width);
/// - a 2-D block of output cells is unroll-and-jammed into its body over independent vector
///   accumulators: the last output dim strip-mined by the largest power-of-two divisor that fits the
///   target's vector width (`vec_width` — jammed lanes share the input-row loads) × the
///   second-to-last by 2 (jammed rows share the weight-row loads — without this the whole weight
///   matrix re-streams once per batch row).
///
/// An extent still open at lowering time, an indivisible one, and the missing row dim of a rank-1
/// output all take the neutral split (`1`), whose size-1 jam dim folds away.
lam dot_schedule_kvec (r_out: Nat) (t: Tileable): Tileable =
    // A block counts only when it divides AND leaves a non-trivial outer dim (`b < k`): an exact
    // split's leading size-1 axis would type-collapse the packed output («1; T» ≡ T).
    lam blk_by (k b: Nat): Bool = core.bit2.and 2 (k / b * b == k, b < k);
    // One accumulator register per jammed cell, so a block wider than the target's lanes spills.
    let vw  = vec_width 8;
    lam blk_ok (k b: Nat): Bool = core.bit2.and 2 (blk_by (k, b), b <= vw);
    let d   = r_out - 1;
    let n   = t#So#(core.idx 0 (t#Ro) d);
    let bs  = if_static (n, ((((1, 2)#(blk_ok (n, 2)), 4)#(blk_ok (n, 4)), 8)#(blk_ok (n, 8)), 16)#(blk_ok (n, 16)), 1);
    let t2  = strip_mine_par (t, d, bs);
    let d2  = r_out - 2;
    let m   = t#So#(core.idx 0 (t#Ro) d2);
    let ms  = (1, if_static (m, (1, 2)#(blk_by (m, 2)), 1))#(2 <= r_out);
    let t3  = strip_mine_par (t2, d2, ms);
    // Dims now (…, m/ms, ms, n/bs, bs | red): swap ms ↔ n/bs so both jam dims are the trailing
    // parallel pair. Identity for a rank-1 output, where the neutral split already sits next to
    // `bs` ((n/bs, 1, bs | red)). `r3` is spelled from t3's own (positional) fields so the pack's
    // length is definitionally the «t#Ro + t#Rr» the dependent `interchange` domain expects —
    // `core.nat.add` does not reassociate an equivalent spelling.
    let r3   = t3#1_8 + t3#2_8;
    let swap = 2 <= r_out;
    let pa   = r_out - 1;
    let pb   = r_out;
    let perm = ‹j: r3; let jj = core.idx2nat j;
                       core.select (core.bit2.and 2 (swap, jj == pa), pb,
                       core.select (core.bit2.and 2 (swap, jj == pb), pa, jj))›;
    unroll_trailing (vectorize (interchange (t3, perm), r3 - 1), 2);
///
/// #### pool_schedule
///
/// The pooling schedule: unroll the window while it stays within budget. Pooling reads its single
/// input in every loop dim (no broadcast operand), so `ow` scores [stride_w = 1] against an
/// un-unrolled kw's [dilation_w = 1] — the row accumulator never wins and the nest stays classic.
lam pool_schedule (stride dilation: «2; Nat») (t: Tileable): Tileable =
    let u     = unroll_budget (t, 32);
    let s_ow  = (0, 1)#(stride#1_2 == 1);
    let s_red = core.select (u == 0, (0, 1)#(dilation#1_2 == 1), core.select (u < t#Rr, 0, s_ow));
    let ow    = t#Sr#(core.idx 0 (t#Ro + t#Rr) 3);
    let vec   = if_static (stride#1_2 * dilation#1_2 * ow, s_red < s_ow, ff);
    unroll_trailing (vectorize_if (t, vec, 3), u);
///
/// ## Implementations
///
/// The `_impl` annexes `lower_tensor` re-applies to expand the derived operations above, together
/// with the fold steps and access maps they read through.
/// Most are a single `map_reduce` over a copy step — the operation itself lives in the access map.
/// They are `priv`: the phase resolves them through the annex table, so no path from outside this
/// plugin reaches them and the axioms above stay the only public spelling of these operations.
///
/// The declaration order is load-bearing beyond the usual definition-before-use: `lower_tensor`
/// resolves an `_impl` in the world it is *building*, so an impl must be declared before any annex
/// whose body applies the axiom it implements — `reshape_impl` before `conv_impl` and
/// `dot_product_impl`, which reshape their packed results.
///
/// ### bid_aff
///
/// `o ↦ (o#(index#i) · [s_in#i ≠ 1])_i`: input axis `i` reads output-loop var `o#(index#i)` (the transpose), unless
/// it is a broadcast axis (`s_in#i = 1`), which reads index 0.
lam bid_aff {r_in r_out: Nat} (s_in: «r_in; Nat», index: «r_in; Idx r_out»): Aff (r_out, r_in) =
    aff_map @(r_out, r_in, r_in) (‹i: r_in; core.select (s_in#i == 1, 0, 1)›,
                                  ‹i: r_in; aff_mul @(r_out, r_in) (aff_dim @(r_out, r_in) (index#i), aff_var @r_in i)›);
///
/// ### broadcast_in_dim_impl
///
priv anx lam broadcast_in_dim_impl {T: *, r_in r_out: Nat}
    (s_in: «r_in; Nat», s_out: «r_out; Nat», input: Tensor r_in s_in T, index: «r_in; Idx r_out»): Tensor r_out s_out T =
    map_reduce (s_out, s_out) (copy, ⊥:T)
        (aff_idn r_out) (bid_aff (s_in, index),) input;
///
/// ### flip_aff
///
/// `o ↦ ((s_in#d − 1) − o#d)_d`: the reverse read map.
lam flip_aff {r: Nat} (s_in: «r; Nat»): Aff (r, r) =
    aff_map @(r, r, r) (‹d: r; s_in#d - 1›, ‹d: r; aff_sub @(r, r) (aff_sym @(r, r) d, aff_dim @(r, r) d)›);
///
/// ### flip_impl
///
priv anx lam flip_impl {T: *, r: Nat} (s_in: «r; Nat») (input: Tensor r s_in T): Tensor r s_in T =
    map_reduce (s_in, s_in) (copy, ⊥:T)
        (aff_idn r) (flip_aff s_in,) input;
///
/// ### gather_pointwise_elem_impl
///
/// One output element: reads `index` at the output coordinate, then the source at that coordinate
/// with axis `dim` replaced by the loaded value.
priv anx lam gather_pointwise_elem_impl {T: *, r: Nat}
                                   (s_src: «r; Nat», s_idx: «r; Nat»)
                                   (dim: Idx r)
                                   (out_indices: «r; I64»)
                                   (input: «s_src; T», index: «s_idx; Idx (s_src#dim)»): T =
    let index_coords = ‹d: r; core.conv.u (s_idx#d) (out_indices#d)›;
    let source_axis_index = core.bitcast I64 (index#index_coords);
    let source_coords = ‹d: r;
        let coordinate = core.select (core.icmp.e @r (d, dim), source_axis_index, out_indices#d);
        core.conv.u (s_src#d) coordinate›;
    input#source_coords;
///
/// ### map_impl
///
/// A `map_reduce` whose fold step drops the accumulator and applies `app` to the element tuple.
priv anx lam map_impl {T: *, ni: Nat, Is: «ni; *»}
                     (app: «i: ni; Is#i» → T)
                     {r: Nat, s: «r; Nat»}
                     (is: «i: ni; Tensor r s (Is#i)»)
                     : Tensor r s T =
    // The `{Tis, Ris, Sis}` group stays explicit: with a *symbolic* `ni`, solving `Sis#i ≡ s` for all `i`
    // (i.e. `Sis := ‹ni; s›`) is Miller pattern unification. Adding that rule to `Checker::alpha_impl_` was tried
    // and reverted — even with an occurs check it fires inside `tuple`'s machinery and commits a wrong solution.
    map_reduce (s, s) @(Is, ‹ni; r›, ‹ni; s›) (map_of @(T, «i: ni; Is#i») app, ⊥:T) (aff_idn r) ‹ni; aff_idn r› is;
///
/// ### fold_of
///
/// The combiner `(acc, xs) ↦ op (acc, h xs)`, which keeps `op` so that a reduction can merge partial results by it.
axm fold_of: {To Ins: *} → [op: [To, To] → To, h: Ins → To] → Fn [To, Ins] → To, normalize_fold_of;
///
/// ### monoid_of
///
/// Whether `op` reassociates, exactly or by its math mode, and has `unit` as its unit; a reduction by it may merge partial results.
axm monoid_of: {T: *} → [op: [T, T] → T, unit: T] → Bool, normalize_monoid_of;
///
/// ### pool_fun
///
/// Wraps a binary fold `g` as a `map_reduce` reduction `Fn [T, «1; T»] → T`.
pub lam pool_fun {T: *} (g: [T, T] → T): Fn [T, T] → T = fold_of @(T, T) (g, λ (y: T): T = y);
///
/// ### reduce_shape
///
/// `s` without axis `ax`.
pub lam reduce_shape {r: Nat} (ax: Idx r, s: «r; Nat»): «r - 1; Nat» =
    ‹i: r - 1; s#(core.idx 0 r (shift_ax (core.idx2nat ax, core.idx2nat i)))›;
///
/// ### reduce
///
/// Folds `input` along axis `ax` with `g`, seeded with `init`; the result drops that axis.
/// The output axes run as the leading loops, `ax` as the trailing reduction loop.
pub lam reduce {T: *} (g: [T, T] → T, init: T) {r: Nat} (ax: Idx r) {s: «r; Nat»} (input: Tensor r s T): Tensor (r - 1) (reduce_shape (ax, s)) T =
    let a = core.idx2nat ax;
    map_reduce (reduce_shape (ax, s), ‹i: r; let ii = core.idx2nat i; s#(core.idx 0 r (core.select (ii < r - 1, shift_ax (a, ii), a)))›)
        (pool_fun g, init)
        (aff_projn @(r, r - 1) ‹i: r - 1; core.idx2nat i›)
        (aff_projn @(r, r) ‹j: r; let jj = core.idx2nat j; core.select (jj < a, jj, core.select (jj == a, r - 1, jj - 1))›)
        input;
///
/// ### binary_ax
///
/// `binary app (x, y)` where `y` lacks axis `ax` of `x` and is broadcast along it.
pub lam binary_ax {Ti1 Ti2 To: *} (app: [Ti1, Ti2] → To) {r: Nat} (ax: Idx r) {s: «r; Nat»}
                  (x: Tensor r s Ti1, y: Tensor (r - 1) (reduce_shape (ax, s)) Ti2): Tensor r s To =
    let a = core.idx2nat ax;
    map_reduce (s, s) @((Ti1, Ti2), (r, r - 1), (s, reduce_shape (ax, s))) (map_of @(To, [Ti1, Ti2]) app, ⊥:To)
        (aff_idn r) (aff_idn r, aff_projn @(r, r - 1) ‹i: r - 1; shift_ax (a, core.idx2nat i)›) (x, y);
///
/// ### softmax
///
/// Numerically stable softmax along axis `ax`: `exp (x - max) / Σ exp (x - max)`.
pub lam softmax (m: Nat) {pe: «2; Nat»} {r: Nat} (ax: Idx r) {s: «r; Nat»} (input: Tensor r s (math.F pe)): Tensor r s (math.F pe) =
    let F  = math.F pe;
    let mx = reduce (math.extrema.fmax m, math.neg_inf pe) ax input;
    let e  = binary_ax (λ (x y: F): F = math.exp.exp m (math.arith.sub m (x, y))) ax (input, mx);
    binary_ax (math.arith.div m) ax (e, reduce (math.arith.add m, 0:F) ax e);
///
/// ### pool2d_in_aff
///
/// Windowed input read over the loop vector `(n, c, oh, ow, kh, kw)`:
/// `(n, c, stride#0·oh + dilation#0·kh, stride#1·ow + dilation#1·kw)`.
lam pool2d_in_aff (stride dl: «2; Nat»): Aff (6, 4) =
    let d = affd @(6, 4);
    aff_map @(6, 4, 4) ((stride#0_2, dl#0_2, stride#1_2, dl#1_2),
                        (d 0, d 1, affa (affm (d 2, 0), affm (d 4, 1)), affa (affm (d 3, 2), affm (d 5, 3))));
///
/// ### pool_impl
///
priv anx lam pool_impl {T: *} (g: [T, T] → T, init: T) {n c h w: Nat}
                      (kernel stride dilation padding s_out: «2; Nat»)
                      (input: Tensor 4 (n, c, h, w) T)
                    : Tensor 4 (n, c, s_out#0_2, s_out#1_2) T =
    let s_in     = (n, c, h, w);
    let pad_lohi = (0, 0, padding#0_2, padding#1_2);
    let padded   = pad s_in (0, pad_lohi, pad_lohi) (input, init);
    let s_padded = shape padded;

    // Schedule (frontend, selected from the parameters — see `pool_schedule`).
    materialize (pool_schedule (stride, dilation) (
        mr_tileable @1 @(4, 2)
            ((n, c, s_out#0_2, s_out#1_2), (0, 1, 2, 3), (n, c, s_out#0_2, s_out#1_2, kernel#0_2, kernel#1_2))
            @(T, 4, s_padded)
            (pool_fun g, init, id @T)
            (aff_projn @(6, 4) (0, 1, 2, 3))
            (pool2d_in_aff (stride, dilation),)
            padded));
///
/// ### repeat_aff
///
/// `o ↦ (o#d mod s_in#d)_d`: the wrap-around (tiling) read map.
lam repeat_aff {r: Nat} (s_in: «r; Nat»): Aff (r, r) =
    aff_map @(r, r, r) (s_in, ‹d: r; aff_mod @(r, r) (aff_dim @(r, r) d, aff_var @r d)›);
///
/// ### repeat_impl
///
priv anx lam repeat_impl {T: *, r: Nat} (s_in: «r; Nat») (s_out: «r; Nat») (input: Tensor r s_in T): Tensor r s_out T =
    map_reduce (s_out, s_out) (copy, ⊥:T)
        (aff_idn r) (repeat_aff s_in,) input;
///
/// ### reshape_impl
///
priv anx lam reshape_impl {T: *, r_in r_out: Nat}
                         (s_in: «r_in; Nat») (s_out: «r_out; Nat») (input: Tensor r_in s_in T): Tensor r_out s_out T =
    map_reduce (s_out, s_out) (copy, ⊥:T)
        (aff_idn r_out) (reshape_aff (s_in, s_out),) input;
///
/// ### conv_fun
///
/// Fused multiply-add over the ring `R`; `x` is the padded-input element, `w` the weight.
lam conv_fun (R: Ring): Fn [R#T, [R#T, R#T]] → R#T = fold_of @(R#T, [R#T, R#T]) (R#add, R#mul);
lam conv_fun_wx (R: Ring): Fn [R#T, [R#T, R#T]] → R#T = fold_of @(R#T, [R#T, R#T]) (R#add, λ (w x: R#T): R#T = R#mul (x, w));
///
/// Whether `tensor.run_levels` lowers the contraction that produces its argument (`tensor::pe_cpu_plan`).
axm pe_cpu_candidate: {T: *} → T → Bool, normalize_pe_cpu_candidate;
/// ### conv2d_in_aff
///
/// The `«7; affine.Index»` loop vector is `o = (n, co, oh, ow, ci, kh, kw)`, so the weight read map
/// `(co, ci, kh, kw)` and the output write map `(n, co, oh, ow)` are `proj_map` projections of it;
/// only this padded-input read needs arithmetic:
/// `(n, ci, stride#0·oh + dilation#0·kh, stride#1·ow + dilation#1·kw)`.
/// `conv2d_in_aff` over the loops `(n, oh, co, ow, r)` whose reduction `r` runs over `(ci, kh, kw)` row-major.
lam conv2d_im2col_aff (stride dl: «2; Nat», kh kw: Nat): Aff (5, 4) =
    let d = affd @(5, 7);
    let r = d 4;
    let i = affr (afff (r, 0), 1);
    let j = affr (r, 0);
    aff_map @(5, 4, 7) ((kw, kh, kh * kw, stride#0_2, dl#0_2, stride#1_2, dl#1_2),
                        (d 0, afff (r, 2), affa (affm (d 1, 3), affm (i, 4)), affa (affm (d 3, 5), affm (j, 6))));
/// `conv2d_im2col_aff` over the loops `(n, co, p, r)` whose pixel `p` runs over `(oh, ow)` row-major.
lam conv2d_pixel_aff (stride dl: «2; Nat», ow kh kw: Nat): Aff (4, 4) =
    let d = affd @(4, 8);
    let p = d 2;
    let r = d 3;
    let i = affr (afff (r, 0), 1);
    let j = affr (r, 0);
    aff_map @(4, 4, 8) ((kw, kh, kh * kw, ow, stride#0_2, dl#0_2, stride#1_2, dl#1_2),
                        (d 0, afff (r, 2), affa (affm (afff (p, 3), 4), affm (i, 5)), affa (affm (affr (p, 3), 6), affm (j, 7))));
/// The padded-input read, with `oh` the loop `h`.
lam conv2d_in_aff (stride dl: «2; Nat», h: Nat): Aff (7, 4) =
    let d = affd @(7, 4);
    aff_map @(7, 4, 4) ((stride#0_2, dl#0_2, stride#1_2, dl#1_2),
                        (d 0, d 4, affa (affm (d h, 0), affm (d 5, 1)), affa (affm (d 3, 2), affm (d 6, 3))));
///
/// ### conv_impl
///
priv anx lam conv_impl (R: Ring) {n cin cout h w kh kw: Nat}
                      (stride dilation padding: «2; Nat»)
                      (input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, cin, kh, kw) (R#T))
                    : Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T) =
    // Zero-pad only the spatial axes (lo = hi = (0, 0, pad_h, pad_w)); the pad value is the ring zero.
    let s_in     = (n, cin, h, w);
    let pad_lohi = (0, 0, padding#0_2, padding#1_2);
    let padded   = pad s_in (0, pad_lohi, pad_lohi) (input, R#_0);
    let s_padded = shape padded;
    let s_out    = conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding);
    let (_, _, oh, ow) = s_out;

    // The SCHEDULE, selected in the frontend from the parameters (see `conv_schedule`): unroll the
    // kh·kw window into the loop body (constant tap offsets) when it fits the budget, and run `ow`
    // as the innermost, unit-stride loop — for a fixed tap, adjacent output pixels read adjacent
    // input pixels, so the vectorizer emits contiguous vector loads instead of gathers. The
    // schedule may strip-mine `oh` (row blocking), packing the materialized tensor along that axis;
    // the row-major `reshape` restores `s_out` (an identity for the neutral split, and absorbed into
    // the consumers' access maps by `fuse_tensor`'s read-through in a fused graph).
    let t = mr_tileable @2 @(4, 3)
            ((n, cout, oh, ow), (0, 1, 2, 3), (n, cout, oh, ow, cin, kh, kw))
            @((R#T, R#T), (4, 4), (s_padded, (cout, cin, kh, kw)))
            (conv_fun R, R#_0, id @(R#T))
            (aff_projn @(7, 4) (0, 1, 2, 3))
            (conv2d_in_aff (stride, dilation, 2), aff_projn @(7, 4) (1, 4, 5, 6))
            (padded, weight);
    // `sched#3_8` is the scheduled Tileable's (possibly packed) output shape `So`.
    lam go (_: []): Tensor 4 s_out (R#T) =
        let sched = conv_schedule (stride, dilation) t;
        reshape (sched#3_8) s_out (materialize sched);
    // For `run_levels`, an implicit im2col: the loops (n, oh, co, ow | r) with r = (ci, kh, kw) flattened, so the
    // register tile `co` × `ow` (with `ow` as the vector loop) folds over a single reduction loop like a GEMM's.
    let taps = kh * kw;
    let pe   = mr_tileable @2 @(4, 1)
            ((n, cout, oh, ow), (0, 2, 1, 3), (n, oh, cout, ow, cin * taps))
            @((R#T, R#T), (2, 4), ((cout, cin * taps), s_padded))
            (conv_fun_wx R, R#_0, id @(R#T))
            (aff_projn @(5, 4) (0, 2, 1, 3))
            (aff_projn @(5, 2) (2, 4), conv2d_im2col_aff (stride, dilation, kh, kw))
            (reshape (cout, cin, kh, kw) (cout, cin * taps) weight, padded);
    let canonical = materialize pe;
    // A row shorter than a register tile wastes its lanes, so a small feature map runs its oh·ow pixels as one loop p.
    let flat = mr_tileable @2 @(3, 1)
            ((n, cout, oh * ow), (0, 1, 2), (n, cout, oh * ow, cin * taps))
            @((R#T, R#T), (2, 4), ((cout, cin * taps), s_padded))
            (conv_fun_wx R, R#_0, id @(R#T))
            (aff_projn @(4, 3) (0, 1, 2))
            (aff_projn @(4, 2) (1, 3), conv2d_pixel_aff (stride, dilation, ow, kh, kw))
            (reshape (cout, cin, kh, kw) (cout, cin * taps) weight, padded);
    let flat_c = materialize flat;
    let small  = ow < 32;
    let out    = (canonical, reshape (n, cout, oh * ow) s_out flat_c)#small;
    // A direct convolution keeps the window loops; `co` next to `ow` lets a register tile take the outer product of a weight column and an input row.
    let direct = mr_tileable @2 @(4, 3)
            ((n, cout, oh, ow), (0, 2, 1, 3), (n, oh, cout, ow, cin, kh, kw))
            @((R#T, R#T), (4, 4), ((cout, cin, kh, kw), s_padded))
            (conv_fun_wx R, R#_0, id @(R#T))
            (aff_projn @(7, 4) (0, 2, 1, 3))
            (aff_projn @(7, 4) (2, 4, 5, 6), conv2d_in_aff (stride, dilation, 1))
            (weight, padded);
    let (_, _, _, _, _, _, _, _, _, _, _, how) = cpu_knobs ();
    ((go (), out)#((pe_cpu_candidate canonical, pe_cpu_candidate flat_c)#small), materialize direct)#(how == 1);
///
/// ### conv_grouped_in_aff
///
/// The loop vector is `o = (b, co, oh, ow, ci, kh, kw)` with `b = n·groups + g`: group `g` reads input channel `g·ci + ci`.
lam conv_grouped_in_aff (groups ci: Nat, stride dl: «2; Nat»): Aff (7, 4) =
    let d = affd @(7, 6);
    aff_map @(7, 4, 6) ((groups, ci, stride#0_2, dl#0_2, stride#1_2, dl#1_2),
                        (afff (d 0, 0), affa (affm (affr (d 0, 0), 1), d 4),
                         affa (affm (d 2, 2), affm (d 5, 3)), affa (affm (d 3, 4), affm (d 6, 5))));
///
/// ### conv_grouped_w_aff
///
/// The weight read of `conv_grouped_in_aff`'s loop vector: group `g` owns the weight rows `g·co + co`.
lam conv_grouped_w_aff (groups co: Nat): Aff (7, 4) =
    let d = affd @(7, 2);
    aff_map @(7, 4, 2) ((groups, co), (affa (affm (affr (d 0, 0), 1), d 1), d 4, d 5, d 6));
/// `conv2d_im2col_aff` over the loops `(n, g, oh, co, ow, r)`: group `g` reads the input channels `g·ci ..`.
lam conv_grouped_im2col_aff (ci: Nat, stride dl: «2; Nat», kh kw: Nat): Aff (6, 4) =
    let d = affd @(6, 8);
    let r = d 5;
    let i = affr (afff (r, 0), 1);
    let j = affr (r, 0);
    aff_map @(6, 4, 8) ((kw, kh, kh * kw, ci, stride#0_2, dl#0_2, stride#1_2, dl#1_2),
                        (d 0, affa (affm (d 1, 3), afff (r, 2)), affa (affm (d 2, 4), affm (i, 5)), affa (affm (d 4, 6), affm (j, 7))));
/// The weight rows `g·co + co` and reduction `r` that `conv_grouped_im2col_aff`'s loops read.
lam conv_grouped_w_im2col_aff (co: Nat): Aff (6, 2) =
    let d = affd @(6, 1);
    aff_map @(6, 2, 1) (co, (affa (affm (d 1, 0), d 3), d 5));
///
/// ### conv_grouped_impl
///
/// Each (batch, group) pair is an independent dense convolution, so folding the group into the batch dim lets the
/// group-free `conv_schedule` apply unchanged: the group arithmetic stays in the outermost loop.
/// The materialized `«n·groups, cout / groups, oh, ow»` is the row-major layout of the NCHW output.
/// For `run_levels`, an implicit im2col per group: the loops `(n, g, oh, co, ow | r)` with `r = (ci, kh, kw)` flattened.

priv anx lam conv_grouped_impl (R: Ring) {n cin cout h w ci kh kw: Nat}
                              (groups: Nat, stride dilation padding: «2; Nat»)
                              (input: Tensor 4 (n, cin, h, w) (R#T), weight: Tensor 4 (cout, ci, kh, kw) (R#T))
                            : Tensor 4 (conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding)) (R#T) =
    let ci_g     = refly.check (ci * groups == cin, ci, "conv_grouped: weight must hold cin / groups input channels");
    let co       = check_div (cout, groups) / groups;
    let s_in     = (n, cin, h, w);
    let pad_lohi = (0, 0, padding#0_2, padding#1_2);
    let padded   = pad s_in (0, pad_lohi, pad_lohi) (input, R#_0);
    let s_padded = shape padded;
    let s_out    = conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding);
    let oh       = s_out#2_4;
    let ow       = s_out#3_4;
    let b        = n * groups;
    lam go (_: []): Tensor 4 s_out (R#T) =
        let sched = conv_schedule (stride, dilation) (
            mr_tileable @2 @(4, 3)
                ((b, co, oh, ow), (0, 1, 2, 3), (b, co, oh, ow, ci, kh, kw))
                @((R#T, R#T), (4, 4), (s_padded, (cout, ci, kh, kw)))
                (conv_fun R, R#_0, id @(R#T))
                (aff_projn @(7, 4) (0, 1, 2, 3))
                (conv_grouped_in_aff (groups, ci_g, stride, dilation), conv_grouped_w_aff (groups, co))
                (padded, weight));
        reshape (sched#3_8) s_out (materialize sched);
    let taps = kh * kw;
    let pe   = mr_tileable @2 @(5, 1)
            ((n, groups, co, oh, ow), (0, 1, 3, 2, 4), (n, groups, oh, co, ow, ci_g * taps))
            @((R#T, R#T), (2, 4), ((cout, ci_g * taps), s_padded))
            (conv_fun_wx R, R#_0, id @(R#T))
            (aff_projn @(6, 5) (0, 1, 3, 2, 4))
            (conv_grouped_w_im2col_aff (co), conv_grouped_im2col_aff (ci_g, stride, dilation, kh, kw))
            (reshape (cout, ci, kh, kw) (cout, ci_g * taps) weight, padded);
    let out = materialize pe;
    (go (), reshape (n, groups, co, oh, ow) s_out out)#(pe_cpu_candidate out);
///
/// ### dot_general_fun
///
/// The fold step: a fused multiply-add in the ring `R`.
pub lam dot_general_fun (R: Ring): Fn [R#T, [R#T, R#T]] → R#T = fold_of @(R#T, [R#T, R#T]) (R#add, R#mul);
///
/// ### dot_general_pick
///
/// Sends input axis `i` to the loop id it reads — batching dims first, then the contractions, then
/// the remaining free axes.
pub lam dot_general_pick {n: Nat} {na nb nc: Nat} (a: «na; Idx n», b: «nb; Idx n», c: «nc; Idx n») (off_1 off_2: Nat) (i: Idx n): Nat =
    match vec.first core.icmp.e (b, i) with
        | Some bi => core.idx2nat bi
        | None    => match vec.first core.icmp.e (c, i) with
            | Some ci => off_2 + core.idx2nat ci
            | None    => match vec.first core.icmp.e (a, i) with
                | Some ai => off_1 + core.idx2nat ai
                | None    => 0;
///
/// ### dot_product_impl
///
/// `r1`/`r2` are an *explicit* group here, unlike in the `dot_product` axiom: they must be literals
/// already when this `lam` is β-reduced, since the subscript rows are built with `vec.diff`/`vec.first`,
/// whose normalizers decline to fold over a non-literal rank, and nothing re-normalizes the body once a
/// Hole is resolved later.
/// `{s1 s2}` has no such problem and stays implicit.
///
/// `tensor::Lower` re-applies the axiom's groups positionally, so the two curry shapes still match —
/// except for the leading `fastest_2`, which has no axiom counterpart: it is `fastest_axis` of the
/// right operand, pre-applied by `Lower` where that operand is concrete.
/// The schedule **decision** built on it lives in the body:
///
/// - a contracted fastest axis (\f$x \cdot W^T\f$, e.g. behind a weight transpose the read-through absorbs) selects
///   `dot_schedule_kvec`, anything else `dot_schedule`;
/// - the selected schedule may strip-mine an output dim (row/output-cell blocking), packing the
///   materialized tensor along that axis, whereupon the row-major `reshape` restores `s_out` — the
///   identity for the neutral split, and absorbed into the consumers' access maps by `fuse_tensor`'s
///   read-through in a fused graph.
///

priv anx lam dot_product_impl
    (fastest_2: Nat)
    (R: Ring) (r1 r2: Nat) {nc nb: Nat}
    (c1: «nc; Idx r1», c2: «nc; Idx r2», b1: «nb; Idx r1», b2: «nb; Idx r2»)
    {s1: «r1; Nat», s2: «r2; Nat»} (a: Tensor r1 s1 (R#T), b: Tensor r2 s2 (R#T))
    : let s_out = dot_general_shape (c1, c2, b1, b2) (s1, s2);
      Tensor (vec.len s_out) s_out (R#T)
    = let s_out    = dot_general_shape (c1, c2, b1, b2) (s1, s2);
      let bc_1     = vec.cat (b1, c1);
      let s1_res   = vec.diff (s1, bc_1);
      let n_s1_res = vec.len s1_res;
      let bc_2     = vec.cat (b2, c2);
      let f        = dot_general_fun R;
      let r_out    = vec.len s_out;
      let a1       = vec.diff (‹i: r1; i›, bc_1);
      let a2       = vec.diff (‹i: r2; i›, bc_2);
      let subs_1   = ‹i: r1; dot_general_pick (a1, b1, c1) (nb, r_out) i›;
      let subs_2   = ‹i: r2; dot_general_pick (a2, b2, c2) (nb + n_s1_res, r_out) i›;
      // The subscript rows use consecutive loop ids: 0 … r_out−1 are the output loops
      // and r_out … r_out+nc−1 the contractions, whose bounds are the contracting extents of `a`.
      let s_red    = ‹i: nc; refly.check (s1#(c1#i) == s2#(c2#i), s1#(c1#i), "contracting dims don't match")›;
      let s_full   = vec.cat (s_out, s_red);
      let n_loops  = r_out + nc;
      let t        = mr_tileable @2 @(r_out, nc)
                         (s_out, ‹i: r_out; core.idx2nat i›, s_full)
                         @((R#T, R#T), (r1, r2), (s1, s2))
                         (f, R#_0, id @(R#T))
                         (aff_projn @(n_loops, r_out) ‹i: r_out; core.idx2nat i›)
                         (aff_projn @(n_loops, r1) subs_1, aff_projn @(n_loops, r2) subs_2)
                         (a, b);
      // Schedule (frontend, selected from the parameters — see `dot_schedule`/`dot_schedule_kvec`):
      // vectorize the contraction iff it is the right operand's effective fastest axis (x·Wᵀ);
      // otherwise the last output dim is unit-stride in that operand (A·B) and runs as the vector
      // loop. Dispatched as an extract over thunks, each materializing its own concretely-scheduled
      // Tileable: behind a stuck extract the record's `Out` field would not reduce, so the
      // reshape's input could not be checked. `sched#3_8` is the scheduled Tileable's (possibly
      // packed) output shape `So`.
      let kvec = option.is_some (vec.first `== (‹i: nc; core.idx2nat (c2#i)›, fastest_2));
      lam go_n    (u: []): Tensor (vec.len s_out) s_out (R#T) =
          let sched = dot_schedule r_out t;
          reshape (sched#3_8) s_out (materialize sched);
      lam go_kvec (u: []): Tensor (vec.len s_out) s_out (R#T) =
          let sched = dot_schedule_kvec r_out t;
          reshape (sched#3_8) s_out (materialize sched);
      let canonical = materialize t;
      let use_pe    = pe_cpu_candidate canonical;
      // A choice of tensors rather than of thunks, so a runtime-shaped one still bufferizes.
      ((go_n, go_kvec)#kvec (), canonical)#use_pe;
///
/// ### bmm_impl
///
/// `dot_product_impl` with literal ranks `(3, 3)`, batching axis 0 and contraction `k`.
priv anx lam bmm_impl (fastest_2: Nat) (R: Ring) {B M K N: Nat} (t1: Tensor 3 (B, M, K) (R#T), t2: Tensor 3 (B, K, N) (R#T)): Tensor 3 (B, M, N) (R#T)
        = dot_product_impl fastest_2 R (3, 3) (2_3, 1_3, 0_3, 0_3) (t1, t2);
///
/// ### product_2d_impl
///
/// `dot_product_impl` with literal ranks `(2, 2)` and the contraction `k`; see there for why the ranks are an explicit group.
priv anx lam product_2d_impl (fastest_2: Nat) (R: Ring) {m k l: Nat} (t1: Tensor 2 (m, k) (R#T), t2: Tensor 2 (k, l) (R#T)): Tensor 2 (m, l) (R#T)
        = dot_product_impl fastest_2 R (2, 2) (1_2, 0_2, (), ()) (t1, t2);
///
/// ### scatter_step_impl
///
/// One update: reads `index` and `updates` at the visited coordinate and inserts the element into the
/// accumulated tensor at the destination it selects.
priv anx lam scatter_step_impl {T: *, r: Nat}
                          (s_src: «r; Nat», s_idx: «r; Nat», s_updates: «r; Nat»)
                          (dim: Idx r)
                          (visit_indices: «r; I64»)
                          (acc: «s_src; T», index: «s_idx; Idx (s_src#dim)», updates: «s_updates; T»): «s_src; T» =
    let index_coords = ‹d: r; core.conv.u (s_idx#d) (visit_indices#d)›;
    let update_coords = ‹d: r; core.conv.u (s_updates#d) (visit_indices#d)›;
    let destination_axis_index = core.bitcast I64 (index#index_coords);
    let update = updates#update_coords;
    let destination_coords = ‹d: r;
        let coordinate = core.select (core.icmp.e @r (d, dim), destination_axis_index, visit_indices#d);
        core.conv.u (s_src#d) coordinate›;
    acc#destination_coords ← update;
///
/// ### slice_aff
///
/// `o ↦ (start#d + step#d · o#d)_d`: the strided read map.
lam slice_aff {r: Nat} (start step: «r; Nat»): Aff (r, r) =
    let t = core.nat.add (r, r);
    aff_map @(r, r, t) (‹j: t; let jj = core.idx2nat j; core.select (jj < r, step#(core.idx 0 r jj), start#(core.idx 0 r (jj - r)))›,
                        ‹d: r; let dd = core.idx2nat d;
                               aff_add @(r, t) (affm (affd @(r, t) dd, dd), aff_sym @(r, t) (core.idx 0 t (r + dd)))›);
///
/// ### slice_impl
///
priv anx lam slice_impl {T: *, r: Nat} (s_in: «r; Nat»)
                       (start step s_out: «r; Nat») (input: Tensor r s_in T): Tensor r s_out T =
    map_reduce (s_out, s_out) (copy, ⊥:T)
        (aff_idn r) (slice_aff (start, step),) input;
///
/// ### transpose_impl
///
priv anx lam transpose_impl {T: *, r: Nat}
                           (permutation: «r; Idx r») {s: «r; Nat»} (input: Tensor r s T)
                         : Tensor r (transpose_shape (s, permutation)) T
                         = let out_s = transpose_shape (s, permutation);
                           map_reduce (out_s, out_s) (copy, ⊥:T)
                               (aff_idn r) (aff_proj @(r, r) permutation,) input;
///
/// ### binary_impl
///
/// `map_impl` over two tensors.
priv anx lam binary_impl {Ti1 Ti2 To: *} (app: [Ti1, Ti2] → To) {r: Nat, s: «r; Nat»} (is: [Tensor r s Ti1, Tensor r s Ti2]): Tensor r s To =
    map_impl app is;
///
/// ### select_impl
///
/// `map_impl` of `core.select` over three tensors.
priv anx lam select_impl {T: *} {r: Nat, s: «r; Nat»} (is: [Tensor r s Bool, Tensor r s T, Tensor r s T]): Tensor r s T =
    map_impl core.select is;
///
/// ### unary_impl
///
/// `map_impl` over one tensor.
priv anx lam unary_impl {Ti To: *} (app: Ti → To) {r: Nat, s: «r; Nat»} (i: Tensor r s Ti): Tensor r s To =
    map_impl app i;
///
/// ## Phases
///
/// ### reassoc
///
/// Reassociates chains of `product_2d` with the classic matrix-chain-order dynamic program — but
/// minimizing vector-lane slots instead of scalar multiplications.
///
/// - The vector loop runs over a product's trailing extent (`dot_schedule`) or, for a transposed
///   operand, over its contraction (`dot_schedule_kvec`), and a literal extent is charged rounded up
///   to whole lanes of `vec_width` (`-X tensor:vec-width=<n>`).
///   A bracketing whose intermediates are too narrow to fill a vector thus pays for the lanes it
///   leaves idle, which is exactly what the multiplication count misses.
/// - Extents need not be literal: a cost is a polynomial in the symbolic extents, ordered by
///   coefficient-wise `≤`, which proves `≤` for every instantiation because extents are non-negative.
/// - That order is only *partial*, so a chain can have several bracketings that each win for some
///   instantiation — a batch dimension favouring a different one when small than when large.
///   Up to 4 matrices — `-X tensor:reassoc-max=<n>`, below `3` to switch it off — those survivors are
///   emitted side by side behind a run-time comparison of their costs, so only the winner's thunk
///   runs; a longer chain is only reassociated where one bracketing provably wins for every extent.
/// - Common sub-products are hash-consed across the alternatives, so the code growth stays well below
///   \f$\mathit{Catalan}(n-1)\f$.
/// - A product with more than one consumer stays a chain boundary, as pulling it apart would leave it
///   materialized for its other consumers as well.
/// - A transposed product is part of the chain, as `(A · B)ᵀ = Bᵀ · Aᵀ`; so `Q · Kᵀ` with `Q = x · wq` and
///   `K = x · wk` is the chain `x · wq · wkᵀ · xᵀ`.
/// - Reassociation is only exact for an associative ring; on floating-point rings it changes the
///   rounding, just like `-ffast-math`.
///
axm reassoc: compile.Phase;
///
/// ### lower_tensor
///
/// Lowers the derived operations to the core ones by re-applying the matching `_impl` annexes.
///
axm lower_tensor: compile.Phase;
///
/// ### lower_map_reduce
///
/// Lowers the core operations, `generate` included, to their underlying primitives: loops, `extract`,
/// `insert`, packs, ...
///
axm lower_map_reduce: compile.Phase;
///
/// ### fuse_tensor
///
/// Fuses pure producer `map_reduce`s into their consumers' access maps.
///
/// - A producer is only fused where the consumer reads it injectively — its access map uses every
///   loop index, possibly strided/shifted — so fusion never recomputes a producer element; strided
///   reads even skip producer elements entirely.
/// - In the reverse direction, a trailing elementwise map over a reducing `map_reduce` is composed
///   into the producer's `post` epilogue (the GEMM-epilogue pattern), provided the map is its only
///   consumer.
///
axm fuse_tensor: compile.Phase;
///
/// ### lower_to_mem
///
/// Bufferizes the core operations onto the `buffer` layer: tensor values become `buffer.Buf` handles,
/// `get` / `set` / `generate` / `map_reduce` become `buffer.read` / `buffer.write` / `buffer.alloc`
/// threading `mem.M`.
/// The nominal `Tensor` key identifies tensor values; shape vectors remain ordinary arrays.
/// Tensor types are rewritten throughout function signatures, aggregates and calls while preserving parameter groups and curry structure.
/// Rank must be literal; literal zero extents are unsupported, and only the outermost extent may be a runtime value.
/// `mem.add_mem` (scheduled next in the pipeline) threads the memory; run `buffer.lower_ptr`
/// afterwards to reach `mem.Ptr`.
///
axm lower_to_mem: compile.Phase;
///
/// ## Compositional Schedule Tree (`SchedTree`) & CPU PE Interpreter (`run_levels`)
///
/// First-order schedule tree for multi-level CPU tiling and panel packing, interpreted by partial
/// evaluation at bufferization (`tensor.lower_to_mem`):
///
/// - `Leaf vdim`               : emit leaf `btensor.map_reduce_post` accumulating into `dst`.
/// - `Split d ts mode body`    : a serial loop (`affine.For`) over axis `d` in tiles of `ts`; `mode` says how the tail runs (`SplitMode`).
/// - `Reduce d w body`         : reduction axis `d` keeps `w` partial accumulators, which the combiner's merge joins; the `Leaf` below vectorizes `d`.
/// - `Pack d w slot dep body`  : BLIS panel packing of `slot` along axis `d` with width `w`.
/// - `Stage slot body`         : compute the box of `slot`'s producer that `body` reads, through the slot's `tensor.Aff` map.
/// - `Alloc slot body`         : allocate once the storage the outermost `Pack`s or `Stage`s of `slot` in `body` fill, instead of each time they run.
/// - `Switch d c small big`    : `small` where axis `d` has fewer than `c` iterations, `big` elsewhere.
///
/// `sched_par`, `sched_seq` and `sched_peel` build splits; `sched_par` cuts several axes, the first outermost.
///
/// `run_levels` takes each axis' static bound `cap0` and whether its extent is a run-time value `dyn0`.
/// A run-time axis must be split by a `Loop` or `Peel` `Split` before a `Pack` or `Leaf` sizes anything by it; a `Leaf` with a run-time register extent computes an edge tile in a scratch tile.

anx fun take {T: *} (_ x: T)@tt: T = return x;

/// The `cap` of a run-time extent without a static bound; panels and edge tiles need a smaller one from a `Split`.
anx let levels_unbounded = 1099511627776;

lam levels_steps {X: *} (n: Nat) (m: mem.M 0, x: X)
    (body: [Nat, mem.M 0, X] → [mem.M 0, X]) (after: [mem.M 0, X] → [mem.M 0, X])
    : [mem.M 0, X] =
    fun run (s: [mem.M 0, X])@tt: [mem.M 0, X] =
        affine.For @(0, 2, (mem.M 0, X)) step exit (0I64, core.bitcast I64 n, 1I64, s)
        where
            con step (i: I64, s: [mem.M 0, X], yield: Cn [mem.M 0, X]) =
                let (m, x) = s;
                yield (body (core.bitcast Nat i, m, x));
            con exit (s: [mem.M 0, X]) = return (after s);
        end;
    cps.cps2ds run (m, x);

lam levels_seq {k: Nat} {A: *} (fs: «k; A → A», a0: A): A =
    vec.fold.r @(A, A → A) @k (λ (f: A → A, a: A): A = f a) (fs, a0);

fun levels_take_mem {T: *} (m: mem.M 0, _: T, x: T)@tt: [mem.M 0, T] = return (m, x);

/// A binary operation as the combiner of two partial results.
anx lam levels_merge {T: *} (op: [T, T] → T): Fn [mem.M 0, T, T] → [mem.M 0, T] =
    fun merge (m: mem.M 0, a b: T)@tt: [mem.M 0, T] = return (m, op (a, b));
    merge;

/// `e`'s terms in `x` without its constants, i.e. `e (lo + x) - e lo` for an affine `e`; the flag tells whether there is any.
lam aff_rel {n s: Nat} (e: AffE (n, s), vals: «s; Nat», x: «n; affine.Index»)@(core.pe.is_closed e): [Bool, affine.Index] =
    match e with
        | Dim d  => (tt, x#d)
        | Add p  =>
            let (a, u) = aff_rel (p#0₂, vals, x);
            let (b, v) = aff_rel (p#1₂, vals, x);
            (((ff, affine.lit 0), (tt, v))#b, ((tt, u), (tt, affine.op.add (u, v)))#b)#a
        | Mul p  => let (a, u) = aff_rel (p#0₂, vals, x); (a, affine.semiop.mul (u, aff_k (p#1₂, vals)))
        | Sym _  => (ff, affine.lit 0)
        | Lit _  => (ff, affine.lit 0)
        | FDiv _ => (ff, affine.lit 0)
        | CDiv _ => (ff, affine.lit 0)
        | Mod _  => (ff, affine.lit 0)
        | Sub _  => (ff, affine.lit 0);

/// The smallest interval holding what `e` maps the box `(lo, ext)` onto, as its start and width minus one, and whether `e` is affine so that a tile reads it at the linear part of `e`.
/// Coefficients are naturals, so an inner expression is monotone and a floordiv or ceildiv maps its ends; a modulus wraps unless the inner interval fits one window.
/// A difference, whose operands stay in its domain no larger than its minuend, spans from the least minuend less the greatest subtrahend, and is not affine.
lam aff_span {n s: Nat} (e: AffE (n, s), vals: «s; Nat», lo ext: «n; Nat»)@(core.pe.is_closed e): [Bool, Nat, Nat] =
    match e with
        | Dim d  => (tt, lo#d, core.nat.sub (ext#d, 1))
        | Sym k  => (tt, vals#k, 0)
        | Lit c  => (tt, c, 0)
        | Add p  =>
            let (a, l, w) = aff_span (p#0₂, vals, lo, ext);
            let (b, k, v) = aff_span (p#1₂, vals, lo, ext);
            (core.bit2.and 2 (a, b), core.nat.add (l, k), core.nat.add (w, v))
        | Mul p  => let (a, l, w) = aff_span (p#0₂, vals, lo, ext); let c = aff_k (p#1₂, vals); (a, core.nat.mul (l, c), core.nat.mul (w, c))
        | FDiv p =>
            let (_, l, w) = aff_span (p#0₂, vals, lo, ext);
            let c = aff_k (p#1₂, vals);
            let f = core.nat.div (l, c);
            (ff, f, core.nat.sub (core.nat.div (core.nat.add (l, w), c), f))
        | CDiv p =>
            let (_, l, w) = aff_span (p#0₂, vals, lo, ext);
            let c = aff_k (p#1₂, vals);
            let up = λ (x: Nat): Nat = core.nat.div (core.nat.add (x, core.nat.sub (c, 1)), c);
            (ff, up l, core.nat.sub (up (core.nat.add (l, w)), up l))
        | Mod p  =>
            let (_, l, w) = aff_span (p#0₂, vals, lo, ext);
            let c = aff_k (p#1₂, vals);
            let r = core.nat.rem (l, c);
            let wraps = c < core.nat.add (core.nat.add (r, w), 1);
            (ff, core.select (wraps, 0, r), core.select (wraps, core.nat.sub (c, 1), w))
        | Sub p  =>
            let (_, l, w) = aff_span (p#0₂, vals, lo, ext);
            let (_, k, v) = aff_span (p#1₂, vals, lo, ext);
            let start = core.nat.sub (l, core.nat.add (k, v));
            (ff, start, core.nat.sub (core.nat.sub (core.nat.add (l, w), k), start));

/// A static bound on the width minus one of `aff_span (e, _, lo, ext)` for any `lo`, `levels_unbounded` where a run-time factor or modulus leaves none.
lam aff_reach {n s: Nat} (e: AffE (n, s), ext: «n; Nat»)@(core.pe.is_closed e): Nat =
    match e with
        | Dim d  => core.nat.sub (ext#d, 1)
        | Sym _  => 0
        | Lit _  => 0
        | Add p  => core.nat.add (aff_reach (p#0₂, ext), aff_reach (p#1₂, ext))
        | Mul p  => let w = aff_reach (p#0₂, ext); let c = aff_kstatic p#1₂; core.select (core.select (w == 0, tt, c != 0), core.nat.mul (w, c), levels_unbounded)
        | FDiv p => let w = aff_reach (p#0₂, ext); let k = aff_kstatic p#1₂; let c = core.select (k == 0, 1, k); core.nat.div (core.nat.add (w, core.nat.sub (c, 1)), c)
        | CDiv p => let w = aff_reach (p#0₂, ext); let k = aff_kstatic p#1₂; let c = core.select (k == 0, 1, k); core.nat.div (core.nat.add (w, core.nat.sub (c, 1)), c)
        | Mod p  => let c = aff_kstatic p#1₂; core.select (aff_reach (p#0₂, ext) == 0, 0, core.select (c == 0, levels_unbounded, core.nat.sub (c, 1)))
        | Sub p  => core.nat.add (aff_reach (p#0₂, ext), aff_reach (p#1₂, ext));

/// Whether `e` mentions loop `d`, also below a floordiv or mod.
lam aff_mentions {n s: Nat} (e: AffE (n, s), d: Idx n)@(core.pe.is_closed e): Bool =
    match e with
        | Dim j  => core.icmp.e (j, d)
        | Add p  => core.bit2.or 2 (aff_mentions (p#0₂, d), aff_mentions (p#1₂, d))
        | Mul p  => aff_mentions (p#0₂, d)
        | FDiv p => aff_mentions (p#0₂, d)
        | CDiv p => aff_mentions (p#0₂, d)
        | Mod p  => aff_mentions (p#0₂, d)
        | Sub p  => core.bit2.or 2 (aff_mentions (p#0₂, d), aff_mentions (p#1₂, d))
        | Sym _  => ff
        | Lit _  => ff;

/// The coefficient of loop `d` in `e`; `0` where `d` only occurs below a floordiv or mod, is subtracted, or is scaled by a run-time factor.
lam aff_coef {n s: Nat} (e: AffE (n, s), d: Idx n)@(core.pe.is_closed e): Nat =
    match e with
        | Dim j  => (0, 1)#(core.icmp.e (j, d))
        | Add p  => core.nat.add (aff_coef (p#0₂, d), aff_coef (p#1₂, d))
        | Mul p  => core.nat.mul (aff_coef (p#0₂, d), aff_kstatic p#1₂)
        | Sym _  => 0
        | Lit _  => 0
        | FDiv _ => 0
        | CDiv _ => 0
        | Mod _  => 0
        | Sub p  => core.select (aff_mentions (p#1₂, d), 0, aff_coef (p#0₂, d));

/// The loops `f` reads along.
anx lam aff_reads {n m: Nat} (f: Aff (n, m)): «n; Bool» =
    ‹d: n; vec.fold.r @(Bool, Idx m) @m (λ (i: Idx m, acc: Bool): Bool = core.bit2.or 2 (acc, aff_mentions (f#rows#i, d))) (‹i: m; i›, ff)›;

/// The loop `e` is, or `n` unless it is a loop coordinate.
lam aff_loop {n s: Nat} (e: AffE (n, s))@(core.pe.is_closed e): Nat =
    match e with
        | Dim d  => core.idx2nat d
        | Sym _  => n
        | Lit _  => n
        | Add _  => n
        | Mul _  => n
        | FDiv _ => n
        | CDiv _ => n
        | Mod _  => n
        | Sub _  => n;

/// The loop each coordinate of `f` writes, and whether they are distinct ones of the first `m`.
anx lam aff_perm {n m: Nat} (f: Aff (n, m)): [Bool, «m; Nat»] =
    let loops = ‹i: m; aff_loop (f#rows#i)›;
    let fresh = λ (i: Idx m): Bool =
        vec.fold.r @(Bool, Idx m) @m (λ (j: Idx m, acc: Bool): Bool = core.select (core.idx2nat j < core.idx2nat i, core.select (loops#j == loops#i, ff, acc), acc)) (‹j: m; j›, loops#i < m);
    (vec.fold.r @(Bool, Idx m) @m (λ (i: Idx m, acc: Bool): Bool = core.bit2.and 2 (acc, fresh i)) (‹i: m; i›, tt), loops);

/// Whether `e` is a constant, literal or run-time.
lam aff_const {n s: Nat} (e: AffE (n, s))@(core.pe.is_closed e): Bool =
    match e with
        | Lit _  => tt
        | Sym _  => tt
        | Dim _  => ff
        | Add _  => ff
        | Mul _  => ff
        | FDiv _ => ff
        | CDiv _ => ff
        | Mod _  => ff
        | Sub _  => ff;

/// The loop `e` reads injectively - itself, scaled by a nonzero literal, or shifted by a constant - or `n`.
lam aff_inj {n s: Nat} (e: AffE (n, s))@(core.pe.is_closed e): Nat =
    match e with
        | Dim d  => core.idx2nat d
        | Mul p  => core.select (aff_kstatic p#1₂ == 0, n, aff_inj p#0₂)
        | Add p  => core.select (aff_const p#0₂, core.select (aff_const p#1₂, n, aff_inj p#1₂), core.select (aff_const p#1₂, aff_inj p#0₂, n))
        | Sub p  => core.select (aff_const p#0₂, core.select (aff_const p#1₂, n, aff_inj p#1₂), core.select (aff_const p#1₂, aff_inj p#0₂, n))
        | Sym _  => n
        | Lit _  => n
        | FDiv _ => n
        | CDiv _ => n
        | Mod _  => n;

/// Whether `f` reads each loop and every row reads one injectively, so that it reads each element at most once.
anx lam aff_injective {n m: Nat} (f: Aff (n, m)): Bool =
    let loops = ‹i: m; aff_inj (f#rows#i)›;
    let hit   = λ (d: Idx n): Bool = vec.fold.r @(Bool, Idx m) @m (λ (i: Idx m, acc: Bool): Bool = core.select (loops#i == core.idx2nat d, tt, acc)) (‹i: m; i›, ff);
    let all   = vec.fold.r @(Bool, Idx n) @n (λ (d: Idx n, acc: Bool): Bool = core.select (hit d, acc, ff)) (‹d: n; d›, tt);
    vec.fold.r @(Bool, Idx m) @m (λ (i: Idx m, acc: Bool): Bool = core.select (loops#i < n, acc, ff)) (‹i: m; i›, all);

/// Whether `f` reads along loop `d` at unit stride: `d` occurs only in the last row, with coefficient 1.
anx lam aff_unit {n m: Nat} (f: Aff (n, m), d: Idx n): Bool =
    vec.fold.r @(Bool, Idx m) @m
        (λ (i: Idx m, acc: Bool): Bool =
            core.bit2.and 2 (acc, aff_coef (f#rows#i, d) == (0, 1)#(core.idx2nat i + 1 == m)))
        (‹i: m; i›, tt);

/// Whether every row of `f` is affine, so that a tile reads a staged box at its linear part and the box's extents do not depend on where the tile starts.
anx lam aff_linear {n m: Nat} (f: Aff (n, m)): Bool =
    vec.fold.r @(Bool, Idx m) @m
        (λ (i: Idx m, acc: Bool): Bool = core.bit2.and 2 (acc, (aff_span (f#rows#i, f#vals, ‹n; 0›, ‹n; 1›))#0₃)) (‹i: m; i›, tt);

/// The box `f` maps the box `(lo, ext)` onto, whose extents may be run-time values where a row divides or takes a modulus, and a static bound on them for extents up to `cap`.
lam aff_box {n m: Nat} (f: Aff (n, m)) (lo ext cap: «n; Nat»): [«m; Nat», «m; Nat», «m; Nat»] =
    let sp = ‹i: m; aff_span (f#rows#i, f#vals, lo, ext)›;
    (‹i: m; (sp#i)#1₃›, ‹i: m; core.nat.add ((sp#i)#2₃, 1)›, ‹i: m; core.nat.add (aff_reach (f#rows#i, cap), 1)›);

/// How a slot gets its data: the buffer itself, or a producer that computes any box `(lo, ext)` of it on demand into a buffer it is given.
/// `cap` bounds `ext` and `dyn` marks its run-time extents, from which the producer picks its own tiling.
anx nom Prod (r: Nat, T: *) =
    | Plain: []
    | Fill:  [lo ext cap: «r; Nat», dyn: «r; Bool»] → [mem.M 0, buffer.Buf (r, ext, T)] → [mem.M 0, buffer.Buf (r, ext, T)];
anx lam prod_plain (r: Nat, T: *): Prod (r, T) = (Prod (r, T))#Plain;

/// Whether `LowerToMem` stages a producer of the kind `p` in a consumer of the kind `c`, once the mechanism can.
/// The kinds are 0 for an elementwise map-reduce, 1 for any other map-reduce but a contraction, 2 for a contraction, 3 for a pad and 4 for a gather.
/// A contraction takes no producer: staged in its bands, any producer is computed again for every block of the loop it does not read, which costs more than the intermediate it saves.
anx lam fuse_policy (p c: Nat): Bool = core.ncmp.ne (c, 2);

/// A gather as a producer: a box of its result reads the source through the same box of `index`.
anx lam gather_fill {T: *, r: Nat} (s_src s_idx: «r; Nat», dim: Idx r)
    (input: buffer.Buf (r, s_src, T), index: buffer.Buf (r, s_idx, Idx (s_src#dim))): Prod (r, T) =
    let make = λ (lo ext _: «r; Nat», _: «r; Bool») (m: mem.M 0, b: buffer.Buf (r, ext, T)): [mem.M 0, buffer.Buf (r, ext, T)] =
        btensor.gather_at @(T, r) (s_src, s_idx, ext, lo) dim (m, b, input, index);
    (Prod (r, T))#Fill make;

/// A constant pad as a producer: a box of its result takes `value` and then the part of `input` it overlaps.
anx lam pad_fill {T: *, r: Nat} (s_in lo: «r; Nat») (input: buffer.Buf (r, s_in, T), value: T): Prod (r, T) =
    let make = λ (at ext _: «r; Nat», _: «r; Bool») (m: mem.M 0, b: buffer.Buf (r, ext, T)): [mem.M 0, buffer.Buf (r, ext, T)] =
        let m   = buffer.set (r, ext, T) (m, b, value);
        let dst = ‹d: r; core.nat.sub (lo#d, at#d)›;
        let src = ‹d: r; core.nat.sub (at#d, lo#d)›;
        let stop = ‹d: r; core.select (at#d + ext#d < lo#d + s_in#d, at#d + ext#d, lo#d + s_in#d)›;
        let len = ‹d: r; core.nat.sub (stop#d, at#d + dst#d)›;
        btensor.map_reduce @1 @(T, r, r) (ext, len) @(T, r, s_in) (levels_take_mem @T, value)
            (λ (o: «r; affine.Index»): «r; affine.Index» = ‹d: r; affine.op.add (affine.lit (dst#d), o#d)›)
            (λ (o: «r; affine.Index»): «r; affine.Index» = ‹d: r; affine.op.add (affine.lit (src#d), o#d)›)
            (m, b, input);
    (Prod (r, T))#Fill make;

/// A slot as the loops below a node see it; the rank is a field so that slots of different ranks share one type.
/// `flat` marks the buffer itself read through an affine `aff` at `q`, which a leaf reads from a buffer shifted to its tile.
/// `store` holds `sn` elements an `Alloc` above provides for the next `Pack` or `Stage` of the slot, if `sn` is not 0.
/// `own` says that `data` is the slot's own buffer rather than a panel or staged box sized by `cap`.
nom LevelsView (Rn: Nat, T: *) = [
    r:    Nat,
    s:    «r; Nat»,
    unit: «Rn; Nat»,
    q:    «Rn; affine.Index»,
    at:   [«Rn; affine.Index», «Rn; affine.Index»] → «r; affine.Index»,
    data: buffer.Buf (r, s, T),
    aff:  Aff (Rn, r),
    prod: Prod (r, T),
    reads: «Rn; Bool»,
    flat: Bool,
    sn:   Nat,
    store: buffer.Buf (1, sn, T),
    own:  Bool,
];

/// Whether a slot holds its data, i.e. is not a producer still waiting for a `Stage`.
lam levels_ready {r: Nat, T: *} (p: Prod (r, T)): Bool =
    match p with
        | Plain _ => tt
        | Fill _  => ff;

lam levels_plain {Rn: Nat} (r: Nat, f: Aff (Rn, r))@(core.pe.is_closed r)
    : [«Rn; affine.Index», «Rn; affine.Index»] → «r; affine.Index» =
    lm (q o: «Rn; affine.Index»): «r; affine.Index» =
        let x = ‹e: Rn; affine.op.add (q#e, o#e)›;
        ‹i: r; aff_eval (f#rows#i, f#vals, x)›;

/// CPU panel packing for one input: loop `d` in runs of `w`, other moving loops in order, lane last.
lam levels_pack_one {T: *, Rn: Nat} (r: Nat) (s: «r; Nat»)
    (ix: [«Rn; affine.Index», «Rn; affine.Index»] → «r; affine.Index») (x: buffer.Buf (r, s, T))
    (d w: Nat, dep: «Rn; Bool», q: «Rn; affine.Index», size cap: «Rn; Nat», dyn: Bool, sn: Nat, store: buffer.Buf (1, sn, T), m: mem.M 0)
    : [mem.M 0, sp: «core.nat.add (Rn, 1); Nat», buffer.Buf (core.nat.add (Rn, 1), sp, T),
       [«Rn; affine.Index», «Rn; affine.Index»] → «core.nat.add (Rn, 1); affine.Index»] =
    let Rp    = core.nat.add (Rn, 1);
    let n     = size#(core.idx 0 Rn d);
    let full  = core.nat.div (n, w);
    let tail  = core.nat.rem (n, w);
    let n_cap = cap#(core.idx 0 Rn d);
    // A run-time extent gets a spare panel, since an empty edge tile still reads the panel after the last whole one.
    let count = core.nat.add (core.nat.add (core.nat.div (n_cap, w), (0, 1)#(core.ncmp.ne (core.nat.rem (n_cap, w), 0))), (0, 1)#dyn);
    // The panel is sized by the static `cap`, so a run-time tail extent never reaches a buffer type.
    let sp    = ‹e: Rp; let k = core.idx2nat e;
        (w, ((1, cap#(core.idx 0 Rn k))#(dep#(core.idx 0 Rn k)), count)#(k == d))#(k < Rn)›;
    let held   = vec.fold.r @(Nat, Idx Rp) @Rp (λ (e: Idx Rp, acc: Nat): Nat = core.nat.mul (acc, sp#e)) (‹e: Rp; e›, 1);
    let store  = refly.check (core.select (0 < sn, core.select (sn < held, ff, tt), tt), store, "SchedTree: a Pack needs more than its Alloc holds");
    let (m, p) = ((λ (_: []): [mem.M 0, buffer.Buf (Rp, sp, T)] = buffer.alloc (Rp, sp, T) m,
                   λ (_: []): [mem.M 0, buffer.Buf (Rp, sp, T)] = (m, buffer.view (Rp, sp, T) (sn, store)))#(0 < sn)) ();
    let last   = core.idx 0 Rp Rn;
    let src = λ (first: Nat) = lm (c: «Rp; affine.Index»): «r; affine.Index» =
        ix (q, ‹e: Rn; let k = core.idx2nat e; let ce = c#(core.idx 0 Rp k);
            (ce, affine.op.add (affine.semiop.mul (affine.op.add (ce, affine.lit first), w), c#last))#(k == d)›);
    let fill = λ (first panels lanes: Nat) (m: mem.M 0): mem.M 0 =
        let ext = ‹e: Rp; let k = core.idx2nat e; let j = core.idx 0 Rn k;
            ((lanes, (1, size#j)#(dep#j))#(k < Rn), panels)#(k == d)›;
        (btensor.map_reduce @1 @(T, Rp, Rp) (sp, ext) @(T, r, s) (levels_take_mem @T, ⊥:T)
            (lm (c: «Rp; affine.Index»): «Rp; affine.Index» =
                ‹e: Rp; (c#e, affine.op.add (c#e, affine.lit first))#(core.idx2nat e == d)›)
            (src first) (m, p, x))#0₂;
    // A run-time extent cannot select the memory to continue with; its empty fills just run no iterations.
    let m = ((m, fill (0, full, w) m)#(core.ncmp.ne (full, 0)), fill (0, full, w) m)#dyn;
    let m = ((m, fill (full, 1, tail) m)#(core.ncmp.ne (tail, 0)), fill (full, 1, tail) m)#dyn;
    let to = lm (q o: «Rn; affine.Index»): «Rp; affine.Index» =
        let od = o#(core.idx 0 Rn d);
        ‹e: Rp; let k = core.idx2nat e; let j = core.idx 0 Rn k;
            (affine.semiop.rem (od, w),
             ((affine.lit 0, affine.op.add (q#j, o#j))#(dep#j),
              affine.op.add (q#j, affine.semiop.floordiv (od, w)))#(k == d))#(k < Rn)›;
    (m, sp, p, to);

/// How a `Split` runs the tail of its axis.
/// `Fixed` needs a static extent and peels its tail statically; `Loop` counts the tiles at run time, so its body is unfolded once;
/// `Peel` is `Fixed` on a static extent, and on a run-time one a loop over whole tiles followed by one edge tile, which may be empty.
anx nom SplitMode =
    | Fixed: []
    | Loop:  []
    | Peel:  [];

anx nom SchedTree (N Rn: Nat) =
    | Leaf:   Nat
    | Split:  [d ts: Nat, mode: SplitMode, body: SchedTree (N, Rn)]
    | Reduce: [d w: Nat, body: SchedTree (N, Rn)]
    | Pack:   [d w: Nat, slot: Idx N, dep: «Rn; Bool», body: SchedTree (N, Rn)]
    | Stage:  [slot: Idx N, body: SchedTree (N, Rn)]
    | Alloc:  [slot: Idx N, body: SchedTree (N, Rn)]
    | Switch: [d c: Nat, small big: SchedTree (N, Rn)];

/// Yields `tree` once its root state is static, and logs it with that state.
/// `LowerToMem` wraps the tree of a fused producer in it at `-VVVV`, where only partial evaluation knows the box.
axm sched_show: {N Rn: Nat} → [ro: Nat, caps: «Rn; Nat», dyn: «Rn; Bool», fuse: «N; Nat», reads: «N; «Rn; Bool»», tree: SchedTree (N, Rn)]
              → SchedTree (N, Rn), normalize_sched_show;

anx lam sched_leaf {N Rn: Nat} (vdim: Nat): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Leaf vdim;
anx lam sched_split {N Rn: Nat} (d ts: Nat, mode: SplitMode, body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Split (d, ts, mode, body);
/// Cuts every axis `d` with `sizes#d` other than 0 into tiles of that size, the first axis outermost.
anx lam sched_par {N Rn: Nat} (sizes: «Rn; Nat», body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    vec.fold.r @(SchedTree (N, Rn), Idx Rn) @Rn
        (λ (d: Idx Rn, t: SchedTree (N, Rn)): SchedTree (N, Rn) =
            (t, sched_split @(N, Rn) (core.idx2nat d, sizes#d, SplitMode#Fixed, t))#(core.ncmp.ne (sizes#d, 0))) (‹d: Rn; d›, body);
anx lam sched_reduce {N Rn: Nat} (d w: Nat, body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Reduce (d, w, body);
anx lam sched_pack {N Rn: Nat} (d w: Nat, slot: Idx N, dep: «Rn; Bool», body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Pack (d, w, slot, dep, body);

anx lam sched_seq {N Rn: Nat} (d ts: Nat, body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    sched_split @(N, Rn) (d, ts, SplitMode#Loop, body);

anx lam sched_peel {N Rn: Nat} (d ts: Nat, body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    sched_split @(N, Rn) (d, ts, SplitMode#Peel, body);

anx lam sched_stage {N Rn: Nat} (slot: Idx N, body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Stage (slot, body);
anx lam sched_alloc {N Rn: Nat} (slot: Idx N, body: SchedTree (N, Rn)): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Alloc (slot, body);
/// Runs `small` where loop `d` has fewer than `c` iterations, `big` elsewhere, branching at run time only for a run-time extent.
anx lam sched_switch {N Rn: Nat} (d c: Nat, small big: SchedTree (N, Rn)): SchedTree (N, Rn) =
    (SchedTree (N, Rn))#Switch (d, c, small, big);

/// The tree of an IREE-style `lowering_config`: one `sched_par` per level, outermost first, each cutting every loop by its tile size
/// (0 leaves a loop whole), over a `Leaf vdim`.
anx lam sched_levels {N Rn L: Nat} (levels: «L; «Rn; Nat»», vdim: Nat): SchedTree (N, Rn) =
    vec.fold.r @(SchedTree (N, Rn), «Rn; Nat») @L
        (λ (sizes: «Rn; Nat», t: SchedTree (N, Rn)): SchedTree (N, Rn) = sched_par @(N, Rn) (sizes, t)) (levels, sched_leaf @(N, Rn) vdim);


/// One function per kind of `SchedTree` node in constructor order (`Leaf`, `Split`, `Reduce`, `Pack`, `Stage`, `Alloc`, `Switch`),
/// each given its fields with the subtrees already folded into `R`.
anx lam SchedAlg (N Rn: Nat, R: *): * =
    [Nat → R, [Nat, Nat, SplitMode, R] → R, [Nat, Nat, R] → R, [Nat, Nat, Idx N, «Rn; Bool», R] → R, [Idx N, R] → R, [Idx N, R] → R, [Nat, Nat, R, R] → R];

/// Folds `t` bottom-up with `alg`.
anx lam sched_fold {N Rn: Nat, R: *} (alg: SchedAlg (N, Rn, R)) (t: SchedTree (N, Rn))@(core.pe.is_closed t): R =
    let (leaf, split, reduce, pack, stage, alloc, switch) = alg;
    let go = λ (b: SchedTree (N, Rn)): R = sched_fold @(N, Rn, R) alg b;
    match t with
        | Leaf v   => leaf v
        | Split n  => split (n#d, n#ts, n#mode, go (n#body))
        | Reduce n => reduce (n#d, n#w, go (n#body))
        | Pack n   => pack (n#d, n#w, n#slot, n#dep, go (n#body))
        | Stage n  => stage (n#slot, go (n#body))
        | Alloc n  => alloc (n#slot, go (n#body))
        | Switch n => switch (n#d, n#c, go (n#small), go (n#big));

/// The fold that rebuilds its tree; an edit replaces the functions of the nodes it changes.
anx lam sched_rebuild {N Rn: Nat} (_: []): SchedAlg (N, Rn, SchedTree (N, Rn)) =
    let T = SchedTree (N, Rn);
    (λ (v: Nat): T = T#Leaf v,
     λ (d ts: Nat, mode: SplitMode, b: T): T = T#Split (d, ts, mode, b),
     λ (d w: Nat, b: T): T = T#Reduce (d, w, b),
     λ (d w: Nat, slot: Idx N, dep: «Rn; Bool», b: T): T = T#Pack (d, w, slot, dep, b),
     λ (slot: Idx N, b: T): T = T#Stage (slot, b),
     λ (slot: Idx N, b: T): T = T#Alloc (slot, b),
     λ (d c: Nat, small big: T): T = T#Switch (d, c, small, big));

/// `t` without the packs of `slot`.
anx lam sched_unpack {N Rn: Nat} (slot: Idx N) (t: SchedTree (N, Rn)): SchedTree (N, Rn) =
    let T = SchedTree (N, Rn);
    let (leaf, split, reduce, pack, stage, alloc, switch) = sched_rebuild @(N, Rn) ();
    let keep = λ (d w: Nat, s: Idx N, dep: «Rn; Bool», b: T): T = (pack (d, w, s, dep, b), b)#(core.icmp.e (s, slot));
    sched_fold @(N, Rn, T) (leaf, split, reduce, keep, stage, alloc, switch) t;

/// `t` with every split of loop `d` at tile size `ts`.
anx lam sched_retile {N Rn: Nat} (d ts: Nat) (t: SchedTree (N, Rn)): SchedTree (N, Rn) =
    let T  = SchedTree (N, Rn);
    let (leaf, split, reduce, pack, stage, alloc, switch) = sched_rebuild @(N, Rn) ();
    let split2 = λ (e o: Nat, mode: SplitMode, b: T): T = split (e, core.select (e == d, ts, o), mode, b);
    sched_fold @(N, Rn, T) (leaf, split2, reduce, pack, stage, alloc, switch) t;

/// `t` with each `Leaf vdim` replaced by `g vdim`, e.g. a register tile above it.
anx lam sched_at_leaves {N Rn: Nat} (g: Nat → SchedTree (N, Rn)) (t: SchedTree (N, Rn)): SchedTree (N, Rn) =
    let (_, split, reduce, pack, stage, alloc, switch) = sched_rebuild @(N, Rn) ();
    sched_fold @(N, Rn, SchedTree (N, Rn)) (g, split, reduce, pack, stage, alloc, switch) t;

/// `t` with each leaf cut by the levels of `sched_levels` first.
anx lam sched_with_levels {N Rn L: Nat} (levels: «L; «Rn; Nat»») (t: SchedTree (N, Rn)): SchedTree (N, Rn) =
    sched_at_leaves @(N, Rn) (λ (v: Nat): SchedTree (N, Rn) = sched_levels @(N, Rn, L) (levels, v)) t;

/// The number of nodes of `t`.
anx lam sched_size {N Rn: Nat} (t: SchedTree (N, Rn)): Nat =
    let one = λ (n: Nat): Nat = core.nat.add (n, 1);
    sched_fold @(N, Rn, Nat)
        (λ (_: Nat): Nat = 1, λ (_: Nat, _: Nat, _: SplitMode, b: Nat): Nat = one b, λ (_: Nat, _: Nat, b: Nat): Nat = one b,
         λ (_: Nat, _: Nat, _: Idx N, _: «Rn; Bool», b: Nat): Nat = one b, λ (_: Idx N, b: Nat): Nat = one b, λ (_: Idx N, b: Nat): Nat = one b,
         λ (_: Nat, _: Nat, a: Nat, b: Nat): Nat = one (core.nat.add (a, b))) t;

/// `post` with its epilogue inputs as a map over a tile of the result: the cells `cells` gives for the coordinates below `ext`.
anx lam levels_epilogue {To: *, Ro: Nat, So: «Ro; Nat»} {nps: Nat, Tps: «nps; *», Rps: «j: nps; Nat», Sps: «j: nps; «Rps#j; Nat»»}
    (post: Fn [mem.M 0, To, «j: nps; Tps#j»] → [mem.M 0, To], post_maps: «j: nps; «Ro; affine.Index» → «Rps#j; affine.Index»»,
     post_is: «j: nps; buffer.Buf (Rps#j, Sps#j, Tps#j)»)
    (m: mem.M 0, dst: buffer.Buf (Ro, So, To), cells: «Ro; affine.Index» → «Ro; affine.Index», ext: «Ro; Nat»): [mem.M 0, buffer.Buf (Ro, So, To)] =
    btensor.map_reduce_post @(1, nps) @(To, To, Ro, Ro, btensor.SchedT) (So, ext, btensor.mk_sched (Ro, 0))
        @(To, Ro, So, Tps, Rps, Sps) @To (levels_take_mem @To, ⊥:To, post) cells (cells, post_maps) (m, dst, dst, post_is);

/// The epilogue that leaves every cell as it is.
anx lam levels_no_epilogue {To: *, Ro: Nat, So: «Ro; Nat»}
    (m: mem.M 0, dst: buffer.Buf (Ro, So, To), _: «Ro; affine.Index» → «Ro; affine.Index», _: «Ro; Nat»): [mem.M 0, buffer.Buf (Ro, So, To)] = (m, dst);

/// What reads the finished cells of a tile without changing them: the tile starts at `corner` of the output loops, spans `ext` of them, at most `cap`, and `dyn` marks its run-time extents.
let LevelsDrain = λ (To: *, Ro: Nat, So: «Ro; Nat»): * =
    [mem.M 0, buffer.Buf (Ro, So, To), corner ext cap: «Ro; Nat», dyn: «Ro; Bool»] → mem.M 0;

anx lam levels_no_drain {To: *, Ro: Nat, So: «Ro; Nat»}
    (m: mem.M 0, _: buffer.Buf (Ro, So, To), _ _ _: «Ro; Nat», _: «Ro; Bool»): mem.M 0 = m;

anx lam levels_drain_both {To: *, Ro: Nat, So: «Ro; Nat»} (a b: LevelsDrain (To, Ro, So))
    (m: mem.M 0, dst: buffer.Buf (Ro, So, To), corner ext cap: «Ro; Nat», dyn: «Ro; Bool»): mem.M 0 =
    b (a (m, dst, corner, ext, cap, dyn), dst, corner, ext, cap, dyn);

/// `a · b`, saturated at `levels_unbounded`.
lam levels_mul (a b: Nat): Nat =
    core.select (core.select (a == 0, tt, b < core.nat.div (levels_unbounded, a)), core.nat.mul (a, b), levels_unbounded);

/// The elements the outermost `Pack`s and `Stage`s of `want` in `t` fill at most, for loops bounded by `caps`; `box` gives a `Stage`'s for given bounds, and `fills` tells whether a `Stage` fills anything.
/// A run-time axis' whole tiles are as wide as its `Split`, and its panels get the spare one `levels_pack_one` gives them.
lam levels_need {N Rn: Nat} (want: Idx N, box: «Rn; Nat» → Nat, fills: Bool) (caps: «Rn; Nat», dyn: «Rn; Bool», t: SchedTree (N, Rn))@(core.pe.is_closed t): Nat =
    let go  = λ (caps: «Rn; Nat», b: SchedTree (N, Rn)): Nat = levels_need @(N, Rn) (want, box, fills) (caps, dyn, b);
    let dyn_at = λ (d: Nat): «Rn; Bool» = ‹e: Rn; core.select (core.idx2nat e == d, tt, dyn#e)›;
    let at  = λ (d c: Nat): «Rn; Nat» = ‹e: Rn; core.select (core.idx2nat e == d, c, caps#e)›;
    let cap = λ (d: Nat): Nat = caps#(core.idx 0 Rn d);
    let min = λ (a b: Nat): Nat = core.select (a < b, a, b);
    let max = λ (a b: Nat): Nat = core.select (a < b, b, a);
    let own = λ (s: Idx N, other mine: Nat): Nat = (other, mine)#(core.icmp.e (s, want));
    match t with
        | Leaf _   => 0
        | Split n  =>
            let caps = at (n#d, core.select (dyn#(core.idx 0 Rn (n#d)), n#ts, min (cap (n#d), n#ts)));
            // A `Loop` counts its tiles at run time, so they are run-time extents even of a static axis.
            let dyn = (dyn, dyn_at (n#d))#(match n#mode with | Fixed _ => ff | Loop _ => tt | Peel _ => ff);
            levels_need @(N, Rn) (want, box, fills) (caps, dyn, n#body)
        | Reduce n => go (caps, n#body)
        | Pack n   =>
            let w     = n#w;
            let count = core.nat.add (core.nat.div (core.nat.add (cap (n#d), core.nat.sub (w, 1)), w), (0, 1)#(dyn#(core.idx 0 Rn (n#d))));
            let panel = vec.fold.r @(Nat, Idx Rn) @Rn
                (λ (e: Idx Rn, acc: Nat): Nat = core.select (core.idx2nat e == n#d, acc, core.select (n#dep#e, levels_mul (acc, caps#e), acc)))
                (‹e: Rn; e›, levels_mul (w, count));
            own (n#slot, go (caps, n#body), panel)
        | Stage n  => (go (caps, n#body), own (n#slot, go (caps, n#body), box caps))#fills
        | Alloc n  => own (n#slot, go (caps, n#body), 0)
        | Switch n => max (go (at (n#d, min (cap (n#d), core.nat.sub (n#c, 1))), n#small), go (caps, n#big));

/// `run_levels` whose slots may be producers: a `Stage slot` node computes only the box of the producer that the loops below it read.
/// `run_levels_with` over the loops starting at `origin`; the output is indexed from zero, so a producer computes a box of its result.
anx lam run_levels_at {N: Nat, To: *, Ro Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (So: «Ro; Nat», Sr origin: «Rn; Nat»)
    (f: Fn [mem.M 0, To, «i: N; Ts#i»] → [mem.M 0, To], init: To, post: Fn [mem.M 0, To, []] → [mem.M 0, To])
    (merge: Fn [mem.M 0, To, To] → [mem.M 0, To], lanes: Nat, finish: Bool)
    (epi: [mem.M 0, buffer.Buf (Ro, So, To), «Ro; affine.Index» → «Ro; affine.Index», «Ro; Nat»] → [mem.M 0, buffer.Buf (Ro, So, To)], eager: Bool,
     drain: LevelsDrain (To, Ro, So), drains: Bool)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: N; Aff (Rn, Rs#i)», prods: «i: N; Prod (Rs#i, Ts#i)»)
    (sched: SchedTree (N, Rn), cap0: «Rn; Nat», dyn0: «Rn; Bool»)
    (m: mem.M 0, dst0: buffer.Buf (Ro, So, To), xs0: «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    : [mem.M 0, buffer.Buf (Ro, So, To)] =
    // An abstract machine: `axes` and `views` are its environment, `tok` and `dst` its store, and a `Body` the continuation.
    // `exec_<node>` checks one instruction and runs it on the state it hands its continuation; `eval` only dispatches.
    let D     = buffer.Buf (Ro, So, To);
    let Rp    = core.nat.add (Rn, 1);
    let IxN   = «Rn; affine.Index»;
    let Views = «i: N; LevelsView (Rn, Ts#i)»;
    // `part` tells statically that a split may have cut the axis into tiles smaller than its whole extent.
    // `red` is the number of partial accumulators a `Reduce` keeps along the axis, or 0.
    let Axis  = [lo size cap: Nat, dyn part: Bool, red: Nat];
    let State = [axes: «Rn; Axis», views: Views, tok: mem.M 0, dst: D];
    let Body  = State → [mem.M 0, D];
    let zero  = ‹Rn; affine.lit 0›;
    let cols  = λ (axes: «Rn; Axis»): [«Rn; Nat», «Rn; Nat», «Rn; Nat», «Rn; Bool»] =
        (‹d: Rn; (axes#d)#lo›, ‹d: Rn; (axes#d)#size›, ‹d: Rn; (axes#d)#cap›, ‹d: Rn; (axes#d)#dyn›);

    let exec_leaf = λ (vdim: Nat, st: State): [mem.M 0, D] =
        let vdim = refly.check (vdim < Rn + 1, vdim, "SchedTree: a Leaf vectorizes a loop below Rn, or none with Rn");
        // In order, only the first reduction loop may be split unless partial results merge.
        let ordered = vec.fold.r @(Bool, Idx Rn) @Rn
            (λ (d: Idx Rn, acc: Bool): Bool = core.select (Ro < core.idx2nat d, core.select ((st#axes#d)#part, ff, acc), acc)) (‹d: Rn; d›, tt);
        let st   = refly.check (core.select (0 < lanes, tt, ordered), st, "SchedTree: only the first reduction loop may be split when the combiner has no merge");
        let (axes, vs, m, dst) = st;
        let (lo, size, cap, dyn_ax) = cols axes;
        let lanes_v = core.select (vdim < Rn, (axes#(core.idx 0 Rn vdim))#red, 0);
        let others  = vec.fold.r @(Bool, Idx Rn) @Rn
            (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d == vdim, acc, core.select ((axes#d)#red == 0, acc, ff))) (‹d: Rn; d›, tt);
        let lanes_v = refly.check (others, lanes_v, "SchedTree: a Reduce must split the loop its Leaf vectorizes");
        let blk   = λ (a: Nat): Bool = core.select (a < Rn, dyn_ax#(core.idx 0 Rn a), ff);
        let out   = lm (o: IxN): «Ro; affine.Index» =
            map_out ‹d: Rn; affine.op.add (affine.lit (lo#d), o#d)›;
        let Ris_c = ‹i: N; (vs#i)#r›;
        let Sis_c = ‹i: N; (vs#i)#s›;
        // A flat slot is read from its buffer shifted to where the map sends the tile's corner, at the map's linear part, so that the indices stay within the tile.
        let corner = ‹d: Rn; core.nat.add (origin#d, lo#d)›;
        let ins_m = ‹i: N; lm (o: IxN): «Ris_c#i; affine.Index» =
            let v = vs#i;
            ((v#at) (v#q, o), ‹j: v#r; let (h, t) = aff_rel ((v#aff)#rows#j, (v#aff)#vals, o); (affine.lit 0, t)#h›)#(v#flat)›;
        let ready = vec.fold.r @(Bool, Idx N) @N (λ (i: Idx N, acc: Bool): Bool = core.bit2.and 2 (acc, levels_ready ((vs#i)#prod))) (‹i: N; i›, tt);
        let datas = ‹i: N; let v = vs#i;
            (v#data, buffer.shift (v#r, v#s, Ts#i) (v#data, ‹j: v#r; core.idx 0 ((v#s)#j) ((aff_span ((v#aff)#rows#j, (v#aff)#vals, corner, ‹Rn; 1›))#1₃)›))#(v#flat)›;
        let ins_b = refly.check (ready, datas, "SchedTree: a Leaf reads a producer slot that no Stage above it computes");
        let fresh = vec.fold.r @(Bool, Idx Rn) @Rn
            (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d < Ro, acc, core.select (core.nat.add (origin#d, lo#d) == 0, acc, ff))) (‹d: Rn; d›, tt);
        // Only a leaf over the whole reduction may finish its cells.
        // Statically, so that `post` stays inlinable; a leaf over part of the reduction leaves it to the one that ends it.
        let whole = vec.fold.r @(Bool, Idx Rn) @Rn
            (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d < Ro, acc, core.select ((axes#d)#part, ff, acc))) (‹d: Rn; d›, eager);
        let kernel = λ (vec: Bool, S: «Ro; Nat», c: buffer.Buf (Ro, S, To), at: IxN → «Ro; affine.Index», sz: «Rn; Nat», m: mem.M 0)
                      : [mem.M 0, buffer.Buf (Ro, S, To)] =
            btensor.map_reduce_post @(N, 0) @(To, To, Ro, Rn, btensor.SchedT) (S, sz, btensor.mk_sched (core.select (core.select (vec, Ro < vdim + 1, tt), Rn, vdim), 0))
                @(Ts, Ris_c, Sis_c, (), (), ()) @[«Ro; Nat», IxN → «Ro; affine.Index», buffer.Buf (Ro, S, To), Bool, To]
                (f, (S, at, c, fresh, init), (btensor.id @To, post)#whole) at (ins_m, ()) (m, c, ins_b, ());
        let cells = lm (o: «Ro; affine.Index»): «Ro; affine.Index» = out ‹d: Rn; (affine.lit 0, o#(core.idx 0 Ro (core.idx2nat d)))#(core.idx2nat d < Ro)›;
        // An edge tile computes in a scratch tile whose valid part is copied in and out; whole tiles come from `Peel` without one.
        // It runs up to `cap` only when panels or staged boxes sized by `cap` hold every slot, since a slot's own buffer ends at the extent.
        // Otherwise it runs over its valid part, unvectorized since that extent is a run-time value.
        let edge_tile = λ (_: []): [mem.M 0, D] =
            let own     = vec.fold.r @(Bool, Idx N) @N (λ (i: Idx N, acc: Bool): Bool = core.select ((vs#i)#own, tt, acc)) (‹i: N; i›, ff);
            let full_sz = ‹d: Rn; core.select (core.select (core.idx2nat d < Ro, core.select (own, ff, tt), ff), cap#d, size#d)›;
            // The scratch tile is indexed by the output loops, which `map_out` may permute in the output.
            let Sc      = ‹d: Ro; cap#(core.idx 0 Rn (core.idx2nat d))›;
            let ext     = ‹d: Ro; size#(core.idx 0 Rn (core.idx2nat d))›;
            let ident   = lm (o: «Ro; affine.Index»): «Ro; affine.Index» = o;
            let loops   = lm (o: IxN): «Ro; affine.Index» = ‹d: Ro; o#(core.idx 0 Rn (core.idx2nat d))›;
            let (m, sc) = buffer.alloc (Ro, Sc, To) m;
            let (m, sc) = btensor.map_reduce @1 @(To, Ro, Ro) (Sc, ext) @(To, Ro, So) (levels_take_mem @To, ⊥:To) ident cells (m, sc, dst);
            let (m, sc) = kernel (core.select (own, ff, tt), Sc, sc, loops, full_sz, m);
            let (m, dst) = btensor.map_reduce @1 @(To, Ro, Ro) (So, ext) @(To, Ro, Sc) (levels_take_mem @To, ⊥:To) cells ident (m, dst, sc);
            (buffer.free (Ro, Sc, To) (m, sc), dst);
        // The reduction loop `vdim` keeps `lanes_v` partial accumulators along it, which `merge` combines into the cells.
        let rfactor = λ (_: []): [mem.M 0, D] =
            let w    = lanes_v;
            let n    = size#(core.idx 0 Rn vdim);
            let full = core.nat.div (n, w);
            let tail = core.nat.rem (n, w);
            let Rq   = core.nat.add (Ro, 1);
            let Rp   = core.nat.add (Rn, 1);
            let IxP  = «Rp; affine.Index»;
            let IxQ  = «Rq; affine.Index»;
            let Sp   = ‹d: Rq; (w, size#(core.idx 0 Rn (core.idx2nat d)))#(core.idx2nat d < Ro)›;
            let (m, p) = buffer.alloc (Rq, Sp, To) m;
            // Loop `Ro` is the lane and loop `vdim + 1` counts groups of `w` from `base`.
            let back = λ (base: Nat) = lm (c: IxP): IxN =
                ‹e: Rn; let k = core.idx2nat e; let next = c#(core.idx 0 Rp (core.nat.add (k, 1)));
                    ((next, affine.op.add (affine.lit base, affine.op.add (affine.semiop.mul (next, w), c#(core.idx 0 Rp Ro))))#(k == vdim),
                     c#(core.idx 0 Rp k))#(k < Ro)›;
            let lane = lm (c: IxP): IxQ = ‹d: Rq; c#(core.idx 0 Rp (core.idx2nat d))›;
            let part = λ (base width groups: Nat, seed: Bool, m: mem.M 0): mem.M 0 =
                let sz    = ‹e: Rp; let k = core.idx2nat e;
                    (((size#(core.idx 0 Rn (core.nat.sub (k, 1))), groups)#(k == core.nat.add (vdim, 1)), width)#(k == Ro),
                     size#(core.idx 0 Rn k))#(k < Ro)›;
                let ins_p = ‹i: N; lm (c: IxP): «Ris_c#i; affine.Index» = (ins_m#i) (back base c)›;
                (btensor.map_reduce_post @(N, 0) @(To, To, Rq, Rp, btensor.SchedT) (Sp, sz, btensor.mk_sched (Ro, 0))
                    @(Ts, Ris_c, Sis_c, (), (), ()) @[«Rq; Nat», IxP → IxQ, buffer.Buf (Rq, Sp, To), Bool, To]
                    (f, (Sp, lane, p, seed, init), btensor.id @To) lane (ins_p, ()) (m, p, ins_b, ()))#0₂;
            // Lanes start from the unit `init`; the tail joins the first `tail` lanes.
            let m = ((λ (_: []): mem.M 0 = part (0, tail, 1, tt, m), λ (_: []): mem.M 0 = part (0, w, full, tt, m))#(core.ncmp.ne (full, 0))) ();
            let m = ((λ (_: []): mem.M 0 = m, λ (_: []): mem.M 0 = part (core.nat.mul (full, w), tail, 1, ff, m))
                     #(core.bit2.and 2 (core.ncmp.ne (full, 0), core.ncmp.ne (tail, 0)))) ();
            let used  = core.select (full == 0, tail, w);
            let cell  = lm (c: IxQ): «Ro; affine.Index» = out ‹d: Rn; (affine.lit 0, c#(core.idx 0 Rq (core.idx2nat d)))#(core.idx2nat d < Ro)›;
            let read  = lm (c: IxQ): IxQ = c;
            let (m, dst) = btensor.map_reduce_post @(1, 0) @(To, To, Ro, Rq, btensor.SchedT)
                (So, ‹d: Rq; (used, size#(core.idx 0 Rn (core.idx2nat d)))#(core.idx2nat d < Ro)›, btensor.mk_sched (Rq, 0))
                @(To, Rq, Sp, (), (), ()) @[«Ro; Nat», IxQ → «Ro; affine.Index», D, Bool, To]
                (merge, (So, cell, dst, fresh, init), (btensor.id @To, post)#whole) cell (read, ()) (m, dst, p, ());
            (buffer.free (Rq, Sp, To) (m, p), dst);
        let red_v = refly.check (core.select (1 < lanes_v, 0 < lanes, tt), 1 < lanes_v, "SchedTree: a Reduce needs a combiner with a merge");
        let edge  = core.select (blk vdim, tt, blk (vdim + 1));
        let held  = vec.fold.r @(Bool, Idx Rn) @Rn
            (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d < Ro, core.select (cap#d < levels_unbounded, acc, ff), acc)) (‹d: Rn; d›, tt);
        let edge  = refly.check (core.select (edge, held, tt), edge, "SchedTree: a Leaf computes an edge tile of a run-time extent that no Split bounds");
        // Without a slot's own buffer, an edge tile reads up to `cap` of its run-time output loops, which stays in the panel it starts in if that is as wide.
        let owned = vec.fold.r @(Bool, Idx N) @N (λ (i: Idx N, acc: Bool): Bool = core.select ((vs#i)#own, tt, acc)) (‹i: N; i›, ff);
        let wide  = vec.fold.r @(Bool, Idx N) @N
            (λ (i: Idx N, acc: Bool): Bool = vec.fold.r @(Bool, Idx Rn) @Rn
                (λ (d: Idx Rn, acc: Bool): Bool =
                    core.select (core.select (core.idx2nat d < Ro, core.select (dyn_ax#d, ((vs#i)#reads)#d, ff), ff),
                                 core.select (((vs#i)#unit)#d < cap#d, ff, acc), acc)) (‹d: Rn; d›, acc)) (‹i: N; i›, tt);
        let edge  = refly.check (core.select (edge, core.select (owned, tt, wide), tt), edge, "SchedTree: a Leaf computes an edge tile wider than a panel of a slot it reads along a run-time loop");
        let plain = (λ (_: []): [mem.M 0, D] = kernel (tt, So, dst, out, size, m), edge_tile)#edge;
        let (m, dst) = ((plain, rfactor)#(core.select (red_v, core.select (blk vdim, ff, tt), ff))) ();
        // The leaf that ends the reduction of its cells maps them by `epi` while they are still in cache.
        // Then `drain` reads them.
        let last  = vec.fold.r @(Bool, Idx Rn) @Rn
            (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d < Ro, acc, core.select (core.nat.add (lo#d, size#d) == Sr#d, acc, ff))) (‹d: Rn; d›, tt);
        let ext   = ‹d: Ro; size#(core.idx 0 Rn (core.idx2nat d))›;
        let mapped = core.select (whole, ff, finish);
        fun finished (m: mem.M 0, dst: D)@tt: [mem.M 0, D] =
            con skip (m: mem.M 0)@tt = return (m, dst);
            con map (m: mem.M 0)@tt =
                let (m, dst) = ((λ (_: []): [mem.M 0, D] = (m, dst), λ (_: []): [mem.M 0, D] = epi (m, dst, cells, ext))#mapped) ();
                let m        = ((λ (_: []): mem.M 0 = m, λ (_: []): mem.M 0 = drain (m, dst, ‹d: Ro; corner#(core.idx 0 Rn (core.idx2nat d))›, ext,
                                                                                ‹d: Ro; cap#(core.idx 0 Rn (core.idx2nat d))›, ‹d: Ro; dyn_ax#(core.idx 0 Rn (core.idx2nat d))›))#drains) ();
                return (m, dst);
            (skip, map)#last m;
        ((λ (_: []): [mem.M 0, D] = (m, dst), λ (_: []): [mem.M 0, D] = cps.cps2ds finished (m, dst))#(core.select (mapped, tt, drains))) ();

    // `rt_tail` lets a static axis count its tiles at run time; `peel` guards a run-time axis' tail by a branch.
    let split_axis = λ (rt_tail peel: Bool, d: Idx Rn, ts: Nat, k: Body): Body =
        λ (st: State): [mem.M 0, D] =
            let (axes, vs, m, dst) = st;
            let a     = axes#d;
            let n     = refly.check ((tt, core.select (rt_tail, tt, peel))#(a#dyn), a#size,
                "SchedTree: a Fixed Split needs an axis with a static extent");
            let full  = core.nat.div (n, ts);
            let tail  = core.nat.rem (n, ts);
            let bound = core.select (a#cap < ts, a#cap, ts);
            let part  = core.select (a#part, tt, core.select (a#dyn, tt, ts < n));
            let Bufs  = «i: N; buffer.Buf ((vs#i)#r, (vs#i)#s, Ts#i)»;
            let X     = [D, Bufs];
            // Each strategy takes `k` so that PE unfolds only the chosen one.
            let tile  = λ (k: Body, t ext cap: Nat, dyn: Bool) (m: mem.M 0, (dst: D, xs: Bufs)): [mem.M 0, X] =
                let vs2 = levels_seq @N @Views (‹i: N; λ (acc: Views): Views =
                    let v  = vs#i;
                    let u  = (v#unit)#d;
                    let per = refly.check (core.nat.rem (ts, u) == 0, core.nat.div (ts, u), "SchedTree: a Split must cut a packed axis into whole panels");
                    let q2 = ‹e: Rn; ((v#q)#e, affine.op.add ((v#q)#e, affine.semiop.mul (affine.lit t, per)))#(core.icmp.e (e, d))›;
                    acc#i ← (v#r, v#s, v#unit, q2, v#at, xs#i, v#aff, v#prod, v#reads, v#flat, v#sn, v#store, v#own) inj LevelsView (Rn, Ts#i)›, vs);
                let (m, dst) = k (axes#d ← (core.nat.add (a#lo, core.nat.mul (t, ts)), ext, cap, dyn, part, a#red), vs2, m, dst);
                (m, (dst, xs));
            let s0    = (m, (dst, ‹i: N; (vs#i)#data›));
            // A static extent without whole tiles skips the loop.
            let wholes = λ (k: Body, after: [mem.M 0, X] → [mem.M 0, X]): [mem.M 0, X] =
                ((λ (_: []): [mem.M 0, X] = after s0,
                  λ (_: []): [mem.M 0, X] = levels_steps @X full s0
                      (λ (t: Nat, m: mem.M 0, x: X): [mem.M 0, X] = tile (k, t, ts, ts, ff) (m, x)) after)#((core.ncmp.ne (full, 0), tt)#(a#dyn))) ();
            let tail_static = λ (k: Body) (s: [mem.M 0, X]): [mem.M 0, X] =
                ((λ (_: []): [mem.M 0, X] = s, λ (_: []): [mem.M 0, X] = tile (k, full, tail, tail, ff) s)#(core.ncmp.ne (tail, 0))) ();
            let tail_branch = λ (k: Body) (m: mem.M 0, (dst: D, xs: Bufs)): [mem.M 0, X] =
                fun edge (m: mem.M 0, dst: D)@tt: [mem.M 0, D] =
                    con skip (m: mem.M 0)@tt = return (m, dst);
                    con some (m: mem.M 0)@tt =
                        let (m, (dst, _)) = tile (k, full, tail, bound, tt) (m, (dst, xs));
                        return (m, dst);
                    (skip, some)#(core.ncmp.ne (tail, 0)) m;
                let (m, dst) = cps.cps2ds edge (m, dst);
                (m, (dst, xs));
            let counted = λ (k: Body): [mem.M 0, X] =
                levels_steps @X (core.nat.add (full, (0, 1)#(core.ncmp.ne (tail, 0)))) s0
                    (λ (t: Nat, m: mem.M 0, x: X): [mem.M 0, X] =
                        let left = core.nat.sub (n, core.nat.mul (t, ts));
                        tile (k, t, core.select (left < ts, left, ts), bound, tt) (m, x))
                    (λ (s: [mem.M 0, X]): [mem.M 0, X] = s);
            // A run-time extent counts its tiles unless peeled; a static one only for a `Loop` with whole tiles and a tail.
            let count = (core.bit2.and 2 (rt_tail, core.bit2.and 2 (core.ncmp.ne (full, 0), core.ncmp.ne (tail, 0))), (tt, ff)#peel)#(a#dyn);
            let (m, (dst, _)) = (((λ (k: Body): [mem.M 0, X] = wholes (k, tail_static k),
                                   λ (k: Body): [mem.M 0, X] = wholes (k, tail_branch k))#(a#dyn), counted)#count) k;
            (m, dst);

    let exec_split = λ (d ts: Nat, mode: SplitMode, k: Body): Body =
        let ax = refly.check (d < Rn, core.idx 0 Rn d, "SchedTree: a Split needs an axis below Rn");
        let ts = refly.check (0 < ts, ts, "SchedTree: a Split needs a positive tile size");
        let (rt_tail, peel) = match mode with
            | Fixed _ => (ff, ff)
            | Loop _  => (tt, ff)
            | Peel _  => (ff, tt);
        split_axis (rt_tail, peel, ax, ts, k);

    let exec_reduce = λ (d w: Nat, k: Body): Body =
        let ax = refly.check (core.select (Ro < d + 1, d < Rn, ff), core.idx 0 Rn d, "SchedTree: a Reduce needs a reduction loop");
        let w  = refly.check (1 < w, w, "SchedTree: a Reduce needs at least two partial results");
        λ (st: State): [mem.M 0, D] =
            let a = st#axes#ax;
            k (st#axes#ax ← (a#lo, a#size, a#cap, a#dyn, a#part, w));

    let exec_pack = λ (d w: Nat, slot: Idx N, dep: «Rn; Bool», k: Body): Body =
        λ (st: State): [mem.M 0, D] =
            let (axes, vs, m, _) = st;
            let (_, size, cap, dyn_ax) = cols axes;
            let w    = refly.check (core.bit2.and 2 (d < Rn, 0 < w), w, "SchedTree: a Pack needs an axis below Rn and a positive width");
            let v    = vs#slot;
            let same = vec.fold.r @(Bool, Idx Rn) @Rn (λ (e: Idx Rn, acc: Bool): Bool = core.select (core.icmp.e (dep#e, (v#reads)#e), acc, ff)) (‹e: Rn; e›, tt);
            let dep  = refly.check (same, dep, "SchedTree: a Pack's dep must be the loops its slot reads");
            let dep  = refly.check ((v#reads)#(core.idx 0 Rn d), dep, "SchedTree: a Pack needs a loop its slot reads");
            let data = refly.check (levels_ready (v#prod), v#data, "SchedTree: a Pack reads a producer slot that no Stage above it computes");
            let held = vec.fold.r @(Bool, Idx Rn) @Rn
                (λ (e: Idx Rn, acc: Bool): Bool = core.select (core.select (dep#e, tt, core.idx2nat e == d), core.select (cap#e < levels_unbounded, acc, ff), acc)) (‹e: Rn; e›, tt);
            let cap  = refly.check (held, cap, "SchedTree: a Pack sizes its panel by a run-time extent that no Split bounds");
            let (m, sp, p, to) = levels_pack_one @(Ts#slot, Rn) (v#r) (v#s) (v#at) data (d, w, dep, v#q, size, cap, dyn_ax#(core.idx 0 Rn d), v#sn, v#store, m);
            let unit = ‹e: Rn; (1, w)#(core.idx2nat e == d)›;
            let none = aff_map @(Rn, Rp, 0) ((), ‹Rp; aff_lit @(Rn, 0) 0›);
            let v2   = (Rp, sp, unit, zero, to, p, none, (Prod (Rp, Ts#slot))#Plain, v#reads, ff, 0, ⊥:(buffer.Buf (1, 0, Ts#slot)), ff) inj LevelsView (Rn, Ts#slot);
            let (m, dst) = k ((st#views#slot ← v2)#tok ← m);
            ((buffer.free (Rp, sp, Ts#slot) (m, p), m)#(0 < v#sn), dst);

    let exec_stage = λ (slot: Idx N, k: Body): Body =
        λ (st: State): [mem.M 0, D] =
            let (axes, vs, m, dst) = st;
            let (lo, size, cap, dyn_ax) = cols axes;
            let v = vs#slot;
            // Both arms are built, so each takes `k` and PE unfolds the body only in the chosen one.
            let arm = match v#prod with
                | Plain _ => λ (k: Body): [mem.M 0, D] = k st
                | Fill make =>
                    λ (k: Body): [mem.M 0, D] =
                        let at   = ‹d: Rn; core.nat.add (origin#d, lo#d)›;
                        let fa   = v#aff;
                        let rows = fa#rows;
                        let (blo, bext, bcap) = aff_box fa (at, size, cap);
                        let linear = ‹i: v#r; (aff_span (rows#i, fa#vals, at, size))#0₃›;
                        // A row that divides or takes a modulus spans a box whose extent depends on where the tile starts.
                        let bdyn = ‹i: v#r; vec.fold.r @(Bool, Idx Rn) @Rn
                            (λ (d: Idx Rn, acc: Bool): Bool = core.select (dyn_ax#d, core.select (aff_mentions (rows#i, d), tt, acc), acc)) (‹d: Rn; d›, core.select (linear#i, ff, tt))›;
                        let stored = 0 < v#sn;
                        let held   = vec.fold.r @(Nat, Idx (v#r)) @(v#r) (λ (i: Idx (v#r), acc: Nat): Nat = core.nat.mul (acc, bcap#i)) (‹i: v#r; i›, 1);
                        let stored = refly.check (core.select (stored, core.select (v#sn < held, ff, tt), tt), stored, "SchedTree: a Stage needs more than its Alloc holds");
                        let (m, t) = ((λ (_: []): [mem.M 0, buffer.Buf (v#r, bext, Ts#slot)] = buffer.alloc (v#r, bext, Ts#slot) m,
                                       λ (_: []): [mem.M 0, buffer.Buf (v#r, bext, Ts#slot)] = (m, buffer.view (v#r, bext, Ts#slot) (v#sn, v#store)))#stored) ();
                        let (m, t) = make (blo, bext, bcap, bdyn) (m, t);
                        // An affine row reads the box at its linear part; any other row at its value less the box's start.
                        let rel = lm (q o: IxN): «v#r; affine.Index» =
                            let x = ‹e: Rn; affine.op.add (q#e, o#e)›;
                            let y = ‹e: Rn; affine.op.add (affine.lit (at#e), x#e)›;
                            ‹i: v#r; let (h, t) = aff_rel (rows#i, fa#vals, x);
                                (affine.op.sub (aff_eval (rows#i, fa#vals, y), affine.lit (blo#i)), (affine.lit 0, t)#h)#(linear#i)›;
                        let v2 = (v#r, bext, ‹Rn; 1›, zero, rel,
                                  t, v#aff, (Prod (v#r, Ts#slot))#Plain, v#reads, ff, 0, ⊥:(buffer.Buf (1, 0, Ts#slot)), ff) inj LevelsView (Rn, Ts#slot);
                        let (m, dst) = k ((st#views#slot ← v2)#tok ← m);
                        ((buffer.free (v#r, bext, Ts#slot) (m, t), m)#stored, dst);
            arm k;

    let exec_alloc = λ (slot: Idx N, t: SchedTree (N, Rn), k: Body): Body =
        λ (st: State): [mem.M 0, D] =
            let (axes, vs, m, dst) = st;
            let (_, _, cap, dyn_ax) = cols axes;
            let v   = vs#slot;
            let box = λ (c: «Rn; Nat»): Nat = vec.fold.r @(Nat, Idx (v#r)) @(v#r)
                (λ (i: Idx (v#r), acc: Nat): Nat = levels_mul (acc, core.nat.add (aff_reach ((v#aff)#rows#i, c), 1))) (‹i: v#r; i›, 1);
            let n   = levels_need @(N, Rn) (slot, box, core.select (levels_ready (v#prod), ff, tt)) (cap, dyn_ax, t);
            // Without a static bound, each `Pack` and `Stage` allocates its own.
            let n   = core.select (n < levels_unbounded, n, 0);
            let T   = Ts#slot;
            let held = λ (k: Body): [mem.M 0, D] =
                let (m, b) = buffer.alloc (1, n, T) m;
                let v2 = (v#r, v#s, v#unit, v#q, v#at, v#data, v#aff, v#prod, v#reads, v#flat, n, b, v#own) inj LevelsView (Rn, T);
                let (m, dst) = k ((st#views#slot ← v2)#tok ← m);
                (buffer.free (1, n, T) (m, b), dst);
            ((held, λ (k: Body): [mem.M 0, D] = k st)#(n == 0)) k;

    let exec_switch = λ (d c: Nat, small big: Body): Body =
        let d = refly.check (d < Rn, core.idx 0 Rn d, "SchedTree: a Switch needs an axis below Rn");
        let c = refly.check (1 < c, c, "SchedTree: a Switch needs a threshold above 1");
        λ (st: State): [mem.M 0, D] =
            let a   = st#axes#d;
            // Below `c`, the small tree may size its scratch tiles by `c - 1`.
            let lt  = st#axes#d ← (a#lo, a#size, core.select (a#cap < c, a#cap, core.nat.sub (c, 1)), a#dyn, a#part, a#red);
            let cut = a#size < c;
            // Each arm takes both trees so that PE unfolds only the chosen one.
            let fixed  = λ (small big: Body): [mem.M 0, D] = ((big, small)#cut) ((st, lt)#cut);
            let branch = λ (small big: Body): [mem.M 0, D] =
                fun pick (m: mem.M 0, out: D)@tt: [mem.M 0, D] =
                    con below (m: mem.M 0)@tt = return (small ((lt#tok ← m)#dst ← out));
                    con above (m: mem.M 0)@tt = return (big ((st#tok ← m)#dst ← out));
                    (above, below)#cut m;
                cps.cps2ds pick (st#tok, st#dst);
            ((fixed, branch)#(a#dyn)) (small, big);

    lam eval (node: SchedTree (N, Rn))@(core.pe.is_closed node): Body =
        match node with
            | Leaf vdim => λ (st: State): [mem.M 0, D] = exec_leaf (vdim, st)
            | Split n   => exec_split (n#d, n#ts, n#mode, eval (n#body))
            | Reduce n  => exec_reduce (n#d, n#w, eval (n#body))
            | Pack n    => exec_pack (n#d, n#w, n#slot, n#dep, eval (n#body))
            | Stage n   => exec_stage (n#slot, eval (n#body))
            | Alloc n   => exec_alloc (n#slot, n#body, eval (n#body))
            | Switch n  => exec_switch (n#d, n#c, eval (n#small), eval (n#big));

    let red_dyn  = vec.fold.r @(Bool, Idx Rn) @Rn
        (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d < Ro, acc, core.select (dyn0#d, tt, acc))) (‹d: Rn; d›, ff);
    let q0 = ‹d: Rn; affine.lit (origin#d)›;
    let vs0: Views = ‹i: N; (Rs#i, Ss#i, ‹Rn; 1›, q0, levels_plain @Rn (Rs#i, maps#i), xs0#i, maps#i, prods#i, aff_reads @(Rn, Rs#i) (maps#i),
                              aff_linear @(Rn, Rs#i) (maps#i), 0, ⊥:(buffer.Buf (1, 0, Ts#i)), tt) inj LevelsView (Rn, Ts#i)›;
    let run = λ (m: mem.M 0): [mem.M 0, D] = eval sched (‹d: Rn; (0, Sr#d, cap0#d, dyn0#d, ff, 0)›, vs0, m, dst0);
    // With a run-time reduction extent of 0 no leaf runs: the cells hold `init`, which `epi` maps.
    let empty = vec.fold.r @(Bool, Idx Rn) @Rn
        (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.idx2nat d < Ro, acc, core.select (Sr#d == 0, tt, acc))) (‹d: Rn; d›, ff);
    let each  = lm (o: «Ro; affine.Index»): «Ro; affine.Index» = o;
    fun pick (m: mem.M 0, dst: D)@tt: [mem.M 0, D] =
        con some (m: mem.M 0)@tt = return (run m);
        con none (m: mem.M 0)@tt =
            let m = buffer.set (Ro, So, To) (m, dst, init);
            let (m, dst) = ((λ (_: []): [mem.M 0, D] = (m, dst), λ (_: []): [mem.M 0, D] = epi (m, dst, each, So))#finish) ();
            let at = λ (v: «Rn; Nat»): «Ro; Nat» = ‹d: Ro; v#(core.idx 0 Rn (core.idx2nat d))›;
            return (((λ (_: []): mem.M 0 = m, λ (_: []): mem.M 0 = drain (m, dst, at origin, at Sr, at cap0, ‹d: Ro; dyn0#(core.idx 0 Rn (core.idx2nat d))›))#drains) (), dst);
        (some, none)#empty m;
    ((λ (_: []): [mem.M 0, D] = run m, λ (_: []): [mem.M 0, D] = cps.cps2ds pick (m, dst0))#red_dyn) ();

/// A map-reduce over `Sr` that reads the result of another one through `f_aff` as a consumer of its finished tiles, by `run_levels` with the tree `tree_of` gives.
/// Its loop `d` with `tied#d` runs over the tile along the producer's output loop `ploop#d`, any other loop over its whole extent.
/// `dim_loop` is the producer's output loop of each dimension of its result.
/// A tile starts a cell of `out` where its reduction loops start at 0 and folds into it elsewhere.
anx lam levels_sink {To: *, Ro: Nat, So: «Ro; Nat»} {N: Nat, Tc: *, Rc Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (Sc: «Rc; Nat», Sr: «Rn; Nat»)
    (f: Fn [mem.M 0, Tc, «i: N; Ts#i»] → [mem.M 0, Tc], init: Tc, merge: Fn [mem.M 0, Tc, Tc] → [mem.M 0, Tc], lanes: Nat)
    (map_out: «Rn; affine.Index» → «Rc; affine.Index», maps: «i: N; Aff (Rn, Rs#i)», f_aff: Aff (Rn, Ro))
    (tied: «Rn; Bool», ploop: «Rn; Nat», dim_loop: «Ro; Nat»)
    (tree_of: [«Rn; Nat», «Rn; Bool»] → SchedTree (N, Rn))
    (out: buffer.Buf (Rc, Sc, Tc), xs: buffer.Buf (Ro, So, To) → «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    (m: mem.M 0, dst: buffer.Buf (Ro, So, To), corner ext cap: «Ro; Nat», dyn: «Ro; Bool»): mem.M 0 =
    let pl     = λ (d: Idx Rn): Idx Ro = core.idx 0 Ro (ploop#d);
    let origin = ‹d: Rn; core.select (tied#d, corner#(pl d), 0)›;
    let size   = ‹d: Rn; core.select (tied#d, ext#(pl d), Sr#d)›;
    let bound  = ‹d: Rn; core.select (tied#d, cap#(pl d), Sr#d)›;
    let fresh  = ‹d: Rn; core.select (tied#d, dyn#(pl d), ff)›;
    let reads  = aff_reads f_aff;
    let alone  = vec.fold.r @(Bool, Idx Rn) @Rn
        (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.select (tied#d, ff, reads#d), ff, acc)) (‹d: Rn; d›, tt);
    // The box the slot reads starts where the tile does and is as wide, which a unit projection of one tied loop per dimension gives.
    let (blo, _, bcap) = aff_box f_aff (origin, size, bound);
    let exact  = vec.fold.r @(Bool, Idx Ro) @Ro
        (λ (e: Idx Ro, acc: Bool): Bool =
            let l = core.idx 0 Ro (dim_loop#e);
            core.select (core.select (blo#e == corner#l, bcap#e == cap#l, ff), acc, ff)) (‹e: Ro; e›, tt);
    // Tiles cut a tied reduction loop, which only the first one may be without partial results to merge.
    let order  = vec.fold.r @(Bool, Idx Rn) @Rn
        (λ (d: Idx Rn, acc: Bool): Bool = core.select (core.select (tied#d, Rc < core.idx2nat d, ff), core.select (0 < lanes, acc, ff), acc)) (‹d: Rn; d›, tt);
    let m = refly.check (alone, m, "SchedTree: a sink reads its tile along a loop that runs over its whole extent");
    let m = refly.check (exact, m, "SchedTree: a sink reads other cells than the tile it is given");
    let m = refly.check (order, m, "SchedTree: a sink cuts a reduction loop after the first without a merge");
    let shift = lm (o: «Rn; affine.Index»): «Rc; affine.Index» = map_out ‹d: Rn; affine.op.add (affine.lit (origin#d), o#d)›;
    (run_levels_at @(N, Tc, Rc, Rn, Ts, Rs, Ss) (Sc, size, origin) (f, init, btensor.id @Tc) (merge, lanes, ff)
        (levels_no_epilogue @(Tc, Rc, Sc), tt, levels_no_drain @(Tc, Rc, Sc), ff) shift (maps, ‹i: N; prod_plain (Rs#i, Ts#i)›)
        (tree_of (bound, fresh), bound, fresh) (m, out, xs dst))#0₂;

/// `run_levels_with` into the buffer `dst`, e.g. one a `Stage` hands a producer.
anx lam run_levels_into {N: Nat, To: *, Ro Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (So: «Ro; Nat», Sr: «Rn; Nat»)
    (f: Fn [mem.M 0, To, «i: N; Ts#i»] → [mem.M 0, To], init: To)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: N; Aff (Rn, Rs#i)», prods: «i: N; Prod (Rs#i, Ts#i)»)
    (sched: SchedTree (N, Rn), cap0: «Rn; Nat», dyn0: «Rn; Bool»)
    (m: mem.M 0, dst: buffer.Buf (Ro, So, To), xs0: «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    : [mem.M 0, buffer.Buf (Ro, So, To)] =
    run_levels_at @(N, To, Ro, Rn, Ts, Rs, Ss) (So, Sr, ‹Rn; 0›) (f, init, btensor.id @To) (levels_take_mem @To, 0, ff)
        (levels_no_epilogue @(To, Ro, So), tt, levels_no_drain @(To, Ro, So), ff) map_out (maps, prods)
        (sched, cap0, dyn0) (m, dst, xs0);

anx lam run_levels_with {N: Nat, To: *, Ro Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (So: «Ro; Nat», Sr: «Rn; Nat»)
    (f: Fn [mem.M 0, To, «i: N; Ts#i»] → [mem.M 0, To], init: To)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: N; Aff (Rn, Rs#i)», prods: «i: N; Prod (Rs#i, Ts#i)»)
    (sched: SchedTree (N, Rn), cap0: «Rn; Nat», dyn0: «Rn; Bool»)
    (m: mem.M 0, xs0: «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    : [mem.M 0, buffer.Buf (Ro, So, To)] =
    let (m, dst) = buffer.alloc (Ro, So, To) m;
    run_levels_into @(N, To, Ro, Rn, Ts, Rs, Ss) (So, Sr) (f, init) map_out (maps, prods) (sched, cap0, dyn0) (m, dst, xs0);

/// `run_levels_with` that maps each output cell by `epi`, within the leaf that ends its reduction if `finish`, and by `post` within the leaf itself where it spans the reduction and `eager`.
/// If `drains`, that leaf then hands its cells to `drain`.
/// A `Reduce` combines its partial accumulators by `merge`, for which `init` must be a unit; `lanes` is 0 for a combiner without one.
anx lam run_levels_post {N: Nat, To: *, Ro Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (So: «Ro; Nat», Sr: «Rn; Nat»)
    (f: Fn [mem.M 0, To, «i: N; Ts#i»] → [mem.M 0, To], init: To, post: Fn [mem.M 0, To, []] → [mem.M 0, To])
    (merge: Fn [mem.M 0, To, To] → [mem.M 0, To], lanes: Nat, finish: Bool)
    (epi: [mem.M 0, buffer.Buf (Ro, So, To), «Ro; affine.Index» → «Ro; affine.Index», «Ro; Nat»] → [mem.M 0, buffer.Buf (Ro, So, To)], eager: Bool,
     drain: LevelsDrain (To, Ro, So), drains: Bool)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: N; Aff (Rn, Rs#i)», prods: «i: N; Prod (Rs#i, Ts#i)»)
    (sched: SchedTree (N, Rn), cap0: «Rn; Nat», dyn0: «Rn; Bool»)
    (m: mem.M 0, xs0: «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    : [mem.M 0, buffer.Buf (Ro, So, To)] =
    let (m, dst) = buffer.alloc (Ro, So, To) m;
    run_levels_at @(N, To, Ro, Rn, Ts, Rs, Ss) (So, Sr, ‹Rn; 0›) (f, init, post) (merge, lanes, finish) (epi, eager, drain, drains) map_out (maps, prods) (sched, cap0, dyn0) (m, dst, xs0);

anx lam run_levels {N: Nat, To: *, Ro Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (So: «Ro; Nat», Sr: «Rn; Nat»)
    (f: Fn [mem.M 0, To, «i: N; Ts#i»] → [mem.M 0, To], init: To)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: N; Aff (Rn, Rs#i)»)
    (sched: SchedTree (N, Rn), cap0: «Rn; Nat», dyn0: «Rn; Bool»)
    (m: mem.M 0, xs0: «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    : [mem.M 0, buffer.Buf (Ro, So, To)] =
    run_levels_with @(N, To, Ro, Rn, Ts, Rs, Ss) (So, Sr) (f, init) map_out
        (maps, ‹i: N; (Prod (Rs#i, Ts#i))#Plain›) (sched, cap0, dyn0) (m, xs0);
///
/// ### cpu_tree
///

lam nat_min (a: Nat) (b: Nat): Nat = core.select (a < b, a, b);
lam nat_or (x: Nat) (d: Nat): Nat = core.select (x == 0, d, x);

/// Whether BLIS packing fits a contraction over `Rn` loops (`M`, `N`, `K` last): `A` must not read `N` and `B` must not read `M`.
anx lam cpu_covers (Rn Ro: Nat) (a: Idx 2, dep: «2; «Rn; Bool»»): Bool =
    let b     = (1₂, 0₂)#(core.idx2nat a == 1);
    let reads = λ (slot: Idx 2) (ax: Nat): Bool = dep#slot#(core.idx 0 Rn ax);
    core.select (reads a (Ro - 1), ff, core.select (reads b (Ro - 2), ff, tt));

/// The facts `cpu_tree` tiles a contraction of the slots `fa` and `fb` by: whether `cpu_covers` it, the slot `a` that reads the second last output loop, the loops each slot reads, and whether the other reads the last output loop at unit stride.
anx lam cpu_facts {Rn Ro Ra Rb: Nat} (fa: Aff (Rn, Ra), fb: Aff (Rn, Rb)): [Bool, Idx 2, «2; «Rn; Bool»», Bool] =
    let dep  = (aff_reads fa, aff_reads fb);
    let a    = (1₂, 0₂)#(dep#0₂#(core.idx 0 Rn (Ro - 2)));
    let last = core.idx 0 Rn (Ro - 1);
    (cpu_covers (Rn, Ro) (a, dep), a, dep, (aff_unit (fa, last), aff_unit (fb, last))#((1₂, 0₂)#(core.idx2nat a == 1)));

/// The facts `generic_tree` tiles a map-reduce by, from the loops each of its `nis` slots reads and reads at unit stride, with its output contiguous along the loop `wdim`:
/// whether every slot reads the innermost loop and the last output loop at unit stride, the loop a slot that reads `wdim` at a stride is contiguous along (else `wdim`), and whether two slots form an outer product.
anx lam generic_facts {nis Rn: Nat} (Ro wdim: Nat, reads units: «nis; «Rn; Bool»»): [Bool, Bool, Nat, Bool] =
    // Curried, since a parameter group would name the fields of a shared `«2; Nat»`.
    let at    = λ (m: «nis; «Rn; Bool»») (i: Nat) (d: Nat): Bool = m#(core.idx 0 nis i)#(core.idx 0 Rn d);
    let all   = λ (d: Nat): Bool = vec.fold.r (λ (i: Idx nis, acc: Bool): Bool = core.select (at units (core.idx2nat i) d, acc, ff)) (‹i: nis; i›, tt);
    let last  = λ (i: Nat) (r: Nat): Nat = vec.fold.l (λ (acc: Nat, d: Idx Ro): Nat = core.select (at units i (core.idx2nat d), core.idx2nat d, acc)) (r, ‹d: Ro; d›);
    let step  = λ (r: Nat, j: Idx nis): Nat =
        let i = core.idx2nat j;
        core.select (core.select (r == wdim, core.select (at reads i wdim, core.select (at units i wdim, ff, tt), ff), ff), last i r, r);
    let op    = λ (a: Nat) (b: Nat): Bool =
        core.select (at reads a (Ro - 2), core.select (at reads a (Ro - 1), ff, core.select (at units b (Ro - 1), core.select (at reads b (Ro - 2), ff, tt), ff)), ff);
    let outer = core.select (nis == 2, core.select (Ro < 2, ff, core.select (op 0 1, tt, op 1 0)), ff);
    (all (Rn - 1), all (Ro - 1), vec.fold.l step (wdim, ‹i: nis; i›), outer);

/// The BLIS-style tree for a contraction over `Rn` loops, `Ro` of them parallel, whose operands have element size `bytes` and read the loops `dep`:
/// outer `N` (`order = 1`: `M`), `K`, pack, cache `M` (`N`), pack, register tile.
/// `M` and `N` are the last two parallel loops and `K` the reduction loop; slot `a` reads `M` and the other slot `N` (at unit stride iff `unit_b`), and the loops before `M` run one at a time.
/// `fuse#i` stages slot `i`'s producer, at most one of them: `1` one without a contraction, `2` a contraction.
/// `dyn_k = 1` gives the `K` loop a run-time tail, which halves the code of a shape whose `K` leaves one at 1–3% speed (251×257×263, 1021×1031×1033).
anx lam cpu_tree (Rn Ro: Nat) (bytes: Nat, a: Idx 2, dep: «2; «Rn; Bool»», unit_b: Bool, sizes: «Rn; Nat», dyn: «Rn; Bool», fuse: «2; Nat»): SchedTree (2, Rn) =
    let (vec_bytes, regs, cache, mr_o, nr_o, mc_o, nc_o, kc_o, order, dyn_k, pack_b_o, _) = cpu_knobs ();
    let m_ax  = Ro - 2;
    let n_ax  = Ro - 1;
    let k_ax  = Ro;
    let b     = (1₂, 0₂)#(core.idx2nat a == 1);
    let lanes = vec_width (core.select (bytes < vec_bytes, vec_bytes / bytes, 1));
    // Two vectors per row and up to eight rows, leaving four registers for the operands; 1 KB packed rows.
    let nr    = nat_or nr_o (lanes * 2);
    let mr    = nat_or mr_o (nat_min 8 (core.select (regs < 6, 1, (regs - 4) / 2)));
    let kc    = nat_or kc_o (core.select (bytes < 1024, 1024 / bytes, 1));
    let mc_b  = cache / (kc * bytes * 2);
    let mc    = nat_or mc_o (core.select (mc_b < mr, mr, mc_b / mr * mr));
    let nc_b  = 4 * cache / (kc * bytes);
    let nc    = nat_or nc_o (core.select (nc_b < nr, nr, nc_b / nr * nr));
    let swap  = order == 1;
    let on    = λ (ax: Nat) (s: Nat): «Rn; Nat» = ‹d: Rn; core.select (core.idx2nat d == ax, s, 0)›;
    let T     = SchedTree (2, Rn);
    let pack_a = λ (t: T): T = sched_pack @(2, Rn) (m_ax, mr, a, dep#a, t);
    let m_ext  = sizes#(core.idx 0 Rn m_ax);
    let b_size = sizes#(core.idx 0 Rn n_ax) * sizes#(core.idx 0 Rn k_ax) * bytes;
    // Packing B pays only when enough row blocks reuse its panel, and below 64 of them only when the rows of B alias in the cache at a 4 KB stride (measured on Zen 5).
    let n_ext  = sizes#(core.idx 0 Rn n_ax);
    let alias  = core.nat.rem (n_ext * bytes, 4096) == 0;
    let few    = core.select (m_ext <= 16 * mr, tt, core.select (b_size <= cache, tt, core.select (m_ext <= 64 * mr, core.select (alias, ff, tt), ff)));
    // An edge tile over a run-time extent reads whole panels, so B is packed whenever a shape is unknown.
    let known  = core.select (dyn#(core.idx 0 Rn m_ax), ff, core.select (dyn#(core.idx 0 Rn n_ax), ff, core.select (dyn#(core.idx 0 Rn k_ax), ff, tt)));
    // A strided read along `N` (a strided convolution's input) packs, so the gather happens once per panel.
    let keep_b = core.select (swap, ff, core.select (known, core.select (pack_b_o == 0, core.select (unit_b, few, ff), pack_b_o == 2), ff));
    // With only `M` unknown, a few rows of `A` branch to an unpacked `B` at run time.
    let m_dyn  = core.select (swap, ff, core.select (dyn#(core.idx 0 Rn n_ax), ff, core.select (dyn#(core.idx 0 Rn k_ax), ff,
                 core.select (pack_b_o == 0, core.select (unit_b, core.select (b_size <= cache, ff, dyn#(core.idx 0 Rn m_ax)), ff), ff))));
    let build  = λ (keep_b: Bool): T =
        let pack_b = λ (t: T): T = (sched_pack @(2, Rn) (n_ax, nr, b, dep#b, t), t)#keep_b;
        let split = λ (ax: Nat) (ts: Nat) (b: T): T =
            (sched_par @(2, Rn) (on ax ts, b), sched_seq @(2, Rn) (ax, ts, b))#(dyn#(core.idx 0 Rn ax));
        let peel  = λ (ax: Nat) (ts: Nat) (b: T): T =
            (sched_par @(2, Rn) (on ax ts, b), sched_peel @(2, Rn) (ax, ts, b))#(dyn#(core.idx 0 Rn ax));
        // The loops before `M` run one at a time: those neither slot reads inside the packs, which they leave unchanged, and the others outside, so that no panel spans them.
        let batch = λ (inner: Bool) (t: T): T =
            vec.fold.r @(T, Idx Rn) @Rn
                (λ (d: Idx Rn, t: T): T =
                    let read = core.select (dep#a#d, tt, dep#b#d);
                    core.select (core.bit2.and 2 (core.idx2nat d < m_ax, (read, (tt, ff)#read)#inner), split (core.idx2nat d) 1 t, t))
                (‹d: Rn; d›, t);
        let tree  = batch tt (peel m_ax mr (peel n_ax nr (sched_leaf @(2, Rn) m_ax)));
        let tree  = ((pack_a, pack_b)#swap) tree;
        let tree  = split (core.select (swap, n_ax, m_ax)) mc tree;
        let tree  = ((pack_b, pack_a)#swap) tree;
        let tree  = ((λ (t: T): T = sched_par @(2, Rn) (on k_ax kc, t),
                      λ (t: T): T = sched_seq @(2, Rn) (k_ax, kc, t))#(core.select (dyn_k == 1, tt, dyn#(core.idx 0 Rn k_ax)))) tree;
        let tree  = split (core.select (swap, m_ax, n_ax)) nc tree;
        // A fused producer is staged once per band of the loop its slot reads besides `K` (`M` for `a`, `N` for the other), outside every loop it does not read, so no tile of it is computed twice.
        // A contraction's band spans all of `K`, and one of twice the cache or more costs more than its round trip saves (measured on Zen 5), so it is staged once at the root.
        let staged = λ (ax ts: Nat, slot: Idx 2) (t: T): T =
            let band = nat_min ts (sizes#(core.idx 0 Rn ax)) * sizes#(core.idx 0 Rn k_ax) * bytes;
            let root = core.select (fuse#(slot) == 2, core.select (band < 2 * cache, ff, tt), ff);
            let t = sched_stage @(2, Rn) (slot, t);
            (split ax ts t, t)#root;
        let tree  = (((tree, staged (n_ax, nc, b) tree)#(fuse#(b) != 0)), staged (m_ax, mc, a) tree)#(fuse#(a) != 0);
        batch ff tree;
    // A fused slot's staged boxes are allocated once, outside every loop.
    // Panels keep their own allocation: hoisting it measured no faster, and at 512³ clang then spills in the micro-kernel (Zen 5).
    let tree = (build keep_b, sched_switch @(2, Rn) (m_ax, 16 * mr + 1, build tt, build ff))#m_dyn;
    let held = λ (i: Idx 2, t: SchedTree (2, Rn)): SchedTree (2, Rn) = (t, sched_alloc @(2, Rn) (i, t))#(fuse#i != 0);
    held (0₂, held (1₂, tree));

/// The tree for a map-reduce over `Rn` loops, `Ro` of them parallel, that is not a contraction; `red_unit` and `out_unit` tell whether every input reads the innermost and the last output loop at unit stride, and the output is contiguous along loop `wdim` while an input is along `rdim`.
/// A leaf accumulates a row along the last output loop when only that one is contiguous or the reduction is a short window, and otherwise splits a contiguous reduction loop into `lanes` partial accumulators when its combiner has a merge (`lanes > 1`).
/// A transpose cuts both contiguous loops into tiles (sizes measured on Zen 5), an outer product over the last two output loops (`outer`) gets a register tile, and the producers `fuse` marks are staged per band of the first loop.
/// The leaf of `generic_tree`: a row of accumulators along the last output loop, or partial results along the innermost reduction loop, which suits a box as small as a tile.
anx lam generic_leaf (N Rn Ro: Nat) (red_unit out_unit: Bool, lanes: Nat) (sizes: «Rn; Nat», dyn: «Rn; Bool»): SchedTree (N, Rn) =
    let last   = core.nat.sub (Ro, 1);
    let dyn_at = λ (d: Nat): Bool = core.select (d < Rn, dyn#(core.idx 0 Rn d), ff);
    let window = vec.fold.r @(Nat, Idx Rn) @Rn
        (λ (d: Idx Rn, acc: Nat): Nat = core.select (core.idx2nat d < Ro, acc, core.nat.mul (acc, sizes#d))) (‹d: Rn; d›, 1);
    // A run-time last loop without a static bound has no edge tile to vectorize it in.
    let row  = core.select (Ro < Rn, core.select (out_unit, core.select (red_unit, window < 16, tt), ff), ff);
    let row  = core.select (row, core.select (dyn_at last, sizes#(core.idx 0 Rn last) < levels_unbounded, tt), ff);
    let inner = core.nat.sub (Rn, 1);
    let split = core.select (row, ff, core.select (Ro < Rn, core.select (red_unit, core.select (1 < lanes, lanes - 1 < sizes#(core.idx 0 Rn inner), ff), ff), ff));
    (sched_leaf @(N, Rn) (core.select (row, last, Rn)), sched_reduce @(N, Rn) (inner, lanes, sched_leaf @(N, Rn) inner))#split;

/// The tree of a sink: `generic_leaf`, or a leaf vectorized along the last loop of a map without reduction that writes it at unit stride.
anx lam sink_tree (N Rn Ro: Nat) (red_unit out_unit: Bool, lanes: Nat) (sizes: «Rn; Nat», dyn: «Rn; Bool»): SchedTree (N, Rn) =
    (generic_leaf (N, Rn, Ro) (red_unit, out_unit, lanes) (sizes, dyn), sched_leaf @(N, Rn) (core.nat.sub (Rn, 1)))#(core.select (Ro == Rn, out_unit, ff));

anx lam generic_tree (N Rn Ro: Nat) (red_unit out_unit: Bool, wdim rdim lanes bytes: Nat, outer: Bool, fuse: «N; Nat») (sizes: «Rn; Nat», dyn: «Rn; Bool»): SchedTree (N, Rn) =
    let (vec_bytes, regs, cache, _, _, _, _, _, _, _, _, trial) = cpu_knobs ();
    let last   = core.nat.sub (Ro, 1);
    let dyn_at = λ (d: Nat): Bool = core.select (d < Rn, dyn#(core.idx 0 Rn d), ff);
    // `Peel` is `Fixed` on a static extent, and keeps the whole tiles of a run-time one static.
    let cuts   = λ (ts: «Rn; Nat», body: SchedTree (N, Rn)): SchedTree (N, Rn) =
        vec.fold.r @(SchedTree (N, Rn), Idx Rn) @Rn
            (λ (d: Idx Rn, t: SchedTree (N, Rn)): SchedTree (N, Rn) =
                (t, sched_peel @(N, Rn) (core.idx2nat d, ts#d, t))#(core.ncmp.ne (ts#d, 0))) (‹d: Rn; d›, body);
    let leaf = generic_leaf (N, Rn, Ro) (red_unit, out_unit, lanes) (sizes, dyn);
    let cut  = λ (ts: Nat): «Rn; Nat» =
        ‹d: Rn; let e = core.idx2nat d; core.select (core.select (e == wdim, tt, e == rdim), ts, 0)›;
    let base = (cuts (cut 256, cuts (cut 8, leaf)), leaf)#(wdim == rdim);
    // An outer product over the last two static output loops (a direct convolution) gets a register tile like `cpu_tree`'s: rows of `mr` jammed, `nr` lanes wide.
    // The outer-product tile is an experiment behind `-X tensor:cpu-conv=1`.
    let vl   = core.select (nat_or bytes 4 < vec_bytes, vec_bytes / nat_or bytes 4, 1);
    let mr   = nat_min 8 (core.nat.sub (regs, 4) / 2);
    let rows = core.nat.sub (Ro, 2);
    // A row splits into power-of-two widths down from `vl`, so that every piece vectorizes.
    let leaf = sched_leaf @(N, Rn) rows;
    let lane = vec.fold.r @(SchedTree (N, Rn), Idx 5) @5
        (λ (i: Idx 5, t: SchedTree (N, Rn)): SchedTree (N, Rn) =
            let w = core.nat.div (vl, (1, 2, 4, 8, 16)#i);
            (t, sched_split @(N, Rn) (last, w, SplitMode#Fixed, sched_switch @(N, Rn) (last, w, t, leaf)))#(1 < w)) (‹i: 5; i›, leaf);
    let tile = core.select (core.select (outer, trial == 1, ff), core.select (1 < Ro, core.select (dyn_at rows, ff, core.select (dyn_at last, ff, tt)), ff), ff);
    let base = (base, sched_split @(N, Rn) (rows, mr, SplitMode#Fixed, lane))#tile;
    // Fused producers are staged per band of the first loop that fills half the cache, so their inputs stay in it.
    let row    = vec.fold.r @(Nat, Idx Rn) @Rn
        (λ (d: Idx Rn, acc: Nat): Nat = core.select (core.idx2nat d == 0, acc, core.nat.mul (acc, sizes#d))) (‹d: Rn; d›, nat_or bytes 4);
    let band   = nat_or (core.nat.div (cache, core.nat.mul (2, row))) 1;
    let staged = vec.fold.r @(SchedTree (N, Rn), Idx N) @N
        (λ (i: Idx N, t: SchedTree (N, Rn)): SchedTree (N, Rn) = (t, sched_stage @(N, Rn) (i, t))#(core.ncmp.ne (fuse#i, 0))) (‹i: N; i›, base);
    let any    = vec.fold.r @(Bool, Idx N) @N (λ (i: Idx N, acc: Bool): Bool = core.select (core.ncmp.ne (fuse#i, 0), tt, acc)) (‹i: N; i›, ff);
    let banded = cuts (‹d: Rn; (0, band)#(core.idx2nat d == 0)›, staged);
    let held   = vec.fold.r @(SchedTree (N, Rn), Idx N) @N
        (λ (i: Idx N, t: SchedTree (N, Rn)): SchedTree (N, Rn) = (t, sched_alloc @(N, Rn) (i, t))#(core.ncmp.ne (fuse#i, 0))) (‹i: N; i›, banded);
    (base, held)#any

/// `cpu_tree` for a box of the given sizes, `dyn` those known only at run time.
anx lam cpu_tree_at (Rn Ro: Nat) (bytes: Nat, a: Idx 2, dep: «2; «Rn; Bool»», unit_b: Bool, fuse: «2; Nat») (sizes: «Rn; Nat», dyn: «Rn; Bool»): SchedTree (2, Rn) =
    cpu_tree (Rn, Ro) (bytes, a, dep, unit_b, sizes, dyn, fuse);

/// A map-reduce whose output loops come first as the producer of a slot: it computes the box `(lo, ext)`
/// of its output with `run_levels` over the loops starting at `lo`, tiled by `tree_of` the static bounds of the box and its run-time extents.
/// `map_out` may permute the output loops, and `inv` gives the output dimension that each of them indexes.
/// With `finish`, `post` maps every cell at the end of its reduction.
anx lam fill_of {N: Nat, To: *, Ro Rn: Nat, Ts: «N; *», Rs: «N; Nat», Ss: «i: N; «Rs#i; Nat»»}
    (Sr: «Rn; Nat», inv: «Ro; Nat»)
    (f: Fn [mem.M 0, To, «i: N; Ts#i»] → [mem.M 0, To], init: To)
    (post: Fn [mem.M 0, To, []] → [mem.M 0, To], finish: Bool)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: N; Aff (Rn, Rs#i)», prods: «i: N; Prod (Rs#i, Ts#i)»)
    (tree_of: [«Rn; Nat», «Rn; Bool»] → SchedTree (N, Rn))
    (xs: «i: N; buffer.Buf (Rs#i, Ss#i, Ts#i)»)
    : Prod (Ro, To) =
    let make = λ (lo ext cap: «Ro; Nat», dyn: «Ro; Bool») (m: mem.M 0, dst: buffer.Buf (Ro, ext, To)): [mem.M 0, buffer.Buf (Ro, ext, To)] =
        let out_d  = λ (d: Idx Rn): Bool = core.idx2nat d < Ro;
        let o      = λ (d: Idx Rn): Idx Ro = core.idx 0 Ro (inv#(core.idx 0 Ro (core.idx2nat d)));
        let size   = ‹d: Rn; core.select (out_d d, ext#(o d), Sr#d)›;
        let bound  = ‹d: Rn; core.select (out_d d, cap#(o d), Sr#d)›;
        let fresh  = ‹d: Rn; core.select (out_d d, dyn#(o d), ff)›;
        let origin = ‹d: Rn; core.select (out_d d, lo#(o d), 0)›;
        let epi    = (levels_no_epilogue @(To, Ro, ext), levels_epilogue @(To, Ro, ext) @(0, (), (), ()) (post, (), ()))#finish;
        run_levels_at @(N, To, Ro, Rn, Ts, Rs, Ss) (ext, size, origin) (f, init, post) (levels_take_mem @To, 0, finish) (epi, tt, levels_no_drain @(To, Ro, ext), ff) map_out (maps, prods)
            (tree_of (bound, fresh), bound, fresh) (m, dst, xs);
    (Prod (Ro, To))#Fill make;
