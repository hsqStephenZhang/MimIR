/// # The regex Plugin {#regex}
///
/// @see mim::plug::regex
///
/// [TOC]
///
/// A normalizing regex plugin.
///
/// ## Dependencies
///
import compile;
plugin core;
plugin mem;
plugin cps;
plugin runtime;
plugin vec;
///
/// ## Types
///
/// ### RE
///
/// Char & String
let Char = I8;
lam Str(n: Nat): * = %mem.Ptr0 «n; Char»;
/// A regular expression matcher.
lam Res (n: Nat): * = [%mem.M 0, Bool, Idx n];
lam Input (n: Nat): * = [%mem.M 0, Str n, Idx n];
let RE = {n: Nat} → Input n → Res n;
///
/// ## Meta
///
/// ### %%regex.conj
///
/// A sequence of RE's. <br>
/// E.g.: `\d\d\d` matches 3 digits: `%%regex.conj (%%regex.cls.d, %%regex.cls.d, %%regex.cls.d)`
axm %regex.conj: {n: Nat} → «n; RE» → RE, normalize_conj, 2;
///
/// ### %%regex.disj
///
/// Match any of the sub expressions: `[0123456789]`
///
axm %regex.disj: {n: Nat} → «n; RE» → RE, normalize_disj, 2;
///
/// ## Values
///
/// ### %%regex.range
///
/// Wraps a range of literals.
/// Use: `%%regex.range ('a', 'z')` to match all lower case letters.
///
axm %regex.range: «2; Char» → RE, normalize_range, 1;
///
/// ### %%regex.lit
///
/// Wraps a literal.
///
lam %regex.lit(val: Char) = %regex.range (val, val);
///
/// ### %%regex.not_
///
/// Do not match any of the ranges in the parameter - parameter must only contain `regex.disj`s and `regex.range`s.
///
axm %regex.not_: RE → RE, normalize_not, 1;
///
/// ### %%regex.neg_lookahead
///
/// Do not match the parameter!
///
axm %regex.neg_lookahead: RE → RE, 1;
///
/// ### %%regex.cls.*
///
/// | Subtag | Matches                        |
/// |--------|--------------------------------|
/// | `d`    | digits `[0-9]`                 |
/// | `D`    | No digits                      |
/// | `w`    | word characters `[a-zA-Z_0-9]` |
/// | `W`    | No word characters             |
/// | `s`    | whitespace `[ \t\r\n]`         |
/// | `S`    | No whitespace                  |
///
let %regex.cls.d = %regex.range ('0', '9');
let %regex.cls.D = %regex.not_ %regex.cls.d;
let %regex.cls.w = %regex.disj (%regex.range ('0', '9'), %regex.range ('a', 'z'), %regex.range ('A', 'Z'), %regex.lit '_');
let %regex.cls.W = %regex.not_ %regex.cls.w;
let %regex.cls.s = %regex.disj (%regex.range ('\t', '\n'), %regex.lit '\r', %regex.lit ' ');
let %regex.cls.S = %regex.not_ %regex.cls.s;
///
/// ### %%regex.any
///
/// Match any character.
///
axm %regex.any: RE, 0;
///
/// ## %%regex.empty
///
/// Matches the empty string.
///
axm %regex.empty: RE, 0;
///
/// ## Quantifiers
///
/// ### %%regex.quant.*
///
axm %regex.quant(optional,star,plus): RE → RE, normalize_quant, 1;

/// A tagged syntax tree used by the object-language interpreter below.
///
/// MimIR already supports pattern matching on unions.  The node payloads use
/// distinct marker fields so that constructors with the same child shape
/// remain different union members.  This first POC is intentionally bounded
/// to one AST level; a recursive type alias can replace `Expr` later.
let %regex.Empty = [Bool, Nat];
let %regex.Any = [Nat, Bool];
let %regex.Leaf = %regex.Empty ∪ %regex.Any ∪ Char ∪ «2; Char»;
let %regex.Concat = [Bool, %regex.Leaf, %regex.Leaf];
let %regex.Alt = [Nat, %regex.Leaf, %regex.Leaf];
let %regex.Optional = [I1, %regex.Leaf];
let %regex.Expr = %regex.Leaf ∪ %regex.Concat ∪ %regex.Alt ∪ %regex.Optional;

lam %regex.expr.empty (): %regex.Leaf = (ff, 0) inj %regex.Leaf;
lam %regex.expr.any (): %regex.Leaf = (0, ff) inj %regex.Leaf;
lam %regex.expr.lit (c: Char): %regex.Leaf = c inj %regex.Leaf;
lam %regex.expr.range (r: «2; Char»): %regex.Leaf = r inj %regex.Leaf;
lam %regex.expr.conj (lhs rhs: %regex.Leaf): %regex.Expr =
    (ff, lhs, rhs) inj %regex.Expr;
lam %regex.expr.disj (lhs rhs: %regex.Leaf): %regex.Expr =
    (0, lhs, rhs) inj %regex.Expr;
lam %regex.expr.optional (expr: %regex.Leaf): %regex.Expr =
    (0I1, expr) inj %regex.Expr;

// Matcher semantics for the object-language interpreter.  These handlers do
// not construct a `%regex.*` axiom application; they directly express the
// residual loads, comparisons, and control flow.
lam %regex.matcher.empty {n: Nat} (args: Input n): Res n =
    (args#(0:(Idx 3)), tt, args#(2:(Idx 3)));

lam %regex.matcher.any {n: Nat} (args: Input n): Res n =
    let (mem, c) = %mem.load (args#(0:(Idx 3)),
                               %mem.lea (args#(1:(Idx 3)), args#(2:(Idx 3))));
    let hit = %core.bit1.neg 0 (%core.icmp.e (c, 0I8));
    let next = %core.idx n 0 1;
    (mem, hit, %core.select (hit, next, args#(2:(Idx 3))));

lam %regex.matcher.range (r: «2; Char») {n: Nat}
    (args: Input n): Res n =
    let (mem, c) = %mem.load (args#(0:(Idx 3)),
                               %mem.lea (args#(1:(Idx 3)), args#(2:(Idx 3))));
    let ge = %core.icmp.uge (c, r#(0:(Idx 2)));
    let le = %core.icmp.ule (c, r#(1:(Idx 2)));
    let hit = %core.bit2.and_ 0 (ge, le);
    let next = %core.idx n 0 1;
    (mem, hit, %core.select (hit, next, args#(2:(Idx 3))));

lam %regex.matcher.lit (c: Char): RE = %regex.matcher.range (c, c);

lam %regex.matcher.conj (lhs rhs: RE) {n: Nat}
    (args: Input n): Res n =
        let (mem, lhit, lpos) = lhs args;
        let (mem, rhit, rpos) = rhs (mem, args#(1:(Idx 3)), lpos);
        let hit = %core.bit2.and_ 0 (lhit, rhit);
        (mem, hit, %core.select (hit, rpos, args#(2:(Idx 3))));

lam %regex.matcher.disj (lhs rhs: RE) {n: Nat}
    (args: Input n): Res n =
        let (mem, lhit, lpos) = lhs args;
        let (mem, rhit, rpos) = rhs (mem, args#(1:(Idx 3)), args#(2:(Idx 3)));
        let hit = %core.select (lhit, lhit, rhit);
        let pos = %core.select (lhit, lpos, rpos);
        (mem, hit, pos);

lam %regex.matcher.optional (expr: RE) {n: Nat}
    (args: Input n): Res n =
        let (mem, hit, pos) = expr args;
        (mem, tt, %core.select (hit, pos, args#(2:(Idx 3))));

lam %regex.interpret_leaf (expr: %regex.Leaf) {n: Nat}
    (args: Input n): Res n =
    match expr with
        | _: %regex.Empty => %regex.matcher.empty args
        | _: %regex.Any => %regex.matcher.any args
        | c: Char => %regex.matcher.lit c args
        | r: «2; Char» => %regex.matcher.range r args;

lam %regex.interpret_conj (p: %regex.Concat) {n: Nat}
    (args: Input n): Res n =
    let (mem, lhit, lpos) = %regex.interpret_leaf p#(1:(Idx 3)) args;
    let (mem, rhit, rpos) = %regex.interpret_leaf p#(2:(Idx 3))
        (mem, args#(1:(Idx 3)), lpos);
    let hit = %core.bit2.and_ 0 (lhit, rhit);
    (mem, hit, %core.select (hit, rpos, args#(2:(Idx 3))));

lam %regex.interpret_disj (p: %regex.Alt) {n: Nat}
    (args: Input n): Res n =
    let (mem, lhit, lpos) = %regex.interpret_leaf p#(1:(Idx 3)) args;
    let (mem, rhit, rpos) = %regex.interpret_leaf p#(2:(Idx 3))
        (mem, args#(1:(Idx 3)), args#(2:(Idx 3)));
    let hit = %core.select (lhit, lhit, rhit);
    let pos = %core.select (lhit, lpos, rpos);
    (mem, hit, pos);

lam %regex.interpret_optional (p: %regex.Optional) {n: Nat}
    (args: Input n): Res n =
    let (mem, hit, pos) = %regex.interpret_leaf p#(1:(Idx 2)) args;
    (mem, tt, %core.select (hit, pos, args#(2:(Idx 3))));

/// The first Futamura projection is now an ordinary pattern-matching
/// interpreter.  For a closed `Expr`, normalization selects one branch and
/// recursively specializes the leaf interpreters before input is available.
lam %regex.interpret (expr: %regex.Expr) {n: Nat}
    (args: Input n): Res n =
    match expr with
        | leaf: %regex.Leaf => %regex.interpret_leaf leaf args
        | p: %regex.Concat => %regex.interpret_conj p args
        | p: %regex.Alt => %regex.interpret_disj p args
        | p: %regex.Optional => %regex.interpret_optional p args;

/// ## Recursive Regex AST
///
/// MimIR does not currently expose an iso-recursive type constructor. A
/// postorder node table gives the interpreter the same expressive power for a
/// finite regex tree: child references are indices into the table, while the
/// node payload remains a tagged union that can be pattern matched normally.
/// The whole table is expected to be closed when `%regex.ast.compile` is used.
///
/// Marker fields distinguish union alternatives that otherwise have the same
/// payload shape. They carry no runtime meaning and disappear during partial
/// evaluation.
let %regex.ast.Empty = [Bool, Nat];
let %regex.ast.Any = [Nat, Bool];
let %regex.ast.Lit = Char;
let %regex.ast.Range = «2; Char»;
lam %regex.ast.Concat (n: Nat): * = [Bool, Idx n, Idx n];
lam %regex.ast.Alt (n: Nat): * = [Nat, Idx n, Idx n];
lam %regex.ast.Optional (n: Nat): * = [I1, Idx n];
lam %regex.ast.Star (n: Nat): * = [I8, Idx n];
lam %regex.ast.Plus (n: Nat): * = [I16, Idx n];
lam %regex.ast.Node (n: Nat): * =
    %regex.ast.Empty ∪ %regex.ast.Any ∪ %regex.ast.Lit ∪ %regex.ast.Range
    ∪ (%regex.ast.Concat n) ∪ (%regex.ast.Alt n) ∪ (%regex.ast.Optional n)
    ∪ (%regex.ast.Star n) ∪ (%regex.ast.Plus n);
lam %regex.ast.Expr (n: Nat): * = [root: Idx n, nodes: «n; %regex.ast.Node n»];

lam %regex.ast.empty {n: Nat} (): %regex.ast.Node n =
    (ff, 0) inj %regex.ast.Node n;
lam %regex.ast.any {n: Nat} (): %regex.ast.Node n =
    (0, ff) inj %regex.ast.Node n;
lam %regex.ast.lit {n: Nat} (c: Char): %regex.ast.Node n =
    c inj %regex.ast.Node n;
lam %regex.ast.range {n: Nat} (lo hi: Char): %regex.ast.Node n =
    (lo, hi) inj %regex.ast.Node n;
lam %regex.ast.conj {n: Nat} (lhs rhs: Idx n): %regex.ast.Node n =
    (ff, lhs, rhs) inj %regex.ast.Node n;
lam %regex.ast.disj {n: Nat} (lhs rhs: Idx n): %regex.ast.Node n =
    (0, lhs, rhs) inj %regex.ast.Node n;
lam %regex.ast.optional {n: Nat} (child: Idx n): %regex.ast.Node n =
    (0I1, child) inj %regex.ast.Node n;
lam %regex.ast.star {n: Nat} (child: Idx n): %regex.ast.Node n =
    (0I8, child) inj %regex.ast.Node n;
lam %regex.ast.plus {n: Nat} (child: Idx n): %regex.ast.Node n =
    (0I16, child) inj %regex.ast.Node n;

/// Compile one closed AST node to a monomorphic matcher. This is an
/// object-language interpreter: it indexes and pattern matches the AST in
/// MimIR, rather than asking the C++ regex lowering pass to inspect it. `fuel`
/// bounds malformed cyclic tables. For a valid finite tree, `id`, `fuel`,
/// union dispatch, and all recursive calls are eliminated before the input
/// string is available.
lam %regex.ast.compile_node {nn n: Nat}
    (nodes: «nn; %regex.ast.Node nn», id: Idx nn, fuel: Nat)
    @(%core.bit2.and_ 0
        (%core.pe.is_closed nodes,
         %core.bit2.and_ 0 (%core.pe.is_closed id, %core.pe.is_closed fuel)))
    : Input n → Res n =
    %core.select (%core.ncmp.g (fuel, 0), compile, exhausted) () where
        lam compile (): Input n → Res n =
            match nodes#id with
                | _: %regex.ast.Empty => lm (args: Input n): Res n =
                    %regex.matcher.empty args
                | _: %regex.ast.Any => lm (args: Input n): Res n =
                    %regex.matcher.any args
                | c: %regex.ast.Lit => lm (args: Input n): Res n =
                    %regex.matcher.lit c args
                | r: %regex.ast.Range => lm (args: Input n): Res n =
                    %regex.matcher.range r args
                | p: %regex.ast.Concat nn =>
                    let lhs = %regex.ast.compile_node
                        (nodes, p#(1:(Idx 3)), %core.nat.sub (fuel, 1));
                    let rhs = %regex.ast.compile_node
                        (nodes, p#(2:(Idx 3)), %core.nat.sub (fuel, 1));
                    lm (args: Input n): Res n =
                        let (mem, lhit, lpos) = lhs args;
                        let (mem, rhit, rpos) =
                            rhs (mem, args#(1:(Idx 3)), lpos);
                        let hit = %core.bit2.and_ 0 (lhit, rhit);
                        (mem, hit, %core.select (hit, rpos, args#(2:(Idx 3))))
                | p: %regex.ast.Alt nn =>
                    let lhs = %regex.ast.compile_node
                        (nodes, p#(1:(Idx 3)), %core.nat.sub (fuel, 1));
                    let rhs = %regex.ast.compile_node
                        (nodes, p#(2:(Idx 3)), %core.nat.sub (fuel, 1));
                    lm (args: Input n): Res n =
                        let (mem, lhit, lpos) = lhs args;
                        let (mem, rhit, rpos) =
                            rhs (mem, args#(1:(Idx 3)), args#(2:(Idx 3)));
                        let hit = %core.select (lhit, lhit, rhit);
                        (mem, hit, %core.select (lhit, lpos, rpos))
                | p: %regex.ast.Optional nn =>
                    let child = %regex.ast.compile_node
                        (nodes, p#(1:(Idx 2)), %core.nat.sub (fuel, 1));
                    lm (args: Input n): Res n =
                        let (mem, hit, pos) = child args;
                        (mem, tt, %core.select (hit, pos, args#(2:(Idx 3))))
                | _: %regex.ast.Star nn =>
                    lm (args: Input n): Res n =
                        %runtime.fail @(Res n, 40)
                            "regex AST star direct matcher is pending"
                | _: %regex.ast.Plus nn =>
                    lm (args: Input n): Res n =
                        %runtime.fail @(Res n, 40)
                            "regex AST plus direct matcher is pending";
        lam exhausted (): Input n → Res n =
            lm (args: Input n): Res n =
                %runtime.fail @(Res n, 53)
                    "regex AST contains a cycle or invalid child reference";
    end;

/// First Futamura projection for a closed regex AST. The node count is also a
/// sufficient recursion bound for an acyclic table, so no AST-dependent value
/// remains in the returned matcher.
lam %regex.ast.compile {nn: Nat} (expr: %regex.ast.Expr nn): RE =
    lm {n: Nat} (input: Input n): Res n =
        (%regex.ast.compile_node (expr#(1:(Idx 2)), expr#(0:(Idx 2)), nn)) input;

/// ## Object-language NFA building blocks
///
/// These definitions are intentionally ordinary MimIR values. A state set is a
/// fixed-size bitset represented as a `Bool` array. Insertion and union are
/// tuple comprehensions over the finite state domain; when the NFA and loop
/// fuel are closed, these arrays are expected to disappear through partial
/// evaluation.
lam %regex.nfa.StateSet (ns: Nat): * = «ns; Bool»;
let %regex.nfa.Epsilon = [Bool, Nat];
let %regex.nfa.Range = «2; Char»;
let %regex.nfa.EmptyLabel = [Nat, Bool];
let %regex.nfa.Label = %regex.nfa.Epsilon ∪ %regex.nfa.Range ∪ %regex.nfa.EmptyLabel;
lam %regex.nfa.Edge (ns: Nat): * =
    [src: Idx ns, dst: Idx ns, label: %regex.nfa.Label];
lam %regex.NFA (ns: Nat) (ne: Nat): * =
    [start accept: Idx ns, edges: «ne; %regex.nfa.Edge ns»];

lam %regex.nfa.epsilon (): %regex.nfa.Label =
    (ff, 0) inj %regex.nfa.Label;
lam %regex.nfa.range (lo hi: Char): %regex.nfa.Label =
    (lo, hi) inj %regex.nfa.Label;
lam %regex.nfa.empty_label (): %regex.nfa.Label =
    (0, ff) inj %regex.nfa.Label;

lam %regex.nfa.edge_src {ns: Nat} (edge: %regex.nfa.Edge ns): Idx ns =
    edge#(0:(Idx 3));
lam %regex.nfa.edge_dst {ns: Nat} (edge: %regex.nfa.Edge ns): Idx ns =
    edge#(1:(Idx 3));
lam %regex.nfa.edge_label {ns: Nat} (edge: %regex.nfa.Edge ns): %regex.nfa.Label =
    edge#(2:(Idx 3));

lam %regex.nfa.empty_set {ns: Nat} (): %regex.nfa.StateSet ns =
    ‹_: ns; ff›;
lam %regex.nfa.singleton {ns: Nat} (state: Idx ns): %regex.nfa.StateSet ns =
    ‹query: ns; %core.icmp.e (query, state)›;
lam %regex.nfa.insert {ns: Nat}
    (set: %regex.nfa.StateSet ns, state: Idx ns): %regex.nfa.StateSet ns =
    ‹query: ns; %core.bit2.or_ 0 (set#query, %core.icmp.e (query, state))›;
lam %regex.nfa.merge {ns: Nat}
    (lhs rhs: %regex.nfa.StateSet ns): %regex.nfa.StateSet ns =
    ‹query: ns; %core.bit2.or_ 0 (lhs#query, rhs#query)›;

lam %regex.nfa.is_epsilon (label: %regex.nfa.Label): Bool =
    match label with
        | _: %regex.nfa.Epsilon => tt
        | _: %regex.nfa.Range => ff
        | _: %regex.nfa.EmptyLabel => ff;

lam %regex.nfa.matches_char (label: %regex.nfa.Label, c: Char): Bool =
    match label with
        | _: %regex.nfa.Epsilon => ff
        | r: %regex.nfa.Range =>
            %core.bit2.and_ 0
                (%core.icmp.uge (c, r#(0:(Idx 2))),
                 %core.icmp.ule (c, r#(1:(Idx 2))))
        | _: %regex.nfa.EmptyLabel => ff;

/// One epsilon-closure relaxation over every edge. Repeating it `ns` times is
/// sufficient for an NFA with `ns` states, because each pass can add at least
/// one new reachable state along an epsilon path.
lam %regex.nfa.epsilon_step {ns: Nat}
    (set: %regex.nfa.StateSet ns, edge: %regex.nfa.Edge ns): %regex.nfa.StateSet ns =
    let can_follow = %core.bit2.and_ 0
        (set#(%regex.nfa.edge_src edge),
         %regex.nfa.is_epsilon (%regex.nfa.edge_label edge));
    %core.select (can_follow, %regex.nfa.insert (set, %regex.nfa.edge_dst edge), set);

lam %regex.nfa.epsilon_pass {ns ne: Nat}
    (edges: «ne; %regex.nfa.Edge ns», set: %regex.nfa.StateSet ns)
    : %regex.nfa.StateSet ns =
    %vec.fold.l step (set, edges) where
        lam step (acc: %regex.nfa.StateSet ns, edge: %regex.nfa.Edge ns)
            : %regex.nfa.StateSet ns =
            %regex.nfa.epsilon_step (acc, edge);
    end;

lam %regex.nfa.epsilon_closure {ns ne: Nat}
    (nfa: %regex.NFA ns ne, set: %regex.nfa.StateSet ns)
    : %regex.nfa.StateSet ns =
    let edges = nfa#(2:(Idx 3));
    let ticks: «ns; Nat» = ‹_: ns; 0›;
    %vec.fold.l step (set, ticks) where
        lam step (acc: %regex.nfa.StateSet ns, _: Nat)
            : %regex.nfa.StateSet ns =
            %regex.nfa.epsilon_pass (edges, acc);
    end;

lam %regex.nfa.move_step {ns: Nat} (source: %regex.nfa.StateSet ns, c: Char)
    (acc: %regex.nfa.StateSet ns, edge: %regex.nfa.Edge ns): %regex.nfa.StateSet ns =
    let can_follow = %core.bit2.and_ 0
        (source#(%regex.nfa.edge_src edge),
         %regex.nfa.matches_char (%regex.nfa.edge_label edge, c));
    %core.select (can_follow, %regex.nfa.insert (acc, %regex.nfa.edge_dst edge), acc);

lam %regex.nfa.move {ns ne: Nat}
    (nfa: %regex.NFA ns ne, set: %regex.nfa.StateSet ns, c: Char)
    @(%core.bit2.and_ 0
        (%core.pe.is_closed nfa,
         %core.bit2.and_ 0 (%core.pe.is_closed set, %core.pe.is_closed c)))
    : %regex.nfa.StateSet ns =
    let moved = %vec.fold.l step (%regex.nfa.empty_set (), nfa#(2:(Idx 3))) where
        lam step (acc: %regex.nfa.StateSet ns, edge: %regex.nfa.Edge ns)
            : %regex.nfa.StateSet ns =
            %regex.nfa.move_step (set, c) (acc, edge);
    end;
    %regex.nfa.epsilon_closure (nfa, moved);

/// Thompson-style object-language AST-to-NFA lowering. Every AST node owns two
/// NFA states: `2 * node` is the fragment start and `2 * node + 1` is the
/// fragment accept state. Every node also owns six fixed edge slots; unused
/// slots carry `%regex.nfa.empty_label`, which never matches and is ignored by
/// epsilon closure and move.
let %regex.ast.edges_per_node = 6;

lam %regex.ast.nfa_state_count (nn: Nat): Nat = %core.nat.mul (2, nn);
lam %regex.ast.nfa_edge_count (nn: Nat): Nat =
    %core.nat.mul (%regex.ast.edges_per_node, nn);

lam %regex.ast.node_start {nn: Nat}
    (node: Idx nn): Idx (%regex.ast.nfa_state_count nn) =
    %core.idx (%regex.ast.nfa_state_count nn) 0
        (%core.nat.mul (2, %core.bitcast Nat node));

lam %regex.ast.node_accept {nn: Nat}
    (node: Idx nn): Idx (%regex.ast.nfa_state_count nn) =
    %core.idx (%regex.ast.nfa_state_count nn) 0
        (%core.nat.add (%core.nat.mul (2, %core.bitcast Nat node), 1));

lam %regex.ast.nfa_invalid_edge {nn: Nat} (): %regex.nfa.Edge (%regex.ast.nfa_state_count nn) =
    let zero = %core.idx (%regex.ast.nfa_state_count nn) 0 0;
    (zero, zero, %regex.nfa.empty_label ());

lam %regex.ast.nfa_epsilon_edge {nn: Nat}
    (src dst: Idx (%regex.ast.nfa_state_count nn))
    : %regex.nfa.Edge (%regex.ast.nfa_state_count nn) =
    (src, dst, %regex.nfa.epsilon ());

lam %regex.ast.nfa_range_edge {nn: Nat}
    (src dst: Idx (%regex.ast.nfa_state_count nn), lo hi: Char)
    : %regex.nfa.Edge (%regex.ast.nfa_state_count nn) =
    (src, dst, %regex.nfa.range (lo, hi));

lam %regex.ast.nfa_edge_for {nn: Nat}
    (node_id: Idx nn, slot: Nat, node: %regex.ast.Node nn)
    : %regex.nfa.Edge (%regex.ast.nfa_state_count nn) =
    let self_start = %regex.ast.node_start node_id;
    let self_accept = %regex.ast.node_accept node_id;
    let invalid = %regex.ast.nfa_invalid_edge @nn ();
    match node with
        | _: %regex.ast.Empty =>
            %core.select (%core.ncmp.e (slot, 0),
                %regex.ast.nfa_epsilon_edge (self_start, self_accept), invalid)
        | _: %regex.ast.Any =>
            %core.select (%core.ncmp.e (slot, 0),
                %regex.ast.nfa_range_edge (self_start, self_accept, 1I8, 255I8), invalid)
        | c: %regex.ast.Lit =>
            %core.select (%core.ncmp.e (slot, 0),
                %regex.ast.nfa_range_edge (self_start, self_accept, c, c), invalid)
        | r: %regex.ast.Range =>
            %core.select (%core.ncmp.e (slot, 0),
                %regex.ast.nfa_range_edge
                    (self_start, self_accept, r#(0:(Idx 2)), r#(1:(Idx 2))),
                invalid)
        | p: %regex.ast.Concat nn =>
            let lhs = p#(1:(Idx 3));
            let rhs = p#(2:(Idx 3));
            let e0 = %regex.ast.nfa_epsilon_edge (self_start, %regex.ast.node_start lhs);
            let e1 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept lhs, %regex.ast.node_start rhs);
            let e2 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept rhs, self_accept);
            %core.select (%core.ncmp.e (slot, 0), e0,
                %core.select (%core.ncmp.e (slot, 1), e1,
                    %core.select (%core.ncmp.e (slot, 2), e2, invalid)))
        | p: %regex.ast.Alt nn =>
            let lhs = p#(1:(Idx 3));
            let rhs = p#(2:(Idx 3));
            let e0 = %regex.ast.nfa_epsilon_edge (self_start, %regex.ast.node_start lhs);
            let e1 = %regex.ast.nfa_epsilon_edge (self_start, %regex.ast.node_start rhs);
            let e2 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept lhs, self_accept);
            let e3 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept rhs, self_accept);
            %core.select (%core.ncmp.e (slot, 0), e0,
                %core.select (%core.ncmp.e (slot, 1), e1,
                    %core.select (%core.ncmp.e (slot, 2), e2,
                        %core.select (%core.ncmp.e (slot, 3), e3, invalid))))
        | p: %regex.ast.Optional nn =>
            let child = p#(1:(Idx 2));
            let e0 = %regex.ast.nfa_epsilon_edge (self_start, self_accept);
            let e1 = %regex.ast.nfa_epsilon_edge (self_start, %regex.ast.node_start child);
            let e2 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept child, self_accept);
            %core.select (%core.ncmp.e (slot, 0), e0,
                %core.select (%core.ncmp.e (slot, 1), e1,
                    %core.select (%core.ncmp.e (slot, 2), e2, invalid)))
        | p: %regex.ast.Star nn =>
            let child = p#(1:(Idx 2));
            let e0 = %regex.ast.nfa_epsilon_edge (self_start, self_accept);
            let e1 = %regex.ast.nfa_epsilon_edge (self_start, %regex.ast.node_start child);
            let e2 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept child, %regex.ast.node_start child);
            let e3 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept child, self_accept);
            %core.select (%core.ncmp.e (slot, 0), e0,
                %core.select (%core.ncmp.e (slot, 1), e1,
                    %core.select (%core.ncmp.e (slot, 2), e2,
                        %core.select (%core.ncmp.e (slot, 3), e3, invalid))))
        | p: %regex.ast.Plus nn =>
            let child = p#(1:(Idx 2));
            let e0 = %regex.ast.nfa_epsilon_edge (self_start, %regex.ast.node_start child);
            let e1 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept child, %regex.ast.node_start child);
            let e2 = %regex.ast.nfa_epsilon_edge (%regex.ast.node_accept child, self_accept);
            %core.select (%core.ncmp.e (slot, 0), e0,
                %core.select (%core.ncmp.e (slot, 1), e1,
                    %core.select (%core.ncmp.e (slot, 2), e2, invalid)));

lam %regex.ast.to_nfa {nn: Nat} (expr: %regex.ast.Expr nn)
    @(%core.pe.is_closed expr)
    : %regex.NFA (%regex.ast.nfa_state_count nn) (%regex.ast.nfa_edge_count nn) =
    let nodes = expr#(1:(Idx 2));
    let edges = ‹edge_id: %regex.ast.nfa_edge_count nn;
        let edge_nat = %core.bitcast Nat edge_id;
        let node_id = %core.idx nn 0
            (%core.nat.div (edge_nat, %regex.ast.edges_per_node));
        let slot = %core.nat.mod (edge_nat, %regex.ast.edges_per_node);
        %regex.ast.nfa_edge_for (node_id, slot, nodes#node_id)›;
    (%regex.ast.node_start (expr#(0:(Idx 2))),
     %regex.ast.node_accept (expr#(0:(Idx 2))),
     edges);

/// ## Closed DFA Tables
///
/// `%regex.DFA ns k` is a homogeneous sparse transition table:
///
/// - `ns` is the number of states;
/// - `k` is the fixed transition capacity of every state;
/// - `entry` is the initial state;
/// - `error` is a designated state that rejects immediately;
/// - `accepting` is consulted only when the next input byte is NUL;
/// - `fallback` is selected when no explicit transition matches.
///
/// A transition `[lo, hi, target]` matches the inclusive unsigned byte range
/// `lo <= c <= hi`. Well-formed DFA tables use disjoint ranges. If ranges do
/// overlap, the later transition in the array has priority. `[255, 0, error]`
/// is consequently a useful never-matching padding transition.
lam %regex.dfa.Transition (ns: Nat): * = [lo hi: Char, target: Idx ns];
lam %regex.dfa.State (ns: Nat) (k: Nat): * =
    [accepting: Bool, fallback: Idx ns, transitions: «k; %regex.dfa.Transition ns»];
lam %regex.DFA (ns: Nat) (k: Nat): * =
    [entry error: Idx ns, states: «ns; %regex.dfa.State ns k»];

/// Named accessors hide the positional encoding of table records. They are
/// ordinary lambdas and disappear through beta reduction.
lam %regex.dfa.transition_lo {ns: Nat}
    (transition: %regex.dfa.Transition ns): Char = transition#(0:(Idx 3));
lam %regex.dfa.transition_hi {ns: Nat}
    (transition: %regex.dfa.Transition ns): Char = transition#(1:(Idx 3));
lam %regex.dfa.transition_target {ns: Nat}
    (transition: %regex.dfa.Transition ns): Idx ns = transition#(2:(Idx 3));
lam %regex.dfa.state_accepting {ns k: Nat}
    (state: %regex.dfa.State ns k): Bool = state#(0:(Idx 3));
lam %regex.dfa.state_fallback {ns k: Nat}
    (state: %regex.dfa.State ns k): Idx ns = state#(1:(Idx 3));
lam %regex.dfa.state_transitions {ns k: Nat}
    (state: %regex.dfa.State ns k): «k; %regex.dfa.Transition ns» = state#(2:(Idx 3));
lam %regex.dfa.entry {ns k: Nat} (dfa: %regex.DFA ns k): Idx ns = dfa#(0:(Idx 3));
lam %regex.dfa.error {ns k: Nat} (dfa: %regex.DFA ns k): Idx ns = dfa#(1:(Idx 3));
lam %regex.dfa.states {ns k: Nat}
    (dfa: %regex.DFA ns k): «ns; %regex.dfa.State ns k» = dfa#(2:(Idx 3));

/// ### `%regex.specialize_dfa`
///
/// Stages a closed DFA table into a residual full-string matcher. Its result
/// is semantically equivalent to `%regex.dfa.interpret`, but the table and the
/// dynamic state index are absent from residual code.
///
/// The normalizer performs the equivalent of Truffle's `@ExplodeLoop` plus a
/// compilation-constant state node. It first allocates one continuation per
/// state, then fills their bodies with constant range checks and direct edges.
/// Statically empty ranges (`lo > hi`) are discarded as table padding.
/// Range checks precede the cold EOF/fallback path, which keeps accepting
/// self-loops free of per-byte result materialization. NUL remains an input
/// terminator even if a closed table contains a transition range starting at 0.
/// Allocating all placeholders first is essential: a DFA back edge references
/// an existing continuation instead of recursively expanding the interpreter.
/// Code size is `O(ns * k)` and does not depend on input length.
///
/// The DFA argument must be closed and projectable to literal table fields.
/// If it is dynamic, this staging axiom remains unresolved; callers that need
/// runtime table interpretation should use `%regex.dfa.interpret` instead.
axm %regex.specialize_dfa: {ns k n: Nat} →
    [%regex.DFA ns k, Input n] → Res n, normalize_dfa_specialize, 2;

/// ### `%regex.dfa.compile`
///
/// Higher-order first Futamura projection. Applying it to a closed table
/// produces an `RE`; applying that matcher to dynamic input exposes
/// `%regex.specialize_dfa` with the table already fixed. Beta reduction removes
/// this wrapper, so it has no residual runtime cost.
let %regex.dfa.compile = lm {ns k: Nat} (dfa: %regex.DFA ns k): RE =
    lm {n: Nat} (input: Input n): Res n = %regex.specialize_dfa (dfa, input);

/// ### `%regex.host.compile`
///
/// Graal-style staging boundary. The regex expression is still written with
/// the high-level `%regex.*` combinators, but `%regex.lower_regex` constructs
/// the NFA/DFA on the host, materializes a closed `%regex.DFA` table, and then
/// routes the call through `%regex.specialize_dfa`.
///
/// This is intentionally separate from the object-language Futamura path under
/// `%regex.ast` and `%regex.nfa`: host construction is a baseline where
/// automaton construction is outside MimIR partial evaluation, while the
/// object-language path keeps those algorithms expressible in MimIR.
axm %regex.host_match: {n: Nat} → [RE, Input n] → Res n, 2;

let %regex.host.compile = lm (re: RE): RE =
    lm {n: Nat} (input: Input n): Res n = %regex.host_match (re, input);

/// ### `%regex.dfa.pick`
///
/// `ns` is the total number of states, so both `next` and
/// `transition.target` are statically bounded by `Idx ns`. `c` is the dynamic
/// input byte. This helper implements one transition update:
///
/// ```python
/// def pick(c, next_state, transition):
///     lo, hi, target = transition
///     return target if lo <= c <= hi else next_state
/// ```
lam %regex.dfa.pick {ns: Nat} (c: Char)
    (next: Idx ns, transition: %regex.dfa.Transition ns): Idx ns =
    let in_range = %core.bit2.and_ 0
        (%core.icmp.uge (c, %regex.dfa.transition_lo transition),
         %core.icmp.ule (c, %regex.dfa.transition_hi transition));
    %core.select (in_range, %regex.dfa.transition_target transition, next);

/// ### `%regex.dfa.fold_transitions`
///
/// `ns` is the state count, `k` is the transition capacity, `transitions` is
/// one state's fixed-size transition array, `i` is the current compile-time
/// slot, and `next` is the accumulated successor. Its semantics are:
///
/// ```python
/// def fold_transitions(transitions, c, i, next_state):
///     while i < k:
///         next_state = pick(c, next_state, transitions[i])
///         i += 1
///     return next_state
/// ```
///
/// The `is_closed i` filter exposes the fixed `k` iterations to partial
/// evaluation. Since every match replaces `next`, a later overlapping
/// transition takes priority over an earlier one.
lam %regex.dfa.fold_transitions {ns k: Nat}
    (transitions: «k; %regex.dfa.Transition ns», c: Char)
    (i: Nat, next: Idx ns)@(%core.pe.is_closed i): Idx ns =
    %core.select (%core.ncmp.le (k, i), done, more) ()
    where
        lam done (): Idx ns = next;
        lam more (): Idx ns =
            let transition = transitions#(%core.idx k 0 i);
            %regex.dfa.fold_transitions (transitions, c)
                (%core.nat.add (i, 1), %regex.dfa.pick c (next, transition));
    end;

/// ### `%regex.dfa.next`
///
/// `state` contains one accepting flag, one fallback state, and exactly `k`
/// transition slots. `next` starts from the fallback and folds every explicit
/// range over it:
///
/// ```python
/// def next_state(state, c):
///     return fold_transitions(
///         transitions=state.transitions,
///         c=c,
///         i=0,
///         next_state=state.fallback,
///     )
/// ```
///
/// The result remains `Idx ns`, so the type guarantees that it names a state
/// in the same DFA table.
lam %regex.dfa.next {ns k: Nat}
    (state: %regex.dfa.State ns k, c: Char): Idx ns =
    %regex.dfa.fold_transitions (%regex.dfa.state_transitions state, c)
        (0, %regex.dfa.state_fallback state);

/// ### `%regex.dfa.interpret`
///
/// Reference table interpreter. It reads bytes beginning at `input.pos`,
/// accepts only when NUL is reached in an accepting state, and returns the
/// position of NUL on success or the position after the rejecting byte on an
/// error transition. The designated error state rejects without loading.
///
/// This function makes the static/dynamic split explicit, but a dynamic state
/// still indexes the aggregate table. Current LLVM lowering does not eliminate
/// that lookup by itself; `%regex.specialize_dfa` is the executable staged path.
///
/// Python-like pseudocode for the positional operations below:
///
/// ```python
/// state_id = dfa.entry
/// while state_id != dfa.error:
///     current = dfa.states[state_id]
///     c = input.bytes[pos]
///     if c == 0:
///         return current.accepting, pos
///     state_id = next_state(current.transitions, current.fallback, c)
///     pos += 1
/// return False, pos
/// ```
fun %regex.dfa.interpret {ns k n: Nat}
    (dfa: %regex.DFA ns k, input: Input n)@tt: Res n =
    (head, reject)#(%core.icmp.e (%regex.dfa.entry dfa, %regex.dfa.error dfa))
        (input#(0:(Idx 3)), input#(2:(Idx 3)), %regex.dfa.entry dfa)
    where
        con head (mem: %mem.M 0, pos: Idx n, state: Idx ns) =
            let ptr = %mem.lea (input#(1:(Idx 3)), pos);
            let (mem, c) = %mem.load (mem, ptr);
            (consume, finish)#(%core.icmp.e (c, 0I8)) (mem, pos, state, c)
            where
                con finish (mem: %mem.M 0, pos: Idx n, state: Idx ns, _: Char) =
                    let current = (%regex.dfa.states dfa)#state;
                    return (mem, %regex.dfa.state_accepting current, pos);

                con consume (mem: %mem.M 0, pos: Idx n, state: Idx ns, c: Char) =
                    let current = (%regex.dfa.states dfa)#state;
                    let next = %regex.dfa.next (current, c);
                    let next_pos = %core.wrap.add 0 (pos, %core.idx n 0 1);
                    let failed = %core.icmp.e (next, %regex.dfa.error dfa);
                    (head, reject)#failed (mem, next_pos, next);
            end;

        con reject (mem: %mem.M 0, pos: Idx n, _: Idx ns) =
            return (mem, ff, pos);
    end;
///
/// ## Passes and Phases
///
/// ### Phases
///
axm %regex.lower_regex: %compile.Phase;
