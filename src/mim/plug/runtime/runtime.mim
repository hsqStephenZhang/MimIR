/// # The runtime Plugin {#runtime}
///
/// Runtime checks whose success continuation protects computations that rely on
/// the checked condition.
///
/// [TOC]
///
/// ## Dependencies
///
plugin core;
plugin mem;
///
/// ## Assertions
///
/// Target-specific failure primitive. Host LLVM lowering prints the message with
/// libc `puts`, calls `abort`, and terminates the block with `unreachable`.
axm %runtime.fail: {T: *, n: Nat} → «n; I8» → T;

// Checks only the statically decidable case. Dynamic conditions are preserved.
axm %runtime.static_check: {n: Nat} → [Bool, «n; I8»] → Bool, normalize_static_check;

/// Effectful statement-style assertion. The memory token sequences the check
/// with subsequent effects; it is not a memory mutation by itself.
axm %runtime.assert: {a n: Nat}
                     → [%mem.M a, Bool, «n; I8»]
                     → %mem.M a;

/// Pure expression-style precondition. The continuation prevents strict
/// evaluation from executing protected code before the check.
lam %runtime.require {T: *, n: Nat}
                     (condition: Bool, message: «n; I8»)
                     (success: [] → T)
                   : T =
    (%core.select (%runtime.static_check (condition, message), success, failure)) () where
        lam failure(): T = %runtime.fail @(T, n) message;
    end;
