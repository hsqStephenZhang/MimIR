// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang -O0 %{s:stem}.ll %S/llvm_array_ext_aux.c -o %t -Wno-override-module
// RUN: %t
// RUN: clang -O3 %{s:stem}.ll %S/llvm_array_ext_aux.c -o %t -Wno-override-module
// RUN: %t
// RUN: %FileCheck %s < %{s:stem}.ll
// RUN: %FileCheck %s --check-prefix=BAR < %{s:stem}.ll

plugin core;
plugin vec;
plugin mem;
plugin math;

fun foo{n: Nat} (a b: «n; Nat»): «n; Nat» =
    let c = vec.zip core.nat.sub (a, b);
    return (vec.zip core.nat.sub (c, ‹n; 1›));

extern fun bar(): «4; Nat» =
    let a = (1, 2, 3, 4);
    let b = (1, 2, 3, 4);
    ret c = foo @4 $ (a, b);
    ret d = foo @4 $ (a, b);
    return d;

// BAR: ret <4 x i64> <i64 0, i64 0, i64 0, i64 0>

// F32 array values stay vectors; the opaque address needs no value conversion.
// CHECK-LABEL: define void @acc(ptr
// CHECK-NOT: alloca
// CHECK-NOT: bitcast
// CHECK-NOT: [16 x float]
// CHECK: load <16 x float>, ptr {{.*}}, align 1
// CHECK-NOT: extractvalue
// CHECK-NOT: insertelement
// CHECK: phi <16 x float>
// CHECK: extractelement <16 x float>
// CHECK: insertelement <16 x float>
// CHECK-NOT: extractvalue
// CHECK-NOT: extractelement
// CHECK-NOT: insertvalue
// CHECK: store <16 x float> {{.*}}, ptr {{.*}}, align 1
extern fun acc (m: mem.M 0, p: mem.Ptr0 «16; math.F32», n: I32): mem.M 0 =
    let (m, x) = mem.load (m, p);
    loop (m, 0I32, x)
    where
        con loop (m: mem.M 0, i: I32, a: «16; math.F32») =
            (exit, body)#(core.icmp.ul (i, n)) m
            where
                con body m: mem.M 0 =
                    let k = core.conv.u 16 i;
                    loop (m, core.wrap.add 0 (1I32, i), a#k ← math.arith.add 0 (a#k, x#k));
                con exit (m: mem.M 0) = return (mem.store (m, p, a));
            end
    end
