// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll %t
// RUN: %mim %S/../gpu/%{s:stem}.mim -p opt -p nvptx -X nvptx:sm=90a -X nvptx:no-embed
// RUN: %FileCheck %s --input-file=%{s:stem}_dev.ll
// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll
// RUN: %mim %S/../gpu/%{s:stem}.mim -p opt -p nvptx -X nvptx:sm=90a
// RUN: %if system-linux && cuda %{ clang++ -O1 %S/../gpu/%{s:stem}_aux.cpp %{s:stem}.ll -lcuda -o %t -Wno-override-module %}
// RUN: %if system-linux && cuda %{ %t %}

