// Vector Addition Benchmark: N = 33554432 (32M elements)
// Matching 02-vec-add/src/main.cu parameters (100 iterations)

plugin core;
plugin math;
plugin affine;
plugin gpu;

rec Timespec = [tv_sec: I64, tv_nsec: I64];

cfun clock_gettime [mem: %mem.M 0, clock_id: I32, ts: %mem.Ptr0 Timespec]: [%mem.M 0, I32];
cfun bench_print_vector_add [mem: %mem.M 0,
                             n: I32,
                             avg_ms: %math.F64,
                             avg_ns: %math.F64,
                             total_ms: %math.F64,
                             iters: I32,
                             gflops: %math.F64,
                             gb_per_sec: %math.F64]: %mem.M 0;

let N        = 33554432; // 33,554,432 elements (128 MB FP32)
let N_BLOCKS = 131072;   // 131,072 blocks
let BLOCK    = 256;      // 256 threads per block
let ITERS    = 100;
let CLOCK_MONOTONIC = 1I32;

// ---------- CUDA Kernel ----------
con vector_add_kernel
    ( m1      : %gpu.GlobalM,
      m3      : %gpu.SharedM,
      m4      : %gpu.ConstM,
      m5      : %gpu.LocalM,
      group_id: Idx N_BLOCKS,
      item_id : Idx BLOCK,
      (),
      ( a: %gpu.GlobalPtr «N; %math.F32»,
        b: %gpu.GlobalPtr «N; %math.F32»,
        c: %gpu.GlobalPtr «N; %math.F32» ),
      return  : Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM] )
=
    let gi   = %core.bitcast I32 group_id;
    let ii   = %core.bitcast I32 item_id;
    let blk  = %core.bitcast I32 BLOCK;
    let gid  = %core.wrap.add 0 (%core.wrap.mul 0 (gi, blk), ii);
    let idx  = %core.conv.u N gid;

    let (m1, a_val) = %mem.load (m1, %mem.lea (a, idx));
    let (m1, b_val) = %mem.load (m1, %mem.lea (b, idx));
    let c_val       = %math.arith.add 0 (a_val, b_val);
    let m1          = %mem.store (m1, %mem.lea (c, idx), c_val);

    return (m1, m3, m4, m5);

// ---------- Host Program & Benchmarking ----------
fun extern main (m0  : %mem.M 0,
                 argc: I32,
                 argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0))
              : [%mem.M 0, I32] =
    let (m0, start_time) = %mem.slot (Timespec, 0) (m0, 0);
    let (m0, end_time)   = %mem.slot (Timespec, 0) (m0, 1);

    con bench_start [m0: %mem.M 0, return: Cn [%mem.M 0]] =
        ret (m0, _) = clock_gettime $ (m0, CLOCK_MONOTONIC, start_time);
        return m0;

    con bench_end [m0: %mem.M 0, n_elements: I32, return: Cn [%mem.M 0]] =
        ret (m0, _) = clock_gettime $ (m0, CLOCK_MONOTONIC, end_time);
        let (m0, start_sec)  = %mem.load (m0, %mem.lea (start_time, 0_2));
        let (m0, start_nsec) = %mem.load (m0, %mem.lea (start_time, 1_2));
        let (m0, stop_sec)   = %mem.load (m0, %mem.lea (end_time, 0_2));
        let (m0, stop_nsec)  = %mem.load (m0, %mem.lea (end_time, 1_2));

        let sec_diff  = %core.wrap.sub 0 (stop_sec, start_sec);
        let nsec_diff = %core.wrap.sub 0 (stop_nsec, start_nsec);
        let sec_ns    = %math.arith.mul 0 (%math.conv.s2f %math.f64 sec_diff, 1000000000.0:%math.F64);
        let elapsed_ns = %math.arith.add 0 (sec_ns, %math.conv.s2f %math.f64 nsec_diff);
        let avg_ns    = %math.arith.div 0 (elapsed_ns, %math.conv.u2f %math.f64 (%core.bitcast I32 ITERS));
        let avg_ms    = %math.arith.div 0 (avg_ns, 1000000.0:%math.F64);
        let total_ms  = %math.arith.div 0 (elapsed_ns, 1000000.0:%math.F64);
        let n_f64     = %math.conv.u2f %math.f64 n_elements;
        let gflops    = %math.arith.div 0 (n_f64, avg_ns);
        let bytes     = %math.arith.mul 0 (%math.arith.mul 0 (3.0:%math.F64, n_f64), 4.0:%math.F64);
        let gb_per_sec = %math.arith.div 0 (bytes, avg_ns);
        ret m0 = bench_print_vector_add $ (m0, n_elements, avg_ms, avg_ns, total_ms,
                                           %core.bitcast I32 ITERS, gflops, gb_per_sec);
        return m0;

    let (m0, h_a) = %mem.alloc («N; %math.F32», 0) m0;
    let (m0, h_b) = %mem.alloc («N; %math.F32», 0) m0;
    let (m0, h_c) = %mem.alloc («N; %math.F32», 0) m0;

    // Initialise host arrays
    con init_body [i : I32, [m : %mem.M 0], yield : Cn [[%mem.M 0]]] =
        let idx = %core.conv.u N i;
        let fi  = %math.conv.u2f %math.f32 i;
        let ni  = %core.wrap.sub 0 (%core.bitcast I32 N, i);
        let fni = %math.conv.u2f %math.f32 ni;
        let m   = %mem.store (m, %mem.lea (h_a, idx), fi);
        let m   = %mem.store (m, %mem.lea (h_b, idx), fni);
        yield m;

    con init_exit [[m0 : %mem.M 0]] =
        let (m0, m1, m4) = %gpu.init m0;

        let (m1, d_a) = %mem.alloc («N; %math.F32», 1) m1;
        let (m1, d_b) = %mem.alloc («N; %math.F32», 1) m1;
        let (m1, d_c) = %mem.alloc («N; %math.F32», 1) m1;

        let (m0, m1) = %gpu.copy_to_device.block (m0, m1, h_a, d_a);
        let (m0, m1) = %gpu.copy_to_device.block (m0, m1, h_b, d_b);

        // Warmup
        ret (m0, m1, m4) = %gpu.launch
            (N_BLOCKS, BLOCK, %gpu.default_stream, ff, ())
            vector_add_kernel (d_a, d_b, d_c) $ (m0, m1, m4);
        let (m0, m1) = %gpu.stream_sync (m0, m1, %gpu.default_stream);

        // Benchmark Start
        bench_start (m0, after_start)
        where
            con after_start [m0: %mem.M 0] =
                // Loop 100 iterations of GPU launch
                con bench_loop [i : I32, [m0 : %mem.M 0, m1 : %gpu.GlobalM, m4 : %gpu.ConstM], yield : Cn [[%mem.M 0, %gpu.GlobalM, %gpu.ConstM]]] =
                    ret (m0, m1, m4) = %gpu.launch
                        (N_BLOCKS, BLOCK, %gpu.default_stream, ff, ())
                        vector_add_kernel (d_a, d_b, d_c) $ (m0, m1, m4);
                    yield (m0, m1, m4);

                con bench_exit [[m0 : %mem.M 0, m1 : %gpu.GlobalM, m4 : %gpu.ConstM]] =
                    // Synchronize Stream after 100 iterations
                    let (m0, m1) = %gpu.stream_sync (m0, m1, %gpu.default_stream);

                    // Benchmark End
                    bench_end (m0, %core.bitcast I32 N, after_end)
                    where
                        con after_end [m0: %mem.M 0] =
                            let (m0, m1) = %gpu.copy_to_host.block (m0, m1, d_c, h_c);

                            let m1 = %mem.free (m1, d_a);
                            let m1 = %mem.free (m1, d_b);
                            let m1 = %mem.free (m1, d_c);

                            let m0 = %gpu.deinit (m0, m1, m4);

                            let m0 = %mem.free (m0, h_a);
                            let m0 = %mem.free (m0, h_b);
                            let m0 = %mem.free (m0, h_c);

                            return (m0, 0I32);
                    end;

                %affine.For bench_loop bench_exit (0I32, %core.bitcast I32 ITERS, 1I32, (m0, m1, m4));
        end;

    %affine.For init_body init_exit (0I32, %core.bitcast I32 N, 1I32, (m0));
