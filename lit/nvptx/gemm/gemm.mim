            let global_row_49 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 0I32)));
            let global_col_49 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 1I32));
            let c_i32_49 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_49, %core.bitcast I32 N), global_col_49);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_49), c49);
            let global_row_50 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 0I32)));
            let global_col_50 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 2I32));
            let c_i32_50 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_50, %core.bitcast I32 N), global_col_50);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_50), c50);
            let global_row_51 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 0I32)));
            let global_col_51 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 3I32));
            let c_i32_51 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_51, %core.bitcast I32 N), global_col_51);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_51), c51);
            let global_row_52 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 1I32)));
            let global_col_52 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 0I32));
            let c_i32_52 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_52, %core.bitcast I32 N), global_col_52);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_52), c52);
            let global_row_53 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 1I32)));
            let global_col_53 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 1I32));
            let c_i32_53 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_53, %core.bitcast I32 N), global_col_53);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_53), c53);
            let global_row_54 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 1I32)));
            let global_col_54 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 2I32));
            let c_i32_54 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_54, %core.bitcast I32 N), global_col_54);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_54), c54);
            let global_row_55 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 1I32)));
            let global_col_55 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 3I32));
            let c_i32_55 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_55, %core.bitcast I32 N), global_col_55);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_55), c55);
            let global_row_56 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 2I32)));
            let global_col_56 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 0I32));
            let c_i32_56 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_56, %core.bitcast I32 N), global_col_56);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_56), c56);
            let global_row_57 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 2I32)));
            let global_col_57 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 1I32));
            let c_i32_57 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_57, %core.bitcast I32 N), global_col_57);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_57), c57);
            let global_row_58 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 2I32)));
            let global_col_58 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 2I32));
            let c_i32_58 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_58, %core.bitcast I32 N), global_col_58);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_58), c58);
            let global_row_59 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 2I32)));
            let global_col_59 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 3I32));
            let c_i32_59 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_59, %core.bitcast I32 N), global_col_59);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_59), c59);
            let global_row_60 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_60 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 0I32));
            let c_i32_60 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_60, %core.bitcast I32 N), global_col_60);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_60), c60);
            let global_row_61 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_61 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 1I32));
            let c_i32_61 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_61, %core.bitcast I32 N), global_col_61);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_61), c61);
            let global_row_62 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_62 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 2I32));
            let c_i32_62 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_62, %core.bitcast I32 N), global_col_62);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_62), c62);
            let global_row_63 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_63 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 3I32));
            let c_i32_63 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_63, %core.bitcast I32 N), global_col_63);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_63), c63);
            return (m1, m3, m4, m5);
    end;


fun extern main (m0: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0))
              : [%mem.M 0, I32] =
    let (m0, start_time) = %mem.slot (Timespec, 0) (m0, 0);
    let (m0, end_time)   = %mem.slot (Timespec, 0) (m0, 1);

    con bench_start [m0: %mem.M 0, return: Cn [%mem.M 0]] =
        ret (m0, _) = clock_gettime $ (m0, CLOCK_MONOTONIC, start_time);
        return m0;

    con bench_end [m0: %mem.M 0, variant: I32, return: Cn [%mem.M 0]] =
        ret (m0, _) = clock_gettime $ (m0, CLOCK_MONOTONIC, end_time);
        let (m0, start_sec)  = %mem.load (m0, %mem.lea (start_time, 0_2));
        let (m0, start_nsec) = %mem.load (m0, %mem.lea (start_time, 1_2));
        let (m0, stop_sec)   = %mem.load (m0, %mem.lea (end_time, 0_2));
        let (m0, stop_nsec)  = %mem.load (m0, %mem.lea (end_time, 1_2));

        let sec_diff   = %core.wrap.sub 0 (stop_sec, start_sec);
        let nsec_diff  = %core.wrap.sub 0 (stop_nsec, start_nsec);
        let sec_ns     = %math.arith.mul 0 (%math.conv.s2f %math.f64 sec_diff, 1000000000.0:%math.F64);
        let elapsed_ns = %math.arith.add 0 (sec_ns, %math.conv.s2f %math.f64 nsec_diff);
        let avg_ns     = %math.arith.div 0 (elapsed_ns, %math.conv.u2f %math.f64 (%core.bitcast I32 ITERS));
        let avg_ms     = %math.arith.div 0 (avg_ns, 1000000.0:%math.F64);
        let total_ms   = %math.arith.div 0 (elapsed_ns, 1000000.0:%math.F64);
        let flops      = 2147483648.0:%math.F64; // 2 * M * N * K
        let gflops     = %math.arith.div 0 (flops, avg_ns);
        ret m0 = bench_print_gemm_result $ (m0, variant, avg_ms, avg_ns, total_ms,
                                            %core.bitcast I32 ITERS, gflops);
        return m0;

    let (m0, h_A) = %mem.alloc («MK; %math.F32», 0) m0;
    let (m0, h_B) = %mem.alloc («KN; %math.F32», 0) m0;
    let (m0, h_C) = %mem.alloc («MN; %math.F32», 0) m0;
    let (m0, h_expected) = %mem.alloc («MN; %math.F32», 0) m0;

    con init_a_body [i: I32, [m0: %mem.M 0], continue: Cn [[%mem.M 0]]] =
        let idx = %core.conv.u MK i;
        let m0 = %mem.store (m0, %mem.lea (h_A, idx), 1.0:%math.F32);
        continue m0;

    con init_a_exit [[m0: %mem.M 0]] =
        con init_b_body [i: I32, [m0: %mem.M 0], continue: Cn [[%mem.M 0]]] =
            let idx = %core.conv.u KN i;
            let m0 = %mem.store (m0, %mem.lea (h_B, idx), 1.0:%math.F32);
            continue m0;

        con init_b_exit [[m0: %mem.M 0]] =
            con init_expected_body [i: I32, [m0: %mem.M 0], continue: Cn [[%mem.M 0]]] =
                let idx = %core.conv.u MN i;
                let expected = %math.conv.u2f %math.f32 (%core.bitcast I32 K);
                let m0 = %mem.store (m0, %mem.lea (h_expected, idx), expected);
                continue m0;

            con init_expected_exit [[m0: %mem.M 0]] =
            let (m0, m1, m4) = %gpu.init m0;

            let (m1, d_A) = %mem.alloc («MK; %math.F32», 1) m1;
            let (m1, d_B) = %mem.alloc («KN; %math.F32», 1) m1;
            let (m1, d_C) = %mem.alloc («MN; %math.F32», 1) m1;

            let (m0, m1) = %gpu.copy_to_device.block (m0, m1, h_A, d_A);
            let (m0, m1) = %gpu.copy_to_device.block (m0, m1, h_B, d_B);
            ret m0 = bench_print_gemm_header $ (m0, %core.bitcast I32 M, %core.bitcast I32 N, %core.bitcast I32 K);

            fun cleanup (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                let m1 = %mem.free (m1, d_A);
                let m1 = %mem.free (m1, d_B);
                let m1 = %mem.free (m1, d_C);
                let m0 = %gpu.deinit (m0, m1, m4);
                let m0 = %mem.free (m0, h_A);
                let m0 = %mem.free (m0, h_B);
                let m0 = %mem.free (m0, h_C);
                let m0 = %mem.free (m0, h_expected);
                return (m0, status);

            fun launch_naive (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM): [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] =
                ret (m0, m1, m4) = %gpu.launch_3d (GRID_X, GRID_Y, 1, BLOCK_X, BLOCK_Y, 1,
                                                   %gpu.default_stream, ff, ())
                    naive_gemm (d_A, d_B, d_C) $ (m0, m1, m4);
                return (m0, m1, m4);

            fun launch_tiled (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM): [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] =
                ret (m0, m1, m4) = %gpu.launch_3d (GRID_X, GRID_Y, 1, BLOCK_X, BLOCK_Y, 1,
                                                   %gpu.default_stream, ff, ())
                    tiled_gemm_16x16 (d_A, d_B, d_C) $ (m0, m1, m4);
                return (m0, m1, m4);

            fun launch_double (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM): [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] =
                ret (m0, m1, m4) = %gpu.launch_3d (GRID_X, GRID_Y, 1, BLOCK_X, BLOCK_Y, 1,
                                                   %gpu.default_stream, ff, ())
                    tiled_gemm_double_buffer (d_A, d_B, d_C) $ (m0, m1, m4);
                return (m0, m1, m4);

            fun launch_tvm (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM): [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] =
                ret (m0, m1, m4) = %gpu.launch_3d (TVM_GRID_X, 1, 1, TVM_BLOCK_X, 1, 1,
                                                   %gpu.default_stream, ff, ())
                    tvm_style_gemm_scalar (d_A, d_B, d_C) $ (m0, m1, m4);
                return (m0, m1, m4);

            fun launch_pipeline (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM): [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] =
                ret (m0, m1, m4) = %gpu.launch_3d (TVM_GRID_X, 1, 1, TVM_BLOCK_X, 1, 1,
                                                   %gpu.default_stream, ff, ())
                    tvm_style_gemm_pipelined (d_A, d_B, d_C) $ (m0, m1, m4);
                return (m0, m1, m4);

            fun launch_pipeline3 (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM): [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] =
                ret (m0, m1, m4) = %gpu.launch_3d (TVM_GRID_X, 1, 1, TVM_BLOCK_X, 1, 1,
                                                   %gpu.default_stream, ff, ())
                    tvm_style_gemm_pipelined3 (d_A, d_B, d_C) $ (m0, m1, m4);
                return (m0, m1, m4);

            con verify_result [m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM,
                               status_in: I32, variant: I32,
                               next: Fn [%mem.M 0, %gpu.GlobalM, %gpu.ConstM, I32] → [%mem.M 0, I32],
                               return: Cn [%mem.M 0, I32]] =
                let (m0, m1) = %gpu.copy_to_host.block (m0, m1, d_C, h_C);
                let (m0, result) = %mem.load (m0, %mem.lea (h_C, 1048575_1048576));
                let expected = %math.conv.u2f %math.f32 (%core.bitcast I32 K);
                ret (m0, scalar_status) = assert_close_scalar $ (m0, result, expected, 0.00001:%math.F64, 0.00000001:%math.F64);
                let actual_ptr = %core.bitcast (%mem.Ptr0 «⊤:Nat; %math.F32») h_C;
                let expected_ptr = %core.bitcast (%mem.Ptr0 «⊤:Nat; %math.F32») h_expected;
                ret (m0, memref_status) = assert_close $ (m0, %core.bitcast I32 MN, actual_ptr, expected_ptr,
                                                          0.00001:%math.F64, 0.00000001:%math.F64);
                let variant_status = %core.wrap.add 0 (scalar_status, memref_status);
                ret m0 = bench_print_gemm_verify $ (m0, variant, variant_status);
                let status = %core.wrap.add 0 (status_in, variant_status);
                ret (m0, status) = next $ (m0, m1, m4, status);
                return (m0, status);

            con run_bench [m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM,
                           status_in: I32, variant: I32,
                           launch: Fn [%mem.M 0, %gpu.GlobalM, %gpu.ConstM] → [%mem.M 0, %gpu.GlobalM, %gpu.ConstM],
                           next: Fn [%mem.M 0, %gpu.GlobalM, %gpu.ConstM, I32] → [%mem.M 0, I32],
                           return: Cn [%mem.M 0, I32]] =
                ret (m0, m1, m4) = launch $ (m0, m1, m4);
                let (m0, m1) = %gpu.stream_sync (m0, m1, %gpu.default_stream);
                bench_start (m0, after_start)
                where
                    con after_start [m0: %mem.M 0] =
                        con bench_body [i: I32,
                                        [m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM],
                                        continue: Cn [[%mem.M 0, %gpu.GlobalM, %gpu.ConstM]]] =
                            ret (m0, m1, m4) = launch $ (m0, m1, m4);
                            continue (m0, m1, m4);

                        con bench_exit [[m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM]] =
                            let (m0, m1) = %gpu.stream_sync (m0, m1, %gpu.default_stream);
                            bench_end (m0, variant, after_bench)
                            where
                                con after_bench [m0: %mem.M 0] =
                                    verify_result (m0, m1, m4, status_in, variant, next, return);
                            end;

                        %affine.For bench_body bench_exit (0I32, %core.bitcast I32 ITERS, 1I32, (m0, m1, m4));
                end;

            fun run_pipeline3 (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                run_bench (m0, m1, m4, status, 5I32, launch_pipeline3, cleanup, return);

            fun run_pipeline (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                run_bench (m0, m1, m4, status, 4I32, launch_pipeline, run_pipeline3, return);

            fun run_tvm (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                run_bench (m0, m1, m4, status, 3I32, launch_tvm, run_pipeline, return);

            fun run_double (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                run_bench (m0, m1, m4, status, 2I32, launch_double, run_tvm, return);

            fun run_tiled (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                run_bench (m0, m1, m4, status, 1I32, launch_tiled, run_double, return);

            fun run_naive (m0: %mem.M 0, m1: %gpu.GlobalM, m4: %gpu.ConstM, status: I32): [%mem.M 0, I32] =
                run_bench (m0, m1, m4, status, 0I32, launch_naive, run_tiled, return);

            ret (m0, status) = run_naive $ (m0, m1, m4, 0I32);
            return (m0, status);

            %affine.For init_expected_body init_expected_exit (0I32, %core.bitcast I32 MN, 1I32, (m0));

        %affine.For init_b_body init_b_exit (0I32, %core.bitcast I32 KN, 1I32, (m0));

    %affine.For init_a_body init_a_exit (0I32, %core.bitcast I32 MK, 1I32, (m0));

