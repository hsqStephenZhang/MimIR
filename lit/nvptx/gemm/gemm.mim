// REQUIRES: system-linux, cuda
// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p ll_nvptx -o -
// RUN: %FileCheck %s --check-prefix=DEV < %{s:stem}_dev.ll
// RUN: %FileCheck %s --check-prefix=HOST < %{s:stem}.ll
// RUN: rm -f %t
// RUN: clang %{s:stem}.ll %S/bench_lib.c -o %t -lcuda -lm -Wno-override-module
// RUN: %t; test $? -eq 0

plugin core;
plugin math;
plugin affine;
plugin gpu;

rec Timespec = [tv_sec: I64, tv_nsec: I64];

cfun clock_gettime [mem: %mem.M 0, clock_id: I32, ts: %mem.Ptr0 Timespec]: [%mem.M 0, I32];
cfun bench_print_gemm_header [mem: %mem.M 0,
                              m: I32,
                              n: I32,
                              k: I32]: %mem.M 0;
cfun bench_print_gemm_result [mem: %mem.M 0,
                              variant: I32,
                              avg_ms: %math.F64,
                              avg_ns: %math.F64,
                              total_ms: %math.F64,
                              iters: I32,
                              gflops: %math.F64]: %mem.M 0;
cfun bench_print_gemm_verify [mem: %mem.M 0, variant: I32, status: I32]: %mem.M 0;
cfun assert_close_scalar [mem: %mem.M 0,
                          actual: %math.F32,
                          expected: %math.F32,
                          rtol: %math.F64,
                          atol: %math.F64]: [%mem.M 0, I32];
cfun assert_close [mem: %mem.M 0,
                   n: I32,
                   actual: %mem.Ptr0 «⊤:Nat; %math.F32»,
                   expected: %mem.Ptr0 «⊤:Nat; %math.F32»,
                   rtol: %math.F64,
                   atol: %math.F64]: [%mem.M 0, I32];

let M = 1024;
let N = 1024;
let K = 1024;
let MN = 1048576;
let MK = 1048576;
let KN = 1048576;
let BLOCK_X = 16;
let BLOCK_Y = 16;
let TILE_ELEMS = 256;
let TILE_COUNT = 64;
let GRID_X = 64;
let GRID_Y = 64;
let TVM_GRID_X = 256;
let TVM_BLOCK_X = 64;
let TVM_SHARED_ELEMS = 512;
let TVM_LOCAL_ELEMS = 64;
let TVM_K_TILES = 128;
let ITERS = 10;
let CLOCK_MONOTONIC = 1I32;
let FP_CONTRACT = 16;

// C = A * B, row-major A[M,K], B[K,N], C[M,N].
con naive_gemm (m1: %gpu.GlobalM, m3: %gpu.SharedM, m4: %gpu.ConstM, m5: %gpu.LocalM,
                block_x: Idx GRID_X, block_y: Idx GRID_Y, block_z: Idx 1,
                thread_x: Idx BLOCK_X, thread_y: Idx BLOCK_Y, thread_z: Idx 1,
                (),
                (A: %gpu.GlobalPtr «MK; %math.F32»,
                 B: %gpu.GlobalPtr «KN; %math.F32»,
                 C: %gpu.GlobalPtr «MN; %math.F32»),
                return: Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM]) =
    let bx = %core.bitcast I32 block_x;
    let by = %core.bitcast I32 block_y;
    let tx = %core.bitcast I32 thread_x;
    let ty = %core.bitcast I32 thread_y;

    let row = %core.wrap.add 0 (%core.wrap.mul 0 (by, %core.bitcast I32 BLOCK_Y), ty);
    let col = %core.wrap.add 0 (%core.wrap.mul 0 (bx, %core.bitcast I32 BLOCK_X), tx);

    %affine.For dot_body dot_exit (0I32, %core.bitcast I32 K, 1I32, (m1, 0.0:%math.F32))
    where
        con dot_body [k: I32, [m1: %gpu.GlobalM, acc: %math.F32], continue: Cn [[%gpu.GlobalM, %math.F32]]] =
            let a_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 K), k);
            let b_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (k, %core.bitcast I32 N), col);
            let a_idx = %core.conv.u MK a_i32;
            let b_idx = %core.conv.u KN b_i32;
            let (m1, a_val) = %mem.load (m1, %mem.lea (A, a_idx));
            let (m1, b_val) = %mem.load (m1, %mem.lea (B, b_idx));
            let prod = %math.arith.mul FP_CONTRACT (a_val, b_val);
            let acc = %math.arith.add FP_CONTRACT (acc, prod);
            continue (m1, acc);

        con dot_exit [[m1: %gpu.GlobalM, sum: %math.F32]] =
            let c_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 N), col);
            let c_idx = %core.conv.u MN c_i32;
            let m1 = %mem.store (m1, %mem.lea (C, c_idx), sum);
            return (m1, m3, m4, m5);
    end;

// 16x16 shared-memory tiled GEMM.
con tiled_gemm_16x16 (m1: %gpu.GlobalM, m3: %gpu.SharedM, m4: %gpu.ConstM, m5: %gpu.LocalM,
                      block_x: Idx GRID_X, block_y: Idx GRID_Y, block_z: Idx 1,
                      thread_x: Idx BLOCK_X, thread_y: Idx BLOCK_Y, thread_z: Idx 1,
                      (),
                      (A: %gpu.GlobalPtr «MK; %math.F32»,
                       B: %gpu.GlobalPtr «KN; %math.F32»,
                       C: %gpu.GlobalPtr «MN; %math.F32»),
                      return: Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM]) =
    let (m3, s_A) = %mem.slot («TILE_ELEMS; %math.F32», 3) (m3, 0);
    let (m3, s_B) = %mem.slot («TILE_ELEMS; %math.F32», 3) (m3, 1);

    let bx = %core.bitcast I32 block_x;
    let by = %core.bitcast I32 block_y;
    let tx = %core.bitcast I32 thread_x;
    let ty = %core.bitcast I32 thread_y;

    let row = %core.wrap.add 0 (%core.wrap.mul 0 (by, %core.bitcast I32 BLOCK_Y), ty);
    let col = %core.wrap.add 0 (%core.wrap.mul 0 (bx, %core.bitcast I32 BLOCK_X), tx);
    let shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (ty, %core.bitcast I32 BLOCK_X), tx);
    let shared_idx = %core.conv.u TILE_ELEMS shared_i32;

    %affine.For tile_body tile_exit (0I32, %core.bitcast I32 TILE_COUNT, 1I32, (m1, m3, 0.0:%math.F32))
    where
        con tile_body [t: I32, [m1: %gpu.GlobalM, m3: %gpu.SharedM, acc: %math.F32],
                       continue: Cn [[%gpu.GlobalM, %gpu.SharedM, %math.F32]]] =
            let tile_k = %core.wrap.mul 0 (t, %core.bitcast I32 BLOCK_X);

            let a_col = %core.wrap.add 0 (tile_k, tx);
            let b_row = %core.wrap.add 0 (tile_k, ty);
            let a_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 K), a_col);
            let b_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (b_row, %core.bitcast I32 N), col);
            let a_idx = %core.conv.u MK a_i32;
            let b_idx = %core.conv.u KN b_i32;
            let (m1, a_val) = %mem.load (m1, %mem.lea (A, a_idx));
            let (m1, b_val) = %mem.load (m1, %mem.lea (B, b_idx));
            let m3 = %mem.store (m3, %mem.lea (s_A, shared_idx), a_val);
            let m3 = %mem.store (m3, %mem.lea (s_B, shared_idx), b_val);
            let (m1, m3) = %gpu.sync_work_items (m1, m3);

            %affine.For dot_body dot_exit (0I32, %core.bitcast I32 BLOCK_X, 1I32, (m3, acc))
            where
                con dot_body [k_inner: I32, [m3: %gpu.SharedM, acc: %math.F32],
                              dot_continue: Cn [[%gpu.SharedM, %math.F32]]] =
                    let a_shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (ty, %core.bitcast I32 BLOCK_X), k_inner);
                    let b_shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (k_inner, %core.bitcast I32 BLOCK_X), tx);
                    let a_shared_idx = %core.conv.u TILE_ELEMS a_shared_i32;
                    let b_shared_idx = %core.conv.u TILE_ELEMS b_shared_i32;
                    let (m3, a_shared) = %mem.load (m3, %mem.lea (s_A, a_shared_idx));
                    let (m3, b_shared) = %mem.load (m3, %mem.lea (s_B, b_shared_idx));
                    let prod = %math.arith.mul FP_CONTRACT (a_shared, b_shared);
                    let acc = %math.arith.add FP_CONTRACT (acc, prod);
                    dot_continue (m3, acc);

                con dot_exit [[m3: %gpu.SharedM, acc: %math.F32]] =
                    let (m1, m3) = %gpu.sync_work_items (m1, m3);
                    continue (m1, m3, acc);
            end;

        con tile_exit [[m1: %gpu.GlobalM, m3: %gpu.SharedM, sum: %math.F32]] =
            let c_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 N), col);
            let c_idx = %core.conv.u MN c_i32;
            let m1 = %mem.store (m1, %mem.lea (C, c_idx), sum);
            return (m1, m3, m4, m5);
    end;

// Two shared-memory tile buffers. Each loop iteration loads and computes two K tiles.
con tiled_gemm_double_buffer (m1: %gpu.GlobalM, m3: %gpu.SharedM, m4: %gpu.ConstM, m5: %gpu.LocalM,
                              block_x: Idx GRID_X, block_y: Idx GRID_Y, block_z: Idx 1,
                              thread_x: Idx BLOCK_X, thread_y: Idx BLOCK_Y, thread_z: Idx 1,
                              (),
                              (A: %gpu.GlobalPtr «MK; %math.F32»,
                               B: %gpu.GlobalPtr «KN; %math.F32»,
                               C: %gpu.GlobalPtr «MN; %math.F32»),
                              return: Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM]) =
    let (m3, s_A) = %mem.slot («512; %math.F32», 3) (m3, 0);
    let (m3, s_B) = %mem.slot («512; %math.F32», 3) (m3, 1);

    let bx = %core.bitcast I32 block_x;
    let by = %core.bitcast I32 block_y;
    let tx = %core.bitcast I32 thread_x;
    let ty = %core.bitcast I32 thread_y;

    let row = %core.wrap.add 0 (%core.wrap.mul 0 (by, %core.bitcast I32 BLOCK_Y), ty);
    let col = %core.wrap.add 0 (%core.wrap.mul 0 (bx, %core.bitcast I32 BLOCK_X), tx);
    let shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (ty, %core.bitcast I32 BLOCK_X), tx);

    %affine.For pair_body pair_exit (0I32, 32I32, 1I32, (m1, m3, 0.0:%math.F32))
    where
        con pair_body [pair: I32, [m1: %gpu.GlobalM, m3: %gpu.SharedM, acc: %math.F32],
                       continue: Cn [[%gpu.GlobalM, %gpu.SharedM, %math.F32]]] =
            let first_tile = %core.wrap.mul 0 (pair, 2I32);
            let second_tile = %core.wrap.add 0 (first_tile, 1I32);
            let first_k = %core.wrap.mul 0 (first_tile, %core.bitcast I32 BLOCK_X);
            let second_k = %core.wrap.mul 0 (second_tile, %core.bitcast I32 BLOCK_X);

            let a0_col = %core.wrap.add 0 (first_k, tx);
            let b0_row = %core.wrap.add 0 (first_k, ty);
            let a1_col = %core.wrap.add 0 (second_k, tx);
            let b1_row = %core.wrap.add 0 (second_k, ty);
            let a0_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 K), a0_col);
            let b0_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (b0_row, %core.bitcast I32 N), col);
            let a1_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 K), a1_col);
            let b1_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (b1_row, %core.bitcast I32 N), col);
            let (m1, a0) = %mem.load (m1, %mem.lea (A, %core.conv.u MK a0_i32));
            let (m1, b0) = %mem.load (m1, %mem.lea (B, %core.conv.u KN b0_i32));
            let (m1, a1) = %mem.load (m1, %mem.lea (A, %core.conv.u MK a1_i32));
            let (m1, b1) = %mem.load (m1, %mem.lea (B, %core.conv.u KN b1_i32));
            let idx0 = %core.conv.u 512 shared_i32;
            let idx1 = %core.conv.u 512 (%core.wrap.add 0 (shared_i32, %core.bitcast I32 TILE_ELEMS));
            let m3 = %mem.store (m3, %mem.lea (s_A, idx0), a0);
            let m3 = %mem.store (m3, %mem.lea (s_B, idx0), b0);
            let m3 = %mem.store (m3, %mem.lea (s_A, idx1), a1);
            let m3 = %mem.store (m3, %mem.lea (s_B, idx1), b1);
            let (m1, m3) = %gpu.sync_work_items (m1, m3);

            %affine.For dot0_body dot0_exit (0I32, %core.bitcast I32 BLOCK_X, 1I32, (m3, acc))
            where
                con dot0_body [k_inner: I32, [m3: %gpu.SharedM, acc: %math.F32],
                               dot_continue: Cn [[%gpu.SharedM, %math.F32]]] =
                    let a_shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (ty, %core.bitcast I32 BLOCK_X), k_inner);
                    let b_shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (k_inner, %core.bitcast I32 BLOCK_X), tx);
                    let (m3, a_shared) = %mem.load (m3, %mem.lea (s_A, %core.conv.u 512 a_shared_i32));
                    let (m3, b_shared) = %mem.load (m3, %mem.lea (s_B, %core.conv.u 512 b_shared_i32));
                    let acc = %math.arith.add FP_CONTRACT (acc, %math.arith.mul FP_CONTRACT (a_shared, b_shared));
                    dot_continue (m3, acc);

                con dot0_exit [[m3: %gpu.SharedM, acc: %math.F32]] =
                    %affine.For dot1_body dot1_exit (0I32, %core.bitcast I32 BLOCK_X, 1I32, (m3, acc))
                    where
                        con dot1_body [k_inner: I32, [m3: %gpu.SharedM, acc: %math.F32],
                                       dot_continue: Cn [[%gpu.SharedM, %math.F32]]] =
                            let base = %core.bitcast I32 TILE_ELEMS;
                            let a_shared_i32 = %core.wrap.add 0 (base, %core.wrap.add 0 (%core.wrap.mul 0 (ty, %core.bitcast I32 BLOCK_X), k_inner));
                            let b_shared_i32 = %core.wrap.add 0 (base, %core.wrap.add 0 (%core.wrap.mul 0 (k_inner, %core.bitcast I32 BLOCK_X), tx));
                            let (m3, a_shared) = %mem.load (m3, %mem.lea (s_A, %core.conv.u 512 a_shared_i32));
                            let (m3, b_shared) = %mem.load (m3, %mem.lea (s_B, %core.conv.u 512 b_shared_i32));
                            let acc = %math.arith.add FP_CONTRACT (acc, %math.arith.mul FP_CONTRACT (a_shared, b_shared));
                            dot_continue (m3, acc);

                        con dot1_exit [[m3: %gpu.SharedM, acc: %math.F32]] =
                            let (m1, m3) = %gpu.sync_work_items (m1, m3);
                            continue (m1, m3, acc);
                    end;
            end;

        con pair_exit [[m1: %gpu.GlobalM, m3: %gpu.SharedM, sum: %math.F32]] =
            let c_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (row, %core.bitcast I32 N), col);
            let c_idx = %core.conv.u MN c_i32;
            let m1 = %mem.store (m1, %mem.lea (C, c_idx), sum);
            return (m1, m3, m4, m5);
    end;

// TVM-exported style: one 64x64 output tile per block, 64 threads per block,
// each thread accumulates four 4x4 output groups in local memory.
con tvm_style_gemm (m1: %gpu.GlobalM, m3: %gpu.SharedM, m4: %gpu.ConstM, m5: %gpu.LocalM,
                    block_x: Idx TVM_GRID_X, block_y: Idx 1, block_z: Idx 1,
                    thread_x: Idx TVM_BLOCK_X, thread_y: Idx 1, thread_z: Idx 1,
                    (),
                    (A: %gpu.GlobalPtr «MK; %math.F32»,
                     B: %gpu.GlobalPtr «KN; %math.F32»,
                     C: %gpu.GlobalPtr «MN; %math.F32»),
                    return: Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM]) =
    let (m3, A_shared) = %mem.slot («TVM_SHARED_ELEMS; %math.F32», 3) (m3, 0);
    let (m3, B_shared) = %mem.slot («TVM_SHARED_ELEMS; %math.F32», 3) (m3, 1);
    let (m5, C_local) = %mem.slot («TVM_LOCAL_ELEMS; %math.F32», 5) (m5, 0);

    let bx = %core.bitcast I32 block_x;
    let tid = %core.bitcast I32 thread_x;
    let block_tile_row = %core.shr.l (bx, 4I32);
    let block_tile_col = %core.bit2.and_ 0 (bx, 15I32);
    let block_row = %core.wrap.mul 0 (block_tile_row, 64I32);
    let block_col = %core.wrap.mul 0 (block_tile_col, 64I32);
    let thread_group = %core.shr.l (tid, 4I32);
    let thread_lane = %core.bit2.and_ 0 (tid, 15I32);
    let thread_row_base = %core.wrap.mul 0 (thread_group, 4I32);
    let thread_col_base = %core.wrap.mul 0 (thread_lane, 4I32);

    %affine.For init_body init_exit (0I32, %core.bitcast I32 TVM_LOCAL_ELEMS, 1I32, (m5))
    where
        con init_body [i: I32, [m5: %gpu.LocalM], continue: Cn [[%gpu.LocalM]]] =
            let m5 = %mem.store (m5, %mem.lea (C_local, %core.conv.u TVM_LOCAL_ELEMS i), 0.0:%math.F32);
            continue m5;

        con init_exit [[m5: %gpu.LocalM]] =
            %affine.For tile_body tile_exit (0I32, %core.bitcast I32 TVM_K_TILES, 1I32, (m1, m3, m5))
            where
                con tile_body [ktile: I32, [m1: %gpu.GlobalM, m3: %gpu.SharedM, m5: %gpu.LocalM],
                               continue: Cn [[%gpu.GlobalM, %gpu.SharedM, %gpu.LocalM]]] =
                    let (m1, m3) = %gpu.sync_work_items (m1, m3);

                    %affine.For load_body load_exit (0I32, 8I32, 1I32, (m1, m3))
                    where
                        con load_body [load: I32, [m1: %gpu.GlobalM, m3: %gpu.SharedM],
                                       load_continue: Cn [[%gpu.GlobalM, %gpu.SharedM]]] =
                            let shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (tid, 8I32), load);
                            let shared_idx = %core.conv.u TVM_SHARED_ELEMS shared_i32;

                            let a_row = %core.wrap.add 0 (block_row, %core.shr.l (shared_i32, 3I32));
                            let a_k = %core.wrap.add 0 (%core.wrap.mul 0 (ktile, 8I32), %core.bit2.and_ 0 (shared_i32, 7I32));
                            let a_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (a_row, %core.bitcast I32 K), a_k);
                            let (m1, a_val) = %mem.load (m1, %mem.lea (A, %core.conv.u MK a_i32));
                            let m3 = %mem.store (m3, %mem.lea (A_shared, shared_idx), a_val);

                            let b_k = %core.wrap.add 0 (%core.wrap.mul 0 (ktile, 8I32), %core.shr.l (shared_i32, 6I32));
                            let b_col = %core.wrap.add 0 (block_col, %core.bit2.and_ 0 (shared_i32, 63I32));
                            let b_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (b_k, %core.bitcast I32 N), b_col);
                            let (m1, b_val) = %mem.load (m1, %mem.lea (B, %core.conv.u KN b_i32));
                            let m3 = %mem.store (m3, %mem.lea (B_shared, shared_idx), b_val);
                            load_continue (m1, m3);

                        con load_exit [[m1: %gpu.GlobalM, m3: %gpu.SharedM]] =
                            let (m1, m3) = %gpu.sync_work_items (m1, m3);

                            %affine.For group_body group_exit (0I32, 4I32, 1I32, (m3, m5))
                            where
                                con group_body [group: I32, [m3: %gpu.SharedM, m5: %gpu.LocalM],
                                                group_continue: Cn [[%gpu.SharedM, %gpu.LocalM]]] =
                                    %affine.For row_body row_exit (0I32, 4I32, 1I32, (m3, m5))
                                    where
                                        con row_body [row_inner: I32, [m3: %gpu.SharedM, m5: %gpu.LocalM],
                                                      row_continue: Cn [[%gpu.SharedM, %gpu.LocalM]]] =
                                            %affine.For col_body col_exit (0I32, 4I32, 1I32, (m3, m5))
                                            where
                                                con col_body [col_inner: I32, [m3: %gpu.SharedM, m5: %gpu.LocalM],
                                                              col_continue: Cn [[%gpu.SharedM, %gpu.LocalM]]] =
                                                    let local_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (group, 16I32),
                                                        %core.wrap.add 0 (%core.wrap.mul 0 (row_inner, 4I32), col_inner));
                                                    let local_idx = %core.conv.u TVM_LOCAL_ELEMS local_i32;
                                                    let (m5, acc0) = %mem.load (m5, %mem.lea (C_local, local_idx));

                                                    %affine.For kk_body kk_exit (0I32, 8I32, 1I32, (m3, acc0))
                                                    where
                                                        con kk_body [kk: I32, [m3: %gpu.SharedM, acc: %math.F32],
                                                                     kk_continue: Cn [[%gpu.SharedM, %math.F32]]] =
                                                            let a_local_row = %core.wrap.add 0 (%core.wrap.mul 0 (group, 16I32),
                                                                %core.wrap.add 0 (thread_row_base, row_inner));
                                                            let a_shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (a_local_row, 8I32), kk);
                                                            let b_local_col = %core.wrap.add 0 (thread_col_base, col_inner);
                                                            let b_shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (kk, 64I32), b_local_col);
                                                            let (m3, a_val) = %mem.load (m3, %mem.lea (A_shared, %core.conv.u TVM_SHARED_ELEMS a_shared_i32));
                                                            let (m3, b_val) = %mem.load (m3, %mem.lea (B_shared, %core.conv.u TVM_SHARED_ELEMS b_shared_i32));
                                                            let acc = %math.arith.add FP_CONTRACT (acc, %math.arith.mul FP_CONTRACT (a_val, b_val));
                                                            kk_continue (m3, acc);

                                                        con kk_exit [[m3: %gpu.SharedM, acc: %math.F32]] =
                                                            let m5 = %mem.store (m5, %mem.lea (C_local, local_idx), acc);
                                                            col_continue (m3, m5);
                                                    end;

                                                con col_exit [[m3: %gpu.SharedM, m5: %gpu.LocalM]] =
                                                    row_continue (m3, m5);
                                            end;

                                        con row_exit [[m3: %gpu.SharedM, m5: %gpu.LocalM]] =
                                            group_continue (m3, m5);
                                    end;

                                con group_exit [[m3: %gpu.SharedM, m5: %gpu.LocalM]] =
                                    continue (m1, m3, m5);
                            end;
                    end;

                con tile_exit [[m1: %gpu.GlobalM, m3: %gpu.SharedM, m5: %gpu.LocalM]] =
                    %affine.For store_group_body store_group_exit (0I32, 4I32, 1I32, (m1, m5))
                    where
                        con store_group_body [group: I32, [m1: %gpu.GlobalM, m5: %gpu.LocalM],
                                              group_continue: Cn [[%gpu.GlobalM, %gpu.LocalM]]] =
                            %affine.For store_row_body store_row_exit (0I32, 4I32, 1I32, (m1, m5))
                            where
                                con store_row_body [row_inner: I32, [m1: %gpu.GlobalM, m5: %gpu.LocalM],
                                                    row_continue: Cn [[%gpu.GlobalM, %gpu.LocalM]]] =
                                    %affine.For store_col_body store_col_exit (0I32, 4I32, 1I32, (m1, m5))
                                    where
                                        con store_col_body [col_inner: I32, [m1: %gpu.GlobalM, m5: %gpu.LocalM],
                                                           col_continue: Cn [[%gpu.GlobalM, %gpu.LocalM]]] =
                                            let local_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (group, 16I32),
                                                %core.wrap.add 0 (%core.wrap.mul 0 (row_inner, 4I32), col_inner));
                                            let (m5, value) = %mem.load (m5, %mem.lea (C_local, %core.conv.u TVM_LOCAL_ELEMS local_i32));
                                            let global_row = %core.wrap.add 0 (block_row,
                                                %core.wrap.add 0 (%core.wrap.mul 0 (group, 16I32),
                                                    %core.wrap.add 0 (thread_row_base, row_inner)));
                                            let global_col = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, col_inner));
                                            let c_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row, %core.bitcast I32 N), global_col);
                                            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32), value);
                                            col_continue (m1, m5);

                                        con store_col_exit [[m1: %gpu.GlobalM, m5: %gpu.LocalM]] =
                                            row_continue (m1, m5);
                                    end;

                                con store_row_exit [[m1: %gpu.GlobalM, m5: %gpu.LocalM]] =
                                    group_continue (m1, m5);
                            end;

                        con store_group_exit [[m1: %gpu.GlobalM, m5: %gpu.LocalM]] =
                            return (m1, m3, m4, m5);
                    end;
            end;
    end;

// TVM-exported style with scalar SSA accumulators. This mirrors the CUDA
// front-end shape where C_local is promoted to registers instead of local memory.
con tvm_style_gemm_scalar (m1: %gpu.GlobalM, m3: %gpu.SharedM, m4: %gpu.ConstM, m5: %gpu.LocalM,
                           block_x: Idx TVM_GRID_X, block_y: Idx 1, block_z: Idx 1,
                           thread_x: Idx TVM_BLOCK_X, thread_y: Idx 1, thread_z: Idx 1,
                           (),
                           (A: %gpu.GlobalPtr «MK; %math.F32»,
                            B: %gpu.GlobalPtr «KN; %math.F32»,
                            C: %gpu.GlobalPtr «MN; %math.F32»),
                           return: Cn [%gpu.GlobalM, %gpu.SharedM, %gpu.ConstM, %gpu.LocalM]) =
    let (m3, A_shared) = %mem.slot («TVM_SHARED_ELEMS; %math.F32», 3) (m3, 0);
    let (m3, B_shared) = %mem.slot («TVM_SHARED_ELEMS; %math.F32», 3) (m3, 1);

    let bx = %core.bitcast I32 block_x;
    let tid = %core.bitcast I32 thread_x;
    let block_tile_row = %core.shr.l (bx, 4I32);
    let block_tile_col = %core.bit2.and_ 0 (bx, 15I32);
    let block_row = %core.wrap.mul 0 (block_tile_row, 64I32);
    let block_col = %core.wrap.mul 0 (block_tile_col, 64I32);
    let thread_group = %core.shr.l (tid, 4I32);
    let thread_lane = %core.bit2.and_ 0 (tid, 15I32);
    let thread_row_base = %core.wrap.mul 0 (thread_group, 4I32);
    let thread_col_base = %core.wrap.mul 0 (thread_lane, 4I32);

    fun load_tvm_tile_vectorized (ktile: I32, m1: %gpu.GlobalM, m3: %gpu.SharedM): [%gpu.GlobalM, %gpu.SharedM] =
        let a_row0 = %core.wrap.add 0 (block_row, %core.shr.l (tid, 1I32));
        let a_k0 = %core.wrap.add 0 (%core.wrap.mul 0 (ktile, 8I32), %core.wrap.mul 0 (%core.bit2.and_ 0 (tid, 1I32), 4I32));
        let a_src0_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (a_row0, %core.bitcast I32 K), a_k0);
        let a_src1_i32 = %core.wrap.add 0 (a_src0_i32, %core.wrap.mul 0 (32I32, %core.bitcast I32 K));
        let a_dst0_i32 = %core.wrap.mul 0 (tid, 4I32);
        let a_dst1_i32 = %core.wrap.add 0 (a_dst0_i32, 256I32);

        let a_src0 = %core.bitcast (%gpu.GlobalPtr «4; %math.F32») (%mem.lea (A, %core.conv.u MK a_src0_i32));
        let a_src1 = %core.bitcast (%gpu.GlobalPtr «4; %math.F32») (%mem.lea (A, %core.conv.u MK a_src1_i32));
        let a_dst0 = %core.bitcast (%gpu.SharedPtr «4; %math.F32») (%mem.lea (A_shared, %core.conv.u TVM_SHARED_ELEMS a_dst0_i32));
        let a_dst1 = %core.bitcast (%gpu.SharedPtr «4; %math.F32») (%mem.lea (A_shared, %core.conv.u TVM_SHARED_ELEMS a_dst1_i32));
        let (m1, a_vec0) = %mem.load (m1, a_src0);
        let (m1, a_vec1) = %mem.load (m1, a_src1);
        let m3 = %mem.store (m3, a_dst0, a_vec0);
        let m3 = %mem.store (m3, a_dst1, a_vec1);

        let b_k0 = %core.wrap.add 0 (%core.wrap.mul 0 (ktile, 8I32), %core.shr.l (tid, 5I32));
        let b_col0 = %core.wrap.add 0 (block_col, %core.wrap.mul 0 (%core.bit2.and_ 0 (tid, 31I32), 2I32));
        let b_src0_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (b_k0, %core.bitcast I32 N), b_col0);
        let b_src1_i32 = %core.wrap.add 0 (b_src0_i32, %core.wrap.mul 0 (2I32, %core.bitcast I32 N));
        let b_src2_i32 = %core.wrap.add 0 (b_src0_i32, %core.wrap.mul 0 (4I32, %core.bitcast I32 N));
        let b_src3_i32 = %core.wrap.add 0 (b_src0_i32, %core.wrap.mul 0 (6I32, %core.bitcast I32 N));
        let b_dst0_i32 = %core.wrap.mul 0 (tid, 2I32);
        let b_dst1_i32 = %core.wrap.add 0 (b_dst0_i32, 128I32);
        let b_dst2_i32 = %core.wrap.add 0 (b_dst0_i32, 256I32);
        let b_dst3_i32 = %core.wrap.add 0 (b_dst0_i32, 384I32);

        let b_src0 = %core.bitcast (%gpu.GlobalPtr «2; %math.F32») (%mem.lea (B, %core.conv.u KN b_src0_i32));
        let b_src1 = %core.bitcast (%gpu.GlobalPtr «2; %math.F32») (%mem.lea (B, %core.conv.u KN b_src1_i32));
        let b_src2 = %core.bitcast (%gpu.GlobalPtr «2; %math.F32») (%mem.lea (B, %core.conv.u KN b_src2_i32));
        let b_src3 = %core.bitcast (%gpu.GlobalPtr «2; %math.F32») (%mem.lea (B, %core.conv.u KN b_src3_i32));
        let b_dst0 = %core.bitcast (%gpu.SharedPtr «2; %math.F32») (%mem.lea (B_shared, %core.conv.u TVM_SHARED_ELEMS b_dst0_i32));
        let b_dst1 = %core.bitcast (%gpu.SharedPtr «2; %math.F32») (%mem.lea (B_shared, %core.conv.u TVM_SHARED_ELEMS b_dst1_i32));
        let b_dst2 = %core.bitcast (%gpu.SharedPtr «2; %math.F32») (%mem.lea (B_shared, %core.conv.u TVM_SHARED_ELEMS b_dst2_i32));
        let b_dst3 = %core.bitcast (%gpu.SharedPtr «2; %math.F32») (%mem.lea (B_shared, %core.conv.u TVM_SHARED_ELEMS b_dst3_i32));
        let (m1, b_vec0) = %mem.load (m1, b_src0);
        let (m1, b_vec1) = %mem.load (m1, b_src1);
        let (m1, b_vec2) = %mem.load (m1, b_src2);
        let (m1, b_vec3) = %mem.load (m1, b_src3);
        let m3 = %mem.store (m3, b_dst0, b_vec0);
        let m3 = %mem.store (m3, b_dst1, b_vec1);
        let m3 = %mem.store (m3, b_dst2, b_vec2);
        let m3 = %mem.store (m3, b_dst3, b_vec3);
        return (m1, m3);

    fun load_tvm_tile_scalar (ktile: I32, m1: %gpu.GlobalM, m3: %gpu.SharedM): [%gpu.GlobalM, %gpu.SharedM] =
        %affine.For load_body load_exit (0I32, 8I32, 1I32, (m1, m3))
        where
            con load_body [load: I32, [m1: %gpu.GlobalM, m3: %gpu.SharedM],
                           load_continue: Cn [[%gpu.GlobalM, %gpu.SharedM]]] =
                let shared_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (tid, 8I32), load);
                let shared_idx = %core.conv.u TVM_SHARED_ELEMS shared_i32;

                let a_row = %core.wrap.add 0 (block_row, %core.shr.l (shared_i32, 3I32));
                let a_k = %core.wrap.add 0 (%core.wrap.mul 0 (ktile, 8I32), %core.bit2.and_ 0 (shared_i32, 7I32));
                let a_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (a_row, %core.bitcast I32 K), a_k);
                let (m1, a_val) = %mem.load (m1, %mem.lea (A, %core.conv.u MK a_i32));
                let m3 = %mem.store (m3, %mem.lea (A_shared, shared_idx), a_val);

                let b_k = %core.wrap.add 0 (%core.wrap.mul 0 (ktile, 8I32), %core.shr.l (shared_i32, 6I32));
                let b_col = %core.wrap.add 0 (block_col, %core.bit2.and_ 0 (shared_i32, 63I32));
                let b_i32 = %core.wrap.add 0 (%core.wrap.mul 0 (b_k, %core.bitcast I32 N), b_col);
                let (m1, b_val) = %mem.load (m1, %mem.lea (B, %core.conv.u KN b_i32));
                let m3 = %mem.store (m3, %mem.lea (B_shared, shared_idx), b_val);
                load_continue (m1, m3);

            con load_exit [[m1: %gpu.GlobalM, m3: %gpu.SharedM]] =
                return (m1, m3);
        end;

    fun update_acc_scalar (group: I32, row_inner: I32, col_inner: I32,
                           m3: %gpu.SharedM, acc0: %math.F32): [%gpu.SharedM, %math.F32] =
        %affine.For rv_body rv_exit (0I32, 2I32, 1I32, (m3, acc0))
        where
            con rv_body [rv_1: I32, [m3: %gpu.SharedM, acc0: %math.F32],
                         rv_continue: Cn [[%gpu.SharedM, %math.F32]]] =
                let a_base = %core.wrap.add 0 (
                    %core.wrap.mul 0 (
                        %core.wrap.add 0 (%core.wrap.mul 0 (group, 16I32), thread_row_base),
                        8I32),
                    %core.wrap.mul 0 (rv_1, 4I32));
                let b_base = %core.wrap.add 0 (%core.wrap.mul 0 (%core.wrap.mul 0 (rv_1, 4I32), 64I32), thread_col_base);

                %affine.For kk_body kk_exit (0I32, 4I32, 1I32, (m3, acc0))
                where
                    con kk_body [kk: I32, [m3: %gpu.SharedM, acc: %math.F32],
                                 kk_continue: Cn [[%gpu.SharedM, %math.F32]]] =
                        let a_shared_i32 = %core.wrap.add 0 (a_base, %core.wrap.add 0 (%core.wrap.mul 0 (row_inner, 8I32), kk));
                        let b_shared_i32 = %core.wrap.add 0 (b_base, %core.wrap.add 0 (%core.wrap.mul 0 (kk, 64I32), col_inner));
                        let (m3, a_val) = %mem.load (m3, %mem.lea (A_shared, %core.conv.u TVM_SHARED_ELEMS a_shared_i32));
                        let (m3, b_val) = %mem.load (m3, %mem.lea (B_shared, %core.conv.u TVM_SHARED_ELEMS b_shared_i32));
                        let acc = %math.arith.add FP_CONTRACT (acc, %math.arith.mul FP_CONTRACT (a_val, b_val));
                        kk_continue (m3, acc);

                    con kk_exit [[m3: %gpu.SharedM, acc: %math.F32]] =
                        rv_continue (m3, acc);
                end;

            con rv_exit [[m3: %gpu.SharedM, acc: %math.F32]] =
                return (m3, acc);
        end;

    fun compute_tvm_row (group: I32, row_inner: I32, m3: %gpu.SharedM,
                         c0: %math.F32, c1: %math.F32, c2: %math.F32, c3: %math.F32)
                      : [%gpu.SharedM, %math.F32, %math.F32, %math.F32, %math.F32] =
        %affine.unroll col_body col_exit (0I32, 4I32, 1I32, (m3, (c0, c1, c2, c3)))
        where
            con col_body [col_inner: I32, [m3: %gpu.SharedM, cs: [%math.F32, %math.F32, %math.F32, %math.F32]],
                          col_continue: Cn [[%gpu.SharedM, [%math.F32, %math.F32, %math.F32, %math.F32]]]] =
                let col_idx = %core.bitcast (Idx 4) col_inner;
                let acc0 = cs#col_idx;
                ret (m3, acc) = update_acc_scalar $ (group, row_inner, col_inner, m3, acc0);
                let cs = ins(cs, col_idx, acc);
                col_continue (m3, cs);

            con col_exit [[m3: %gpu.SharedM, cs: [%math.F32, %math.F32, %math.F32, %math.F32]]] =
                return (m3, cs#(0_4), cs#(1_4), cs#(2_4), cs#(3_4));
        end;

    fun compute_tvm_group (group: I32, m3: %gpu.SharedM,
                           c00: %math.F32, c01: %math.F32, c02: %math.F32, c03: %math.F32,
                           c10: %math.F32, c11: %math.F32, c12: %math.F32, c13: %math.F32,
                           c20: %math.F32, c21: %math.F32, c22: %math.F32, c23: %math.F32,
                           c30: %math.F32, c31: %math.F32, c32: %math.F32, c33: %math.F32)
                        : [%gpu.SharedM, %math.F32, %math.F32, %math.F32, %math.F32,
                          %math.F32, %math.F32, %math.F32, %math.F32,
                          %math.F32, %math.F32, %math.F32, %math.F32,
                          %math.F32, %math.F32, %math.F32, %math.F32] =
        %affine.unroll row_body row_exit (0I32, 4I32, 1I32,
            (m3, (c00, c01, c02, c03, c10, c11, c12, c13,
                  c20, c21, c22, c23, c30, c31, c32, c33)))
        where
            con row_body [row_inner: I32,
                          [m3: %gpu.SharedM,
                           cs: [%math.F32, %math.F32, %math.F32, %math.F32,
                                %math.F32, %math.F32, %math.F32, %math.F32,
                                %math.F32, %math.F32, %math.F32, %math.F32,
                                %math.F32, %math.F32, %math.F32, %math.F32]],
                          row_continue: Cn [[%gpu.SharedM,
                                             [%math.F32, %math.F32, %math.F32, %math.F32,
                                              %math.F32, %math.F32, %math.F32, %math.F32,
                                              %math.F32, %math.F32, %math.F32, %math.F32,
                                              %math.F32, %math.F32, %math.F32, %math.F32]]]] =
                let base_i32 = %core.wrap.mul 0 (row_inner, 4I32);
                let idx0 = %core.bitcast (Idx 16) base_i32;
                let idx1 = %core.bitcast (Idx 16) (%core.wrap.add 0 (base_i32, 1I32));
                let idx2 = %core.bitcast (Idx 16) (%core.wrap.add 0 (base_i32, 2I32));
                let idx3 = %core.bitcast (Idx 16) (%core.wrap.add 0 (base_i32, 3I32));
                ret (m3, c0, c1, c2, c3) = compute_tvm_row $ (group, row_inner, m3, cs#idx0, cs#idx1, cs#idx2, cs#idx3);
                let cs = ins(cs, idx0, c0);
                let cs = ins(cs, idx1, c1);
                let cs = ins(cs, idx2, c2);
                let cs = ins(cs, idx3, c3);
                row_continue (m3, cs);

            con row_exit [[m3: %gpu.SharedM,
                           cs: [%math.F32, %math.F32, %math.F32, %math.F32,
                                %math.F32, %math.F32, %math.F32, %math.F32,
                                %math.F32, %math.F32, %math.F32, %math.F32,
                                %math.F32, %math.F32, %math.F32, %math.F32]]] =
                return (m3, cs#(0_16), cs#(1_16), cs#(2_16), cs#(3_16),
                        cs#(4_16), cs#(5_16), cs#(6_16), cs#(7_16),
                        cs#(8_16), cs#(9_16), cs#(10_16), cs#(11_16),
                        cs#(12_16), cs#(13_16), cs#(14_16), cs#(15_16));
        end;

    fun compute_tvm_tile (m3: %gpu.SharedM,
                          c0: %math.F32, c1: %math.F32, c2: %math.F32, c3: %math.F32,
                          c4: %math.F32, c5: %math.F32, c6: %math.F32, c7: %math.F32,
                          c8: %math.F32, c9: %math.F32, c10: %math.F32, c11: %math.F32,
                          c12: %math.F32, c13: %math.F32, c14: %math.F32, c15: %math.F32,
                          c16: %math.F32, c17: %math.F32, c18: %math.F32, c19: %math.F32,
                          c20: %math.F32, c21: %math.F32, c22: %math.F32, c23: %math.F32,
                          c24: %math.F32, c25: %math.F32, c26: %math.F32, c27: %math.F32,
                          c28: %math.F32, c29: %math.F32, c30: %math.F32, c31: %math.F32,
                          c32: %math.F32, c33: %math.F32, c34: %math.F32, c35: %math.F32,
                          c36: %math.F32, c37: %math.F32, c38: %math.F32, c39: %math.F32,
                          c40: %math.F32, c41: %math.F32, c42: %math.F32, c43: %math.F32,
                          c44: %math.F32, c45: %math.F32, c46: %math.F32, c47: %math.F32,
                          c48: %math.F32, c49: %math.F32, c50: %math.F32, c51: %math.F32,
                          c52: %math.F32, c53: %math.F32, c54: %math.F32, c55: %math.F32,
                          c56: %math.F32, c57: %math.F32, c58: %math.F32, c59: %math.F32,
                          c60: %math.F32, c61: %math.F32, c62: %math.F32, c63: %math.F32)
                       : [%gpu.SharedM,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
                         %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32] =
        ret (m3, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15) =
            compute_tvm_group $ (0I32, m3, c0, c1, c2, c3, c4, c5, c6, c7,
                                 c8, c9, c10, c11, c12, c13, c14, c15);
        ret (m3, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31) =
            compute_tvm_group $ (1I32, m3, c16, c17, c18, c19, c20, c21, c22, c23,
                                 c24, c25, c26, c27, c28, c29, c30, c31);
        ret (m3, c32, c33, c34, c35, c36, c37, c38, c39, c40, c41, c42, c43, c44, c45, c46, c47) =
            compute_tvm_group $ (2I32, m3, c32, c33, c34, c35, c36, c37, c38, c39,
                                 c40, c41, c42, c43, c44, c45, c46, c47);
        ret (m3, c48, c49, c50, c51, c52, c53, c54, c55, c56, c57, c58, c59, c60, c61, c62, c63) =
            compute_tvm_group $ (3I32, m3, c48, c49, c50, c51, c52, c53, c54, c55,
                                 c56, c57, c58, c59, c60, c61, c62, c63);
        return (m3, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15,
                c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31,
                c32, c33, c34, c35, c36, c37, c38, c39, c40, c41, c42, c43, c44, c45, c46, c47,
                c48, c49, c50, c51, c52, c53, c54, c55, c56, c57, c58, c59, c60, c61, c62, c63);

    let ComputeTileFn =
        Fn [%gpu.SharedM,
            %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
            %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32, %math.F32,
