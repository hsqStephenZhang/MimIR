            let global_col_44 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 0I32));
            let c_i32_44 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_44, %core.bitcast I32 N), global_col_44);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_44), c44);
            let global_row_45 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (2I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_45 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 1I32));
            let c_i32_45 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_45, %core.bitcast I32 N), global_col_45);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_45), c45);
            let global_row_46 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (2I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_46 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 2I32));
            let c_i32_46 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_46, %core.bitcast I32 N), global_col_46);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_46), c46);
            let global_row_47 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (2I32, 16I32), %core.wrap.add 0 (thread_row_base, 3I32)));
            let global_col_47 = %core.wrap.add 0 (block_col, %core.wrap.add 0 (thread_col_base, 3I32));
            let c_i32_47 = %core.wrap.add 0 (%core.wrap.mul 0 (global_row_47, %core.bitcast I32 N), global_col_47);
            let m1 = %mem.store (m1, %mem.lea (C, %core.conv.u MN c_i32_47), c47);
            let global_row_48 = %core.wrap.add 0 (block_row, %core.wrap.add 0 (%core.wrap.mul 0 (3I32, 16I32), %core.wrap.add 0 (thread_row_base, 0I32)));
