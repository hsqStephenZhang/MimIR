// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll %t
// RUN: %mim -p opt -X tensor:tile-fuse=1 %S/../gpu/%{s:stem}.mim -p nvptx
// RUN: %FileCheck %s --input-file=%{s:stem}_dev.ll
// RUN: %if system-linux && cuda %{ clang++ -O1 -DWARPS_ONLY %S/../gpu/%{s:stem}_aux.cpp %{s:stem}.ll -lcuda -o %t -Wno-override-module %}
// RUN: %if system-linux && cuda %{ %t %}

// The block law's warp schedule runs on the device: tensor-core products and double-buffered K/V panels.

// CHECK: define ptx_kernel void @tileKernel
// CHECK-DAG: llvm.nvvm.mma.m16n8k8.row.col.tf32
// CHECK-DAG: llvm.nvvm.cp.async.cg.shared.global.16
