// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll %t
// RUN: %mim -p opt -X tensor:tile-fuse=1 %S/../gpu/%{s:stem}.mim -p nvptx
// RUN: %FileCheck %s --input-file=%{s:stem}_dev.ll
// RUN: %if system-linux && cuda %{ clang++ -O1 %S/../gpu/tile_reduce_merge_aux.cpp %{s:stem}.ll -lcuda -o %t -Wno-override-module %}
// RUN: %if system-linux && cuda %{ %t %}

// The pair-valued partials live in a shared array of pairs; the four work-items merge them as a tree behind fences.

// CHECK: addrspace(3) global [{{[0-9]+}} x [2 x float]]
// CHECK: define ptx_kernel void @tileKernel
// CHECK-COUNT-4: call void @llvm.nvvm.barrier0()
// CHECK-NOT: call void @llvm.nvvm.barrier0()
