// RUN: rm -f %{s:stem}.ll %{s:stem}_dev.ll %t
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p nvptx
// RUN: %if system-linux && cuda %{ clang++ -O1 %S/law_resident_race_aux.cpp %{s:stem}.ll -lcuda -o %t -Wno-override-module %}
// RUN: %if system-linux && cuda %{ %t %}

// The fused producer's input is the consumer's `x` by construction, so its chunks read the 4 rows the work-group stages
// for the consumer instead of global memory.
// The chunk fill reads that staged box, so it runs outside the work-group's batch, fenced on both sides, as the merging
// fill that reads the chunks does; the driver runs the kernel many times to catch a race between them.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;
let ML   = [F32, F32];

fun step (acc: ML, xs: [F32])@tt: ML =
    let (m, l) = acc;
    let (x)    = xs;
    let m2     = math.extrema.fmax fast (m, x);
    return (m2, math.arith.add fast (math.arith.mul fast (l, math.exp.exp fast (math.arith.sub fast (m, m2))),
                                     math.exp.exp fast (math.arith.sub fast (x, m2))));

lam merge (a b: ML): ML =
    let (m1, l1) = a;
    let (m2, l2) = b;
    let m        = math.extrema.fmax fast (m1, m2);
    (m, math.arith.add fast (math.arith.mul fast (l1, math.exp.exp fast (math.arith.sub fast (m1, m))),
                            math.arith.mul fast (l2, math.exp.exp fast (math.arith.sub fast (m2, m)))));

fun normalize (_: F32, xv_ml: [F32, ML])@tt: F32 =
    let (xv, ml) = xv_ml;
    let (m, l)   = ml;
    return (math.arith.div fast (math.exp.exp fast (math.arith.sub fast (xv, m)), l));

let levels = serial_group ((4, 0), 1, 3, group_item ((1, 4), 1, item_done ()));

extern fun rows (x: tensor.Tensor 2 (64, 256) F32): tensor.Tensor 2 (64, 256) F32 =
    let x  = buf x;
    let ml = map_reduce (64, (64, 256)) (step, (math.neg_inf math.f32, 0.0:F32)) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) x;
    let l  = law.fuse_shared 1 (64, (64, 256)) (step, (math.neg_inf math.f32, 0.0:F32), merge) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) x (0)
        @2 @(F32, 2, 2) ((64, 256), (64, 256)) @((F32, ML), (2, 1), ((64, 256), 64)) (normalize, ⊥:F32)
        (affine.id @2) (affine.id @2, proj_map @(2, 1) 0) (x, ml);
    return (law.run (l, levels, default_control));
