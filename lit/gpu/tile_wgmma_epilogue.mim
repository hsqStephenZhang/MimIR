// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_epilogue_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// `a · b + bias` with F16 inputs, F32 accumulation and an F16 result on 200 rows: the bias add and the conversion run
// on the wgmma accumulator fragments as they are written, and the last work-group computes a full 128-row tile from
// TMA's zero fill but stores only its 72 rows; without gpu it lowers to host loops.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

fun epilogue (c: F32, b: H)@tt: H = return (math.conv.f2f math.f16 (math.arith.add fast (c, math.conv.f2f math.f32 b)));

let levels = serial_group ((128, 128, 0), 0, 0, group_warpgroup ((64, 128, 0), 1, wg_red_tma ((0, 0, 64), 1, 3, 2, wg_mma (64, 128, 16))));

extern fun gemm_bias (a: tensor.Tensor 2 (200, 128) H, b: tensor.Tensor 2 (128, 128) H, bias: tensor.Tensor 1 128 H): tensor.Tensor 2 (200, 128) H =
    let y = map_reduce_post @(2, 1) @(F32, H, 2, 3, SchedT)
        ((200, 128), (200, 128, 128), mk_sched (3, 0)) @((H, H), (2, 2), ((200, 128), (128, 128)), H, 1, 128)
        (mac, 0.0:F32, epilogue) (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)), proj_map @(2, 1) 1) ((buf a, buf b), buf bias);
    return (tile_req (y, (), levels, default_control));

// CHECK-DAG: gpu.wgmma_f16
// CHECK-DAG: gpu.tma_load_if
