// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_dequant_offset_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// The dequantized weights read the I8 weights five rows down; their staged panels are not widened to the work-group,
// since that box is the wide tile's image only for maps that read each loop as is.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

fun dequant (_: F32, ws: [I8, F32])@tt: F32 =
    let (w, s) = ws;
    return (math.arith.mul fast (math.conv.s2f math.f32 w, s));

lam column (o: «2; affine.Index»): «2; affine.Index» = (affine.lit 0, o#1_2);
lam shifted (o: «2; affine.Index»): «2; affine.Index» = (affine.op.add (o#0_2, affine.lit 5), o#1_2);

let levels = serial_group ((16, 16, 0), 1, 0, group_warp ((16, 8, 0), 1, warp_red ((0, 0, 8), 1, 3, warp_mma (16, 8, 8))));

extern fun gemm (a: tensor.Tensor 2 (32, 16) F32, w: tensor.Tensor 2 (21, 32) I8, s: tensor.Tensor 2 (1, 32) F32): tensor.Tensor 2 (32, 32) F32 =
    let wd = map_reduce ((16, 32), (16, 32)) (dequant, 0.0:F32) (proj_map @(2, 2) (0, 1)) (shifted, column) (buf w, buf s);
    let root = map_reduce ((32, 32), (32, 32, 16)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, wd);
    return (tile_req (root, wd, levels, default_control));
