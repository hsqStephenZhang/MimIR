// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_cluster_refill_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// The cluster of `tile_wgmma_ws_shared.mim` over 8 blocks and a 4-slot ring: the slots are refilled, and each is given
// up one step after it was read, the last one before the cluster's closing barrier.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_cluster (2, 1, serial_group ((128, 128, 0), 1, 0,
    group_warpgroup ((64, 128, 0), 1, wg_red_ws ((0, 0, 64), 1, 3, 4, 0, wg_mma (64, 128, 16)))));

extern fun gemm_cluster_refill (a: tensor.Tensor 2 (128, 512) H, b: tensor.Tensor 2 (512, 256) H): tensor.Tensor 2 (128, 256) F32 =
    let root = map_reduce ((128, 256), (128, 256, 512)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK-DAG: gpu.tma_load_multicast_if
// CHECK-DAG: gpu.sync_cluster
// CHECK-DAG: gpu.cluster_size 2
