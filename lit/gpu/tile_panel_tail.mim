// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_panel_tail_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A single work-group stages the panels of a peeled reduction tail inside its region, in their own extents.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let levels = serial_group ((32, 32, 0), 1, 0, group_item ((4, 4, 0), 1, item_red ((0, 0, 16), 1, 3, item_done ())));

extern fun gemm_tail (a: tensor.Tensor 2 (32, 24) F32, b: tensor.Tensor 2 (24, 32) F32): tensor.Tensor 2 (32, 32) F32 =
    let root = map_reduce ((32, 32), (32, 32, 24)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK: gpu.launch
