// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/law_resident_sum_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Rows divided by their sums, which are fused without a vouched merge: the sum's combiner is a recognized addition,
// whose own operation merges partials, so each row's sum splits into chunks over the work-items like a vouched merge.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun add (acc: F32, xs: [F32])@tt: F32 =
    let (x) = xs;
    return (math.arith.add fast (acc, x));
fun divide (_: F32, xs: [F32, F32])@tt: F32 =
    let (x, s) = xs;
    return (math.arith.div fast (x, s));

let levels = serial_group ((4, 0), 1, 3, group_item ((1, 4), 1, item_done ()));

extern fun rows (x: tensor.Tensor 2 (16, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    let x = buf x;
    let s = map_reduce (16, (16, 16)) (add, 0.0:F32) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) x;
    let l = law.fuse 1 (16, (16, 16)) (add, 0.0:F32) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) x
        @2 @(F32, 2, 2) ((16, 16), (16, 16)) @((F32, F32), (2, 1), ((16, 16), 16)) (divide, ⊥:F32)
        (affine.id @2) (affine.id @2, proj_map @(2, 1) 0) (x, s);
    return (law.run (l, levels, default_control));

// CHECK-DAG: gpu.slot_shared
// CHECK: gpu.sync_work_items
// CHECK: gpu.sync_work_items
// CHECK: gpu.sync_work_items
// CHECK: gpu.launch
// CHECK-NOT: gpu.launch
