// RUN: %mim %s -o /dev/null

// Block `i · depth + j` is in slot `j`, so the turn of a ring that unrolls its slots reads slot `j` with that block's token.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam turn {depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (sync: gpu.SyncOf depth H V)
    (m: mem.M 0, i: Nat, j: Idx depth, ring: «depth; Nat»): [mem.M 0, Nat] =
    let (_, _, _, await, release, _, _) = sync;
    let block         = core.nat.add (core.nat.mul (i, depth), core.idx2nat j);
    let (m, mine)     = await (m, block);
    let s             = core.idx 0 depth (core.nat.rem (block, depth));
    let (panel, mine) = gpu.read_slot @(Nat, depth, H) (ring, j, s, mine);
    (release (m, s, tt, mine), panel);

extern lam step (m: mem.M 0, i: Nat, j: Idx 2, ring: «2; Nat»): [mem.M 0, Nat] =
    turn (gpu.Held (0, 2)) (gpu.Vacant (0, 2)) (gpu.async_ring @(0, 2) (1, ff)) (m, i, j, ring);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
