// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - -VVVV 2> %t.log | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LOG < %t.log
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_reduce_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A work-item reduction is plain: the law's meaning binds the fold's blocks to the work-items, and their partials merge
// in shared memory with the combiner's `add`, as when TileFuse realizes the same chain.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun add (acc: F32, xs: [F32])@tt: F32 =
    let (x) = xs;
    return (math.arith.add fast (acc, x));

extern fun rowsum16 (x: tensor.Tensor 2 (16, 16) F32): tensor.Tensor 1 16 F32 =
    let l = law.of_map_reduce @1 (16, (16, 16)) (add, 0.0:F32) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1),) (buf x,);
    return (law.run (l, serial_group ((4, 0), 1, 0, group_red_items ((0, 4), 1, group_done ())), default_control));

// LOG-NOT: tensor.tile_fuse {{.*}} red
// LOG: gpu.outline tileGroups{{.*}}: 4 groups × 4 items

// CHECK-DAG: gpu.launch
// CHECK-DAG: gpu.slot_shared
// CHECK-DAG: gpu.sync_work_items
