// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s

// Tiles typed by their owner, lifetime, memory space, what may be done with them and how they are stored, over the
// tile primitives: a work-group's blocks
// stage per-step panels its work-items read, one of them column-major, and the indices leave nothing behind once the
// schedule is unfolded.
// `lit/error/typed_tile_*.mim` are schedules these types reject.

plugin tensor;
plugin core;
plugin affine;
plugin math;
plugin gpu;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

// Execution units and memory spaces.
let Grid   = units.Grid;
let Block  = units.Block;
let Thread = units.Thread;
let Shared = spaces.Shared;
let Reg    = spaces.Reg;

// `Tile` is the tensor plugin's, the type the law interpreter gives the panels it stages: who owns a tile (unit and the
// origin of that unit's tile), until when it lives (all zero: as long as its owner, k + 1: the reduction step at k),
// where it lives, what may be done with it and how it is stored, a `layout_expr` value over its capacity.
// `Filling`: only its owner's cooperative fill writes it; `Seen`: published, so every unit inside its owner reads it
// and none writes it; `Mine`: its owner alone reads and writes it.
// These are the phases `gpu.SharedBuf` goes through after lowering, so a schedule and its barriers share one vocabulary.
let Filling = gpu.Vis#Unpublished;
let Seen    = gpu.Vis#Published;
let Mine    = gpu.Vis#Owned;
// The last logical axis in runs of `n` elements, each read as one vector: the axis shrinks by `n`, which must divide
// it, and the layout must store each run contiguously; whose the tile is and what may be done with it stay.
lam vectors {T: *, r rx: Nat} {u space: Nat, at life: «r; Nat», cap: gpu.Vis} {s c: «rx; Nat», lay: layout_expr.Expr (rx, c)} (n: Nat)
    (p: Tile r u at life space cap rx s c lay T)
    : RowTile r u at life space cap rx ‹d: rx; (s#d, core.nat.div (s#d, n))#(core.ncmp.e (core.idx2nat d, core.nat.sub (rx, 1)))› «n; T» =
    let last = core.idx 0 rx (core.nat.sub (rx, 1));
    let v    = ‹d: rx; (s#d, core.nat.div (s#d, n))#(core.ncmp.e (core.idx2nat d, core.nat.sub (rx, 1)))›;
    let ok   = core.bit2.and 0 (core.ncmp.e (core.nat.rem (s#last, n), 0), core.ncmp.ne (layout_expr.contiguous (lay, n), 1));
    row_tile r u at life space cap
        (require (ok, as_vectors @(rx, s, T) (n, v) (p#data), "a vector view needs whole vectors along the stored last axis"));
// An execution context: the running unit, its tile's origin, its work-group's, and the reduction step it is in.
nom Ctx (r: Nat) (unit: Nat) (at: «r; Nat») (block: «r; Nat») (step: Nat) = [here: «(r, unit, at, block, step)», pad: []];
lam ctx (r: Nat) (unit: Nat) (at: «r; Nat») (block: «r; Nat») (step: Nat): Ctx r unit at block step =
    (‹(r, unit, at, block, step)›, ()) inj Ctx r unit at block step;

lam grid (r: Nat): Ctx r Grid ‹r; 0› ‹r; 0› 0 = ctx r Grid ‹r; 0› ‹r; 0› 0;

// Grid → blocks: each work-group computes a tile it owns in shared memory; the grid concatenates them.
lam blocks {T: *, r: Nat} (s ts: «r; Nat») {I: *} (_: Ctx r Grid ‹r; 0› ‹r; 0› 0) (ins: I)
    (body: [off ext: «r; Nat»] → Ctx r Block off off 0 → I → RowTile r Block off ‹r; 0› Shared Mine r ext T)
    : Tensor r s T =
    tiled (s, ts, 0) ins (bind 1 (λ (off ext: «r; Nat») (xs: I): Tensor r ext T =
        row_data (body (off, ext) (ctx r Block off off 0) xs)));

// A work-group's accumulator before any step.
lam seed {T: *, r: Nat} {b: «r; Nat»} (s: «r; Nat») (_: Ctx r Block b b 0) (init: T): RowTile r Block b ‹r; 0› Shared Mine r s T =
    row_tile r Block b ‹r; 0› Shared Mine (splat (s, init));

// Time: a work-group folds `n` blocks of `ks` of a reduction loop in order.
// The step at `k` runs in a context of its own, so what it stages cannot outlive it: the accumulator's type has no `k`.
lam steps {T: *, r: Nat} {b: «r; Nat»} {s: «r; Nat»} {I: *} (n ks: Nat) (_: Ctx r Block b b 0)
    (acc: RowTile r Block b ‹r; 0› Shared Mine r s T) (ins: I)
    (step: [k: Nat] → Ctx r Block b b (core.nat.add (k, 1)) → RowTile r Block b ‹r; 0› Shared Mine r s T → I → RowTile r Block b ‹r; 0› Shared Mine r s T)
    : RowTile r Block b ‹r; 0› Shared Mine r s T =
    row_tile r Block b ‹r; 0› Shared Mine
        (tile_fold (n, ks) (row_data acc) ins (λ (a: Tensor r s T, k: Nat) (xs: I): Tensor r s T =
            row_data (step k (ctx r Block b b (core.nat.add (k, 1))) (row_tile r Block b ‹r; 0› Shared Mine a) xs)));

// Space: block → threads, with two panels the work-group stages for the current step (or for good, at step 0).
// `fill` runs in the block's context: it cannot see a thread's offset, so the panels are uniform over the work-group.
// The panels reach `body` published; each thread gets its part of the accumulator to own.
lam threads {T: *, r: Nat} {b: «r; Nat», e: Nat} (s ts: «r; Nat») {I: *}
    {Ta Tb: *, ra rb: Nat, sa ca: «ra; Nat», sb cb: «rb; Nat», la: layout_expr.Expr (ra, ca), lb: layout_expr.Expr (rb, cb)}
    (cx: Ctx r Block b b e) (acc: RowTile r Block b ‹r; 0› Shared Mine r s T) (ins: I)
    (fill: I → [Tile r Block b ‹r; e› Shared Filling ra sa ca la Ta, Tile r Block b ‹r; e› Shared Filling rb sb cb lb Tb])
    (body: [off ext: «r; Nat»] → Ctx r Thread off b e
         → [Tile r Block b ‹r; e› Shared Seen ra sa ca la Ta, Tile r Block b ‹r; e› Shared Seen rb sb cb lb Tb]
         → RowTile r Thread off ‹r; 0› Reg Mine r ext T
         → RowTile r Thread off ‹r; 0› Reg Mine r ext T)
    : RowTile r Block b ‹r; 0› Shared Mine r s T =
    row_tile r Block b ‹r; 0› Shared Mine
        (tiled (s, ts, 0) (ins, row_data acc) (bind 2 (λ (off ext: «r; Nat») (xa: [I, Tensor r s T]): Tensor r ext T =
            let (xs, a) = xa;
            let (pa, pb) = fill xs;
            let seen = (tile_as r Block b ‹r; e› Shared Seen la (pa#data), tile_as r Block b ‹r; e› Shared Seen lb (pb#data));
            row_data (body (off, ext) (ctx r Thread off b e) seen
                (row_tile r Thread off ‹r; 0› Reg Mine (slice @(T, r) s (off, ‹r; 1›, ext) a))))));

// A work-group stages a box whole in its shared memory; nobody has seen it yet.
lam resident {T: *, r rx: Nat} {b: «r; Nat», e: Nat} {s: «rx; Nat»} (_: Ctx r Block b b e) (box: Tensor rx s T)
    : RowTile r Block b ‹r; e› Shared Filling rx s T =
    row_tile r Block b ‹r; e› Shared Filling (core.bitcast (Tensor rx s T) (stage @(T, rx, 0) s ((), (), ‹d: rx; d›, ⊥:T) 0 box));

// The same box stored as `lay` says.
lam resident_as {T: *, r rx: Nat} {b: «r; Nat», e: Nat} {s: «rx; Nat»} (lay: layout_expr.Expr (rx, s)) (_: Ctx r Block b b e) (box: Tensor rx s T)
    : Tile r Block b ‹r; e› Shared Filling rx s s lay T =
    tile_as r Block b ‹r; e› Shared Filling lay
        (placed @(T, rx) @s (s, lay) (core.bitcast (Tensor rx s T) (stage @(T, rx, 0) s ((), (), ‹d: rx; d›, ⊥:T) 0 box)));

// Any unit inside work-group `b` reads what `b` published for the step it is in, in logical coordinates whatever its
// layout.
lam read {T: *, r rx: Nat} {u: Nat, at b: «r; Nat», e: Nat} {s c: «rx; Nat», lay: layout_expr.Expr (rx, c)} (_: Ctx r u at b e)
    (p: Tile r Block b ‹r; e› Shared Seen rx s c lay T): Tensor rx s T = p#data;

// A thread's own tile in its registers, and what it computes into one.
lam own {T: *, r rx: Nat} {at b: «r; Nat», e: Nat} {s: «rx; Nat»} (_: Ctx r Thread at b e)
    (p: RowTile r Thread at ‹r; 0› Reg Mine rx s T): Tensor rx s T = row_data p;
lam mine {T: *, r rx: Nat} {at b: «r; Nat», e: Nat} {s: «rx; Nat»} (_: Ctx r Thread at b e) (x: Tensor rx s T)
    : RowTile r Thread at ‹r; 0› Reg Mine rx s T = row_tile r Thread at ‹r; 0› Reg Mine x;

// Time split over units: one thread per block of the reduction loop folds its block from the seed in registers of its
// own, and the work-group merges the partials.
// It takes the seed, not an accumulator tile, so a partly folded accumulator cannot be handed out; `merge` is the
// caller's permission to reorder.
lam steps_par {T: *, r: Nat} {b: «r; Nat»} {I: *} (s: «r; Nat») (n ks: Nat) (_: Ctx r Block b b 0)
    (init: T) (merge: [T, T] → T) (ins: I)
    (step: [k: Nat] → Ctx r Thread ‹r; k› b (core.nat.add (k, 1)) → RowTile r Thread ‹r; k› ‹r; 0› Reg Mine r s T → I
         → RowTile r Thread ‹r; k› ‹r; 0› Reg Mine r s T)
    : RowTile r Block b ‹r; 0› Shared Mine r s T =
    row_tile r Block b ‹r; 0› Shared Mine
        (tile_fold (n, ks) (splat (s, init)) ins (λ (a: Tensor r s T, k: Nat): I → Tensor r s T =
            bind 2 (merge_with @(I → Tensor r s T, T) merge (λ (xs: I): Tensor r s T =
                row_data (step k (ctx r Thread ‹r; k› b (core.nat.add (k, 1))) (row_tile r Thread ‹r; k› ‹r; 0› Reg Mine a) xs)))));

let AB = [tensor.Tensor 2 (16, 16) F32, tensor.Tensor 2 (16, 16) F32];
lam row_vectors {g: «2; Nat», t: «2; Nat», e: Nat} (tc: Ctx 2 Thread t g e) (p: RowTile 2 Block g ‹2; e› Shared Seen 2 (8, 16) F32)
    : tensor.Tensor 2 (8, 4) «4; F32» = read tc (vectors 4 p);

extern fun gemm16 (a b: tensor.Tensor 2 (16, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (blocks ((16, 16), (8, 8)) (grid 2) (buf a, buf b)
        (λ (g ge: «2; Nat») (bc: Ctx 2 Block g g 0) (xs: AB): RowTile 2 Block g ‹2; 0› Shared Mine 2 ge F32 =
            let (gi, gj) = g;
            let (gm, gn) = ge;
            let col_a = layout_expr.make @2 ((gm, 8), 1, (1₃, 0₃, 2₃), (0, 0), 1, 1, 0, 1, ff);
            steps (2, 8) bc (seed ge bc 0.0:F32) xs
                (λ (k: Nat) (sc: Ctx 2 Block g g (core.nat.add (k, 1))) (acc: RowTile 2 Block g ‹2; 0› Shared Mine 2 ge F32) (ys: AB)
                    : RowTile 2 Block g ‹2; 0› Shared Mine 2 ge F32 =
                    threads (ge, (4, 4)) sc acc ys
                        (λ (zs: AB) =
                            let (p, q) = zs;
                            (resident_as col_a sc (slice @(F32, 2) (16, 16) ((gi, k), (1, 1), (gm, 8)) p),
                             resident sc (slice @(F32, 2) (16, 16) ((k, gj), (1, 1), (8, gn)) q)))
                        (λ (t te: «2; Nat») (tc: Ctx 2 Thread t g (core.nat.add (k, 1)))
                           (ps: [Tile 2 Block g ‹2; (core.nat.add (k, 1))› Shared Seen 2 (gm, 8) (gm, 8) col_a F32,
                                 RowTile 2 Block g ‹2; (core.nat.add (k, 1))› Shared Seen 2 (8, gn) F32])
                           (part: RowTile 2 Thread t ‹2; 0› Reg Mine 2 te F32): RowTile 2 Thread t ‹2; 0› Reg Mine 2 te F32 =
                            let (ti, tj) = t;
                            let (tm, tn) = te;
                            let (pa, pb) = ps;
                            mine tc (map_reduce_acc (te, (tm, tn, 8)) (mac, own tc part) (proj_map @(3, 2) (0, 1))
                                (λ (i _ l: affine.Index): «2; affine.Index» = (affine.op.add (i, affine.lit ti), l),
                                 λ (_ j l: affine.Index): «2; affine.Index» = (l, affine.op.add (j, affine.lit tj)))
                                (read tc pa, read tc pb))))));

// CHECK-NOT: nom Tile
// CHECK-NOT: nom Ctx
// CHECK-NOT: gpu.Vis
// CHECK: gpu.launch
