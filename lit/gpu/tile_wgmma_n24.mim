// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_n24_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec
// A warpgroup whose wgmma tile is 24 wide writes its 16-bit result whole: its 16-byte runs do not split evenly over
// the 128 work-items, so it stores them directly instead of staging them in shared memory.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));
fun half (c: F32, _: [])@tt: H = return (math.conv.f2f math.f16 c);

let levels = serial_group ((64, 24, 0), 1, 0, group_warpgroup ((64, 24, 0), 1, wg_red ((0, 0, 64), 1, 3, wg_mma (64, 24, 16))));

extern fun gemm_n24 (a: tensor.Tensor 2 (128, 128) H, b: tensor.Tensor 2 (48, 128) H): tensor.Tensor 2 (128, 48) H =
    let root = map_reduce_post @(2, 0) @(F32, H, 2, 3, SchedT)
        ((128, 48), (128, 48, 128), mk_sched (3, 0)) @((H, H), (2, 2), ((128, 128), (48, 128)), (), (), ())
        (mac, 0.0:F32, half) (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (0, 2), proj_map @(3, 2) (1, 2)), ()) ((buf a, buf b), ());
    return (tile_req (root, (), levels, default_control));
