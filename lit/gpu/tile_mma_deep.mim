// RUN: %mim -p opt -X tensor:tile-fuse=1 -X tensor:pipeline=4 %s -p gpu -o - | %FileCheck %s

// Four stages of 128×128 panels need 75 KiB of shared memory, more than a kernel may declare statically.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let levels = serial_group ((128, 128, 0), 1, 0, group_warp ((64, 32, 0), 1, warp_red ((0, 0, 16), 1, 3, warp_mma (16, 8, 8))));

extern fun gemm128 (a b: tensor.Tensor 2 (128, 128) F32): tensor.Tensor 2 (128, 128) F32 =
    let root = map_reduce ((128, 128), (128, 128, 128)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK: gpu.async_wait_group 2
