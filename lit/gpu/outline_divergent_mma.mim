// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s

plugin core;
plugin affine;
plugin gpu;
plugin mem;
plugin math;
plugin compile;

extern con bad (m: mem.M 0, return: Cn [mem.M 0]) =
    affine.For (gpu.bind.group group_body) group_exit (0I64, 1I64, 1I64, (m, ⊥:«4; math.F32»))
    where
        con group_body (_: I64, (m: mem.M 0, c: «4; math.F32»), group_yield: Cn [mem.M 0, «4; math.F32»]) =
            affine.For (gpu.bind.item full_body) after_full (0I64, 64I64, 1I64, (m, c))
            where
                con full_body (_: I64, (m: mem.M 0, c: «4; math.F32»), item_yield: Cn [mem.M 0, «4; math.F32»]) =
                    item_yield (m, c);

                con after_full (m: mem.M 0, c: «4; math.F32») =
                    affine.For (gpu.bind.item item_body) group_yield (0I64, 33I64, 1I64, (m, c));

                con item_body (_: I64, (m: mem.M 0, c: «4; math.F32»), item_yield: Cn [mem.M 0, «4; math.F32»]) =
                    item_yield (m, gpu.mma_tf32 (⊥:«4; math.F32», ⊥:«2; math.F32», c));
            end;

        con group_exit (m: mem.M 0, _: «4; math.F32») = return m;
    end;

extern lam _compile (): compile.Phase = gpu.outline;

// CHECK: error: gpu.outline: a warp collective cannot execute under a non-warp-aligned item guard
