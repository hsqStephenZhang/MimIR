// RUN: %mim %s -o /dev/null

// Each case of a selection among continuations gives the slot up once, and only one of them runs.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

extern fun step (m: mem.M 0, n: Nat): mem.M 0 =
    let (_, _, _, await, release, _, _) = gpu.async_ring @2 (1, ff);
    let (m, mine) = await (m, n);
    let s = core.idx 0 2 (core.nat.rem (n, 2));
    con yes (m: mem.M 0) = return (release (m, s, tt, mine));
    con no (m: mem.M 0) = return (release (gpu.fence m, s, tt, mine));
    (yes, no)#(core.ncmp.e (n, 0)) m;

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
