// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_persistent_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Four persistent work-groups run the six 128 × 64 tiles of `a · b`, two of them a second tile; in each, two warpgroups
// take turns issuing their wgmmas on the blocks a producer warp fills with TMA into a 4-slot ring that persists across
// tiles; without gpu it lowers to host loops.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_persistent (4, serial_group ((128, 64, 0), 1, 0,
    group_warpgroup ((64, 64, 0), 1, wg_red_ws ((0, 0, 64), 1, 3, 4, 1, wg_mma (64, 64, 16)))));

extern fun gemm_wg_persistent (a: tensor.Tensor 2 (384, 256) H, b: tensor.Tensor 2 (256, 128) H): tensor.Tensor 2 (384, 128) F32 =
    let root = map_reduce ((384, 128), (384, 128, 256)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK-DAG: gpu.wgmma_f16
// CHECK-DAG: gpu.tma_load_if
// CHECK-DAG: gpu.mbar_wait_at
// CHECK-DAG: gpu.mbar_arrive_if
// CHECK-DAG: gpu.reg_budget
