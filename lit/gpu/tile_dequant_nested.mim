// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_dequant_nested_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// The member is the product of two pointwise producers, each with its own column scale.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

fun dequant (_: F32, ws: [I8, F32])@tt: F32 =
    let (w, s) = ws;
    return (math.arith.mul fast (math.conv.s2f math.f32 w, s));

fun scale (_: F32, wt: [F32, F32])@tt: F32 =
    let (w, t) = wt;
    return (math.arith.mul fast (w, t));

lam column (o: «2; affine.Index»): «2; affine.Index» = (affine.lit 0, o#1_2);

let levels = serial_group ((16, 16, 0), 1, 0, group_warp ((16, 8, 0), 1, warp_red ((0, 0, 8), 1, 3, warp_mma (16, 8, 8))));

extern fun gemm16 (a: tensor.Tensor 2 (16, 16) F32, w: tensor.Tensor 2 (16, 16) I8, s: tensor.Tensor 2 (1, 16) F32, t: tensor.Tensor 2 (1, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    let wq = map_reduce ((16, 16), (16, 16)) (dequant, 0.0:F32) (proj_map @(2, 2) (0, 1))
        (proj_map @(2, 2) (0, 1), column) (buf w, buf s);
    let wd = map_reduce ((16, 16), (16, 16)) (scale, 0.0:F32) (proj_map @(2, 2) (0, 1))
        (proj_map @(2, 2) (0, 1), column) (wq, buf t);
    let root = map_reduce ((16, 16), (16, 16, 16)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, wd);
    return (tile_req (root, wd, levels, default_control));

