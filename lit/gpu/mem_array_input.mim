// RUN: (! %mim %s 2>&1) | %FileCheck %s

plugin gpu;
plugin mem;
import compile;

extern lam _compile (): compile.Phase = gpu.mem_checks;

extern fun main (m: mem.M 0, tokens: «2, 3; [Nat, gpu.GlobalM]»): [mem.M 0, I32] =
    return (m, 0I32);

