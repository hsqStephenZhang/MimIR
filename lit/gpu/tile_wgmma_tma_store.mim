// RUN: %mim -p opt -X tensor:tile-fuse=1 -X tensor:tma-store=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 -X tensor:tma-store=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 -DK=256 %S/tile_wgmma_h_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A 16-bit result stored by TMA: each warpgroup stages its 64 × 128 tile in two swizzled 128-byte atoms, which one of its
// work-items copies out as two boxes once all have written and fenced the async proxy.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

fun half (c: F32, _: [])@tt: H = return (math.conv.f2f math.f16 c);

let levels = serial_group ((128, 128, 0), 1, 0, group_warpgroup ((64, 128, 0), 1, wg_red_tma ((0, 0, 64), 1, 3, 2, wg_mma (64, 128, 16))));

extern fun gemm_wg_h (a: tensor.Tensor 2 (128, 256) H, b: tensor.Tensor 2 (256, 128) H): tensor.Tensor 2 (128, 128) H =
    let root = map_reduce_post @(2, 0) @(F32, H, 2, 3, SchedT)
        ((128, 128), (128, 128, 256), mk_sched (3, 0)) @((H, H), (2, 2), ((128, 256), (256, 128)), (), (), ())
        (mac, 0.0:F32, half) (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)), ()) ((buf a, buf b), ());
    return (tile_req (root, (), levels, default_control));

// CHECK-DAG: gpu.tma_store_if
// CHECK-DAG: gpu.tma_store_wait_if
// CHECK-DAG: gpu.fence_proxy_async
