// RUN: %mim -p opt -X tensor:tile-fuse=1 -X tensor:pipeline=2 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Two warpgroups compute a work-group's 128 × 64 tile of `a · bᵀ` from F16 inputs with one wgmma per k step, both
// operands read from 128-byte-swizzled panels; without the gpu plugin the request lowers to host loops.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_group ((128, 64, 0), 1, 0, group_warpgroup ((64, 64, 0), 1, wg_red ((0, 0, 64), 1, 3, wg_mma (64, 64, 16))));

extern fun gemm_wg (a: tensor.Tensor 2 (128, 128) H, b: tensor.Tensor 2 (64, 128) H): tensor.Tensor 2 (128, 64) F32 =
    let root = map_reduce ((128, 64), (128, 64, 128)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (1, 2)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK-DAG: gpu.wgmma_f16
// CHECK-DAG: gpu.wgmma_wait
// CHECK-DAG: gpu.fence_proxy_async
