// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - -VVVV 2> %t.log | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LOG < %t.log
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/softmax16_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// The online `(max, sum)` fold is a member of the normalizing tile; `merge_with` on the producer hands the
// explicit merge to the reduction level TileFuse splits over the work-items.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;
let ML   = [F32, F32];

fun step (acc: ML, xs: [F32])@tt: ML =
    let (m, l) = acc;
    let (x)    = xs;
    let m2     = math.extrema.fmax fast (m, x);
    return (m2, math.arith.add fast (math.arith.mul fast (l, math.exp.exp fast (math.arith.sub fast (m, m2))),
                                     math.exp.exp fast (math.arith.sub fast (x, m2))));

lam merge (a b: ML): ML =
    let (m1, l1) = a;
    let (m2, l2) = b;
    let m        = math.extrema.fmax fast (m1, m2);
    (m, math.arith.add fast (math.arith.mul fast (l1, math.exp.exp fast (math.arith.sub fast (m1, m))),
                            math.arith.mul fast (l2, math.exp.exp fast (math.arith.sub fast (m2, m)))));

fun normalize (_: F32, xv_ml: [F32, ML])@tt: F32 =
    let (xv, ml) = xv_ml;
    let (m, l)   = ml;
    return (math.arith.div fast (math.exp.exp fast (math.arith.sub fast (xv, m)), l));

let levels = serial_group ((4, 0), 1, 0, group_item ((4, 4), 1, item_done ()));

extern fun softmax16 (x: tensor.Tensor 2 (16, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    let x  = buf x;
    let ml = map_reduce (16, (16, 16)) (step, (math.neg_inf math.f32, 0.0:F32)) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) x;
    let ml = merge_with merge ml;
    let y  = map_reduce @2 @(F32, 2, 2) ((16, 16), (16, 16)) @((F32, ML), (2, 1), ((16, 16), 16)) (normalize, ⊥:F32)
        (affine.id @2) (affine.id @2, proj_map @(2, 1) 0) (x, ml);
    return (tile_req (y, ml, levels, default_control));

// LOG: L1 red loop=1 ks=4 tail=peel inputs=1 fused=0 tail_fused=0 bind=2
// LOG: L1 par tiles=‹2; 4› tail=peel inputs=2 fused=0 yielded=0 bind=2
// LOG: L0 par tiles=(4, 16) tail=peel inputs=1 fused=1 yielded=0 bind=1
// LOG: gpu.outline tileGroups{{.*}}: 4 groups × 4 items

// CHECK-DAG: gpu.launch
// CHECK-DAG: gpu.slot_shared
// CHECK-DAG: gpu.sync_work_items
