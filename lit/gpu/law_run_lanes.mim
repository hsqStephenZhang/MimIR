// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o /dev/null -VVVV 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/group_tile_req_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A lane reduction is plain: each work-item's dot products fold a quarter of k on each of four lanes, merged by the
// combiner's `add`.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F    = math.F32;
let fast = math.mode.fast;

fun mac (acc: F, xy: [F, F])@tt: F =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

extern fun gemm (a b: tensor.Tensor 2 (64, 64) F): tensor.Tensor 2 (64, 64) F =
    let l = law.of_map_reduce ((64, 64), (64, 64, 64)) (mac, 0.0:F) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (law.run (l, serial_group ((16, 64, 0), 1, 0, group_item ((4, 4, 0), 1, item_lanes ((0, 0, 16), 1, item_done ()))),
                     default_control));

// CHECK-NOT: tensor.tile_fuse {{.*}} red
// CHECK: gpu.outline tileGroups{{.*}}: 4 groups × 256 items
