// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_split_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A cluster of two work-groups computes one 128 × 128 tile, each the half of the 256-long reduction its rank selects
// through a TMA ring; they add their accumulators through distributed shared memory; without gpu it lowers to host loops.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_cluster_split (2, serial_group ((128, 128, 0), 1, 0,
    group_warpgroup ((64, 128, 0), 1, wg_red_tma ((0, 0, 64), 1, 3, 2, wg_mma (64, 128, 16)))));

extern fun gemm_split (a: tensor.Tensor 2 (128, 256) H, b: tensor.Tensor 2 (256, 128) H): tensor.Tensor 2 (128, 128) F32 =
    let root = map_reduce ((128, 128), (128, 128, 256)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK-DAG: gpu.load_peer
// CHECK-DAG: gpu.sync_cluster
// CHECK-DAG: gpu.cluster_size 2
