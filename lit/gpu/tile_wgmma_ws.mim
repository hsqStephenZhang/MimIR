// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_mn_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Two warpgroups compute a work-group's 128 × 128 tile of `a · b` from F16 inputs with one wgmma per k step; a producer
// warp only fills their 2-slot ring with TMA, synchronized by "full" and "empty" mbarriers; without gpu it lowers to host loops.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_group ((128, 128, 0), 1, 0, group_warpgroup ((64, 128, 0), 1, wg_red_ws ((0, 0, 64), 1, 3, 2, 0, wg_mma (64, 128, 16))));

extern fun gemm_wg_mn (a: tensor.Tensor 2 (128, 128) H, b: tensor.Tensor 2 (128, 128) H): tensor.Tensor 2 (128, 128) F32 =
    let root = map_reduce ((128, 128), (128, 128, 128)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// CHECK-DAG: gpu.wgmma_f16
// CHECK-DAG: gpu.wgmma_wait
// CHECK-DAG: gpu.tma_load_if
// CHECK-DAG: gpu.mbar_wait_at
// CHECK-DAG: gpu.mbar_arrive_if
