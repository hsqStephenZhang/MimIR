// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - -VVVV 2> %t.log | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LOG < %t.log
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/law_promote_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A promoting reduction level runs as the law's meaning: each block stages the promoted inputs' boxes into panels as wide
// as the next parallel level's tiles, and the leaf reads them through the panels.
// Inside a work-group the panels are placed by the layout search, and a reduction of the work-items stages the
// work-group's block, which all its work-items fill and read; TileFuse realizes the same chains alike.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

lam gemm (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32) =
    law.of_map_reduce ((16, 16), (16, 16, 20)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);

extern fun pro_serial_run (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.run (gemm (a, b), serial_par ((8, 8, 0), 0, serial_red ((0, 0, 4), 1, 3, serial_par ((2, 2, 0), 0, serial_done ()))), default_control));
extern fun pro_serial_req (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.req (gemm (a, b), (), serial_par ((8, 8, 0), 0, serial_red ((0, 0, 4), 1, 3, serial_par ((2, 2, 0), 0, serial_done ()))), default_control));
extern fun pro_group_run (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.run (gemm (a, b), serial_group ((8, 8, 0), 0, 0, group_red ((0, 0, 4), 1, 3, group_item ((2, 2, 0), 0, item_vec ((1, 0, 0), item_done ())))), default_control));
extern fun pro_group_req (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.req (gemm (a, b), (), serial_group ((8, 8, 0), 0, 0, group_red ((0, 0, 4), 1, 3, group_item ((2, 2, 0), 0, item_vec ((1, 0, 0), item_done ())))), default_control));
extern fun pro_items_run (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.run (gemm (a, b), serial_group ((8, 8, 0), 1, 0, group_item ((2, 2, 0), 1, item_red ((0, 0, 4), 1, 3, item_vec ((1, 0, 0), item_done ())))), default_control));
extern fun pro_items_req (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.req (gemm (a, b), (), serial_group ((8, 8, 0), 1, 0, group_item ((2, 2, 0), 1, item_red ((0, 0, 4), 1, 3, item_vec ((1, 0, 0), item_done ())))), default_control));

// LOG-COUNT-4: panel (4, 4, 2) stored as 4, 2, 4 split=1 perm=1, 2, 0 swizzle=none

// CHECK-DAG: gpu.slot_shared
// CHECK-DAG: gpu.sync_work_items
