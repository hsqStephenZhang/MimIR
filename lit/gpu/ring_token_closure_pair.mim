// RUN: %mim %s -o /dev/null

// Two functions in one tuple, each called once, are told apart by their positions.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam noop (m: mem.M 0)@ff: mem.M 0 = m;

lam make_pair (h: gpu.Held (0, 3) (0₃, tt))@ff: [mem.M 0 → mem.M 0, mem.M 0 → mem.M 0] =
    lam give (m: mem.M 0)@ff: mem.M 0 = gpu.retire (m, 0₃, tt, h);
    (noop, give);

extern lam step (m: mem.M 0, h: gpu.Held (0, 3) (0₃, tt)): mem.M 0 =
    let pair = make_pair h;
    let m1 = (pair#0₂) m;
    (pair#1₂) m1;

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
