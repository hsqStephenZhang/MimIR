// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - -VVVV 2> %t.log | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LOG < %t.log
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_outline_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A promoted reduction level inside a work-group level stages its panels in shared memory,
// filled by all work-items between barriers; the same request lowers to host loops without the gpu plugin.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let levels = ((0, (8, 8, 0), 0, 0, 1), (1, (0, 0, 4), 1, 3, 0), (0, (2, 2, 0), 0, 0, 2), (2, (1, 0, 0), 1, 0, 0));

extern fun gemm16 (a b: tensor.Tensor 2 (16, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    let root = map_reduce ((16, 16), (16, 16, 16)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));

// LOG-DAG: L1 promote input 0 axis 0 panel 2
// LOG-DAG: L1 promote input 1 axis 1 panel 2
// LOG-DAG: L1 red loop=2 ks=4 tail=peel
// LOG: gpu.outline tileGroups{{.*}}: 4 groups × 16 items

// CHECK-DAG: gpu.launch
// CHECK-DAG: gpu.slot_shared
// CHECK-DAG: gpu.sync_work_items
