// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p gpu -o - | %FileCheck %s
// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 %S/tile_wgmma_refill_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A producer warp fills more blocks than its ring has slots, so it refills slots the consumers released.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

lam levels (depth: Nat) =
    serial_group ((128, 128, 0), 1, 0, group_warpgroup ((64, 128, 0), 1, wg_red_ws ((0, 0, 64), 1, 3, depth, 0, wg_mma (64, 128, 16))));

lam gemm (K: Nat) (depth: Nat) (a: tensor.Tensor 2 (128, K) H, b: tensor.Tensor 2 (K, 128) H): tensor.Tensor 2 (128, 128) F32 =
    let root = map_reduce ((128, 128), (128, 128, K)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    tile_req (root, (), levels depth, default_control);

extern fun gemm_refill (a: tensor.Tensor 2 (128, 256) H, b: tensor.Tensor 2 (256, 128) H): tensor.Tensor 2 (128, 128) F32 =
    return (gemm 256 2 (a, b));

extern fun gemm_refill_late (a: tensor.Tensor 2 (128, 512) H, b: tensor.Tensor 2 (512, 128) H): tensor.Tensor 2 (128, 128) F32 =
    return (gemm 512 4 (a, b));

// CHECK-DAG: gpu.wgmma_f16
// CHECK-DAG: gpu.tma_load_if
// CHECK-DAG: gpu.mbar_wait_at
// CHECK-DAG: gpu.mbar_arrive_if
