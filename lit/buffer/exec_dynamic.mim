// RUN: %mim -p opt %s -o - > %t.out
// RUN: %FileCheck %s < %t.out
// RUN: %FileCheck %s --check-prefix=GONE < %t.out

// Bufferization with a *runtime* extent through the default pipeline, in the first-order form the frontend
// emits: `row_sum` takes its row count `n` as a value next to the tensor it types. `main` fills a «4, n» tensor
// with `i · 10 + 1` and reads row 3's sum, `31 · n`; the exit code checks it for n = argc + 4.
// Distinct rows catch a buffer whose runtime row extent degenerated to a zero stride.
// Below `tensor.lower_to_mem` the handle is a flat `mem.Ptr («⊤; I32», 0)` and the element address is
// linearized from the logical shape, so no type names `n` (see `buffer.lower_ptr`).
// exec_dynamic_run.mim compiles this to an executable and asserts the exit codes.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin btensor;
plugin buffer;

use core.ops.u.w;

fun add (x y: I32)@tt = return (x + y);

lam out_i (i j: affine.Index): «1; affine.Index» = i;
lam id2   (i j: affine.Index): «2; affine.Index» = (i, j);

extern con row_sum (n: Nat, input: tensor.Tensor 2 (4, n) I32, return: Cn [tensor.Tensor 1 4 I32]) =
    return (tensor.map_reduce (4, (4, n)) (add, 0I32) out_i id2 (input));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let n = core.nat.add (core.bitcast Nat argc, 4);
    let a = tensor.generate (4, n) (λ (i: «2; I64»): I32 = core.conv.u 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (10I64, i#0₂), 1I64)));
    con done (o: tensor.Tensor 1 4 I32) = return (m, tensor.get (o, 3₄));
    row_sum (n, a, done);

// CHECK-DAG: extern con row_sum ({{.*}}: core.M 0, {{.*}}: Nat, {{.*}}: core.Ptr («⊤:Nat; I32», 0), return{{.*}}: Cn [core.M 0, core.Ptr («4; I32», 0)])
// CHECK-DAG: mem.load
// CHECK-DAG: mem.store
// GONE-NOT: tensor.
// GONE-NOT: buffer.
// GONE-NOT: %btensor.
