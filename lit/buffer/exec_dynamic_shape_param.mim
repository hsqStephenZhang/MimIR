// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -p ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 25
// RUN: %t x y z ; test $? -eq 52

// A shape vector passed next to the tensor it types: `row_sum` takes `s: «2; Nat»` as a value and `a: «s; I32»`.
// The caller's shape argument has the same type as a two-element tensor of naturals would; it must stay a value
// (the callee's parameter decides the role), while `a` and the result bufferize.
// a[i][j] = i + j over «(4, n)», n = argc + 4; row 3's sum is 3n + n(n-1)/2: 25 for n = 5, 52 for n = 8.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin btensor;
plugin buffer;

use core.ops.u.w;

fun add (x y: I32)@tt = return (x + y);

lam out_i (i j: affine.Index): «1; affine.Index» = i;
lam id2   (i j: affine.Index): «2; affine.Index» = (i, j);

extern con row_sum (s: «2; Nat», a: tensor.Tensor 2 s I32, return: Cn [tensor.Tensor 1 (s#0₂) I32]) =
    return (tensor.map_reduce (s#0₂, s) (add, 0I32) out_i id2 (a));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let n = core.nat.add (core.bitcast Nat argc, 4);
    let s = (4, n);
    let a = tensor.generate s (λ (i: «2; I64»): I32 = core.conv.u 4294967296 (core.wrap.add 0 (i#0₂, i#1₂)));
    con done (o: tensor.Tensor 1 4 I32) = return (m, tensor.get (o, 3₄));
    row_sum (s, a, done);

// The shape parameter stays a pair of naturals (scalarized); only the tensor and the result become pointers.
// CHECK: extern con row_sum ({{.*}}: core.M 0, {{.*}}: Nat, {{.*}}: Nat, {{.*}}: core.Ptr («⊤:Nat; I32», 0), {{.*}}: Cn [core.M 0, core.Ptr («⊤:Nat; I32», 0)])
// CHECK-NOT: buffer.Buf (1, 2, Nat)
