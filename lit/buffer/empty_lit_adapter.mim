// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=buffer.

plugin core;
plugin mem;
plugin buffer;
plugin compile;

extern con consume (m: mem.M 0, n: Nat, a: buffer.Buf (1, n, I32), return: Cn [mem.M 0]) =
    return (buffer.free (1, n, I32) (m, a));

extern con empty_lit (m: mem.M 0, return: Cn [mem.M 0]) =
    let (m, a) = buffer.lit (1, 0, I32) (m, 7I32);
    consume (m, 0, a, return);

extern lam _compile (): compile.Phase = compile.phases ff (buffer.lower_ptr, compile.cleanup);

// CHECK-LABEL: extern fun empty_lit
// CHECK: core.bitcast @ (core.Ptr ([], 0)) (core.Ptr («⊤:Nat; I32», 0))
// CHECK: consume
