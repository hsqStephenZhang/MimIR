// RUN: %mim -p opt -p ll %s -X ll:o=%t.ll
// RUN: clang %t.ll -o %t -Wno-override-module
// RUN: %t

plugin core;
plugin mem;
plugin affine;
plugin buffer;
plugin btensor;
plugin cps;

use core.ops.u.w;

fun add (m: mem.M 0, acc: I32, x: I32)@tt: [mem.M 0, I32] = return (m, acc + x);

fun empty_output (m: mem.M 0)@tt: [mem.M 0, Bool] =
    let (m, src) = buffer.alloc (1, 0, I32) m;
    let (m, dst) = buffer.alloc (1, 0, I32) m;
    let (m, _) = btensor.map_reduce (0, 0) (add, 7I32) (affine.id @1) (affine.id @1) (m, dst, src);
    return (m, tt);

fun empty_reduction (m: mem.M 0)@tt: [mem.M 0, Bool] =
    let (m, src) = buffer.alloc (1, 0, I32) m;
    let (m, bias) = buffer.init (1, 3, I32) (m, (1I32, 2I32, 3I32));
    let (m, dst) = buffer.alloc (1, 3, I32) m;
    let (m, out) = btensor.map_reduce_post @(1, 1)
        (3, (3, 0), btensor.mk_sched (2, 0))
        (add, 7I32, add) (btensor.proj_map @(2, 1) 0)
        (btensor.proj_map @(2, 1) 1, affine.id @1) (m, dst, src, bias);
    let (m, x) = buffer.read (1, 3, I32) (m, out, 0₃);
    let (m, y) = buffer.read (1, 3, I32) (m, out, 1₃);
    let (m, z) = buffer.read (1, 3, I32) (m, out, 2₃);
    let ok = core.bit2.and 2 (core.icmp.e (x, 8I32), core.bit2.and 2 (core.icmp.e (y, 9I32), core.icmp.e (z, 10I32)));
    return (m, ok);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr (mem.Ptr (I8, 0), 0), return: Cn [mem.M 0, I32]) =
    let (m, a) = cps.cps2ds empty_output m;
    let (m, b) = cps.cps2ds empty_reduction m;
    return (m, core.select (core.bit2.and 2 (a, b), 0I32, 1I32));
