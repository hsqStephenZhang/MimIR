// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang %S/../lib.c %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t | %FileCheck %s

// Non-empty slots of `btensor.mr_nest_with` over the domain (2, 2 | 2), one log row per nest:
// classic, classic with an unrolled window, vectorized, blocked, and reduction-vectorized.
// A `U` hook logs `1dxyz` on entry and `2dxyz` on exit, where `d` is the dim of its loop (3 = root) and
// `xyz` the loop-vector prefix; the write-back logs `33xyz` followed by the folded value.
// A `To` hook adds 1 to the fold value on entry and 10 on exit, so the folded value shows which levels
// thread the accumulator through it: the two reduction steps add 1 each, every wrapped level 11 more.
plugin core;
plugin mem;
plugin buffer;
plugin btensor;

let W   = 40;
let Sr  = (2, 2, 2);
let Log = buffer.Buf (2, (5, W), I32);
let U   = «2; I32»;

extern con print_int_matrix [mm: mem.M 0, k l: Nat, m: buffer.Buf (2, (k, l), I32), return: Cn [mem.M 0]];

lam add (a b: I32): I32 = core.wrap.add 0 (a, b);
lam mul (a b: I32): I32 = core.wrap.mul 0 (a, b);

lam enc (kind: I32, d: Nat, pref: «3; I32»): I32 =
    add (add (mul (kind, 10000I32), mul (core.bitcast I32 d, 1000I32)),
         add (add (mul (pref#0_3, 100I32), mul (pref#1_3, 10I32)), pref#2_3));

lam put (log: Log) (m: mem.M 0, (row col: I32), x: I32): [mem.M 0, U] =
    let (m, _) = buffer.write (2, (5, W), I32) (m, log, (core.conv.u 5 row, core.conv.u W col), x);
    (m, (row, add (col, 1I32)));

lam hu (log: Log) (d: Nat) (b: btensor.Body (3, U)): btensor.Body (3, U) =
    con at (pref: «3; I32», m: mem.M 0, u: U, k: Cn [mem.M 0, U]) =
        con leave (m: mem.M 0, u: U) =
            let (m, u) = put log (m, u, enc (2I32, d, pref));
            k (m, u);
        let (m, u) = put log (m, u, enc (1I32, d, pref));
        b (pref, m, u, leave);
    at;

lam ht (d: Nat) (b: btensor.Body (3, I32)): btensor.Body (3, I32) =
    con at (pref: «3; I32», m: mem.M 0, acc: I32, k: Cn [mem.M 0, I32]) =
        con leave (m: mem.M 0, acc: I32) = k (m, add (acc, 10I32));
        b (pref, m, add (acc, 1I32), leave);
    at;

con cell (m: mem.M 0, acc: I32, pref: «3; I32», k: Cn [mem.M 0, I32]) = k (m, add (acc, 1I32));

lam wb (log: Log): Cn [mem.M 0, U, I32, «3; I32», Cn [mem.M 0, U]] =
    con at (m: mem.M 0, u: U, v: I32, pref: «3; I32», k: Cn [mem.M 0, U]) =
        let (m, u) = put log (m, u, enc (3I32, 3, pref));
        let (m, u) = put log (m, u, v);
        k (m, u);
    at;

lam run (log: Log) (row: I32, s: btensor.Sched, k: Cn [mem.M 0, U]): Cn [mem.M 0, U] =
    con at (m: mem.M 0, _: U) =
        btensor.mr_nest_with (2, 1, Sr, I32, U) (hu log, ht) s (0I32, cell, wb log) (m, (row, 0I32), k);
    at;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let (m, log) = buffer.init (2, (5, W), I32) (m, ‹5; ‹W; 0I32››);
    con done (m: mem.M 0, _: U) =
        con fin (m: mem.M 0) = return (m, 0I32);
        print_int_matrix (m, 5, W, log, fin);
    let redvec     = run log (4I32, (2, 1), done);
    let blocked    = run log (3I32, (0, 0), redvec);
    let vectorized = run log (2I32, (1, 0), blocked);
    let window     = run log (1I32, (3, 1), vectorized);
    let classic    = run log (0I32, (3, 0), window);
    classic (m, (0I32, 0I32));

// CHECK: 13000, 10000, 11000, 33000, 24, 21000, 11010, 33010, 24, 21010, 20000, 10100, 11100, 33100, 24, 21100, 11110, 33110, 24, 21110, 20100, 23000, 0,
// CHECK-NEXT: 13000, 10000, 11000, 33000, 24, 21000, 11010, 33010, 24, 21010, 20000, 10100, 11100, 33100, 24, 21100, 11110, 33110, 24, 21110, 20100, 23000, 0,
// CHECK-NEXT: 13000, 10000, 12000, 11000, 21000, 11010, 21010, 22000, 12001, 11001, 21001, 11011, 21011, 22001, 33000, 2, 33010, 2, 20000, 10100, 12100, 11100, 21100, 11110, 21110, 22100, 12101, 11101, 21101, 11111, 21111, 22101, 33100, 2, 33110, 2, 20100, 23000, 0,
// CHECK-NEXT: 13000, 12000, 11000, 10000, 20000, 10100, 20100, 21000, 11010, 10010, 20010, 10110, 20110, 21010, 22000, 12001, 11001, 10001, 20001, 10101, 20101, 21001, 11011, 10011, 20011, 10111, 20111, 21011, 22001, 33000, 2, 33010, 2, 33100, 2, 33110, 2, 23000, 0,
// CHECK-NEXT: 13000, 10000, 12000, 11000, 21000, 11010, 21010, 22000, 12001, 11001, 21001, 11011, 21011, 22001, 33000, 2, 33010, 2, 20000, 10100, 12100, 11100, 21100, 11110, 21110, 22100, 12101, 11101, 21101, 11111, 21111, 22101, 33100, 2, 33110, 2, 20100, 23000, 0,
