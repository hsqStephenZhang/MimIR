// RUN: %mim -p opt -p ll -X tensor:strict=1 -VVVV %s -X ll:o=%t.ll 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: clang++ -O3 -fsanitize=address %S/blis_batch_aux.cpp %t.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt -p ll -X tensor:group=0 %s -X ll:o=%t.off.ll
// RUN: clang++ -O3 -fsanitize=address %S/blis_batch_aux.cpp %t.off.ll -o %t.off -Wno-override-module
// RUN: %t.off

plugin tensor;
plugin core;
plugin math;

let F32 = math.F32;
let mode = math.mode.contract;
let add = math.arith.add mode;
let R: tensor.Ring = (F32, 0:F32, add, math.arith.mul mode);

lam finish {b: Nat} (x: tensor.Tensor 3 (b, 13, 11) F32, bias: tensor.Tensor 2 (b, 11) F32): tensor.Tensor 3 (b, 13, 11) F32 =
    tensor.binary add (x, tensor.broadcast_in_dim @(F32, 2, 3) ((b, 11), (b, 13, 11), bias, (0₃, 2₃)));

extern fun batched (a: tensor.Tensor 3 (2, 13, 7) F32, b: tensor.Tensor 3 (2, 7, 11) F32, c: tensor.Tensor 2 (2, 11) F32): tensor.Tensor 3 (2, 13, 11) F32 =
    return (finish @2 (tensor.bmm R @(2, 13, 7, 11) (tensor.buf a, tensor.buf b), tensor.buf c));
extern fun batch_nt (a: tensor.Tensor 3 (2, 13, 7) F32, b: tensor.Tensor 3 (2, 11, 7) F32, c: tensor.Tensor 2 (2, 11) F32): tensor.Tensor 3 (2, 13, 11) F32 =
    return (finish (tensor.dot_product R @(3, 3) @(1, 1) (2₃, 2₃, 0₃, 0₃) (tensor.buf a, tensor.buf b), tensor.buf c));
extern fun batch_tn (a: tensor.Tensor 3 (2, 7, 13) F32, b: tensor.Tensor 3 (2, 7, 11) F32, c: tensor.Tensor 2 (2, 11) F32): tensor.Tensor 3 (2, 13, 11) F32 =
    return (finish (tensor.dot_product R @(3, 3) @(1, 1) (1₃, 1₃, 0₃, 0₃) (tensor.buf a, tensor.buf b), tensor.buf c));
extern fun single (a: tensor.Tensor 3 (1, 13, 7) F32, b: tensor.Tensor 3 (1, 7, 11) F32, c: tensor.Tensor 2 (1, 11) F32): tensor.Tensor 3 (1, 13, 11) F32 =
    return (finish @1 (tensor.bmm R @(1, 13, 7, 11) (tensor.buf a, tensor.buf b), tensor.buf c));
extern fun prefix (a: tensor.Tensor 4 (2, 3, 13, 7) F32, b: tensor.Tensor 4 (2, 3, 11, 7) F32, c: tensor.Tensor 3 (2, 3, 11) F32): tensor.Tensor 4 (2, 3, 13, 11) F32 =
    let x = tensor.dot_product R @(4, 4) @(1, 2) (3₄, 3₄, (0₄, 1₄), (0₄, 1₄)) (tensor.buf a, tensor.buf b);
    return (tensor.binary add (x, tensor.broadcast_in_dim @(F32, 3, 4) ((2, 3, 11), (2, 3, 13, 11), tensor.buf c, (0₄, 1₄, 3₄))));

// CHECK-COUNT-5: tensor.tile_group root {{.*}} kind 1
// CHECK-NOT: tensor.tile_group root {{.*}} kind 1
// CHECK-NOT: not realized
