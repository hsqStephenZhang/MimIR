// RUN: %mim -p opt %s -o - | %FileCheck %s

// As in TVM's multiple-path test, an injective layout transform feeding a
// kOutEWiseFusable anchor is not folded into that anchor. The transpose and
// matmul therefore remain separate loop nests.
plugin tensor;
plugin core;
plugin affine;
plugin math;
plugin opt;

let f32 = %math.f32;
let F32 = %math.F32;
let R: %tensor.Ring = (F32, 0: F32, %math.arith.add @f32 0, %math.arith.mul @f32 0);

con extern f [a: «2; «3; F32»», bt: «4; «3; F32»», return: Cn «2; «4; F32»»] =
    let b  = %tensor.transpose @(F32, 2, (4, 3)) (bt, (1_2, 0_2));
    let mm = %tensor.product_2d R (a, b);
    return mm;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK-NOT: %tensor.map_reduce_epilogue
// CHECK-COUNT-2: %tensor.map_reduce
