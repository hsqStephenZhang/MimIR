// RUN: %mim -p opt -p ll -X tensor:strict=1 %s
// RUN: clang++ -O3 -fsanitize=address %S/group_rules_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt -p ll -X tensor:strict=1 -X tensor:reference-tiles=1 %s
// RUN: clang++ -O3 -fsanitize=address %S/group_rules_aux.cpp %{s:stem}.ll -o %t.ref -Wno-override-module
// RUN: env ASAN_OPTIONS=detect_leaks=0 %t.ref

// The reference fold carries a fresh accumulator per step, which nothing releases without ownership tracking.

plugin tensor;
plugin math;
plugin affine;
plugin core;
import compile;
import opt;
use tensor;
use core.ops.n;
let F32 = math.F32;
let Ring = (F32, 0.0:F32, math.arith.add math.mode.fast, math.arith.mul math.mode.fast);

fun inc (_ x: F32)@tt: F32 = return (math.arith.add math.mode.fast (x, 1.0:F32));
fun subtract (_: F32, (a b: F32))@tt: F32 = return (math.arith.sub math.mode.fast (b, a));
fun sum (a b: F32)@tt: F32 = return (math.arith.add math.mode.fast (a, b));
lam rows (i _: affine.Index): affine.Index = i;
lam increment (x: tensor.Tensor 2 (5, 7) F32): tensor.Tensor 2 (5, 7) F32 =
    map_reduce ((5, 7), (5, 7)) (inc, 0.0:F32) (affine.id @2) (affine.id @2,) x;
lam row_sum (x: tensor.Tensor 2 (5, 7) F32): tensor.Tensor 1 5 F32 =
    map_reduce (5, (5, 7)) (sum, 0.0:F32) rows (affine.id @2,) x;

extern fun gemm (a: tensor.Tensor 2 (13, 7) F32, b: tensor.Tensor 2 (7, 11) F32): tensor.Tensor 2 (13, 11) F32 =
    return (group_req (product_2d Ring (buf a, buf b), 1, 0, 4, (16, 4, 32)));

extern fun outer (a b: tensor.Tensor 2 (5, 7) F32): tensor.Tensor 2 (5, 7) F32 =
    let p = increment (buf a);
    let c = map_reduce ((5, 7), (5, 7)) (subtract, 0.0:F32)
        (affine.id @2) (affine.id @2, affine.id @2) (p, buf b);
    return (group_req (c, 0, 0, 2, 1));

extern fun reverse (a: tensor.Tensor 2 (5, 3) F32, b: tensor.Tensor 2 (3, 7) F32): tensor.Tensor 1 5 F32 =
    let p = product_2d Ring (buf a, buf b);
    let c = row_sum p;
    let p = group_req (p, 2, 0, 2, c);
    return (row_sum p);

extern lam _compile (): compile.Phase =
    compile.phases ff (lower_tensor, fuse_tensor, group_rules, opt._default_compile ());
