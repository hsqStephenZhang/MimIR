// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// reverse_compute_at with several producers and several consumers, against the unscheduled ops, with P = A · B:
// * `y1`, `y2`: Σ_j P[i, j] and P + 1 both inside the loop of i of one P.
// * `h`: G ⊙ U with G = A · B and U = A · Bu, as SwiGLU: inside the loop of i of G, which computes the row of U first.
// * `z1`, `z2`: Σ_j Q[i, j] and Q + z1 inside one Q: z2 reads z1, so the two do not share Q's loop.
// * `h2`: G ⊙ V with V = A · Bu + 1 computed at j of each part of the op inside G.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac2 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac3 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac4 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac5 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac6 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac8 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum9 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun inc1 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc2 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc9 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun mul1 (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun mul2 (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun mul9 (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun add1 (_: I32, (x y: I32))@tt: I32 = return (x + y);
fun add9 (_: I32, (x y: I32))@tt: I32 = return (x + y);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);

lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam ro (i _: affine.Index): affine.Index = i;
lam ri (i j: affine.Index): «2; affine.Index» = (i, j);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;

let a  = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b  = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));
let bu = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (i#1_2, core.wrap.mul 0 (5I64, i#0_2))));

lam prod (f: Fn [I32, «2; I32»] → I32) (x: «6, 5; I32», y: «5, 7; I32») =
    materialize (mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (ma, mb) (buf x, buf y));
lam rsum (f: Fn [I32, I32] → I32) (p: «6, 7; I32») = mr_tileable @1 @(1, 1) (6, 0, (6, 7)) (f, 0I32, id) ro ri p;
lam ew (f: Fn [I32, I32] → I32) (p: «6, 7; I32») = mr_tileable @1 @(2, 0) ((6, 7), (0, 1), (6, 7)) (f, 0I32, id) po po p;
lam ew2 (f: Fn [I32, «2; I32»] → I32) (p q: «6, 7; I32») =
    mr_tileable @2 @(2, 0) ((6, 7), (0, 1), (6, 7)) (f, 0I32, id) po (po, po) (p, q);
lam bc (f: Fn [I32, «2; I32»] → I32) (p: «6, 7; I32», s: «6; I32») =
    mr_tileable @2 @(2, 0) ((6, 7), (0, 1), (6, 7)) (f, 0I32, id) po (po, ro) (p, s);
lam diff6 (u v: «6; I32»): I32 = reduce (add, 0I32) 0₁ (binary ne (u, v));
lam diff7 (u v: «6, 7; I32»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let p   = prod mac1 (a, b);
    let y1  = materialize (reverse_compute_at (rsum sum1 p, 0, 0));
    let y2  = materialize (reverse_compute_at (ew inc1 p, 0, 0));
    let h   = materialize (reverse_compute_at (reverse_compute_at (ew2 mul1 (prod mac2 (a, b), prod mac3 (a, bu)), 0, 0), 1, 0));
    let q   = prod mac4 (a, b);
    let z1  = materialize (reverse_compute_at (rsum sum2 q, 0, 0));
    let z2  = materialize (reverse_compute_at (bc add1 (q, z1), 0, 0));
    let v   = materialize (ew inc2 (prod mac6 (a, bu)));
    let h2  = materialize (compute_at (reverse_compute_at (ew2 mul2 (prod mac5 (a, b), v), 0, 0), 1, 1));
    let pr  = prod mac9 (a, b);
    let ur  = prod mac8 (a, bu);
    let y1r = materialize (rsum sum9 pr);
    return (m, diff6 (y1, y1r) + diff7 (y2, materialize (ew inc9 pr)) + diff7 (h, materialize (ew2 mul9 (pr, ur)))
               + diff6 (z1, y1r) + diff7 (z2, materialize (bc add9 (pr, y1r)))
               + diff7 (h2, materialize (ew2 mul9 (pr, materialize (ew inc9 ur)))));
