// RUN: %mim -p opt %s -o - | %FileCheck %s

// `base` is both observable and consumed by `mapped`.  Marking it as an
// external graph reference prevents fusion from duplicating its computation.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);
lam mul2 (x: Nat): Nat = %core.nat.mul (x, 2);

con extern f [v: «2; «3; Nat»», return: Cn [«2; «3; Nat»», «2; «3; Nat»»]] =
    let base   = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) v;
    let mapped = %tensor.unary @(Nat, Nat) mul2 @(2, (2, 3)) base;
    return (base, mapped);

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK: %tensor.map_reduce
// CHECK: %tensor.map_reduce
// CHECK-NOT: %tensor.map_reduce
