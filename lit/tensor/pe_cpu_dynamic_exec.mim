// RUN: %mim -p opt %s -p ll -X ll:asan=1 -X ll:o=%t0.ll -o %t0.mim
// RUN: clang++ -O2 -fsanitize=address %S/pe_cpu_dynamic_aux.cpp %t0.ll -o %t0.exec -Wno-override-module
// RUN: %t0.exec | %FileCheck %s
// RUN: %mim -p opt -X tensor:cpu-mr=4 -X tensor:cpu-nr=8 -X tensor:cpu-mc=12 -X tensor:cpu-nc=24 -X tensor:cpu-kc=5 %s -p ll -X ll:asan=1 -X ll:o=%t1.ll -o %t1.mim
// RUN: clang++ -O2 -fsanitize=address %S/pe_cpu_dynamic_aux.cpp %t1.ll -o %t1.exec -Wno-override-module
// RUN: %t1.exec | %FileCheck %s
// RUN: %mim -VVV -p opt %s -o %t2.mim 2>&1 | %FileCheck %s --check-prefix=PE
// RUN: %mim -VVVV -p opt -X tensor:group-cache=4096 %s -p ll -X ll:asan=1 -X ll:o=%t3.ll -o %t3.mim 2>&1 | %FileCheck %s --check-prefix=SWITCH
// RUN: clang++ -O2 -fsanitize=address %S/pe_cpu_dynamic_aux.cpp %t3.ll -o %t3.exec -Wno-override-module
// RUN: %t3.exec | %FileCheck %s

// Contractions with run-time extents are tiled by run_levels: `Seq` splits every run-time axis and edge tiles go through a scratch tile.

// With only `M` unknown and `B` larger than the cache, a few rows branch at run time to a tree that does not pack `B`.

// PE-COUNT-4: with tensor.run_levels
// SWITCH:      Switch 0, 129
// SWITCH-NOT:  Pack 1
// SWITCH:      Leaf 0
// SWITCH:      Pack 1
// CHECK: dynamic GEMM: all shapes passed

plugin tensor;
plugin core;
plugin math;

let F32 = math.F32;
let R: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);

extern fun gemm_dyn {m k n: Nat} (a: tensor.Tensor 2 (m, k) F32, b: tensor.Tensor 2 (k, n) F32): tensor.Tensor 2 (m, n) F32 =
    return (tensor.product_2d R (a, b));

extern fun gemm_dyn_nt {m k n: Nat} (a: tensor.Tensor 2 (m, k) F32, b: tensor.Tensor 2 (n, k) F32): tensor.Tensor 2 (m, n) F32 =
    return (tensor.product_2d R (a, tensor.transpose_2d b));

extern fun gemm_dyn_bias {m k n: Nat} (a: tensor.Tensor 2 (m, k) F32, b: tensor.Tensor 2 (k, n) F32, bias: tensor.Tensor 1 n F32): tensor.Tensor 2 (m, n) F32 =
    let p = tensor.product_2d R (a, b);
    return (tensor.binary (math.arith.add math.mode.contract) (p, tensor.broadcast ((1, n), (m, n), tensor.reshape n (1, n) bias)));

extern fun gemm_dyn_m {m: Nat} (a: tensor.Tensor 2 (m, 33) F32, b: tensor.Tensor 2 (33, 70) F32): tensor.Tensor 2 (m, 70) F32 =
    return (tensor.product_2d R (a, b));
