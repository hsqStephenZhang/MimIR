// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"

// Reads that go down along a dim inside the box, against the unscheduled ops, with P = A · B:
// * `f`: F[i, j] = P[i, 6 - j] + 1 with P computed at i, whose row starts at the read of j = 6.
// * `g`: A · B' with B'[k, j] = B[k, 6 - j] read from a copy of B made ahead of the nest.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac2 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac8 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun inc1 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc9 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam mf (_ j k: affine.Index): «2; affine.Index» = (k, affine.op.sub (affine.lit 6, j));
lam po (o: «2; affine.Index»): «2; affine.Index» = o;
lam pf (i j: affine.Index): «2; affine.Index» = (i, affine.op.sub (affine.lit 6, j));

let a = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));

lam prod (f: Fn [I32, «2; I32»] → I32) (mbr: «3; affine.Index» → «2; affine.Index») =
    mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (ma, mbr) (buf a, buf b);
lam flipped (f: Fn [I32, I32] → I32) (p: «6, 7; I32») = mr_tileable @1 @(2, 0) ((6, 7), (0, 1), (6, 7)) (f, 0I32, id) po pf p;
lam diff (u v: «6, 7; I32»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let f = materialize (compute_at (flipped inc1 (materialize (prod mac1 mb)), 0, 0));
    let g = materialize (cache_read (prod mac2 mf, 1, 0));
    let r = materialize (flipped inc9 (materialize (prod mac9 mb)));
    return (m, diff (f, r) + diff (g, materialize (prod mac8 mf)));
