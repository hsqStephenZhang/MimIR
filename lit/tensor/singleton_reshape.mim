// RUN: %mim -p opt %s -p ll -X tensor:group=0 -X ll:o=%t.off.ll
// RUN: clang++ -O3 -fsanitize=address %S/singleton_reshape_aux.cpp %t.off.ll -o %t.off -Wno-override-module
// RUN: %t.off
// RUN: %mim -p opt %s -p ll -X tensor:group=1 -X ll:o=%t.on.ll
// RUN: clang++ -O3 -fsanitize=address %S/singleton_reshape_aux.cpp %t.on.ll -o %t.on -Wno-override-module
// RUN: %t.on

plugin tensor;
plugin core;

extern fun singleton_reshape (x: tensor.Tensor 3 (2, 3, 4) I64): tensor.Tensor 3 (2, 3, 4) I64 =
    let x = tensor.reshape (2, 3, 4) (1, 2, 3, 4) (tensor.buf x);
    let x = tensor.transpose @(I64, 4) (0₄, 2₄, 1₄, 3₄) @(1, 2, 3, 4) x;
    let x = tensor.reshape (1, 3, 2, 4) (3, 2, 4) x;
    return (tensor.transpose @(I64, 3) (1₃, 0₃, 2₃) @(3, 2, 4) x);
