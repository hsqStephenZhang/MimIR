// RUN: %mim -VVV -p opt -X tensor:pe-fuse=1 -X tensor:cpu-mc=8 -X tensor:cpu-nc=16 %s -p ll -X ll:o=%t.ll -o %t.mim 2>&1 | %FileCheck %s
// RUN: %FileCheck %s --check-prefix=LL --input-file=%t.ll --implicit-check-not='malloc(i64 1920)' --implicit-check-not='malloc(i64 960)'
// RUN: clang++ -O2 -fsanitize=address %S/pe_fuse_auto_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Contraction chains fused automatically: a single-use contraction feeding a `run_levels` contraction is staged band by band.
// CHECK-DAG: tile the contraction over (40, 20, 24) with tensor.run_levels
// CHECK-DAG: fuse the contraction over (24, 20, 36) into its consumer
// CHECK-DAG: tile the contraction over (40, 20, 12) with tensor.run_levels
// CHECK-DAG: fuse the contraction over (12, 16, 24) into its consumer
// CHECK-DAG: fuse the contraction over (12, 20, 16) into its consumer

// Only bands of the intermediates are allocated (24×16 of B·D; 12×16 of the middle product, and its 8×16 bands inside),
// never the whole 24×20 B·D or 12×20 middle product.
// LL-LABEL: define {{.*}} @chain2(
// LL:       malloc(i64 1536)
// LL-LABEL: define {{.*}} @chain3(
// LL-DAG:   malloc(i64 768)
// LL-DAG:   malloc(i64 512)
plugin tensor;
plugin core;
plugin math;

let F32 = math.F32;
let R: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);

// Reassociated to A·(B·D).
extern fun chain2 (a: tensor.Tensor 2 (40, 24) F32, b: tensor.Tensor 2 (24, 36) F32, d: tensor.Tensor 2 (36, 20) F32): tensor.Tensor 2 (40, 20) F32 =
    return (tensor.product_2d R (tensor.product_2d R (a, b), d));

// Reassociated to A·((B1·B2)·B3): both inner products are fused, one inside the other's producer.
extern fun chain3 (a: tensor.Tensor 2 (40, 12) F32, b1: tensor.Tensor 2 (12, 24) F32, b2: tensor.Tensor 2 (24, 16) F32,
                   b3: tensor.Tensor 2 (16, 20) F32): tensor.Tensor 2 (40, 20) F32 =
    return (tensor.product_2d R (tensor.product_2d R (tensor.product_2d R (a, b1), b2), b3));
