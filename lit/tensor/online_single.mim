// RUN: %mim -p opt %s -p ll
// RUN: clang++ -O2 -std=c++23 %S/online_single_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

plugin tensor;
plugin math;
import opt;
plugin compile;

extern fun singleton (q: «1, 3, 1; math.F32», k: «1, 1, 1; math.F32»,
                      v: «1, 1, 2; math.F32»): «1, 3, 2; math.F32» =
    return (tensor.sdpa math.mode.contract @(1, 3, 1, 1, 2)
        (0.5:math.F32, tensor.buf q, tensor.buf k, tensor.buf v));
extern fun scalar (q k v: «1, 1, 1; math.F32»): «1, 1, 1; math.F32» =
    return (tensor.sdpa math.mode.contract @(1, 1, 1, 1, 1)
        (0.5:math.F32, tensor.buf q, tensor.buf k, tensor.buf v));

extern lam _compile (): compile.Phase =
    compile.phases ff (compile.rule_app (tensor.attention_online_rule (math.mode.contract, 2, 3)),
        opt._default_compile ());
