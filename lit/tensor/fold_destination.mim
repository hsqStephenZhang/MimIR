// RUN: %mim %s -o - > %t.out
// RUN: %FileCheck %s < %t.out

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;
fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));
extern fun linear (x: «3; I64»): «3; I64» =
    return (tile_fold (3, 2) (buf x) (λ (acc: «3; I64», off: Nat): «3; I64» =
        map_reduce_post @(1, 0) @(I64, I64, 1, 1, SchedT)
            (3, 3, mk_sched (1, 0)) @(I64, 1, 3, (), (), ())
            (add, outs_default @(I64, 1) 3 acc, id @I64) (affine.id @1)
            (affine.id @1, ()) (splat (3, core.bitcast I64 off), ())));
extern lam _compile (): compile.Phase =
    compile.phases ff (lower_tensor, fuse_tensor, lower_to_mem, compile.cleanup);

// CHECK: con tileFoldStep
// CHECK-NOT: buffer.copy
// CHECK-NOT: foldCopy
// CHECK: btensor.map_reduce_post
// CHECK-NOT: buffer.copy
// CHECK-NOT: foldCopy
// CHECK: fun tileFold
// CHECK: foldCopy
// CHECK-LABEL: extern fun linear
