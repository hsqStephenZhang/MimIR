// RUN: %mim %s -o - > %t.out
// RUN: %FileCheck %s --implicit-check-not=foldCopy --implicit-check-not=buffer.copy --implicit-check-not=buffer.lit < %t.out

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;
extern fun seeded (): «3; I64» =
    return (tile_fold (3, 2) (splat (3, 3I64))
        ()
        (λ (acc: «3; I64», off: Nat) (): «3; I64» =
            fun combine (x: I64, _: [])@tt: I64 =
                return (core.wrap.add 0 (core.wrap.mul 0 (x, 10I64), core.bitcast I64 off));
            map_reduce_post @(0, 0) @(I64, I64, 1, 1, SchedT)
                (3, 3, mk_sched (1, 0)) @((), (), (), (), (), ())
                (combine, outs_default @(I64, 1) 3 acc, id @I64)
                (affine.id @1) ((), ()) ((), ())));
extern lam _compile (): compile.Phase =
    compile.phases ff (lower_tensor, fuse_tensor, lower_to_mem, compile.cleanup);

// CHECK: foldFirst
// CHECK: btensor.map_reduce_post
// CHECK: @ I64
// CHECK: buffer.alloc
