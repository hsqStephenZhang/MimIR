// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=TILE

// A stride-2 convolution C[n, o] = Σ_k P[n, 2·o + k] · w[k] with P = Σ_j A[n, x, j] computed one tile at a time,
// against the unscheduled ops.
// The box of P a tile reads is not exact, as 2·o skips the odd values, but its corner is, which is all compute_at needs.
// * `s`: P at o, three cells per output.
// * `t`: o split by 4 and P at its outer dim: 2·o + k with k ∈ [0, 3) is one run of 9 cells.
// * `u`: the same, copying a materialized P.
// * `v`: one tap, so the 4 reads leave gaps: the tile is their hull of 7 cells.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac2 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac3 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac4 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac8 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum3 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum4 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum8 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum9 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam qo (n x _: affine.Index): «2; affine.Index» = (n, x);
lam qa (n x j: affine.Index): «3; affine.Index» = (n, x, j);
lam mo (n o _: affine.Index): «2; affine.Index» = (n, o);
lam mp (n o k: affine.Index): «2; affine.Index» = (n, affine.op.add (affine.semiop.mul (o, 2), k));
lam mw (_ _ k: affine.Index): affine.Index = k;

let a = generate (2, 17, 3) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (5I64, i#0_3), core.wrap.sub 0 (i#1_3, i#2_3))));
let w = generate 3 (λ i: I64: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i, 1I64)));

lam prod (f: Fn [I32, I32] → I32) = mr_tileable @1 @(2, 1) ((2, 17), (0, 1), (2, 17, 3)) (f, 0I32, id) qo qa a;
lam cv (f: Fn [I32, «2; I32»] → I32) (p: «2, 17; I32») =
    mr_tileable @2 @(2, 1) ((2, 8), (0, 1), (2, 8, 3)) (f, 0I32, id) mo (mp, mw) (p, w);
lam cv1 (f: Fn [I32, «2; I32»] → I32) (p: «2, 17; I32») =
    mr_tileable @2 @(2, 1) ((2, 8), (0, 1), (2, 8, 1)) (f, 0I32, id) mo (mp, mw) (p, w);
lam d (u v: «2, 8; I32»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let s = materialize (compute_at (cv mac1 (materialize (prod sum1)), 0, 1));
    let t = materialize (compute_at (split_par (cv mac2 (materialize (prod sum2)), 1, 4), 0, 1));
    let u = materialize (compute_at (cache_read (split_par (cv mac3 (materialize (prod sum3)), 1, 4), 0, 0), 0, 1));
    let v = materialize (compute_at (split_par (cv1 mac4 (materialize (prod sum4)), 1, 4), 0, 1));
    let r = materialize (cv mac9 (materialize (prod sum9)));
    let q = materialize (cv1 mac8 (materialize (prod sum8)));
    return (m, d (s, r) + d (t, r) + d (u, r) + d (v, q));

// TILE-DAG: mem.malloc («9; I32», 0)
// TILE-DAG: mem.malloc («7; I32», 0)
