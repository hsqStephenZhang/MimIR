// RUN: not %mim -p opt %s -o - 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: not %mim -p opt -X tensor:strict=1 %s -o - 2> %t.strict.log
// RUN: %FileCheck %s < %t.strict.log

plugin tensor;
plugin core;
plugin affine;
import compile;

fun inc (_ x: I64)@tt: I64 = return (core.wrap.add 0 (x, 1I64));
extern fun stacked (x: tensor.Tensor 1 5 I64): tensor.Tensor 1 5 I64 =
    let p = tensor.map_reduce (5, 5) (inc, 0I64) (affine.id @1) (affine.id @1,) (tensor.buf x);
    let p = tensor.group_req (p, 0, 0, 2, 1);
    return (tensor.group_req (p, 0, 0, 2, 1));

extern lam _compile (): compile.Phase =
    compile.phases ff (tensor.lower_tensor, tensor.group_rules);

// CHECK: error: tensor.group phase bug: stacked structural requests on one op
