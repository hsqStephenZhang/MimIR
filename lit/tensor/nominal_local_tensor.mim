// RUN: %mim %s -p ll -X ll:o=%t.ll
// RUN: clang %t.ll %S/nominal_local_tensor_aux.c -o %t -Wno-override-module
// RUN: %t

plugin core;
plugin tensor;
use core.ops.u.w;
use tensor;

extern fun local_tensor {n: Nat} (x: I32): I32 =
    let size = core.nat.add (n, 1);
    let a = generate size (λ (i: I64): I32 = x + core.conv.u 4294967296 i);
    return (get (a, core.idx 0 size n));

extern fun branch_tensor {n: Nat} (x: I32, active: Bool): I32 =
    con plain () = return x;
    con materialize () =
        let size = core.nat.add (n, 1);
        let a = generate size (λ (i: I64): I32 = x + core.conv.u 4294967296 i);
        return (get (a, core.idx 0 size n));
    (plain, materialize)#active ();
