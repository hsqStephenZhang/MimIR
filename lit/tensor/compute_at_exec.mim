// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/compute_at_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=FULL
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --check-prefix=WARN

// `tensor.compute_at` end to end, driven by compute_at_aux.cpp against a scalar reference:
// * `mm_at0`:  (a + 1) · b with a + 1 computed one row «1, 6» per iteration of i.
// * `mm_at1`:  the same inside the loop of j, i.e. recomputed per output cell.
// * `conv_at`: a 3×3 convolution of x + 1, computed per output row: three input rows «1, 2, 3, 6», the halo.
// * `red_at`:  s[i] · b[i, j] with the row sum s[i] = Σ_k a[i, k] computed per row: a reduction producer.
// * `plain`:   an input that no map_reduce_post computes cannot be computed at a loop: warned, and read as is.
plugin core;
plugin tensor;
plugin affine;

use core.ops.u.w;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mul (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun sum (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add1 (x: I32): I32 = x + 1I32;

lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

extern fun mm_at0 (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun mm_at1 (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 1)));

lam co (n c oh ow _ _ _: affine.Index): «4; affine.Index» = (n, c, oh, ow);
lam cx (n _ oh ow ci kh kw: affine.Index): «4; affine.Index» = (n, ci, affine.op.add (oh, kh), affine.op.add (ow, kw));
lam cw (_ c _ _ ci kh kw: affine.Index): «4; affine.Index» = (c, ci, kh, kw);

extern fun conv_at (x: «2, 2, 6, 6; I32», w: «3, 2, 3, 3; I32»): «2, 3, 4, 4; I32» =
    let p = tensor.unary add1 (tensor.buf x);
    let t = tensor.mr_tileable @2 @(4, 3) ((2, 3, 4, 4), (0, 1, 2, 3), (2, 3, 4, 4, 2, 3, 3))
                (mac, 0I32, tensor.id) co (cx, cw) (p, tensor.buf w);
    return (tensor.materialize (tensor.compute_at (t, 0, 2)));

lam ro (i _: affine.Index): affine.Index = i;
lam ri (i k: affine.Index): «2; affine.Index» = (i, k);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;

extern fun red_at (a: «4, 6; I32», b: «4, 5; I32»): «4, 5; I32» =
    let s = tensor.materialize (tensor.mr_tileable @1 @(1, 1) (4, 0, (4, 6)) (sum, 0I32, tensor.id) ro ri (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 0) ((4, 5), (0, 1), (4, 5)) (mul, 0I32, tensor.id) po (ro, po) (s, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun plain (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (tensor.buf a, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

// WARN: compute_at of input 1 inside dim 0 of {{.*}} not realized: the input is not a map_reduce_post

// Every producer runs inside its consumer's nest on a tile buffer of the box's static size — a row «1, 6»
// (folded to «6»), three input rows «1, 2, 3, 6» of the convolution (folded to «2, 3, 6») — which lands on
// the stack; no buffer of a whole producer remains.
// CHECK-DAG: mem.mslot («6; I32», 0)
// CHECK-DAG: mem.mslot («2, 3, 6; I32», 0)
// FULL-NOT: mem.{{m?slot|malloc}} («4, 6; I32»
// FULL-NOT: mem.{{m?slot|malloc}} («2, 2, 6, 6; I32»
// FULL-NOT: mem.{{m?slot|malloc}} («4; I32»
