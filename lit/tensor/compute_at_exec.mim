// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/compute_at_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=FULL
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --check-prefix=WARN

// `tensor.compute_at` end to end, driven by compute_at_aux.cpp against a scalar reference:
// * `mm_at0`:  (a + 1) · b with a + 1 computed one row «1, 6» per iteration of i.
// * `mm_at1`:  the same inside the loop of j, i.e. recomputed per output cell.
// * `conv_at`: a 3×3 convolution of x + 1, computed per output row: three input rows «1, 2, 3, 6», the halo.
// * `red_at`:  s[i] · b[i, j] with the row sum s[i] = Σ_k a[i, k] computed per row: a reduction producer.
// * `rep_at`:  y[i] = (x + 1)[i floordiv 16] with i split 64 = 8 × 8, per outer i: an aligned box «1».
// * `grp_at`:  y[c] = x[c] + (g + 1)[c floordiv 16] with c split 48 = 2 × 24, per outer c: boxes of 2 that overlap.
// * `edge_at`: y[c] = x[c] + (g + 1)[c floordiv 5] with c split 24 = 3 × 8: the last box of 3 would leave g, so warned.
// * `rev_at`:  P read reversed, P[i, 5 − k]: the box does not start at the corner's read, so warned and whole.
// * `chain_at`: Q at i of P, P at i of C: P is realized, Q inside P's tile is warned and whole.
// * `back_at`: P read at row (i − 5) + 5, whose Nat bounds must not saturate at the intermediate i − 5.
// * `fused_at`: C = Σ_k (x + y)[i, j, k] · P[i, k], P at i: fuse_tensor splices x + y into two inputs, so P moves to slot 2.
// * `fold_at`: a producer of «1, 5» read as «5, 1», one type as unit axes fold: warned, and read as `fold_plain` reads it.
// * `epi_at`: C = R + P with R a reduction and P at i: epilogue fusion would sink C into R, dropping the schedule.
// * `plain`:   an input that no map_reduce_post computes cannot be computed at a loop: warned, and read as is.
plugin core;
plugin tensor;
plugin affine;

use core.ops.u.w;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mul (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun sum (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add1 (x: I32): I32 = x + 1I32;
lam add2 (x y: I32): I32 = x + y;

lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

extern fun mm_at0 (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun mm_at1 (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 1)));

lam co (n c oh ow _ _ _: affine.Index): «4; affine.Index» = (n, c, oh, ow);
lam cx (n _ oh ow ci kh kw: affine.Index): «4; affine.Index» = (n, ci, affine.op.add (oh, kh), affine.op.add (ow, kw));
lam cw (_ c _ _ ci kh kw: affine.Index): «4; affine.Index» = (c, ci, kh, kw);

extern fun conv_at (x: «2, 2, 6, 6; I32», w: «3, 2, 3, 3; I32»): «2, 3, 4, 4; I32» =
    let p = tensor.unary add1 (tensor.buf x);
    let t = tensor.mr_tileable @2 @(4, 3) ((2, 3, 4, 4), (0, 1, 2, 3), (2, 3, 4, 4, 2, 3, 3))
                (mac, 0I32, tensor.id) co (cx, cw) (p, tensor.buf w);
    return (tensor.materialize (tensor.compute_at (t, 0, 2)));

lam ro (i _: affine.Index): affine.Index = i;
lam ri (i k: affine.Index): «2; affine.Index» = (i, k);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;

extern fun red_at (a: «4, 6; I32», b: «4, 5; I32»): «4, 5; I32» =
    let s = tensor.materialize (tensor.mr_tileable @1 @(1, 1) (4, 0, (4, 6)) (sum, 0I32, tensor.id) ro ri (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 0) ((4, 5), (0, 1), (4, 5)) (mul, 0I32, tensor.id) po (ro, po) (s, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

fun inc (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun add (_: I32, (x y: I32))@tt: I32 = return (x + y);
lam m1  (i: affine.Index): affine.Index = i;
lam d16 (i: affine.Index): affine.Index = affine.semiop.floordiv (i, 16);

extern fun rep_at (x: «4; I32»): «8, 8; I32» =
    let p = tensor.unary add1 (tensor.buf x);
    let t = tensor.mr_tileable @1 @(1, 0) (64, 0, 64) (inc, 0I32, tensor.id) m1 d16 p;
    return (tensor.materialize (tensor.compute_at (tensor.strip_mine_par (t, 0, 8), 0, 0)));

extern fun grp_at (x: «48; I32», g: «3; I32»): «2, 24; I32» =
    let p = tensor.unary add1 (tensor.buf g);
    let t = tensor.mr_tileable @2 @(1, 0) (48, 0, 48) (add, 0I32, tensor.id) m1 (m1, d16) (tensor.buf x, p);
    return (tensor.materialize (tensor.compute_at (tensor.strip_mine_par (t, 0, 24), 1, 0)));

lam d5 (i: affine.Index): affine.Index = affine.semiop.floordiv (i, 5);

extern fun edge_at (x: «24; I32», g: «5; I32»): «3, 8; I32» =
    let p = tensor.unary add1 (tensor.buf g);
    let t = tensor.mr_tileable @2 @(1, 0) (24, 0, 24) (add, 0I32, tensor.id) m1 (m1, d5) (tensor.buf x, p);
    return (tensor.materialize (tensor.compute_at (tensor.strip_mine_par (t, 0, 8), 1, 0)));

lam qo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam mr (i _ k: affine.Index): «2; affine.Index» = (i, affine.op.sub (affine.lit 5, k));

extern fun rev_at (a: «3, 6, 2; I32», b: «6, 5; I32»): «3, 5; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((3, 6), (0, 1), (3, 6, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 6)) (mac, 0I32, tensor.id) mo (mr, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun chain_at (a: «3, 6, 2; I32», b: «6, 5; I32», e: «5, 3; I32»): «3, 3; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((3, 6), (0, 1), (3, 6, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.compute_at (tensor.mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b), 0, 0));
    let t = tensor.mr_tileable @2 @(2, 1) ((3, 3), (0, 1), (3, 3, 5)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

lam mback (i _ k: affine.Index): «2; affine.Index» = (affine.op.add (affine.op.sub (i, affine.lit 5), affine.lit 5), k);

extern fun back_at (a: «4, 6, 2; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((4, 6), (0, 1), (4, 6, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (mback, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

lam m3 (o: «3; affine.Index»): «3; affine.Index» = o;

extern fun fused_at (x y: «4, 5, 7; I32», a: «4, 7, 2; I32»): «4, 5; I32» =
    let s = tensor.binary add2 (tensor.buf x, tensor.buf y);
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((4, 7), (0, 1), (4, 7, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 7)) (mac, 0I32, tensor.id) mo (m3, ma) (s, p);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

extern fun fold_at (x: «1, 5; I32»): «5; I32» =
    let p: «5, 1; I32» = tensor.materialize (tensor.mr_tileable @1 @(2, 0) ((1, 5), (0, 1), (1, 5)) (inc, 0I32, tensor.id) po po (tensor.buf x));
    let t = tensor.mr_tileable @1 @(1, 1) (5, 0, (5, 1)) (sum, 0I32, tensor.id) ro ri p;
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun fold_plain (x: «1, 5; I32»): «5; I32» =
    let p: «5, 1; I32» = tensor.materialize (tensor.mr_tileable @1 @(2, 0) ((1, 5), (0, 1), (1, 5)) (inc, 0I32, tensor.id) po po (tensor.buf x));
    return (tensor.materialize (tensor.mr_tileable @1 @(1, 1) (5, 0, (5, 1)) (sum, 0I32, tensor.id) ro ri p));

extern fun epi_at (a: «2, 9, 2; I32», b: «2, 9; I32»): «2, 9; I32» =
    let r = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((2, 9), (0, 1), (2, 9, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.unary add1 (tensor.buf b);
    let t = tensor.mr_tileable @2 @(2, 0) ((2, 9), (0, 1), (2, 9)) (add, 0I32, tensor.id) po (po, po) (r, p);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

extern fun plain (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (tensor.buf a, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

// WARN-DAG: compute_at of input 0 inside dim 0 of {{.*}} not realized: the box does not start at the read of the corner
// WARN-DAG: compute_at of input 1 inside dim 0 of {{.*}} not realized: a box may leave the input
// WARN-DAG: compute_at inside input 0 of {{.*}} not realized: the input is computed one tile at a time
// WARN-DAG: compute_at of input 1 inside dim 0 of {{.*}} not realized: the input is not a map_reduce_post
// WARN-DAG: compute_at of input 0 inside dim 0 of {{.*}} not realized: the input's shape is not the producer's

// Every producer runs inside its consumer's nest on a tile buffer of the box's static size — a row «1, 6»
// (folded to «6»), three input rows «1, 2, 3, 6» of the convolution (folded to «2, 3, 6») — which lands on
// the stack; no buffer of a whole producer remains.
// CHECK-DAG: mem.mslot («6; I32», 0)
// CHECK-DAG: mem.mslot («2, 3, 6; I32», 0)
// CHECK-DAG: mem.mslot («2; I32», 0)
// CHECK-DAG: mem.mslot («7; I32», 0)
// CHECK-DAG: mem.mslot («9; I32», 0)
// CHECK-DAG: mem.{{m?slot|malloc}} («3, 6; I32», 0)
// FULL-NOT: mem.{{m?slot|malloc}} («4, 6; I32»
// FULL-NOT: mem.{{m?slot|malloc}} («2, 2, 6, 6; I32»
// FULL-NOT: mem.{{m?slot|malloc}} («4; I32»
// FULL-NOT: mem.{{m?slot|malloc}} («3; I32»
// FULL-NOT: mem.{{m?slot|malloc}} («4, 7; I32»
