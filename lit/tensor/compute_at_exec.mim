// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/compute_at_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=FULL
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --check-prefix=WARN
// RUN: %mim -p opt %s -o - | %FileCheck %s --check-prefix=SHARED

// `tensor.compute_at` end to end, driven by compute_at_aux.cpp against a scalar reference:
// * `mm_at0`:  (a + 1) · b with a + 1 computed one row «1, 6» per iteration of i.
// * `mm_at1`:  the same inside the loop of j, i.e. recomputed per output cell.
// * `conv_at`: a 3×3 convolution of x + 1, computed per output row: three input rows «1, 2, 3, 6», the halo.
// * `red_at`:  s[i] · b[i, j] with the row sum s[i] = Σ_k a[i, k] computed per row: a reduction producer.
// * `rep_at`:  y[i] = (x + 1)[i floordiv 16] with i split 64 = 8 × 8, per outer i: an aligned box «1».
// * `grp_at`:  y[c] = x[c] + (g + 1)[c floordiv 16] with c split 48 = 2 × 24, per outer c: boxes of 2 that overlap.
// * `edge_at`: y[c] = x[c] + (g + 1)[c floordiv 5] with c split 24 = 3 × 8: the last box of 3 would leave g, so it is
//   computed up to g's end.
// * `rev_at`:  P read reversed, P[i, 5 − k]: the box does not start at the corner's read, so warned and whole.
// * `chain_at`: Q at i of P, P at i of C: Q is computed one row «11» at a time inside each of P's tiles.
// * `two_at`:   C = P · Q with both producers inside the loop of j: a row «7» of P and a column «7» of Q.
// * `fuse_at`:  tile_and_fuse at i over Q → P = Q · B → C = P · E: a row «10» of P, ahead of it a row «13» of Q.
// * `fuse_tile`: tiles of 2 rows of the same chain: strip-mine i, then tile_and_fuse into the outer loop computes a
//   tile «2, 10» of P and ahead of it «2, 13» of Q.
// * `fuse_lim`: the same per cell of C within a budget of 1: a row of P per cell recomputes P 3 times, so it stays
//   whole, and with it Q.
// * `back_at`: P read at row (i − 5) + 5, whose Nat bounds must not saturate at the intermediate i − 5.
// * `fused_at`: C = Σ_k (x + y)[i, j, k] · P[i, k], P at i: fuse_tensor splices x + y into two inputs, so P moves to slot 2.
// * `fold_at`: a producer of «1, 5» read as «5, 1», one type as unit axes fold: warned, and read as `fold_plain` reads it.
// * `epi_at`: C = R + P with R a reduction and P at i: epilogue fusion would sink C into R, dropping the schedule.
// * `inl_at`: R[i] = Σ_j P[i, j] over P = Q + B with Q at i of P: fusing P into R would drop P's schedule.
// * `split_mm`: (a + 1) · b with i split 8 = 4 × 2 by split_par: the result keeps its shape «8, 5».
// * `split_at`: the same with a + 1 inside the loop of the outer i: a tile «2, 7» of it per pair of rows.
// * `tail_mm`: (a + 1) · b with i split 7 = 3 × 3 by split_par: the last tile has a single row.
// * `tail_at`: the same with a + 1 inside the loop of the outer i: a tile «3, 9» per tile of rows, the last cut to
//   the one row left.
// * `tail_perm`: the split interchanged to (j, i₀, i₁, k): the tail moves with its dims.
// * `fuse_tail`: tile_and_fuse into the tiles of 3 rows of 7 over Q → P = Q · B → C = P · E: tiles «3, 9» of P and
//   «3, 12» of Q, the last ones cut short.
// * `shared_at`: C · Dᵀ with C = P · B computing P at i and D = P · E reading it whole: P's rows go into its one
//   whole buffer «5, 14», which D reads once C has filled it.
// * `rev_rowsum`: C[i] = Σ_j (A · B)[i, j] with C inside the loop of i of the product: a row of C per row of it.
// * `rev_ew`:   C = P + 1 inside the loop of i of the reduction P.
// * `rev_halo`: C[i, j] = Σ_k P[i + k, j] reads three rows of P: no part of C reads one row only, so warned.
// * `tfb`: tile_and_fuse_by C = (Q · B) · E of 7 × 5 by tiles (3, 2), neither dividing: per tile a tile «3, 17» of P
//   and ahead of it «3, 15» of Q, the last tiles cut short.
// * `plain`:   an input that no map_reduce_post computes cannot be computed at a loop: warned, and read as is.
plugin core;
plugin tensor;
plugin affine;

use core.ops.u.w;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mul (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun sum (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add1 (x: I32): I32 = x + 1I32;
lam add2 (x y: I32): I32 = x + y;

lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

extern fun mm_at0 (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun mm_at1 (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 1)));

lam co (n c oh ow _ _ _: affine.Index): «4; affine.Index» = (n, c, oh, ow);
lam cx (n _ oh ow ci kh kw: affine.Index): «4; affine.Index» = (n, ci, affine.op.add (oh, kh), affine.op.add (ow, kw));
lam cw (_ c _ _ ci kh kw: affine.Index): «4; affine.Index» = (c, ci, kh, kw);

extern fun conv_at (x: «2, 2, 6, 6; I32», w: «3, 2, 3, 3; I32»): «2, 3, 4, 4; I32» =
    let p = tensor.unary add1 (tensor.buf x);
    let t = tensor.mr_tileable @2 @(4, 3) ((2, 3, 4, 4), (0, 1, 2, 3), (2, 3, 4, 4, 2, 3, 3))
                (mac, 0I32, tensor.id) co (cx, cw) (p, tensor.buf w);
    return (tensor.materialize (tensor.compute_at (t, 0, 2)));

lam ro (i _: affine.Index): affine.Index = i;
lam ri (i k: affine.Index): «2; affine.Index» = (i, k);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;

extern fun red_at (a: «4, 6; I32», b: «4, 5; I32»): «4, 5; I32» =
    let s = tensor.materialize (tensor.mr_tileable @1 @(1, 1) (4, 0, (4, 6)) (sum, 0I32, tensor.id) ro ri (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 0) ((4, 5), (0, 1), (4, 5)) (mul, 0I32, tensor.id) po (ro, po) (s, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

fun inc (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun add (_: I32, (x y: I32))@tt: I32 = return (x + y);
lam m1  (i: affine.Index): affine.Index = i;
lam d16 (i: affine.Index): affine.Index = affine.semiop.floordiv (i, 16);

extern fun rep_at (x: «4; I32»): «8, 8; I32» =
    let p = tensor.unary add1 (tensor.buf x);
    let t = tensor.mr_tileable @1 @(1, 0) (64, 0, 64) (inc, 0I32, tensor.id) m1 d16 p;
    return (tensor.materialize (tensor.compute_at (tensor.strip_mine_par (t, 0, 8), 0, 0)));

extern fun grp_at (x: «48; I32», g: «3; I32»): «2, 24; I32» =
    let p = tensor.unary add1 (tensor.buf g);
    let t = tensor.mr_tileable @2 @(1, 0) (48, 0, 48) (add, 0I32, tensor.id) m1 (m1, d16) (tensor.buf x, p);
    return (tensor.materialize (tensor.compute_at (tensor.strip_mine_par (t, 0, 24), 1, 0)));

lam d5 (i: affine.Index): affine.Index = affine.semiop.floordiv (i, 5);

fun add64 (_: I64, (x y: I64))@tt: I64 = return (x + y);
lam inc64 (x: I64): I64 = x + 1I64;

extern fun edge_at (x: «24; I64», g: «5; I64»): «3, 8; I64» =
    let p = tensor.unary inc64 (tensor.buf g);
    let t = tensor.mr_tileable @2 @(1, 0) (24, 0, 24) (add64, 0I64, tensor.id) m1 (m1, d5) (tensor.buf x, p);
    return (tensor.materialize (tensor.compute_at (tensor.strip_mine_par (t, 0, 8), 1, 0)));

lam qo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam mr (i _ k: affine.Index): «2; affine.Index» = (i, affine.op.sub (affine.lit 5, k));

extern fun rev_at (a: «3, 6, 2; I32», b: «6, 5; I32»): «3, 5; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((3, 6), (0, 1), (3, 6, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 6)) (mac, 0I32, tensor.id) mo (mr, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun chain_at (a: «3, 11, 2; I32», b: «11, 5; I32», e: «5, 3; I32»): «3, 3; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((3, 11), (0, 1), (3, 11, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.compute_at (tensor.mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 11)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b), 0, 0));
    let t = tensor.mr_tileable @2 @(2, 1) ((3, 3), (0, 1), (3, 3, 5)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun two_at (a: «3, 7, 2; I32», b: «7, 4, 2; I32»): «3, 4; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((3, 7), (0, 1), (3, 7, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((7, 4), (0, 1), (7, 4, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((3, 4), (0, 1), (3, 4, 7)) (mac, 0I32, tensor.id) mo (ma, mb) (p, q);
    return (tensor.materialize (tensor.compute_at (tensor.compute_at (t, 0, 1), 1, 1)));

extern fun fuse_at (a: «3, 13, 2; I32», b: «13, 10; I32», e: «10, 2; I32»): «3, 2; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((3, 13), (0, 1), (3, 13, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((3, 10), (0, 1), (3, 10, 13)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((3, 2), (0, 1), (3, 2, 10)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.tile_and_fuse (t, 0, 1)));

extern fun fuse_tile (a: «4, 13, 2; I32», b: «13, 10; I32», e: «10, 2; I32»): «2, 2, 2; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((4, 13), (0, 1), (4, 13, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((4, 10), (0, 1), (4, 10, 13)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 2), (0, 1), (4, 2, 10)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.tile_and_fuse (tensor.strip_mine_par (t, 0, 2), 0, 1)));

extern fun fuse_lim (a: «2, 5, 2; I32», b: «5, 7; I32», e: «7, 3; I32»): «2, 3; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((2, 5), (0, 1), (2, 5, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((2, 7), (0, 1), (2, 7, 5)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((2, 3), (0, 1), (2, 3, 7)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.tile_and_fuse (t, 1, 1)));

lam mback (i _ k: affine.Index): «2; affine.Index» = (affine.op.add (affine.op.sub (i, affine.lit 5), affine.lit 5), k);

extern fun back_at (a: «4, 6, 2; I32», b: «6, 5; I32»): «4, 5; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((4, 6), (0, 1), (4, 6, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (mback, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

lam m3 (o: «3; affine.Index»): «3; affine.Index» = o;

extern fun fused_at (x y: «4, 5, 7; I32», a: «4, 7, 2; I32»): «4, 5; I32» =
    let s = tensor.binary add2 (tensor.buf x, tensor.buf y);
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((4, 7), (0, 1), (4, 7, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 7)) (mac, 0I32, tensor.id) mo (m3, ma) (s, p);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

extern fun fold_at (x: «1, 5; I32»): «5; I32» =
    let p: «5, 1; I32» = tensor.materialize (tensor.mr_tileable @1 @(2, 0) ((1, 5), (0, 1), (1, 5)) (inc, 0I32, tensor.id) po po (tensor.buf x));
    let t = tensor.mr_tileable @1 @(1, 1) (5, 0, (5, 1)) (sum, 0I32, tensor.id) ro ri p;
    return (tensor.materialize (tensor.compute_at (t, 0, 0)));

extern fun fold_plain (x: «1, 5; I32»): «5; I32» =
    let p: «5, 1; I32» = tensor.materialize (tensor.mr_tileable @1 @(2, 0) ((1, 5), (0, 1), (1, 5)) (inc, 0I32, tensor.id) po po (tensor.buf x));
    return (tensor.materialize (tensor.mr_tileable @1 @(1, 1) (5, 0, (5, 1)) (sum, 0I32, tensor.id) ro ri p));

extern fun epi_at (a: «2, 9, 2; I32», b: «2, 9; I32»): «2, 9; I32» =
    let r = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((2, 9), (0, 1), (2, 9, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.unary add1 (tensor.buf b);
    let t = tensor.mr_tileable @2 @(2, 0) ((2, 9), (0, 1), (2, 9)) (add, 0I32, tensor.id) po (po, po) (r, p);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

lam rj2 (i j: affine.Index): «2; affine.Index» = (i, j);

extern fun inl_at (a: «5, 8, 2; I32», b: «5, 8; I32»): «5; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((5, 8), (0, 1), (5, 8, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.compute_at (tensor.mr_tileable @2 @(2, 0) ((5, 8), (0, 1), (5, 8)) (add, 0I32, tensor.id) po (po, po) (q, tensor.buf b), 0, 0));
    return (tensor.materialize (tensor.mr_tileable @1 @(1, 1) (5, 0, (5, 8)) (sum, 0I32, tensor.id) ro rj2 p));

extern fun split_mm (a: «8, 7; I32», b: «7, 5; I32»): «8, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((8, 5), (0, 1), (8, 5, 7)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.split_par (t, 0, 2)));

extern fun split_at (a: «8, 7; I32», b: «7, 5; I32»): «8, 5; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((8, 5), (0, 1), (8, 5, 7)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (tensor.split_par (t, 0, 2), 0, 0)));

extern fun tail_mm (a: «7, 9; I32», b: «9, 3; I32»): «7, 3; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((7, 3), (0, 1), (7, 3, 9)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.split_par (t, 0, 3)));

extern fun tail_at (a: «7, 9; I32», b: «9, 3; I32»): «7, 3; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((7, 3), (0, 1), (7, 3, 9)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (tensor.split_par (t, 0, 3), 0, 0)));

extern fun tail_perm (a: «7, 9; I32», b: «9, 3; I32»): «7, 3; I32» =
    let p = tensor.unary add1 (tensor.buf a);
    let t = tensor.mr_tileable @2 @(2, 1) ((7, 3), (0, 1), (7, 3, 9)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b);
    return (tensor.materialize (tensor.interchange (tensor.split_par (t, 0, 3), (2, 0, 1, 3))));

extern fun fuse_tail (a: «7, 12, 2; I32», b: «12, 9; I32», e: «9, 2; I32»): «7, 2; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((7, 12), (0, 1), (7, 12, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((7, 9), (0, 1), (7, 9, 12)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((7, 2), (0, 1), (7, 2, 9)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.tile_and_fuse (tensor.split_par (t, 0, 3), 0, 2)));

lam mdt (_ j k: affine.Index): «2; affine.Index» = (j, k);

extern fun shared_at (a: «5, 14, 2; I32», b e: «14, 3; I32»): «5, 5; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((5, 14), (0, 1), (5, 14, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let c = tensor.materialize (tensor.compute_at (tensor.mr_tileable @2 @(2, 1) ((5, 3), (0, 1), (5, 3, 14)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf b), 0, 0));
    let d = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((5, 3), (0, 1), (5, 3, 14)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e));
    return (tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((5, 5), (0, 1), (5, 5, 3)) (mac, 0I32, tensor.id) mo (ma, mdt) (c, d)));

lam rv1 (i _: affine.Index): affine.Index = i;
lam rv2 (i k: affine.Index): «2; affine.Index» = (i, k);
lam rvh (i j k: affine.Index): «2; affine.Index» = (affine.op.add (i, k), j);

extern fun rev_rowsum (a: «6, 5; I32», b: «5, 7; I32»): «6; I32» =
    let p = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (mac, 0I32, tensor.id) mo (ma, mb) (tensor.buf a, tensor.buf b));
    let t = tensor.mr_tileable @1 @(1, 1) (6, 0, (6, 7)) (sum, 0I32, tensor.id) rv1 rv2 p;
    return (tensor.materialize (tensor.reverse_compute_at (t, 0, 0)));

extern fun rev_ew (a: «6, 7, 2; I32»): «6, 7; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((6, 7), (0, 1), (6, 7, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @1 @(2, 0) ((6, 7), (0, 1), (6, 7)) (inc, 0I32, tensor.id) po po p;
    return (tensor.materialize (tensor.reverse_compute_at (t, 0, 0)));

extern fun rev_halo (a: «6, 8, 2; I32»): «4, 8; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((6, 8), (0, 1), (6, 8, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let t = tensor.mr_tileable @1 @(2, 1) ((4, 8), (0, 1), (4, 8, 3)) (sum, 0I32, tensor.id) mo rvh p;
    return (tensor.materialize (tensor.reverse_compute_at (t, 0, 0)));

extern fun tfb (a: «7, 15, 2; I32», b: «15, 17; I32», e: «17, 5; I32»): «7, 5; I32» =
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((7, 15), (0, 1), (7, 15, 2)) (sum, 0I32, tensor.id) qo pa (tensor.buf a));
    let p = tensor.materialize (tensor.mr_tileable @2 @(2, 1) ((7, 17), (0, 1), (7, 17, 15)) (mac, 0I32, tensor.id) mo (ma, mb) (q, tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((7, 5), (0, 1), (7, 5, 17)) (mac, 0I32, tensor.id) mo (ma, mb) (p, tensor.buf e);
    return (tensor.materialize (tensor.tile_and_fuse_by (t, (3, 2), 4)));

extern fun plain (a: «4, 6; I32», b: «6, 5; I32»): «4, 5; I32» =
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) mo (ma, mb) (tensor.buf a, tensor.buf b);
    return (tensor.materialize (tensor.compute_at (t, 1, 0)));

