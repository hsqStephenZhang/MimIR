// RUN: %mim -p opt -p clos %s -p ll -X ll:o=%t.ll
// RUN: clang++ -std=c++23 %S/partition_iter_aux.cpp %t.ll -o %t -Wno-override-module
// RUN: MIM_NUM_THREADS=4 %t
// RUN: MIM_NUM_THREADS=1 %t

plugin core;
plugin tensor;
plugin affine;
use core.ops.u.w;
use tensor;
fun add (x y: I32)@tt: I32 = return (x + y);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam mi (o: «3; affine.Index»): «3; affine.Index» = o;
lam rows (input: «5, 7, 13; I32») =
    mr_tileable @1 @(2, 1) ((5, 7), (0, 1), (5, 7, 13)) (add, 0I32, id) mo mi (buf input);

// Non-divisible spatial and reduction blocks preserve the original output layout.
extern fun masked_rows (input: «5, 7, 13; I32»): «5, 7; I32» =
    let t = partition_iter (partition_iter (rows input, 0, 4), 2, 3);
    let t = interchange (t, (0, 2, 1, 3, 4));
    let t = fuse_iter (t, 0);
    let t = partition_iter (t, 3, 4);
    return (materialize (parallelize (vectorize (unroll_trailing (t, 1), 1), 0)));

// Nested padding must preserve the intermediate bound 8: an extra lane cannot alias the next tile.
extern fun nested_padding (input: «5, 7, 13; I32»): «5, 7; I32» =
    let t = partition_iter (fuse_iter (rows input, 0), 0, 8);
    let t = partition_iter (t, 1, 3);
    let t = interchange (t, (1, 0, 2, 3));
    let t = fuse_iter (fuse_iter (t, 0), 0);
    let t = partition_iter (t, 1, 4);
    let t = fuse_iter (t, 1);
    return (materialize (parallelize (t, 0)));

// Nested reduction padding cannot double-count a lane that aliases the next K block.
extern fun nested_reduction (input: «5, 7, 13; I32»): «5, 7; I32» =
    let t = partition_iter (partition_iter (rows input, 2, 8), 3, 3);
    let t = fuse_iter (fuse_iter (t, 2), 2);
    let t = split_iter (t, 2, 3);
    return (materialize (parallelize (t, 0)));

// Spatial and fold predicates also survive producer epilogue fusion.
lam inc (x: I32): I32 = x + 1000I32;
extern fun masked_epilogue (input: «5, 7, 13; I32»): «5, 7; I32» =
    let t = partition_iter (partition_iter (rows input, 0, 4), 3, 4);
    return (unary inc (materialize (parallelize (t, 0))));

// Extra epilogue inputs must also stay behind the spatial guard.
lam bias_add (x y: I32): I32 = x + y;
extern fun masked_bias (input: «5, 7, 13; I32», bias: «5, 7; I32»): «5, 7; I32» =
    let t = partition_iter (partition_iter (rows input, 0, 4), 3, 4);
    return (binary bias_add (materialize (parallelize (t, 0)), buf bias));

// A zero reduction extent over a nonempty input ABI still writes init for every valid output cell.
extern fun empty_reduction (input: «5, 7, 1; I32»): «5, 7; I32» =
    let t = mr_tileable @1 @(2, 1) ((5, 7), (0, 1), (5, 7, 0)) (add, 37I32, id) mo mi (buf input);
    return (materialize (parallelize (partition_iter (partition_iter (t, 0, 4), 3, 4), 0)));

fun madd (acc: I32, ab: «2; I32»)@tt: I32 = return (acc + ab#0_2 * ab#1_2);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
extern fun masked_gemm (a: «5, 13; I32», b: «13, 19; I32»): «5, 19; I32» =
    let t = mr_tileable @2 @(2, 1) ((5, 19), (0, 1), (5, 19, 13)) (madd, 0I32, id) mo (ma, mb) (buf a, buf b);
    let t = partition_iter (partition_iter (t, 0, 4), 2, 16);
    let t = fuse_iter (interchange (t, (0, 2, 1, 3, 4)), 0);
    let t = partition_iter (t, 3, 4);
    return (materialize (parallelize (vectorize (unroll_trailing (t, 1), 1), 0)));
