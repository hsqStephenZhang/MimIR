// RUN: %mim -VVV -p opt -X tensor:pe-fuse=2 -X tensor:cpu-mc=8 -X tensor:cpu-nc=16 %s -p ll -X ll:asan=1 -X ll:o=%t0.ll -o %t0.mim 2>&1 | %FileCheck %s
// RUN: clang++ -O2 -fsanitize=address %S/pe_fuse_more_aux.cpp %t0.ll -o %t0.exec -Wno-override-module
// RUN: %t0.exec
// RUN: %mim -VVV -p opt %s -p ll -X ll:asan=1 -X ll:o=%t1.ll -o %t1.mim 2>&1 | %FileCheck %s --check-prefix=POLICY
// RUN: clang++ -O2 -fsanitize=address %S/pe_fuse_more_aux.cpp %t1.ll -o %t1.exec -Wno-override-module
// RUN: %t1.exec
// RUN: %mim -p opt -X tensor:pe-fuse=0 %s -p ll -X ll:asan=1 -X ll:o=%t2.ll -o %t2.mim
// RUN: clang++ -O2 -fsanitize=address %S/pe_fuse_more_aux.cpp %t2.ll -o %t2.exec -Wno-override-module
// RUN: %t2.exec

// Producers beyond a plain map-reduce: one that permutes its output loops, one with an epilogue, and a constant pad.
// By default, `tensor.fuse_policy` stages none of them in a contraction, only the pad in the elementwise map.
// POLICY-NOT: fuse the map-reduce
// POLICY:     fuse the pad of (37, 20) into its consumer
// POLICY-NOT: fuse the
// CHECK-DAG: fuse the map-reduce over (40, 36, 24) into its consumer
// CHECK-DAG: fuse the map-reduce over (40, 36, 24) into its consumer
// CHECK-DAG: fuse the pad of (37, 20) into its consumer
// CHECK-DAG: fuse the pad of (37, 20) into its consumer
plugin tensor;
plugin core;
plugin math;
plugin affine;

let F32 = math.F32;
let Ix  = affine.Index;
let R: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);

fun mac (acc: F32, (x y: F32))@tt: F32 = return (math.arith.add math.mode.contract (acc, math.arith.mul math.mode.contract (x, y)));
lam relu (x: F32): F32 = math.extrema.fmax 0 (x, 0:F32);

// E = (A·B)ᵀ·D with the transposed product written by a permuted output map.
extern fun perm_mm (a: tensor.Tensor 2 (40, 24) F32, b: tensor.Tensor 2 (24, 36) F32, d: tensor.Tensor 2 (40, 20) F32): tensor.Tensor 2 (36, 20) F32 =
    let pt = tensor.map_reduce ((36, 40), (40, 36, 24)) (mac, 0:F32) (tensor.proj_map (1, 0))
        (tensor.proj_map (0, 2), tensor.proj_map (2, 1)) (a, b);
    return (tensor.product_2d R (pt, d));

// E = relu(A·B)·D with relu as the epilogue of the inner product.
extern fun relu_chain (a: tensor.Tensor 2 (40, 24) F32, b: tensor.Tensor 2 (24, 36) F32, d: tensor.Tensor 2 (36, 20) F32): tensor.Tensor 2 (40, 20) F32 =
    return (tensor.product_2d R (tensor.unary relu (tensor.product_2d R (a, b)), d));

// C = pad(A)·B.
extern fun pad_mm (a: tensor.Tensor 2 (37, 20) F32, b: tensor.Tensor 2 (24, 19) F32): tensor.Tensor 2 (40, 19) F32 =
    return (tensor.product_2d R (tensor.pad (37, 20) (0, (2, 1), (1, 3)) (a, 0.5:F32), b));

// relu(pad(A)).
extern fun pad_relu (a: tensor.Tensor 2 (37, 20) F32): tensor.Tensor 2 (40, 24) F32 =
    return (tensor.unary relu (tensor.pad (37, 20) (0, (2, 1), (1, 3)) (a, -0.5:F32)));
