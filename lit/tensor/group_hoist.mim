// RUN: %mim -p opt -p ll %s -X ll:o=%t.ll -V -V -V -V 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: sed 's/(p):/(_):/' %s > %t.bad.mim
// RUN: (! %mim %t.bad.mim 2>&1) | %FileCheck %s --check-prefix=CAPTURE

plugin tensor;
plugin math;
plugin core;
use tensor;
let F32 = math.F32;
let mode = math.mode.fast;
let Ring = (F32, 0.0:F32, math.arith.add mode, math.arith.mul mode);

extern fun rows (a: tensor.Tensor 2 (64, 96) F32, b: tensor.Tensor 2 (96, 128) F32): tensor.Tensor 2 (64, 128) F32 =
    let p = product_2d Ring (buf a, buf b);
    return (tiled ((64, 128), (2, 128), 1)
        p
        (λ (off ext: «2; Nat») (p): tensor.Tensor 2 ext F32 = slice @(F32, 2) (64, 128) (off, (1, 1), ext) p));

extern fun recomputed_rows (a: tensor.Tensor 2 (64, 96) F32, b: tensor.Tensor 2 (96, 128) F32): tensor.Tensor 2 (64, 128) F32 =
    return (tiled ((64, 128), (2, 128), 1)
        (a, b)
        (λ (off ext: «2; Nat») (a: tensor.Tensor 2 (64, 96) F32, b: tensor.Tensor 2 (96, 128) F32): tensor.Tensor 2 ext F32 =
            tile_of (product_2d Ring (buf a, buf b), off, ext)));

// CHECK: tensor.group contraction {{.*}}: MR=
// CHECK-NOT: tensor.group contraction
// CAPTURE: tensor region operation tensor.slice reads outer tensor input p
// CAPTURE-SAME: pass it explicitly
