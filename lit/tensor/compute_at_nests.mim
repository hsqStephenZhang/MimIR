// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"

// (A + 1) · B with A + 1 computed at a loop that a vector nest runs inside the reduction loops, against the unscheduled
// ops; the tile is computed once per iteration of each loop around it, those of k included.
// * `v`: vectorized over j, at j.
// * `p`, `q`: blocked with i jammed into the vector loop over j, at i and at j.
// * `w`: the contraction vectorized with j jammed into it, at j.
// * `h`: K blocks hoisted outside j, vectorized over j, at j.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac2 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac3 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac4 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac5 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun inc1 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc2 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc3 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc4 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc5 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc9 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;

let a = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));

lam ew (f: Fn [I32, I32] → I32) = materialize (mr_tileable @1 @(2, 0) ((6, 5), (0, 1), (6, 5)) (f, 0I32, id) po po a);
lam prod (f: Fn [I32, «2; I32»] → I32) (g: Fn [I32, I32] → I32) =
    mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (ma, mb) (ew g, buf b);
lam diff (u v: «6, 7; I32»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let v = materialize (compute_at (vectorize (prod mac1 inc1, 1), 0, 1));
    let p = materialize (compute_at (vectorize (prod mac2 inc2, 0), 0, 0));
    let q = materialize (compute_at (vectorize (prod mac5 inc5, 0), 0, 1));
    let w = materialize (compute_at (unroll_trailing (vectorize (prod mac3 inc3, 2), 1), 0, 1));
    let h = materialize (compute_at (hoist_red (vectorize (strip_mine_red (prod mac4 inc4, 2, 5), 1), 1, 1), 0, 1));
    let r = materialize (prod mac9 inc9);
    return (m, diff (v, r) + diff (p, r) + diff (q, r) + diff (w, r) + diff (h, r));
