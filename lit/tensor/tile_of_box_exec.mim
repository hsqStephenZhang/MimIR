// RUN: %mim -p opt %s -p ll
// RUN: clang++ -O3 -fsanitize=address %S/tile_of_box_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -X tensor:reference-tiles=1 -p opt %s -p ll
// RUN: clang++ -O3 -fsanitize=address %S/tile_of_box_aux.cpp %{s:stem}.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

plugin tensor;
plugin core;
plugin affine;
use tensor;

fun scale (_ x: I64)@tt: I64 = return (core.wrap.mul 0 (x, 3I64));
extern fun edge (input: «7; I64», off: Nat): I64 =
    let p = map_reduce (7, 7) (scale, 0I64) (affine.id @1) (affine.id @1,) (buf input);
    let size = core.nat.sub (7, off);
    let values = tile_of_box (p, off, size, 3);
    return (core.wrap.add 0 (values#(core.idx 0 size 0), values#(core.idx 0 size (core.nat.sub (size, 1)))));

extern fun tiles (input: «7; I64»): «7; I64» =
    let p = map_reduce (7, 7) (scale, 0I64) (affine.id @1) (affine.id @1,) (buf input);
    return (tiled @(I64, 1) (7, 3)
        (λ (off ext: «1; Nat»): «ext; I64» = tile_of_box (p, off, ext, ext)));
