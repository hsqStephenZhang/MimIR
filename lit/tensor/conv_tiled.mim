// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// `conv` through `conv_schedule_tiled` against the unscheduled op, for shapes `chk` with a last block of output
// channels and of columns cut short, channel blocks of 1, 2 and 4, and stride 2.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x w: I32))@tt: I32 = return (acc + x * w);
lam add (x y: I32): I32 = x + y;
lam mul (x y: I32): I32 = x * y;
let Ring = (I32, 0I32, add, mul);
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam out (n co oh ow _ _ _: affine.Index): «4; affine.Index» = (n, co, oh, ow);
lam wt (_ co _ _ ci kh kw: affine.Index): «4; affine.Index» = (co, ci, kh, kw);
lam inp (s: Nat) (n _ oh ow ci kh kw: affine.Index): «4; affine.Index» =
    (n, ci, affine.op.add (affine.semiop.mul (oh, s), kh), affine.op.add (affine.semiop.mul (ow, s), kw));

lam chk (n ci co h w kh kw s p: Nat): I32 =
    let a      = generate (n, ci, h, w) (λ i: «4; I64»: I32 =
                     core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#2_4), core.bit2.and 0 (core.wrap.add 0 (i#1_4, i#3_4), 7I64))));
    let b      = generate (co, ci, kh, kw) (λ i: «4; I64»: I32 =
                     core.conv.s 4294967296 (core.wrap.sub 0 (core.bit2.and 0 (core.wrap.add 0 (i#0_4, i#1_4), 3I64), i#3_4)));
    let lohi   = (0, 0, p, p);
    let padded = pad (n, ci, h, w) (0, lohi, lohi) (a, 0I32);
    let so     = conv_shape (n, co, (h, w), (kh, kw), (s, s), (1, 1), (p, p));
    let ref    = materialize (mr_tileable @2 @(4, 3) (so, (0, 1, 2, 3), (so#0_4, so#1_4, so#2_4, so#3_4, ci, kh, kw))
                     @((I32, I32), (4, 4), (shape 4 padded, (co, ci, kh, kw)))
                     (mac, 0I32, id) out (inp s, wt) (padded, buf b));
    let res    = conv Ring ((s, s), (1, 1), (p, p)) (buf a, buf b);
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (reduce (add, 0I32) 2₃ (reduce (add, 0I32) 3₄ (binary ne (res, ref)))));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    return (m, chk (2, 6, 12, 7, 10, 3, 3, 1, 1) + chk (2, 5, 9, 4, 8, 3, 3, 1, 1)
               + chk (2, 4, 8, 9, 19, 3, 3, 2, 1));
