// RUN: %mim -p opt -p ll -X tensor:group=0 -X tensor:strict=1 -X ll:o=%t.ll %s -V -V -V -V 2> %t.log
// RUN: %FileCheck %s < %t.log

plugin tensor;
plugin core;
plugin affine;
use tensor;
fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));
lam packed (i j k _: affine.Index): «3; affine.Index» =
    let merged = affine.op.add (i, j);
    (affine.semiop.floordiv (merged, 1), affine.semiop.rem (merged, 1), k);
extern fun origin (x: tensor.Tensor 4 (4, 1, 5, 3) I64): tensor.Tensor 3 (4, 1, 5) I64 =
    let p = map_reduce ((4, 1, 5), (4, 1, 5, 3)) (add, 0I64) packed (affine.id @4,) (buf x);
    return (tiled @(I64, 3) ((4, 1, 5), (4, 1, 3), 1)
        x
        (λ (off ext: «3; Nat») (x): tensor.Tensor 3 ext I64 =
            let p = map_reduce ((4, 1, 5), (4, 1, 5, 3)) (add, 0I64) packed (affine.id @4,) (buf x);
            tile_of_box @(I64, 3) @(4, 1, 5) (p, off, ext, (4, 1, 3))));

// CHECK-NOT: tensor destination fallback
// CHECK: finish phase `tensor.lower_to_mem`
// CHECK-NOT: tensor destination fallback
