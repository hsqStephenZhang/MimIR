// RUN: %mim -p opt -p clos -X tensor:threads=4 --max-fp-iters 32 %s -p ll
// RUN: %FileCheck %s  < %{s:stem}.ll
// RUN: clang++ -std=c++23 %S/dot_par_masked_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: MIM_NUM_THREADS=4 %t
// RUN: MIM_NUM_THREADS=2 %t
// RUN: MIM_NUM_THREADS=1 %t

// Non-divisible K uses composed predicates on the fused parallel task grid.
// Full packed B remains immutable and shared; no worker-local writable scratch is shared.

plugin tensor;
plugin core;
plugin math;
plugin affine;

let F32 = math.F32;
let R: tensor.Ring = (F32, 0:F32, math.arith.add 0, math.arith.mul 0);

// CHECK-COUNT-4: call void @mim_rt_parallel_for
extern fun mm49 (a: «64, 49; F32», b: «49, 1024; F32»): «64, 1024; F32» = return (tensor.product_2d R (a, b));
extern fun mm65 (a: «32, 65; F32», b: «65, 512; F32»): «32, 512; F32» = return (tensor.product_2d R (a, b));
extern fun mm130 (a: «64, 130; F32», b: «130, 512; F32»): «64, 512; F32» = return (tensor.product_2d R (a, b));

fun madd (acc: F32, ab: «2; F32»)@tt: F32 = return (math.arith.add 0 (acc, math.arith.mul 0 (ab#0_2, ab#1_2)));
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
// Spatial tails are an explicit schedule until their guarded micro-kernel improves on serial defaults.
extern fun mm_spatial (a: «101, 17; F32», b: «17, 1001; F32»): «101, 1001; F32» =
    let t = tensor.mr_tileable @2 @(2, 1) ((101, 1001), (0, 1), (101, 1001, 17)) (madd, 0:F32, tensor.id)
        mo (ma, mb) (tensor.buf a, tensor.buf b);
    let t = tensor.partition_iter (tensor.partition_iter (t, 0, 4), 2, 16);
    let t = tensor.fuse_iter (tensor.interchange (t, (0, 2, 1, 3, 4)), 0);
    let t = tensor.partition_iter (t, 3, 4);
    return (tensor.materialize (tensor.parallelize (tensor.vectorize (tensor.unroll_trailing (t, 1), 1), 0)));
