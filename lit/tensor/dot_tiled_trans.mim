// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s -X tensor:gemm-mr=4 -X tensor:gemm-nr=16 -X tensor:gemm-kc=32 -X tensor:gemm-nc=64
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -X tensor:gemm-mr=4 -X tensor:gemm-nr=16 -X tensor:gemm-kc=32 -X tensor:gemm-nc=64 -o - | %FileCheck %s

// `product_2d` over transposed operands against the unscheduled product, for shapes `chk (m, k, n)` with a last block of
// rows, of columns and of K cut short: Aᵀ·Bᵀ, A·Bᵀ and Aᵀ·B.
// The transposes are read through, and a transposed B is copied per K block in the order the register block reads it:
// «32, 64», not as stored, «64, 32».
// The exit code counts the cells that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (k, i);
lam mb (_ j k: affine.Index): «2; affine.Index» = (j, k);
lam add (x y: I32): I32 = x + y;
let Ring = (I32, 0I32, add, λ (x y: I32): I32 = x * y);
lam diff {m n: Nat} (x y: «m, n; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (u v: I32): I32 = core.select (core.icmp.e (u, v), 0I32, 1I32)) (x, y)));
lam fa (r c: I64): I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, c), core.bit2.and 0 (r, 7I64)));
lam fb (r c: I64): I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.bit2.and 0 (c, 3I64), core.wrap.mul 0 (2I64, r)));
// One A and one B in both layouts: `at` is «k, m» and `a` «m, k», `bt` «n, k» and `b` «k, n»; the reference reads `at`
// and `bt` transposed through its maps.
lam chk (m k n: Nat): I32 =
    let at  = generate (k, m) (λ i: «2; I64»: I32 = fa (i#0_2, i#1_2));
    let a   = generate (m, k) (λ i: «2; I64»: I32 = fa (i#1_2, i#0_2));
    let bt  = generate (n, k) (λ i: «2; I64»: I32 = fb (i#0_2, i#1_2));
    let b   = generate (k, n) (λ i: «2; I64»: I32 = fb (i#1_2, i#0_2));
    let ref = materialize (mr_tileable @2 @(2, 1) ((m, n), (0, 1), (m, n, k)) (mac, 0I32, id) mo (ma, mb) (buf at, buf bt));
    diff (product_2d Ring (transpose_2d (buf at), transpose_2d (buf bt)), ref)
        + diff (product_2d Ring (buf a, transpose_2d (buf bt)), ref) + diff (product_2d Ring (transpose_2d (buf at), buf b), ref);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    return (m, chk (8, 64, 64) + chk (7, 100, 50) + chk (13, 130, 33));

// CHECK: mem.malloc («32, 64;
// CHECK-NOT: mem.malloc («64, 32;
