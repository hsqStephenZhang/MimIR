// RUN: %mim -VVV -p opt %s -p ll -X ll:o=%t.ll -o %t.mim 2>&1 | %FileCheck %s
// RUN: clang++ -O2 -fsanitize=address %S/pe_cpu_conv_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Convolutions tiled by run_levels as an implicit im2col; rows shorter than a register tile run their pixels as one loop (n, co, oh·ow | ci·kh·kw).
// CHECK-DAG: tile the contraction over (2, 11, 221, 45) with tensor.run_levels
// CHECK-DAG: tile the contraction over (1, 8, 64, 147) with tensor.run_levels
// CHECK-DAG: tile the contraction over (2, 12, 90, 16) with tensor.run_levels
// CHECK-DAG: tile the contraction over (1, 6, 168, 36) with tensor.run_levels
// CHECK-DAG: tile the contraction over (2, 9, 36, 54) with tensor.run_levels
plugin core;
plugin tensor;
plugin math;

let F32 = math.F32;
let R: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);

extern fun conv_pad (x: tensor.Tensor 4 (2, 5, 13, 17) F32, w: tensor.Tensor 4 (11, 5, 3, 3) F32): tensor.Tensor 4 (2, 11, 13, 17) F32 =
    return (tensor.conv R ((1, 1), (1, 1), (1, 1)) (x, w));

extern fun conv_stem (x: tensor.Tensor 4 (1, 3, 15, 16) F32, w: tensor.Tensor 4 (8, 3, 7, 7) F32): tensor.Tensor 4 (1, 8, 8, 8) F32 =
    return (tensor.conv R ((2, 2), (1, 1), (3, 3)) (x, w));

extern fun conv_1x1 (x: tensor.Tensor 4 (2, 16, 9, 10) F32, w: tensor.Tensor 4 (12, 16, 1, 1) F32): tensor.Tensor 4 (2, 12, 9, 10) F32 =
    return (tensor.conv R ((1, 1), (1, 1), (0, 0)) (x, w));

extern fun conv_dil (x: tensor.Tensor 4 (1, 4, 12, 14) F32, w: tensor.Tensor 4 (6, 4, 3, 3) F32): tensor.Tensor 4 (1, 6, 12, 14) F32 =
    return (tensor.conv R ((1, 1), (2, 2), (2, 2)) (x, w));

extern fun conv_s2 (x: tensor.Tensor 4 (2, 6, 11, 12) F32, w: tensor.Tensor 4 (9, 6, 3, 3) F32): tensor.Tensor 4 (2, 9, 6, 6) F32 =
    return (tensor.conv R ((2, 2), (1, 1), (1, 1)) (x, w));
