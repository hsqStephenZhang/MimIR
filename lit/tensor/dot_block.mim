// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s
// RUN: cat %t | %FileCheck %s --check-prefix=SCHED

// Cache blocking of a contraction (tensor.dot_schedule_nblk). The last output dim N is blocked by nc and its block
// loop runs outside the left operand's free dims, so the right operand's panel stays in cache for all of them.
// A contraction whose whole panel does not fit is blocked too and hoisted outside the left free dims
// (tensor.hoist_red), which the schedule carries as (vdim, unroll, tail, pout, rout) with rout = 1.
// Where the whole panel fits, the block is register-blocked instead (vdim = ro - 2).
// The packed output is reshaped back; lower_to_mem makes that reshape a view of the buffer.

plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin compile;

let R: tensor.Ring = (Nat, 0, core.nat.add, core.nat.mul);

// SCHED-DAG: {{mk[_a-zA-Z0-9]* \(3, 1, 0, 2, 0\)}}
// SCHED-DAG: {{mk[_a-zA-Z0-9]* \(3, 1, 0, 1, 1\)}}
// SCHED-DAG: {{mk[_a-zA-Z0-9]* \(3, 1, 0, 0, 0\)}}

// A conv-like product, (Cout, K) x (N, K, P): the batch and the P blocks outside Cout, K = 96 fits whole.
// CHECK-LABEL: extern fun conv
// CHECK: tensor.map_reduce_post @ (2, 0) {{.*}} ((6, 2, 5, 128), (2, 5, 6, 128, 1, 24, 4),
extern fun conv (w: «6, 96; Nat», c: «2, 96, 640; Nat»): «6, 2, 640; Nat» =
    return (tensor.dot_product R (1_2, 1_3, (), ()) (w, c));

// K = 2304: a whole k x nc panel wide enough to register-block does not fit, so N is blocked by nc = 256 and the
// contraction in 9 blocks of 64 x 4 steps, hoisted outside M; the 4 x 16 register blocks of the N block run inside
// each contraction block, loaded from and stored back to its panel (tensor.dot_schedule_nblk_rbk).
// CHECK-LABEL: extern fun kblk
// CHECK: tensor.map_reduce_post @ (2, 0) {{.*}} ((2, 4, 2, 16, 16), (2, 16, 2, 4, 16, 9, 64, 4),
extern fun kblk (a: «8, 2304; Nat», b: «2304, 512; Nat»): «8, 512; Nat» =
    return (tensor.product_2d R (a, b));

// M = 64 and K = 130: the right operand is packed into 16-column panels «N/16, K, 16», computed at the panel loop of a
// 4 x 16 register-blocked contraction (tensor.dot_product_impl); K runs as 33 x 4 with its tail skipped.
// CHECK-LABEL: extern fun pack
// CHECK: tensor.map_reduce_post @ (1, 0) {{.*}} ((32, 130, 16), (32, 130, 16),
// CHECK: tensor.compute_at {{.*}} 1
// CHECK: tensor.map_reduce_post @ (2, 0) {{.*}} ((16, 4, 32, 1, 16), (32, 1, 16, 4, 16, 1, 33, 4),
extern fun pack (a: «64, 130; Nat», b: «130, 512; Nat»): «64, 512; Nat» =
    return (tensor.product_2d R (a, b));

// K = 100: N is blocked by 256 and register-blocked by 4 x 16 within the block (tensor.dot_schedule_rb), in the loop
// order (N/256, 256/16, M/4 | 4, 16).
// CHECK-LABEL: extern fun rblk
// CHECK: tensor.map_reduce_post @ (2, 0) {{.*}} ((2, 4, 2, 16, 16), (2, 16, 2, 4, 16, 25, 4),
extern fun rblk (a: «8, 100; Nat», b: «100, 512; Nat»): «8, 512; Nat» =
    return (tensor.product_2d R (a, b));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        tensor.lower_tensor,
        tensor.fuse_tensor,
        compile.cleanup,
    );
