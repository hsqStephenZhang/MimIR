// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"

// Copies of 16-byte cells padded with zeros, against the unscheduled ops: C = A · B over pairs, each component a
// product of its own, with A «6, 5» and B «5, 7».
// * `l`: B's copy laid out with its columns split by 4, which pads the last panel.
// * `t`: Bᵀ stored «7, 5» and read with j as the vector loop, which splits the copy's columns by the run of 7.
// The exit code counts the components that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

let P = [I64, I32];
fun mac1 (acc: P, (x y: P))@tt: P =
    return (core.wrap.add 0 (acc#0_2, core.wrap.mul 0 (x#0_2, y#0_2)), acc#1_2 + x#1_2 * y#1_2);
fun mac2 (acc: P, (x y: P))@tt: P =
    return (core.wrap.add 0 (acc#0_2, core.wrap.mul 0 (x#0_2, y#0_2)), acc#1_2 + x#1_2 * y#1_2);
fun mac9 (acc: P, (x y: P))@tt: P =
    return (core.wrap.add 0 (acc#0_2, core.wrap.mul 0 (x#0_2, y#0_2)), acc#1_2 + x#1_2 * y#1_2);
lam add (x y: I32): I32 = x + y;
lam ne (x y: P): I32 =
    core.select (core.bit2.and 2 (core.icmp.e (x#0_2, y#0_2), core.icmp.e (x#1_2, y#1_2)), 0I32, 1I32);

lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam mt (_ j k: affine.Index): «2; affine.Index» = (j, k);

let zero = (0I64, 0I32);
let a  = generate (6, 5) (λ i: «2; I64»: P = (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2), core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, 1I64))));
let b  = generate (5, 7) (λ i: «2; I64»: P = (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2)), core.conv.s 4294967296 (core.wrap.sub 0 (i#1_2, 4I64))));
let bt = generate (7, 5) (λ i: «2; I64»: P = (core.wrap.add 0 (i#1_2, core.wrap.mul 0 (2I64, i#0_2)), core.conv.s 4294967296 (core.wrap.sub 0 (i#0_2, 4I64))));

lam prod (f: Fn [P, «2; P»] → P) = mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, zero, id) mo (ma, mb) (buf a, buf b);
lam prod_t (f: Fn [P, «2; P»] → P) = mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, zero, id) mo (ma, mt) (buf a, buf bt);
lam diff (u v: «6, 7; P»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let l = materialize (transform_layout (prod mac1, 1, 1, 4));
    let t = materialize (cache_read (vectorize (prod_t mac2, 1), 1, 0));
    let r = materialize (prod mac9);
    return (m, diff (l, r) + diff (t, r));
