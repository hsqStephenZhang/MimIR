// RUN: python3 %S/row_norm.py %mim %S/row_norm.mim %t.dir rows=1
// RUN: clang++ -O3 -fsanitize=address %S/row_norm_aux.cpp %t.dir/probe.ll -o %t -Wno-override-module
// RUN: %t
// RUN: python3 %S/realization_count.py %t.dir/probe.ll %t.exp.ll --exp --unoptimized
// RUN: clang++ -O3 -DREALIZATION_COUNT %S/row_norm_aux.cpp %t.exp.ll -o %t.exp -Wno-override-module
// RUN: %t.exp
// RUN: python3 %S/realization_count.py %t.dir/probe.ll %t.center.ll --center --unoptimized
// RUN: clang++ -O3 -DCENTER_COUNT %S/row_norm_aux.cpp %t.center.ll -o %t.center -Wno-override-module
// RUN: %t.center
// RUN: python3 %S/realization_count.py %t.dir/probe.ll %t.alloc.ll --allocations --unoptimized
// RUN: clang++ -O3 -DALLOCATION_COUNT -fsanitize=address %S/row_norm_aux.cpp %t.alloc.ll -o %t.alloc -Wno-override-module
// RUN: %t.alloc
// RUN: python3 %S/row_norm.py %mim %S/row_norm.mim %t.ref.dir reference rows=1
// RUN: clang++ -O3 %S/row_norm_aux.cpp %t.ref.dir/probe.ll -o %t.ref -Wno-override-module
// RUN: %t.ref
