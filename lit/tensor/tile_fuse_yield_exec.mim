// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll -VVVV 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: clang++ -O1 -fsanitize=address %S/tile_fuse_yield_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec
// RUN: %mim -p opt -X tensor:tile-fuse=1 -X tensor:tile-ref=1 %s -p ll -X ll:o=%t.ref.ll
// RUN: clang++ -O1 -fsanitize=address %S/tile_fuse_yield_aux.cpp %t.ref.ll -o %t.ref -Wno-override-module
// RUN: %t.ref
// RUN: sed -E 's/= mul i64 2, (%%[_a-zA-Z0-9.]+)/= call i64 @twice_count(i64 \1)/' %t.ll > %t.count.ll
// RUN: echo 'declare i64 @twice_count(i64)' >> %t.count.ll
// RUN: clang++ -O0 -DCOUNT %S/tile_fuse_yield_aux.cpp %t.count.ll -o %t.count -Wno-override-module
// RUN: %t.count

// Members with users outside the group are handed back by every parallel level that tiles them.
// A member read pointwise on the root's grid is computed once: the root reads it through views of the handed tile.

plugin tensor;
plugin core;
plugin affine;
use tensor;

fun twice (_ x: I64)@tt: I64 = return (core.wrap.mul 0 (x, 2I64));
fun inc (_ x: I64)@tt: I64 = return (core.wrap.add 0 (x, 1I64));
fun relu (_ x: I64)@tt: I64 = return ((x, 0I64)#(core.icmp.sl (x, 0I64)));
fun add (_: I64, xy: [I64, I64])@tt: I64 = let (x, y) = xy; return (core.wrap.add 0 (x, y));
fun mac (acc: I64, xy: [I64, I64])@tt: I64 =
    let (x, y) = xy;
    return (core.wrap.add 0 (acc, core.wrap.mul 0 (x, y)));
fun bias_add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (core.wrap.mul 0 (acc, 2I64), x));

lam shared_ (n: Nat) (levels: TileLevels (2, I64, NoMma)) (x y: tensor.Tensor 2 (n, 4) I64)
    : [tensor.Tensor 2 (n, 4) I64, tensor.Tensor 2 (n, 4) I64] =
    let p1   = map_reduce ((n, 4), (n, 4)) (twice, 0I64) (affine.id @2) (affine.id @2,) x;
    let p2   = map_reduce ((n, 4), (n, 4)) (inc, 0I64) (affine.id @2) (affine.id @2,) p1;
    let root = map_reduce ((n, 4), (n, 4)) (add, 0I64) (affine.id @2) (affine.id @2, affine.id @2) (p2, y);
    (tile_req (root, (p1, p2), levels, default_control), p1);

let two = serial_par ((4, 0), 1, serial_par ((1, 2), 1, serial_done ()));
let twocap = serial_par ((4, 0), 0, serial_par ((1, 3), 0, serial_done ()));

extern fun sh2 (x y: tensor.Tensor 2 (6, 4) I64): [tensor.Tensor 2 (6, 4) I64, tensor.Tensor 2 (6, 4) I64] =
    return (shared_ 6 two (buf x, buf y));
extern fun sh2_sym (n: Nat, x y: tensor.Tensor 2 (n, 4) I64): [tensor.Tensor 2 (n, 4) I64, tensor.Tensor 2 (n, 4) I64] =
    return (shared_ n two (buf x, buf y));
extern fun sh2_cap (n: Nat, x y: tensor.Tensor 2 (n, 4) I64): [tensor.Tensor 2 (n, 4) I64, tensor.Tensor 2 (n, 4) I64] =
    return (shared_ n twocap (buf x, buf y));

// The epilogue reads q on the root's grid; the reduction level leaves it to the parallel level around it.
extern fun gemm_yield (m: Nat, a: tensor.Tensor 2 (m, 7) I64, b: tensor.Tensor 2 (7, 6) I64, c: tensor.Tensor 2 (m, 6) I64)
    : [tensor.Tensor 2 (m, 6) I64, tensor.Tensor 2 (m, 6) I64] =
    let q    = map_reduce ((m, 6), (m, 6)) (relu, 0I64) (affine.id @2) (affine.id @2,) (buf c);
    let root = map_reduce_post @(2, 1) @(I64, I64, 2, 3, SchedT)
        ((m, 6), (m, 6, 7), mk_sched (3, 0)) @((I64, I64), (2, 2), ((m, 7), (7, 6)), I64, 2, (m, 6))
        (mac, 0I64, bias_add) (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)), proj_map @(2, 2) (0, 1))
        ((buf a, buf b), q);
    return (tile_req (root, q, serial_par ((2, 0, 0), 1, serial_red ((0, 0, 3), 1, 0, serial_par ((1, 4, 0), 0, serial_done ()))), default_control), q);

// A transposed read leaves the tile's box, so the handed tile is computed on its own.
extern fun unaligned (x y: tensor.Tensor 2 (4, 4) I64): [tensor.Tensor 2 (4, 4) I64, tensor.Tensor 2 (4, 4) I64] =
    let p1   = map_reduce ((4, 4), (4, 4)) (twice, 0I64) (affine.id @2) (affine.id @2,) (buf x);
    let root = map_reduce ((4, 4), (4, 4)) (add, 0I64) (affine.id @2) (proj_map @(2, 2) (1, 0), affine.id @2) (p1, buf y);
    return (tile_req (root, p1, serial_par ((2, 0), 1, serial_par ((1, 2), 1, serial_done ())), default_control), p1);

// CHECK-DAG: L1 par tiles=(1, 2) tail=peel inputs=2 fused=2 yielded=1
// CHECK-DAG: L1 par tiles=(1, 3) tail=cap inputs=2 fused=2 yielded=1
// CHECK-DAG: L0 par tiles=(2, 6) tail=peel inputs=3 fused=1 yielded=1
// CHECK-DAG: L1 par tiles=(1, 2) tail=peel inputs=2 fused=1 yielded=0
