// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s

// The inputs of one op at loops of their own, against the unscheduled product:
// * `two`:  C = P · Q with P computed per row at the loop of i and Q per column at the loop of j.
// * `blas`: C = A · B with K split by 4 and hoisted outermost: B copied per K block «4, 5» at the loop of ko, A per
//   row and K block «1, 4» at the loop of i inside it, as a GEMM packs its operands.
// The exit code counts the cells that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add (x y: I32): I32 = x + y;
lam po (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

let x = generate (4, 6, 2) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (5I64, i#0_3), core.wrap.sub 0 (i#1_3, i#2_3))));
let y = generate (6, 5, 2) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#1_3), core.wrap.add 0 (i#0_3, i#2_3))));
let a = generate (6, 8) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (8, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));
lam pair (f: Fn [I32, I32] → I32) {m n: Nat} (z: «m, n, 2; I32») = materialize (mr_tileable @1 @(2, 1) ((m, n), (0, 1), (m, n, 2)) (f, 0I32, id) po pa z);
lam mmf {m k n: Nat} (u: «m, k; I32», v: «k, n; I32») = mr_tileable @2 @(2, 1) ((m, n), (0, 1), (m, n, k)) (mac, 0I32, id) mo (ma, mb) (u, v);
lam diff {m n: Nat} (u v: «m, n; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (s t: I32): I32 = core.select (core.icmp.e (s, t), 0I32, 1I32)) (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let two  = materialize (compute_at (compute_at (mmf (pair sum1 x, pair sum1 y), 1, 1), 0, 0));
    let blas = materialize (compute_at (cache_read (compute_at (cache_read (hoist_red (strip_mine_red (mmf (a, b), 2, 4), 0, 1), 1, 0), 1, 2), 0, 0), 0, 0));
    return (m, diff (two, materialize (mmf (pair sum2 x, pair sum2 y))) + diff (blas, materialize (mmf (a, b))));

// CHECK-DAG: («6; I32», 0)
// CHECK-DAG: («4, 5; I32», 0)
// CHECK-DAG: («4; I32», 0)
