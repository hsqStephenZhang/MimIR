// RUN: %mim -p opt %s -o - | %FileCheck %s

// Both branch results have the same post-dominator: `join`.  This mirrors
// TVM's post-dominator driven fusion case and checks that independent branches
// can be consumed by one continuation chain.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);
lam mul2 (x: Nat): Nat = %core.nat.mul (x, 2);
lam add  (xs: [Nat, Nat]): Nat = %core.nat.add xs;

con extern f [v1: «2; «3; Nat»», v2: «2; «3; Nat»», return: Cn «2; «3; Nat»»] =
    let left0  = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) v1;
    let left   = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) left0;
    let right0 = %tensor.unary @(Nat, Nat) mul2 @(2, (2, 3)) v2;
    let right  = %tensor.unary @(Nat, Nat) mul2 @(2, (2, 3)) right0;
    let join   = %tensor.binary @(Nat, Nat, Nat) add @(2, (2, 3)) (left, right);
    let result = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) join;
    return result;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// The whole injective reconverging graph is materialized as one map_reduce.
// CHECK: %tensor.map_reduce
// CHECK-NOT: %tensor.map_reduce
