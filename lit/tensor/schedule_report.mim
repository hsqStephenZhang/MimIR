// RUN: %mim -p opt -p clos -X tensor:threads=4 -X tensor:schedule_report=%t.jsonl %s -p ll -X ll:o=%t.ll
// RUN: python3 %S/schedule_report_check.py %t.jsonl
// RUN: %mim -p opt -p clos -X tensor:threads=4 %s -p ll -X ll:o=%t.off.ll
// RUN: diff %t.ll %t.off.ll
// RUN: %mim -p opt -p clos -X tensor:threads=4 -X tensor:schedule_report=- %s -p ll -X ll:o=%t.stdout.ll > %t.stdout.jsonl
// RUN: python3 %S/schedule_report_check.py %t.stdout.jsonl
// RUN: %mim -p opt -p clos -X tensor:schedule_report=%t.missing/report.jsonl %s -p ll -X ll:o=%t.bad.ll 2> %t.err; test $? -ne 0
// RUN: %FileCheck %s --check-prefix=ERROR < %t.err
// ERROR: cannot open output file
plugin core;
plugin tensor;
plugin affine;
use core.ops.u.w;
use tensor;
fun add (x y: I32)@tt: I32 = return (x + y);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam mi (o: «3; affine.Index»): «3; affine.Index» = o;
extern fun ssa (input: «12, 16, 2; I32»): «12, 16; I32» =
    let t = mr_tileable @1 @(2, 1) ((12, 16), (0, 1), (12, 16, 2)) (add, 0I32, id) mo mi (buf input);
    return (materialize (parallelize (vectorize (unroll_trailing (split_iter (t, 0, 4), 1), 1), 0)));
// 16x16 exceeds the 128-cell SSA limit: report the selected panel implementation.
extern fun fallback (input: «48, 16, 2; I32»): «48, 16; I32» =
    let t = mr_tileable @1 @(2, 1) ((48, 16), (0, 1), (48, 16, 2)) (add, 0I32, id) mo mi (buf input);
    return (materialize (vectorize (unroll_trailing (split_iter (t, 0, 16), 1), 1)));
// A par annotation away from the nest's leading boundary is not a generated parallel loop.
extern fun classic (input: «3, 7, 2; I32»): «3, 7; I32» =
    let t = mr_tileable @1 @(2, 1) ((3, 7), (0, 1), (3, 7, 2)) (add, 0I32, id) mo mi (buf input);
    return (materialize (parallelize (t, 1)));
