// RUN: %mim %s -X ll:o=%t.ll
// RUN: clang %t.ll %S/nominal_dynamic_aux.c -o %t -Wno-override-module
// RUN: %t

plugin core;
plugin mem;
plugin tensor;
plugin ll;
use tensor;
use core.ops.u.w;

extern con make_array (n: Nat, return: Cn [Tensor 1 n I32]) =
    return (generate n (λ (i: I64): I32 = core.conv.u 4294967296 i * 2I32 + 3I32));

extern con make_pair (n: Nat, return: Cn [Tensor 1 n I32, Tensor 1 n I32]) =
    let a = generate n (λ (i: I64): I32 = core.conv.u 4294967296 i * 2I32 + 3I32);
    let i = core.idx 0 n (core.nat.sub (n, 1));
    let b = set (a, i, 9I32);
    return (a, b);

extern con forward (n: Nat, a: Tensor 1 n I32, return: Cn [Tensor 1 n I32]) = return a;

extern con static_one (return: Cn [Tensor 1 1 I32]) =
    let a = generate 1 (λ (i: I64): I32 = 5I32);
    forward (1, a, return);

extern con make_scalar (return: Cn [Tensor 0 () I32]) =
    return (generate @(I32, 0) () (λ (i: []): I32 = 42I32));

extern con static_zero (return: Cn [Tensor 1 0 I32]) =
    let a = generate 0 (λ (i: I64): I32 = 5I32);
    forward (0, a, return);

extern con call_one (return: Cn [Tensor 1 1 I32]) = make_array (1, return);
extern con call_zero (return: Cn [Tensor 1 0 I32]) = make_array (0, return);

extern con capture (n: Nat, a: Tensor 1 n I32, return: Cn [Tensor 1 n I32]) =
    return (generate n (λ (i: I64): I32 = get (a, core.conv.u n i) + 1I32));

nom Marker = I32;
extern con read_marker (n: Nat, a: Tensor 1 n I32, marker: Marker, return: Cn I32) =
    return (get (a, core.idx 0 n 0) + #marker);

extern con closed_update (return: Cn [Tensor 1 4 I32]) =
    let a = from_array (1I32, 2I32, 3I32, 4I32);
    let v = item (generate @(I32, 0) () (λ (_: []): I32 = 42I32));
    return (set (a, 0₄, v));
