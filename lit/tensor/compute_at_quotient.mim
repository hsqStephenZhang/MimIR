// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"

// Reads through floordiv and rem that region inference bounds exactly, against the unscheduled ops, with P the row
// sums of a «8, 2, 6»:
// * `s`: Σ_k P[k / 2, k % 2] with k split by 4 and its K blocks hoisted, P computed per K block: a block «2, 2».
// * `c`: c[v] = P[v / 2, v % 2] + 1 inside the loop of i of P: the part of c reading row i is v ∈ [2i, 2i + 2).
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum3 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun inc (_: I32, x: I32)@tt: I32 = return (x + 1I32);
lam add (x y: I32): I32 = x + y;
lam qo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam none (_: affine.Index): «0; affine.Index» = ();
lam one (v: affine.Index): «1; affine.Index» = (v,);
lam split2 (v: affine.Index): «2; affine.Index» = (affine.semiop.floordiv (v, 2), affine.semiop.rem (v, 2));

let a = generate (8, 2, 6) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (7I64, i#0_3), core.wrap.sub 0 (i#1_3, i#2_3))));
lam rows (f: Fn [I32, I32] → I32) = materialize (mr_tileable @1 @(2, 1) ((8, 2), (0, 1), (8, 2, 6)) (f, 0I32, id) qo pa a);
lam total (p: «8, 2; I32») = mr_tileable @1 @(0, 1) ((), (), (16,)) (sum1, 0I32, id) none (split2,) p;
lam flat (p: «8, 2; I32») = mr_tileable @1 @(1, 0) (16, 0, 16) (inc, 0I32, id) one split2 p;
lam diff (u v: «16; I32»): I32 =
    reduce (add, 0I32) 0₁ (binary (λ (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32)) (u, v));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let s  = materialize (compute_at (hoist_red (strip_mine_red (total (rows sum1), 0, 4), 0, 1), 0, 0));
    let c  = materialize (reverse_compute_at (flat (rows sum3), 0, 0));
    let sr = materialize (total (rows sum2));
    let cr = materialize (flat (rows sum2));
    return (m, diff (c, cr) + core.select (core.icmp.e (s, sr), 0I32, 1I32));
