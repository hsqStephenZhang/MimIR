// RUN: %mim -p opt %s -o - | %FileCheck %s

// TVM tracks one kOutEWiseFusable anchor per group. When two matmuls meet at
// an elementwise add, MimIR may fuse the add as one anchor's epilogue only if
// the other matmul is materialized first and becomes an explicit epilogue
// input. The two contractions must never be merged or duplicated.
plugin tensor;
plugin core;
plugin affine;
plugin math;
plugin opt;

let f32 = %math.f32;
let F32 = %math.F32;
let R: %tensor.Ring = (F32, 0: F32, %math.arith.add @f32 0, %math.arith.mul @f32 0);

lam add (xs: [F32, F32]): F32 = %math.arith.add @f32 0 xs;

con extern f [a0: «2; «3; F32»», b0: «3; «4; F32»»,
              a1: «2; «5; F32»», b1: «5; «4; F32»», return: Cn «2; «4; F32»»] =
    let mm0    = %tensor.product_2d R (a0, b0);
    let mm1    = %tensor.product_2d R (a1, b1);
    let result = %tensor.binary @(F32, F32, F32) add @(2, (2, 4)) (mm0, mm1);
    return result;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// One ordinary reduction is materialized; the other owns the add epilogue.
// CHECK-COUNT-1: = %tensor.map_reduce 2
// CHECK-COUNT-1: = %tensor.map_reduce_epilogue
