// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// A matrix product of «6, 8» · «8, 5» with its K blocks hoisted out of the M and N loops, against the plain nest:
// * `h1`:    K split by 4, loops (i, ko, j, ki).
// * `h0`:    the same with ko outermost, accumulating all of the cells.
// * `hpost`: with the epilogue 2x + 1, which must run once, after the last K block.
// * `htail`: the GEMM order (io, jo, ko, ii, ji, ki) with i in tiles of 4, the last one cut short.
// The exit code counts the cells that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun twice1 (x: I32, _: [])@tt: I32 = return (2I32 * x + 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam add (x y: I32): I32 = x + y;

let a = generate (6, 8) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (8, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));

lam mm (post: Fn [I32, []] → I32) = mr_tileable @2 @(2, 1) ((6, 5), (0, 1), (6, 5, 8)) (mac, 0I32, post) mo (ma, mb) (a, b);
lam diff (x y: «6, 5; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (u v: I32): I32 = core.select (core.icmp.e (u, v), 0I32, 1I32)) (x, y)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let plain = materialize (mm id);
    let h1    = materialize (hoist_red (strip_mine_red (mm id, 2, 4), 1, 1));
    let h0    = materialize (hoist_red (strip_mine_red (mm id, 2, 4), 0, 1));
    let hpost = materialize (hoist_red (strip_mine_red (mm twice1, 2, 4), 1, 1));
    let htail = materialize (hoist_red (strip_mine_red (tile_par (mm id, (4, 0)), 4, 4), 2, 1));
    let bad   = diff (h1, plain) + diff (h0, plain) + diff (hpost, materialize (mm twice1)) + diff (htail, plain);
    return (m, bad);
