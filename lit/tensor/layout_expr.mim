// RUN: %mim %s

plugin tensor;
plugin refly;
plugin core;
plugin vec;

use core.ops.n;

lam check_coords {n: Nat} (physical: «2; Nat», outputs: «n; «2; I64»»): Bool =
    let bounded = vec.scan.for_all @(Idx n) @n
        (λ (i: Idx n): Bool =
            vec.scan.for_all @(Idx 2) @2
                (λ (d: Idx 2): Bool = core.bitcast Nat (outputs#i#(d)) < physical#(d)) (0₂, 1₂))
        ‹i: n; i›;
    let distinct = vec.scan.for_all @(Idx n) @n
        (λ (i: Idx n): Bool =
            vec.scan.for_all @(Idx n) @n
                (λ (j: Idx n): Bool =
                    let equal = vec.scan.for_all @(Idx 2) @2
                        (λ (d: Idx 2): Bool = core.icmp.e (outputs#i#(d), outputs#j#(d))) (0₂, 1₂);
                    core.bit2.or 0 (core.idx2nat i == core.idx2nat j, core.bit2.xor 0 (equal, tt)))
                ‹j: n; j›)
        ‹i: n; i›;
    core.bit2.and 0 (bounded, distinct);

let perm = tensor.layout_expr.make @(2) ((2, 3), 1, (1₃, 0₃, 2₃), (0, 0), 1, 1, 0, 1, ff);
let split = tensor.layout_expr.make @(2) ((2, 4), 2, (1₃, 0₃, 2₃), (0, 0), 1, 1, 0, 1, ff);
let padded = tensor.layout_expr.make @(2) ((2, 4), 2, (1₃, 0₃, 2₃), (0, 2), 1, 1, 0, 1, ff);
let rotated = tensor.layout_expr.make @(2) ((2, 4), 2, (1₃, 0₃, 2₃), (0, 2), 2, 2, 0, 3, ff);

let inputs_23 = ‹i: 6; let ii = core.idx2nat i; (core.bitcast I64 (ii / 3), core.bitcast I64 (ii % 3))›;
let inputs_24 = ‹i: 8; let ii = core.idx2nat i; (core.bitcast I64 (ii / 4), core.bitcast I64 (ii % 4))›;
let perm_coords = ‹i: 6; tensor.layout_expr.map_i64 @2 @(2, 3) perm (inputs_23#i)›;
let split_coords = ‹i: 8; tensor.layout_expr.map_i64 @2 @(2, 4) split (inputs_24#i)›;
let padded_coords = ‹i: 8; tensor.layout_expr.map_i64 @2 @(2, 4) padded (inputs_24#i)›;
let rotated_coords = ‹i: 8; tensor.layout_expr.map_i64 @2 @(2, 4) rotated (inputs_24#i)›;
let xored = tensor.layout_expr.make @(2) ((8, 32), 1, (0₃, 1₃, 2₃), (0, 0), 4, 8, 0, 8, tt);
let inputs_832 = ‹i: 256; let ii = core.idx2nat i; (core.bitcast I64 (ii / 32), core.bitcast I64 (ii % 32))›;
let xored_coords = ‹i: 256; tensor.layout_expr.map_i64 @2 @(8, 32) xored (inputs_832#i)›;

let _ = refly.check (check_coords (tensor.layout_expr.shape @2 @(2, 3) perm, perm_coords), tt,
                         "permuted layout must be injective and in bounds");
let _ = refly.check (check_coords (tensor.layout_expr.shape @2 @(2, 4) split, split_coords), tt,
                         "split layout must be injective and in bounds");
let _ = refly.check (check_coords (tensor.layout_expr.shape @2 @(2, 4) padded, padded_coords), tt,
                         "padded layout must be injective and in bounds");
let _ = refly.check (check_coords (tensor.layout_expr.shape @2 @(2, 4) rotated, rotated_coords), tt,
                         "rotated layout must be injective and in bounds");
let _ = refly.check (check_coords (tensor.layout_expr.shape @2 @(8, 32) xored, xored_coords), tt,
                         "xor-swizzled layout must be injective and in bounds");

// An MN-major wgmma panel: columns split into atoms that become the physical rows, chunks xored by the segment's row.
let segmented = tensor.layout_expr.make @(2) ((16, 32), 16, (1₃, 0₃, 2₃), (0, 0), 4, 4, 0, 4, tt);
let inputs_1632 = ‹i: 512; let ii = core.idx2nat i; (core.bitcast I64 (ii / 32), core.bitcast I64 (ii % 32))›;
let segmented_coords = ‹i: 512; tensor.layout_expr.map_i64 @2 @(16, 32) segmented (inputs_1632#i)›;
let _ = refly.check (check_coords (tensor.layout_expr.shape @2 @(16, 32) segmented, segmented_coords), tt,
                     "segmented layout must be injective and in bounds");
let at = λ (k n: Nat): «2; I64» = tensor.layout_expr.map_i64 @2 @(16, 32) segmented (core.bitcast I64 k, core.bitcast I64 n);
let _ = refly.check (core.bit2.and 0 (core.icmp.e ((at (1, 0))#1₂, 20I64), core.icmp.e ((at (3, 21))#1₂, 57I64)), tt,
                     "a segment's chunk must be xored by its row");
