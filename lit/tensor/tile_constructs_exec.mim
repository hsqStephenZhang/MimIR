// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/tile_constructs_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -X tensor:reference-tiles=1 -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/tile_constructs_aux.cpp %{s:stem}.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

plugin tensor;
plugin core;
plugin affine;
use tensor;
use core.ops.n;

extern fun tiled_tail (x: «5, 7; I64»): «5, 7; I64» =
    let x = buf x;
    return (tiled @(I64, 2) ((5, 7), (2, 3))
        x
        (λ (off ext: «2; Nat») (x): «ext; I64» = slice (5, 7) (off, (1, 1), ext) x));
extern fun tiled_one (x: «5; I64»): «5; I64» =
    let x = buf x;
    return (tiled @(I64, 2) ((1, 5), (4, 2))
        x
        (λ (off ext: «2; Nat») (x): «ext; I64» = slice @(I64, 2) (1, 5) (off, (1, 1), ext) x));
extern fun tiled_empty (x: «0, 5; I64»): «0, 5; I64» =
    return (tiled @(I64, 2) ((0, 5), (2, 3))
        x
        (λ (off ext: «2; Nat») (x: «0, 5; I64»): «ext; I64» =
            slice (0, 5) (off, (1, 1), ext) (buf @«0, 5; I64» x)));
extern fun tiled_full (x: «5, 7; I64»): «4, 6; I64» =
    return (tiled @(I64, 2) ((4, 6), (2, 3))
        x
        (λ (off ext: «2; Nat») (x): «ext; I64» = slice (5, 7) (off, (1, 1), ext) (buf x)));
extern fun tiled_scalar (x: «1, 1; I64»): «1, 1; I64» =
    return (tiled @(I64, 2) ((1, 1), (2, 3))
        x
        (λ (off ext: «2; Nat») (x): «ext; I64» = slice @(I64, 2) (1, 1) (off, (1, 1), ext) (buf x)));

extern fun packed (x: «5, 7; I64»): «3, 5, 3; I64» =
    return (stage @(I64, 2, 1) (5, 7) (1, 3, (1₂, 0₂), -99I64) 0 (buf x));
extern fun packed_both (x: «5, 7; I64»): «3, 3, 3, 2; I64» =
    return (stage @(I64, 2, 2) (5, 7) ((1, 0), (3, 2), (1₂, 0₂), -99I64) 0 (buf x));
extern fun packed_one (x: «5; I64»): «3, 2; I64» =
    return (stage @(I64, 2, 1) (1, 5) (1, 2, (1₂, 0₂), -99I64) 0 (buf x));
extern fun packed_box (x: «5, 7; I64»): «2, 2, 2; I64» =
    return (stage @(I64, 2, 1) (2, 3) (1, 2, (1₂, 0₂), -99I64) 0
        (slice @(I64, 2) (5, 7) ((1, 1), (2, 2), (2, 3)) (buf x)));
extern fun packed_box_one (x: «5, 7; I64»): «2, 2; I64» =
    return (stage @(I64, 2, 1) (1, 3) (1, 2, (1₂, 0₂), -99I64) 0
        (slice @(I64, 2) (5, 7) ((2, 1), (1, 2), (1, 3)) (buf x)));

extern fun ordered (): Nat =
    return (tile_fold (3, 2) 1 ()
        (λ (acc off: Nat) (): Nat = acc * 10 + off));
extern fun no_blocks (): Nat = return (tile_fold (0, 2) 7 ()
        (λ (_ _: Nat) (): Nat = 0));
lam seeded_fold (n: Nat): «3; I64» =
    tile_fold (n, 2) (splat (3, 3I64)) ()
        (λ (acc: «3; I64», off: Nat) (): «3; I64» =
        fun combine (x value: I64)@tt: I64 =
            return (core.wrap.add 0 (core.wrap.mul 0 (x, 10I64), value));
        map_reduce_post @(1, 0) @(I64, I64, 1, 1, SchedT)
            (3, 3, mk_sched (1, 0)) @(I64, 1, 3, (), (), ())
            (combine, outs_default @(I64, 1) 3 acc, id @I64)
            (affine.id @1) (affine.id @1, ()) (splat (3, core.bitcast I64 off), ()));
extern fun seeded_zero (): «3; I64» = return (seeded_fold 0);
extern fun seeded_one (): «3; I64» = return (seeded_fold 1);
extern fun seeded_three (): «3; I64» = return (seeded_fold 3);

fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));
extern fun tensor_fold (x: «3; I64»): «3; I64» =
    return (tile_fold (3, 2) (buf x) ()
        (λ (acc: «3; I64», off: Nat) (): «3; I64» =
        map_reduce_post @(1, 0) @(I64, I64, 1, 1, SchedT)
            (3, 3, mk_sched (1, 0)) @(I64, 1, 3, (), (), ())
            (add, outs_default @(I64, 1) 3 acc, id @I64) (affine.id @1)
            (affine.id @1, ()) (splat (3, core.bitcast I64 off), ())));

extern fun fold_shared_read (x: «3; I64»): «3; I64» =
    return (tile_fold (3, 2) (buf x) ()
        (λ (acc: «3; I64», off: Nat) (): «3; I64» =
        map_reduce_post @(1, 0) @(I64, I64, 1, 1, SchedT)
            (3, 3, mk_sched (1, 0)) @(I64, 1, 3, (), (), ())
            (add, outs @(I64, 1, 1) 3 (λ (_: affine.Index): affine.Index = affine.lit 0) acc, id @I64)
            (affine.id @1) (affine.id @1, ()) (splat (3, core.bitcast I64 off), ())));

extern fun fold_extra_read (x: «3; I64»): «3; I64» =
    return (tile_fold (3, 2) (buf x) ()
        (λ (acc: «3; I64», off: Nat) (): «3; I64» =
        map_reduce_post @(1, 0) @(I64, I64, 1, 1, SchedT)
            (3, 3, mk_sched (1, 0)) @(I64, 1, 3, (), (), ())
            (add, outs_default @(I64, 1) 3 acc, id @I64) (affine.id @1)
            (affine.id @1, ()) (acc, ())));
