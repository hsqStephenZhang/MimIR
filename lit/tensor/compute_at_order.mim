// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"

// P = A · B read by S[i] = Σ_j P[i, j], which computes it at i, and by T[j] = Σ_i P[i, j], which reads it whole, against
// the unscheduled ops: whichever the lowering reaches first, S computes P one row at a time into the buffer T reads.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum8 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum9 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam ro (i _: affine.Index): affine.Index = i;
lam ri (i j: affine.Index): «2; affine.Index» = (i, j);
lam co (j _: affine.Index): affine.Index = j;
lam ci (j i: affine.Index): «2; affine.Index» = (i, j);

let a = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));

lam prod (f: Fn [I32, «2; I32»] → I32) =
    materialize (mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (ma, mb) (buf a, buf b));
lam rsum (f: Fn [I32, I32] → I32) (p: «6, 7; I32») = mr_tileable @1 @(1, 1) (6, 0, (6, 7)) (f, 0I32, id) ro ri p;
lam csum (f: Fn [I32, I32] → I32) (p: «6, 7; I32») = mr_tileable @1 @(1, 1) (7, 0, (7, 6)) (f, 0I32, id) co ci p;

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let p  = prod mac1;
    let s  = materialize (compute_at (rsum sum1 p, 0, 0));
    let t  = materialize (csum sum2 p);
    let q  = prod mac9;
    let dt = reduce (add, 0I32) 0₁ (binary ne (t, materialize (csum sum8 q)));
    let ds = reduce (add, 0I32) 0₁ (binary ne (s, materialize (rsum sum9 q)));
    return (m, dt + ds);
