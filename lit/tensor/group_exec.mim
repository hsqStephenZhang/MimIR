// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s

// group_tensor without any schedule, against closed forms:
// * `s[j] = Σ_i 2 · M[i, j]` with the row sums `M[i, j] = Σ_k a[i, j, k]`: s groups M, one column «6» per j, so
//   no buffer of M remains.
// * `c[j] = Σ_i P[i, j]` with the product `P = b · e`: a contraction stays a group of its own, computed whole.
// The exit code counts the sums that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + 2I32 * x);
fun sum3 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
lam add (x y: I32): I32 = x + y;
lam q2 (i j _: affine.Index): «2; affine.Index» = (i, j);
lam q3 (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam tr (j i: affine.Index): «2; affine.Index» = (i, j);
lam ro (j _: affine.Index): affine.Index = j;
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

// a[i, j, k] = i + j + k, so M[i, j] = 3 (i + j + 1) and Σ_j s[j] = 2 · 3 · 120.
let a = generate (6, 4, 3) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_3, core.wrap.add 0 (i#1_3, i#2_3))));
// b[i, k] = 1 and e[k, j] = k, so P[i, j] = 0 + 1 + 2 and Σ_j c[j] = 5 · 3 · 3.
let b = generate (5, 3) (λ _: «2; I64»: I32 = 1I32);
let e = generate (3, 3) (λ i: «2; I64»: I32 = core.conv.s 4294967296 i#0_2);

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let rs = materialize (mr_tileable @1 @(2, 1) ((6, 4), (0, 1), (6, 4, 3)) (sum1, 0I32, id) q2 q3 a);
    let s  = materialize (mr_tileable @1 @(1, 1) (4, 0, (4, 6)) (sum2, 0I32, id) ro tr rs);
    let p  = materialize (mr_tileable @2 @(2, 1) ((5, 3), (0, 1), (5, 3, 3)) (mac, 0I32, id) q2 (ma, mb) (b, e));
    let c  = materialize (mr_tileable @1 @(1, 1) (3, 0, (3, 5)) (sum3, 0I32, id) ro tr p);
    let ts = reduce (add, 0I32) 0₁ s;
    let tc = reduce (add, 0I32) 0₁ c;
    return (m, core.select (ts == 720I32, 0I32, 1I32) + core.select (tc == 45I32, 0I32, 1I32));

// CHECK-NOT:  mem.{{m?slot|malloc}} («6, 4; I32»
// CHECK:      mem.{{m?slot|malloc}} («5, 3; I32», 0)
