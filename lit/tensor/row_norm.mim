// RUN: python3 %S/row_norm.py %mim %s %t.dir
// RUN: clang++ -O3 %S/row_norm_aux.cpp %t.dir/probe.ll -o %t -Wno-override-module
// RUN: %t
// RUN: python3 %S/realization_count.py %t.dir/probe.ll %t.count.ll --exp
// RUN: clang++ -O3 -DREALIZATION_COUNT %S/row_norm_aux.cpp %t.count.ll -o %t.count -Wno-override-module
// RUN: %t.count
// RUN: python3 %S/realization_count.py %t.dir/probe.ll %t.raw.ll --exp --unoptimized
// RUN: clang++ -O3 -DREALIZATION_COUNT %S/row_norm_aux.cpp %t.raw.ll -o %t.raw -Wno-override-module
// RUN: %t.raw
// RUN: python3 %S/realization_count.py %t.dir/probe.ll %t.center.ll --center --unoptimized
// RUN: clang++ -O3 -DCENTER_COUNT %S/row_norm_aux.cpp %t.center.ll -o %t.center -Wno-override-module
// RUN: %t.center
// RUN: python3 %S/row_norm.py %mim %s %t.ref.dir reference
// RUN: clang++ -O3 %S/row_norm_aux.cpp %t.ref.dir/probe.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

plugin tensor;
plugin affine;
plugin math;
plugin core;
plugin compile;
use tensor;
use core.ops.n;
let F32 = math.F32;
let mode = math.mode.fast;

lam row (i _: affine.Index): affine.Index = i;
fun add (acc x: F32)@tt: F32 = return (math.arith.add mode (acc, x));
fun maximum (acc x: F32)@tt: F32 = return (math.extrema.fmax mode (acc, x));
fun shifted_exp (_: F32, (x maximum: F32))@tt: F32 =
    return (math.exp.exp mode (math.arith.sub mode (x, maximum)));
fun divide (_: F32, (x divisor: F32))@tt: F32 = return (math.arith.div mode (x, divisor));
fun subtract (_: F32, (x mean: F32))@tt: F32 = return (math.arith.sub mode (x, mean));
fun square_sum (acc x: F32)@tt: F32 =
    return (math.arith.add mode (acc, math.arith.mul mode (x, x)));
fun normalize (_: F32, (x variance: F32))@tt: F32 =
    return (math.arith.div mode (x, math.rt.sq mode (math.arith.add mode (variance, 0.00001:F32))));

lam with_rows {M N: Nat} (combine: Fn [F32, «2; F32»] → F32, x: «M, N; F32», rows: «M; F32»): «M, N; F32» =
    map_reduce_post @(2, 0) @(F32, F32, 2, 2, SchedT) ((M, N), (M, N), mk_sched (2, 0))
        @((F32, F32), (2, 1), ((M, N), M), (), (), ())
        (combine, 0.0:F32, id @F32) (affine.id @2) ((affine.id @2, row), ()) ((x, rows), ());
lam retained {M N: Nat} (x: «M, N; F32»): «M, N; F32» =
    stage @(F32, 2, 0) (M, N) ((), (), (ff, tt), 0.0:F32) 0 x;
lam row_soft {M N: Nat} (x: «M, N; F32»): «M, N; F32» =
    let maximum = map_reduce_post @(1, 0) @(F32, F32, 1, 2, SchedT) (M, (M, N), mk_sched (2, 0))
        @(F32, 2, (M, N), (), (), ())
        (maximum, math.neg_inf math.f32, id @F32) row ((affine.id @2,), ()) ((x,), ());
    let exp = retained (with_rows (shifted_exp, x, maximum));
    let sum = map_reduce_post @(1, 0) @(F32, F32, 1, 2, SchedT) (M, (M, N), mk_sched (2, 0))
        @(F32, 2, (M, N), (), (), ())
        (add, 0.0:F32, id @F32) row ((affine.id @2,), ()) ((exp,), ());
    with_rows (divide, exp, sum);
lam row_layer {M N: Nat} (x: «M, N; F32»): «M, N; F32» =
    let divisor = math.conv.u2f math.f32 (core.idx 0 0 N);
    fun mean (value: F32, _: [])@tt: F32 = return (math.arith.div mode (value, divisor));
    lam average (squares: Bool, x: «M, N; F32»): «M; F32» =
        map_reduce_post @(1, 0) @(F32, F32, 1, 2, SchedT) (M, (M, N), mk_sched (2, 0))
            @(F32, 2, (M, N), (), (), ())
            ((add, square_sum)#squares, 0.0:F32, mean) row ((affine.id @2,), ()) ((x,), ());
    let mean = average (ff, x);
    let centered = retained (with_rows (subtract, x, mean));
    let variance = average (tt, centered);
    with_rows (normalize, centered, variance);

axm mark_soft: {M N: Nat} → [rows: Nat, «M, N; F32»] → «M, N; F32»;
axm mark_layer: {M N: Nat} → [rows: Nat, «M, N; F32»] → «M, N; F32»;
pub rule group_soft (M N rows: Nat, x: «M, N; F32»):
    mark_soft @(M, N) (rows, x) when core.bit2.and 0 (0 < N, 0 < rows) =>
    tiled ((M, N), (rows, N))
        (λ (off ext: «2; Nat»): «ext; F32» = row_soft (slice (M, N) (off, (1, 1), ext) x));
pub rule group_layer (M N rows: Nat, x: «M, N; F32»):
    mark_layer @(M, N) (rows, x) when core.bit2.and 0 (0 < N, 0 < rows) =>
    tiled ((M, N), (rows, N))
        (λ (off ext: «2; Nat»): «ext; F32» = row_layer (slice (M, N) (off, (1, 1), ext) x));
