// RUN: %mim -p opt %s -p ll
// RUN: clang++ -O3 -fsanitize=address %S/tile_cap_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -X tensor:reference-tiles=1 -p opt %s -p ll
// RUN: clang++ -O3 -fsanitize=address %S/tile_cap_aux.cpp %{s:stem}.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

plugin tensor;
plugin core;
plugin affine;
use tensor;
use core.ops.n;

fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));
fun twice (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, core.wrap.add 0 (x, x)));
lam first2 (i j _: affine.Index): «2; affine.Index» = (i, j);
lam first (i _: affine.Index): affine.Index = i;
lam transposed (j i: affine.Index): «2; affine.Index» = (i, j);

extern fun rows (a: «6, 4, 3; I64»): «4; I64» =
    let p = map_reduce ((6, 4), (6, 4, 3)) (add, 0I64) first2 (affine.id @3,) (buf a);
    return (tiled @(I64, 1) (4, 1)
        (λ (off ext: «1; Nat»): «ext; I64» =
            let limit = off + ext;
            let width = core.select (limit < 4, limit, 4) - off;
            let q = tile_of (p, (0, off), (6, width));
            map_reduce (ext, (ext, 6)) (twice, 0I64) first (transposed,) q));

extern fun tail (a: «6, 5, 3; I64»): «5; I64» =
    let p = map_reduce ((6, 5), (6, 5, 3)) (add, 0I64) first2 (affine.id @3,) (buf a);
    return (tiled @(I64, 1) (5, 2)
        (λ (off ext: «1; Nat»): «ext; I64» =
            let limit = off + ext;
            let width = core.select (limit < 5, limit, 5) - off;
            let q = tile_of (p, (0, off), (6, width));
            map_reduce (ext, (ext, 6)) (twice, 0I64) first (transposed,) q));

extern fun seeded (a: «6, 5, 3; I64»): «5; I64» =
    let p = map_reduce (5, (5, 6, 3)) (add, 0I64)
        (λ (j _ _: affine.Index): affine.Index = j)
        ((λ (j i k: affine.Index): «3; affine.Index» = (i, j, k)),) (buf a);
    return (tiled @(I64, 1) (5, 2)
        (λ (off ext: «1; Nat»): «ext; I64» =
            let limit = off + ext;
            let width = core.select (limit < 5, limit, 5) - off;
            let q = tile_of (p, off, width);
            map_reduce_post @(1, 1) @(I64, I64, 1, 1, SchedT)
                (ext, ext, mk_sched (1, 0)) @(I64, 1, width, I64, 1, width)
                (add, outs_default @(I64, 1) width q, add) (affine.id @1)
                (affine.id @1, affine.id @1) (q, q)));
