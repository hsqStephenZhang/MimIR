// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --allow-empty --implicit-check-not="not realized"

// An op that reads one producer through two slots computed at the same loop, against the unscheduled ops: both read the
// one tile that spans their boxes, with P = A · B.
// * `f`: F[i, j] = P[i, j] · P[i, 6 - j] at i: both read row i.
// * `g`: T[i] = Σ_j S[i, j] · S[j, i] with S = A · B «6, 6» at i: row i and column i, so the tile is all of S.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mul1 (_: I32, (x y: I32))@tt: I32 = return (x * y);
fun mul9 (_: I32, (x y: I32))@tt: I32 = return (x * y);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;
lam pf (i j: affine.Index): «2; affine.Index» = (i, affine.op.sub (affine.lit 6, j));
lam ro (i _: affine.Index): affine.Index = i;
lam rr (i j: affine.Index): «2; affine.Index» = (i, j);
lam rc (i j: affine.Index): «2; affine.Index» = (j, i);

let a = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (5, 6) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));
let c = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (2I64, i#1_2), i#0_2)));

lam prod (f: Fn [I32, «2; I32»] → I32) =
    materialize (mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (ma, mb) (buf a, buf c));
lam sq (f: Fn [I32, «2; I32»] → I32) =
    materialize (mr_tileable @2 @(2, 1) ((6, 6), (0, 1), (6, 6, 5)) (f, 0I32, id) mo (ma, mb) (buf a, buf b));
lam both (f: Fn [I32, «2; I32»] → I32) (p: «6, 7; I32») =
    mr_tileable @2 @(2, 0) ((6, 7), (0, 1), (6, 7)) (f, 0I32, id) po (po, pf) (p, p);
// T[i] = Σ_j S[i, j] · S[j, i]: row i and column i of S.
lam cross (f: Fn [I32, «2; I32»] → I32) (q: «6, 6; I32») =
    mr_tileable @2 @(1, 1) (6, 0, (6, 6)) (f, 0I32, id) ro (rr, rc) (q, q);
lam d67 (u v: «6, 7; I32»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));
lam d6 (u v: «6; I32»): I32 = reduce (add, 0I32) 0₁ (binary ne (u, v));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let f = materialize (compute_at (compute_at (both mul1 (prod mac1), 0, 0), 1, 0));
    let g = materialize (compute_at (compute_at (cross mac1 (sq mac1), 0, 0), 1, 0));
    return (m, d67 (f, materialize (both mul9 (prod mac9))) + d6 (g, materialize (cross mac9 (sq mac9))));
