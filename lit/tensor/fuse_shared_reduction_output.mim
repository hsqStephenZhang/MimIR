// RUN: %mim -p opt %s -o - | %FileCheck %s

// A reduction result with two consumers cannot be inlined by the current
// tree-oriented materializer. TVM can represent the whole DAG as one grouped
// function, but MimIR must materialize matmul once and fuse only its pointwise
// descendants; it must never duplicate the contraction as two epilogues.
plugin tensor;
plugin core;
plugin affine;
plugin math;
plugin opt;

let f32 = %math.f32;
let F32 = %math.F32;
let R: %tensor.Ring = (F32, 0: F32, %math.arith.add @f32 0, %math.arith.mul @f32 0);

lam relu (x: F32): F32 = %math.extrema.fmax @f32 0 (x, 0: F32);
lam mul2 (x: F32): F32 = %math.arith.mul @f32 0 (x, 2: F32);
lam add  (xs: [F32, F32]): F32 = %math.arith.add @f32 0 xs;

con extern f [a: «2; «3; F32»», b: «3; «4; F32»», return: Cn «2; «4; F32»»] =
    let mm     = %tensor.product_2d R (a, b);
    let left   = %tensor.unary @(F32, F32) relu @(2, (2, 4)) mm;
    let right  = %tensor.unary @(F32, F32) mul2 @(2, (2, 4)) mm;
    let result = %tensor.binary @(F32, F32, F32) add @(2, (2, 4)) (left, right);
    return result;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK-NOT: %tensor.map_reduce_epilogue
// CHECK-COUNT-2: %tensor.map_reduce
