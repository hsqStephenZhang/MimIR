// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s

// P + 1 inside a loop of a producer whose reduction blocks run outside some of its parallel loops, against the
// unscheduled ops:
// * `e0`, `e1`: P = A · B with its K blocks hoisted inside the loop of i: after an iteration of i a row of P is done, but
//   not after one of j, which a K block runs around.
// * `g`: the default GEMM schedule, whose K blocks run around the loop of its row blocks.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

let R: Ring = (I32, 0I32, core.wrap.add 0, core.wrap.mul 0);
fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac2 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun inc1 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc2 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc3 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc8 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
fun inc9 (_: I32, x: I32)@tt: I32 = return (x + 1I32);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam po (o: «2; affine.Index»): «2; affine.Index» = o;

let a = generate (8, 6) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (6, 32) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));

lam prod (f: Fn [I32, «2; I32»] → I32) = mr_tileable @2 @(2, 1) ((8, 32), (0, 1), (8, 32, 6)) (f, 0I32, id) mo (ma, mb) (buf a, buf b);
lam hoisted (f: Fn [I32, «2; I32»] → I32) = materialize (hoist_red (strip_mine_red (prod f, 2, 3), 1, 1));
lam ew (f: Fn [I32, I32] → I32) (p: «8, 32; I32») = mr_tileable @1 @(2, 0) ((8, 32), (0, 1), (8, 32)) (f, 0I32, id) po po p;
lam diff (u v: «8, 32; I32»): I32 = reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary ne (u, v)));

// CHECK-DAG: reverse_compute_at of {{.*}} inside dim 1 of the producer of its input 0 not realized: other loops than the dims before it run around the loop
// CHECK-NOT: inside dim 0 of the producer of its input 0 not realized: other loops
extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let e0 = materialize (reverse_compute_at (ew inc1 (hoisted mac1), 0, 0));
    let e1 = materialize (reverse_compute_at (ew inc2 (hoisted mac2), 0, 1));
    let g  = materialize (reverse_compute_at (ew inc3 (product_2d R (a, b)), 0, 1));
    let r  = materialize (ew inc9 (materialize (prod mac9)));
    return (m, diff (e0, r) + diff (e1, r) + diff (g, materialize (ew inc8 (product_2d R (a, b)))));
