// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -V -o /dev/null 2>&1 | %FileCheck %s --check-prefix=WARN

// C = P' · B with P' the rows of P read reversed as 5 + (−k), which region inference cannot bound: it answers the
// whole row, from 0, for the box and for the single point of its corner alike.
// * `at`:    P computed per row of C is warned and computed whole.
// * `cache`: P cached per row of C is warned and read as is.
// The exit code counts the cells that differ from the unscheduled product.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add (x y: I32): I32 = x + y;
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam qo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam mn (i _ k: affine.Index): «2; affine.Index» = (i, affine.op.add (affine.lit 5, affine.op.neg k));

let a = generate (3, 6, 2) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (7I64, i#0_3), core.wrap.sub 0 (i#1_3, i#2_3))));
let b = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));
lam diff {m n: Nat} (x y: «m, n; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (u v: I32): I32 = core.select (core.icmp.e (u, v), 0I32, 1I32)) (x, y)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let p  = materialize (mr_tileable @1 @(2, 1) ((3, 6), (0, 1), (3, 6, 2)) (sum, 0I32, id) qo pa a);
    let c  = materialize (compute_at (mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 6)) (mac, 0I32, id) mo (mn, mb) (p, b), 0, 0));
    let pr = materialize (mr_tileable @1 @(2, 1) ((3, 6), (0, 1), (3, 6, 2)) (sum2, 0I32, id) qo pa a);
    let cr = materialize (mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 6)) (mac, 0I32, id) mo (mn, mb) (pr, b));
    let cc = materialize (compute_at (cache_read (mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 6)) (mac, 0I32, id) mo (mn, mb) (p, b), 0, 0), 0, 0));
    return (m, diff (c, cr) + diff (cc, cr));

// WARN-DAG: compute_at of input 0 inside dim 0 of {{.*}} not realized: the read of the corner is not known exactly
// WARN-DAG: cache_read of input 0 of {{.*}} not realized: the read of the corner is not known exactly
