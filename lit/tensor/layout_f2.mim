// RUN: %mim %s

// Over power-of-two extents a layout is a matrix over F₂, so its injectivity and its fills' contiguity are decided.

plugin tensor;
plugin refly;

use tensor.layout_expr;

let identity = make @2 ((64, 64), 1, (0₃, 1₃, 2₃), (0, 0), 1, 1, 0, 1, ff);
let _ = refly.struc.e (injective identity, 2);
let _ = refly.struc.e (contiguous (identity, 64), 2);

// The 128-byte swizzle of a wgmma panel exchanges 16-byte chunks, so vectors of 8 F16 stay whole and 16 do not.
let swizzled = make @2 ((64, 64), 1, (0₃, 1₃, 2₃), (0, 0), 8, 8, 0, 8, tt);
let _ = refly.struc.e (injective swizzled, 2);
let _ = refly.struc.e (contiguous (swizzled, 8), 2);
let _ = refly.struc.e (contiguous (swizzled, 16), 1);

// Padding leaves the class, so nothing is decided.
let padded = make @2 ((64, 64), 1, (0₃, 1₃, 2₃), (0, 4), 1, 1, 0, 1, ff);
let _ = refly.struc.e (injective padded, 0);

// A permutation that repeats a dim, which `make` rejects, maps two rows onto one.
let collapsed = ((‹(64, 64)›, 1, (0₃, 0₃, 2₃), (0, 0), 1, 1, 0, 1, ff) inj Data (2, (64, 64))) inj Expr (2, (64, 64));
let _ = refly.struc.e (injective collapsed, 1);

// The swizzle a K-major wgmma panel is filled in is the one its descriptor makes the hardware read.
let _ = refly.struc.e (matches_sw128 (swizzled, 2), 2);
let rows128 = make @2 ((128, 64), 1, (0₃, 1₃, 2₃), (0, 0), 8, 8, 0, 8, tt);
let _ = refly.struc.e (matches_sw128 (rows128, 2), 2);
// A swizzle shifted by one row bit, or one that rotates instead of exchanging, is not.
let shifted = make @2 ((64, 64), 1, (0₃, 1₃, 2₃), (0, 0), 8, 8, 1, 8, tt);
let _ = refly.struc.e (matches_sw128 (shifted, 2), 1);
let _ = refly.struc.e (matches_sw128 (identity, 2), 1);

// For any rank, a layout is the 128-byte swizzle of its own unswizzled placement, or it is not.
let _ = refly.struc.e (lies_sw128 (swizzled, 2), 2);
let _ = refly.struc.e (lies_sw128 (rows128, 2), 2);
let _ = refly.struc.e (lies_sw128 (shifted, 2), 1);
let _ = refly.struc.e (lies_sw128 (identity, 2), 1);
let unit3 = make @3 ((64, 1, 64), 1, (0₄, 1₄, 3₄, 2₄), (0, 0, 0), 8, 8, 0, 8, tt);
let _ = refly.struc.e (lies_sw128 (unit3, 2), 2);
// So is the layout of an MN-major tensor-core operand, and the same placement left unswizzled is not.
let mn = (tc_wgmma @2 ((64, 128), 1, 2, ff))#1₂;
let _ = refly.struc.e (lies_sw128 (mn, 2), 2);
let _ = refly.struc.e (lies_sw128 (make @2 ((64, 128), (#mn)#split, (#mn)#perm, (#mn)#pad, 1, 1, 0, 1, ff), 2), 1);

// A TMA copy stacks the atoms of 128 bytes its rows split into and swizzles each: both operand layouts lie there, with
// the matrix's rows and columns in the dims the copy fills, and not with them exchanged or without the swizzle.
let _ = refly.struc.e (lies_tma128 (mn, 2, 0, 1), 2);
let _ = refly.struc.e (lies_tma128 (mn, 2, 1, 0), 1);
let km = (tc_wgmma @3 ((64, 1, 128), 0, 2, tt))#1₂;
let _ = refly.struc.e (lies_tma128 (km, 2, 2, 0), 2);
let _ = refly.struc.e (lies_tma128 (make @3 ((64, 1, 128), (#km)#split, (#km)#perm, (#km)#pad, 1, 1, 0, 1, ff), 2, 2, 0), 1);
