// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll -VVVV 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: not grep "copies accumulator" %t.log
// RUN: clang++ -O1 -fsanitize=address %S/tile_fuse_levels_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec
// RUN: %mim -p opt -X tensor:tile-fuse=1 -X tensor:tile-ref=1 %s -p ll -X ll:o=%t.ref.ll
// RUN: clang++ -O1 -fsanitize=address %S/tile_fuse_levels_aux.cpp %t.ref.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

// Nested parallel, reduction and vector levels tile a GEMM with a fused producer and a bias epilogue.

plugin tensor;
plugin core;
plugin affine;
use tensor;

fun relu (_ x: I64)@tt: I64 = return ((x, 0I64)#(core.icmp.sl (x, 0I64)));
fun mac (acc: I64, xy: [I64, I64])@tt: I64 =
    let (x, y) = xy;
    return (core.wrap.add 0 (acc, core.wrap.mul 0 (x, y)));
fun bias_add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (core.wrap.mul 0 (acc, 2I64), x));

lam gemm {C K: *} (m k: Nat, transposed: Bool) (levels: C, control: K)
    (a: tensor.Tensor 2 ((m, k), (k, m))#transposed I64, b: tensor.Tensor 2 (k, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (m, 6) I64 =
    let s    = ((m, k), (k, m))#transposed;
    let r    = map_reduce (s, s) (relu, 0I64) (affine.id @2) (affine.id @2,) a;
    let root = map_reduce_post @(2, 1) @(I64, I64, 2, 3, SchedT)
        ((m, 6), (m, 6, k), mk_sched (3, 0)) @((I64, I64), (2, 2), (s, (k, 6)), I64, 1, 6)
        (mac, 0I64, bias_add) (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (((0, 2), (2, 0))#transposed), proj_map @(3, 2) (2, 1)), proj_map @(2, 1) 1)
        ((r, b), bias);
    tile_req (root, r, levels, control);

let four = ((0, (2, 0, 0), 1, 0), (1, (0, 0, 3), 1, 0), (0, (1, 4, 0), 1, 0), (2, (0, 1, 0), 1, 0));

// Symbolic extents stay outermost in every buffer.
// With a symbolic K, the parallel level cannot bound a relu tile, so the reduction level fuses relu per chunk.
extern fun nested_k (k: Nat, a: tensor.Tensor 2 (k, 5) I64, b: tensor.Tensor 2 (k, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, k, tt) (four, default_control) (buf a, buf b, buf bias));
extern fun nested_m (m: Nat, a: tensor.Tensor 2 (m, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (m, 6) I64 =
    return (gemm (m, 7, ff) (four, default_control) (buf a, buf b, buf bias));
extern fun nested7 (a: tensor.Tensor 2 (5, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, 7, ff) (four, default_control) (buf a, buf b, buf bias));
extern fun capped (k: Nat, a: tensor.Tensor 2 (k, 5) I64, b: tensor.Tensor 2 (k, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, k, tt) (((0, (2, 0, 0), 1, 0), (1, (0, 0, 3), 0, 0)), default_control) (buf a, buf b, buf bias));
extern fun reduce_first (k: Nat, a: tensor.Tensor 2 (k, 5) I64, b: tensor.Tensor 2 (k, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, k, tt) (((1, (0, 0, 4), 1, 0), (0, (2, 2, 0), 1, 0)), default_control) (buf a, buf b, buf bias));

// Inner levels that keep an outer relu tile as a region input index it by its capped storage.
lam outer (q: FuseQuery): FuseDecision = (core.bit2.and 0 (q#in_group, core.ncmp.e (q#level, 0)), ff);
extern fun outer_m (m: Nat, a: tensor.Tensor 2 (m, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (m, 6) I64 =
    return (gemm (m, 7, ff) (four, outer) (buf a, buf b, buf bias));
extern fun outer7 (a: tensor.Tensor 2 (5, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, 7, ff) (four, outer) (buf a, buf b, buf bias));

// Capped parallel levels run one body over the tail; a capped inner extent allocates its bound.
let capfour = ((0, (2, 0, 0), 0, 0), (1, (0, 0, 3), 1, 0), (0, (1, 4, 0), 0, 0), (2, (0, 1, 0), 1, 0));
extern fun cap_m (m: Nat, a: tensor.Tensor 2 (m, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (m, 6) I64 =
    return (gemm (m, 7, ff) (capfour, default_control) (buf a, buf b, buf bias));
extern fun cap7 (a: tensor.Tensor 2 (5, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, 7, ff) (capfour, default_control) (buf a, buf b, buf bias));
extern fun cap_k (k: Nat, a: tensor.Tensor 2 (k, 5) I64, b: tensor.Tensor 2 (k, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, k, tt) (((0, (2, 4, 0), 0, 0), (1, (0, 0, 3), 0, 0), (0, (1, 2, 0), 0, 0)), default_control)
        (buf a, buf b, buf bias));
extern fun cap_n7 (a: tensor.Tensor 2 (5, 7) I64, b: tensor.Tensor 2 (7, 6) I64, bias: tensor.Tensor 1 6 I64)
    : tensor.Tensor 2 (5, 6) I64 =
    return (gemm (5, 7, ff) (((0, (2, 4, 0), 0, 0), (1, (0, 0, 3), 0, 0), (0, (1, 2, 0), 0, 0)), default_control)
        (buf a, buf b, buf bias));

// CHECK-DAG: L0 par tiles=(2, 6) tail=peel inputs=3 fused=1 yielded=0
// CHECK-DAG: L1 red loop=2 ks=3 tail=peel inputs={{[0-9]+}} fused=1 tail_fused=1
// CHECK-DAG: L1 red loop=2 ks=3 tail=cap inputs={{[0-9]+}} fused=1 tail_fused=0
// CHECK-DAG: L2 par tiles=(1, 4) tail=peel inputs={{[0-9]+}} fused=1 yielded=0
// CHECK-DAG: L2 par tiles=(1, 4) tail=peel inputs=3 fused=0 yielded=0
// CHECK-DAG: L3 vec vdim=1
// CHECK-DAG: L0 par tiles=(2, 6) tail=cap inputs=3 fused=1 yielded=0
// CHECK-DAG: L2 par tiles=(1, 4) tail=cap inputs=3 fused=1 yielded=0
// CHECK-DAG: L0 par tiles=(2, 4) tail=cap inputs=3 fused=0 yielded=0
// CHECK-DAG: L0 red loop=2 ks=4 tail=peel inputs={{[0-9]+}} fused=1 tail_fused=1
// CHECK-DAG: skip r{{.*}}: its tile storage (k{{.*}}, 2) has no constant bound
