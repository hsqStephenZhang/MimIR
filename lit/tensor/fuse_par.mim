// RUN: %mim -p opt -p clos %s -p ll -X ll:o=%t.ll
// RUN: %FileCheck %s < %t.ll
// RUN: clang++ -std=c++23 %S/fuse_par_aux.cpp %t.ll -o %t -Wno-override-module
// RUN: MIM_NUM_THREADS=4 %t
// RUN: MIM_NUM_THREADS=1 %t

// CHECK-DAG: define {{.*}} @direct(
// CHECK-DAG: define {{.*}} @permuted(
// CHECK-DAG: define {{.*}} @tiled(
// CHECK-DAG: define {{.*}} @rescheduled(
// CHECK-DAG: define {{.*}} @epilogue(
// CHECK-DAG: define {{.*}} @three_axes(
// CHECK-DAG: define {{.*}} @reduction_axes(
// CHECK-DAG: call void @mim_rt_parallel_for(i64 60,
// CHECK-DAG: call void @mim_rt_parallel_for(i64 30,
// CHECK-DAG: call void @mim_rt_parallel_for(i64 10,

plugin core;
plugin tensor;
plugin affine;

use core.ops.u.w;
use tensor;

fun add (x y: I32)@tt: I32 = return (x + y);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam mi (o: «3; affine.Index»): «3; affine.Index» = o;
lam rows (input: «6, 10, 7; I32») =
    mr_tileable @1 @(2, 1) ((6, 10), (0, 1), (6, 10, 7)) (add, 0I32, id) mo mi (buf input);

// The fused 60-point domain writes the original 6 x 10 output, including after loop permutation.
extern fun direct (input: «6, 10, 7; I32»): «6, 10; I32» =
    return (materialize (parallelize (fuse_par (rows input, 0), 0)));
extern fun permuted (input: «6, 10, 7; I32»): «6, 10; I32» =
    return (materialize (parallelize (fuse_par (interchange (rows input, (1, 0, 2)), 0), 0)));

// Nonadjacent output axes: split first, reorder the tile loops, fuse them, preserve the output layout.
extern fun tiled (input: «6, 10, 7; I32»): «6, 10; I32» =
    let t = strip_mine_par (strip_mine_par (rows input, 1, 2), 0, 3);
    let t = interchange (t, (0, 2, 1, 3, 4));
    return (reshape (2, 3, 5, 2) (6, 10) (materialize (parallelize (fuse_par (t, 0), 0))));

// Empty iteration domains over an allocated output: neither case reads or writes a cell.
// Keep boundary tensor shapes nonempty; zero-shaped tensor ABIs are a separate lowering limitation.
extern fun empty_outer (input: «6, 10, 7; I32»): «6, 10; I32» =
    let t = (rows input)#6_15 ← (0, 10, 7);
    return (materialize (parallelize (fuse_par (t, 0), 0)));
extern fun empty_inner (input: «6, 10, 7; I32»): «6, 10; I32» =
    let t = (rows input)#6_15 ← (6, 0, 7);
    return (materialize (parallelize (fuse_par (t, 0), 0)));

// Domain split and reorder compose after fusion; the materialized shape is still 6 x 10.
extern fun rescheduled (input: «6, 10, 7; I32»): «6, 10; I32» =
    let t = split_iter (fuse_iter (rows input, 0), 0, 5);
    let t = interchange (t, (1, 0, 2));
    return (materialize (parallelize (fuse_iter (t, 0), 0)));

lam inc (x: I32): I32 = x + 1000I32;
// The epilogue fuses into a producer with Ro != Rp, preserving its iteration rank.
extern fun epilogue (input: «6, 10, 7; I32»): «6, 10; I32» =
    return (unary inc (materialize (parallelize (fuse_iter (rows input, 0), 0))));

lam mo3 (i j k _: affine.Index): «3; affine.Index» = (i, j, k);
lam mi4 (o: «4; affine.Index»): «4; affine.Index» = o;
// Three spatial axes collapse to one iteration axis, retaining a rank-three output.
extern fun three_axes (input: «2, 3, 5, 7; I32»): «2, 3, 5; I32» =
    let t = mr_tileable @1 @(3, 1) ((2, 3, 5), (0, 1, 2), (2, 3, 5, 7))
                        (add, 0I32, id) mo3 mi4 (buf input);
    return (materialize (parallelize (fuse_iter (fuse_iter (t, 0), 0), 0)));

lam mo4 (i j _ _: affine.Index): «2; affine.Index» = (i, j);
// Both spatial and reduction axes fuse; reduction split restores a nested sequential fold.
extern fun reduction_axes (input: «6, 10, 3, 5; I32»): «6, 10; I32» =
    let t = mr_tileable @1 @(2, 2) ((6, 10), (0, 1), (6, 10, 3, 5))
                        (add, 0I32, id) mo4 mi4 (buf input);
    let t = fuse_iter (fuse_iter (t, 0), 1);
    return (materialize (parallelize (split_iter (t, 1, 5), 0)));

fun copy (_ x: I32)@tt: I32 = return x;
lam mo2 (o: «2; affine.Index»): «2; affine.Index» = o;
// No reductions: parallel rank can differ from output rank for pointwise kernels too.
extern fun pointwise (input: «6, 10; I32»): «6, 10; I32» =
    let t = mr_tileable @1 @(2, 0) ((6, 10), (0, 1), (6, 10)) (copy, 0I32, id) mo2 mo2 (buf input);
    let t = split_iter (fuse_iter (t, 0), 0, 5);
    return (materialize (parallelize (fuse_iter (t, 0), 0)));

// A rank-two output may start with a rank-one parallel domain, without first creating dummy output axes.
lam output_flat (i _: affine.Index): «2; affine.Index» =
    (affine.semiop.floordiv (i, 10), affine.semiop.rem (i, 10));
lam input_flat (i k: affine.Index): «3; affine.Index» =
    (affine.semiop.floordiv (i, 10), affine.semiop.rem (i, 10), k);
extern fun explicit_domain (input: «6, 10, 7; I32»): «6, 10; I32» =
    let t = mr_iter_tileable @1 @(2, 1, 1) ((6, 10), (2,), (60, 7))
                             (add, 0I32, id) output_flat input_flat (buf input);
    return (materialize (parallelize (split_iter (t, 0, 5), 0)));
