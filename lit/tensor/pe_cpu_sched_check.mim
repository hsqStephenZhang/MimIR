// RUN: %mim %s -o - 2>&1 | %FileCheck %s
// RUN: %mim -X refly:strict=1 %s -o %t.mim > %t.log 2>&1; test $? -ne 0
// RUN: %FileCheck %s --check-prefix=STRICT --input-file=%t.log

// Malformed hand-written SchedTrees are rejected while PE unfolds them.
// `-X refly:strict=1` turns the first rejection into a compile error at the offending call.
// STRICT: error: SchedTree: a Split must cut a packed axis into whole panels
plugin tensor;
plugin core;
plugin math;
plugin mem;
plugin buffer;
plugin affine;

let F32 = math.F32;
let dep = ((tt, ff, tt), (ff, tt, tt));
let tree_par = tensor.sched_pack @(2, 3) (1, 8, 1₂, dep#1₂,
    tensor.sched_par @(2, 3) ((0, 3, 0), tensor.sched_leaf @(2, 3) 0));
let tree_seq0 = tensor.sched_seq @(2, 3) (2, 0, tensor.sched_leaf @(2, 3) 0);
let tree_seq_par = tensor.sched_seq @(2, 3) (0, 6,
    tensor.sched_par @(2, 3) ((4, 0, 0), tensor.sched_leaf @(2, 3) 1));

fun mac (m: mem.M 0, acc: F32, (x y: F32))@tt: [mem.M 0, F32] = return (m, math.arith.add 0 (acc, math.arith.mul 0 (x, y)));

// CHECK: SchedTree: a Split must cut a packed axis into whole panels
lam probe_par (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4))
        (mac, 0:F32)
        (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃))
        (tensor.aff_proj @(3, 2) (0₃, 2₃), tensor.aff_proj @(3, 2) (2₃, 1₃))
        (tree_par, (4, 16, 4), (ff, ff, ff))
        (m, (a, b));

// CHECK: SchedTree: a Split needs a positive tile size
lam probe_seq0 (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4))
        (mac, 0:F32)
        (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃))
        (tensor.aff_proj @(3, 2) (0₃, 2₃), tensor.aff_proj @(3, 2) (2₃, 1₃))
        (tree_seq0, (4, 16, 4), (ff, ff, ff))
        (m, (a, b));


// CHECK: SchedTree: a Fixed Split needs an axis with a static extent
lam probe_seq_par (m: mem.M 0, a: buffer.Buf (2, (10, 4), F32), b: buffer.Buf (2, (4, 8), F32)): [mem.M 0, buffer.Buf (2, (10, 8), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((10, 4), (4, 8)))
        ((10, 8), (10, 8, 4))
        (mac, 0:F32)
        (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃))
        (tensor.aff_proj @(3, 2) (0₃, 2₃), tensor.aff_proj @(3, 2) (2₃, 1₃))
        (tree_seq_par, (10, 8, 4), (ff, ff, ff))
        (m, (a, b));

// A producer read through a floordiv is staged as the exact box its tiles read.
// CHECK-NOT: Aff:
lam probe_stage_div (m: mem.M 0, a: buffer.Buf (2, (2, 2), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    let half = tensor.aff_map @(3, 2, 0) ((), (tensor.aff_fdiv @(3, 0) (tensor.aff_dim @(3, 0) 0₃, 2), tensor.aff_dim @(3, 0) 2₃));
    let make = λ (lo ext _: «2; Nat», _: «2; Bool») (m: mem.M 0, t: buffer.Buf (2, ext, F32)): [mem.M 0, buffer.Buf (2, ext, F32)] = (m, t);
    tensor.run_levels_with @(2, F32, 2, 3, (F32, F32), (2, 2), ((2, 2), (4, 16)))
        ((4, 16), (4, 16, 4))
        (mac, 0:F32)
        (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃))
        ((half, tensor.aff_proj @(3, 2) (2₃, 1₃)), ((tensor.Prod (2, F32))#Fill make, (tensor.Prod (2, F32))#Plain))
        (tensor.sched_stage @(2, 3) (0₂, tensor.sched_leaf @(2, 3) 0), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));

// A producer slot read without a Stage above the reader.
let fill_any = λ (lo ext _: «2; Nat», _: «2; Bool») (m: mem.M 0, t: buffer.Buf (2, ext, F32)): [mem.M 0, buffer.Buf (2, ext, F32)] = (m, t);
let ik = tensor.aff_proj @(3, 2) (0₃, 2₃);
let kj = tensor.aff_proj @(3, 2) (2₃, 1₃);

// CHECK: SchedTree: a Leaf reads a producer slot that no Stage above it computes
lam probe_leaf_fill (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels_with @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃))
        ((ik, kj), ((tensor.Prod (2, F32))#Fill fill_any, (tensor.Prod (2, F32))#Plain))
        (tensor.sched_leaf @(2, 3) 0, (4, 16, 4), (ff, ff, ff))
        (m, (a, b));

// CHECK: SchedTree: a Pack reads a producer slot that no Stage above it computes
lam probe_pack_fill (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels_with @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃))
        ((ik, kj), ((tensor.Prod (2, F32))#Fill fill_any, (tensor.Prod (2, F32))#Plain))
        (tensor.sched_pack @(2, 3) (0, 2, 0₂, (tt, ff, tt), tensor.sched_stage @(2, 3) (0₂, tensor.sched_leaf @(2, 3) 0)), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));

// CHECK: SchedTree: a Pack's dep must be the loops its slot reads
lam probe_pack_dep (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_pack @(2, 3) (1, 8, 1₂, (tt, tt, tt), tensor.sched_leaf @(2, 3) 0), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));

// CHECK: SchedTree: a Leaf vectorizes a loop below Rn, or none with Rn
lam probe_leaf_vdim (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_leaf @(2, 3) 7, (4, 16, 4), (ff, ff, ff))
        (m, (a, b));

// Splitting the second of two reduction loops reorders a combiner without merge; splitting the first does not.
fun add (m: mem.M 0, acc: F32, x: F32)@tt: [mem.M 0, F32] = return (m, math.arith.add 0 (acc, x));
let ijk = tensor.aff_proj @(3, 3) (0₃, 1₃, 2₃);
// CHECK: SchedTree: only the first reduction loop may be split when the combiner has no merge
// CHECK-NOT: SchedTree:
lam probe_order (m: mem.M 0, x: buffer.Buf (3, (4, 6, 8), F32)): [mem.M 0, buffer.Buf (1, 4, F32)] =
    tensor.run_levels @(1, F32, 1, 3, F32, 3, (4, 6, 8))
        (4, (4, 6, 8)) (add, 0:F32) (λ (o: «3; affine.Index»): affine.Index = o#0₃) ijk
        (tensor.sched_par @(1, 3) ((0, 0, 4), tensor.sched_leaf @(1, 3) 3), (4, 6, 8), (ff, ff, ff))
        (m, x);
lam probe_order_first (m: mem.M 0, x: buffer.Buf (3, (4, 6, 8), F32)): [mem.M 0, buffer.Buf (1, 4, F32)] =
    tensor.run_levels @(1, F32, 1, 3, F32, 3, (4, 6, 8))
        (4, (4, 6, 8)) (add, 0:F32) (λ (o: «3; affine.Index»): affine.Index = o#0₃) ijk
        (tensor.sched_par @(1, 3) ((0, 4, 0), tensor.sched_leaf @(1, 3) 3), (4, 6, 8), (ff, ff, ff))
        (m, x);

// A run-time extent without a static bound sizes neither a panel nor an edge tile until a Seq or Peel splits it.
// CHECK: SchedTree: a Pack sizes its panel by a run-time extent that no Split bounds
lam probe_pack_unbounded (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_pack @(2, 3) (0, 2, 0₂, (tt, ff, tt), tensor.sched_leaf @(2, 3) 3), (tensor.levels_unbounded, 16, 4), (tt, ff, ff))
        (m, (a, b));
// CHECK: SchedTree: a Leaf computes an edge tile of a run-time extent that no Split bounds
lam probe_edge_unbounded (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_leaf @(2, 3) 0, (tensor.levels_unbounded, 16, 4), (tt, ff, ff))
        (m, (a, b));

// A Reduce keeps partial results along the reduction loop its Leaf vectorizes, which only a combiner with a merge joins.
// CHECK: SchedTree: a Reduce needs a reduction loop
lam probe_reduce_out (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_reduce @(2, 3) (0, 4, tensor.sched_leaf @(2, 3) 0), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));
// CHECK: SchedTree: a Reduce needs at least two partial results
lam probe_reduce_one (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_reduce @(2, 3) (2, 1, tensor.sched_leaf @(2, 3) 2), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));
// CHECK: SchedTree: a Reduce must split the loop its Leaf vectorizes
lam probe_reduce_vdim (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_reduce @(2, 3) (2, 4, tensor.sched_leaf @(2, 3) 1), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));
// CHECK: SchedTree: a Reduce needs a combiner with a merge
lam probe_reduce_merge (m: mem.M 0, a: buffer.Buf (2, (4, 4), F32), b: buffer.Buf (2, (4, 16), F32)): [mem.M 0, buffer.Buf (2, (4, 16), F32)] =
    tensor.run_levels @(2, F32, 2, 3, (F32, F32), (2, 2), ((4, 4), (4, 16)))
        ((4, 16), (4, 16, 4)) (mac, 0:F32) (λ (o: «3; affine.Index»): «2; affine.Index» = (o#0₃, o#1₃)) (ik, kj)
        (tensor.sched_reduce @(2, 3) (2, 4, tensor.sched_leaf @(2, 3) 2), (4, 16, 4), (ff, ff, ff))
        (m, (a, b));
