// RUN: %mim -p opt %s -o - | %FileCheck %s

plugin tensor;
plugin core;
plugin math;
plugin compile;

let F32 = math.F32;
let mode = math.mode.contract;
let R: tensor.Ring = (F32, 0:F32, math.arith.add mode, math.arith.mul mode);

lam scores (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32): tensor.Tensor 3 (2, 5, 7) F32 =
    tensor.dot_product R @(3, 3) @(1, 1) (2₃, 2₃, 0₃, 0₃) @((2, 5, 3), (2, 7, 3)) (q, k);

lam finish (p: tensor.Tensor 3 (2, 5, 7) F32, v: tensor.Tensor 3 (2, 7, 4) F32): tensor.Tensor 3 (2, 5, 4) F32 =
    tensor.dot_product R @(3, 3) @(1, 1) (2₃, 1₃, 0₃, 0₃) @((2, 5, 7), (2, 7, 4)) (p, v);

extern fun matched (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32, v: tensor.Tensor 3 (2, 7, 4) F32): tensor.Tensor 3 (2, 5, 4) F32 =
    let s = tensor.unary (λ x: F32: F32 = math.arith.mul mode (x, 0.5:F32)) @(3, (2, 5, 7))
        (scores (tensor.buf q, tensor.buf k));
    return (finish (tensor.softmax mode @math.f32 @3 2₃ @(2, 5, 7) s, tensor.buf v));

extern fun masked (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32, v: tensor.Tensor 3 (2, 7, 4) F32,
                   mask: tensor.Tensor 3 (2, 5, 7) F32): tensor.Tensor 3 (2, 5, 4) F32 =
    let s = tensor.unary (λ x: F32: F32 = math.arith.mul mode (x, 0.5:F32)) @(3, (2, 5, 7))
        (scores (tensor.buf q, tensor.buf k));
    let s = tensor.binary (math.arith.add mode) @(3, (2, 5, 7)) (s, tensor.buf mask);
    return (finish (tensor.softmax mode @math.f32 @3 2₃ @(2, 5, 7) s, tensor.buf v));

extern fun wrong_axis (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32, v: tensor.Tensor 3 (2, 7, 4) F32): tensor.Tensor 3 (2, 5, 4) F32 =
    let s = tensor.unary (λ x: F32: F32 = math.arith.mul mode (x, 0.5:F32)) @(3, (2, 5, 7))
        (scores (tensor.buf q, tensor.buf k));
    return (finish (tensor.softmax mode @math.f32 @3 1₃ @(2, 5, 7) s, tensor.buf v));

extern fun late_scale (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32, v: tensor.Tensor 3 (2, 7, 4) F32): tensor.Tensor 3 (2, 5, 4) F32 =
    let p = tensor.softmax mode @math.f32 @3 2₃ @(2, 5, 7) (scores (tensor.buf q, tensor.buf k));
    let p = tensor.unary (λ x: F32: F32 = math.arith.mul mode (x, 0.5:F32)) @(3, (2, 5, 7)) p;
    return (finish (p, tensor.buf v));

extern fun unstable (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32, v: tensor.Tensor 3 (2, 7, 4) F32): tensor.Tensor 3 (2, 5, 4) F32 =
    let s = tensor.unary (λ x: F32: F32 = math.arith.mul mode (x, 0.5:F32)) @(3, (2, 5, 7))
        (scores (tensor.buf q, tensor.buf k));
    let e = tensor.unary (math.exp.exp mode) @(3, (2, 5, 7)) s;
    let z = tensor.reduce (math.arith.add mode, 0:F32) 2₃ e;
    return (finish (tensor.binary_ax (math.arith.div mode) 2₃ (e, z), tensor.buf v));

extern fun observable (q: tensor.Tensor 3 (2, 5, 3) F32, k: tensor.Tensor 3 (2, 7, 3) F32, v: tensor.Tensor 3 (2, 7, 4) F32):
    [tensor.Tensor 3 (2, 5, 4) F32, tensor.Tensor 3 (2, 5, 7) F32] =
    let s = tensor.unary (λ x: F32: F32 = math.arith.mul mode (x, 0.5:F32)) @(3, (2, 5, 7))
        (scores (tensor.buf q, tensor.buf k));
    let p = tensor.softmax mode @math.f32 @3 2₃ @(2, 5, 7) s;
    return (finish (p, tensor.buf v), p);

extern lam _compile (): compile.Phase =
    compile.phases ff (compile.beta_red, tensor.raise_attention, compile.cleanup);

// CHECK-LABEL: extern fun late_scale
// CHECK-NOT: tensor.sdpa
// CHECK-LABEL: extern fun masked
// CHECK: tensor.sdpa_masked
// CHECK-LABEL: extern fun matched
// CHECK: tensor.sdpa 16
// CHECK-LABEL: extern fun observable
// CHECK: tensor.sdpa 16
// CHECK: tensor.map_reduce_post
// CHECK-LABEL: extern fun unstable
// CHECK-NOT: tensor.sdpa
// CHECK-LABEL: extern fun wrong_axis
// CHECK-NOT: tensor.sdpa
