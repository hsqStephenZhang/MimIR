// RUN: %mim %s -p ll -X ll:rt=embed -X ll:o=%t.ll
// RUN: python3 %S/prepack_count.py %t.ll %t.count.ll
// RUN: clang++ -O3 -fsanitize=address %S/prepack_aux.cpp %t.count.ll -o %t -Wno-override-module
// RUN: %t

plugin opt;
plugin tensor;
plugin core;
plugin math;

extern fun packed (x: tensor.Tensor 2 (5, 7) math.F32): math.F32 =
    let p = tensor.prepack @(math.F32, 2, 1) (5, 7) (1, 4, (ff, tt), 0.0:math.F32)
        (tensor.frozen (tensor.buf x));
    return (tensor.get (p, (4₅, 1₂, 2₄)));
