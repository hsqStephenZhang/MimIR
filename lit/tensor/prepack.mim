// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -V -o /dev/null 2>&1 | %FileCheck %s
// RUN: clang++ -std=c++23 %S/prepack_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// GEMMs with a frozen weight, driven by prepack_aux.cpp: each is called with a weight, the same again, another one and
// the first again, against a scalar reference.
// * `pp`:   37×513 · 513×100 — the copies of B stacked by its column and K blocks.
// * `pp1`:  6×128 · 128×32 — a single block of B.
// * `pp_t`: 7×300 · (96×300)ᵀ — a transposed weight.
// * `pp_c`: B computed in the function, so the copy is not kept.
plugin tensor;
plugin core;
plugin math;

use tensor;

let F32  = math.F32;
let Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);

extern fun pp (a: «37, 513; F32», b: «513, 100; F32»): «37, 100; F32» = return (product_2d Ring (a, frozen b));
extern fun pp1 (a: «6, 128; F32», b: «128, 32; F32»): «6, 32; F32» = return (product_2d Ring (a, frozen b));
extern fun pp_t (a: «7, 300; F32», b: «96, 300; F32»): «7, 96; F32» =
    return (dot_product Ring (1₂, 1₂, (), ()) (a, frozen b));

// CHECK: prepack of input 1 of {{.*}} not realized: it is no input buffer of the function
// CHECK-NOT: not realized
extern fun pp_c (a: «6, 128; F32», b: «128, 32; F32»): «6, 32; F32» =
    return (product_2d Ring (a, frozen (binary (math.arith.add math.mode.contract) (b, b))));
