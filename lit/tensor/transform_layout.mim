// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s

// `tensor.transform_layout` on a matrix product C = A · B, against the unscheduled product:
// * `bk`:    B «8, 5» split along j by 2 per K block of 4 at the loop of ko: a copy «3, 4, 2», its last panel padded.
// * `ak`:    A «6, 8» split along i by 4 per K block at the loop of ko as well: a copy «2, 4, 4», 2 rows padded.
// * `whole`: B split along k by 3 ahead of the nest: a copy «3, 5, 3», its last block padded.
// * `vec`:   B «8, 8» split along j by 4 per K block around a vectorized micro-kernel: a copy «2, 4, 4».
// The exit code counts the cells that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
lam add (x y: I32): I32 = x + y;
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

let a  = generate (6, 8) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b  = generate (8, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));
let b8 = generate (8, 8) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
lam mmf {n: Nat} (y: «8, n; I32») = mr_tileable @2 @(2, 1) ((6, n), (0, 1), (6, n, 8)) (mac, 0I32, id) mo (ma, mb) (a, y);
lam hk {n: Nat} (y: «8, n; I32») = hoist_red (strip_mine_red (mmf y, 2, 4), 0, 1);
lam diff {m n: Nat} (u v: «m, n; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (s t: I32): I32 = core.select (core.icmp.e (s, t), 0I32, 1I32)) (u, v)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let plain = materialize (mmf b);
    let bk    = materialize (compute_at (transform_layout (hk b, 1, 1, 2), 1, 2));
    let ak    = materialize (compute_at (transform_layout (hk b, 0, 0, 4), 0, 2));
    let whole = materialize (transform_layout (mmf b, 1, 0, 3));
    let vec   = materialize (compute_at (transform_layout (hoist_red (vectorize (strip_mine_red (mmf b8, 2, 4), 1), 1, 1), 1, 1, 4), 1, 2));
    return (m, diff (bk, plain) + diff (ak, plain) + diff (whole, plain) + diff (vec, materialize (mmf b8)));

// CHECK-DAG: («3, 4, 2; I32», 0)
// CHECK-DAG: («2, 4, 4; I32», 0)
// CHECK-DAG: («3, 5, 3; I32», 0)
