// RUN: %mim -p opt %s -o - | %FileCheck %s

// Mirrors TVM's multiple-functions case. Fusion analysis must not connect
// otherwise identical dataflow graphs across external function boundaries.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);
lam mul2 (x: Nat): Nat = %core.nat.mul (x, 2);

con extern first [v: «2; «3; Nat»», return: Cn «2; «3; Nat»»] =
    let x = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) v;
    let y = %tensor.unary @(Nat, Nat) mul2 @(2, (2, 3)) x;
    return y;

con extern second [v: «2; «3; Nat»», return: Cn «2; «3; Nat»»] =
    let x = %tensor.unary @(Nat, Nat) mul2 @(2, (2, 3)) v;
    let y = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) x;
    return y;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK-COUNT-2: %tensor.map_reduce
