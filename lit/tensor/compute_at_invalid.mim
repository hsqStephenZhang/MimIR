// RUN: %mim -p opt %s -o - 2>&1 | %FileCheck %s

// Two inputs of one op computed at different loops: `refly.check` reports it, as a schedule holds one loop.
plugin core;
plugin affine;
plugin tensor;

use core.ops.u.w;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam po (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);

// CHECK: compute_at: the inputs of an op must be computed at one loop
extern fun two (a: «4, 6, 2; I32», b: «6, 5, 2; I32»): «4, 5; I32» =
    let p = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((4, 6), (0, 1), (4, 6, 2)) (sum, 0I32, tensor.id) po pa (tensor.buf a));
    let q = tensor.materialize (tensor.mr_tileable @1 @(2, 1) ((6, 5), (0, 1), (6, 5, 2)) (sum, 0I32, tensor.id) po pa (tensor.buf b));
    let t = tensor.mr_tileable @2 @(2, 1) ((4, 5), (0, 1), (4, 5, 6)) (mac, 0I32, tensor.id) po (ma, mb) (p, q);
    return (tensor.materialize (tensor.compute_at (tensor.compute_at (t, 1, 1), 0, 0)));
