// RUN: %mim -p opt %s -p ll -X ll:o=%t.ll
// RUN: clang++ -fsanitize=address %S/group_folded_rank_aux.cpp %t.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt -X tensor:group=0 %s -p ll -X ll:o=%t.off.ll
// RUN: clang++ -fsanitize=address %S/group_folded_rank_aux.cpp %t.off.ll -o %t.off -Wno-override-module
// RUN: %t.off

plugin tensor;
plugin core;
plugin affine;
use tensor;

fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));
extern fun folded (x: «2, 3; I64»): «2, 3; I64» =
    let p = map_reduce @1 @(I64, 3, 3) ((2, 1, 3), (2, 1, 3)) @(I64, 2, (2, 3))
        (add, 0I64) (affine.id @3)
        ((λ (i _ j: affine.Index): «2; affine.Index» = (i, j)),) (buf x);
    return (map_reduce @1 @(I64, 2, 2) ((2, 3), (2, 3)) @(I64, 2, (2, 3))
        (add, 0I64) (affine.id @2) (affine.id @2,) p);
