// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 28
// RUN: %t x y z ; test $? -eq 34

// A shape-polymorphic function whose inner parameter list is itself dependent: `{m}` is implicit, `n` explicit,
// and `a: «m, n; I32»` names both; `tensor.lower_to_mem` detects it by the inner parameters' types.
// `twice` doubles every element of a = i · 10 + j over «3, n», n = argc + 4; main probes a[1][n-1] · 2 = 2n + 18:
// 28 for n = 5, 34 for n = 8.
plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin cps;
plugin btensor;
plugin buffer;

use core.ops.u.w;
use tensor;

extern fun twice {m: Nat} (n: Nat, a: «m, n; I32»): «m, n; I32» =
    return (unary (λ (x: I32): I32 = x + x) (buf a));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let n = core.nat.add (core.bitcast Nat argc, 4);
    let a = generate (3, n) (λ (i: «2; I64»): I32 = core.conv.u 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (10I64, i#0₂), i#1₂)));
    con done (o: «3, n; I32») = return (m, o#(1₃, core.idx 0 n (core.nat.sub (n, 1))));
    twice ((n, a), done);
