// RUN: %mim -VVVV -p opt -X btensor:vec-bytes=32 -X btensor:vregs=16 -X tensor:cpu-mr=4 -X tensor:cpu-nr=16 -X tensor:cpu-mc=64 -X tensor:cpu-nc=240 -X tensor:cpu-kc=128 -X tensor:cpu-pack-b=1 %s -o %t.mim 2>&1 | %FileCheck %s

// The schedule tree run_levels interprets, one node per line at -VVVV.
// CHECK:      schedule tree:
// CHECK-NEXT: Split 1, 240, Fixed
// CHECK-NEXT:   Split 2, 128, Loop
// CHECK-NEXT:     Pack 1, 16, 1, (ff, tt, tt)
// CHECK-NEXT:       Split 0, 64, Fixed
// CHECK-NEXT:         Pack 0, 4, 0, (tt, ff, tt)
// CHECK-NEXT:           Split 0, 4, Fixed
// CHECK-NEXT:             Split 1, 16, Fixed
// CHECK-NEXT:               Leaf 0
plugin tensor;
plugin core;
plugin math;

let F32 = math.F32;
let R: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);

extern fun g (a: tensor.Tensor 2 (300, 200) F32, b: tensor.Tensor 2 (200, 500) F32): tensor.Tensor 2 (300, 500) F32 =
    return (tensor.product_2d R (a, b));
