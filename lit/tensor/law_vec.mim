// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: %FileCheck %s --input-file=%t.ll
// RUN: clang++ -O1 %S/law_vec_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// A vector level runs as the law's meaning: its parallel loop of size 1 becomes the vector loop, and its size on the
// last reduction loop splits that loop into an unrolled inner one.
// The law's run and TileFuse's realization of each chain vectorize alike and agree with the product.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

lam gemm (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32) =
    law.of_map_reduce ((16, 16), (16, 16, 20)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);

extern fun vec_run (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.run (gemm (a, b), serial_group ((8, 8, 0), 0, 0, group_item ((2, 2, 0), 0, item_vec ((1, 0, 4), item_done ()))), default_control));
extern fun vec_req (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.req (gemm (a, b), (), serial_group ((8, 8, 0), 0, 0, group_item ((2, 2, 0), 0, item_vec ((1, 0, 4), item_done ()))), default_control));
extern fun cols_run (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.run (gemm (a, b), serial_par ((8, 8, 0), 0, serial_vec ((0, 1, 4), serial_done ())), default_control));
extern fun cols_req (a: tensor.Tensor 2 (16, 20) F32, b: tensor.Tensor 2 (20, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    return (law.req (gemm (a, b), (), serial_par ((8, 8, 0), 0, serial_vec ((0, 1, 4), serial_done ())), default_control));

// CHECK-LABEL: define {{.*}} @cols_req
// CHECK: <16 x float>
// CHECK-LABEL: define {{.*}} @cols_run
// CHECK: <16 x float>
// CHECK-LABEL: define {{.*}} @vec_req
// CHECK: <16 x float>
// CHECK-LABEL: define {{.*}} @vec_run
// CHECK: <16 x float>
