// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s -X tensor:gemm-mr=4 -X tensor:gemm-nr=16 -X tensor:gemm-kc=256 -X tensor:gemm-nc=64
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %FileCheck %s --check-prefix=WIDTH < %{s:stem}.ll
// RUN: %mim -p opt %s -X tensor:gemm-mr=4 -X tensor:gemm-nr=16 -X tensor:gemm-kc=256 -X tensor:gemm-nc=64 -o - | %FileCheck %s
// RUN: %mim -p opt -p clos -p ll %s -X tensor:vec-bytes=32 -X tensor:vec-regs=16 -X tensor:lane-fma=0 -X tensor:l1=32768 -X ll:o=%t.ll
// RUN: clang++ %t.ll -o %t.derived -Wno-override-module
// RUN: %t.derived

// `product_2d` against the unscheduled product, for shapes `chk (m, k, n)` that take `dot_schedule_tiled`:
// * rows in whole 4-row blocks or with a last block of 1, 2 or 3 rows;
// * columns in whole 16-wide panels, grouped by 4, 2 or 1, or with a last panel of 1 to 15 columns;
// * `K` in one block, in whole blocks of 256 or with a last block cut short;
// and for shapes that fall back to `dot_schedule`: fewer than 4 rows, fewer than 16 columns.
// The derived blocks of an AVX2-like target split the rows and `K` by the shape instead.
// The exit code counts the cells that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam add (x y: I32): I32 = x + y;
let Ring = (I32, 0I32, add, λ (x y: I32): I32 = x * y);
lam diff {m n: Nat} (x y: «m, n; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (u v: I32): I32 = core.select (core.icmp.e (u, v), 0I32, 1I32)) (x, y)));
lam ga (m k: Nat) = generate (m, k) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), core.bit2.and 0 (i#1_2, 7I64))));
lam gb (k n: Nat) = generate (k, n) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.bit2.and 0 (i#0_2, 3I64), core.wrap.mul 0 (2I64, i#1_2))));
lam chk (m k n: Nat): I32 =
    let a = ga (m, k); let b = gb (k, n);
    diff (product_2d Ring (buf a, buf b), materialize (mr_tileable @2 @(2, 1) ((m, n), (0, 1), (m, n, k)) (mac, 0I32, id) mo (ma, mb) (buf a, buf b)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    return (m, chk (4, 8, 16) + chk (7, 12, 32) + chk (9, 256, 48) + chk (6, 512, 64) + chk (13, 100, 80)
               + chk (5, 768, 128) + chk (10, 128, 64) + chk (8, 1000, 32) + chk (6, 8, 20) + chk (7, 300, 50)
               + chk (9, 600, 40) + chk (13, 1000, 33) + chk (5, 520, 17) + chk (12, 513, 70)
               + chk (3, 8, 16) + chk (4, 8, 15));

// CHECK-DAG: («100, 16; I32», 0)
// CHECK-DAG: («128, 64; I32», 0)
// CHECK-DAG: («i8, 16; I32», 0)

// A whole run of 16 columns is one vector.
// WIDTH: !{!"llvm.loop.vectorize.width", i32 16}, !{!"llvm.loop.interleave.count", i32 1}
