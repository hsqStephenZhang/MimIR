// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// A producer computed one tile at a time whose own input is computed whole and only read inside the tiles, against
// the unscheduled ops: S[i] = Σ_j P[i, j] with P computed at i, and P = Q ⊗ B over k with Q the row sums of A «6» (`s`)
// or the column sums of B «7» (`t`), each of the type of a buffer the tiles or S allocate.
// The exit code counts the values that differ.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac1 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac2 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac9 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun mac8 (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum3 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum4 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum8 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum9 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum7 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum6 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add (x y: I32): I32 = x + y;
lam ne (x y: I32): I32 = core.select (core.icmp.e (x, y), 0I32, 1I32);
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam mi (i _ _: affine.Index): affine.Index = i;
lam mj (_ j _: affine.Index): affine.Index = j;
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam ro (i _: affine.Index): affine.Index = i;
lam ri (i j: affine.Index): «2; affine.Index» = (i, j);
lam ck (j k: affine.Index): «2; affine.Index» = (k, j);

let a = generate (6, 5) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.sub 0 (core.wrap.mul 0 (3I64, i#0_2), i#1_2)));
let b = generate (5, 7) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));

lam rows (f: Fn [I32, I32] → I32) = materialize (mr_tileable @1 @(1, 1) (6, 0, (6, 5)) (f, 0I32, id) ro ri (buf a));
lam cols (f: Fn [I32, I32] → I32) = materialize (mr_tileable @1 @(1, 1) (7, 0, (7, 5)) (f, 0I32, id) ro ck (buf b));
lam by_row (f: Fn [I32, «2; I32»] → I32) (q: «6; I32») =
    materialize (mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (mi, mb) (q, buf b));
lam by_col (f: Fn [I32, «2; I32»] → I32) (q: «7; I32») =
    materialize (mr_tileable @2 @(2, 1) ((6, 7), (0, 1), (6, 7, 5)) (f, 0I32, id) mo (mj, mb) (q, buf b));
lam rsum (f: Fn [I32, I32] → I32) (p: «6, 7; I32») = mr_tileable @1 @(1, 1) (6, 0, (6, 7)) (f, 0I32, id) ro ri p;
lam d6 (u v: «6; I32»): I32 = reduce (add, 0I32) 0₁ (binary ne (u, v));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let s  = materialize (compute_at (rsum sum1 (by_row mac1 (rows sum2)), 0, 0));
    let t  = materialize (compute_at (rsum sum3 (by_col mac2 (cols sum4)), 0, 0));
    let sr = materialize (rsum sum9 (by_row mac9 (rows sum8)));
    let tr = materialize (rsum sum7 (by_col mac8 (cols sum6)));
    return (m, d6 (s, sr) + d6 (t, tr));
