// RUN: %mim -p opt -p ll -X tensor:group=1 %s -X ll:o=%t.on.ll --profile summary --output-profile %t.profile -V -V -V -V 2> %t.on.log
// RUN: %FileCheck %s --check-prefix=OUTCOME < %t.on.log
// RUN: %FileCheck %s --check-prefix=PROFILE < %t.profile
// RUN: %FileCheck %s --check-prefix=REPORTED < %t.on.log
// RUN: clang++ -O3 -fsanitize=address %S/group_default_aux.cpp %t.on.ll -o %t.on -Wno-override-module
// RUN: %t.on
// RUN: %mim -p opt -p ll -X tensor:group=0 %s -X ll:o=%t.off.ll
// RUN: clang++ -O3 -fsanitize=address %S/group_default_aux.cpp %t.off.ll -o %t.off -Wno-override-module
// RUN: %t.off

plugin tensor;
plugin affine;
plugin math;
plugin core;
use tensor;
let F32 = math.F32;
let mode = math.mode.fast;
let Ring = (F32, 0.0:F32, math.arith.add mode, math.arith.mul mode);

lam row (i _: affine.Index): affine.Index = i;
lam column (_ j: affine.Index): affine.Index = j;
fun add (acc x: F32)@tt: F32 = return (math.arith.add mode (acc, x));
fun maximum (acc x: F32)@tt: F32 = return (math.extrema.fmax mode (acc, x));
fun copy (_ x: F32)@tt: F32 = return x;
fun bias_relu (value bias: F32)@tt: F32 =
    let value = math.arith.add mode (value, bias);
    return (math.extrema.fmax mode (value, 0.0:F32));
fun shifted_exp (_: F32, (x maximum: F32))@tt: F32 =
    return (math.exp.exp mode (math.arith.sub mode (x, maximum)));
fun divide (_: F32, (x divisor: F32))@tt: F32 = return (math.arith.div mode (x, divisor));
fun subtract (_: F32, (x mean: F32))@tt: F32 = return (math.arith.sub mode (x, mean));
fun square_sum (acc x: F32)@tt: F32 =
    return (math.arith.add mode (acc, math.arith.mul mode (x, x)));
fun normalize (_: F32, (x variance: F32))@tt: F32 =
    return (math.arith.div mode (x, math.rt.sq mode (math.arith.add mode (variance, 0.00001:F32))));

lam with_rows {M N: Nat} (combine: Fn [F32, «2; F32»] → F32, x: «M, N; F32», rows: «M; F32»): «M, N; F32» =
    map_reduce_post @(2, 0) @(F32, F32, 2, 2, SchedT) ((M, N), (M, N), mk_sched (2, 0))
        @((F32, F32), (2, 1), ((M, N), M), (), (), ())
        (combine, 0.0:F32, id @F32) (affine.id @2) ((affine.id @2, row), ()) ((x, rows), ());
lam row_reduce {M N: Nat} (combine: Fn [F32, F32] → F32, init: F32, x: «M, N; F32»): «M; F32» =
    map_reduce (M, (M, N)) (combine, init) row (affine.id @2,) x;
lam row_average {M N: Nat} (squares: Bool, x: «M, N; F32»): «M; F32» =
    let divisor = math.conv.u2f math.f32 (core.idx 0 0 N);
    fun mean (value: F32, _: [])@tt: F32 = return (math.arith.div mode (value, divisor));
    map_reduce_post @(1, 0) @(F32, F32, 1, 2, SchedT) (M, (M, N), mk_sched (2, 0))
        @(F32, 2, (M, N), (), (), ())
        ((add, square_sum)#squares, 0.0:F32, mean) row ((affine.id @2,), ()) ((x,), ());
lam row_soft {M N: Nat} (x: «M, N; F32»): «M, N; F32» =
    let maximum = row_reduce (maximum, math.neg_inf math.f32, x);
    let exp = with_rows (shifted_exp, x, maximum);
    let sum = row_reduce (add, 0.0:F32, exp);
    with_rows (divide, exp, sum);
lam row_layer {M N: Nat} (x: «M, N; F32»): «M, N; F32» =
    let mean = row_average (ff, x);
    let centered = with_rows (subtract, x, mean);
    let variance = row_average (tt, centered);
    with_rows (normalize, centered, variance);

lam gemm_relu {M K N: Nat} (a: «M, K; F32», b: «K, N; F32», bias: «N; F32»): «M, N; F32» =
    let product = product_2d Ring (a, b);
    map_reduce_post @(1, 1) @(F32, F32, 2, 2, SchedT) ((M, N), (M, N), mk_sched (2, 0))
        @(F32, 2, (M, N), F32, 1, N)
        (copy, 0.0:F32, bias_relu)
        (affine.id @2) ((affine.id @2,), (column,)) ((product,), (bias,));
lam mlp_chain {M K H N: Nat} (a: «M, K; F32», b: «K, H; F32», w: «H, N; F32»): «M, N; F32» =
    let hidden = gemm_relu (a, b, splat (H, 0.0:F32));
    product_2d Ring (hidden, w);

extern fun gemm (a: «13, 7; F32», b: «7, 11; F32», bias: «11; F32»): «13, 11; F32» =
    return (gemm_relu (buf a, buf b, buf bias));
extern fun mlp (a: «13, 7; F32», b: «7, 11; F32», w: «11, 5; F32»): «13, 5; F32» =
    return (mlp_chain (buf a, buf b, buf w));
extern fun soft (x: «5, 7; F32»): «5, 7; F32» = return (row_soft (buf x));
extern fun layer (x: «5, 7; F32»): «5, 7; F32» = return (row_layer (buf x));
extern fun conv_chain (a: «1, 2, 7, 8; F32», w: «3, 2, 3, 3; F32», v: «2, 3, 3, 3; F32»): «1, 2, 3, 4; F32» =
    let hidden = conv Ring @(1, 2, 3, 7, 8, 3, 3) ((1, 1), (1, 1), (0, 0)) (buf a, buf w);
    return (conv Ring @(1, 3, 2, 5, 6, 3, 3) ((1, 1), (1, 1), (0, 0)) (hidden, buf v));

