// RUN: python3 %S/group_run.py %mim %S/../rules/tf_reverse_exec.mim %t.reverse > %t.reverse.out 2> %t.reverse.log
// RUN: %FileCheck %s --check-prefix=REVERSE < %t.reverse.out
// RUN: python3 %S/group_run.py %mim %S/../rules/tf_halo_exec.mim %t.halo -Xtensor:group-budget=3 > %t.halo.out 2> %t.halo.log
// RUN: %FileCheck %s --check-prefix=HALO < %t.halo.out
// RUN: python3 %S/group_run.py %mim %S/row_norm.mim %t.norm normalization > %t.norm.out 2> %t.norm.log
// RUN: %FileCheck %s --check-prefix=NORM < %t.norm.out

