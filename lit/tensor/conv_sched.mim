// RUN: %mim -p opt %s -o - | %FileCheck %s

// Schedule SELECTION for convolutions, decided in the IR from the op's parameters.
// With at least 8 output channels and columns and 2 input channels, `conv_schedule_tiled` blocks the op as an implicit
// GEMM — c64, c13, p64 and p14 (chooser (4, 0): vdim 4, no window unrolled).
// The others take `conv_schedule`, the old lowering's heuristics, which strip-mines `ci`, `co` and `oh` (neutrally by 1,
// or by a real tile: `ci`/`co` when the window is POINTWISE, `oh` by the largest dividing size ≤ 4 when rows BLOCK:
// vectorized, ow < 16, oh divisible), so the domain is rank 10 (n, co/cb, cb, oh/ts, ts, ow, ci/cts, cts, kh, kw):
// * stride 2 (ow = 4): the window unrolls (9 taps), cin stays a loop (576 > 32), ow vectorizes and rows block
//   (oh = 4 → block size 4) — chooser (4, 2) (vdim = ro − 2 = the block dim);
// * cin = 64, 3x3 at 16x16 with co = 4: ow vectorizes but rows do not block (ow = 16) — chooser (5, 2);
// * cin = 3, 3x3 with co = 4: the whole reduction unrolls (27 taps ≤ 32), nothing left to vectorize against — chooser
//   (10, 4) (10 = "no vector dim" sentinel);
// * 1x1 with co = 3: no `co` block divides, so rows block instead and only a `ci` tile (cts = 8) joins the window —
//   chooser (4, 3).

plugin tensor;
plugin math;
plugin compile;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;
let Ring = (F32, 0.0:F32, math.arith.add fast, math.arith.mul fast);
let same = ((1, 1), (1, 1), (1, 1));
let pw   = ((1, 1), (1, 1), (0, 0));

extern lam c64 (input: «2, 64, 8, 8; F32», w: «16, 64, 3, 3; F32»): «2, 16, 8, 8; F32» =
    conv Ring same (input, w);
extern lam c3 (input: «2, 3, 8, 8; F32», w: «4, 3, 3, 3; F32»): «2, 4, 8, 8; F32» =
    conv Ring same (input, w);
extern lam cs2 (input: «2, 64, 9, 9; F32», w: «16, 64, 3, 3; F32»): «2, 16, 4, 4; F32» =
    conv Ring ((2, 2), (1, 1), (0, 0)) (input, w);
extern lam c64w (input: «2, 64, 16, 16; F32», w: «4, 64, 3, 3; F32»): «2, 4, 16, 16; F32» =
    conv Ring same (input, w);
extern lam p64 (input: «2, 64, 8, 8; F32», w: «16, 64, 1, 1; F32»): «2, 16, 8, 8; F32» =
    conv Ring pw (input, w);
extern lam p3 (input: «2, 64, 8, 8; F32», w: «3, 64, 1, 1; F32»): «2, 3, 8, 8; F32» =
    conv Ring pw (input, w);
extern lam p14 (input: «2, 64, 14, 14; F32», w: «16, 64, 1, 1; F32»): «2, 16, 14, 14; F32» =
    conv Ring pw (input, w);
extern lam c13 (input: «2, 64, 13, 13; F32», w: «16, 64, 3, 3; F32»): «2, 16, 13, 13; F32» =
    conv Ring same (input, w);

extern lam _compile (): compile.Phase =
    compile.phases ff (
        compile.cleanup,
        tensor.lower_tensor,
        compile.cleanup,
    );

// CHECK-DAG: {{mk_[0-9]+ \(10, 4, }}
// CHECK-DAG: {{mk_[0-9]+ \(4, 2, }}
// CHECK-DAG: {{mk_[0-9]+ \(5, 2, }}
// CHECK-DAG: {{mk_[0-9]+ \(4, 3, }}
// CHECK-DAG: {{mk_[0-9]+ \(4, 0, }}
// The binding-time guards must all have resolved.
// CHECK-NOT: if_static
