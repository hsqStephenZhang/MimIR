// RUN: %mim -X tensor:reference-tiles=1 %s -o - | %FileCheck %s --implicit-check-not=mem.fresh

plugin tensor;
plugin core;
plugin compile;
plugin mem;
plugin buffer;
plugin affine;
plugin cps;
extern fun folded (x: «3; I64»): «3; I64» =
    return (tensor.tile_fold (3, 2) (tensor.buf x)
        (λ (acc: «3; I64», off: Nat): «3; I64» =
            tensor.binary (core.wrap.add 0 @0) @(1, 3)
                (acc, tensor.splat (3, core.bitcast I64 off))));
extern lam _compile (): compile.Phase =
    compile.phases ff (tensor.lower_tensor, tensor.fuse_tensor, tensor.lower_to_mem, mem.add_mem,
        compile.named "btensor.lower_map_reduce", buffer.lower_ptr, affine.lower_index, cps.conv,
        affine.lower_for, mem.resolve_fresh, compile.cleanup);

// CHECK-LABEL: extern con folded
// CHECK-DAG: mem.alloc
// CHECK-DAG: mem.load
// CHECK-DAG: mem.store
