// RUN: %mim -p opt %s -o - | %FileCheck %s

// TVM classifies a broadcast producer as kBroadcast. `broadcast_in_dim`
// normalizes to a map_reduce with an identity output map and a broadcast input
// access map, so the continuation materializer can fuse it with the following
// elementwise operation.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);

con extern f [v: «3; Nat», return: Cn «2; «3; Nat»»] =
    let broadcast = %tensor.broadcast_in_dim (3, (2, 3), v, (1_2,));
    let mapped    = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) broadcast;
    return mapped;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK-COUNT-1: = %tensor.map_reduce
// CHECK-NOT: %tensor.map_reduce
