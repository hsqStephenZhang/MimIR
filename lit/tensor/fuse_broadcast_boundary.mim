// RUN: %mim -p opt %s -o - | %FileCheck %s

// TVM classifies a broadcast producer as kBroadcast.  MimIR's broadcast
// lowering keeps an identity output map, so the continuation materializer can
// safely fuse this producer with the following elementwise operation.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);

con extern f [v: «2; «1; Nat»», return: Cn «2; «3; Nat»»] =
    let broadcast = %tensor.broadcast ((2, 1), (2, 3), v);
    let mapped    = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) broadcast;
    return mapped;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK: %tensor.map_reduce
// CHECK-NOT: %tensor.map_reduce
