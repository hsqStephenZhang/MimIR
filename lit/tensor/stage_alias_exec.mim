// RUN: %mim -p opt %s -p ll
// RUN: clang++ -O3 -fsanitize=address %S/stage_alias_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -X tensor:reference-tiles=1 -p opt %s -p ll
// RUN: clang++ -O3 -fsanitize=address %S/stage_alias_aux.cpp %{s:stem}.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

plugin tensor;
plugin core;
use tensor;
lam increment (x: I64): I64 = core.wrap.add 0 (x, 1I64);

extern fun identity_stage (x: tensor.Tensor 2 (5, 7) I64): tensor.Tensor 2 (5, 7) I64 =
    return (tiled ((5, 7), (2, 7), 1)
        x
        (λ (off ext: «2; Nat») (x): tensor.Tensor 2 ext I64 =
            let p = unary increment (slice (5, 7) (off, (1, 1), ext) (buf x));
            let p = stage @(I64, 2, 0) ext ((), (), (ff, tt), 0I64) 0 p;
            unary increment p));

extern fun permuted_stage (x: tensor.Tensor 2 (5, 7) I64): tensor.Tensor 2 (5, 7) I64 =
    return (tiled ((5, 7), (2, 7), 1)
        x
        (λ (off ext: «2; Nat») (x): tensor.Tensor 2 ext I64 =
            let p = unary increment (slice (5, 7) (off, (1, 1), ext) (buf x));
            let p = stage @(I64, 2, 0) ext ((), (), (tt, ff), 0I64) 0 p;
            let p = unary increment p;
            let p = stage @(I64, 2, 0) (ext#tt, ext#ff) ((), (), (tt, ff), 0I64) 0 p;
            unary increment p));

extern fun whole_stage (x: tensor.Tensor 2 (5, 7) I64): tensor.Tensor 2 (5, 7) I64 =
    let p = unary increment (buf x);
    let p = stage @(I64, 2, 0) (5, 7) ((), (), (ff, tt), 0I64) 0 p;
    return (unary increment p);

extern fun borrowed_stage (x: tensor.Tensor 2 (5, 7) I64): tensor.Tensor 2 (5, 7) I64 =
    return (stage @(I64, 2, 0) (5, 7) ((), (), (ff, tt), 0I64) 0 (buf x));
