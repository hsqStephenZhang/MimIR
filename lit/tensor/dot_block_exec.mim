// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/dot_block_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// Executable cache-blocked contractions (see dot_block.mim), driven by dot_block_aux.cpp against a scalar reference:
// N and a 4 x 16 register block, N and the hoisted K blocked, and a conv-like product with a batch outside the blocks.
// `pack` and `pack_conv` pack the right operand into 16-column panels, `pack_tail` and `pack_tails` with N padded to
// whole panels; `part`, `pack`, `pack_conv` and `pack_tails` partition M into 6-row register blocks whose last block is
// partial.
plugin tensor;
plugin refly;
plugin core;
plugin cps;
plugin affine;
plugin mem;
plugin math;

let F32 = math.F32;

let R: tensor.Ring = (F32, 0:F32, math.arith.add 0, math.arith.mul 0);

extern fun nblk (a: «8, 100; F32», b: «100, 512; F32»): «8, 512; F32» = return (tensor.product_2d R (a, b));
extern fun kblk (a: «8, 2304; F32», b: «2304, 512; F32»): «8, 512; F32» = return (tensor.product_2d R (a, b));
// The register block with a ring that allows contraction into fused multiply-adds.
let R_fma: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);
extern fun nblk_fma (a: «8, 100; F32», b: «100, 512; F32»): «8, 512; F32» = return (tensor.product_2d R_fma (a, b));
extern fun conv (w: «6, 96; F32», c: «2, 96, 640; F32»): «6, 2, 640; F32» =
    return (tensor.dot_product R (1_2, 1_3, (), ()) (w, c));
extern fun pack (a: «64, 130; F32», b: «130, 512; F32»): «64, 512; F32» = return (tensor.product_2d R_fma (a, b));
extern fun pack_conv (w: «64, 147; F32», c: «2, 147, 640; F32»): «64, 2, 640; F32» =
    return (tensor.dot_product R_fma (1_2, 1_3, (), ()) (w, c));
extern fun part (a: «20, 100; F32», b: «100, 512; F32»): «20, 512; F32» = return (tensor.product_2d R_fma (a, b));
extern fun pack_tail (a: «64, 130; F32», b: «130, 500; F32»): «64, 500; F32» = return (tensor.product_2d R_fma (a, b));
extern fun pack_tails (a: «50, 130; F32», b: «130, 500; F32»): «50, 500; F32» = return (tensor.product_2d R_fma (a, b));
