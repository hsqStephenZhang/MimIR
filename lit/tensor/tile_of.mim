// RUN: %mim %s -o - 2> %t.log | %FileCheck %s --implicit-check-not=tensor.tile_of
// RUN: %FileCheck %s --check-prefix=REPORT < %t.log

plugin tensor;
plugin affine;
plugin core;
plugin compile;
use tensor;

fun keep (_ x: I64)@tt: I64 = return x;
fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));

extern fun cut (a: «6, 5; I64»): «3, 5; I64» =
    let p = map_reduce ((6, 5), (6, 5)) (keep, 0I64) (affine.id @2) (affine.id @2,) (buf a);
    return (tile_of (p, (2, 0), (3, 5)));

// CHECK-LABEL: extern fun cut
// CHECK: tensor.map_reduce_post

extern fun unknown (a: «6; I64»): «3; I64» =
    return (tile_of (buf a, 1, 3));

// REPORT-DAG: tensor.tile_of fallback: producer is not a map_reduce_post

extern fun reduction_cut (a: «6, 5; I64»): «3; I64» =
    let p = map_reduce (6, (6, 5)) (add, 0I64)
        (λ (i k: affine.Index): affine.Index = k) (affine.id @2,) (buf a);
    return (tile_of (p, 1, 3));

// REPORT-DAG: tensor.tile_of fallback: write preimage cuts a reduction dimension

extern fun inexact (a: «6, 5; I64»): «2, 2; I64» =
    let p = map_reduce ((11, 5), (6, 5)) (keep, 0I64)
        (λ (i j: affine.Index): «2; affine.Index» = (affine.op.add (i, j), j))
        (affine.id @2,) (buf a);
    return (tile_of (p, (2, 1), (2, 2)));

// REPORT-DAG: tensor.tile_of fallback: write preimage is not proven exact

extern lam _compile (): compile.Phase =
    compile.phases ff (lower_tensor, compile.cleanup);
