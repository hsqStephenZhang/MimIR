// RUN: %mim -p opt %s -p ll -X ll:asan=1 -X ll:o=%t0.ll -o %t0.mim
// RUN: clang++ -O2 -fsanitize=address %S/pe_aff_aux.cpp %t0.ll -o %t0.exec -Wno-override-module
// RUN: %t0.exec
// RUN: %mim -p opt -X tensor:pe-generic=0 -X tensor:pe-cpu=0 %s -p ll -X ll:asan=1 -X ll:o=%t1.ll -o %t1.mim
// RUN: clang++ -O2 -fsanitize=address %S/pe_aff_aux.cpp %t1.ll -o %t1.exec -Wno-override-module
// RUN: %t1.exec
// RUN: %mim -VVV -p opt %s -o %t2.mim 2>&1 | %FileCheck %s

// Reads through a flip, a broadcast and a reshape, whose maps subtract, multiply by 0 and take a modulus, tiled by `run_levels`.
// CHECK-DAG: tile the contraction over (21, 13, 17) with tensor.run_levels
// CHECK-DAG: tile the map-reduce over (19, 23) with tensor.run_levels
// CHECK-DAG: tile the map-reduce over (5, 31) with tensor.run_levels
// CHECK-DAG: tile the map-reduce over (4, 6) with tensor.run_levels
// CHECK-DAG: tile the contraction over ({{.*_[0-9]+}}, 5, 8) with tensor.run_levels
plugin tensor;
plugin core;
plugin math;
plugin affine;

let F32 = math.F32;
let R: tensor.Ring = (F32, 0:F32, math.arith.add math.mode.contract, math.arith.mul math.mode.contract);
lam add (x y: F32): F32 = math.arith.add 0 (x, y);

extern fun flip_mm (a: tensor.Tensor 2 (21, 17) F32, b: tensor.Tensor 2 (17, 13) F32): tensor.Tensor 2 (21, 13) F32 =
    return (tensor.product_2d R (tensor.flip (21, 17) a, b));

extern fun flip_add (x y: tensor.Tensor 2 (19, 23) F32): tensor.Tensor 2 (19, 23) F32 =
    return (tensor.binary add (tensor.flip (19, 23) x, y));

extern fun bcast_add (x: tensor.Tensor 2 (1, 31) F32, y: tensor.Tensor 2 (5, 31) F32): tensor.Tensor 2 (5, 31) F32 =
    return (tensor.binary add (tensor.broadcast_in_dim ((1, 31), (5, 31), x, (0₂, 1₂)), y));

extern fun reshape_add (x: tensor.Tensor 1 24 F32, y: tensor.Tensor 2 (4, 6) F32): tensor.Tensor 2 (4, 6) F32 =
    return (tensor.binary add (tensor.reshape 24 (4, 6) x, y));

// A reshape of run-time extents reads through a run-time modulus and stride.
extern fun reshape_mm {m: Nat} (a: tensor.Tensor 1 (core.nat.mul (m, 8)) F32, b: tensor.Tensor 2 (8, 5) F32): tensor.Tensor 2 (m, 5) F32 =
    return (tensor.product_2d R (tensor.reshape (core.nat.mul (m, 8)) (m, 8) a, b));
