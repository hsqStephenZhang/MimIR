// RUN: %mim -p opt -X tensor:tile-fuse=1 %s -p ll -X ll:o=%t.ll
// RUN: clang++ -O1 -fsanitize=address %S/law_sources_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec
// RUN: %FileCheck %s --input-file=%t.ll

// A product of two producers, each a law fused as a source: every block computes the boxes of both producers it reads.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));
fun twice (_: F32, xs: [F32])@tt: F32 =
    let (x) = xs;
    return (math.arith.add fast (x, x));
fun succ (_: F32, xs: [F32])@tt: F32 =
    let (x) = xs;
    return (math.arith.add fast (x, 1.0:F32));

lam doubled (x: tensor.Tensor 2 (32, 16) F32) =
    law.of_map_reduce ((32, 16), (32, 16)) (twice, 0.0:F32) (affine.id @2) (affine.id @2,) (buf x);
lam shifted (y: tensor.Tensor 2 (16, 32) F32) =
    law.of_map_reduce ((16, 32), (16, 32)) (succ, 0.0:F32) (affine.id @2) (affine.id @2,) (buf y);

lam gemm (x: tensor.Tensor 2 (32, 16) F32, y: tensor.Tensor 2 (16, 32) F32) =
    let a = doubled x;
    let b = shifted y;
    law.of_sources ((32, 32), (32, 32, 16)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1))
        (tensor.Tensor 2 (32, 16) F32, tensor.Tensor 2 (16, 32) F32) (law.as_source a, law.as_source b)
        (law.denote a, law.denote b);

let staged   = serial_par ((8, 8, 0), 0, serial_red ((0, 0, 4), 1, 3, serial_par ((2, 4, 0), 0, serial_done ())));
let unstaged = serial_par ((8, 8, 0), 0, serial_red ((0, 0, 4), 1, 0, serial_done ()));

extern fun sources_denote (x: tensor.Tensor 2 (32, 16) F32, y: tensor.Tensor 2 (16, 32) F32): tensor.Tensor 2 (32, 32) F32 =
    return (law.denote (gemm (x, y)));
extern fun sources_staged (x: tensor.Tensor 2 (32, 16) F32, y: tensor.Tensor 2 (16, 32) F32): tensor.Tensor 2 (32, 32) F32 =
    return (law.run (gemm (x, y), staged, default_control));
extern fun sources_unstaged (x: tensor.Tensor 2 (32, 16) F32, y: tensor.Tensor 2 (16, 32) F32): tensor.Tensor 2 (32, 32) F32 =
    return (law.run (gemm (x, y), unstaged, default_control));

// CHECK-LABEL: define {{.*}}@sources_staged
// CHECK-NOT: @malloc(i64 2048)
// CHECK: {{^}}}
