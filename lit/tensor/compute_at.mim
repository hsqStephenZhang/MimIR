// RUN: %mim %s -p opt -o %t
// RUN: cat %t | %FileCheck %s

// tensor.compute_at computes a producer inside its consumer's loop nest, into a tile of just what the loops below the
// given level read; the producer is never materialized. Checked on the allocations the lowered program makes:
// * `att`:  the exp(q · kt) scores per query row, a 40-element tile instead of the 48 x 40 scores;
// * `mlp`:  relu(a) per row of a, a 36-element tile instead of 20 x 36;
// * `pack`: a product's packed right operand per 16-column panel, 130 x 16 although the contraction runs to 132;
// * `pool`: relu(x) per output row of a 2x2/stride-2 pool, the 2 x 10 input rows its window reads;
// * `twice`: a producer with a second consumer stays materialized.

plugin tensor;
plugin refly;
plugin core;
plugin cps;
plugin affine;
plugin mem;
plugin math;

let F32 = math.F32;

let R: tensor.Ring = (F32, 0:F32, math.arith.add 0, math.arith.mul 0);

lam relu (x: F32): F32 = math.extrema.fmax 0 (0:F32, x);

// CHECK-LABEL: extern con att
// CHECK-NOT: mem.malloc («48, 40;
// CHECK: mem.malloc («40;
// CHECK-NOT: mem.malloc («48, 40;
extern fun att (q: «48, 16; F32», kt: «16, 40; F32», v: «40, 24; F32»): «48, 24; F32» =
    let s = tensor.unary (math.exp.exp 0) (tensor.product_2d R (q, kt));
    return (tensor.product_2d R (tensor.compute_at 1 s, v));

// CHECK-LABEL: extern con mlp
// CHECK-NOT: mem.malloc («20, 36;
// CHECK: mem.malloc («36;
// CHECK-NOT: mem.malloc («20, 36;
extern fun mlp (a: «20, 36; F32», b: «36, 28; F32»): «20, 28; F32» =
    return (tensor.product_2d R (tensor.compute_at 1 (tensor.unary relu a), b));

// CHECK-LABEL: extern con pack
// CHECK-NOT: mem.malloc («32, 130, 16;
// CHECK: mem.malloc («130, 16;
// CHECK-NOT: mem.malloc («32, 130, 16;
extern fun pack (a: «64, 130; F32», b: «130, 512; F32»): «64, 512; F32» = return (tensor.product_2d R (a, b));

// CHECK-LABEL: extern con pool
// CHECK-NOT: mem.malloc («2, 3, 8, 10;
// CHECK: mem.malloc («2, 10;
// CHECK-NOT: mem.malloc («2, 3, 8, 10;
extern fun pool (x: «2, 3, 8, 10; F32», _: F32): «2, 3, 4, 5; F32» =
    let y = tensor.compute_at 3 (tensor.unary relu x);
    return (tensor.pool (math.extrema.fmax 0, 0:F32) ((2, 2), (2, 2), (1, 1), (0, 0), (4, 5)) y);

// CHECK-LABEL: extern con twice
// CHECK: mem.malloc («20, 36;
extern fun twice (a: «20, 36; F32», b: «36, 28; F32»): «20, 28; F32» =
    let r = tensor.unary relu a;
    let p = tensor.product_2d R (tensor.compute_at 1 r, b);
    return (tensor.binary (math.arith.add 0) (p, tensor.product_2d R (r, b)));
