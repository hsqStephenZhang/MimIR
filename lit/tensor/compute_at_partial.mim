// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt -p clos -p ll %s
// RUN: clang++ %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// P has 5 rows and two readers: C reads only its first 3 rows, computing P per row at its loop, and D reads it whole.
// C's tiles do not fill P, so P is not shared with D, which must not see rows that no tile computed.
// The exit code counts the cells of C · Dᵀ that differ from the product of unscheduled ones.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun mac (acc: I32, (x y: I32))@tt: I32 = return (acc + x * y);
fun sum (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam add (x y: I32): I32 = x + y;
lam mo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam ma (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam mb (_ j k: affine.Index): «2; affine.Index» = (k, j);
lam qo (i j _: affine.Index): «2; affine.Index» = (i, j);
lam pa (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam mdt (_ j k: affine.Index): «2; affine.Index» = (j, k);

let a = generate (5, 14, 2) (λ i: «3; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (core.wrap.mul 0 (3I64, i#0_3), core.wrap.sub 0 (i#1_3, i#2_3))));
let b = generate (14, 3) (λ i: «2; I64»: I32 = core.conv.s 4294967296 (core.wrap.add 0 (i#0_2, core.wrap.mul 0 (2I64, i#1_2))));
lam diff {m n: Nat} (x y: «m, n; I32»): I32 =
    reduce (add, 0I32) 0₁ (reduce (add, 0I32) 1₂ (binary (λ (u v: I32): I32 = core.select (core.icmp.e (u, v), 0I32, 1I32)) (x, y)));

extern con main (m: mem.M 0, argc: I32, argv: mem.Ptr («core.idx2nat argc; mem.Ptr (mem.Char, 0)», 0), return: Cn [mem.M 0, I32]) =
    let p  = materialize (mr_tileable @1 @(2, 1) ((5, 14), (0, 1), (5, 14, 2)) (sum, 0I32, id) qo pa a);
    let c  = materialize (compute_at (mr_tileable @2 @(2, 1) ((3, 3), (0, 1), (3, 3, 14)) (mac, 0I32, id) mo (ma, mb) (p, b), 0, 0));
    let d  = materialize (mr_tileable @2 @(2, 1) ((5, 3), (0, 1), (5, 3, 14)) (mac, 0I32, id) mo (ma, mb) (p, b));
    let pr = materialize (mr_tileable @1 @(2, 1) ((5, 14), (0, 1), (5, 14, 2)) (sum2, 0I32, id) qo pa a);
    let cr = materialize (mr_tileable @2 @(2, 1) ((3, 3), (0, 1), (3, 3, 14)) (mac, 0I32, id) mo (ma, mb) (pr, b));
    let dr = materialize (mr_tileable @2 @(2, 1) ((5, 3), (0, 1), (5, 3, 14)) (mac, 0I32, id) mo (ma, mb) (pr, b));
    let e  = materialize (mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 3)) (mac, 0I32, id) mo (ma, mdt) (c, d));
    let er = materialize (mr_tileable @2 @(2, 1) ((3, 5), (0, 1), (3, 5, 3)) (mac, 0I32, id) mo (ma, mdt) (cr, dr));
    return (m, diff (e, er));
