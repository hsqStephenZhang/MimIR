// RUN: %mim -I %S -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/blis_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -X tensor:reference-tiles=1 -I %S -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/blis_aux.cpp %{s:stem}.ll -o %t.ref -Wno-override-module
// RUN: %t.ref

import blis;
import opt;
plugin compile;
extern lam _compile (): compile.Phase =
    compile.phases ff (compile.rule_app blis.pack, opt._default_compile ());
