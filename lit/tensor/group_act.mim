// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/group_act_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// RUN: %mim -p opt %s -o - | %FileCheck %s

// C[j] = Σ_i P[i, j] with the row sums P[i, j] = Σ_k x[i, j, k] and an action in C's loop of j that counts its runs.
// group_tensor computes P one column per j inside that loop, after the action, which still runs once per j.
plugin core;
plugin tensor;
plugin affine;
plugin mem;

use core.ops.u.w;
use tensor;

fun sum1 (acc: I32, x: I32)@tt: I32 = return (acc + x);
fun sum2 (acc: I32, x: I32)@tt: I32 = return (acc + x);
lam q2 (i j _: affine.Index): «2; affine.Index» = (i, j);
lam q3 (i j k: affine.Index): «3; affine.Index» = (i, j, k);
lam tr (j i: affine.Index): «2; affine.Index» = (i, j);
lam ro (j _: affine.Index): affine.Index = j;

extern fun counted (x: «6, 4, 3; I32», n: mem.Ptr0 I32): «4; I32» =
    fun tick (m: mem.M 0, _: Nat → I32)@tt: mem.M 0 =
        let (m, v) = mem.load (m, n);
        return (mem.store (m, n, v + 1I32));
    let p = materialize (mr_tileable @1 @(2, 1) ((6, 4), (0, 1), (6, 4, 3)) (sum1, 0I32, id) q2 q3 (buf x));
    let c = mr_tileable @1 @(1, 1) (4, 0, (4, 6)) (sum2, 0I32, id) ro tr p;
    let c = c#7_9#7_23 ← 1;
    let c = c#7_9#8_23 ← lm (_: Nat): Fn [mem.M 0, Nat → I32] → mem.M 0 = tick;
    return (materialize c);

// CHECK-NOT: mem.{{m?slot|malloc}} («6, 4; I32»
