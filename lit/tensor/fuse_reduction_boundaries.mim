// RUN: %mim -p opt %s -o - | %FileCheck %s

// kCommReduce is a fusion boundary for producers, but it can be the sink of
// an elementwise group.  The first function checks the forbidden direction;
// the second checks the supported map-to-reduction direction.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);
fun sum_reduce (acc x: Nat)@tt: Nat = return (%core.nat.add (acc, x));

con extern reduction_then_map [v: «2; «3; Nat»», return: Cn «2; Nat»] =
    let reduced = %tensor.map_reduce @1 @(Nat, 1, 1) (2, (2, 3)) @(Nat, 2, (2, 3)) (sum_reduce, 0)
        (%tensor.proj_map @(2, 1) 0)
        (%tensor.proj_map @(2, 2) (0, 1),)
        v;
    let result = %tensor.unary @(Nat, Nat) add1 @(1, 2) reduced;
    return result;

con extern map_then_reduction [v: «2; «3; Nat»», return: Cn «2; Nat»] =
    let mapped = %tensor.unary @(Nat, Nat) add1 @(2, (2, 3)) v;
    let result = %tensor.map_reduce @1 @(Nat, 1, 1) (2, (2, 3)) @(Nat, 2, (2, 3)) (sum_reduce, 0)
        (%tensor.proj_map @(2, 1) 0)
        (%tensor.proj_map @(2, 2) (0, 1),)
        mapped;
    return result;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// Two map_reduces remain for reduction->map; map->reduction is fused into its
// reduction sink, giving three map_reduces across the two functions.
// CHECK-COUNT-3: %tensor.map_reduce
