// RUN: %mim -X tensor:reference-tiles=1 %s -o - | %FileCheck %s

plugin tensor;
plugin core;
plugin compile;
plugin mem;
extern fun folded (x: «3; I64»): «3; I64» =
    return (tensor.tile_fold (3, 2) (tensor.buf x)
        (λ (acc: «3; I64», off: Nat): «3; I64» =
            tensor.binary (core.wrap.add 0 @0) @(1, 3)
                (acc, tensor.splat (3, core.bitcast I64 off))));
extern lam _compile (): compile.Phase =
    compile.phases ff (tensor.lower_tensor, tensor.fuse_tensor, tensor.lower_to_mem, mem.add_mem, compile.cleanup);

// CHECK-LABEL: extern con folded
// CHECK: fun run
// CHECK: con fresh_mem
// CHECK: con next
// CHECK-NEXT: mem.fresh
// CHECK: cps.cps2ds_dep
