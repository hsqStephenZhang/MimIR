// RUN: python3 %S/../rules/tf_run.py %mim %s %t rule > %t.out 2> %t.log
// RUN: %FileCheck %s --implicit-check-not='mark @' < %t.out
// TF-RULES: pack
// TF-PURE: mark
// CHECK-DAG: tensor.tile_req

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;
use core.ops.n;

let Config = [mr nr nc kc: Nat, pack_a: Bool];
let Ring = (I64, 0I64, core.wrap.add 0 @0, core.wrap.mul 0 @0);
lam valid (M K N MR KR NR: Nat): Bool =
    core.bit2.and 0 (core.bit2.and 0 (M > 0, K > 0),
        core.bit2.and 0 (core.bit2.and 0 (N > 0, MR > 0), core.bit2.and 0 (KR > 0, NR > 0)));
lam select_config (lanes registers cache_bytes: Nat, pack_a: Bool): Config =
    let (mr, nr, kc, nc) = group_blocks (core.trait.size I64, lanes, registers, cache_bytes);
    (mr, nr, nc, kc, pack_a);
axm mark: {M K N: Nat} → [config: Config, tensor.Tensor 2 (M, N) I64] → tensor.Tensor 2 (M, N) I64;

lam packed_with_post {M K N: Nat} (config: Config, a: tensor.Tensor 2 (M, K) I64, b: tensor.Tensor 2 (K, N) I64,
    add mul: «2; I64» → I64, bias: tensor.Tensor 1 N I64, epilogue: Fn [I64, I64] → I64, apply_post: Bool): tensor.Tensor 2 (M, N) I64 =
    let (MR, NR, NC, KC, pack_a) = config;
    fun combine (acc: I64, pair: «2; I64»)@tt: I64 = return (add (acc, mul pair));
    fun identity (value _: I64)@tt: I64 = return value;
    let root = map_reduce_post @(2, 1) @(I64, I64, 2, 3, SchedT)
        ((M, N), (M, N, K), mk_sched (3, 0))
        @((I64, I64), (2, 2), ((M, K), (K, N)), I64, 1, N)
        (combine, 0I64, (identity, epilogue)#apply_post)
        (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)), proj_map @(2, 1) 1)
        ((a, b), bias);
    tile_req (root, (a, b), cpu_contraction_levels @I64 (2, MR, NR, MR * 2, NC, KC, (2, 3)#pack_a), default_control);

lam packed {M K N: Nat} (config: Config, a: tensor.Tensor 2 (M, K) I64, b: tensor.Tensor 2 (K, N) I64,
    add mul: «2; I64» → I64): tensor.Tensor 2 (M, N) I64 =
    fun identity (value _: I64)@tt: I64 = return value;
    packed_with_post @(M, K, N) (config, a, b, add, mul, splat (N, 0I64), identity, ff);

axm mark_post: {M K N: Nat} → [config: Config, tensor.Tensor 2 (M, N) I64, bias: tensor.Tensor 1 N I64] → tensor.Tensor 2 (M, N) I64;
fun bias_relu (value bias: I64)@tt: I64 =
    let value = core.wrap.add 0 (value, bias);
    return (core.select (core.icmp.sl (value, 0I64), 0I64, value));

pub rule pack_post (M K N: Nat, config: Config, a: tensor.Tensor 2 (M, K) I64, b: tensor.Tensor 2 (K, N) I64, bias: tensor.Tensor 1 N I64, add mul: «2; I64» → I64):
    mark_post @(M, K, N) (config, product_2d (I64, 0I64, add, mul) @(M, K, N) (a, b), bias)
    when core.bit2.and 0 (valid (M, K, N, config#mr, config#kc, config#nr), 0 < config#nc) =>
    packed_with_post @(M, K, N) (config, a, b, add, mul, bias, bias_relu, tt);

pub rule pack (M K N: Nat, config: Config, a: tensor.Tensor 2 (M, K) I64, b: tensor.Tensor 2 (K, N) I64, add mul: «2; I64» → I64):
    mark @(M, K, N) (config, product_2d (I64, 0I64, add, mul) @(M, K, N) (a, b))
    when core.bit2.and 0 (valid (M, K, N, config#mr, config#kc, config#nr), 0 < config#nc) =>
    packed @(M, K, N) (config, a, b, add, mul);

extern fun square (a b: tensor.Tensor 2 (8, 8) I64): tensor.Tensor 2 (8, 8) I64 =
    return (mark @(8, 8, 8) ((4, 4, 8, 4, ff), product_2d Ring @(8, 8, 8) (buf a, buf b)));
extern fun tailed (a: tensor.Tensor 2 (13, 7) I64, b: tensor.Tensor 2 (7, 11) I64): tensor.Tensor 2 (13, 11) I64 =
    return (mark @(13, 7, 11) ((4, 4, 8, 3, ff), product_2d Ring @(13, 7, 11) (buf a, buf b)));
extern fun skinny (a: tensor.Tensor 2 (1, 7) I64, b: tensor.Tensor 2 (7, 1) I64): tensor.Tensor 2 (1, 1) I64 =
    return (mark @(1, 7, 1) ((4, 4, 8, 3, ff), product_2d Ring @(1, 7, 1) (buf a, buf b)));
extern fun hand_square (a b: tensor.Tensor 2 (8, 8) I64): tensor.Tensor 2 (8, 8) I64 =
    return (packed @(8, 8, 8) ((4, 4, 8, 4, ff), buf a, buf b, core.wrap.add 0 @0, core.wrap.mul 0 @0));
extern fun hand_tailed (a: tensor.Tensor 2 (13, 7) I64, b: tensor.Tensor 2 (7, 11) I64): tensor.Tensor 2 (13, 11) I64 =
    return (packed @(13, 7, 11) ((4, 4, 8, 3, ff), buf a, buf b, core.wrap.add 0 @0, core.wrap.mul 0 @0));
extern fun hand_skinny (a: tensor.Tensor 2 (1, 7) I64, b: tensor.Tensor 2 (7, 1) I64): tensor.Tensor 2 (1, 1) I64 =
    return (packed @(1, 7, 1) ((4, 4, 8, 3, ff), buf a, buf b, core.wrap.add 0 @0, core.wrap.mul 0 @0));
extern fun register_tails (a: tensor.Tensor 2 (5, 9) I64, b: tensor.Tensor 2 (9, 19) I64): tensor.Tensor 2 (5, 19) I64 =
    return (mark @(5, 9, 19) ((4, 16, 16, 4, ff), product_2d Ring @(5, 9, 19) (buf a, buf b)));
