// RUN: %mim -p opt -X tensor:tile-fuse=2 %s -p ll -X ll:o=%t.ll -VVVV 2> %t.log
// RUN: %FileCheck %s < %t.log
// RUN: %FileCheck %s --check-prefix=BATCH < %t.log
// RUN: %FileCheck %s --check-prefix=PACK < %t.log
// RUN: clang++ -O1 -fsanitize=address %S/tile_group_contraction_aux.cpp %t.ll -o %t.exec -Wno-override-module
// RUN: %t.exec

// Batched contractions and contractions that read views are register-blocked contractions.
// An operand read through a view is materialized on its batch and contraction loops.
// Batched operands are packed behind their batch axes, also when the reduction fits one block.
// A batched contraction takes no members: its producers also feed other roots, so fusing them computes them twice.

plugin tensor;
plugin core;
plugin math;

let F32 = math.F32;
let mode = math.mode.contract;
let add = math.arith.add mode;
let R: tensor.Ring = (F32, 0:F32, add, math.arith.mul mode);

lam linear (rows inputs outputs: Nat)
    (x: tensor.Tensor 2 (rows, inputs) F32, w: tensor.Tensor 2 (outputs, inputs) F32, b: tensor.Tensor 1 (outputs) F32): tensor.Tensor 2 (rows, outputs) F32 =
    let y = tensor.dot_product R @ (2, 2) @ (1, 0)
        (1₂, 1₂, (), ()) @ ((rows, inputs), (outputs, inputs)) (x, w);
    tensor.binary add @ (2, (rows, outputs))
        (y, tensor.broadcast @ (F32, 2) ((1, outputs), (rows, outputs), tensor.reshape outputs (1, outputs) b));

extern fun mim_model (qkv: tensor.Tensor 2 (8, 48) F32, w: tensor.Tensor 2 (16, 16) F32, b: tensor.Tensor 1 (16) F32): tensor.Tensor 2 (8, 16) F32 =
    let qkv = tensor.buf qkv;
    let w = tensor.frozen (tensor.buf w);
    let b = tensor.frozen (tensor.buf b);
    let q = tensor.slice @ (F32, 2) (8, 48) ((0, 0), (1, 1), (8, 16)) qkv;
    let q = tensor.reshape (8, 16) (1, 8, 2, 8) q;
    let q = tensor.transpose @ (F32, 4) (0₄, 2₄, 1₄, 3₄) @ (1, 8, 2, 8) q;
    let q = tensor.reshape (1, 2, 8, 8) (2, 8, 8) q;
    let k = tensor.slice @ (F32, 2) (8, 48) ((0, 16), (1, 1), (8, 16)) qkv;
    let k = tensor.reshape (8, 16) (1, 8, 2, 8) k;
    let k = tensor.transpose @ (F32, 4) (0₄, 2₄, 1₄, 3₄) @ (1, 8, 2, 8) k;
    let k = tensor.reshape (1, 2, 8, 8) (2, 8, 8) k;
    let v = tensor.slice @ (F32, 2) (8, 48) ((0, 32), (1, 1), (8, 16)) qkv;
    let v = tensor.reshape (8, 16) (1, 8, 2, 8) v;
    let v = tensor.transpose @ (F32, 4) (0₄, 2₄, 1₄, 3₄) @ (1, 8, 2, 8) v;
    let v = tensor.reshape (1, 2, 8, 8) (2, 8, 8) v;
    let scores = tensor.dot_product R @ (3, 3) @ (1, 1) (2₃, 2₃, 0₃, 0₃) @ ((2, 8, 8), (2, 8, 8)) (q, k);
    let probabilities = tensor.softmax mode @ math.f32 @ 3 2₃ @ (2, 8, 8) scores;
    let context = tensor.dot_product R @ (3, 3) @ (1, 1) (2₃, 1₃, 0₃, 0₃) @ ((2, 8, 8), (2, 8, 8)) (probabilities, v);
    let context = tensor.reshape (2, 8, 8) (1, 2, 8, 8) context;
    let context = tensor.transpose @ (F32, 4) (0₄, 2₄, 1₄, 3₄) @ (1, 2, 8, 8) context;
    let context = tensor.reshape (1, 8, 2, 8) (8, 16) context;
    return (linear (8, 16, 16) (context, w, b));

// CHECK-COUNT-3: tensor.tile_group root {{.*}} kind 1
// BATCH-NOT: kind 1 members {{[1-9]}}
// PACK-COUNT-4: L{{[24]}} pack input {{[01]}} axis {{[12]}}
