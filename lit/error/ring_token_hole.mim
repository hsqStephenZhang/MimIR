// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: `?` stands for a ring slot token that no ring sync made

// An implicit token that nothing supplies leaves a hole, which erasure would turn into a read of the slot.

plugin gpu;
plugin compile;

lam get (s: Idx 3) {h: gpu.Held (0, 3) (s, tt)} (r: gpu.Panels (0, 3) Nat): Nat =
    let (p, _) = gpu.read_slot @(Nat, 0, 3) (r, s, s, h);
    p;

extern lam step (s: Idx 3, r: gpu.Panels (0, 3) Nat): Nat = get s r;

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
