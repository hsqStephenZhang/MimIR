// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot token `?` is never supplied

// An implicit token that nothing supplies leaves a hole, which erasure would turn into a read of the slot.

plugin gpu;
plugin compile;

lam get (s: Idx 3) {h: gpu.Held 3 (s, tt)} (r: «3; Nat»): Nat =
    let (p, _) = gpu.read_slot @(Nat, 3, gpu.Held 3) (r, s, s, h);
    p;

extern lam step (s: Idx 3, r: «3; Nat»): Nat = get s r;

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
