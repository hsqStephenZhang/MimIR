// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot `0₃` is read with the token of slot

// Block `2⁶⁴ − 3 + 3 · i` of a three-slot ring is in slot 1 until the sum wraps around, so slot 0 is not its slot.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam wrapped {depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (sync: gpu.SyncOf depth H V)
    (m: mem.M 0, i: Nat, ring: «depth; Nat»): [mem.M 0, Nat] =
    let (_, _, _, await, release, _, _) = sync;
    let n             = core.nat.add (18446744073709551613, core.nat.mul (depth, i));
    let (m, mine)     = await (m, n);
    let s             = core.idx 0 depth (core.nat.rem (n, depth));
    let (panel, mine) = gpu.read_slot @(Nat, depth, H) (ring, core.idx 0 depth 0, s, tt, mine);
    (release (m, s, tt, mine), panel);

extern lam step (m: mem.M 0, i: Nat, ring: «3; Nat»): [mem.M 0, Nat] =
    wrapped (gpu.Held 3) (gpu.Vacant 3) (gpu.async_ring @3 (1, ff)) (m, i, ring);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
