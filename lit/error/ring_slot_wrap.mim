// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot `0₃` is read with the token of slot

// Block `2⁶⁴ − 3 + 3 · i` of a three-slot ring is in slot 1 until the sum wraps around, so slot 0 is not its slot.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam wrapped {rid depth: Nat} (sync: gpu.SyncOf depth (gpu.Held (rid, depth)) (gpu.Vacant (rid, depth)) (gpu.Ring (rid, depth)))
    (m: mem.M 0, i: Nat, ring: gpu.Panels (rid, depth) Nat): [mem.M 0, Nat] =
    let (_, _, _, await, release, (_, state), _) = sync;
    let n             = core.nat.add (18446744073709551613, core.nat.mul (depth, i));
    let (m, mine, state)     = await (m, n, state);
    let s             = core.idx 0 depth (core.nat.rem (n, depth));
    let (panel, mine) = gpu.read_slot @(Nat, rid, depth) (ring, core.idx 0 depth 0, s, mine);
    ((release (m, s, tt, mine, tt, state))#0_2, panel);

extern lam step (m: mem.M 0, i: Nat, ring: gpu.Panels (0, 3) Nat): [mem.M 0, Nat] =
    wrapped @(0, 3) (gpu.async_ring @(0, 3) (1, ff)) (m, i, ring);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
