// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot token {{.*}} is used 2 times

// Only a selection among continuations runs one case: a selection among values computes both of them.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam either {depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (sync: gpu.SyncOf depth H V) (m: mem.M 0, n: Nat): mem.M 0 =
    let (_, _, _, await, release, _, _) = sync;
    let (m, mine) = await (m, n);
    let s = core.idx 0 depth (core.nat.rem (n, depth));
    (release (m, s, tt, mine), release (gpu.fence m, s, tt, mine))#(core.ncmp.e (n, 0));

extern lam step (m: mem.M 0, n: Nat): mem.M 0 =
    either (gpu.Held 2) (gpu.Vacant 2) (gpu.async_ring @2 (1, ff)) (m, n);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
