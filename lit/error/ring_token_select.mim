// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot token {{.*}} is used 2 times

// Only a selection among continuations runs one case: a selection among values computes both of them.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam either {depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (R: Bool → *) (sync: gpu.SyncOf depth H V R) (m: mem.M 0, n: Nat): mem.M 0 =
    let (_, _, _, await, release, (_, ring), _) = sync;
    let (m, mine, ring) = await (m, n, ring);
    let s = core.idx 0 depth (core.nat.rem (n, depth));
    ((release (m, s, tt, mine, tt, ring))#0_2, (release (gpu.fence m, s, tt, mine, tt, ring))#0_2)#(core.ncmp.e (n, 0));

extern lam step (m: mem.M 0, n: Nat): mem.M 0 =
    either (gpu.Held (0, 2)) (gpu.Vacant (0, 2)) (gpu.Ring (0, 2)) (gpu.async_ring @(0, 2) (1, ff)) (m, n);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
