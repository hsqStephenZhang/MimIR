// RUN: not %mim -p opt -X tensor:tile-fuse=1 %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: tile_tail.mim:20:{{.*}}error: a tail is 0 (cap) or 1 (peel)

// A tail caps or peels the last tile.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F    = math.F32;
let fast = math.mode.fast;

fun mac (acc: F, xy: [F, F])@tt: F =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let inner = group_warp ((16, 8, 0), 2, warp_red ((0, 0, 8), 1, 3, warp_mma (16, 8, 8)));

lam body (off ext: «2; Nat») (a: Tensor 2 (64, 64) F, b: Tensor 2 (64, 64) F, c: Tensor 2 (64, 64) F): Tensor 2 ext F =
    let ct = slice @(F, 2) (64, 64) (off, (1, 1), ext) c;
    let at = slice @(F, 2) (64, 64) ((off#0₂, 0), (1, 1), (ext#0₂, 64)) a;
    let bt = slice @(F, 2) (64, 64) ((0, off#1₂), (1, 1), (64, ext#1₂)) b;
    let root = map_reduce_acc (ext, (ext#0₂, ext#1₂, 64)) (mac, ct) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (at, bt);
    group_tile_req (root, (), (16, 64, 0), inner, default_control);

extern fun gemm (a b c: tensor.Tensor 2 (64, 64) F): tensor.Tensor 2 (64, 64) F =
    return (tiled ((64, 64), (16, 64), 1) (buf a, buf b, buf c)
        (bind @([off ext: «2; Nat»] → [Tensor 2 (64, 64) F, Tensor 2 (64, 64) F, Tensor 2 (64, 64) F] → Tensor 2 ext F) 1 body));
