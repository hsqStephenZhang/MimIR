// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot `{{.*}}` is read with the token of slot

// Holding block `n`'s slot does not let a step read the slot after it.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam next_slot {rid depth: Nat} (sync: gpu.SyncOf depth (gpu.Held (rid, depth)) (gpu.Vacant (rid, depth)) (gpu.Ring (rid, depth)))
    (m: mem.M 0, n: Nat, ring: gpu.Panels (rid, depth) Nat): [mem.M 0, Nat] =
    let (_, _, _, await, release, (_, state), _) = sync;
    let (m, mine, state)     = await (m, n, state);
    let s             = core.idx 0 depth (core.nat.rem (n, depth));
    let ahead         = core.idx 0 depth (core.nat.rem (core.nat.add (n, 1), depth));
    let (panel, mine) = gpu.read_slot @(Nat, rid, depth) (ring, ahead, s, mine);
    ((release (m, s, tt, mine, tt, state))#0_2, panel);

extern lam step (m: mem.M 0, n: Nat, ring: gpu.Panels (0, 2) Nat): [mem.M 0, Nat] =
    next_slot @(0, 2) (gpu.async_ring @(0, 2) (1, ff)) (m, n, ring);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
