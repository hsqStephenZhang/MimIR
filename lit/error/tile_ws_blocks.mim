// RUN: not %mim -p opt -X tensor:tile-fuse=1 %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: tile_ws_blocks.mim:26:{{.*}}error: a specialized reduction needs at least two blocks, not 1

// A specialized reduction's producer fills a ring, which needs at least two blocks.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_group ((128, 128, 0), 1, 0, group_warpgroup ((64, 128, 0), 1, wg_red_ws ((0, 0, 64), 1, 3, 2, 0, wg_mma (64, 128, 16))));

extern fun gemm_wg_mn (a: tensor.Tensor 2 (128, 64) H, b: tensor.Tensor 2 (64, 128) H): tensor.Tensor 2 (128, 128) F32 =
    let root = map_reduce ((128, 128), (128, 128, 64)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
