// RUN: not %mim -p opt -X tensor:tile-fuse=1 %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: law_shared_shape.mim:45:{{.*}}error: shared producer input 0 differs from the consumer's input 0 in rank, shape or element size

// The producer reads 64 × 128, so it cannot be the consumer's 64 × 256 input, which its meaning would reinterpret.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;
let ML   = [F32, F32];

fun step (acc: ML, xs: [F32])@tt: ML =
    let (m, l) = acc;
    let (x)    = xs;
    let m2     = math.extrema.fmax fast (m, x);
    return (m2, math.arith.add fast (math.arith.mul fast (l, math.exp.exp fast (math.arith.sub fast (m, m2))),
                                     math.exp.exp fast (math.arith.sub fast (x, m2))));

lam merge (a b: ML): ML =
    let (m1, l1) = a;
    let (m2, l2) = b;
    let m        = math.extrema.fmax fast (m1, m2);
    (m, math.arith.add fast (math.arith.mul fast (l1, math.exp.exp fast (math.arith.sub fast (m1, m))),
                            math.arith.mul fast (l2, math.exp.exp fast (math.arith.sub fast (m2, m)))));

fun normalize (_: F32, xv_ml: [F32, ML])@tt: F32 =
    let (xv, ml) = xv_ml;
    let (m, l)   = ml;
    return (math.arith.div fast (math.exp.exp fast (math.arith.sub fast (xv, m)), l));

let levels = serial_group ((4, 0), 1, 3, group_item ((1, 4), 1, item_done ()));

extern fun rows (x: tensor.Tensor 2 (64, 256) F32, y: tensor.Tensor 2 (64, 128) F32): tensor.Tensor 2 (64, 256) F32 =
    let x  = buf x;
    let y  = buf y;
    let ml = map_reduce (64, (64, 128)) (step, (math.neg_inf math.f32, 0.0:F32)) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) y;
    let l  = law.fuse_shared 1 (64, (64, 128)) (step, (math.neg_inf math.f32, 0.0:F32), merge) (proj_map @(2, 1) 0) (proj_map @(2, 2) (0, 1)) y (0)
        @2 @(F32, 2, 2) ((64, 256), (64, 256)) @((F32, ML), (2, 1), ((64, 256), 64)) (normalize, ⊥:F32)
        (affine.id @2) (affine.id @2, proj_map @(2, 1) 0) (x, ml);
    return (law.run (l, levels, default_control));
