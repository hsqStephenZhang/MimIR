// RUN: not %mim -p opt -X tensor:tile-fuse=1 %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: tile_vec_innermost.mim:20:{{.*}}error: a vector level must be the innermost

// A vector level is the innermost one.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let levels = serial_group ((8, 8, 0), 1, 0, group_item ((2, 2, 0), 1, item_red_pipelined ((0, 0, 4), 1, 3, 3, item_vec ((1, 0, 0), item_red ((0, 0, 2), 1, 0, item_done ())))));

extern fun gemm16 (a b: tensor.Tensor 2 (16, 16) F32): tensor.Tensor 2 (16, 16) F32 =
    let root = map_reduce ((16, 16), (16, 16, 16)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
