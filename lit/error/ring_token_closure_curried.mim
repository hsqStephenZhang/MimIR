// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: `sink3 h` holds a ring slot token and may be called more than once

// A curried closure hands its token on through each partial application.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam sink3 (h: gpu.Held (0, 3) (0₃, tt))@ff: Nat → mem.M 0 → mem.M 0 =
    lam mid (_: Nat)@ff: mem.M 0 → mem.M 0 =
        lam give (m: mem.M 0)@ff: mem.M 0 = gpu.retire (m, 0₃, tt, h);
        give;
    mid;

extern lam step (m: mem.M 0, h: gpu.Held (0, 3) (0₃, tt)): mem.M 0 =
    let f = sink3 h 0;
    f (f m);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
