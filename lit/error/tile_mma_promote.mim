// RUN: not %mim -p opt -X tensor:tile-fuse=1 %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: tile_mma_promote.mim:26:{{.*}}error: a tensor-core level reads A and B from promoted panels

// Tensor cores read both operands from shared-memory panels.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_group ((32, 32, 0), 1, 0, group_warp ((16, 16, 0), 1, warp_red ((0, 0, 32), 1, 1, warp_mma (16, 8, 16))));

extern fun gemm32 (a b: tensor.Tensor 2 (32, 64) H): tensor.Tensor 2 (32, 32) F32 =
    let root = map_reduce ((32, 32), (32, 32, 64)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (1, 2)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
