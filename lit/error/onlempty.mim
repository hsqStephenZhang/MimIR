// RUN: (! %mim %s -o - 2>&1) | %FileCheck %s

plugin tensor;
plugin math;

extern fun invalid (q: tensor.Tensor 3 (2, 3, 4) math.F32, k v: tensor.Tensor 3 (2, 0, 4) math.F32): tensor.Tensor 3 (2, 3, 4) math.F32 =
    return (tensor.sdpa_online (math.mode.contract, ff, 2, 3) @(2, 3, 0, 4, 4)
        (0.5:math.F32, q, k, v, tensor.splat ((2, 3, 0), 0:math.F32)));

// CHECK: tensor.sdpa_online requires a nonempty key sequence
