// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: ring slot token {{.*}} is made in {{.*}} but used inside {{.*}}, which may repeat

// A loop body may run more than once, so it cannot give up a slot its loop was handed before it started.

plugin core;
plugin mem;
plugin gpu;
plugin compile;

lam each {depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (R: Bool → *) (sync: gpu.SyncOf depth H V R) (m: mem.M 0, n: Nat): mem.M 0 =
    let (open_ring, _, _, await, release, _, _) = sync;
    let (m, ring) = open_ring m;
    let (m, mine, ring) = await (m, n, ring);
    let s = core.idx 0 depth (core.nat.rem (n, depth));
    lam loop (m: mem.M 0, i: Nat)@ff: mem.M 0 =
        (loop ((release (m, s, tt, mine, tt, ring))#0_2, core.nat.add (i, 1)), m)#(core.ncmp.e (i, n));
    loop (m, 0);

extern lam step (m: mem.M 0, n: Nat): mem.M 0 =
    each (gpu.Held (0, 2)) (gpu.Vacant (0, 2)) (gpu.Ring (0, 2)) (gpu.async_ring @(0, 2) (1, ff)) (m, n);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
