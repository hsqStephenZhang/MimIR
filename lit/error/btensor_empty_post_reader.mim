// RUN: (! %mim %s 2>&1) | %FileCheck %s

plugin core;
plugin tensor;
plugin btensor;
plugin affine;
plugin compile;
use core.ops.u.w;

fun copy (_ x: I32)@tt: I32 = return x;
fun post (x bias: I32)@tt: I32 = return (x + bias);

extern con read_empty (a: tensor.Tensor 1 2 I32, bias: tensor.Tensor 1 0 I32, return: Cn [tensor.Tensor 1 2 I32]) =
    return (tensor.map_reduce_post @(1, 1) (2, 2, tensor.mk_sched (1, 0))
        (copy, 0I32, post) (affine.id @1) (affine.id @1, affine.id @1) (a, bias));

extern lam _compile (): compile.Phase = compile.phases ff (tensor.lower_tensor, tensor.lower_to_mem, btensor.lower_map_reduce);

// CHECK: error: cannot lower map-reduce read from an empty input with a nonempty iteration domain
