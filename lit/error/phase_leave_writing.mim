// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: argument is not assignable to callee's domain

// A construct is not left while its fills are still unpublished.

plugin core;
plugin mem;
plugin buffer;
plugin gpu;
plugin compile;

lam fill (m: mem.M 0, b: buffer.Buf (1, 4, I32)): [mem.M 0, buffer.Buf (1, 4, I32)] = buffer.write (1, 4, I32) (m, b, 0₄, 7I32);

extern lam dangling (m: mem.M 0): mem.M 0 =
    let t = gpu.enter_write (gpu.group_enter @0 m);
    let (t, p) = gpu.shared_panel @(0, 0) @(1, 4, I32) t;
    let (t, _) = gpu.coop_fill (t, p, fill);
    gpu.group_leave t;
