// RUN: not %mim -p opt -X tensor:tile-fuse=1 %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: tile_cluster_groups.mim:27:{{.*}}error: 2 work-groups do not form clusters of 4

// A cluster's size divides the work-groups it groups.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_cluster (4, 1, serial_group ((128, 128, 0), 1, 0,
    group_warpgroup ((64, 128, 0), 1, wg_red_tma ((0, 0, 64), 1, 3, 2, wg_mma (64, 128, 16)))));

extern fun gemm_cluster (a: tensor.Tensor 2 (128, 128) H, b: tensor.Tensor 2 (128, 256) H): tensor.Tensor 2 (128, 256) F32 =
    let root = map_reduce ((128, 256), (128, 256, 128)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
