// RUN: not %mim %s -o - 2>&1 | %FileCheck %s

// A ring's sync gives a step what it holds of the slot it waited for, so the step cannot give up another slot with it.

plugin core;
plugin mem;
plugin gpu;

lam other {depth: Nat} (H: [Idx depth, Bool] → *) (V: Idx depth → *) (R: Bool → *) (sync: gpu.SyncOf depth H V R) (m: mem.M 0, n: Nat): mem.M 0 =
    let (_, _, _, await, release, (_, ring), _) = sync;
    let (m, mine, ring) = await (m, n, ring);
    (release (m, core.idx 0 depth (core.nat.rem (core.nat.add (n, 1), depth)), tt, mine, tt, ring))#0_2;

// CHECK: error: {{.*}}not assignable
