// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: work-group phase token {{.*}} is made in `captured` but consumed inside `later`

// A token must not be consumed inside a continuation, which could run once per call.

plugin core;
plugin mem;
plugin buffer;
plugin gpu;
plugin compile;

lam fill (n: Nat) (m: mem.M 0, b: buffer.Buf (1, n, I32)): [mem.M 0, buffer.Buf (1, n, I32)] = (m, b);

extern con captured (m: mem.M 0, k: Cn mem.M 0) =
    let t = gpu.enter_write (gpu.group_enter @0 m);
    con later (n: Nat) =
        let (t, p) = gpu.shared_panel @(0, 0) @(1, n, I32) t;
        let (t, _) = gpu.coop_fill (t, p, fill n);
        k (gpu.leave_reading (gpu.sync_publish t));
    later 4;

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
