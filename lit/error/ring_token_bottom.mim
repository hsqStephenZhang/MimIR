// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: `⊥:(gpu.Held (0, 3) (s, tt))` stands for a ring slot token that no ring sync made

plugin gpu;
plugin compile;

extern lam step (r: gpu.Panels (0, 3) Nat, s: Idx 3): Nat =
    let (p, _) = gpu.read_slot @(Nat, 0, 3) (r, s, s, ⊥:(gpu.Held (0, 3) (s, tt)));
    p;

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
