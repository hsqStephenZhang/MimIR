// RUN: not %mim %s -o /dev/null 2>&1 | %FileCheck %s
// CHECK: error: work-group construct 0 is entered twice

// Two constructs sharing an index could trade tokens and panels.

plugin core;
plugin mem;
plugin buffer;
plugin gpu;
plugin compile;

lam fill (m: mem.M 0, b: buffer.Buf (1, 4, I32)): [mem.M 0, buffer.Buf (1, 4, I32)] = buffer.write (1, 4, I32) (m, b, 0₄, 7I32);

extern lam shared (m: mem.M 0): mem.M 0 =
    let a = gpu.group_leave (gpu.group_enter @0 m);
    gpu.group_leave (gpu.group_enter @0 a);

extern lam _compile (): compile.Phase = compile.named "gpu.check_sync";
