// RUN: %mim %s -o - | %FileCheck %s

// Every construct with surface syntax must dump as that syntax - not as the `(Node ops…)`
// debug fallback - or `--output-mim` does not round-trip.
plugin core;

extern lam i (t: [I32, I32], v: I32): [I32, I32] = t#0_2 ← v;
extern lam j (a b: *) (x: a): a ∪ b = x inj a ∪ b;
extern lam k (t: «2; «2; I32»», i: Bool, v: I32): «2; «2; I32»» = t#i#1_2 ← v;
extern lam r (): Rule Nat = ⊥:(Rule Nat);
extern lam u (a: *) (x: «a»): «a» = x;
extern lam w (a: *) (x: a): «x» = ‹x›;
extern fun d (s: Nat, x: «core.nat.add (s, 1); Nat»): «core.nat.add (s, 1); Nat» = return x;

// A dependent component spells its type with the pattern's own names.
// CHECK:      extern fun d ((s: Nat, x: «core.nat.add (1, s); Nat») as
// CHECK:      {{.*}}#ff ← {{.*}};
// CHECK:      : {{.*}} ∪ {{.*}} =
// CHECK-NEXT: {{.*}} inj {{.*}} ∪ {{.*}};
// A path insert collapses into one fused Insert: `t#i#1_2 ← v` is `t#(i, 1_2) ← v`.
// CHECK:      {{.*}}#({{.*}}, tt) ← {{.*}};
// CHECK:      extern lam r (): Rule Nat =
// CHECK-NEXT: ⊥:(Rule Nat);
// CHECK:      «{{.*}}»
// CHECK:      ‹{{.*}}›
