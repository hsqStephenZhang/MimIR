// RUN: %mim %s -p ll -X ll:o=%t.ll
// RUN: %FileCheck %s < %t.ll

// `mem.heap2stack_loops` also turns an allocation in a loop into a slot when it dies with its iteration.
// Its `alloca` sits in the entry block, so the iterations reuse it instead of growing the stack.

plugin core;
plugin mem;
plugin compile;
plugin ll;

extern lam _compile (): compile.Phase =
    compile.phases ff (
        mem.heap2stack_loops,
        mem.alloc2malloc_repl,
        compile.named "ll.emit",
    );

let P = mem.Ptr (I32, 0);

// Handed on to the next iteration, the pointer outlives the iteration that allocates it.
// CHECK-LABEL: define i32 @carried(
// CHECK: call {{.*}} @malloc(
// CHECK: }
extern con carried (m: mem.M 0, n: I32, return: Cn [mem.M 0, I32]) =
    con head (m: mem.M 0, i: I32, q: P) =
        con body (m: mem.M 0) =
            let (m, p) = mem.alloc (I32, 0) m;
            let (m, x) = mem.load (m, q);
            let m      = mem.store (m, p, core.wrap.add 0 (x, i));
            head (m, core.wrap.add 0 (i, 1I32), p);
        con exit (m: mem.M 0) = return (mem.load (m, q));
        (exit, body)#(core.icmp.ul (i, n)) m;
    head (m, 0I32, ⊥:P);

// CHECK-LABEL: define i32 @sum(
// CHECK-NEXT: {{.*}}:
// CHECK-NEXT: alloca i32, align 16
// CHECK-NOT: alloca
// CHECK-NOT: @malloc(
// CHECK: }
extern con sum (m: mem.M 0, n: I32, return: Cn [mem.M 0, I32]) =
    con head (m: mem.M 0, i: I32, s: I32) =
        con body (m: mem.M 0) =
            let (m, p) = mem.alloc (I32, 0) m;
            let m      = mem.store (m, p, i);
            let (m, x) = mem.load (m, p);
            head (m, core.wrap.add 0 (i, 1I32), core.wrap.add 0 (s, x));
        con exit (m: mem.M 0) = return (m, s);
        (exit, body)#(core.icmp.ul (i, n)) m;
    head (m, 0I32, 0I32);
