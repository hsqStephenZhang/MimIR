// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=mem.fresh

plugin compile;
plugin core;
plugin mem;

extern con first (m: mem.M 0, return: Cn [mem.M 0, mem.Ptr (I64, 0)]) =
    mem.fresh (0, receive)
    where
        con receive (fresh: mem.M 0) =
            let (m, p) = mem.alloc (I64, 0) ⊥:(mem.M 0);
            return (m, p);
    end;
extern con second (m: mem.M 0, return: Cn [mem.M 0, mem.Ptr (I64, 0)]) =
    mem.fresh (0, receive)
    where
        con receive (fresh: mem.M 0) =
            let (m, p) = mem.alloc (I64, 0) ⊥:(mem.M 0);
            return (m, p);
    end;

extern lam _compile (): compile.Phase = mem.resolve_fresh;

// CHECK-LABEL: extern fun first
// CHECK: con receive ([[FIRST:_[0-9]+]]: core.M 0)
// CHECK: mem.alloc (I64, 0) [[FIRST]]
// CHECK-LABEL: extern fun second
// CHECK: con receive_1 ([[SECOND:_[0-9]+]]: core.M 0)
// CHECK: mem.alloc (I64, 0) [[SECOND]]
