// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: %FileCheck %s --input-file=%{s:stem}.ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 7

// Returning only an alias alongside a memory token must not erase the store
// that produced the token. Currently the store of 7 is eliminated, so the
// generated program incorrectly returns the previous value, 3.

plugin core;
plugin mem;

lam store_and_return_alias(
    mem: %mem.M 0,
    ptr: %mem.Ptr (I32, 0)): %mem.Ptr (I32, 0) =
    ((%mem.store (mem, ptr, 7I32), ptr)#tt);

con extern main(
    mem: %mem.M 0,
    argc: I32,
    argv: %mem.Ptr (%mem.Ptr (I8, 0), 0),
    return: Cn [%mem.M 0, I32]) =
    let (mem, ptr) = %mem.alloc (I32, 0) mem;
    let mem = %mem.store (mem, ptr, 3I32);
    let alias = store_and_return_alias (mem, ptr);
    let (mem, value) = %mem.load (mem, alias);
    return (mem, value);

// CHECK: store i32 3
// CHECK: store i32 7
