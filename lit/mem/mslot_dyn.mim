// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -p ll -o -
// RUN: %FileCheck %s < %{s:stem}.ll
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t; test $? -eq 1
// RUN: %t 1 2 3; test $? -eq 7

plugin core;
plugin mem;

// CHECK-LABEL: define{{.*}}@main
// CHECK: [[RAW:%[^ ]+]] = alloca i8, i64 %{{.*}}, align 4
// CHECK: bitcast i8* [[RAW]] to [0 x i32]*
extern con main(m: mem.M 0, argc: I32, argv: mem.Ptr («⊤:Nat; mem.Ptr («⊤:Nat; I8», 0)», 0), return: Cn [mem.M 0, I32]) =
    let n           = core.bitcast Nat argc;
    ret (m, p)      = mem.slot («n; I32», 0) $ m;
    let q           = core.bitcast (mem.Ptr0 «⊤:Nat; I32») p;
    let last        = core.bitcast I64 (core.nat.sub (n, 1));
    let m           = mem.store (m, mem.lea (q, 0I64), 7I32);
    let m           = mem.store (m, mem.lea (q, last), argc);
    let ld          = mem.load (m, mem.lea (q, 0I64));
    return ld;
