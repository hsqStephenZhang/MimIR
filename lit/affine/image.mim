// RUN: %mim %s -o - | %FileCheck %s

// Region inference: `affine.image` bounds the box each access map reads from a box of its domain.
// Each `image` and `cover` returns (lo, ext, cap, exact) per result coordinate, each `preimage` (lo, ext, cap) per
// domain dim and whether that box is exact.

plugin core;
plugin affine;
plugin compile;

let B2 = [«2; Nat», «2; Nat», «2; Nat», «2; Bool»];
let P3 = [«3; Nat», «3; Nat», «3; Nat», Bool];

lam proj  (i _ k: affine.Index): «2; affine.Index» = (i, k);
lam tr    (i j: affine.Index): «2; affine.Index» = (j, i);
lam shift (i j: affine.Index): «2; affine.Index» = (affine.op.add (i, affine.lit 1), affine.op.sub (j, affine.lit 1));
lam win   (oh kh: affine.Index): «2; affine.Index» =
    (affine.op.add (oh, kh), affine.op.add (affine.semiop.mul (oh, 2), kh));
lam bcast (i j: affine.Index): «2; affine.Index» = (i, affine.semiop.mul (j, 0));
lam fdiv  (i: affine.Index): «2; affine.Index» = (affine.semiop.floordiv (i, 4), affine.semiop.ceildiv (i, 4));
lam rem8  (i j: affine.Index): «2; affine.Index» = (affine.semiop.rem (i, 8), affine.semiop.rem (j, 8));
lam twice (i j: affine.Index): «2; affine.Index» = (affine.op.add (i, i), affine.op.add (i, j));
lam neg   (i j: affine.Index): «2; affine.Index» = (affine.op.neg i, j);
lam resh  (o: «2; affine.Index»): «2; affine.Index» = affine.delinearize (affine.linearize (o, (4, 6)), (3, 8));

// (i, k) of the box i ∈ [2, 4), j ∈ [4, 8), k ∈ [0, 4): exact.
extern fun c_proj (): B2 = return (affine.image proj ((2, 4, 0), (2, 4, 4), (6, 4)));

// The transpose of i ∈ [1, 3), j ∈ [0, 5).
extern fun c_tr (): B2 = return (affine.image tr ((1, 0), (2, 5), (8, 6)));

// i + 1 and j − 1 of i ∈ [0, 2), j ∈ [1, 4).
extern fun c_shift (): B2 = return (affine.image shift ((0, 1), (2, 3), (8, 8)));

// A window: oh + kh is exact; 2·oh + kh is bounded but strided, so not exact.
extern fun c_win (): B2 = return (affine.image win ((1, 0), (3, 3), (16, 16)));

// A broadcast reads index 0 only.
extern fun c_bcast (): B2 = return (affine.image bcast ((2, 1), (3, 4), (8, 1)));

// i ∈ [5, 12): floordiv 4 ∈ [1, 2], ceildiv 4 ∈ [2, 3].
extern fun c_div (): B2 = return (affine.image fdiv (5, 7, (8, 8)));

// rem 8 of i ∈ [9, 13) stays in one block; of j ∈ [6, 11) it wraps, so it is all of [0, 8).
extern fun c_rem (): B2 = return (affine.image rem8 ((9, 6), (4, 5), (8, 8)));

// i + i skips the odd values; i + j of independent ranges does not.
extern fun c_twice (): B2 = return (affine.image twice ((1, 1), (3, 3), (16, 16)));

// A coordinate it cannot bound is the whole shape.
extern fun c_neg (): B2 = return (affine.image neg ((1, 1), (2, 2), (7, 8)));

// Clamped to the shape: i + 1 of i ∈ [4, 6) in a dim of 6 reaches only 5.
extern fun c_clamp (): B2 = return (affine.image shift ((4, 1), (2, 3), (6, 8)));

// Row 1 of a «4, 6» reshaped to «3, 8»: flat [6, 12) is row 0 or 1, and columns that wrap.
extern fun c_resh (): B2 = return (affine.image resh ((1, 0), (1, 6), (3, 8)));

// A run-time origin yields bounds in terms of it, and still a literal cap.
extern fun c_sym (i0: Nat): B2 = return (affine.image tr ((0, i0), (2, 3), (8, 6)));

// An unknown map stays an `affine.image`.
extern fun c_open (f: «2; affine.Index» → «2; affine.Index»): B2 = return (affine.image f ((0, 0), (2, 2), (8, 8)));

lam left  (i: affine.Index): affine.Index = affine.op.sub (i, affine.lit 1);
lam right (i: affine.Index): affine.Index = affine.op.add (i, affine.lit 1);
lam far   (i: affine.Index): affine.Index = affine.op.add (i, affine.lit 5);
lam twox  (i: affine.Index): affine.Index = affine.semiop.mul (i, 2);
let C1 = [Nat, Nat, Nat, Bool];

// The stencil reads a[i − 1] and a[i + 1] of i ∈ [i0, i0 + 4): one box of 6 at any origin.
extern fun c_stencil (i0: Nat): C1 = return (affine.cover (left, right) (i0, 4, 64));

// Reads 6 apart leave a gap: the hull is a literal 10 but not exact.
extern fun c_gap (i0: Nat): C1 = return (affine.cover (left, far) (i0, 4, 64));

// Maps that differ by more than an offset have only the shape as a static bound.
extern fun c_mixed (i0: Nat): C1 = return (affine.cover (right, twox) (i0, 4, 64));

lam wr (i j _: affine.Index): «2; affine.Index» = (i, j);
lam wt (i j _: affine.Index): «2; affine.Index» = (j, i);
lam ws (i j _: affine.Index): «2; affine.Index» = (affine.op.add (i, affine.lit 2), affine.op.sub (j, affine.lit 1));
lam wd (i j _: affine.Index): «2; affine.Index» = (i, affine.semiop.floordiv (j, 2));

// The points of an (i, j | k) nest writing the box (2..4, 4..8): the reduction dim k stays whole.
extern fun p_proj (): P3 = return (affine.preimage wr ((2, 4), (2, 4), (6, 8, 5)));

// Through a transposing write map.
extern fun p_tr (): P3 = return (affine.preimage wt ((4, 2), (4, 2), (6, 8, 5)));

// A tile's shifted write map at a run-time origin.
extern fun p_shift (a0: Nat): P3 = return (affine.preimage ws ((a0, 3), (2, 4), (6, 8, 5)));

// A coordinate that is not a shifted dim does not restrict anything and is not exact.
extern fun p_div (): P3 = return (affine.preimage wd ((1, 1), (2, 2), (6, 8, 5)));

// A chain, as for softmax: the «2, 16» tile of y at row i0 reads e at (i, j), e writes through (i, j), so its
// points are that box, and they read mx at i: the caps stay literal along the chain.
lam rd_e  (i j: affine.Index): «2; affine.Index» = (i, j);
lam rd_mx (i _: affine.Index): affine.Index = i;
extern fun chain (i0: Nat): Nat =
    let (lo, _, cap, _)   = affine.image rd_e ((i0, 0), (2, 16), (8, 16));
    let (plo, _, pcap, _) = affine.preimage rd_e (lo, cap, (8, 16));
    let (_, _, mcap, _)   = affine.image rd_mx (plo, pcap, 8);
    return mcap;

extern lam _compile (): compile.Phase = compile.phases ff (compile.cleanup,);

// CHECK-LABEL: extern fun c_bcast
// CHECK-NEXT:  return ((2, 0), (3, 1), (3, 1), ‹2; tt›);
// CHECK-LABEL: extern fun c_clamp
// CHECK-NEXT:  return ((5, 0), (1, 3), (2, 3), ‹2; tt›);
// CHECK-LABEL: extern fun c_div
// CHECK-NEXT:  return ((1, 2), ‹2; 2›, ‹2; 3›, ‹2; tt›);
// CHECK-LABEL: extern fun c_gap
// CHECK:       return ({{.*}}, {{.*}}, 10, ff);
// CHECK-LABEL: extern fun c_mixed
// CHECK:       return ({{.*}}, {{.*}}, 64, ff);
// CHECK-LABEL: extern fun c_neg
// CHECK-NEXT:  return ((0, 1), (7, 2), (7, 2), (ff, tt));
// CHECK-LABEL: extern fun c_open
// CHECK-NEXT:  affine.image
// CHECK-LABEL: extern fun c_proj
// CHECK-NEXT:  return ((2, 0), (2, 4), (2, 4), ‹2; tt›);
// CHECK-LABEL: extern fun c_rem
// CHECK-NEXT:  return ((1, 0), (4, 8), ‹2; 8›, (tt, ff));
// CHECK-LABEL: extern fun c_resh
// CHECK-NEXT:  return (‹2; 0›, (2, 8), (3, 8), (tt, ff));
// CHECK-LABEL: extern fun c_shift
// CHECK-NEXT:  return ((1, 0), (2, 3), (2, 3), ‹2; tt›);
// CHECK-LABEL: extern fun c_stencil
// CHECK:       return ({{.*}}, {{.*}}, 6, tt);
// CHECK-LABEL: extern fun c_sym
// CHECK:       return ((i0{{.*}}, 0), ({{.*}}, 2), (3, 2), ‹2; tt›);
// CHECK-LABEL: extern fun c_tr
// CHECK-NEXT:  return ((0, 1), (5, 2), (5, 2), ‹2; tt›);
// CHECK-LABEL: extern fun c_twice
// CHECK-NEXT:  return (‹2; 2›, ‹2; 5›, ‹2; 5›, (ff, tt));
// CHECK-LABEL: extern fun c_win
// CHECK-NEXT:  return ((1, 2), (5, 7), (5, 7), (tt, ff));
// CHECK-LABEL: extern fun chain
// CHECK-NEXT:  return 2;
// CHECK-LABEL: extern fun p_div
// CHECK-NEXT:  return ((1, 0, 0), (2, 8, 5), (2, 8, 5), ff);
// CHECK-LABEL: extern fun p_proj
// CHECK-NEXT:  return ((2, 4, 0), (2, 4, 5), (2, 4, 5), tt);
// CHECK-LABEL: extern fun p_shift
// CHECK:       return (({{.*}}, 4, 0), ({{.*}}, 4, 5), (2, 4, 5), tt);
// CHECK-LABEL: extern fun p_tr
// CHECK-NEXT:  return ((2, 4, 0), (2, 4, 5), (2, 4, 5), tt);
