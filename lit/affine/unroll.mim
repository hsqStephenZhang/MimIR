// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll -o - | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ; test $? -eq 6

plugin core;
plugin affine;

con extern main [mem : %mem.M 0, argc : I32, argv : %mem.Ptr (%mem.Ptr (I32, 0), 0), return : Cn [%mem.M 0, I32]] =
    %affine.unroll unroll_body unroll_exit (0I32, 4I32, 1I32, 0I32)
    where
        con unroll_body [i : I32, acc : I32, continue : Cn [I32]] =
            let a : I32 = %core.wrap.add 0 (i, acc);
            continue (a);
        con unroll_exit [acc : I32] = return (mem, acc);
    end;

// CHECK-NOT: affine.unroll
// CHECK-NOT: affine.For
