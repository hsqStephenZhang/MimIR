// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p ll
// RUN: clang++ -std=c++23 %S/image_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t

// Soundness of region inference at run-time origins, checked by image_aux.cpp against brute force:
// * `image` and `cover`: every value the maps take over the box lies within the inferred box, an exact
//   coordinate takes all of them, and the box fits its cap and the shape.
// * `preimage`: every domain point that the write map sends into the box lies within the inferred box, and
//   an exact box holds no other point, and the box fits its cap.
// The origins are run-time `Nat`s, so the bounds stay symbolic until the program runs.
plugin core;
plugin mem;
plugin affine;

lam win  (oh kh: affine.Index): «2; affine.Index» = (affine.op.add (oh, kh), affine.op.add (affine.semiop.mul (oh, 2), kh));
lam resh (o: «2; affine.Index»): «2; affine.Index» = affine.delinearize (affine.linearize (o, (4, 6)), (3, 8));
lam rdiv (i j: affine.Index): «2; affine.Index» = (affine.semiop.rem (i, 8), affine.semiop.floordiv (j, 3));
lam trs  (i j: affine.Index): «2; affine.Index» = (affine.op.add (j, affine.lit 2), affine.op.sub (i, affine.lit 1));
lam st0  (i j: affine.Index): «2; affine.Index» = (affine.op.sub (i, affine.lit 1), j);
lam st1  (i j: affine.Index): «2; affine.Index» = (affine.op.add (i, affine.lit 1), affine.op.add (j, affine.lit 2));
lam al   (i j: affine.Index): «2; affine.Index» =
    (affine.semiop.floordiv (affine.op.add (affine.semiop.mul (i, 8), j), 12),
     affine.semiop.ceildiv (affine.op.add (affine.semiop.mul (i, 6), j), 9));
lam bk   (i j: affine.Index): «2; affine.Index» =
    (affine.op.add (affine.op.sub (i, affine.lit 3), affine.lit 3), affine.op.add (affine.op.sub (j, affine.lit 2), affine.lit 1));
lam ws   (i j _: affine.Index): «2; affine.Index» = (affine.op.add (i, affine.lit 2), affine.op.sub (j, affine.lit 1));

lam n (x: Nat): I64 = core.bitcast I64 x;
lam b (x: Bool): I64 = (0I64, 1I64)#x;

lam put (m: mem.M 0, out: mem.Ptr0 «8; I64», (lo ext cap: «2; Nat», ex: «2; Bool»)): mem.M 0 =
    mem.store (m, out, (n lo#0_2, n lo#1_2, n ext#0_2, n ext#1_2, n cap#0_2, n cap#1_2, b ex#0_2, b ex#1_2));

extern fun img_win (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 a1: Nat): mem.M 0 =
    return (put (m, out, affine.image win ((a0, a1), (3, 3), (64, 64))));

extern fun img_resh (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 a1: Nat): mem.M 0 =
    return (put (m, out, affine.image resh ((a0, a1), (1, 4), (3, 8))));

extern fun img_rdiv (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 a1: Nat): mem.M 0 =
    return (put (m, out, affine.image rdiv ((a0, a1), (5, 4), (8, 64))));

extern fun img_trs (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 a1: Nat): mem.M 0 =
    return (put (m, out, affine.image trs ((a0, a1), (2, 3), (16, 16))));

extern fun img_st (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 a1: Nat): mem.M 0 =
    return (put (m, out, affine.cover (st0, st1) ((a0, a1), (3, 4), (32, 32))));

extern fun img_bk (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 a1: Nat): mem.M 0 =
    return (put (m, out, affine.image bk ((a0, a1), (2, 3), (16, 16))));

// The box starts at column 0, so the caps use the residues a run-time row admits.
extern fun img_al (m: mem.M 0, out: mem.Ptr0 «8; I64», a0 _: Nat): mem.M 0 =
    return (put (m, out, affine.image al ((a0, 0), (1, 8), (64, 64))));

extern fun pre_ws (m: mem.M 0, out: mem.Ptr0 «10; I64», y0 y1: Nat): mem.M 0 =
    let (lo, ext, cap, ex) = affine.preimage ws ((y0, y1), (2, 4), (6, 8, 5));
    return (mem.store (m, out, (n lo#0_3, n lo#1_3, n lo#2_3, n ext#0_3, n ext#1_3, n ext#2_3,
                                n cap#0_3, n cap#1_3, n cap#2_3, b ex)));
