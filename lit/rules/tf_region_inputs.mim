// RUN: python3 %S/tf_run.py %mim %s %t rule tt > %t.rule 2> %t.rule.log
// RUN: %FileCheck %s < %t.rule
// RUN: python3 %S/tf_run.py %mim %s %t graph tt > %t.graph 2> %t.graph.log
// RUN: %FileCheck %s < %t.graph
// RUN: python3 %S/tf_run.py %mim %s %t rule tt lower > %t.rule.out 2> %t.rule.exec.log
// RUN: clang++ -O3 -fsanitize=address %S/tf_region_inputs_aux.cpp %t.rule.ll -o %t.rule.exec -Wno-override-module
// RUN: %t.rule.exec
// RUN: python3 %S/tf_run.py %mim %s %t graph tt lower > %t.graph.out 2> %t.graph.exec.log
// RUN: clang++ -O3 -fsanitize=address %S/tf_region_inputs_aux.cpp %t.graph.ll -o %t.graph.exec -Wno-override-module
// RUN: %t.graph.exec
// TF-RULES: (tensor.fuse_producer (I64, 1))
// TF-REGION-FUSION: 0, 1
// TF-PURE: tensor.tile_of, tensor.slice, tensor.map_reduce_post

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;

fun twice (_ x: I64)@tt: I64 = return (core.wrap.mul 0 (x, 2I64));
fun add (_: I64, (a b: I64))@tt: I64 = return (core.wrap.add 0 (a, b));
lam producer (a: tensor.Tensor 1 8 I64): tensor.Tensor 1 8 I64 =
    map_reduce (8, 8) (twice, 0I64) (affine.id @1) (affine.id @1,) (buf a);
lam plus (a b: tensor.Tensor 1 4 I64): tensor.Tensor 1 4 I64 =
    map_reduce @2 (4, 4) (add, 0I64) (affine.id @1) (affine.id @1, affine.id @1) (a, b);

extern fun fold_inputs (a: tensor.Tensor 1 8 I64): tensor.Tensor 1 4 I64 =
    let p = producer a;
    return (tile_fold (2, 4) (splat (4, 0I64)) p
        (λ (acc: tensor.Tensor 1 4 I64, off: Nat) (p): tensor.Tensor 1 4 I64 =
            plus (acc, slice @(I64, 1) 8 (off, 1, 4) p)));

extern fun multi_inputs (a: tensor.Tensor 1 8 I64, b: tensor.Tensor 1 4 I64): tensor.Tensor 1 8 I64 =
    let p = producer a;
    lam boxes (point: Nat): TileBox 1 = (core.nat.mul (point, 4), 4);
    return (tiled_n @(1, 1, I64, 1) (8, 2) boxes
        (buf b, (1, p))
        (λ (point: Nat) (b: tensor.Tensor 1 4 I64, (_: Nat, p: tensor.Tensor 1 8 I64)): tensor.Tensor 1 4 I64 =
            plus (slice @(I64, 1) 8 (core.nat.mul (point, 4), 1, 4) p, b)));

extern fun retained_init (a: tensor.Tensor 1 8 I64): tensor.Tensor 1 8 I64 =
    let p = producer a;
    return (tile_fold (2, 1) p p
        (λ (acc: tensor.Tensor 1 8 I64, _: Nat) (p): tensor.Tensor 1 8 I64 =
            map_reduce @2 (8, 8) (add, 0I64) (affine.id @1)
                (affine.id @1, affine.id @1) (acc, slice @(I64, 1) 8 (0, 1, 8) p)));

extern fun shared_tiles (a: tensor.Tensor 1 8 I64): tensor.Tensor 1 8 I64 =
    let p = producer a;
    let left = tiled (4, 2) p
        (λ (off ext: Nat) (p): tensor.Tensor 1 ext I64 = slice @(I64, 1) 8 (off, 1, ext) p);
    let right = tiled (4, 2) p
        (λ (off ext: Nat) (p): tensor.Tensor 1 ext I64 =
            slice @(I64, 1) 8 (core.nat.add (off, 4), 1, ext) p);
    return (concat @(I64, 2, 1) 0_1 (left, right));

// CHECK-NOT: tensor.map_reduce_post {{.*}} (8, 8,
// CHECK: tensor.map_reduce_post {{.*}} btensor.clip_sched
// CHECK-LABEL: extern fun fold_inputs
// CHECK-NOT: tensor.map_reduce_post {{.*}} (8, 8,
// CHECK: tensor.tile_fold
// CHECK-NOT: tensor.map_reduce_post {{.*}} (8, 8,
// CHECK: tensor.map_reduce_post
// CHECK-LABEL: extern fun multi_inputs
// CHECK-NOT: tensor.map_reduce_post {{.*}} (8, 8,
// CHECK: tensor.tiled_n
// CHECK-LABEL: extern fun retained_init
// CHECK: tensor.map_reduce_post {{.*}} (8, 8,
// CHECK: tensor.tile_fold
// CHECK-LABEL: extern fun shared_tiles
// CHECK-NOT: tensor.map_reduce_post {{.*}} (8, 8,
// CHECK: tensor.tiled
// CHECK: tensor.tiled
// CHECK-NOT: tensor.map_reduce_post {{.*}} (8, 8,
