// RUN: python3 %S/tf_run.py %mim %s %t graph > %t.graph 2> %t.graph.log
// RUN: cat %t.graph | %FileCheck %s --check-prefix=GAP
// RUN: grep 'guard is not true' %t.graph.log
// TF-RULES: exclusive
// TF-PURE: producer, consumer, fused

plugin compile;
// only_used_by asks whether all data uses of p are the captured consumer c in this snapshot.
axm only_used_by: [Nat, Nat] → Bool;
axm producer: Nat → Nat;
axm consumer: Nat → Nat;
axm fused: Nat → Nat;

rule exclusive (x: Nat): consumer (producer x)
    when only_used_by (producer x, consumer (producer x)) => fused x;
extern lam single (x: Nat): Nat = consumer (producer x);
extern lam shared (x: Nat): [Nat, Nat] = (consumer (producer x), producer x);

// FACT-LABEL: extern lam shared
// FACT: producer x
// FACT-LABEL: extern lam single
// FACT: fused

// Flip GAP to the target CHECKs when the missing extension lands.
// GAP-LABEL: extern lam shared
// GAP: consumer (producer
// GAP-LABEL: extern lam single
// GAP: consumer (producer
// GAP-NOT: fused
