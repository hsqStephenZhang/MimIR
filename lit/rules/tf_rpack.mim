// RUN: python3 %S/tf_run.py %mim %s %t rule > %t.rule 2> %t.rule.log
// RUN: cat %t.rule | %FileCheck %s --check-prefix=PACK
// TF-RULES: prepack
// TF-PURE: frozen, stage_persistent

plugin compile;
plugin tensor;
// The resource contract remains modeled; the downstream slice is the actual tensor op.
axm frozen: (tensor.Tensor 1 8 Nat) → tensor.Tensor 1 8 Nat;
axm stage_persistent: (tensor.Tensor 1 8 Nat) → tensor.Tensor 1 8 Nat;
rule prepack (b: tensor.Tensor 1 8 Nat): frozen b => stage_persistent b;
extern lam result (b: tensor.Tensor 1 8 Nat, salt: Nat): [tensor.Tensor 1 2 Nat, tensor.Tensor 1 2 Nat] =
    let packed = frozen b;
    (tensor.slice @(Nat, 1) 8 (0, 1, 2) packed, tensor.slice @(Nat, 1) 8 (2, 1, 2) packed);

// PACK-LABEL: extern lam result
// PACK: tensor.slice @ (Nat, 1) 8 (0, 1, 2) (stage_persistent b)
// PACK: tensor.slice @ (Nat, 1) 8 (2, 1, 2) (stage_persistent b)
// PACK-NOT: frozen
