// RUN: %mim %s -o - | %FileCheck %s
// XFAIL: *
// Even a singleton polymorphic axiom fails the current pure_ops type contract.

plugin compile;
plugin tensor;
axm q: Nat → Nat;
rule identity (x: Nat): q x => q x;
extern lam result (x: Nat): Nat = q x;
extern lam _compile (): compile.Phase =
    compile.graph_rule_app (identity, tensor.slice);

// CHECK-LABEL: extern lam result
// CHECK: q
