// RUN: python3 %S/tf_run.py %mim %s %t rule > %t.out 2> %t.log
// RUN: cat %t.out | %FileCheck %s --check-prefix=SINGLE
// RUN: cat %t.out | %FileCheck %s --check-prefix=SHARED
// RUN: cat %t.out | %FileCheck %s --check-prefix=UNKNOWN
// RUN: cat %t.out | %FileCheck %s --check-prefix=USED
// RUN: cat %t.out | %FileCheck %s --check-prefix=SOURCE
// RUN: grep "guard is not true" %t.log
// TF-RULES: (indirect, exclusive, read)
// TF-PURE: producer, consumer, other, fused
// TF-SCHEMAS: schemas

plugin compile;
// Only these declarations describe data uses; purity declarations do not imply a schema.
axm producer: Nat → Nat;
axm consumer: Nat → Nat;
axm other: Nat → Nat;
axm opaque: Nat → Nat;
axm fused: Nat → Nat;
axm wrong: Nat → Nat;
let schemas = (compile.data_op @((Nat → Nat), 1) (consumer, 1, (0, 0)),
               compile.data_op @((Nat → Nat), 1) (other, 1, (0, 0)));
rule indirect (x: Nat): consumer (producer x)
    when compile.used_by (x, consumer (producer x)) => wrong x;
rule exclusive (x: Nat): consumer (producer x)
    when compile.only_used_by (producer x, consumer (producer x)) => fused x;
rule read (x: Nat): other (producer x)
    when compile.used_by (producer x, other (producer x)) => fused x;
extern lam single (x: Nat): Nat = consumer (producer x);
extern lam shared (x: Nat): [Nat, Nat] = (consumer (producer x), producer x);
extern lam unknown (x: Nat): [Nat, Nat] = (consumer (producer x), opaque (producer x));
extern lam used_result (x: Nat): [Nat, Nat] = (other (producer x), producer x);

extern lam first (): Nat = other (producer 0);
extern lam second (): Nat = consumer (producer 0);

// SINGLE-LABEL: extern lam single
// SINGLE: fused
// SINGLE-NOT: consumer
// SINGLE-LABEL: extern lam unknown
// SHARED-LABEL: extern lam shared
// SHARED: consumer (producer
// SHARED-NOT: fused
// SHARED-LABEL: extern lam single
// UNKNOWN-LABEL: extern lam unknown
// UNKNOWN: consumer (producer
// UNKNOWN: opaque (producer
// UNKNOWN-NOT: fused
// UNKNOWN-LABEL: extern lam used_result
// USED-LABEL: extern lam used_result
// USED: fused
// USED: producer
// SOURCE-LABEL: extern lam first
// SOURCE: fused 0
// SOURCE-LABEL: extern lam second
// SOURCE: consumer (producer 0)
