// RUN: python3 %S/tf_run.py %mim %s %t graph > %t.out 2> %t.log
// RUN: cat %t.out | %FileCheck %s
// RUN: grep "guard is not true" %t.log
// TF-RULES: (exclusive, local)
// TF-PURE: q, v, wrong
// TF-SCHEMAS: schema

plugin compile;
axm q: [Nat, Nat] → Nat;
axm v: [Nat, Nat] → Nat;
axm wrong: [Nat, Nat] → Nat;
let schema = compile.data_op @(([Nat, Nat] → Nat), 1) (q, 1, (0, 1));
axm left: (Nat → Nat) → Nat;
axm right: (Nat → Nat) → Nat;
axm outer: (Nat → Nat) → Nat;
rule exclusive (x o: Nat, unused: Nat): q (x, o)
    when compile.only_used_by (x, q (x, o)) => wrong (x, o);
rule local (x o: Nat, unused: Nat): q (x, o) => v (x, o);
extern lam result (x salt: Nat): [Nat, Nat] =
    let body = λ (o: Nat): Nat = q (x, o);
    (left body, right body);
extern lam double (x salt: Nat): Nat =
    outer (λ (o: Nat): Nat = left (λ (k: Nat): Nat = q (x, o)));

// CHECK-LABEL: extern lam double
// CHECK: lam {{.*}} ([[OFF:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat)
// CHECK: v ({{.*}}, [[OFF]])
// CHECK-NOT: wrong
// CHECK-LABEL: extern lam result
// CHECK: lam [[NEW:[a-zA-Z_][a-zA-Z_0-9]*]] ([[O:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat)
// CHECK: v ({{.*}}, [[O]])
// CHECK: lam [[OLD:[a-zA-Z_][a-zA-Z_0-9]*]] ([[P:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat)
// CHECK: q ({{.*}}, [[P]])
// CHECK: (left [[NEW]], right [[OLD]])
