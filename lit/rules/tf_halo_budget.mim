// RUN: python3 %S/tf_run.py %mim %s %t rule tt > %t.rule 2> %t.rule.log
// RUN: %FileCheck %s < %t.rule
// RUN: python3 %S/tf_run.py %mim %s %t graph tt > %t.graph 2> %t.graph.log
// RUN: %FileCheck %s < %t.graph
// TF-RULES: (tensor.fuse_halo (I64, 1, 2))
// TF-PURE: tensor.tile_of_box, tensor.slice_box, tensor.map_reduce_post, btensor.clip_sched, affine.op.add, affine.op.sub, affine.lit

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;

fun scale (_ x: I64)@tt: I64 = return (core.wrap.mul 0 (x, 2I64));
fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));
lam producer (a: «7; I64»): «7; I64» =
    map_reduce (7, 7) (scale, 0I64) (affine.id @1) (affine.id @1,) (buf a);
lam window (p: «7; I64»): «5; I64» =
    map_reduce (5, (5, 3)) (add, 0I64) (proj_map @(2, 1) 0)
        ((λ (i k: affine.Index): affine.Index = affine.op.add (i, k)),) p;
lam tiled_window (p: «7; I64», ts: Nat): «5; I64» =
    tiled @(I64, 1) (5, ts)
        (λ (off ext: «1; Nat»): «ext; I64» = tile_of_box (window p, off, ext, ext));

extern fun accepted (a: «7; I64»): «5; I64» = return (tiled_window (producer a, 2));
extern fun overlap_exceeds_budget (a: «7; I64»): «5; I64» = return (tiled_window (producer a, 1));
extern fun shared_whole (a: «7; I64»): [«5; I64», «7; I64»] =
    let p = producer a;
    return (tiled_window (p, 2), p);
extern fun unknown_count (a: «7; I64», count: Nat): «5; I64» =
    let p = producer a;
    return (tile_fold (count, 1) (splat (5, 0I64))
        (λ (_: «5; I64», _: Nat): «5; I64» = tiled_window (p, 2)));

// CHECK-LABEL: extern fun accepted
// CHECK-NOT: tensor.map_reduce_post {{.*}} (7,
// CHECK: btensor.clip_sched
// CHECK-NOT: tensor.map_reduce_post {{.*}} (7,
// CHECK: tensor.tiled
// CHECK-LABEL: extern fun overlap_exceeds_budget
// CHECK: tensor.map_reduce_post {{.*}} (7,
// CHECK: tensor.slice_box
// CHECK-LABEL: extern fun shared_whole
// CHECK: tensor.map_reduce_post {{.*}} (7,
// CHECK: tensor.slice_box
// CHECK-LABEL: extern fun unknown_count
// CHECK: tensor.map_reduce_post {{.*}} (7,
// CHECK: tensor.slice_box
