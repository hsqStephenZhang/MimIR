// RUN: python3 %S/tf_run.py %mim %s %t graph > %t.out 2> %t.log
// RUN: cat %t.out | %FileCheck %s --check-prefix=MAP
// RUN: cat %t.out | %FileCheck %s --check-prefix=NEG
// RUN: cat %t.out | %FileCheck %s --check-prefix=NEST
// TF-RULES: local
// TF-PURE: tensor.slice, tensor.unary

plugin compile;
plugin tensor;
// tiled calls its body at the starts of the two length-2 output tiles.
axm tiled: (Nat → tensor.Tensor 1 2 Nat) → tensor.Tensor 1 4 Nat;

rule local (f: Nat → Nat, x: tensor.Tensor 1 8 Nat, o: Nat):
    tensor.slice @(Nat, 1) 8 (o, 1, 2) (tensor.unary @(Nat, Nat) f @(1, 8) x) =>
    tensor.unary @(Nat, Nat) f @(1, 2) (tensor.slice @(Nat, 1) 8 (o, 1, 2) x);
extern lam result (f: Nat → Nat, x: tensor.Tensor 1 8 Nat, o salt: Nat): tensor.Tensor 1 2 Nat =
    tensor.slice @(Nat, 1) 8 (o, 1, 2) (tensor.unary @(Nat, Nat) f @(1, 8) x);
extern lam shared (f: Nat → Nat, x: tensor.Tensor 1 8 Nat, o salt: Nat): [tensor.Tensor 1 2 Nat, tensor.Tensor 1 8 Nat] =
    let p = tensor.unary @(Nat, Nat) f @(1, 8) x;
    (tensor.slice @(Nat, 1) 8 (o, 1, 2) p, p);

extern lam nested (f: Nat → Nat, x: tensor.Tensor 1 8 Nat, salt: Nat): tensor.Tensor 1 4 Nat =
    tiled (λ (o: Nat): tensor.Tensor 1 2 Nat =
        tensor.slice @(Nat, 1) 8 (o, 1, 2) (tensor.unary @(Nat, Nat) f @(1, 8) x));
extern lam mismatch (f: Nat → Nat, x: tensor.Tensor 1 16 Nat, o salt: Nat): tensor.Tensor 1 2 Nat =
    tensor.slice @(Nat, 1) 16 (o, 1, 2) (tensor.unary @(Nat, Nat) f @(1, 16) x);

// MAP: nom [[INPUT:Tensor[_0-9]*]] = [«(1, 8, ⊥:Nat)», «8; Nat»]
// MAP-LABEL: extern lam result
// MAP-SAME: ([[F:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat → Nat, [[X:[a-zA-Z_][a-zA-Z_0-9]*]]: [[INPUT]], [[O:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat,
// MAP: let [[SL:[a-zA-Z_][a-zA-Z_0-9]*]] = tensor.slice @ (Nat, 1) 8 ([[O]], 1, 2) [[X]];
// MAP: tensor.unary @ {{.*}} [[F]] @ (1, 2) [[SL]]
// NEG-LABEL: extern lam mismatch
// NEG: tensor.unary @ {{.*}} @ (1, 16)
// NEG: tensor.slice @ (Nat, 1) 16
// NEST: nom [[NEST_INPUT:Tensor[_0-9]*]] = [«(1, 8, ⊥:Nat)», «8; Nat»]
// NEST-LABEL: extern lam nested
// NEST-SAME: ([[NF:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat → Nat, [[NX:[a-zA-Z_][a-zA-Z_0-9]*]]: [[NEST_INPUT]]
// NEST: lam {{.*}} ([[NO:[a-zA-Z_][a-zA-Z_0-9]*]]: Nat)
// NEST: let [[NS:[a-zA-Z_][a-zA-Z_0-9]*]] = tensor.slice @ (Nat, 1) 8 ([[NO]], 1, 2) [[NX]];
// NEST: tensor.unary @ {{.*}} [[NF]] @ (1, 2) [[NS]]
