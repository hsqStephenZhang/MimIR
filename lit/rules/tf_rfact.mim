// RUN: python3 %S/tf_run.py %mim %s %t rule > %t.rule 2> %t.rule.log
// RUN: not python3 %S/tf_run.py %mim %s %t graph > %t.graph 2> %t.graph.log
// RUN: grep 'argument is not assignable to callee' %t.graph.log
// RUN: cat %t.rule | %FileCheck %s --check-prefix=FACT
// RUN: cat %t.graph | %FileCheck %s --check-prefix=FACT
// XFAIL: *
// Polymorphic pure_ops is rejected before the unresolved graph guard can run.
// TF-RULES: exclusive
// TF-PURE: tensor.unary, fused

plugin compile;
plugin tensor;
axm only_used_by: [«8; Nat», «8; Nat»] → Bool;
axm fused: [Nat → Nat, «8; Nat»] → «8; Nat»;
rule exclusive (f: Nat → Nat, x: «8; Nat», unused: Nat):
    tensor.unary @(Nat, Nat) f @(1, 8) x
    when only_used_by (x, tensor.unary @(Nat, Nat) f @(1, 8) x) => fused (f, x);
extern lam result (f: Nat → Nat, x: «8; Nat», salt: Nat): «8; Nat» =
    tensor.unary @(Nat, Nat) f @(1, 8) x;

// FACT-LABEL: extern lam result
// FACT: fused
