// RUN: python3 %S/tf_run.py %mim %s %t rule tt > %t.rule 2> %t.rule.log
// RUN: %FileCheck %s < %t.rule
// RUN: python3 %S/tf_run.py %mim %s %t graph tt > %t.graph 2> %t.graph.log
// RUN: %FileCheck %s < %t.graph
// TF-RULES: (tensor.fuse_halo (I64, 1, 1))
// TF-PURE: tensor.tile_of_box, tensor.slice_box, tensor.map_reduce_post

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;

fun scale (_ x: I64)@tt: I64 = return (core.wrap.mul 0 (x, 2I64));
fun add (acc x: I64)@tt: I64 = return (core.wrap.add 0 (acc, x));

extern fun rejected (a: «7; I64»): «5; I64» =
    let p = map_reduce (7, 7) (scale, 0I64) (affine.id @1) (affine.id @1,) (buf a);
    let q = map_reduce (5, (5, 3)) (add, 0I64) (proj_map @(2, 1) 0)
        ((λ (i k: affine.Index): affine.Index = affine.op.add (i, k)),) p;
    return (tiled @(I64, 1) (5, 2)
        (λ (off ext: «1; Nat»): «ext; I64» = tile_of_box (q, off, ext, ext)));

// CHECK-LABEL: extern fun rejected
// CHECK: tensor.map_reduce_post {{.*}} (7,
// CHECK: tensor.slice_box
// CHECK: tensor.tiled
