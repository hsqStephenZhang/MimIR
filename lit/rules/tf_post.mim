// RUN: python3 %S/tf_run.py %mim %s %t rule > %t.rule 2> %t.rule.log
// RUN: cat %t.rule | %FileCheck %s --check-prefix=POST
// TF-RULES: cache
// TF-PURE: tiled, mm, slice, stage

plugin compile;
// Handles model tensors; stage belongs outside the io loop so all row tiles reuse it.
axm mm: [Nat, Nat] → Nat;
axm slice: [Nat, Nat, Nat] → Nat;
axm stage: Nat → Nat;
axm tiled: [Nat, Nat → Nat] → Nat;

rule cache (a b: Nat):
    tiled (4, λ (jo: Nat): Nat =
        tiled (4, λ (io: Nat): Nat = mm (slice (a, io, 2), slice (b, jo, 2)))) =>
    tiled (4, λ (jo: Nat): Nat =
        let bp = stage (slice (b, jo, 2));
        tiled (4, λ (io: Nat): Nat = mm (slice (a, io, 2), bp)));
extern lam result (a b: Nat): Nat =
    tiled (4, λ (jo: Nat): Nat =
        tiled (4, λ (io: Nat): Nat = mm (slice (a, io, 2), slice (b, jo, 2))));

// POST-LABEL: extern lam result
// POST: lam {{.*}} (jo: Nat)
// POST: let [[BOX:[a-zA-Z_][a-zA-Z_0-9]*]] = slice (b, jo, 2);
// POST: lam {{.*}} (io: Nat)
// POST: mm ({{.*}}, stage [[BOX]])
// POST: tiled
