// RUN: python3 %S/tf_run.py %mim %s %t rule > %t.rule.out 2> %t.rule.log
// RUN: %FileCheck %s --implicit-check-not='mark @' < %t.rule.out
// RUN: python3 %S/tf_run.py %mim %s %t graph > %t.graph.out 2> %t.graph.log
// RUN: %FileCheck %s --implicit-check-not='mark @' < %t.graph.out
// TF-RULES: (captures, repeated)
// TF-PURE: mark, dims, only, hit

plugin compile;
axm mark: {s: «3; Nat»} → Nat → Nat;
axm dims: [«3; Nat», Nat] → Nat;
axm only: {s: «3; Nat»} → Nat → Nat;
axm hit: Nat → Nat;
rule captures (M K N: Nat, x: Nat): mark @(M, K, N) x => dims ((M, K, N), x);
rule repeated (M N: Nat, x: Nat): only @(M, M, N) x => hit x;
extern lam uniform (x: Nat): Nat = mark @(4, 4, 4) x;
extern lam different (x: Nat): Nat = mark @(3, 5, 7) x;
extern lam same (x: Nat): Nat = only @(4, 4, 4) x;
extern lam mixed (x: Nat): Nat = only @(4, 4, 6) x;
extern lam conflict (x: Nat): Nat = only @(4, 5, 6) x;

// CHECK-DAG: dims ({{.*}}4{{.*}}, x
// CHECK-DAG: dims ((3, 5, 7), x
// CHECK-DAG: extern lam same {{.*}}=
// CHECK-DAG: extern lam mixed {{.*}}=
// CHECK-DAG: hit x
// CHECK-DAG: hit x
// CHECK-DAG: only @ (4, 5, 6) x
