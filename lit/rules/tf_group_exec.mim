// RUN: python3 %S/tf_run.py %mim %s %t rule tt lower > %t.rule.out 2> %t.rule.log
// RUN: clang++ -O3 %S/tf_group_aux.cpp %t.rule.ll -o %t.rule -Wno-override-module
// RUN: %t.rule
// RUN: python3 %S/tf_run.py %mim %s %t graph tt lower > %t.graph.out 2> %t.graph.log
// RUN: clang++ -O3 %S/tf_group_aux.cpp %t.graph.ll -o %t.graph -Wno-override-module
// RUN: %t.graph
// RUN: python3 %S/tf_run.py %mim %s %t rule tt > %t.tiles 2> %t.tiles.log
// RUN: %FileCheck %s < %t.tiles
// TF-RULES: (tensor.fuse_producer (I64, 1))
// TF-PURE: tensor.tile_of, tensor.slice, tensor.map_reduce_post

plugin tensor;
plugin core;
plugin affine;
plugin compile;
use tensor;

fun keep (_ x: I64)@tt: I64 = return x;
fun twice (_ x: I64)@tt: I64 = return (core.wrap.add 0 (x, x));
lam producer (a: «10; I64»): «10; I64» =
    map_reduce (10, 10) (keep, 0I64) (affine.id @1) (affine.id @1,) (buf a);

extern fun chain (a: «10; I64»): «10; I64» =
    let p = map_reduce (10, 10) (twice, 0I64) (affine.id @1) (affine.id @1,) (producer a);
    return (tiled @(I64, 1) (10, 4)
        (λ (off ext: «1; Nat»): «ext; I64» = slice @(I64, 1) 10 (off, 1, ext) p));

extern fun reference (a: «10; I64»): «10; I64» =
    let p = map_reduce (10, 10) (twice, 0I64) (affine.id @1) (affine.id @1,) (producer a);
    return p;

extern fun nested (a: «10; I64»): «10; I64» =
    let p = producer a;
    return (tiled @(I64, 1) (10, 4)
        (λ (off ext: «1; Nat»): «ext; I64» =
            tiled @(I64, 1) (ext, 3)
                (λ (lo len: «1; Nat»): «len; I64» =
                    slice @(I64, 1) 10 (core.nat.add (off, lo), 1, len) p)));

// CHECK-LABEL: extern fun chain
// CHECK-NOT: tensor.map_reduce_post {{.*}} (10,
// CHECK: tensor.map_reduce_post
// CHECK-NOT: tensor.map_reduce_post {{.*}} (10,
// CHECK-LABEL: extern fun nested
