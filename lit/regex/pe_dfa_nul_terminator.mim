// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t ""; test $? -eq 1
// RUN: %t "a"; test $? -eq 0

plugin mem;
plugin core;
plugin regex;
plugin cps;

let Top = ⊤:Nat;
let error = 2:(Idx 3);
let no_transitions = ((255I8, 0I8, error), (255I8, 0I8, error));

// NUL is the Input terminator, not a byte consumed by the [0, 255] edge.
// Consequently, the empty input accepts in state 0 while "a" transitions to
// the non-accepting state 1 and rejects at its terminator.
let dfa = (
    0:(Idx 3),
    error,
    ((tt, error, ((0I8, 255I8, 1:(Idx 3)), (255I8, 0I8, error))),
     (ff, error, no_transitions),
     (ff, error, no_transitions)));
let matcher = %regex.dfa.compile dfa;

con extern main[mem: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0), exit : Cn [%mem.M 0, I32]] =
    let arg1 = %mem.lea (argv, %core.idx_unsafe 1);
    let (mem, to_match) = %mem.load (mem, arg1);
    let (mem, matched, _) = matcher (mem, to_match, 0:(Idx Top));
    exit (mem, %core.conv.u i32 matched);

// CHECK-NOT: %regex.specialize_dfa
// CHECK-NOT: 0I8, 255I8
// CHECK-DAG: state_0
// CHECK-DAG: state_1
// CHECK: %mem.load
