// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t "ab"; test $? -eq 1
// RUN: %t "aaab"; test $? -eq 1
// RUN: %t "a"; test $? -eq 0
// RUN: %t "abc"; test $? -eq 0
// RUN: %t "xb"; test $? -eq 0

plugin mem;
plugin core;
plugin regex;
plugin cps;

let Top = ⊤:Nat;
let error = 3:(Idx 4);
let no_transitions = ((255I8, 0I8, error), (255I8, 0I8, error));

// A sparse cyclic DFA for the full match /^a+b$/:
//   state 0 --'a'--> state 1 --'a'--> state 1
//                                  --'b'--> state 2 (accepting)
// Every missing transition falls back to state 3 (error).
let dfa = (
    0:(Idx 4),
    error,
    ((ff, error, (('a', 'a', 1:(Idx 4)), (255I8, 0I8, error))),
     (ff, error, (('a', 'a', 1:(Idx 4)), ('b', 'b', 2:(Idx 4)))),
     (tt, error, no_transitions),
     (ff, error, no_transitions)));
let matcher = %regex.dfa.compile dfa;

con extern main[mem: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0), exit : Cn [%mem.M 0, I32]] =
    (exit, match_argument)#(%core.icmp.ug (argc, 1I32)) (mem, 0I32)
    where
        con match_argument[mem: %mem.M 0, I32] =
            let arg1 = %mem.lea (argv, %core.idx_unsafe 1);
            let (mem, to_match) = %mem.load (mem, arg1);
            let (mem, matched, _) = matcher (mem, to_match, 0:(Idx Top));
            exit (mem, %core.conv.u i32 matched);
    end;

// CHECK-NOT: %regex.specialize_dfa
// CHECK-NOT: static_states
// CHECK-NOT: 255I8
// CHECK-DAG: state_0
// CHECK-DAG: state_1
// CHECK-DAG: state_2
// CHECK: %mem.load
