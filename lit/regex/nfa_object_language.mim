// RUN: %mim -p opt %s | %FileCheck %s

plugin core;
plugin regex;

let edge_eps: %regex.nfa.Edge 3 =
    (0:(Idx 3), 1:(Idx 3), %regex.nfa.epsilon ());
let edge_a: %regex.nfa.Edge 3 =
    (1:(Idx 3), 2:(Idx 3), %regex.nfa.range ('a', 'a'));
let nfa: %regex.NFA 3 2 =
    (0:(Idx 3), 2:(Idx 3), (edge_eps, edge_a));

let start = %regex.nfa.singleton (0:(Idx 3));
let closed = %regex.nfa.epsilon_closure (nfa, start);
let moved_a = %regex.nfa.move (nfa, closed, 'a');
let moved_b = %regex.nfa.move (nfa, closed, 'b');

fun extern closure_has_epsilon_successor (): I32 =
    return (%core.conv.u i32 (closed#(1:(Idx 3))));

fun extern move_a_reaches_accept (): I32 =
    return (%core.conv.u i32 (moved_a#(2:(Idx 3))));

fun extern move_b_rejects_accept (): I32 =
    return (%core.conv.u i32 (moved_b#(2:(Idx 3))));

// CHECK-DAG: fun extern closure_has_epsilon_successor
// CHECK-DAG: return{{.*}}1I32
// CHECK-DAG: fun extern move_a_reaches_accept
// CHECK-DAG: return{{.*}}1I32
// CHECK-DAG: fun extern move_b_rejects_accept
// CHECK-DAG: return{{.*}}0I32
// CHECK-NOT: %regex.nfa
// CHECK-NOT: Match
