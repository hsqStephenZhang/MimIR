// Derived from rust-lang/regex testdata/fowler/basic.toml `basic26`.
// We compare only ASCII full-match acceptance, not capture spans or
// leftmost-first submatch selection.
// RUN: rm -f %{s:stem}.ll ; \
// RUN: %mim -p opt %s -o - -p ll | %FileCheck %s
// RUN: clang %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t "abc"; test $? -eq 1
// RUN: %t "ac"; test $? -eq 1
// RUN: %t "abbc"; test $? -eq 1
// RUN: %t ""; test $? -eq 0
// RUN: %t "ab"; test $? -eq 0
// RUN: %t "abb"; test $? -eq 0
// RUN: %t "abcc"; test $? -eq 0
// RUN: %t "bc"; test $? -eq 0

plugin mem;
plugin core;
plugin regex;

let Top = ⊤:Nat;
let error = 5:(Idx 6);
let none = (255I8, 0I8, error);

// Full-match DFA for `(ab|a)(bc|c)`:
//   0 -a-> 1 -b-> 2 -b-> 3 -c-> 4
//             |      `-c----------> 4
//             `-c-----------------> 4
let dfa = (
    0:(Idx 6),
    error,
    ((ff, error, (('a', 'a', 1:(Idx 6)), none)),
     (ff, error, (('b', 'b', 2:(Idx 6)), ('c', 'c', 4:(Idx 6)))),
     (ff, error, (('b', 'b', 3:(Idx 6)), ('c', 'c', 4:(Idx 6)))),
     (ff, error, (('c', 'c', 4:(Idx 6)), none)),
     (tt, error, (none, none)),
     (ff, error, (none, none))));
let matcher = %regex.dfa.compile dfa;

con extern main[mem: %mem.M 0, argc: I32, argv: %mem.Ptr («⊤:Nat; %mem.Ptr («⊤:Nat; I8», 0)», 0), exit : Cn [%mem.M 0, I32]] =
    (exit, match_argument)#(%core.icmp.ug (argc, 1I32)) (mem, 0I32)
    where
        con match_argument[mem: %mem.M 0, I32] =
            let arg1 = %mem.lea (argv, %core.idx_unsafe 1);
            let (mem, to_match) = %mem.load (mem, arg1);
            let (mem, matched, _) = matcher (mem, to_match, 0:(Idx Top));
            exit (mem, %core.conv.u i32 matched);
    end;

// CHECK-NOT: %regex.specialize_dfa
// CHECK-NOT: static_states
// CHECK-NOT: 255I8
// CHECK-DAG: state_0
// CHECK-DAG: state_4
// CHECK: %mem.load
