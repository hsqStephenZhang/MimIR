// 1024³ GEMM by `law.run` on the chain `gemm_vec_buffers.mim` interprets at the buffer level.
plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

extern fun gemm1024 (a b: tensor.Tensor 2 (1024, 1024) F32): tensor.Tensor 2 (1024, 1024) F32 =
    let l = law.of_map_reduce ((1024, 1024), (1024, 1024, 1024)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (law.run (l, serial_group ((64, 64, 0), 0, 0, group_red ((0, 0, 16), 0, 3, group_item ((4, 4, 0), 0, item_vec ((1, 0, 0), item_done ())))), default_control));
