// relu(A·B + bias) on 1024³ with the G3 tile request: the bias add and relu are the product's epilogue, finishing each tile.
plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

fun bias_relu (acc: F32, b: F32)@tt: F32 = return (math.extrema.fmax fast (math.arith.add fast (acc, b), 0.0:F32));

let levels = serial_group ((64, 64, 0), 1, 0, group_item ((4, 4, 0), 1, item_red ((0, 0, 16), 1, 3, item_vec ((1, 0, 0), item_done ()))));

extern fun gemm_bias_relu (a b bias: tensor.Tensor 2 (1024, 1024) F32): tensor.Tensor 2 (1024, 1024) F32 =
    let root = map_reduce_post @(2, 1) @(F32, F32, 2, 3, SchedT)
        ((1024, 1024), (1024, 1024, 1024), mk_sched (3, 0)) @((F32, F32), (2, 2), ((1024, 1024), (1024, 1024)), F32, 2, (1024, 1024))
        (mac, 0.0:F32, bias_relu) (proj_map @(3, 2) (0, 1))
        ((proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)), affine.id @2) ((buf a, buf b), buf bias);
    return (tile_req (root, (), levels, default_control));
