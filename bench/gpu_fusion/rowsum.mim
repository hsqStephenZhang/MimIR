// Row sums over (12, 1024, 1024): a work-group per 8 rows, the row's 1024 elements split into 256 blocks of 4,
// one block per work-item, partials combined in shared memory.
plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

let levels = ((0, (1, 8, 0), 1, 0, 1), (1, (0, 0, 4), 1, 0, 2));

extern fun rowsum (x: tensor.Tensor 3 (12, 1024, 1024) F32): tensor.Tensor 2 (12, 1024) F32 =
    return (tile_req (reduce (math.arith.add fast, 0.0:F32) 2₃ (buf x), (), levels, default_control));
