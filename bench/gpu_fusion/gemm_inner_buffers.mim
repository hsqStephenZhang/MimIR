// A 1024³ GEMM by the buffer-level interpreter of `bench/typed_tiles/buffer_levels.mim`, with the levels below.

plugin core;
plugin mem;
plugin affine;
plugin cps;
plugin vec;
plugin buffer;
plugin math;
plugin btensor;
plugin tensor;
plugin gpu;

import "../typed_tiles/buffer_levels.mim" as *;

use tensor;

let F32 = math.F32;
let C   = buffer.Buf (2, (1024, 1024), F32);

fun mac (m: mem.M 0, acc: F32, xy: [F32, F32])@tt: [mem.M 0, F32] =
    let (x, y) = xy;
    return (m, math.arith.add math.mode.fast (acc, math.arith.mul math.mode.fast (x, y)));

extern fun gemm1024 (m: mem.M 0, a b: C): [mem.M 0, C] =
    let (m, c) = buffer.alloc (2, (1024, 1024), F32) m;
    return (run_buffers ((1024, 1024), (1024, 1024, 1024)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1))
        (serial_group @(3, F32, NoMma) ((64, 64, 0), 0, 0, group_item ((4, 4, 0), 0, item_red ((0, 0, 16), 0, 3, item_vec ((1, 0, 0), item_done ())))))
        (m, c, (a, b)));
