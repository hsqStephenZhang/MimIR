// 1024³ GEMM by `bench/typed_tiles/buffer_interp.mim`'s interpreter: a schedule's levels interpreted at the buffer level: every parallel level is a loop over its tiles, bound to the
// unit its level names, and a leaf is a `btensor.map_reduce` that writes its tile of the destination in place.
// A reduction level folds its loop's blocks in order: the first from the seed, the others into the destination.
// A promoting reduction level inside a work-group stages the boxes its work-group's block reads of every input into
// shared memory: the leaf is one `gpu.superstep` whose fills copy the boxes and whose read is the `map_reduce`.
// It reads the same `tensor.TileLevels` chain as `law.run`; vector levels are not interpreted, and a level promotes
// all inputs or none.
plugin core;
plugin mem;
plugin affine;
plugin cps;
plugin vec;
plugin buffer;
plugin math;
plugin btensor;
plugin tensor;
plugin gpu;

use tensor;

let add = core.nat.add;
let mul = core.nat.mul;
let div = core.nat.div;
let rem = core.nat.rem;
let `-  = core.nat.sub;
let `<  = core.ncmp.l;
let `!= = core.ncmp.ne;
let `<= = core.ncmp.le;
let `== = core.ncmp.e;

lam Step (X: *): * = Cn [I64, [mem.M 0, X], Cn [mem.M 0, X]];
// `n` steps of `body` over a memory and a value; `bound` binds the loop to an execution unit.
lam steps {X: *} (bound: Step X → Step X) (n: Nat) (m: mem.M 0, x: X) (body: [Nat, mem.M 0, X] → [mem.M 0, X])
    : [mem.M 0, X] =
    fun run (s: [mem.M 0, X]): [mem.M 0, X] =
        affine.For @(0, 2, (mem.M 0, X)) (bound step) return (0I64, core.bitcast I64 n, 1I64, s)
        where
            con step (i: I64, s: [mem.M 0, X], yield: Cn [mem.M 0, X]) = yield (body (core.bitcast Nat i, s#0₂, s#1₂));
        end;
    cps.cps2ds run (m, x);
lam unbound {X: *} (k: Step X): Step X = k;

lam run_buffers {nis: Nat} {To: *, Ro Rn: Nat} (So: «Ro; Nat», Sr: «Rn; Nat»)
    {Tis: «nis; *», Ris: «i: nis; Nat», Sis: «i: nis; «Ris#i; Nat»»}
    (f: Fn [mem.M 0, To, «i: nis; Tis#i»] → [mem.M 0, To], init: To)
    (map_out: «Rn; affine.Index» → «Ro; affine.Index»)
    (maps: «i: nis; («Rn; affine.Index» → «Ris#i; affine.Index»)»)
    {K: *} (levels: TileLevels (Rn, To, K))
    (m: mem.M 0, dst: buffer.Buf (Ro, So, To), is: «i: nis; buffer.Buf (Ris#i, Sis#i, Tis#i)»)
    : [mem.M 0, buffer.Buf (Ro, So, To)] =
    let D     = buffer.Buf (Ro, So, To);
    // `seeded` tells whether the block's tile of the destination is still unwritten.
    // What a block's leaves read: the inputs, or for each of them a box at `los#i` of `exts#i` that the work-group stages.
    // `site` numbers the place in the unfolded schedule, so every leaf's superstep is a construct of its own.
    let Plan  = [staged: Bool, los: «i: nis; «Ris#i; Nat»», exts: «i: nis; «Ris#i; Nat»», site: Nat];
    // The work-group's block, whose boxes its work-items stage together.
    let Group = [lo: «Rn; Nat», size: «Rn; Nat»];
    let Block = [lo: «Rn; Nat», size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D] → [mem.M 0, D];
    // The box of input `i` that the block at `lo` of `size` reads; an axis one loop drives with unit slope is as long as
    // that loop's block, which keeps the extent a literal.
    let box   = λ (lo size: «Rn; Nat») (i: Idx nis): [«Ris#i; Nat», «Ris#i; Nat»] =
        let r     = Ris#i;
        let image = affine.image @(Rn, r) (maps#i) (lo, size, Sis#i);
        let probe = λ (k: Nat): «r; Nat» =
            (affine.image @(Rn, r) (maps#i) (‹Rn; 0›, ‹d: Rn; (1, 2)#(core.idx2nat d == k)›, Sis#i))#1₄;
        (image#0₄, ‹a: r;
            let drives = ‹k: Rn; (probe (core.idx2nat k))#a == 2›;
            let count  = vec.fold.r @(Nat, Bool) @Rn (λ (h: Bool, x: Nat): Nat = (x, add (x, 1))#h) (drives, 0);
            let k      = vec.fold.r @(Nat, Idx Rn) @Rn (λ (d: Idx Rn, x: Nat): Nat = (x, core.idx2nat d)#(drives#d)) (‹d: Rn; d›, 0);
            ((image#1₄)#a, size#(core.idx 0 Rn k))#(count == 1)›);
    let at    = λ (lo: «Rn; Nat») (o: «Rn; affine.Index»): «Rn; affine.Index» = ‹d: Rn; affine.op.add (o#d, affine.lit (lo#d))›;
    // The fold of the block at `lo` over buffers of shapes `ss`, read at `ins`, into its tile of the destination.
    lam reduce {ss: «i: nis; «Ris#i; Nat»»} (lo size: «Rn; Nat», seeded: Bool,
        ins: «i: nis; «Rn; affine.Index» → «Ris#i; affine.Index»», m: mem.M 0, dst: D,
        xs: «i: nis; buffer.Buf (Ris#i, ss#i, Tis#i)»): [mem.M 0, D] =
        let out  = λ (o: «Rn; affine.Index»): «Ro; affine.Index» = map_out (at lo o);
        let Held = [«Ro; Nat», «Rn; affine.Index» → «Ro; affine.Index», D];
        (btensor.map_reduce_post @(nis, 0) @(To, To, Ro, Rn, btensor.SchedT) (So, size, btensor.mk_sched (Rn, 0))
            @(Tis, Ris, ss, (), (), ()) @Held (f, (So, out, dst), btensor.id @To) out (ins, ()) (m, dst, xs, ()),
         btensor.map_reduce @nis @(To, Ro, Rn) (So, size) @(Tis, Ris, ss) (f, init) out ins (m, dst, xs))#seeded;
    let leaf  = λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] =
        let (staged, los, exts, site) = plan;
        let direct = λ (): [mem.M 0, D] =
            reduce @Sis (lo, size, seeded, ‹i: nis; λ (o: «Rn; affine.Index»): «Ris#i; affine.Index» = (maps#i) (at lo o)›, m, dst, is);
        // Each fill copies its input's box element by element, spread over the work-group's work-items.
        let fills  = ‹i: nis; let r = Ris#i; let P = buffer.Buf (r, exts#i, Tis#i);
            λ (m: mem.M 0, p: P): [mem.M 0, P] =
                let e     = exts#i;
                let after = λ (d: Nat): Nat = vec.fold.r @(Nat, Idx r) @r
                    (λ (a: Idx r, x: Nat): Nat = (x, mul (x, e#a))#(d < core.idx2nat a)) (‹a: r; a›, 1);
                steps (gpu.bind.chained @(Step P)) (vec.fold.r @(Nat, Nat) @r (λ (x y: Nat): Nat = mul (x, y)) (e, 1)) (m, p) (λ (n: Nat, m: mem.M 0, p: P): [mem.M 0, P] =
                    let c      = ‹a: r; rem (div (n, after (core.idx2nat a)), e#a)›;
                    let (m, v) = buffer.read (r, Sis#i, Tis#i) (m, is#i, ‹a: r; core.idx 0 ((Sis#i)#a) (add ((los#i)#a, c#a))›);
                    buffer.write (r, e, Tis#i) (m, p, ‹a: r; core.idx 0 (e#a) (c#a)›, v))›;
        let shared = λ (): [mem.M 0, D] =
            gpu.superstep @(site, nis, Ris, exts, Tis, D) (m, fills,
                λ (m: mem.M 0, ps: «i: nis; buffer.Buf (Ris#i, exts#i, Tis#i)»): [mem.M 0, D] =
                    reduce @exts (lo, size, seeded,
                        ‹i: nis; λ (o: «Rn; affine.Index»): «Ris#i; affine.Index» =
                            let c = (maps#i) (at lo o);
                            ‹a: Ris#i; affine.op.sub (c#a, affine.lit ((los#i)#a))››, m, dst, ps));
        (direct, shared)#staged ();
    // The tiles of the parallel loops, in row-major order; a loop `sizes` leaves at 0 is one tile.
    let split = λ (bound: Step D → Step D, group: Bool) (sizes: «Rn; Nat», k: Block): Block =
        λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] =
            let par    = λ (d: Idx Rn): Bool = core.idx2nat d < Ro;
            let ts     = ‹d: Rn; (size#d, (size#d, sizes#d)#(sizes#d != 0))#(par d)›;
            let counts = ‹d: Rn; (1, div (add (size#d, ts#d - 1), ts#d))#(par d)›;
            let after  = λ (d: Nat): Nat = vec.fold.r @(Nat, Idx Rn) @Rn
                (λ (e: Idx Rn, x: Nat): Nat = (x, mul (x, counts#e))#(d < core.idx2nat e)) (‹e: Rn; e›, 1);
            steps bound (mul (counts#(core.idx 0 Rn 0), after 0)) (m, dst) (λ (t: Nat, m: mem.M 0, dst: D): [mem.M 0, D] =
                let off  = ‹d: Rn; mul (rem (div (t, after (core.idx2nat d)), counts#d), ts#d)›;
                let rest = ‹d: Rn; size#d - off#d›;
                // A tile of a loop its size divides is whole, which keeps the extent a literal.
                let ext  = ‹d: Rn; (core.select (rest#d < ts#d, rest#d, ts#d), ts#d)#(core.ncmp.e (rem (size#d, ts#d), 0))›;
                let lo2   = ‹d: Rn; add (lo#d, off#d)›;
                let size2 = ‹d: Rn; (size#d, ext#d)#(par d)›;
                k (lo2, size2, seeded, plan, (grp, (lo2, size2))#group, m, dst));
    // The blocks of the first reduction loop `sizes` splits, in order.
    let fold  = λ (sizes: «Rn; Nat», promote: Nat, k: Block): Block =
        λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] =
            let loop  = vec.fold.r @(Nat, Idx Rn) @Rn
                (λ (d: Idx Rn, x: Nat): Nat = (x, core.idx2nat d)#(core.bit2.and 0 (sizes#d != 0, Ro <= core.idx2nat d)))
                (‹d: Rn; d›, Rn);
            let ax    = core.idx 0 Rn (core.select (loop < Rn, loop, 0));
            let K     = size#ax;
            let ks    = core.select (sizes#ax != 0, sizes#ax, 1);
            let count = div (add (K, ks - 1), ks);
            let block = λ (j: Nat, seeded: Bool, m: mem.M 0, dst: D): [mem.M 0, D] =
                let k0   = mul (j, ks);
                let rest = K - k0;
                let n    = (core.select (rest < ks, rest, ks), ks)#(core.ncmp.e (rem (K, ks), 0));
                let blo   = ‹d: Rn; add (lo#d, (0, k0)#(core.icmp.e (d, ax)))›;
                let bsize = ‹d: Rn; (size#d, n)#(core.icmp.e (d, ax))›;
                // The boxes cover the work-group's block along the parallel loops, so its work-items fill them together.
                let plo   = ‹d: Rn; ((grp#0₂)#d, blo#d)#(Ro <= core.idx2nat d)›;
                let psize = ‹d: Rn; ((grp#1₂)#d, bsize#d)#(Ro <= core.idx2nat d)›;
                let here  = add (mul (plan#3₄, 2), (1, 0)#seeded);
                let boxes = (tt, ‹i: nis; (box (plo, psize) i)#0₂›, ‹i: nis; (box (plo, psize) i)#1₂›, here);
                k (blo, bsize, seeded, ((plan#0₄, plan#1₄, plan#2₄, here), boxes)#(promote != 0), grp, m, dst);
            let from  = (0, 1)#seeded;
            let run   = (λ (): [mem.M 0, D] =
                let (m, dst) = ((m, dst), block (0, tt, m, dst))#seeded;
                steps (unbound @D) (count - from) (m, dst) (λ (j: Nat, m: mem.M 0, dst: D): [mem.M 0, D] = block (add (j, from), ff, m, dst)),
                         λ (): [mem.M 0, D] = k (lo, size, seeded, plan, grp, m, dst))#(core.ncmp.e (loop, Rn));
            run ();
    lam item_step {M: *} (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D, l: ItemLevels (Rn, To, M))@(core.pe.is_closed l): [mem.M 0, D] =
        match l with
            | 0 => leaf (lo, size, seeded, plan, grp, m, dst)
            | 1 (sizes, _, rest) => split (unbound @D, ff) (sizes, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = item_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 2 (sizes, _, promote, _, rest) => fold (sizes, promote, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = item_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 3 (_, _) => leaf (lo, size, seeded, plan, grp, m, dst)
            | 4 (_, _, _) => leaf (lo, size, seeded, plan, grp, m, dst);
    lam group_step {M: *, g: «Rn; Nat»} (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D, l: GroupLevels (Rn, To, M, g))@(core.pe.is_closed l): [mem.M 0, D] =
        match l with
            | 0 => leaf (lo, size, seeded, plan, grp, m, dst)
            | 1 (sizes, _, rest) => split (unbound @D, ff) (sizes, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = group_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 2 (sizes, _, rest) => split (gpu.bind.item @(Step D), ff) (sizes, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = item_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 3 (sizes, _, promote, _, rest) => fold (sizes, promote, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = group_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 4 (_, _, _, _) => leaf (lo, size, seeded, plan, grp, m, dst)
            | 5 (_, _) => leaf (lo, size, seeded, plan, grp, m, dst)
            | 6 (sizes: «Rn; Nat», _: Nat, _: WarpLevels (Rn, To, M, within (g, sizes))) => leaf (lo, size, seeded, plan, grp, m, dst)
            | 7 (sizes: «Rn; Nat», _: Nat, _: WarpgroupLevels (Rn, To, M, g, sizes)) => leaf (lo, size, seeded, plan, grp, m, dst);
    lam tile_step {M: *} (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D, l: TileLevels (Rn, To, M))@(core.pe.is_closed l): [mem.M 0, D] =
        match l with
            | 0 => leaf (lo, size, seeded, plan, grp, m, dst)
            | 1 (sizes, _, rest) => split (unbound @D, ff) (sizes, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = tile_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 2 (sizes: «Rn; Nat», _ _: Nat, rest: GroupLevels (Rn, To, M, sizes)) => split (gpu.bind.group @(Step D), tt) (sizes, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = group_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 3 (sizes, _, _, rest) => fold (sizes, 0, λ (lo size: «Rn; Nat», seeded: Bool, plan: Plan, grp: Group, m: mem.M 0, dst: D): [mem.M 0, D] = tile_step (lo, size, seeded, plan, grp, m, dst, rest)) (lo, size, seeded, plan, grp, m, dst)
            | 4 (_, _) => leaf (lo, size, seeded, plan, grp, m, dst)
            | 5 (_, _, _, _) => leaf (lo, size, seeded, plan, grp, m, dst)
            | 6 (_, _) => leaf (lo, size, seeded, plan, grp, m, dst);
    tile_step (‹Rn; 0›, Sr, tt, (ff, ‹i: nis; ‹Ris#i; 0››, ‹i: nis; ‹Ris#i; 0››, 0), (‹Rn; 0›, Sr), m, dst, levels);

let F32 = math.F32;
let C   = buffer.Buf (2, (1024, 1024), F32);

fun mac (m: mem.M 0, acc: F32, xy: [F32, F32])@tt: [mem.M 0, F32] =
    let (x, y) = xy;
    return (m, math.arith.add math.mode.fast (acc, math.arith.mul math.mode.fast (x, y)));

extern fun gemm1024 (m: mem.M 0, a b: C): [mem.M 0, C] =
    let (m, c) = buffer.alloc (2, (1024, 1024), F32) m;
    return (run_buffers ((1024, 1024), (1024, 1024, 1024)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1))
        (serial_group @(3, F32, NoMma) ((64, 64, 0), 0, 0, group_item ((4, 4, 0), 0, item_done ())))
        (m, c, (a, b)));
