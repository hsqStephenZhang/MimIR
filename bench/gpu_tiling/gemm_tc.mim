// TF32 tensor-core SGEMM, 1024^3: 128x128 work-group tiles, k in blocks of 16 double-buffered with cp.async,
// 8 warps of 64x32, A fragments via ldmatrix.x4, B fragments via scalar shared loads.
plugin core;
plugin gpu;
plugin mem;
plugin math;
plugin affine;

use core.ops.u.w;

let F32 = math.F32;
let Mat = «1024, 1024; F32»;
let Acc = «16; «4; F32»»;

lam ix (n: Nat) (x: I64): Idx n = core.conv.u n x;
lam shr (x: I64, s: I64): I64 = core.shr.l (x, s);
lam band (x: I64, s: I64): I64 = core.bit2.and 0 (x, s);
lam sync (m: mem.M 0, m3: gpu.SharedM): mem.M 0 =
    let (m1, _) = gpu.sync_work_items (gpu.global_mem m, m3);
    gpu.generic_mem m1;

con kernel (m1: gpu.GlobalM, m3: gpu.SharedM, m4: gpu.ConstM, m5: gpu.LocalM,
            group_id: Idx 64, item_id: Idx 256, (), (a b c: gpu.GlobalPtr Mat),
            return: Cn [gpu.GlobalM, gpu.SharedM, gpu.ConstM, gpu.LocalM]) =
    let m      = gpu.generic_mem m1;
    let (m, sa) = gpu.slot_shared «2, 128, 5, 4; F32» m;
    let (m, sb) = gpu.slot_shared «2, 16, 34, 4; F32» m;
    let sbs    = core.bitcast (mem.Ptr0 «2, 16, 136; F32») sb;
    let av     = core.bitcast (mem.Ptr0 «1024, 256, 4; F32») a;
    let bv     = core.bitcast (mem.Ptr0 «1024, 256, 4; F32») b;
    let cv     = core.bitcast (mem.Ptr0 Mat) c;
    let tid    = core.conv.u 0 item_id;
    let gid    = core.conv.u 0 group_id;
    let bm     = shr (gid, 3I64);
    let bn     = band (gid, 7I64);
    let lane   = band (tid, 31I64);
    let warp   = shr (tid, 5I64);
    let wm     = shr (warp, 2I64);
    let wn     = band (warp, 3I64);
    let g      = shr (lane, 2I64);
    let t      = band (lane, 3I64);
    lam fill (m: mem.M 0, buf: Idx 2, kb: I64): mem.M 0 =
        let ca0       = tid + 0I64;
        let pa0       = mem.lea (mem.lea (av, ix 1024 (bm * 128I64 + shr (ca0, 2I64))), ix 256 (kb * 4I64 + band (ca0, 3I64)));
        let (m, va0)  = mem.load (m, pa0);
        let m          = gpu.store_async (m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (shr (ca0, 2I64))), ix 5 (band (ca0, 3I64))), va0);
        let pb0       = mem.lea (mem.lea (bv, ix 1024 (kb * 16I64 + shr (ca0, 5I64))), ix 256 (bn * 32I64 + band (ca0, 31I64)));
        let (m, vb0)  = mem.load (m, pb0);
        let m          = gpu.store_async (m, mem.lea (mem.lea (mem.lea (sb, buf), ix 16 (shr (ca0, 5I64))), ix 34 (band (ca0, 31I64))), vb0);
        let ca1       = tid + 256I64;
        let pa1       = mem.lea (mem.lea (av, ix 1024 (bm * 128I64 + shr (ca1, 2I64))), ix 256 (kb * 4I64 + band (ca1, 3I64)));
        let (m, va1)  = mem.load (m, pa1);
        let m          = gpu.store_async (m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (shr (ca1, 2I64))), ix 5 (band (ca1, 3I64))), va1);
        let pb1       = mem.lea (mem.lea (bv, ix 1024 (kb * 16I64 + shr (ca1, 5I64))), ix 256 (bn * 32I64 + band (ca1, 31I64)));
        let (m, vb1)  = mem.load (m, pb1);
        let m          = gpu.store_async (m, mem.lea (mem.lea (mem.lea (sb, buf), ix 16 (shr (ca1, 5I64))), ix 34 (band (ca1, 31I64))), vb1);
        m;
    lam step (m: mem.M 0, buf: Idx 2, acc: Acc): [mem.M 0, Acc] =
        let (m, a00) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 0I64 + band (lane, 15I64))), ix 5 (0I64 + shr (lane, 4I64))));
        let (m, a01) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 16I64 + band (lane, 15I64))), ix 5 (0I64 + shr (lane, 4I64))));
        let (m, a02) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 32I64 + band (lane, 15I64))), ix 5 (0I64 + shr (lane, 4I64))));
        let (m, a03) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 48I64 + band (lane, 15I64))), ix 5 (0I64 + shr (lane, 4I64))));
        let (m, b000) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (0I64 + t)), ix 136 (wn * 32I64 + 0I64 + g)));
        let (m, b001) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (4I64 + t)), ix 136 (wn * 32I64 + 0I64 + g)));
        let (m, b010) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (0I64 + t)), ix 136 (wn * 32I64 + 8I64 + g)));
        let (m, b011) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (4I64 + t)), ix 136 (wn * 32I64 + 8I64 + g)));
        let (m, b020) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (0I64 + t)), ix 136 (wn * 32I64 + 16I64 + g)));
        let (m, b021) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (4I64 + t)), ix 136 (wn * 32I64 + 16I64 + g)));
        let (m, b030) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (0I64 + t)), ix 136 (wn * 32I64 + 24I64 + g)));
        let (m, b031) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (4I64 + t)), ix 136 (wn * 32I64 + 24I64 + g)));
        let af0 = (a00, a01, a02, a03);
        let bf0 = ((b000, b001), (b010, b011), (b020, b021), (b030, b031));
        let acc = ‹i: 16; gpu.mma_tf32 (af0#(core.conv.u 4 (core.shr.l (i, 2₁₆))), bf0#(core.conv.u 4 (core.bit2.and 0 (i, 3₁₆))), acc#i)›;
        let (m, a10) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 0I64 + band (lane, 15I64))), ix 5 (2I64 + shr (lane, 4I64))));
        let (m, a11) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 16I64 + band (lane, 15I64))), ix 5 (2I64 + shr (lane, 4I64))));
        let (m, a12) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 32I64 + band (lane, 15I64))), ix 5 (2I64 + shr (lane, 4I64))));
        let (m, a13) = gpu.ldmatrix (4, m, mem.lea (mem.lea (mem.lea (sa, buf), ix 128 (wm * 64I64 + 48I64 + band (lane, 15I64))), ix 5 (2I64 + shr (lane, 4I64))));
        let (m, b100) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (8I64 + t)), ix 136 (wn * 32I64 + 0I64 + g)));
        let (m, b101) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (12I64 + t)), ix 136 (wn * 32I64 + 0I64 + g)));
        let (m, b110) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (8I64 + t)), ix 136 (wn * 32I64 + 8I64 + g)));
        let (m, b111) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (12I64 + t)), ix 136 (wn * 32I64 + 8I64 + g)));
        let (m, b120) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (8I64 + t)), ix 136 (wn * 32I64 + 16I64 + g)));
        let (m, b121) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (12I64 + t)), ix 136 (wn * 32I64 + 16I64 + g)));
        let (m, b130) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (8I64 + t)), ix 136 (wn * 32I64 + 24I64 + g)));
        let (m, b131) = mem.load (m, mem.lea (mem.lea (mem.lea (sbs, buf), ix 16 (12I64 + t)), ix 136 (wn * 32I64 + 24I64 + g)));
        let af1 = (a10, a11, a12, a13);
        let bf1 = ((b100, b101), (b110, b111), (b120, b121), (b130, b131));
        let acc = ‹i: 16; gpu.mma_tf32 (af1#(core.conv.u 4 (core.shr.l (i, 2₁₆))), bf1#(core.conv.u 4 (core.bit2.and 0 (i, 3₁₆))), acc#i)›;
        (m, acc);
    let m = fill (m, 0₂, 0I64);
    affine.For block block_exit (0I64, 64I64, 1I64, (m, ‹16; ‹4; 0.0:F32››))
    where
        con block (kb: I64, state: [mem.M 0, Acc], continue: Cn [[mem.M 0, Acc]]) =
            let (m, acc) = state;
            let m        = sync (gpu.async_wait m, m3);
            let buf      = ix 2 (band (kb, 1I64));
            let next     = core.select (core.icmp.ul (kb + 1I64, 64I64), kb + 1I64, 63I64);
            let m        = fill (m, ix 2 (band (kb + 1I64, 1I64)), next);
            let (m, acc) = step (m, buf, acc);
            continue (m, acc);
        con block_exit (state: [mem.M 0, Acc]) =
            let (m, acc) = state;
            let m        = gpu.async_wait m;
            let r0 = bm * 128I64 + wm * 64I64 + 0I64 + g;
            let c0 = bn * 128I64 + wn * 32I64 + 0I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r0 + 0I64)), ix 1024 (c0 + 0I64)), acc#0₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r0 + 0I64)), ix 1024 (c0 + 1I64)), acc#0₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r0 + 8I64)), ix 1024 (c0 + 0I64)), acc#0₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r0 + 8I64)), ix 1024 (c0 + 1I64)), acc#0₁₆#3₄);
            let r1 = bm * 128I64 + wm * 64I64 + 0I64 + g;
            let c1 = bn * 128I64 + wn * 32I64 + 8I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r1 + 0I64)), ix 1024 (c1 + 0I64)), acc#1₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r1 + 0I64)), ix 1024 (c1 + 1I64)), acc#1₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r1 + 8I64)), ix 1024 (c1 + 0I64)), acc#1₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r1 + 8I64)), ix 1024 (c1 + 1I64)), acc#1₁₆#3₄);
            let r2 = bm * 128I64 + wm * 64I64 + 0I64 + g;
            let c2 = bn * 128I64 + wn * 32I64 + 16I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r2 + 0I64)), ix 1024 (c2 + 0I64)), acc#2₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r2 + 0I64)), ix 1024 (c2 + 1I64)), acc#2₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r2 + 8I64)), ix 1024 (c2 + 0I64)), acc#2₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r2 + 8I64)), ix 1024 (c2 + 1I64)), acc#2₁₆#3₄);
            let r3 = bm * 128I64 + wm * 64I64 + 0I64 + g;
            let c3 = bn * 128I64 + wn * 32I64 + 24I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r3 + 0I64)), ix 1024 (c3 + 0I64)), acc#3₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r3 + 0I64)), ix 1024 (c3 + 1I64)), acc#3₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r3 + 8I64)), ix 1024 (c3 + 0I64)), acc#3₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r3 + 8I64)), ix 1024 (c3 + 1I64)), acc#3₁₆#3₄);
            let r4 = bm * 128I64 + wm * 64I64 + 16I64 + g;
            let c4 = bn * 128I64 + wn * 32I64 + 0I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r4 + 0I64)), ix 1024 (c4 + 0I64)), acc#4₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r4 + 0I64)), ix 1024 (c4 + 1I64)), acc#4₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r4 + 8I64)), ix 1024 (c4 + 0I64)), acc#4₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r4 + 8I64)), ix 1024 (c4 + 1I64)), acc#4₁₆#3₄);
            let r5 = bm * 128I64 + wm * 64I64 + 16I64 + g;
            let c5 = bn * 128I64 + wn * 32I64 + 8I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r5 + 0I64)), ix 1024 (c5 + 0I64)), acc#5₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r5 + 0I64)), ix 1024 (c5 + 1I64)), acc#5₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r5 + 8I64)), ix 1024 (c5 + 0I64)), acc#5₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r5 + 8I64)), ix 1024 (c5 + 1I64)), acc#5₁₆#3₄);
            let r6 = bm * 128I64 + wm * 64I64 + 16I64 + g;
            let c6 = bn * 128I64 + wn * 32I64 + 16I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r6 + 0I64)), ix 1024 (c6 + 0I64)), acc#6₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r6 + 0I64)), ix 1024 (c6 + 1I64)), acc#6₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r6 + 8I64)), ix 1024 (c6 + 0I64)), acc#6₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r6 + 8I64)), ix 1024 (c6 + 1I64)), acc#6₁₆#3₄);
            let r7 = bm * 128I64 + wm * 64I64 + 16I64 + g;
            let c7 = bn * 128I64 + wn * 32I64 + 24I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r7 + 0I64)), ix 1024 (c7 + 0I64)), acc#7₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r7 + 0I64)), ix 1024 (c7 + 1I64)), acc#7₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r7 + 8I64)), ix 1024 (c7 + 0I64)), acc#7₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r7 + 8I64)), ix 1024 (c7 + 1I64)), acc#7₁₆#3₄);
            let r8 = bm * 128I64 + wm * 64I64 + 32I64 + g;
            let c8 = bn * 128I64 + wn * 32I64 + 0I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r8 + 0I64)), ix 1024 (c8 + 0I64)), acc#8₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r8 + 0I64)), ix 1024 (c8 + 1I64)), acc#8₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r8 + 8I64)), ix 1024 (c8 + 0I64)), acc#8₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r8 + 8I64)), ix 1024 (c8 + 1I64)), acc#8₁₆#3₄);
            let r9 = bm * 128I64 + wm * 64I64 + 32I64 + g;
            let c9 = bn * 128I64 + wn * 32I64 + 8I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r9 + 0I64)), ix 1024 (c9 + 0I64)), acc#9₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r9 + 0I64)), ix 1024 (c9 + 1I64)), acc#9₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r9 + 8I64)), ix 1024 (c9 + 0I64)), acc#9₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r9 + 8I64)), ix 1024 (c9 + 1I64)), acc#9₁₆#3₄);
            let r10 = bm * 128I64 + wm * 64I64 + 32I64 + g;
            let c10 = bn * 128I64 + wn * 32I64 + 16I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r10 + 0I64)), ix 1024 (c10 + 0I64)), acc#10₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r10 + 0I64)), ix 1024 (c10 + 1I64)), acc#10₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r10 + 8I64)), ix 1024 (c10 + 0I64)), acc#10₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r10 + 8I64)), ix 1024 (c10 + 1I64)), acc#10₁₆#3₄);
            let r11 = bm * 128I64 + wm * 64I64 + 32I64 + g;
            let c11 = bn * 128I64 + wn * 32I64 + 24I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r11 + 0I64)), ix 1024 (c11 + 0I64)), acc#11₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r11 + 0I64)), ix 1024 (c11 + 1I64)), acc#11₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r11 + 8I64)), ix 1024 (c11 + 0I64)), acc#11₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r11 + 8I64)), ix 1024 (c11 + 1I64)), acc#11₁₆#3₄);
            let r12 = bm * 128I64 + wm * 64I64 + 48I64 + g;
            let c12 = bn * 128I64 + wn * 32I64 + 0I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r12 + 0I64)), ix 1024 (c12 + 0I64)), acc#12₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r12 + 0I64)), ix 1024 (c12 + 1I64)), acc#12₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r12 + 8I64)), ix 1024 (c12 + 0I64)), acc#12₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r12 + 8I64)), ix 1024 (c12 + 1I64)), acc#12₁₆#3₄);
            let r13 = bm * 128I64 + wm * 64I64 + 48I64 + g;
            let c13 = bn * 128I64 + wn * 32I64 + 8I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r13 + 0I64)), ix 1024 (c13 + 0I64)), acc#13₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r13 + 0I64)), ix 1024 (c13 + 1I64)), acc#13₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r13 + 8I64)), ix 1024 (c13 + 0I64)), acc#13₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r13 + 8I64)), ix 1024 (c13 + 1I64)), acc#13₁₆#3₄);
            let r14 = bm * 128I64 + wm * 64I64 + 48I64 + g;
            let c14 = bn * 128I64 + wn * 32I64 + 16I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r14 + 0I64)), ix 1024 (c14 + 0I64)), acc#14₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r14 + 0I64)), ix 1024 (c14 + 1I64)), acc#14₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r14 + 8I64)), ix 1024 (c14 + 0I64)), acc#14₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r14 + 8I64)), ix 1024 (c14 + 1I64)), acc#14₁₆#3₄);
            let r15 = bm * 128I64 + wm * 64I64 + 48I64 + g;
            let c15 = bn * 128I64 + wn * 32I64 + 24I64 + t * 2I64;
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r15 + 0I64)), ix 1024 (c15 + 0I64)), acc#15₁₆#0₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r15 + 0I64)), ix 1024 (c15 + 1I64)), acc#15₁₆#1₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r15 + 8I64)), ix 1024 (c15 + 0I64)), acc#15₁₆#2₄);
            let m = mem.store (m, mem.lea (mem.lea (cv, ix 1024 (r15 + 8I64)), ix 1024 (c15 + 1I64)), acc#15₁₆#3₄);
            return (gpu.global_mem m, m3, m4, m5);
    end;

extern fun gemm_tc (m0: mem.M 0, a b c: mem.Ptr0 Mat): [mem.M 0, I32] =
    let (m0, m1, m4) = gpu.init m0;
    let (m1, da)     = mem.alloc (Mat, 1) m1;
    let (m1, db)     = mem.alloc (Mat, 1) m1;
    let (m1, dc)     = mem.alloc (Mat, 1) m1;
    let (m0, m1)     = gpu.copy_to_device.block (m0, m1, a, da);
    let (m0, m1)     = gpu.copy_to_device.block (m0, m1, b, db);
    ret (m0, m1, m4) = gpu.launch (64, 256, gpu.default_stream, ff, ()) kernel (da, db, dc) $ (m0, m1, m4);
    let (m0, m1)     = gpu.copy_to_host.block (m0, m1, dc, c);
    let m1           = mem.free (m1, da);
    let m1           = mem.free (m1, db);
    let m1           = mem.free (m1, dc);
    let m0           = gpu.deinit (m0, m1, m4);
    return (m0, 0I32);
