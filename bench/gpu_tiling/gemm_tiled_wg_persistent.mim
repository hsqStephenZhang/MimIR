// 1024³ F16 GEMM `a · b` with F32 accumulation on warpgroup MMAs: 132 persistent work-groups each run 128×256 tiles
// of two warpgroups of 64×256 in turn, k in blocks of 64 with both inputs promoted into 128-byte-swizzled panels,
// B MN-major, filled by a producer warp with TMA into a 4-slot ring that persists across tiles; the consumers
// alternate their MMAs.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let H    = math.F16;
let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [H, H])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (math.conv.f2f math.f32 x, math.conv.f2f math.f32 y)));

let levels = serial_persistent (132, serial_group ((128, 256, 0), 1, 0, group_warpgroup ((64, 256, 0), 1, wg_red_ws ((0, 0, 64), 1, 3, 4, 1, wg_mma (64, 256, 16)))));

extern fun gemm1024 (a b: tensor.Tensor 2 (1024, 1024) H): tensor.Tensor 2 (1024, 1024) F32 =
    let root = map_reduce ((1024, 1024), (1024, 1024, 1024)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
