// 1024³ SGEMM: 64×64 work-group tiles, k in blocks of 16 with both inputs promoted into work-group panels,
// 4×4 work-item tiles with an SSA accumulator.
plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let levels = ((0, (64, 64, 0), 1, 0, 1), (0, (4, 4, 0), 1, 0, 2), (1, (0, 0, 16), 1, 3, 0), (2, (1, 0, 0), 1, 0, 0));

extern fun gemm1024 (a b: tensor.Tensor 2 (1024, 1024) F32): tensor.Tensor 2 (1024, 1024) F32 =
    let root = map_reduce ((1024, 1024), (1024, 1024, 1024)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
