// 1024³ SGEMM on TF32 tensor cores: 128×128 work-group tiles, 8 warps of 64×32, k in blocks of 8 with both
// inputs promoted into work-group panels, each warp block computed by mma.sync m16n8k8.

plugin tensor;
plugin core;
plugin affine;
plugin math;

use tensor;

let F32  = math.F32;
let fast = math.mode.fast;

fun mac (acc: F32, xy: [F32, F32])@tt: F32 =
    let (x, y) = xy;
    return (math.arith.add fast (acc, math.arith.mul fast (x, y)));

let levels = serial_group ((128, 128, 0), 1, 0, group_warp ((64, 32, 0), 1, warp_red ((0, 0, 8), 1, 3, warp_mma (16, 8, 8))));

extern fun gemm1024 (a b: tensor.Tensor 2 (1024, 1024) F32): tensor.Tensor 2 (1024, 1024) F32 =
    let root = map_reduce ((1024, 1024), (1024, 1024, 1024)) (mac, 0.0:F32) (proj_map @(3, 2) (0, 1))
        (proj_map @(3, 2) (0, 2), proj_map @(3, 2) (2, 1)) (buf a, buf b);
    return (tile_req (root, (), levels, default_control));
