plugin tensor;
plugin core;
plugin math;
plugin affine;
use tensor;

let F32 = math.F32;
// nsz | arcp | contract | afn | reassoc: what PyTorch's CPU kernels assume, without dropping NaN or infinity.
let M = 124;
let Ring = (F32, 0:F32, math.arith.add M, math.arith.mul M);
let `* = product_2d Ring;
lam add (x y: F32): F32 = math.arith.add M (x, y);
lam mul (x y: F32): F32 = math.arith.mul M (x, y);
lam fmax (x y: F32): F32 = math.extrema.fmax 0 (x, y);
lam scale (c: F32) (v: F32): F32 = math.arith.mul M (v, c);

extern fun transpose_ (x: Tensor 2 (2048, 2048) F32): Tensor 2 (2048, 2048) F32 = return (transpose_2d x);
extern fun row_sum_ (x: Tensor 2 (2048, 2048) F32): Tensor 1 2048 F32 = return (reduce (add, 0:F32) 1_2 x);
extern fun col_sum_ (x: Tensor 2 (2048, 2048) F32): Tensor 1 2048 F32 = return (reduce (add, 0:F32) 0_2 x);
extern fun softmax_ (x: Tensor 2 (2048, 2048) F32): Tensor 2 (2048, 2048) F32 = return (softmax M 1_2 x);
extern fun layer_norm_ (x: Tensor 2 (2048, 2048) F32): Tensor 2 (2048, 2048) F32 =
    let mean = unary (scale 0.00048828125:F32) (reduce (add, 0:F32) 1_2 x);
    let d    = binary_ax (λ (u v: F32): F32 = math.arith.sub M (u, v)) 1_2 (x, mean);
    let var  = unary (scale 0.00048828125:F32) (reduce (add, 0:F32) 1_2 (binary mul (d, d)));
    let rstd = unary (λ (v: F32): F32 = math.arith.div M (1.0:F32, math.rt.sq M (math.arith.add M (v, 0.00001:F32)))) var;
    return (binary_ax mul 1_2 (d, rstd));
extern fun max_pool_ (x: Tensor 4 (8, 64, 112, 112) F32): Tensor 4 (8, 64, 56, 56) F32 =
    return (pool (fmax, math.neg_inf (23, 8)) ((2, 2), (2, 2), (1, 1), (0, 0), (56, 56)) x);
extern fun avg_pool_ (x: Tensor 4 (8, 64, 112, 112) F32): Tensor 4 (8, 64, 110, 110) F32 =
    return (unary (λ (v: F32): F32 = math.arith.div M (v, 9.0:F32)) (pool (add, 0:F32) ((3, 3), (1, 1), (1, 1), (0, 0), (110, 110)) x));
extern fun attention_ (q k v: Tensor 2 (2048, 64) F32): Tensor 2 (2048, 64) F32 =
    return (softmax M 1₂ (unary (scale 0.125:F32) (q * transpose_2d k)) * v);
